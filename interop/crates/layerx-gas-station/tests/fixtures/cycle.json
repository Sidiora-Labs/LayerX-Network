{
  "rates": [
    {"denom":"usid","exchange_rate":"1.000000000000000000","last_update":"10","last_update_timestamp":1000},
    {"denom":"uhpx","exchange_rate":"2.000000000000000000","last_update":"10","last_update_timestamp":1000}
  ],
  "phases": {
    "*": [
      {"method":"eth_chainId","params":[],"result":"0x52d"},
      {"method":"eth_getBalance","params":["$sponsor","pending"],"result":"0x3782dace9d900000"},
      {"method":"eth_getTransactionCount","params":["$account","pending"],"result":"0x0"},
      {"method":"eth_getTransactionCount","params":["$sponsor","pending"],"result":"0x5"},
      {"method":"eth_call","params":[{"to":"$account","data":"$batch_nonce_call"},"pending"],"result":"$zero"}
    ],
    "submit": [
      {"method":"eth_call","params":[{"to":"$account","data":"$consumed_call"},"finalized"],"result":"$zero"},
      {"method":"eth_sendRawTransaction","params":["$raw"],"fault":"unavailable"}
    ],
    "restart": [
      {"method":"eth_getTransactionReceipt","params":["$hash"],"result":null},
      {"method":"eth_call","params":[{"to":"$account","data":"$consumed_call"},"finalized"],"result":"$zero"},
      {"method":"eth_sendRawTransaction","params":["$raw"],"result":"$hash"}
    ],
    "included": [
      {"method":"eth_getTransactionReceipt","params":["$hash"],"result":{
        "transactionHash":"$hash","from":"$sponsor","to":"$account","status":"0x1","blockNumber":"0x10","blockHash":"$block",
        "gasUsed":"0x186a0","effectiveGasPrice":"0x48c27395000",
        "logs":[
          {"address":"$token","topics":["$transfer_topic","$account_word","$sponsor_word"],"data":"$amount","removed":false},
          {"address":"$account","topics":["$sponsored_topic","$sponsor_word","$token_word"],"data":"$sponsored_data","removed":false}
        ]
      }},
      {"method":"eth_getBlockByNumber","params":["finalized",false],"result":{"number":"0x12","hash":"$finalized"}},
      {"method":"eth_getBlockByNumber","params":["0x10",false],"result":{"number":"0x10","hash":"$block"}},
      {"method":"eth_getBalance","params":["$sponsor","latest"],"result":"0x30927f74c9de0000"},
      {"method":"eth_call","params":[{"to":"$token","data":"$balance_call"},"latest"],"result":"$amount"}
    ],
    "consumed": [
      {"method":"eth_call","params":[{"to":"$account","data":"$consumed_call"},"finalized"],"result":"$one"}
    ]
  }
}
