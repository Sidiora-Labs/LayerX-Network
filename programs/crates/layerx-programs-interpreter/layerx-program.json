{
  "schema": 1,
  "abi_version": 2,
  "language": "rust",
  "name": "deterministic-interpreter",
  "sdk": "../../sdk/rust",
  "build": {
    "command": "cargo",
    "args": ["build", "--release", "--target", "wasm32-unknown-unknown", "--locked", "-p", "layerx-programs-interpreter"],
    "artifact": "../../target/wasm32-unknown-unknown/release/layerx_programs_interpreter.wasm"
  },
  "entry": {"call": "layerx_call", "reserve": "layerx_reserve", "interface": "interface.kvx"},
  "capabilities": ["storage_read", "storage_write", "transfer_402"]
}
