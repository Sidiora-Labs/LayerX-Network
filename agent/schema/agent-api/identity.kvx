[module]
name = "identity"
contract_major = 1
compatibility = "additive_only"

[type.SessionContext]
required = ["tenant","agent_did","authority_ref","permitted_activity_types","expiry","client","policy_version"]

[operation.agent.register]
request = "AgentRegistration"
required = ["tenant","agent_did","authority_ref","client","policy_version"]
response = "AuthorityResponse<AgentRecord>"

[operation.session.open]
request = "SessionOpen"
required = ["context"]
response = "AuthorityResponse<SessionRecord>"

[operation.session.refresh]
request = "SessionRefresh"
required = ["session_id","context"]
response = "AuthorityResponse<SessionRecord>"

[operation.session.close]
request = "SessionClose"
required = ["session_id","context"]
response = "AuthorityResponse<SessionRecord>"

[operation.session.list]
request = "SessionList"
required = ["context"]
response = "AuthorityResponse<SessionRecords>"

[type.CapabilityDimensions]
required = ["activity_types","counterparties","assets","amount_ceilings","rate_ceilings","purpose_constraints","expiry"]
set_semantics = "Every set is explicitly supplied. An explicit empty set denies that dimension; omission is invalid and never means allow all."

[operation.capability.create]
required = ["tenant","agent_did","dimensions"]
response = "AuthorityResponse<CapabilityRecord>"

[operation.capability.attenuate]
required = ["tenant","agent_did","parent_id","dimensions"]
response = "AuthorityResponse<CapabilityRecord>"

[operation.capability.list]
required = ["tenant","agent_did"]
response = "AuthorityResponse<CapabilityRecords>"

[operation.capability.revoke]
required = ["tenant","agent_did","capability_id"]
response = "AuthorityResponse<CapabilityRecord>"

[type.BudgetEnforcement]
variants = ["ProtocolBudget","DaemonLimit"]
ProtocolBudget.guarantee = "protocol_enforced"
DaemonLimit.guarantee = "daemon_enforced"
DaemonLimit.notice = "Bypassing the daemon bypasses this limit. It is not equivalent to a protocol budget."

[operation.budget.create]
required = ["tenant","agent_did","asset","limit","enforcement","expiry"]
response = "AuthorityResponse<BudgetRecord>"

[operation.budget.fund]
required = ["tenant","agent_did","budget_id","amount"]
response = "AuthorityResponse<BudgetRecord>"

[operation.budget.list]
required = ["tenant","agent_did"]
response = "AuthorityResponse<BudgetRecords>"

[operation.budget.reconciliation]
required = ["tenant","agent_did","budget_id"]
response = "AuthorityResponse<BudgetReconciliation>"

[operation.budget.revoke]
required = ["tenant","agent_did","budget_id"]
response = "AuthorityResponse<BudgetRecord>"

[type.AuthorityResponse]
required = ["authority","value"]
authority_description = "Every response names the tenant, agent DID, authority reference and exact protocol authority actually used."

[type.FaucetGrant]
required = ["funded","funding_id","transaction_id","amount","network"]
funded_semantics = "Only a grant the funding boundary confirmed as funded is a value. A pending, unfunded or incomplete document is a refusal and never a zero amount."

[operation.faucet.claim]
required = ["did","signer_public_key"]
response = "FaucetGrant"
network_scope = "test_network_only"
signer_binding = "The signer key must be one the calling session already authorises. A key the session does not name is refused before any grant is reserved."
idempotency_binding = "The claim key is derived by the funding boundary from the principal, the DID and the signer key, so a repeated claim settles onto the reservation it already made instead of consuming a second grant."
