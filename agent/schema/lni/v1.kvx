[schema]
name = "LayerX Node Interface"
major = 1
minor = 4
encoding = "major:u16be minor:u16be message_tag:u16be correlation_id:u64be canonical_payload:bytes32 proof_material:bytes32"
compatibility = "Within major version 1, minor releases may add only new message tags, optional trailing fields, and capabilities; removal, reuse, reordering, or changed meaning requires a new major version."
protocol_payload = "Any protocol datum is opaque canonical LayerX bytes. It is never expanded into an LNI-specific activity, receipt, state, batch, checkpoint, proof, or event layout."
transport = "Length-prefixed canonical frames over Unix sockets by default, mutual-TLS TCP remotely, or the separately versioned opaque-buffer C ABI."
handshake = "NodeInfo is the first exchange and carries LNI version, protocol version, network id, node role, chain head, latest sealed batch, latest finalised checkpoint, authorised sequencer key, and capabilities."

[capabilities]
values = ["node_info","submit","authenticated_durable_submit","receipt_lookup","account_read","history_range","batch_header","checkpoint","proof_bundle","availability_fetch","event_subscribe","historical_proofs","preparation_state","finality_evidence_register","simulate"]

[message.1]
name = "NodeInfoRequest"
kind = "request"
capability = "node_info"
canonical_payload = "empty selector bytes"
proof_material = "empty"
golden = "0001000000010000000000000000000000010100000000"

[message.2]
name = "NodeInfoResponse"
kind = "response"
capability = "node_info"
canonical_payload = "canonical node-info bytes"
proof_material = "empty"
golden = "0001000000020000000000000000000000010200000000"

[message.3]
name = "SubmitRequest"
kind = "request"
capability = "submit"
canonical_payload = "canonical signed LayerX activity bytes"
proof_material = "empty"
golden = "0001000000030000000000000000000000010300000000"

[message.4]
name = "SubmitResponse"
kind = "response"
capability = "submit"
canonical_payload = "canonical admission acknowledgement or rejection bytes; authenticated_durable_submit echoes the exact SubmitRequest canonical payload only after signature and current signing-authority verification and fdatasync-backed bounded-queue admission in the configured persistent checkpoint directory, while a refusal never consumes queue capacity"
proof_material = "core result evidence bytes; authenticated_durable_submit returns exactly the 32-byte activity id derived from the echoed canonical payload"
golden = "0001000000040000000000000000000000010400000001a5"

[message.5]
name = "ReceiptLookupRequest"
kind = "request"
capability = "receipt_lookup"
canonical_payload = "canonical activity-id, idempotency-key, or sequence selector bytes"
proof_material = "empty"
golden = "0001000000050000000000000000000000010500000000"

[message.6]
name = "ReceiptLookupResponse"
kind = "response"
capability = "receipt_lookup"
canonical_payload = "canonical signed LayerX receipt bytes or canonical absence marker"
proof_material = "receipt verification context bytes"
golden = "0001000000060000000000000000000000010600000001a5"

[message.7]
name = "AccountReadRequest"
kind = "request"
capability = "account_read"
canonical_payload = "AR1: version:u16be=1 kind:u8(balance=1,account=2) account_id:bytes32 [asset_id:bytes32 for balance] root_selector:u8(latest=1,batch=2,checkpoint=3) [batch:u64be|checkpoint_id:bytes32] requested_verification_rank:u8; zero identities, zero selected batch/checkpoint, unknown kinds/ranks, and trailing bytes are refused"
proof_material = "empty"
golden = "0001000000070000000000000000000000010700000000"

[message.8]
name = "AccountReadResponse"
kind = "response"
capability = "account_read"
canonical_payload = "exact canonical lx_account_state_leaf_material value bytes; no LNI balance wrapper"
proof_material = "NP1: version:u16be=1 kind:u8=2 echoed_root_selector account_id:bytes32 account_root:bytes32 universal_root:bytes32 resulting_root:bytes32 account_SP1 account_tree_SP1 universal_module_SP1 canonical_head_receipt:bytes32 receipt_SP1 SH1 checkpoint_present:u8 [CP1:bytes32 CX1:bytes32]; exact account->account-tree->module-0->signed-global-root chain, head receipt inclusion, and selector identity are mandatory"
golden = "0001000000080000000000000000000000010800000001a5"

[message.9]
name = "HistoryRangeRequest"
kind = "request"
capability = "history_range"
canonical_payload = "canonical sequence-range, cursor, filter, and page-bound bytes"
proof_material = "empty"
golden = "0001000000090000000000000000000000010900000000"

[message.10]
name = "HistoryItem"
kind = "stream"
capability = "history_range"
canonical_payload = "canonical LayerX activity, receipt, and event bytes"
proof_material = "ordered inclusion evidence bytes"
golden = "00010000000a0000000000000000000000010a00000001a5"

[message.11]
name = "HistoryEnd"
kind = "stream"
capability = "history_range"
canonical_payload = "canonical next-cursor and range-completion bytes"
proof_material = "empty"
golden = "00010000000b0000000000000000000000010b00000000"

[message.12]
name = "BatchHeaderRequest"
kind = "request"
capability = "batch_header"
canonical_payload = "version:u16be=1 selector_batch_number:u64be; zero and trailing bytes are refused"
proof_material = "empty"
golden = "00010000000c0000000000000000000000010c00000000"

[message.13]
name = "BatchHeaderResponse"
kind = "response"
capability = "batch_header"
canonical_payload = "canonical LayerX batch-header bytes"
proof_material = "version:u16be=1 sequencer_id:bytes32 authorised_sequencer_public_key:bytes32 first_batch_number:u64be last_batch_number:u64be canonical_header_signature:bytes64; key must equal the authenticated NodeInfo key and the selected batch must lie in the inclusive nonzero range"
golden = "00010000000d0000000000000000000000010d00000001a5"

[message.14]
name = "CheckpointRequest"
kind = "request"
capability = "checkpoint"
canonical_payload = "version:u16be=1 selector:u8(checkpoint_id=1,batch=2) checkpoint_id:bytes32|batch:u64be; zero selectors and trailing bytes are refused"
proof_material = "empty"
golden = "00010000000e0000000000000000000000010e00000000"

[message.15]
name = "CheckpointResponse"
kind = "response"
capability = "checkpoint"
canonical_payload = "CP1: version:u16be=1 canonical_header:bytes32 validity_proof:bytes32 attestation_count:u8 sorted_full_attestations threshold:u8 settlement_registration_reference:bytes16"
proof_material = "CX1: version:u16be=1 expected_registration_count:u64be full_bonded_set_snapshot sorted by guarantor id, finalisation_requirements, and checkpoint registration summary with exact settlement reference; response exists only for authority-verified durably registered evidence"
golden = "00010000000f0000000000000000000000010f00000001a5"

[message.16]
name = "ProofBundleRequest"
kind = "request"
capability = "proof_bundle"
canonical_payload = "PB1: version:u16be=1 kind:u8(activity=1,account_state=2,receipt=3) activity_id:bytes32 [account_id:bytes32 for account_state]; zero identities, unknown kinds, and trailing bytes are refused"
proof_material = "empty"
golden = "0001000000100000000000000000000000011000000000"

[message.17]
name = "ProofBundleResponse"
kind = "response"
capability = "proof_bundle"
canonical_payload = "kind 1 exact canonical signed activity; kind 2 exact canonical account value; kind 3 exact canonical receipt"
proof_material = "kind 1/3: version:u16be=1 kind:u8 activity_id:bytes32 SP1 SH1; kind 2: NP1; SP1 is leaf_index:u32be leaf_count:u32be depth:u8 siblings:bytes32[] with exact geometry; SH1 is version:u16be=1 sequencer_id:bytes32 public_key:bytes32 first_batch:u64be last_batch:u64be canonical_header:bytes32 signature:bytes64"
golden = "0001000000110000000000000000000000011100000001a5"

[message.18]
name = "AvailabilityFetchRequest"
kind = "request"
capability = "availability_fetch"
canonical_payload = "canonical checkpoint, batch, sequence-range, or activity selector and class bytes"
proof_material = "empty"
golden = "0001000000120000000000000000000000011200000000"

[message.19]
name = "AvailabilityChunk"
kind = "stream"
capability = "availability_fetch"
canonical_payload = "canonical LayerX availability chunk bytes"
proof_material = "chunk inclusion and class evidence bytes"
golden = "0001000000130000000000000000000000011300000001a5"

[message.20]
name = "AvailabilityEnd"
kind = "stream"
capability = "availability_fetch"
canonical_payload = "canonical availability class report bytes"
proof_material = "reassembled commitment evidence bytes"
golden = "0001000000140000000000000000000000011400000001a5"

[message.21]
name = "EventSubscribeRequest"
kind = "request"
capability = "event_subscribe"
canonical_payload = "canonical start-cursor and filter bytes"
proof_material = "empty"
golden = "0001000000150000000000000000000000011500000000"

[message.22]
name = "EventRecord"
kind = "stream"
capability = "event_subscribe"
canonical_payload = "canonical LayerX event bytes"
proof_material = "event ordering and inclusion evidence bytes"
golden = "0001000000160000000000000000000000011600000001a5"

[message.23]
name = "EventGap"
kind = "stream"
capability = "event_subscribe"
canonical_payload = "canonical gap range and recovery cursor bytes"
proof_material = "empty"
golden = "0001000000170000000000000000000000011700000000"

[message.24]
name = "EventHeartbeat"
kind = "stream"
capability = "event_subscribe"
canonical_payload = "canonical head and cursor bytes"
proof_material = "empty"
golden = "0001000000180000000000000000000000011800000000"

[message.25]
name = "ErrorResponse"
kind = "response"
capability = "node_info"
canonical_payload = "canonical typed boundary-error bytes: refusal class u8 followed by big-endian lxp_result i32; class 6 is an authentication refusal and means the submitted activity did not touch the queue"
proof_material = "empty"
golden = "0001000000190000000000000000000000011900000000"

[message.26]
name = "PreparationStateRequest"
kind = "request"
capability = "preparation_state"
canonical_payload = "version:u16be=1 actor_did_length:u16be actor_did:bytes; the DID is non-empty and bounded to the protocol maximum"
proof_material = "empty"
golden = "00010001001a0000000000000000000000011a00000000"

[message.27]
name = "PreparationStateResponse"
kind = "response"
capability = "preparation_state"
canonical_payload = "version:u16be=1 actor_did_length:u16be actor_did:bytes network_id:u32be account_next_sequence:u64be latest_sealed_timestamp:u64be observed_head_sequence:u64be observed_state_root:bytes32 kernel_epoch:u64be module_count:u16be modules:(module_id:u16be activity_count:u16be activity_types:u32be[]); total payload is bounded to 4096 bytes; authenticated same-process snapshot only, not a Merkle proof"
proof_material = "empty"
golden = "00010001001b0000000000000000000000011b00000000"

[message.28]
name = "FinalityEvidenceRegisterRequest"
kind = "request"
capability = "finality_evidence_register"
canonical_payload = "CP1 exact finalized-checkpoint certificate bytes as tag 15; bounded validity proof, sorted full attestations, threshold, and exact 110-byte registration reference"
proof_material = "CX1 full bonded-set snapshot, finalisation requirements, and exact settlement registration evidence as tag 15; daemon-owned finality-authority verification is mandatory before append and unbound authority fails unavailable"
golden = "00010002001c0000000000000000000000011c00000001a5"

[message.29]
name = "FinalityEvidenceRegisterResponse"
kind = "response"
capability = "finality_evidence_register"
canonical_payload = "version:u16be=1 checkpoint_id:bytes32 batch_number:u64be durable_record_digest:bytes32; returned only after append and fsync; identical retry returns the same digest and conflicting retry is refused"
proof_material = "empty"
golden = "00010002001d0000000000000000000000011d00000000"

[message.30]
name = "SimulateRequest"
kind = "request"
capability = "simulate"
canonical_payload = "canonical signed LX_PROGRAMS_CALL activity bytes; executed against the current head through the programs runtime without any commit, journal, or queue mutation"
proof_material = "empty"
golden = "00010004001e0000000000000000000000011e00000000"

[message.31]
name = "SimulateResponse"
kind = "response"
capability = "simulate"
canonical_payload = "version:u16be=1 activity_id:bytes32 receipt_length:u32be receipt:bytes terminal_payload_length:u32be terminal_payload:bytes call_graph_length:u32be call_graph:bytes; the receipt is the sequencer-signed receipt of the noncommitted execution"
proof_material = "version:u16be=1 boundary_id:bytes32 activity_id:bytes32 previous_state_root:bytes32 hypothetical_state_root:bytes32 observed_sequence:u64be observed_at:u64be public_key:bytes32 signature:bytes64; boundary_id is sha256 of the domain LayerX/emulator/simulation-boundary/v1 with a NUL terminator followed by public_key; signature is the sequencer ed25519 signature over sha256 of the domain LayerX/agent/program-simulation-evidence/v1 with a NUL terminator followed by boundary_id, activity_id, previous_state_root, hypothetical_state_root, observed_sequence, observed_at and one zero byte"
