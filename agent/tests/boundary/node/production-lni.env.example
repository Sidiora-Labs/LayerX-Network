# Optional extension for `make agent-test-boundary`. These values make the
# Rust boundary client connect to an already-running production layerxd after
# its isolated fixture cases complete.
LAYERX_QUALIFY_LNI_SOCKET=/run/layerx/layerxd.lni.sock
LAYERX_QUALIFY_SIGNED_ACTIVITY=/secure/qualification/activity.lxp
LAYERX_QUALIFY_MAX_SIGNED_ACTIVITY=/secure/qualification/max-activity.lxp
LAYERX_QUALIFY_PROTOCOL_VERSION=2
LAYERX_QUALIFY_NETWORK_ID=1
LAYERX_QUALIFY_LNI_DEADLINE_MS=2000
LAYERX_QUALIFY_LNI_DAEMON_UID=1000
LAYERX_QUALIFY_LNI_CLIENT_GID=1001
