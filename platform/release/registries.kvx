[release]
registries = ["crates-io", "npm", "pypi", "go-modules", "maven-central", "swiftpm", "nuget"]
tag_format = "sdk-v{version}"
source_digest = "git-archive-sha256"
reference_applications = ["@sidiora/layerx-example-buyer-agent","@sidiora/layerx-example-marketplace","@sidiora/layerx-example-merchant-shop","@sidiora/layerx-example-paid-api"]

[registry.crates-io]
ecosystem = "rust"
artifact = "crate"
distribution = "https://crates.io"
signing = "sigstore-keyless"
provenance = "github-actions-attestation"
verification = "byte-compare-against-tagged-source"
packages = ["layerx-agent-api","layerx-client","layerx-crypto","layerx-mirror","layerx-programs-runtime","layerx-proof","layerx-sdk","layerx-types","layerx-wire"]
status = "active"

[registry.npm]
ecosystem = "typescript"
artifact = "npm-package"
distribution = "https://registry.npmjs.org"
signing = "sigstore-keyless"
provenance = "npm-provenance-attestation"
verification = "byte-compare-against-tagged-source"
packages = ["@sidiora/layerx-agent-integrations","@sidiora/layerx-agent-middleware","@sidiora/layerx-buyer-middleware","@sidiora/layerx-express","@sidiora/layerx-merchant-middleware","@sidiora/layerx-next","@sidiora/layerx-sdk","@sidiora/layerx-seller-middleware"]
status = "active"

[registry.pypi]
ecosystem = "python"
artifact = "wheel"
distribution = "https://pypi.org"
signing = "sigstore-keyless"
provenance = "pypi-trusted-publisher-attestation"
verification = "byte-compare-against-tagged-source"
packages = ["layerx-fastapi","layerx-sdk"]
status = "active"

[registry.go-modules]
ecosystem = "go"
artifact = "module-zip"
distribution = "https://proxy.golang.org"
signing = "git-tag-signature"
provenance = "go-checksum-database"
verification = "byte-compare-against-tagged-source"
packages = ["github.com/Sidiora-Labs/LayerX-Protocol/platform/sdk/go"]
status = "active"

[registry.maven-central]
ecosystem = "jvm"
artifact = "jar-and-pom"
coordinate = "com.sidiora.layerx:layerx-sdk"
languages = ["java","kotlin"]
module_name = "com.sidiora.layerx.sdk"
distribution = "https://repo1.maven.org/maven2"
signing = "pgp-detached-signature"
provenance = "github-actions-attestation"
verification = "byte-compare-against-tagged-source"
packages = ["com.sidiora.layerx:layerx-android","com.sidiora.layerx:layerx-sdk","com.sidiora.layerx:layerx-spring-boot-starter"]
status = "active"

[registry.swiftpm]
ecosystem = "swift"
artifact = "git-tag"
distribution = "https://github.com"
signing = "git-tag-signature"
provenance = "github-actions-attestation"
verification = "byte-compare-against-tagged-source"
packages = ["LayerXSDK"]
status = "active"

[registry.nuget]
ecosystem = "dotnet"
artifact = "nupkg"
distribution = "https://www.nuget.org"
signing = "nuget-repository-signature"
provenance = "github-actions-attestation"
verification = "byte-compare-against-tagged-source"
packages = ["LayerX.Sdk"]
status = "active"
