        }
      },
      "description": "Next sequence from the authenticated atomic node preparation snapshot; not a Merkle proof."
    },
    {
      "name": "lx_getProof",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "kind",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "activity",
              "receipt",
              "account"
            ]
          }
        },
        {
          "name": "activity_id",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        {
          "name": "account_id",
          "required": false,
          "description": "Required only when kind is account.",
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      ],
      "result": {
        "name": "proof",
        "schema": {
          "type": "object"
        }
      },
      "description": "Verified proof with canonical value and signed batch header. Account proofs export the exact verified native proof bytes without reconstruction."
    }
