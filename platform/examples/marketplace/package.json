{
  "name": "@sidiora/layerx-example-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.mjs --environment emulator --action deploy",
    "start:emulator": "node index.mjs --environment emulator --action deploy",
    "start:beta": "node index.mjs --environment beta --action deploy",
    "list:emulator": "node index.mjs --environment emulator --action list",
    "list:beta": "node index.mjs --environment beta --action list",
    "buy:emulator": "node index.mjs --environment emulator --action buy",
    "buy:beta": "node index.mjs --environment beta --action buy",
    "test": "node --check index.mjs && node test/deploy-payload.test.mjs"
  },
  "dependencies": {
    "@sidiora/layerx-sdk": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
