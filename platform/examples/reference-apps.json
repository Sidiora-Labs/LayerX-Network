        "emulator": ["npm", "run", "start:emulator", "--workspace", "@sidiora/layerx-example-marketplace"],
        "testnet": ["npm", "run", "start:testnet", "--workspace", "@sidiora/layerx-example-marketplace"]
      }
    }
