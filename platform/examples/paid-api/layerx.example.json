{
  "version": 1,
  "application": "paid-api",
  "environments": {
    "emulator": {
      "receiptAuthorityUrl": "http://127.0.0.1:9402",
      "resourceUrl": "http://127.0.0.1:8081/paid",
      "scheme": "exact",
      "network": "layerx:emulator",
      "protocolVersion": 3,
      "tokenEnvironment": "LAYERX_EMULATOR_TOKEN",
      "assetEnvironment": "LAYERX_EMULATOR_ASSET",
      "payToEnvironment": "LAYERX_EMULATOR_SELLER",
      "accountEnvironment": "LAYERX_EMULATOR_SELLER_ACCOUNT",
      "currencyEnvironment": "LAYERX_EMULATOR_CURRENCY",
      "priceEnvironment": "LAYERX_EMULATOR_PRICE",
      "resourceFile": "resource.json",
      "fulfillmentDirectory": "state/fulfillments",
      "port": 8081
    },
    "beta": {
      "receiptAuthorityUrl": "https://api.paxeer.network",
      "resourceUrl": "http://127.0.0.1:8081/paid",
      "scheme": "exact",
      "network": "layerx:beta",
      "protocolVersion": 3,
      "tokenEnvironment": "LAYERX_TESTNET_TOKEN",
      "assetEnvironment": "LAYERX_TESTNET_ASSET",
      "payToEnvironment": "LAYERX_TESTNET_SELLER",
      "accountEnvironment": "LAYERX_TESTNET_SELLER_ACCOUNT",
      "currencyEnvironment": "LAYERX_TESTNET_CURRENCY",
      "priceEnvironment": "LAYERX_TESTNET_PRICE",
      "resourceFile": "resource.json",
      "fulfillmentDirectory": "state/fulfillments",
      "port": 8081
    }
  }
}
