{
  "version": 1,
  "application": "merchant-checkout",
  "environments": {
    "emulator": {
      "publicUrl": "http://127.0.0.1:8082",
      "settlementUrl": "http://127.0.0.1:9402/v1/settle",
      "receiptAuthorityUrl": "http://127.0.0.1:9402",
      "scheme": "exact",
      "network": "layerx:emulator",
      "protocolVersion": 3,
      "tokenEnvironment": "LAYERX_EMULATOR_TOKEN",
      "webhookKeysEnvironment": "LAYERX_EMULATOR_WEBHOOK_PUBLIC_KEYS_JSON",
      "assetEnvironment": "LAYERX_EMULATOR_ASSET",
      "payToEnvironment": "LAYERX_EMULATOR_MERCHANT",
      "accountEnvironment": "LAYERX_EMULATOR_MERCHANT_ACCOUNT",
      "currencyEnvironment": "LAYERX_EMULATOR_CURRENCY",
      "priceEnvironment": "LAYERX_EMULATOR_PRICE",
      "stateDirectory": "state",
      "port": 8082
    },
    "beta": {
      "publicUrl": "http://127.0.0.1:8082",
      "settlementUrl": "https://api.layerx.network/v1/settle",
      "receiptAuthorityUrl": "https://api.layerx.network",
      "scheme": "exact",
      "network": "layerx:beta",
      "protocolVersion": 3,
      "tokenEnvironment": "LAYERX_TESTNET_TOKEN",
      "webhookKeysEnvironment": "LAYERX_TESTNET_WEBHOOK_PUBLIC_KEYS_JSON",
      "assetEnvironment": "LAYERX_TESTNET_ASSET",
      "payToEnvironment": "LAYERX_TESTNET_MERCHANT",
      "accountEnvironment": "LAYERX_TESTNET_MERCHANT_ACCOUNT",
      "currencyEnvironment": "LAYERX_TESTNET_CURRENCY",
      "priceEnvironment": "LAYERX_TESTNET_PRICE",
      "stateDirectory": "state",
      "port": 8082
    }
  }
}
