[registry]
name = "LayerX capability enforcement registry"
rule = "Every capability this documentation states carries the layer that actually enforces it. A lower layer never implies a higher one, and a restriction enforced above the protocol is never described as a protocol guarantee."
layers = ["protocol","agent-layer","service","hosted-surface"]

[capability.atomic-settlement]
title = "Atomic settlement"
enforcement = "protocol"
surface = "Every payment you commit"
statement = "An activity applies completely or not at all. There is no partial-transfer transition, so no client, daemon, gateway or middleware above the protocol can produce a half-applied payment."

[capability.conserved-supply]
title = "Conserved supply"
enforcement = "protocol"
surface = "Every balance you read"
statement = "The kernel transfer primitive is the only path that mutates a balance. A state change outside an authenticated 402LXP transfer aborts the transition, so total supply is conserved by construction rather than by reconciliation."

[capability.replay-refusal]
title = "Replay refusal"
enforcement = "protocol"
surface = "Every retry your code makes"
statement = "Each principal's activity sequence is consumed exactly once. Resubmitting an already-applied activity is refused by the transition function, so a retried network call cannot pay twice."

[capability.offline-receipt-verification]
title = "Offline receipt verification"
enforcement = "protocol"
surface = "layerx receipt verify, and the verify APIs in every SDK"
statement = "A receipt verifies from its own bytes against an authorised batch header: canonical encoding, protocol invariants, root chain and signature. Verification needs no LayerX node, gateway or hosted service, so a settlement claim can be checked by someone who trusts none of them."

[capability.budget-ceiling]
title = "Protocol budget ceilings"
enforcement = "protocol"
surface = "Agent spend limits backed by the budget module"
statement = "A budget is a protocol object in the budget module. Spending past a funded budget is refused by the transition function, so the ceiling holds even against an agent runtime that has been fully compromised."

[capability.program-money-law]
title = "Programs never write balances"
enforcement = "protocol"
surface = "Every LayerX Program you deploy or call"
statement = "Guest program code receives no balance-writing authority. Its only monetary exit is a typed 402LXP transfer request bound to the invoking activity's authority and applied by the kernel primitive, so a hostile program cannot move money its caller could not move."

[capability.program-failure-rollback]
title = "Typed program failure with rollback"
enforcement = "protocol"
surface = "Every program activity receipt"
statement = "A program that traps, returns a malformed result or exhausts its metered budget has every state write discarded, its sequence consumed and its metered fee charged, and the receipt carries the typed failure. A program cannot stall or crash a node."

[capability.deterministic-programs]
title = "Deterministic program execution"
enforcement = "protocol"
surface = "Every node that replays your program"
statement = "The programs runtime denies clocks, networking, filesystem, floating point, threads, randomness and ambient authority, and records the runtime and ABI version in the receipt. Replay executes under the recorded version, so an upgrade never rewrites history."

[capability.adapter-boundary]
title = "Interop adapters hold no protocol authority"
enforcement = "protocol"
surface = "x402, AP2, UCP, A2A, MCP and card, bank or RTP flows"
statement = "An adapter translates an external protocol at the edge and then submits an ordinary authenticated activity. It never gains authority the submitting principal lacks, so a compromised adapter cannot produce a settlement the protocol would refuse."

[capability.capability-attenuation]
title = "Capability attenuation"
enforcement = "agent-layer"
surface = "capability.create, capability.attenuate and capability.revoke"
statement = "layerx-agentd refuses a request that falls outside the presented capability and lets you narrow or revoke one at any time. This binds callers that go through the daemon; a principal reaching the protocol another way is bound by protocol budgets, not by this."

[capability.approval-holds]
title = "Approval holds"
enforcement = "agent-layer"
surface = "The approval inbox and the approval.* operations"
statement = "The agent layer can hold an activity for human approval, carrying the held activity's structured disclosure, its canonical-bytes digest, its hold reason and a deterministic expiry. The hold exists while the daemon is in the request path."

[capability.verification-honesty]
title = "Honest verification levels"
enforcement = "agent-layer"
surface = "Every protocol fact an SDK returns"
statement = "Every successful response carries its verification status, and a shortfall is reported rather than silently downgraded. No layer reports a level its evidence does not justify."

[capability.unknown-outcome]
title = "Unknown is a real outcome"
enforcement = "agent-layer"
surface = "submit, track and wait"
statement = "When a submission cannot be classified, the answer is Unknown - a terminal-pending state you resolve by tracking, never a guessed success or a guessed failure."

[capability.agent-tenancy]
title = "Agent tenancy isolation"
enforcement = "agent-layer"
surface = "Sessions opened for each agent"
statement = "Each session is scoped to its agent's tenancy and the daemon refuses cross-tenancy reads and writes. It is an agent-layer boundary, not a protocol one."

[capability.quote-then-commit]
title = "Quote then commit"
enforcement = "service"
surface = "move.quote and move.commit"
statement = "A quote states the fee estimate with its ceiling, the arrival expectation and any irreversibility before anything moves, and the commit turns exactly that quote into a journey. The human service enforces the ordering; callers of that service are bound by it."

[capability.idempotent-money-moves]
title = "Idempotent money moves"
enforcement = "service"
surface = "The Idempotency-Key header on every money-moving mutation"
statement = "layerx-human-service requires the header on every mutation that could move money and returns the original journey when the request repeats, so a retry after a timeout cannot create a second effect."

[capability.evidence-backed-done]
title = "Done means verified"
enforcement = "service"
surface = "Journey states and the evidence references they carry"
statement = "The human service reports a journey as done only against a verified LayerX receipt or a Paxeer finality proof, and every figure it renders travels with the verification level behind it."

[capability.payment-gate]
title = "Receipt-gated resource release"
enforcement = "service"
surface = "The seller middleware and the framework integrations you deploy"
statement = "The middleware releases your protected resource only after it verifies the receipt covering the request against an authorised batch. It binds requests that reach your service through the middleware."

[capability.fulfillment-idempotence]
title = "Exactly-once fulfilment"
enforcement = "service"
surface = "The fulfilment repository you hand to the middleware"
statement = "A repeated payment with the same idempotency key returns the stored fulfilment, and a repeat carrying a different request digest is refused as a conflict. The guarantee is only as durable as the repository you supply."

[capability.webhook-verification]
title = "Verified, replay-protected webhooks"
enforcement = "service"
surface = "The webhook endpoint the integration mounts in your process"
statement = "Deliveries are verified by signature against your configured public keys, refused when stale, and claimed under a lease so a redelivery is processed once. Your delivery store decides whether that survives a restart."

[capability.no-published-secrets]
title = "Refusal to publish a secret"
enforcement = "service"
surface = "The mobile bindings and the Next.js bundle scanner"
statement = "The mobile configuration accepts publishable values only, and the Next.js scanner fails a build whose client bundle contains a declared secret. Client code holds a brokered ephemeral session token, never a long-lived key."

[capability.api-keys]
title = "API keys, usage and request logs"
enforcement = "hosted-surface"
surface = "The developer dashboard"
statement = "Key issuance, rotation, usage counters, request logs and webhook delivery logs are controls of the hosted deployment. They bind traffic arriving through the hosted gateway."

[capability.hosted-rate-limits]
title = "Hosted rate limits"
enforcement = "hosted-surface"
surface = "The gateway response to a burst"
statement = "The gateway refuses excess traffic with a rate-limit error carrying honest retry timing. It is an operational control on the hosted deployment, not a property of the protocol."

[capability.faucet-funding]
title = "Beta faucet funding"
enforcement = "hosted-surface"
surface = "The beta faucet"
statement = "The faucet decides who may draw test funds and how much. Test funds are ordinary protocol balances once issued; the eligibility rule lives entirely in the hosted surface."

[capability.beta-reset]
title = "Scheduled beta resets"
enforcement = "hosted-surface"
surface = "The published beta reset calendar"
statement = "The hosted beta network is reset on a published schedule and every balance, agent and receipt from the previous epoch is discarded. Nothing on the beta network is durable and no protocol rule promises otherwise."

[capability.status-page]
title = "Honest degradation reporting"
enforcement = "hosted-surface"
surface = "The status page"
statement = "The status page distinguishes gateway, network, core and Paxeer-side degradation instead of collapsing them into one indicator, so you can tell whose outage you are seeing."
