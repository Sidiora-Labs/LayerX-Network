{
  "name": "@sidiora/layerx-next",
  "version": "0.1.0",
  "description": "One-call LayerX x402 route mount and client-bundle secret scanner for Next.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidiora-Labs/LayerX-Protocol.git",
    "directory": "platform/integrations/next"
  },
  "type": "module",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
