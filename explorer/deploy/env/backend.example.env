# Backend (Blockscout release) environment for the local stack.
#
# docker-compose.local.yml reads this file verbatim and then overrides the
# wiring that depends on the compose network: DATABASE_URL, the four
# ETHEREUM_JSONRPC_* endpoints, the two MICROSERVICE_* URLs, CHAIN_ID,
# SECRET_KEY_BASE and PORT. Do not set those here; set CHAIN_ID,
# SECRET_KEY_BASE, RPC_HTTP_URL and RPC_WS_URL in the host environment.
#
# Every name used below also exists in
# explorer/backend/docker-compose/envs/common-blockscout.env, which is the
# upstream catalogue of every backend variable.

# --- node and transport ---------------------------------------------------
# paxeer_x is the Paxeer X Network adapter: it maps the Cosmos-originated
# transaction type into the transactions.type column, refetches a new head by
# hash instead of trusting the notification, and reads eth_syncing's refusal as
# synced. Tracing is delegated to the geth variant unchanged.
ETHEREUM_JSONRPC_VARIANT=paxeer_x
PAXEER_X_COSMOS_TRANSACTION_TYPE=127
PAXEER_X_NATIVE_COIN_DECIMALS=18
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=true
ETHEREUM_JSONRPC_HTTP_TIMEOUT=30

# --- node request guard ---------------------------------------------------
# The explorer indexes one full node, so every request it makes passes a
# per-endpoint guard: a global in-flight cap, a per-second token bucket, and
# tighter caps for tracing and for historical state reads. Callers that cannot
# be admitted queue in arrival order; nothing is dropped.
ETHEREUM_JSONRPC_THROTTLE_MAX_INFLIGHT=32
ETHEREUM_JSONRPC_THROTTLE_RPS=200
ETHEREUM_JSONRPC_THROTTLE_TRACE_MAX_INFLIGHT=4
ETHEREUM_JSONRPC_THROTTLE_ARCHIVE_MAX_INFLIGHT=8
ETHEREUM_JSONRPC_THROTTLE_COALESCE_ENABLED=true

# --- Paxeer X surfaces ----------------------------------------------------
# Capability discovery probes eth_getCode at the LayerX precompiles and one
# eth_call at the addr precompile, so a surface is offered only once the chain
# actually carries it. The settlement ladder turns the anchor's checkpoints
# into the sealed and final rungs; PAXEER_X_FINAL_CONFIRMATIONS is the
# confirmation-count fallback for the final rung and 0 leaves it off.
PAXEER_X_CAPABILITIES_ENABLED=true
PAXEER_X_CAPABILITIES_REFRESH_SECONDS=30
PAXEER_X_FINALITY_CACHE_MS=1000
PAXEER_X_FINALITY_PROBE_BATCHES=16
PAXEER_X_FINAL_CONFIRMATIONS=0

# --- database pools -------------------------------------------------------
POOL_SIZE=40
POOL_SIZE_API=20
ECTO_USE_SSL=false

# --- web endpoint ---------------------------------------------------------
NETWORK=Paxeer X Network
SUBNETWORK=Paxeer X Network
DISABLE_WEBAPP=true
API_V2_ENABLED=true
API_V1_READ_METHODS_DISABLED=false
API_V1_WRITE_METHODS_DISABLED=false
ADMIN_PANEL_ENABLED=false
API_RATE_LIMIT_DISABLED=true
RE_CAPTCHA_DISABLED=true
CHECKSUM_ADDRESS_HASHES=true

# --- native coin ----------------------------------------------------------
# COIN and COIN_NAME are display labels; the ledger denomination and its
# scaling are a property of the chain, not of the explorer.
COIN=PAX
COIN_NAME=PAX
DISABLE_MARKET=true
COIN_BALANCE_HISTORY_DAYS=90

# --- indexer --------------------------------------------------------------
DISABLE_INDEXER=false
DISABLE_REALTIME_INDEXER=false
DISABLE_CATCHUP_INDEXER=false
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
INDEXER_DISABLE_ARCHIVAL_TOKEN_BALANCES_FETCHER=true
INDEXER_DISABLE_WITHDRAWALS_FETCHER=true
INDEXER_MEMORY_LIMIT=4Gb
# The chain produces blocks several times a second; these are the fork's own
# defaults, large enough for catchup to outrun the head.
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=100
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=20
# The node keeps trace state for the last 10000 blocks, so pending operations
# below head minus this window are dropped instead of retried forever. 0
# disables the rule.
INDEXER_INTERNAL_TRANSACTIONS_LOOKBACK_BLOCKS=9000
INDEXER_RECEIPTS_BATCH_SIZE=250
INDEXER_RECEIPTS_CONCURRENCY=10
INDEXER_COIN_BALANCES_BATCH_SIZE=500
INDEXER_COIN_BALANCES_CONCURRENCY=4

# --- microservices --------------------------------------------------------
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_TYPE=sc_verifier
MICROSERVICE_SIG_PROVIDER_ENABLED=true
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED=false
MICROSERVICE_BENS_ENABLED=false
MICROSERVICE_METADATA_ENABLED=false

# --- accounts and media ---------------------------------------------------
ACCOUNT_ENABLED=false
NFT_MEDIA_HANDLER_ENABLED=false

# --- runtime --------------------------------------------------------------
DISABLE_FILE_LOGGING=true
HEART_BEAT_TIMEOUT=30
TXS_STATS_DAYS_TO_COMPILE_AT_INIT=10
