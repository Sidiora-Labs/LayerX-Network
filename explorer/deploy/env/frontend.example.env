# Frontend (Next.js) environment for the local stack.
#
# docker-compose.local.yml reads this file verbatim and then overrides the
# values that depend on where the stack is published: NEXT_PUBLIC_NETWORK_ID,
# NEXT_PUBLIC_API_HOST, NEXT_PUBLIC_API_PORT, NEXT_PUBLIC_APP_HOST,
# NEXT_PUBLIC_APP_PORT and PORT. Set CHAIN_ID in the host environment; the
# compose file feeds it to NEXT_PUBLIC_NETWORK_ID.
#
# Every name used below also exists in
# explorer/backend/docker-compose/envs/common-frontend.env or in
# explorer/frontend/docs/ENVS.md, which is the full upstream catalogue.
#
# The image validates these on start (deploy/scripts/validate_envs.sh); a name
# that the schema does not know, or a required name left empty, stops the
# container instead of being ignored.
#
# One more name belongs to the deployment rather than to the image and is
# therefore not set here: EXPLORER_IMAGE_TAG picks which published image runs.
# It is the tag of ghcr.io/sidiora-labs/paxeer-x-explorer-frontend, the image
# .github/workflows/explorer-images.yml publishes - `latest` or `main` for the
# main branch, `sha-<short commit>` to pin one build. docker-compose.local.yml
# defaults it to `latest`; on Railway it is part of the service's image source.
#
# No value in this file is an endpoint, a credential or a host. Each of those
# enters through the host environment or the deployment's variable store.

# --- how the browser reaches the backend ----------------------------------
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws
NEXT_PUBLIC_APP_PROTOCOL=http

# --- network identity -----------------------------------------------------
NEXT_PUBLIC_NETWORK_NAME=Paxeer X Network
NEXT_PUBLIC_NETWORK_SHORT_NAME=Paxeer X
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=PAX
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=PAX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_IS_TESTNET=true
# The frontend's chain type: it turns on the Paxeer X Network surfaces - the
# unified account page and the settlement status shown next to a block or a
# transaction - and it is the counterpart of CHAIN_TYPE=paxeer_x in
# env/backend.example.env. The backend's JSON-RPC variant and its capability
# probe have no frontend setting: which surfaces a page offers comes from
# /api/v2/paxeer-x/capabilities, which answers false for every surface while
# the probe is off.
NEXT_PUBLIC_PAXEER_X_ENABLED=true

# --- user interface -------------------------------------------------------
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_HIDE_INDEXING_ALERT_BLOCKS=false
NEXT_PUBLIC_HAS_CONTRACT_AUDIT_REPORTS=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
