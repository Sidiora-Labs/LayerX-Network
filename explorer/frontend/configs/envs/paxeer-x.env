# Paxeer X Network explorer — run-time ENV preset.
#
# This file is the tracked source of truth. The container entrypoint reads
# ./configs/envs/.env.$ENVS_PRESET, so a deployment copies this file to
# configs/envs/.env.paxeer-x (dotfile name) and builds with ENVS_PRESET=paxeer-x.
#
# Deployment inputs: REPLACE_API_HOST and REPLACE_APP_HOST must be substituted
# with the deployment's own hosts before the container starts.

# App
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=REPLACE_APP_HOST
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_INSTANCE=paxeer-x

# API
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=REPLACE_API_HOST
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# Chain
NEXT_PUBLIC_NETWORK_NAME=Paxeer X Network
NEXT_PUBLIC_NETWORK_SHORT_NAME=Paxeer X
NEXT_PUBLIC_NETWORK_ID=125
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Pax
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=PAX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_IS_TESTNET=false

# Branding
NEXT_PUBLIC_NETWORK_LOGO=file:///app/public/static/paxeer-x/logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=file:///app/public/static/paxeer-x/logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=file:///app/public/static/paxeer-x/icon.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=file:///app/public/static/paxeer-x/icon-dark.svg
NEXT_PUBLIC_COLOR_THEME_OVERRIDES={'hover':{'_light':{'value':'rgb(61,47,214)'},'_dark':{'value':'rgb(111,99,242)'}},'link':{'primary':{'_light':{'value':'rgb(61,47,214)'},'_dark':{'value':'rgb(143,134,247)'}}},'graph':{'line':{'_light':{'value':'rgb(61,47,214)'},'_dark':{'value':'rgb(111,99,242)'}},'gradient':{'start':{'_light':{'value':'rgba(61,47,214,0.3)'},'_dark':{'value':'rgba(111,99,242,0.3)'}},'stop':{'_light':{'value':'rgba(61,47,214,0)'},'_dark':{'value':'rgba(111,99,242,0)'}}}}}

# Meta
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_OG_DESCRIPTION=Explorer for Paxeer X Network: blocks, transactions, accounts, contracts and the LayerX kernel domain.

# Navigation — the only two external links this deployment carries
NEXT_PUBLIC_OTHER_LINKS=[{'text':'Paxeer X Network','url':'https://paxeer.app'},{'text':'GitHub','url':'https://github.com/Sidiora-Labs/Paxeer-X-Network'}]

# Homepage
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses','gas_tracker']

# Misc — no market data source is configured for the native coin
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true

# Disabled third-party surfaces
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# Paxeer X unified surfaces
NEXT_PUBLIC_PAXEER_X_ENABLED=true
