# Paxeer X Network explorer — run-time ENV preset.
#
# This file is the tracked source of truth. The container entrypoint reads
# ./configs/envs/.env.$ENVS_PRESET, so a deployment copies this file to
# configs/envs/.env.paxeer-x (dotfile name) and builds with ENVS_PRESET=paxeer-x.
#
# Deployment inputs: REPLACE_API_HOST and REPLACE_APP_HOST must be substituted
# with the deployment's own hosts before the container starts.

# App
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=REPLACE_APP_HOST
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_INSTANCE=paxeer-x

# API
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=REPLACE_API_HOST
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# Chain
NEXT_PUBLIC_NETWORK_NAME=Paxeer X Network
NEXT_PUBLIC_NETWORK_SHORT_NAME=Paxeer X
NEXT_PUBLIC_NETWORK_ID=125
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Paxeer
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=PAX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_IS_TESTNET=false

# Branding
NEXT_PUBLIC_NETWORK_LOGO=file:///app/public/static/paxeer-x/logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=file:///app/public/static/paxeer-x/logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=file:///app/public/static/paxeer-x/icon.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=file:///app/public/static/paxeer-x/icon-dark.svg
NEXT_PUBLIC_COLOR_THEME_OVERRIDES={'bg':{'primary':{'_light':{'value':'#F8F8F8'},'_dark':{'value':'#101112'}},'surface':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#171923'}},'sunken':{'_light':{'value':'#F0F0F0'},'_dark':{'value':'rgba(255, 255, 255, 0.06)'}},'overlay':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#171923'}}},'text':{'primary':{'_light':{'value':'#0A0A0A'},'_dark':{'value':'rgba(255, 255, 255, 0.80)'}},'secondary':{'_light':{'value':'#585858'},'_dark':{'value':'#A0AEC0'}},'muted':{'_light':{'value':'#6B6B6B'},'_dark':{'value':'#718096'}}},'border':{'divider':{'_light':{'value':'#E6E6E6'},'_dark':{'value':'rgba(255, 255, 255, 0.06)'}},'strong':{'_light':{'value':'#D4D4D4'},'_dark':{'value':'#4A5568'}}},'accent':{'primary':{'_light':{'value':'#0965E8'},'_dark':{'value':'#63B3ED'}},'strong':{'_light':{'value':'#0060F8'},'_dark':{'value':'#90CDF4'}},'soft':{'_light':{'value':'#E9F1FE'},'_dark':{'value':'#2A4365'}}},'hover':{'_light':{'value':'#0060F8'},'_dark':{'value':'#90CDF4'}},'selected':{'control':{'text':{'_light':{'value':'#0060F8'},'_dark':{'value':'#F7FAFC'}},'bg':{'_light':{'value':'#E9F1FE'},'_dark':{'value':'rgba(255, 255, 255, 0.04)'}}},'option':{'bg':{'_light':{'value':'#0965E8'},'_dark':{'value':'#3182CE'}}}},'icon':{'primary':{'_light':{'value':'#585858'},'_dark':{'value':'#A0AEC0'}},'secondary':{'_light':{'value':'#6B6B6B'},'_dark':{'value':'#718096'}}},'button':{'primary':{'_light':{'value':'#000000'},'_dark':{'value':'#FFFFFF'},'text':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#101112'}},'hover':{'_light':{'value':'#1F1F1F'},'_dark':{'value':'#E2E8F0'}}}},'link':{'primary':{'_light':{'value':'#0965E8'},'_dark':{'value':'#63B3ED'}}},'graph':{'line':{'_light':{'value':'#0965E8'},'_dark':{'value':'#90CDF4'}},'gradient':{'start':{'_light':{'value':'rgba(9, 101, 232, 0.3)'},'_dark':{'value':'rgba(144, 205, 244, 0.3)'}},'stop':{'_light':{'value':'rgba(9, 101, 232, 0)'},'_dark':{'value':'rgba(144, 205, 244, 0)'}}}},'navigation':{'bg':{'selected':{'_light':{'value':'#E9F1FE'},'_dark':{'value':'#1A202C'}}},'text':{'selected':{'_light':{'value':'#0060F8'},'_dark':{'value':'#F7FAFC'}}}},'stats':{'bg':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'rgba(255, 255, 255, 0.06)'}}},'topbar':{'bg':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'rgba(255, 255, 255, 0.06)'}}},'tabs':{'text':{'primary':{'_light':{'value':'#0060F8'},'_dark':{'value':'#BEE3F8'}}}},'table':{'header':{'bg':{'_light':{'value':'#F0F0F0'},'_dark':{'value':'rgba(255, 255, 255, 0.08)'}},'fg':{'_light':{'value':'#6B6B6B'},'_dark':{'value':'rgba(255, 255, 255, 0.64)'}}}},'feedback':{'success':{'fg':{'_light':{'value':'#256B34'},'_dark':{'value':'#9AE6B4'}},'bg':{'_light':{'value':'#E8F5EA'},'_dark':{'value':'#22543D'}}},'error':{'fg':{'_light':{'value':'#B42318'},'_dark':{'value':'#FEB2B2'}},'bg':{'_light':{'value':'#F8E8E8'},'_dark':{'value':'#822727'}}},'warning':{'fg':{'_light':{'value':'#774700'},'_dark':{'value':'#FEEBCB'}},'bg':{'_light':{'value':'#FDF3E3'},'_dark':{'value':'#7B341E'}}}}}
NEXT_PUBLIC_COLOR_THEME_DEFAULT=light
NEXT_PUBLIC_FONT_FAMILY_HEADING={'name':'Manrope','url':'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap'}
NEXT_PUBLIC_FONT_FAMILY_BODY={'name':'Manrope','url':'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap'}

# Meta
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_OG_DESCRIPTION=Explorer for Paxeer X Network: blocks, transactions, accounts, contracts and the LayerX kernel domain.

# Navigation — the only two external links this deployment carries
NEXT_PUBLIC_OTHER_LINKS=[{'text':'Paxeer X Network','url':'https://paxeer.app'},{'text':'GitHub','url':'https://github.com/Sidiora-Labs/Paxeer-X-Network'}]

# Homepage
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses','gas_tracker']

# Misc — no market data source is configured for the native coin
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true

# Disabled third-party surfaces
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# Paxeer X unified surfaces
NEXT_PUBLIC_PAXEER_X_ENABLED=true
