# spec.kvx - the Paxeer X Network bridge contracts and the tooling that deploys
# them to every major EVM mainnet and to Solana. SINGLE SOURCE OF TRUTH for
# this feature.
#
# requirements.md / design.md / tasks.md next to this file are GENERATED from it
# by spec/specgen. Never hand-edit those; edit this file and regenerate.
#
# Drive the work with:  cg spec next -> cg spec start <id> -> cg spec done <id>
#
# The chain half of this bridge already exists and is frozen: the layerxBridge
# precompile at 0x0000000000000000000000000000000000001016, the two attestation
# preimages, the secp256k1 signature rules and the tokenfactory denom scheme are
# fixed inputs this feature reads and never edits. What is missing is the far
# side: one production custody contract for every EVM mainnet, one production
# custody program for Solana, the relayer's Solana half, and the per-chain
# configuration, deployment, governance and read-back tooling that turns them
# into a deployment the owner can run. Wave 1 builds those foundations in
# parallel, wave 2 integrates them, wave 3 runs the gate once.

[meta]
feature   = "paxeer-x-bridge"
title     = "Paxeer X Network bridge contracts and deployment"
kind      = "product-feature-specification"
version   = "0.1.0"
status    = "draft"
language  = "Solidity (the EVM custody vault and its Foundry tests under bridge/evm), Rust (the Solana custody program under bridge/solana and the relayer under interop/crates/layerx-bridge-relayer), Go (the shared identity vectors under bridge/vectors and the configuration and governance tooling under bridge/deploy), Bash (the per-chain deploy, verify and checklist scripts), JSON (per-chain configuration, the attestor-set manifest, recorded fixtures), YAML (one CI workflow), Markdown (the operator runbook, the per-chain pages and the Solana attestation document)"
repo_root = "bridge/evm (the Foundry project: src, test, script, chains, lib and the library bootstrap); bridge/solana (the raw solana-program crate and its program tests); bridge/deploy (the configuration schema, the governance proposal generator, the per-chain deploy and verify scripts, the attestor-set manifest and the post-deploy checklist runner); bridge/vectors (the shared identity and digest vectors, asserted against the chain's own preimage builders); bridge/README.md and bridge/ATTESTATION-SOLANA.md (the operator runbook and the Solana identity document); interop/crates/layerx-bridge-relayer (the relayer's Solana observer and submitter); .github/workflows/bridge-test.yml (one workflow); spec/paxeer-x-bridge/ (this feature and its qualification log)"
upstream  = "The Paxeer side is finished and frozen. modules/layerxbridge holds the keeper, the attestation preimages, the nullifier set, the per-asset caps, the pause and the governance messages; precompiles/layerxbridge/LayerXBridge.sol is the ABI at 0x0000000000000000000000000000000000001016; modules/layerxbridge/ATTESTATION.md is the byte-exact digest specification and modules/layerxbridge/types/keys.go fixes the tokenfactory denom scheme and Sidiora's remote address. A full freeze on chain changes is in force, so this feature reads all of that and edits none of it. interop/crates/layerx-bridge-relayer already observes EVM chains, signs attestations through the remote signer and submits both halves; this feature adds a Solana observer and submitter beside its existing ones and changes no existing loop. interop/contracts/solana-mirror is the repository's pattern for a raw solana-program crate and interop/deploy/mirror is its pattern for deployment scripting and their offline check scripts."
intro     = "The bridge is lock and release, both ways, everywhere. A foreign chain locks a deposit and the Paxeer precompile mints the bridged denom against a threshold of attestor signatures; a Paxeer burn of that denom is attested and the foreign chain releases the locked funds. The precompile's mint and burn are the Paxeer-side equivalent of a lock and a release and need no new concept. This feature builds the far side of that sentence as production code: one PaxeerXVault source deployed as identical bytecode to ethereum, base, arbitrum, optimism, bnb, polygon, avalanche and hyperevm, with per-chain differences confined to a configuration file; one Solana custody program that verifies the same outbound digest through the native secp256k1 program; the relayer's Solana observer and submitter; and the tooling - per-chain configuration, deploy and verify scripts, governance proposal generators, an attestor-set manifest, a post-deploy checklist that reads the chain back and compares it with the configuration - that makes a deployment repeatable. The default pair on every foreign chain is PAX against that chain's native coin, so the native coin is the first, always-registered asset of every chain: address(0) on the EVM chains through depositNative and the native release path, and the wrapped SOL mint on Solana. Sidiora exists today on exactly two chains, Paxeer X and Solana, and its Solana mint is registered with the asset id the chain already fixed for it, so an inbound SID deposit resolves to the usid denom the bridge module already administers. Nothing in this feature mints a wrapped asset, and nothing in it touches the chain."

# Decisions locked before implementation begins. They bind every task in this
# feature and are not reopened by a task.
[decision]
code_quality        = "A+ on every changed path: real code paths, real types, real fixtures. No stub, mock or fake test double on a production path, no placeholder implementation, no TODO, FIXME or 'for now' comment, no dead branch left for later. A test exercises the contract, program, package or script it names through its real entry point with data shaped like production data. Where a program test needs a cluster, it uses solana-program-test; where a script test needs a node, it uses anvil, solana-test-validator or a recorded fixture in the format the relayer's tests already use."
chain_frozen        = "ZERO changes to the chain. No task edits, adds or removes a file under modules/, precompiles/, node/ or consensus/, and no task changes api/ or any generated *.pb.go. A full freeze on chain changes is in force and this feature is entirely outside it. The consequence is recorded rather than fixed: modules/layerxbridge/ATTESTATION.md and modules/layerxbridge/types/attestation.go name interop/contracts/ethereum-bridge, which task 1.1 moves, so task 1.1 appends one observation to spec/paxeer-x-bridge/qualification.kvx naming those two stale references and leaves both files untouched for the first authorised chain change to correct."
attestation_fixed   = "The attestation contract is a fixed input, copied from nothing and changed by nothing. The inbound preimage is the 196 bytes of domain PAXEERX_BRIDGE_IN_V1, chainId as uint256, the 20-byte vault, the 32-byte txHash, the uint64 logIndex, the 32-byte recipient, the 20-byte asset and the uint256 amount; the outbound preimage is the 185 bytes of domain PAXEERX_BRIDGE_OUT_V1, chainId, vault, paxeerTxHash, paxeerNonce, the 20-byte recipient, the 20-byte asset and amount; the digest is keccak256 of the preimage with no EIP-191 prefix and no EIP-712 domain; each signature is 65 bytes r then s then v with v in 27 or 28, s at or below half the secp256k1 order, ordered by strictly ascending recovered signer, every signer a current attestor, at least threshold of them; the nullifier is consumed once. The bridged denom is the tokenfactory denom of the bridge module account for the (chain, asset) pair, except Sidiora, which the chain already fixes to the usid subdenom. modules/layerxbridge/ATTESTATION.md remains the byte-exact specification of all of it."
attestor_keys       = "Attestor keys are secp256k1 on every chain, Solana included. There is one attestor set, one threshold and one signature format across the whole bridge, so an attestor signs one digest and every destination accepts it. On Solana the program verifies those signatures through the native secp256k1 program by introspecting the instructions sysvar; it never carries its own elliptic-curve code and never accepts an ed25519 attestation. The ed25519 keys on Solana pay transaction fees and nothing else."
solana_identity     = "Solana identities enter the digests as 20-byte handles. The handle of any 32-byte Solana key is the last 20 bytes of keccak256 of that key. The vault registered on Paxeer for Solana is the handle of the bridge program's vault-authority PDA. An asset's 20 bytes come from the program's owner-set asset registry: the default for a mint is the handle of the mint, and the owner may register an explicit id instead. An inbound txHash is keccak256 of the 64-byte Solana transaction signature. An inbound logIndex is the deposit's monotonically increasing nonce, recorded in a deposit-receipt PDA. An outbound release takes the recipient's full 32-byte pubkey and the program derives the 20-byte recipient of the signed digest from it, so a release can pay only the key the attestors signed for. Solana's chain id on the Paxeer side is the reserved uint64 91600046870081, the big-endian value of the ASCII bytes SOLANA left-padded to eight bytes (0x0000534f4c414e41); it is far above every EIP-155 chain id in use and cannot collide with one, and governance registers it like any other chain."
sidiora_scope       = "Sidiora exists on exactly two chains: Paxeer X, where it is the bank-backed pointer at 0x21f7b20a555199fa73A238B1a91FD0f549068fEe over the usid denom with six decimals, and Solana, where it is the SPL mint 5w3wVdJaESaJKyLmStM6Hv9UyUkmZ1b9DLQquAqqpump with six decimals. Solana is Sidiora's foreign home. The Solana asset registry therefore registers that mint with the explicit asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe, because EnsureSidioraDenom in modules/layerxbridge/keeper/sidiora.go registers the bridged asset (chain id, 0x21f7b20a555199fa73A238B1a91FD0f549068fEe, usid) and governance will call it with the Solana chain id. Sidiora on the EVM mainnets is out of scope: the chain maps one denom per (chain, asset) pair, so SID admitted from Ethereum would land as a denom other than usid, and an alias is a chain change the halt forbids."
native_pair         = "The default pair on every foreign chain is PAX against that chain's native coin, and the native coin is the first asset of every chain configuration, always registered. On an EVM chain it is the asset id address(0), deposited through depositNative and released through the native release path; on Solana it is the wrapped SOL mint So11111111111111111111111111111111111111112 with its derived handle and nine decimals. Native-coin bridging is lock and release with a tokenfactory denom on Paxeer, exactly what the precompile does today. PAX itself does not leave Paxeer through this bridge and no vault in this feature has a mint mode: wrapped PAX on a foreign chain, like Sidiora on the EVM mainnets, is a governed upgrade after the freeze and appears nowhere in this feature's code."
layout              = "The bridge lives at the repository root. bridge/evm is the Foundry project - src, test, script, chains/<name>/config.json with a README.md per chain, and lib populated by a bootstrap script - created by moving interop/contracts/ethereum-bridge with git mv so its history follows it. bridge/solana is the raw solana-program crate, its chains/solana configuration and its program tests. bridge/deploy holds the configuration schema and validator, the governance proposal generator, the attestor-set manifest, the per-chain deploy and verify scripts, the post-deploy checklist runner and the offline check scripts that test them. bridge/vectors holds the shared identity and digest vectors. bridge/README.md is the operator runbook and bridge/ATTESTATION-SOLANA.md is the Solana identity document."
one_bytecode        = "Every EVM chain deploys the same PaxeerXVault bytecode from one source. Per-chain differences live only in bridge/evm/chains/<name>/config.json - the chain id, the native coin's symbol and decimals, the name of the environment variable carrying the RPC endpoint, the name of the environment variable carrying the explorer verification key, the owner address, the attestor set and threshold, the per-asset caps and the finality depth - and never in Solidity. No chain gets a branch, a conditional, an override or a second contract."
fail_closed         = "Owner and attestor addresses in a committed configuration are placeholders, and every tool refuses to use a placeholder. A deploy script, a proposal generator or a checklist runner that reads a placeholder owner, a placeholder attestor, a zero address, a zero threshold or a zero cap stops with a message naming the file and the field. There is no default owner, no default attestor and no silent substitution anywhere, and no fake address is ever committed in a position a tool would accept."
evm_vault           = "PaxeerXVault stays non-upgradeable with no proxy surface, and its wire format does not move: the BridgeDeposit and BridgeRelease events, the deposit, depositNative and release signatures, and the two digest views keep the exact bytes the relayer's abi.rs constants declare, asserted in the vault's own tests. The hardening is internal: OpenZeppelin v5.3.0 SafeERC20, ReentrancyGuard and Ownable2Step so ownership moves in two steps; no permit path; the received amount measured as a balance delta so a fee-on-transfer token cannot desync custody from the amount the Paxeer side mints; explicit NATIVE_ASSET handling; a rescue path that moves only a token that was never registered for bridging; and no EIP-165 surface. forge-std v1.9.6 and openzeppelin-contracts v5.3.0 are cloned into bridge/evm/lib by a bootstrap script and by the CI job, exactly as .github/workflows/paxeer-forge-test.yml clones them, and are never committed."
solana_program      = "bridge/solana is a raw solana-program crate in the shape of interop/contracts/solana-mirror: no Anchor, no borsh, hand-rolled fixed-width big-endian account and instruction layouts with explicit magic and version bytes, spl-token moved by CPI, unsafe code denied, its own workspace and a committed Cargo.lock, and program tests driven by solana-program-test. Custody is held by a vault-authority PDA; the asset registry, the deposit receipts and the release nullifiers are PDAs whose existence is the record. SPL mints only: native SOL bridges as the wrapped SOL mint, so one code path serves every asset."
relayer_scope       = "The relayer gains a Solana observer and a Solana submitter beside the EVM ones and changes no existing loop, no existing fixture and no existing journal key. The configuration gains one solana entry with the same shape as a chains[] entry plus the program id, the commitment and the slot finality depth. Its RPC seam speaks getSlot, getSignaturesForAddress, getTransaction, getAccountInfo, getLatestBlockhash, sendTransaction and getSignatureStatuses. Attestations are signed with the existing secp256k1 attestor key; the Solana transaction is signed under the policy domain LayerX/bridge/solana-tx/v1 by an ed25519 fee-payer key held by the remote signer, which never appears in a configuration file. Tests are recorded fixtures in the format interop/crates/layerx-bridge-relayer/tests/fixtures already uses."
ci                  = "One workflow, .github/workflows/bridge-test.yml, with path filters bridge/**, interop/crates/layerx-bridge-relayer/** and the workflow file itself, and job names that say what they run: forge test for bridge/evm, cargo test plus cargo build-sbf for bridge/solana, cargo test for the relayer crate, and the bridge/deploy tooling leg that runs the Go packages and the offline check scripts the 1:1 test ratio requires. No job name, path filter or step description claims anything the step does not do, and no continue-on-error is added."
test_ratio          = "One to one. Every task's touches list names its test files explicitly, and every production file a task changes is accompanied by a test file that changes or is added in the same task and that exercises it: a Solidity *.t.sol under bridge/evm/test, a Rust #[cfg(test)] module or a file under the crate's tests/, a Go *_test.go in the same package, or a *-check.sh under bridge/deploy/tests for a shell script. Markdown, JSON configuration, recorded fixtures and workflow YAML are not production files for the ratio; the behaviour they carry is tested through the code and the check scripts that read them."
testing_allowance   = "Testing time is bounded on purpose. Every task's verify_cmd is one command wrapped in `timeout 20m`, run from the repository root. A task gets one build of its declared targets and one verify_cmd run, then at most two task-scoped repair cycles, each followed by exactly one rerun. The whole workflow command set runs once, in the wave 3 gate task, never per task and never per rebase. A task whose verify_cmd exceeds its timeout stops at thirty minutes and reports implemented-not-qualified with the exact command, exit code and log path; that is an acceptable outcome and is never dressed up as a pass."
naming              = "The product is Paxeer X Network. LayerX names the kernel domain only and stays on the kernel entities that already carry it, including the layerxBridge precompile, the layerxbridge module and the layerx-bridge-relayer crate; no new user-facing name this feature introduces reads LayerX. The Paxeer coin is PAX. No file content, comment, log line or documentation introduced by this feature carries a date, a hostname, an IP address, a port of an internal host, an internal URL, a credential, or the name of an agent, a model or a working branch. The only documentation links are https://paxeer.app and paths under github.com/Sidiora-Labs/Paxeer-X-Network; the pinned library clone URLs the bootstrap script and the CI job use are the two upstream repositories .github/workflows/paxeer-forge-test.yml already clones."
production_safety   = "No task touches a mainnet, a production deployment, its services, its variables or its domains; no task reads, writes or commits a .env file or any secret; no task broadcasts a transaction to a public network. Every RPC endpoint, explorer key, deploy key and fee-payer key enters a tool through a named environment variable or a file path documented in the tool, never through a literal committed to the repository. Deployment is proven against anvil, solana-test-validator and recorded fixtures only, and the governance proposals this feature generates are left for their owner to submit."
no_weakening        = "No assertion is relaxed, no bound loosened, no type widened, no silent fallback added, no test skipped, deleted or marked pending, no lint rule disabled on a file this feature owns. A missing signature, an unknown signer, a signer out of order, a high s value, a consumed nullifier, an unregistered asset, a cap exceeded, a paused bridge or a placeholder configuration value refuses the operation; none of them ever degrades into a partial success. Where the code and a check disagree, both stay exactly as written and the conflict is recorded in spec/paxeer-x-bridge/qualification.kvx."
generated_files     = "CLAUDE.md, AGENTS.md, .github/copilot-instructions.md, .cursor/rules/spec-workflow.mdc and the requirements.md, design.md and tasks.md mirrors under spec/*/ are generated and off limits: edit spec/workflow.kvx or this file and regenerate with cg spec render. bridge/evm/lib is populated by a bootstrap script and is ignored by git, never committed."
publication         = "A qualified task is published immediately: one commit per task from the repository root describing the change honestly and naming the gates that actually ran, pushed before the next task starts, with no co-author trailer and no model name. Several tasks are never batched into one commit and a finished task is never left unpushed. Every log_path a done record carries and every evidence path a gate record carries is repository-relative, such as build/bridge-gates/task-<id>-verify.log or .logs/verify.log, and never an absolute path or the name of a working branch."

[design]
overview = "Three waves. Wave 1 builds six foundations that share no file, so all six proceed in parallel: the EVM vault moves to bridge/evm and is hardened without moving its wire format; the Solana program's custody core - ownership, the attestor set, the asset registry, the caps, the pause, the deposit and its receipt - is written; the Solana identity mapping is documented and pinned as vectors proven against the chain's own preimage builders; the nine chain configurations, their schema and their validator are written together with the per-chain deploy and verify scripts; the governance proposal generator and the attestor-set manifest are written against the same schema; and the one CI workflow is added. Wave 2 integrates them: the Solana release path verifies attestations through the native secp256k1 program, the relayer learns to observe Solana deposits and then to submit Solana releases, the post-deploy checklist reads the chain back and compares it with the configuration, the per-chain pages and the operator runbook are written, and the two deploy dry runs are recorded against anvil and solana-test-validator. Wave 3 runs the workflow's command set once on the merged revision and writes down what ran. Two things are deliberately absent and stay absent: wrapped PAX on a foreign chain and Sidiora on the EVM mainnets are both governed upgrades for after the freeze, because each needs a chain change the halt forbids."

[design.identity]
title = "Identity and digests"
p1 = "There is one attestation contract and every destination speaks it. An attestor signs keccak256 of a packed preimage - the inbound one for a foreign deposit, the outbound one for a Paxeer burn - with secp256k1, and hands over 65 bytes of r, s and v. The EVM vault recovers those signatures with ecrecover; the Paxeer precompile recovers them in the keeper; the Solana program has them recovered for it by the native secp256k1 program. Nothing in this feature adds a second signature format, a second domain or a second hash."
p2 = "Solana keys are 32 bytes and the digests carry 20, so Solana identities enter through a handle: the last 20 bytes of keccak256 of the key. The vault handle is the handle of the vault-authority PDA and is what governance registers as Solana's vault on Paxeer. An asset's 20 bytes come from the program's registry, whose default for a mint is the handle of the mint and whose owner may instead record an explicit id. A recipient's 20 bytes are derived by the program from the full 32-byte pubkey the release names, so the release can pay only the key the attestors signed for. An inbound txHash is keccak256 of the 64-byte transaction signature and an inbound logIndex is the deposit nonce the receipt PDA records."
p3 = "Solana's chain id on the Paxeer side is the reserved uint64 91600046870081: the ASCII bytes of SOLANA, left-padded to eight bytes and read big-endian, 0x0000534f4c414e41. It is orders of magnitude above every EIP-155 id in use, so it can never collide with one, and governance registers it through MsgRegisterChain like any other chain."
p4 = "Sidiora's Solana mint is registered with the explicit asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe rather than its derived handle, because the chain has already fixed that pair: EnsureSidioraDenom registers the bridged asset (chain id, that address, usid), so an inbound SID deposit resolves to the denom the bridge module already administers and no alias is needed. The binding is exclusive both ways: the id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe is accepted only for the mint 5w3wVdJaESaJKyLmStM6Hv9UyUkmZ1b9DLQquAqqpump, and that mint only with that id, and anything else is refused by the Solana program's asset registration, by the configuration validator and by the post-deploy checklist."
p5 = "bridge/ATTESTATION-SOLANA.md states all of this with a worked example, and bridge/vectors pins it: the handle of the Sidiora mint against the asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe, the handle of the vault-authority PDA, the handle of the wrapped SOL mint, and a full inbound and outbound digest for a Sidiora transfer. The vectors are recomputed in Go against modules/layerxbridge/types.InboundPreimage and OutboundPreimage - the chain's own builders, read and not edited - and asserted again by the Solana program's tests and the relayer's tests, so the three implementations cannot drift."

[design.layout]
title = "Where the code lives"
p1 = "bridge/evm is interop/contracts/ethereum-bridge moved with git mv, so PaxeerXVault.sol, BridgeAttestation.sol, their tests and ATTESTATION.md keep their history. It gains script for the Foundry deploy script, chains for the eight EVM configurations and their pages, lib for the two pinned libraries and bootstrap-libs.sh to fetch them. Its foundry.toml keeps solc 0.8.30, the optimizer at 100000 runs, via_ir, no bytecode hash and no metadata, so the bytecode is reproducible, and writes its artifacts under build."
p2 = "bridge/solana is a self-contained crate with its own workspace and lockfile, laid out like interop/contracts/solana-mirror: src/lib.rs with the entrypoint and the instruction dispatch, one module per concern, tests under tests driven by solana-program-test, and chains/solana holding the Solana configuration and its page."
p3 = "bridge/deploy holds the parts that are neither contract nor program: chainconfig, the Go package that defines the configuration schema, loads it and refuses a placeholder; proposals, the Go package and command that emit the governance messages; the attestor-set manifest; deploy-evm-chain.sh, verify-evm-chain.sh and deploy-solana-program.sh; checklist.sh, which reads the deployed state back and compares it with the configuration; and tests, the offline check scripts that exercise every script the way interop/deploy/mirror/tests exercises the mirror's."
p4 = "bridge/vectors is a small Go package holding the shared identity and digest vectors and the handle derivation, with the test that proves them against the chain's preimage builders. bridge/README.md is the operator runbook: what to deploy, in what order, with which environment variables, which proposals to submit, and what the checklist must report before the bridge is opened."

[design.chains]
title = "The chains and their configuration"
p1 = "Eight EVM chains and Solana. The EVM chains are ethereum (1), base (8453), arbitrum (42161), optimism (10), bnb (56), polygon (137), avalanche (43114) and hyperevm (999, Hyperliquid). Solana is the reserved id 91600046870081. Every EVM chain gets identical bytecode from one source; hyperevm gets one extra sentence in its page and one flag in its configuration, because a contract deployment there needs the account switched to big blocks first and will otherwise run out of block gas."
p2 = "One JSON schema serves all nine. A configuration names the chain, its numeric id, the native coin's symbol and decimals, the environment variable holding the RPC endpoint, the environment variable holding the explorer verification key, the owner address, the attestor addresses and the threshold, the finality depth, and the asset list. The first asset of every chain is its native coin - address(0) on an EVM chain with eighteen decimals, the wrapped SOL mint on Solana with nine - and it is always registered, so the default pair PAX against the chain's native coin works the moment the chain is opened. Each asset carries its address or mint, its 20-byte asset id, its decimals, its per-transaction cap and its total cap."
p3 = "The validator in bridge/deploy/chainconfig is what makes the configuration trustworthy: it refuses an unknown field, a chain id that is not the one the file's name claims, a native symbol or decimals that do not match the chain, an environment variable name that is empty or not upper snake case, a placeholder or zero owner, a placeholder, zero, duplicated or out-of-order attestor, a threshold of zero or above the attestor count, a finality depth of zero, an asset list whose first entry is not the native coin, a cap of zero, and a Solana asset id that does not match either the mint's derived handle or, for Sidiora, 0x21f7b20a555199fa73A238B1a91FD0f549068fEe. Every refusal names the file and the field. The chainconfig package task 1.4 writes is the single configuration schema of the bridge: the proposals generator of task 1.5 imports it rather than declaring a schema of its own, and the handle derivation lives only in bridge/vectors."
p4 = "The per-chain pages name the pair in plain words - PAX against ETH on ethereum, base, arbitrum and optimism, against BNB on bnb, POL on polygon, AVAX on avalanche, HYPE on hyperevm and SOL on solana - and say what the operator must have in hand before running the deploy script."

[design.solana]
title = "The Solana program"
p1 = "One program holds custody for Solana. A config PDA holds the owner, the pending owner of a two-step transfer, the paused flag, the attestor set as up to 64 twenty-byte addresses with the threshold, the deposit nonce and the bumps. A vault-authority PDA signs for the program's token accounts and is the identity whose handle Paxeer registers as Solana's vault. An asset PDA per mint records the mint, the 20-byte asset id, the decimals, the per-transaction cap, the total cap, the amount outstanding and whether it is enabled. A deposit-receipt PDA per nonce records the deposit, which is what makes the nonce monotonic and auditable. A nullifier PDA per (paxeerTxHash, paxeerNonce) is created by a release, so a replayed release fails because the account already exists."
p2 = "A deposit moves SPL tokens by CPI from the depositor's token account into the vault's, admits the amount against the asset's caps, refuses a zero amount, refuses a recipient whose high twelve bytes are not zero or whose low twenty bytes are zero, increments the nonce, writes the receipt and logs the record the relayer reads. The program never learns its own transaction signature and does not need to: the relayer computes the inbound txHash as keccak256 of the signature it observed, and reads the nonce from the receipt."
p3 = "A release verifies the same outbound digest every other destination verifies, without carrying elliptic-curve code. The program rebuilds the 185-byte outbound preimage from the Solana chain id, the vault handle, the paxeerTxHash and paxeerNonce, the handle of the 32-byte recipient the instruction names, the asset id from the registry and the amount; it then reads the instructions sysvar, finds the native secp256k1 program's instruction in the same transaction, and requires that it carries at least threshold signature entries, that every entry's message bytes are exactly that preimage, that every entry's offsets resolve inside the secp256k1 instruction's own data, that every 64-byte signature has s at or below half the curve order, and that the recovered ethereum addresses are current attestors in strictly ascending order with no repeat. The native program having already verified each signature over keccak256 of the message, an accepted release is one the same attestors could have released on any EVM chain. Anything unresolved, out of order, unknown or short of the threshold refuses."
p4 = "Then the release creates the nullifier PDA, reduces the asset's outstanding amount, moves the tokens out by CPI and logs the record. Every instruction is refused while the program is paused except the owner's unpause, and every owner instruction is refused for any other signer."
p5 = "Paxeer's bridgeOut carries a 20-byte recipient, so the relayer cannot recover a 32-byte Solana pubkey from it; a permissionless recipient registry closes that gap. A Solana account registers its own pubkey under its 20-byte handle in a recipient PDA seeded by the handle, signing for that pubkey, and the program verifies that the last 20 bytes of keccak256 of the pubkey equal the handle before writing the PDA, which is never overwritten. The relayer reads that PDA before submitting a release and holds the release in its journal as pending-recipient until the PDA exists, so an outbound transfer to an unregistered handle waits rather than fails or guesses."

[design.relayer]
title = "The relayer's Solana side"
p1 = "The relayer keeps one shape and gains one chain. The configuration grows a solana entry carrying what a chains[] entry carries - the chain id, the vault handle, the finality depth in slots, the start slot, the maximum slot range, the RPC quorum and the fee-payer key handle - plus the program id and the commitment. The fee-payer handle names an ed25519 key the remote signer holds; no key material enters the configuration, and the validator refuses a solana entry whose fee-payer handle is the attestor handle."
p2 = "The observer follows the program with getSlot and getSignaturesForAddress, reads each transaction with getTransaction, keeps the deposits confirmed to the configured slot depth, computes the inbound attestation from the deposit record and the receipt PDA read with getAccountInfo, signs it with the existing secp256k1 attestor key and submits bridgeIn to the precompile through the Paxeer link that already exists. The journal keys it under the same inbound stream shape the EVM chains use, so exactly-once submission and restart behaviour are the ones already proven."
p3 = "The submitter watches BridgeOut on Paxeer as it already does, builds the release instruction with the recipient's full pubkey, prepends the native secp256k1 instruction carrying the threshold signatures over the outbound preimage, fetches a blockhash with getLatestBlockhash, has the fee payer sign the message under the policy domain LayerX/bridge/solana-tx/v1, journals the signed bytes before broadcast, sends it with sendTransaction and confirms it with getSignatureStatuses. A nullifier PDA that already exists is a completed submission, not an error to retry."
p4 = "Both loops are proven by recorded fixtures in the existing format, with a real signer socket and a real journal on disk, so no production path is faked."

[design.deploy]
title = "Deployment, governance and the checklist"
p1 = "Deployment is one script per kind of chain and one order. deploy-evm-chain.sh takes a chain name, loads and validates its configuration, refuses every placeholder, builds with the pinned libraries, deploys the vault with the Foundry script, sets the attestor set and the caps the configuration names, reads the deployed code back and writes a deployment record naming the chain, the address, the deployer, the code hash and the block. verify-evm-chain.sh submits the source to the chain's explorer through the key its configuration names. deploy-solana-program.sh builds with cargo-build-sbf and deploys with the pinned Solana toolchain, in the shape interop/deploy/mirror/deploy-solana-mirror.sh already uses, then initialises the program and registers the assets the configuration names."
p2 = "Governance comes next and is generated, not typed. The proposals command reads a chain configuration and emits, as JSON bodies matching the module's own message types field for field, MsgRegisterChain for the chain and its vault handle, MsgSetAttestors for the shared attestor set and threshold, and one MsgSetCap per asset - always including the native coin, and for Solana including the usid cap for Sidiora. The generator marshals the real types from modules/layerxbridge/types, which it imports and does not modify, so a body cannot drift from what the keeper will accept, and its test decodes every body back into those types with unknown fields forbidden and runs their ValidateBasic."
p3 = "The attestor-set manifest is the one place the attestor addresses and the threshold are written down, and every chain configuration is checked against it, so a chain cannot be brought up with a different set by accident. It carries addresses and a threshold only: no key material, no endpoint and no operator identity."
p4 = "checklist.sh is the gate before the bridge is opened. For each chain it reads the deployed state back through the chain's own RPC - the vault's owner, attestors and threshold, the per-asset caps, the paused flag, the deployed code hash on an EVM chain and the program's config and asset PDAs on Solana - and reads the Paxeer side back through the precompile's views, then compares every value with the configuration and the generated proposals and reports one line per check. The native coin is checked first, and any mismatch, any placeholder and any missing registration fails the run."

[tasks]
heading = "Implementation Plan: the Paxeer X Network Bridge Contracts and Deployment"

# --------------------------------------------------------------------------
# REQUIREMENTS
# --------------------------------------------------------------------------

[req.1]
title = "The EVM Vault Lives at bridge/evm With Its History"
story = "As someone deploying this bridge, I want the EVM custody contract to sit in one obvious place with its own project, so that deploying it is not an archaeology exercise across an interop directory."
ac_1 = "THE Ethereum custody project SHALL be moved to bridge/evm with git mv so that PaxeerXVault.sol, BridgeAttestation.sol, their tests and ATTESTATION.md keep their recorded history, and no copy SHALL be left at the old path."
ac_2 = "THE moved Foundry project SHALL build and test from bridge/evm with solc 0.8.30, the optimizer at 100000 runs, via_ir, no bytecode hash and no metadata, writing artifacts under build so that the bytecode a deploy produces is reproducible."
ac_3 = "THE pinned libraries forge-std v1.9.6 and openzeppelin-contracts v5.3.0 SHALL be fetched into bridge/evm/lib by a committed bootstrap script that is idempotent and by the CI job, following the clone pattern .github/workflows/paxeer-forge-test.yml already uses, and SHALL NOT be committed to the repository."
ac_4 = "EVERY reference in code this feature may edit that names the old path SHALL be updated to the new one, and the two references under modules/ SHALL be left untouched and recorded once as an observation in the feature's qualification log, because no task in this feature edits the chain."
ac_5 = "A Makefile target SHALL run the bridge/evm test suite and a second SHALL run the bridge/solana test suite, beside the interop targets that already exist."

[req.2]
title = "A Production EVM Vault Whose Wire Format Does Not Move"
story = "As an attestor and as a relayer, I want the vault hardened without a single byte of its interface changing, so that the signatures I produce and the logs I decode keep working exactly as they do."
ac_1 = "THE BridgeDeposit and BridgeRelease event topics, the deposit, depositNative and release selectors and the two digest views SHALL keep exactly the bytes interop/crates/layerx-bridge-relayer/src/abi.rs declares, and a test SHALL assert each topic and selector against those byte values."
ac_2 = "THE vault SHALL remain non-upgradeable with no proxy surface and no EIP-165 surface, SHALL hold ownership through OpenZeppelin v5.3.0 Ownable2Step so a transfer needs the new owner's acceptance, SHALL guard deposit, depositNative and release with OpenZeppelin ReentrancyGuard, and SHALL move tokens through SafeERC20 with no permit path."
ac_3 = "A token deposit SHALL measure the amount received as the balance delta across the transfer and SHALL refuse the deposit when the delta is not the amount requested, so a fee-on-transfer or rebasing token cannot leave custody short of what the Paxeer side mints."
ac_4 = "THE native asset SHALL be handled explicitly under the id address(0): depositNative SHALL admit the value sent against the native caps and release SHALL pay the recipient with a call whose failure reverts the whole release."
ac_5 = "THE rescue path SHALL move the full balance of a token only when that token has never been registered for bridging and has no outstanding amount, SHALL refuse the native asset and any registered token, and SHALL be callable only by the owner."
ac_6 = "THE release path SHALL keep refusing exactly what it refuses now - a zero amount, a zero recipient, an amount above the per-transaction cap, an amount above the outstanding balance, a consumed nullifier, fewer than threshold signatures, a signature that is not 65 bytes, a high s value, a v outside 27 and 28, a signer out of ascending order and an unknown signer - and SHALL add no path that admits any of them."
ac_7 = "FOUNDRY tests SHALL cover a token deposit and a native deposit, a release of each under threshold, the ascending and unknown signer refusals, the high s refusal, the replayed nullifier refusal, the cap refusals, the paused refusals, the two-step ownership transfer and its refusals, the fee-on-transfer refusal, the rescue path and each of its refusals, and the topic and selector parity with the relayer's constants."

[req.3]
title = "One Bytecode, Nine Configurations"
story = "As the operator, I want every chain to differ only in a configuration file I can read, so that deploying to a ninth chain is a file rather than a release."
ac_1 = "THE eight EVM chains ethereum (1), base (8453), arbitrum (42161), optimism (10), bnb (56), polygon (137), avalanche (43114) and hyperevm (999) and the Solana chain (91600046870081) SHALL each have a configuration file and a page, and the EVM chains SHALL deploy identical bytecode from one source with no per-chain branch, conditional or override in Solidity."
ac_2 = "A CONFIGURATION SHALL declare the chain name and numeric id, the native coin's symbol and decimals, the name of the environment variable carrying the RPC endpoint, the name of the environment variable carrying the explorer verification key, the owner address, the attestor addresses with the threshold, the finality depth, and the asset list, and SHALL carry no endpoint, key, credential or host."
ac_3 = "THE first asset of every configuration SHALL be the chain's native coin - address(0) with eighteen decimals on every EVM chain listed, and the wrapped SOL mint So11111111111111111111111111111111111111112 with nine decimals on Solana - and it SHALL always be registered with a non-zero per-transaction and total cap."
ac_4 = "THE Solana configuration SHALL additionally carry the program id, the commitment, the slot finality depth, and for each asset its mint and its 20-byte asset id, with Sidiora's mint 5w3wVdJaESaJKyLmStM6Hv9UyUkmZ1b9DLQquAqqpump carrying six decimals and the asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe, and the wrapped SOL mint carrying its derived handle."
ac_5 = "THE hyperevm configuration and page SHALL state that the deploying account must be switched to big blocks before a contract deployment will fit, and the deploy script SHALL refuse to deploy to hyperevm until the configuration records that acknowledgement."
ac_6 = "THE loader SHALL refuse an unknown field, a chain id that disagrees with the file's chain name, a native symbol or decimals that disagree with the chain, an empty or malformed environment variable name, a placeholder or zero owner, a placeholder, zero, duplicated or descending attestor, a threshold of zero or above the attestor count, a zero finality depth, an asset list whose first entry is not the native coin, a zero cap, and a Solana asset id that is neither the mint's derived handle nor Sidiora's fixed address, naming the file and the field in every refusal."
ac_7 = "GO tests SHALL load every committed configuration and assert it is accepted, and SHALL cover each refusal above against a configuration that differs from an accepted one in exactly that field."
ac_8 = "THE asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe SHALL be accepted only for the Sidiora mint 5w3wVdJaESaJKyLmStM6Hv9UyUkmZ1b9DLQquAqqpump, and that mint SHALL be accepted only with that id; any other pairing SHALL be refused by the Solana program's asset registration, by the configuration validator and by the post-deploy checklist."

[req.4]
title = "The Solana Custody Program"
story = "As a Solana holder, I want a program that locks my tokens against a recorded deposit the Paxeer side can mint from, so that bridging from Solana is the same operation bridging from Ethereum is."
ac_1 = "THE program SHALL be a raw solana-program crate with no Anchor and no borsh, with hand-rolled fixed-width big-endian layouts carrying an explicit magic and version, unsafe code denied, its own workspace and a committed lockfile, in the shape interop/contracts/solana-mirror establishes."
ac_2 = "A CONFIG PDA SHALL hold the owner, the pending owner, the paused flag, up to 64 twenty-byte attestor addresses with the threshold, the deposit nonce and the bumps; ownership SHALL transfer in two steps through a proposal by the owner and an acceptance by the new owner; and every owner instruction SHALL refuse any other signer."
ac_3 = "AN ASSET PDA per mint SHALL record the mint, the 20-byte asset id, the decimals, the per-transaction cap, the total cap, the outstanding amount and whether it is enabled; registration SHALL default the asset id to the last 20 bytes of keccak256 of the mint and SHALL accept an explicit id from the owner instead; and an unregistered or disabled mint SHALL be refused."
ac_4 = "A DEPOSIT SHALL move SPL tokens by spl-token CPI into the vault-authority PDA's token account, SHALL refuse a zero amount, an amount above the per-transaction cap, an amount that would take the outstanding amount above the total cap, a recipient whose high twelve bytes are not zero, and a recipient whose low twenty bytes are zero, and SHALL be refused while the program is paused."
ac_5 = "A DEPOSIT SHALL increment the config's nonce, SHALL write a deposit-receipt PDA seeded by that nonce recording the mint, the amount, the 32-byte Paxeer recipient, the depositor and the slot, and SHALL log the record the relayer reads; two deposits SHALL never share a nonce and a receipt SHALL never be overwritten."
ac_6 = "THE pause SHALL refuse every instruction except the owner's unpause, and the owner instructions SHALL be refused when the program is not initialised."
ac_7 = "PROGRAM tests driven by solana-program-test SHALL cover initialisation, the two-step ownership transfer and its refusals, setting the attestor set and each of its refusals, registering an asset with a derived and with an explicit id, the cap and pause refusals, a successful SPL deposit with its receipt and its logged record, the recipient refusals, and two deposits taking consecutive nonces."

[req.5]
title = "One Identity Mapping, Pinned as Vectors"
story = "As someone implementing any side of this bridge, I want the Solana identity mapping written down once and proven against the chain's own code, so that three implementations of the same digest cannot drift."
ac_1 = "A DOCUMENT bridge/ATTESTATION-SOLANA.md SHALL state the mapping: the handle of a 32-byte Solana key as the last 20 bytes of keccak256 of that key, the vault handle as the handle of the vault-authority PDA, the asset id as the registry's value with the derived handle as its default, the inbound txHash as keccak256 of the 64-byte transaction signature, the inbound logIndex as the deposit nonce, the release recipient as the full 32-byte pubkey whose handle the program derives, and the Solana chain id as the reserved uint64 91600046870081 with the reason it cannot collide with an EIP-155 id."
ac_2 = "THE document SHALL name modules/layerxbridge/ATTESTATION.md as the byte-exact specification of the preimages and signature rules it inherits, SHALL add no second domain, hash or signature format, and SHALL state that the Paxeer-side copy under modules/ is not edited by this feature."
ac_3 = "THE document SHALL carry a worked vector table: the Sidiora mint against the asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe, the wrapped SOL mint against its derived handle, a vault-authority PDA against its handle, and a full inbound and a full outbound digest for a Sidiora transfer with every input listed."
ac_4 = "A GO package SHALL implement the handle derivation and hold those vectors as values, and its test SHALL recompute each digest through modules/layerxbridge/types.InboundPreimage and OutboundPreimage - the chain's own builders, read and not modified - and assert it equals the vector, so the document cannot claim a digest the chain would not produce."
ac_5 = "THE same vector values SHALL be asserted by the Solana program's tests and by the relayer's Solana tests, and a change to any one of the three SHALL fail the others."

[req.6]
title = "Solana Releases Verified Through the Native Secp256k1 Program"
story = "As an attestor, I want the signature I already produce for Ethereum to release funds on Solana too, so that there is one attestation for the whole bridge."
ac_1 = "THE release instruction SHALL rebuild the 185-byte outbound preimage from the Solana chain id, the vault handle, the paxeerTxHash, the paxeerNonce, the handle of the 32-byte recipient the instruction names, the asset id from the registry and the amount, so the digest it verifies is byte-identical to the one the EVM vault and the Paxeer keeper verify."
ac_2 = "THE program SHALL verify the attestation only through the native secp256k1 program by introspecting the instructions sysvar: it SHALL find that program's instruction in the same transaction, SHALL require at least threshold signature entries, SHALL require every entry's message bytes to equal the rebuilt preimage exactly, and SHALL require every entry's message, signature and address offsets to resolve inside that instruction's own data."
ac_3 = "THE program SHALL require every entry's 64-byte signature to carry an s at or below half the secp256k1 order, and SHALL require the recovered ethereum addresses to be current attestors in strictly ascending order with no repeat; it SHALL carry no elliptic-curve code of its own and SHALL never accept an ed25519 signature as an attestation."
ac_4 = "A SUCCESSFUL release SHALL create a nullifier PDA seeded by the paxeerTxHash and the paxeerNonce, so a replayed release fails because the account exists; it SHALL reduce the asset's outstanding amount, SHALL move the tokens out by spl-token CPI from the vault-authority PDA, and SHALL log the record naming the asset, the amount, the recipient, the paxeerTxHash and the paxeerNonce."
ac_5 = "A RELEASE SHALL be refused when the program is paused, when the amount is zero or above the per-transaction cap or above the outstanding amount, when the mint is unregistered or disabled, when the recipient's token account is not the recipient's, when the secp256k1 instruction is absent, short of the threshold, over a different message, self-inconsistent in its offsets, high in s, out of order, repeated or signed by an unknown address, and when the nullifier already exists."
ac_6 = "PROGRAM tests SHALL cover a successful release paying the recipient and creating the nullifier, the digest matching the vector the document pins, a release replayed, and each refusal above, with the signatures produced by real secp256k1 keys over the real preimage and verified by the real native program under solana-program-test."

[req.7]
title = "The Relayer Observes Solana"
story = "As the operator of the relayer, I want Solana deposits to reach the precompile the same way Ethereum deposits do, so that I run one service and not two."
ac_1 = "THE relayer configuration SHALL gain one solana entry carrying the chain id, the vault handle, the finality depth in slots, the start slot, the maximum slot range, the RPC quorum, the fee-payer key handle, the program id and the commitment, with unknown fields refused and no key material accepted, and its validator SHALL refuse a fee-payer handle equal to the attestor handle and a chain id that is not the reserved Solana constant."
ac_2 = "THE Solana RPC seam SHALL speak getSlot, getSignaturesForAddress, getTransaction, getAccountInfo, getLatestBlockhash, sendTransaction and getSignatureStatuses, returning the same typed faults the existing seam returns for a configuration error, an unavailable endpoint, a rate limit, a divergence, a malformed response and a rejection."
ac_3 = "THE observer SHALL follow the program's signatures, SHALL keep only deposits confirmed to the configured slot depth, SHALL read the deposit record and its receipt PDA, SHALL compute the inbound attestation with the txHash as keccak256 of the 64-byte transaction signature and the logIndex as the receipt's nonce, and SHALL refuse a deposit whose logged record and receipt disagree."
ac_4 = "THE observer SHALL sign the inbound digest with the existing secp256k1 attestor key under the existing inbound policy domain and SHALL submit bridgeIn to the precompile through the existing Paxeer link, journalling under the same inbound stream shape the EVM chains use, so exactly-once submission and restart behaviour are the ones already proven."
ac_5 = "NO existing loop, fixture, journal key or configuration field SHALL change behaviour, and a configuration with no solana entry SHALL behave exactly as it behaves now."
ac_6 = "TESTS SHALL cover the configuration's acceptance and each refusal, the attestation computed from a recorded deposit against the vector the document pins, the slot-depth refusal, the record-and-receipt disagreement refusal, and a full observe-and-submit cycle against recorded fixtures in the existing format with a real signer socket and a real journal."

[req.8]
title = "The Relayer Releases on Solana"
story = "As someone bridging out to Solana, I want my Paxeer burn to arrive as tokens in my account without anybody typing a transaction by hand, so that the outbound direction is as automatic as the inbound one."
ac_1 = "THE submitter SHALL build the release instruction with the recipient's full 32-byte pubkey, the mint, the amount, the paxeerTxHash and the paxeerNonce, and SHALL prepend the native secp256k1 instruction carrying at least threshold attestor signatures over the outbound preimage, laid out so every offset resolves inside that instruction's own data."
ac_2 = "THE transaction SHALL be signed by an ed25519 fee-payer key held by the remote signer under the policy domain LayerX/bridge/solana-tx/v1, and no private key SHALL enter the relayer process or its configuration."
ac_3 = "THE signed bytes SHALL be journalled before broadcast so a restart rebroadcasts rather than re-signs, and a nullifier PDA that already exists SHALL be recorded as a completed submission rather than an error to retry."
ac_4 = "THE submitter SHALL confirm with getSignatureStatuses to the configured commitment and SHALL treat a blockhash that has expired without inclusion as a resubmission of the same journalled attestation rather than a new signature over new bytes."
ac_5 = "TESTS SHALL cover the instruction layout against the vector the document pins, the fee payer's domain, the journal written before broadcast, a restart rebroadcasting the journalled bytes, an existing nullifier recorded as completed, an expired blockhash resubmitted, and a full outbound cycle against recorded fixtures in the existing format."

[req.9]
title = "Governance Proposals Generated From the Configuration"
story = "As the owner who will submit these proposals, I want them generated from the same file the deployment used, so that what governance registers and what is deployed cannot disagree."
ac_1 = "A COMMAND SHALL read a chain configuration and emit, as JSON bodies matching modules/layerxbridge/types field for field, MsgRegisterChain carrying the chain id, the vault or vault-handle address and the finality depth, MsgSetAttestors carrying the shared attestor set and threshold, and one MsgSetCap per asset."
ac_2 = "THE generator SHALL marshal the real message types from modules/layerxbridge/types, which it imports and does not modify, and its test SHALL decode every emitted body back into those types with unknown fields forbidden and SHALL run their ValidateBasic, so a body cannot drift from what the keeper accepts."
ac_3 = "THE MsgSetCap set SHALL always include the chain's native coin, first, and for Solana it SHALL include Sidiora's cap for the asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe, which is the asset the chain already maps to the usid denom."
ac_4 = "AN ATTESTOR-SET MANIFEST SHALL be the single committed record of the attestor addresses and the threshold, carrying no key material, endpoint or operator identity, and the generator SHALL refuse a chain configuration whose attestor set or threshold differs from the manifest."
ac_5 = "THE generator SHALL refuse a placeholder or zero authority, owner or attestor, a zero threshold or one above the attestor count, and a zero cap, naming the file and the field, and SHALL write no partial output when it refuses."
ac_6 = "GO tests SHALL cover the three bodies against the real types, the native cap always being present and first, the Solana Sidiora cap, the manifest disagreement refusal, and each placeholder refusal."

[req.10]
title = "Deploy and Verify, One Script Per Kind of Chain"
story = "As the operator, I want one command per chain that deploys what the configuration says and refuses anything it is not sure about, so that a deployment is repeatable rather than remembered."
ac_1 = "A SCRIPT SHALL deploy an EVM chain from its name alone: it SHALL load and validate the configuration, refuse every placeholder, require the RPC endpoint and the deploy key through the environment variables the configuration names, build with the pinned libraries, deploy the vault, set the attestor set and every cap the configuration declares, read the deployed code back and write a deployment record naming the chain, the address, the deployer, the code hash and the block."
ac_2 = "A SECOND SCRIPT SHALL submit the vault's source for explorer verification through the key the configuration's environment variable names, and SHALL report the explorer's own answer rather than assuming success."
ac_3 = "A THIRD SCRIPT SHALL build the Solana program with cargo-build-sbf and deploy it with the pinned Solana toolchain in the shape interop/deploy/mirror/deploy-solana-mirror.sh uses, then initialise the program and register every asset the configuration names, and write a deployment record naming the program id, the program data account, the ELF hash, the vault-authority PDA and its handle, and the rooted slot."
ac_4 = "EVERY script SHALL fail closed: a missing environment variable, an unreadable key file, a placeholder configuration value, a chain id the endpoint does not confirm, a deployed code hash that is not the built one, or an already-initialised program with a different owner SHALL stop the run with a message naming the cause, and no script SHALL carry a default endpoint, key, address or host."
ac_5 = "NO script SHALL broadcast to a public network in a test, and every script SHALL be exercised by an offline check script under bridge/deploy/tests in the shape interop/deploy/mirror/tests/render-config-check.sh establishes, covering its acceptance and each of its refusals."

[req.11]
title = "The Post-Deploy Checklist Reads the Chain Back"
story = "As the owner deciding whether to open the bridge, I want a run that reads every deployed value back and compares it with the configuration, so that opening it is a check rather than a hope."
ac_1 = "THE checklist SHALL read the deployed state back through each chain's own RPC - on an EVM chain the vault's owner, attestors, threshold, per-asset caps, paused flag and deployed code hash; on Solana the config PDA's owner, attestors, threshold and paused flag and every asset PDA - and SHALL read the Paxeer side back through the precompile's getChain, getAttestors, getCap and isPaused views."
ac_2 = "IT SHALL compare every value with the chain configuration and the generated proposals and SHALL report one line per check naming the chain, the value, what was expected and what was found."
ac_3 = "THE native coin SHALL be checked first for every chain, and a run SHALL fail when the native coin is unregistered, uncapped or paused, when any value disagrees, when a placeholder is still in place, or when the Paxeer side has no registration for the chain."
ac_4 = "THE run SHALL make no transaction and SHALL change no state anywhere; it SHALL read only."
ac_5 = "AN OFFLINE check script SHALL exercise the checklist against recorded responses covering a fully agreeing deployment, a disagreeing cap, an unregistered native coin, a paused vault, a missing Paxeer registration and a placeholder still in place."

[req.12]
title = "The Runbook and the Per-Chain Pages"
story = "As the operator coming to this cold, I want one page that says what to do in what order and one page per chain that says what that chain needs, so that I can deploy without reading the code."
ac_1 = "bridge/README.md SHALL be the operator runbook: what the bridge is in two sentences, the order of operations from building through deploying, verifying, generating and submitting the proposals to running the checklist, the environment variables each step needs by name, and what the checklist must report before the bridge is opened."
ac_2 = "EACH chain SHALL have a page naming the pair in plain words - PAX against ETH on ethereum, base, arbitrum and optimism, against BNB on bnb, POL on polygon, AVAX on avalanche, HYPE on hyperevm and SOL on solana - the chain id, the assets its configuration registers, the environment variables its scripts need, and anything the chain requires that the others do not."
ac_3 = "THE hyperevm page SHALL state the big-block requirement for contract deployment and the Solana page SHALL state the Sidiora mint, its asset id and that Solana is Sidiora's foreign home."
ac_4 = "NO page SHALL carry a date, a hostname, an IP address, an internal URL, a credential or an agent or branch name, every page SHALL name the product as Paxeer X Network, and the only links SHALL be https://paxeer.app and paths under github.com/Sidiora-Labs/Paxeer-X-Network."
ac_5 = "A CHECK script SHALL assert that every link in the bridge documentation is in that allowlist, that every repository path a page names exists, and that no page carries a date, host, IP address or credential pattern."

[req.13]
title = "Dry Runs Recorded Against Real Local Nodes"
story = "As the person who will run these scripts for real, I want them proven end to end against a local node first, so that the first time they touch a mainnet is not the first time they run."
ac_1 = "AN EVM dry run SHALL start anvil, deploy the vault with the deploy script against a configuration whose placeholders have been replaced by that run's own local values, set the attestors and caps, read the state back with the checklist and assert every check passes, then record the RPC exchange as a fixture in the format the relayer's fixtures use."
ac_2 = "A SOLANA dry run SHALL start solana-test-validator, deploy and initialise the program with the deploy script, register the native and Sidiora assets, make a deposit, release against real attestor signatures, read the state back with the checklist and assert every check passes, then record the exchange as a fixture."
ac_3 = "NEITHER dry run SHALL touch a public network, and each SHALL skip nothing: a missing local tool SHALL stop the run with a message naming the tool rather than passing with the step omitted."
ac_4 = "THE recorded fixtures SHALL carry no key material, no endpoint of any host but the local one the run started, and no date or hostname."
ac_5 = "EACH dry run SHALL be a committed script under bridge/deploy/tests that a single command runs, and its recorded fixture SHALL be replayable so a later run can assert the same exchange without a node."

[req.14]
title = "One Workflow That Says What It Runs"
story = "As a reviewer, I want one workflow whose job names and path filters are true, so that a green check means the bridge was tested and not that a filter skipped it."
ac_1 = "ONE workflow .github/workflows/bridge-test.yml SHALL run on pull requests and pushes touching bridge/**, interop/crates/layerx-bridge-relayer/** or .github/workflows/bridge-test.yml itself, and SHALL carry exactly those three path filters and no other."
ac_2 = "ITS jobs SHALL be forge test for bridge/evm after cloning the two pinned libraries, cargo test plus cargo build-sbf for bridge/solana, cargo test for the layerx-bridge-relayer crate, and the bridge/deploy tooling leg running that directory's Go packages and offline check scripts; every job name SHALL name what that job runs."
ac_3 = "NO job SHALL carry continue-on-error, no step SHALL claim a check it does not perform, and every action SHALL be pinned the way the repository's existing workflows pin theirs."
ac_4 = "A CHECK script SHALL parse the workflow, assert the path filters are exactly bridge/**, interop/crates/layerx-bridge-relayer/** and the workflow file itself and that each names a directory or file that exists, assert every job's command is one the repository can run from its root, and assert no continue-on-error is present."

[req.15]
title = "Wave Qualification and Recorded Evidence"
story = "As the person deciding whether this feature is done, I want the workflow's command set run once on the merged revision with what ran written down, so that the feature's state is a record rather than a recollection."
ac_1 = "THE workflow's four legs SHALL be run once, on the merged revision of the feature's waves, and never per task."
ac_2 = "THE run SHALL be recorded in spec/paxeer-x-bridge/qualification.kvx as [gate.*] records carrying the task, the requirements the gate qualifies, the revision, the exact command, the exit code, the log path, the outcome and the evidence, written only by having executed the command they name."
ac_3 = "ANY failure the run exposes that belongs to no task in this feature SHALL be recorded once as an [observation.*] entry in the repository-wide shape spec/workflow.kvx [qualification_log] fixes - task, file, symbol, observed (one sentence), assumption (one sentence) and severity - and SHALL NOT be chased; the four evidence fields revision, command, exit code and log path belong only to task done records and [gate.*] records."
ac_4 = "NO gate record SHALL be written for a command that did not run, no gate that passed at the recorded revision SHALL be rerun to confirm it, and nothing SHALL be deployed: the deployment scripts and the generated proposals are left for their owner."

# --------------------------------------------------------------------------
# TASKS
#   wave 1  six foundations that share no file, so all six proceed in parallel
#   wave 2  integration: the release path, the relayer's two Solana loops,
#           the checklist, the documentation and the two dry runs
#   wave 3  one run of the workflow's command set on the merged revision
# --------------------------------------------------------------------------

[task.1]
section = "Wave 1 - Foundations, Six Lanes at Once"
title = "Build the two custody sides, the identity mapping, the configuration, the proposals and the workflow"
status = "pending"

[task.1.1]
title = "Move the EVM vault to bridge/evm and harden it to production grade"
status = "done"
revision = "f715c9d92d1e984d28a0667fa71fca0ce94fc4a6"
command = "timeout 20m sh -c 'bash bridge/evm/bootstrap-libs.sh && forge test --root bridge/evm -vvv'"
exit_code = 0
log_path = "build/bridge-gates/task-1.1-verify.log"
wave = 1
requires = []
do_1 = "Move the project with git mv so its history follows: interop/contracts/ethereum-bridge/src/PaxeerXVault.sol, src/BridgeAttestation.sol, test/PaxeerXVault.t.sol, test/TestToken.sol, test/Vm.sol, ATTESTATION.md and foundry.toml become bridge/evm/..., and nothing is left at the old path."
do_2 = "Rewrite bridge/evm/foundry.toml for its new root: src, test and script under bridge/evm, libs lib, solc 0.8.30, optimizer on at 100000 runs, via_ir, no bytecode hash, no cbor metadata, offline, artifacts and cache under build, and a remapping for the OpenZeppelin contracts directory."
do_3 = "Add bridge/evm/bootstrap-libs.sh cloning forge-std v1.9.6 and openzeppelin-contracts v5.3.0 into bridge/evm/lib at their pinned tags the way .github/workflows/paxeer-forge-test.yml clones them, idempotent when they are already present, and add bridge/evm/lib to .gitignore so neither library is committed."
do_4 = "Harden bridge/evm/src/PaxeerXVault.sol without moving one byte of its wire format: replace the hand-written owner with OpenZeppelin v5.3.0 Ownable2Step, the hand-written reentrancy latch with ReentrancyGuard and the raw token calls with SafeERC20, keep the balance-delta measurement and its mismatch refusal, keep the explicit NATIVE_ASSET path for depositNative and the native release, add no permit path and no EIP-165 surface, and leave the BridgeDeposit and BridgeRelease events, the deposit, depositNative and release signatures and the two digest views exactly as they are."
do_5 = "Add a registration record so the rescue path can tell a bridged token from a stray one, and add an owner-only rescue that moves the full balance of a token only when it was never registered and has no outstanding amount, refusing the native asset and every registered token with named errors."
do_6 = "Add bridge/evm/test/RelayerAbiParity.t.sol asserting the BridgeDeposit and BridgeRelease topic hashes and the deposit, depositNative and release selectors against the byte values interop/crates/layerx-bridge-relayer/src/abi.rs declares, so a rename of any of them fails here before it reaches the relayer."
do_7 = "Extend bridge/evm/test/PaxeerXVault.t.sol to cover the two-step ownership transfer and its refusals, the fee-on-transfer refusal, the rescue path and each of its refusals, and every existing deposit, release, signature, cap, pause and nullifier case unchanged; add no test that would pass with a weaker vault."
do_8 = "Update the two doc comments in interop/crates/layerx-bridge-relayer/src/abi.rs and src/attestation.rs that name the old path, add bridge-test-evm and bridge-test-solana targets to the Makefile beside the interop targets, edit nothing under modules/, precompiles/, node/ or consensus/, and append one observation to spec/paxeer-x-bridge/qualification.kvx naming the two stale references the freeze leaves in modules/layerxbridge."
verify_cmd = "timeout 20m sh -c 'bash bridge/evm/bootstrap-libs.sh && forge test --root bridge/evm -vvv'"
symbols = ["PaxeerXVault","BridgeAttestation","Ownable2Step","rescue","NATIVE_ASSET"]
touches = ["bridge/evm/foundry.toml","bridge/evm/bootstrap-libs.sh","bridge/evm/src/PaxeerXVault.sol","bridge/evm/src/BridgeAttestation.sol","bridge/evm/ATTESTATION.md","bridge/evm/test/PaxeerXVault.t.sol","bridge/evm/test/RelayerAbiParity.t.sol","bridge/evm/test/TestToken.sol","bridge/evm/test/Vm.sol",".gitignore","Makefile","interop/crates/layerx-bridge-relayer/src/abi.rs","interop/crates/layerx-bridge-relayer/src/attestation.rs","spec/paxeer-x-bridge/qualification.kvx"]
reqs = ["1.1","1.2","1.3","1.4","1.5","2.1","2.2","2.3","2.4","2.5","2.6","2.7"]

[task.1.2]
title = "Write the Solana custody program core"
status = "done"
revision = "e4afaa05cd1cd1118d2a25be6212449ba7835416"
command = "timeout 20m sh -c 'cargo test --locked --manifest-path bridge/solana/Cargo.toml'"
exit_code = 0
log_path = ".logs/verify-review.log"
wave = 1
requires = []
do_1 = "Create bridge/solana as a raw solana-program crate in the shape interop/contracts/solana-mirror/Cargo.toml uses: its own workspace, a cdylib and lib target, pinned solana-program, spl-token and solana-sdk-ids dependencies, solana-program-test and tokio as dev dependencies, unsafe code denied, a committed Cargo.lock, and no Anchor and no borsh anywhere."
do_2 = "Write src/lib.rs with the entrypoint and the instruction dispatch over an explicit magic and version prefix, and src/state.rs with hand-rolled fixed-width big-endian layouts for the config PDA (owner, pending owner, paused, attestor count, threshold, up to 64 twenty-byte attestor addresses, deposit nonce, bumps), the asset PDA (mint, 20-byte asset id, decimals, per-transaction cap, total cap, outstanding, enabled) and the deposit-receipt PDA (nonce, mint, amount, 32-byte Paxeer recipient, depositor, slot), each carrying its own magic and version and refusing a foreign or short account."
do_3 = "Write src/admin.rs with initialise, propose and accept ownership, set attestors, register asset, set cap and set pause: every one owner-only, ownership moving only in two steps, the attestor set accepted only strictly ascending with no repeat and a threshold between one and the count, an asset id defaulting to the last 20 bytes of keccak256 of the mint and accepted as an explicit value from the owner, and every instruction but unpause refused while paused."
do_4 = "Write src/identity.rs with the handle derivation - the last 20 bytes of keccak256 of a 32-byte key - and the vault-authority PDA and its handle, and use it for the vault handle and the asset default so one function is the only place the mapping lives."
do_5 = "Write src/deposit.rs moving SPL tokens by spl-token CPI into the vault-authority PDA's token account, admitting the amount against the per-transaction and total caps, refusing a zero amount, a recipient whose high twelve bytes are not zero and a recipient whose low twenty bytes are zero, incrementing the config nonce, writing the deposit-receipt PDA seeded by that nonce and logging the record the relayer reads."
do_6 = "Write tests/core.rs under solana-program-test covering initialisation, the two-step ownership transfer and its refusals, the attestor-set refusals, registration with a derived and with an explicit asset id, the cap and pause refusals, a successful SPL deposit with its receipt and logged record, the recipient refusals and two deposits taking consecutive nonces; use real mints, real token accounts and the real program, with no fake account layout written by the test."
verify_cmd = "timeout 20m sh -c 'cargo test --locked --manifest-path bridge/solana/Cargo.toml'"
symbols = ["process_instruction","Config","Asset","DepositReceipt","handle","vault_authority","deposit"]
touches = ["bridge/solana/Cargo.toml","bridge/solana/Cargo.lock","bridge/solana/src/lib.rs","bridge/solana/src/state.rs","bridge/solana/src/admin.rs","bridge/solana/src/identity.rs","bridge/solana/src/deposit.rs","bridge/solana/tests/core.rs"]
reqs = ["4.1","4.2","4.3","4.4","4.5","4.6","4.7"]

[task.1.3]
title = "Document the Solana identity mapping and pin it as vectors"
status = "done"
revision = "f37eca32497dbc1cd2d3abd38fed70db03427030"
command = "timeout 20m sh -c 'go test -count=1 ./bridge/vectors/...'"
exit_code = 0
log_path = "build/bridge-gates/task-1.3-verify.log"
wave = 1
requires = []
do_1 = "Write bridge/ATTESTATION-SOLANA.md stating the mapping in full: the handle of a 32-byte Solana key as the last 20 bytes of keccak256 of that key, the vault handle as the handle of the vault-authority PDA, the asset id as the registry's value with the derived handle as its default, the inbound txHash as keccak256 of the 64-byte transaction signature, the inbound logIndex as the deposit nonce recorded in the receipt PDA, the release recipient as the full 32-byte pubkey whose handle the program derives, and the Solana chain id as the reserved uint64 91600046870081, the big-endian ASCII bytes of SOLANA left-padded to eight bytes, with the reason it cannot collide with an EIP-155 id."
do_2 = "Name modules/layerxbridge/ATTESTATION.md as the byte-exact specification of the preimages and the signature rules the Solana side inherits, state that this feature does not edit the Paxeer-side copy, and add no second domain, hash or signature format."
do_3 = "Add the worked vector table: Sidiora's mint 5w3wVdJaESaJKyLmStM6Hv9UyUkmZ1b9DLQquAqqpump against the asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe with the reason the chain fixes it, the wrapped SOL mint So11111111111111111111111111111111111111112 against its derived handle, a vault-authority PDA against its handle, and one inbound and one outbound digest for a Sidiora transfer with every input listed."
do_4 = "Write bridge/vectors/solana.go holding the handle derivation and those vectors as values, with no dependency on the Solana toolchain, so any Go tool in the repository can read the mapping from one place."
do_5 = "Write bridge/vectors/solana_test.go recomputing each digest through modules/layerxbridge/types.InboundPreimage and OutboundPreimage - the chain's own builders, imported read-only - and asserting it equals the vector, and asserting the chain id constant is the big-endian value of the padded ASCII bytes and that it exceeds every EIP-155 id the chain configurations use; edit nothing under modules/."
verify_cmd = "timeout 20m sh -c 'go test -count=1 ./bridge/vectors/...'"
symbols = ["Handle","SolanaChainID","SidioraAssetID","WrappedSolAssetID","InboundVector","OutboundVector"]
touches = ["bridge/ATTESTATION-SOLANA.md","bridge/vectors/solana.go","bridge/vectors/solana_test.go"]
reqs = ["5.1","5.2","5.3","5.4","5.5"]

[task.1.4]
title = "Write the nine chain configurations, their validator and the deploy and verify scripts"
status = "done"
revision = "9236afa7197b204060b6921cf88ab6d04bb3e5db"
command = "timeout 20m sh -c 'go test -count=1 ./bridge/deploy/chainconfig/... && bash bridge/deploy/tests/deploy-scripts-check.sh'"
exit_code = 0
log_path = "build/bridge-gates/task-1.4-verify.log"
wave = 1
requires = []
do_1 = "Write bridge/deploy/chainconfig/config.go defining the schema and its loader: the chain name and numeric id, the native coin's symbol and decimals, the names of the environment variables carrying the RPC endpoint and the explorer verification key, the owner address, the attestor addresses and threshold, the finality depth, the asset list, and for Solana the program id, the commitment and the slot finality depth; decode with unknown fields forbidden and carry no endpoint, key or host in the type."
do_2 = "Write bridge/deploy/chainconfig/validate.go refusing a chain id that disagrees with the file's chain name, a native symbol or decimals that disagree with the chain, an empty or non-upper-snake-case environment variable name, a placeholder or zero owner, a placeholder, zero, duplicated or descending attestor, a threshold of zero or above the count, a zero finality depth, an asset list whose first entry is not the chain's native coin, a zero per-transaction or total cap, and a Solana asset id that is neither the mint's derived handle nor Sidiora's fixed 0x21f7b20a555199fa73A238B1a91FD0f549068fEe, naming the file and the field in every refusal."
do_3 = "Write the eight EVM configurations under bridge/evm/chains/<name>/config.json for ethereum 1, base 8453, arbitrum 42161, optimism 10, bnb 56, polygon 137, avalanche 43114 and hyperevm 999, each listing address(0) with its eighteen-decimal native symbol as the first, always-registered asset and each carrying the placeholder owner and attestor values every tool refuses, with hyperevm additionally recording the big-block acknowledgement its deployment needs; and write bridge/solana/chains/solana/config.json for chain id 91600046870081 listing the wrapped SOL mint with nine decimals and its derived handle first and Sidiora's mint with six decimals and the asset id 0x21f7b20a555199fa73A238B1a91FD0f549068fEe."
do_4 = "Write bridge/evm/script/DeployPaxeerXVault.s.sol taking the owner, the attestors, the threshold and the caps as parameters with no literal compiled in, and bridge/deploy/deploy-evm-chain.sh taking a chain name: validate the configuration, refuse every placeholder, require the RPC endpoint and the deploy key through the environment variables the configuration names, bootstrap the libraries, deploy, set the attestors and every cap, read the deployed code back and write a deployment record naming the chain, the address, the deployer, the code hash and the block."
do_5 = "Write bridge/deploy/verify-evm-chain.sh submitting the vault's source to the chain's explorer through the key its configuration names and reporting the explorer's own answer, and bridge/deploy/deploy-solana-program.sh building with cargo-build-sbf and deploying with the pinned Solana toolchain in the shape interop/deploy/mirror/deploy-solana-mirror.sh uses, then initialising the program, registering every asset the configuration names and writing a record naming the program id, the program data account, the ELF hash, the vault-authority PDA with its handle and the rooted slot; both fail closed on a missing variable, an unreadable key file, a placeholder, an unconfirmed chain id or a code hash that is not the built one."
do_6 = "Write bridge/deploy/chainconfig/config_test.go loading all nine committed configurations and asserting each is accepted, and covering every refusal against a configuration differing in exactly that field; write bridge/deploy/tests/deploy-scripts-check.sh exercising each script's argument handling, its placeholder refusals and its missing-variable refusals offline in the shape interop/deploy/mirror/tests/render-config-check.sh establishes, touching no network."
verify_cmd = "timeout 20m sh -c 'go test -count=1 ./bridge/deploy/chainconfig/... && bash bridge/deploy/tests/deploy-scripts-check.sh'"
symbols = ["ChainConfig","Asset","Load","Validate","DeployPaxeerXVault"]
touches = ["bridge/deploy/chainconfig/config.go","bridge/deploy/chainconfig/validate.go","bridge/deploy/chainconfig/config_test.go","bridge/evm/chains/ethereum/config.json","bridge/evm/chains/base/config.json","bridge/evm/chains/arbitrum/config.json","bridge/evm/chains/optimism/config.json","bridge/evm/chains/bnb/config.json","bridge/evm/chains/polygon/config.json","bridge/evm/chains/avalanche/config.json","bridge/evm/chains/hyperevm/config.json","bridge/solana/chains/solana/config.json","bridge/evm/script/DeployPaxeerXVault.s.sol","bridge/deploy/deploy-evm-chain.sh","bridge/deploy/verify-evm-chain.sh","bridge/deploy/deploy-solana-program.sh","bridge/deploy/tests/deploy-scripts-check.sh"]
reqs = ["3.1","3.2","3.3","3.4","3.5","3.6","3.7","10.1","10.2","10.3","10.4","10.5"]

