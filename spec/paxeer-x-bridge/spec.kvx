[task.2.3]
title = "Submit Solana releases from the relayer with an ed25519 fee payer"
status = "pending"
wave = 2
requires = ["2.2"]
do_1 = "Write interop/crates/layerx-bridge-relayer/src/solana/release.rs building the release instruction with the recipient's full 32-byte pubkey, the mint, the amount, the paxeerTxHash and the paxeerNonce, and prepending the native secp256k1 instruction carrying at least threshold attestor signatures over the outbound preimage, laid out so every message, signature and address offset resolves inside that instruction's own data."
do_2 = "Add the Solana fee payer to src/signer.rs as an ed25519 submitter held by the remote signer under the new policy domain LayerX/bridge/solana-tx/v1, beside the existing secp256k1 submitters, so no private key enters the process or its configuration."
do_3 = "Fetch a blockhash with getLatestBlockhash, sign the transaction message with the fee payer, journal the exact signed bytes before broadcast so a restart rebroadcasts rather than re-signs, send with sendTransaction and confirm with getSignatureStatuses to the configured commitment; record an existing nullifier PDA as a completed submission rather than an error to retry, and treat an expired blockhash without inclusion as a resubmission of the same journalled attestation."
do_4 = "Wire the loop into src/relayer.rs beside the existing outbound step, watching BridgeOut on Paxeer exactly as it already does and changing no existing journal key or stream name."
do_5 = "Write interop/crates/layerx-bridge-relayer/tests/solana_release.rs and its recorded fixture covering the instruction layout against the pinned vector, the fee payer's domain, the journal written before broadcast, a restart rebroadcasting the journalled bytes, an existing nullifier recorded as completed, an expired blockhash resubmitted, and a full outbound cycle with a real signer socket and a real journal."
do_6 = "Before building a release, read the recipient PDA seeded by the BridgeOut 20-byte recipient handle with getAccountInfo and take the 32-byte pubkey from it; while that PDA does not exist, hold the release in src/journal.rs as pending-recipient and retry the lookup on later passes without signing or broadcasting anything, and cover the pending state, its resolution once the PDA appears, and a restart that keeps the release pending in interop/crates/layerx-bridge-relayer/tests/solana_release.rs and its fixture."
verify_cmd = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p layerx-bridge-relayer --test solana_release'"
symbols = ["build_release_transaction","SOLANA_TRANSACTION_DOMAIN","outbound_step"]
touches = ["interop/crates/layerx-bridge-relayer/src/solana/release.rs","interop/crates/layerx-bridge-relayer/src/solana/mod.rs","interop/crates/layerx-bridge-relayer/src/signer.rs","interop/crates/layerx-bridge-relayer/src/journal.rs","interop/crates/layerx-bridge-relayer/src/relayer.rs","interop/crates/layerx-bridge-relayer/tests/solana_release.rs","interop/crates/layerx-bridge-relayer/tests/fixtures/solana_outbound.json"]
reqs = ["8.1","8.2","8.3","8.4","8.5"]

[task.2.4]
title = "Read the deployment back with the post-deploy checklist"
status = "done"
revision = "d3d370a2cc2a69d309fb85ec3f21adcce3e7c26a"
command = "timeout 20m sh -c 'go test -count=1 ./bridge/deploy/... && bash bridge/deploy/tests/checklist-check.sh'"
exit_code = 0
