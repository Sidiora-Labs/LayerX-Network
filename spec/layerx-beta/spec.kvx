[task.4.3]
title = "Add the beta-qualify runner gate and the in-repository qualification driver"
status = "pending"
wave = 4
requires = ["1.1"]
do_1 = "In tools/qualification/release_runner.py add a human-qualify-functional gate whose local commands are those of human-qualify without human-qualify-perf and with no external ui or usability gates, and a beta-qualify gate whose local commands are those of platform-qualify with human-qualify-functional in place of human-qualify and whose external gates are platform-qualify-adoption, programs-qualify, interop-qualify and multichain-qualify; leave platform-qualify and human-qualify unchanged."
do_2 = "Write tools/qualification/beta_driver.py implementing the runner's driver contract - run --gate --output --source-identity and the four component URL flags - and producing evidence.json with every case and artifact kind in the runner's EVIDENCE_SPECS for the four external gates by executing the real stack: per-ecosystem first payments through the published SDKs against the node and agent daemon, the ten-line middleware integration, the five-minute Programs deploy and paid call through the hosted registry, the real-node hostile-program gauntlet, isolation, determinism, metering, concurrency, idempotency and crash matrix, ported reference contracts and program-heavy monetary-law replay, x402, AP2, UCP and Visa trusted-agent pinned conformance, portable verification both directions, migration and fiat fault injection, mirror offline verification and tamper rejection on the test networks, Paxeer exclusivity, one-ledger and the reference ramp end to end."
do_3 = "Make every case's result the outcome of execution; a case that cannot run reports failed with the reason and the driver exits non-zero, so the runner records the gate failed rather than passing on synthesised evidence."
do_4 = "Extend tools/qualification/test_release_runner.py to cover the two new gates and add a driver test that runs the driver against the local emulator-backed stack for at least the adoption and multichain inventories; add beta-qualify and beta-driver-test make targets."
verify_cmd = "make beta-driver-test"
