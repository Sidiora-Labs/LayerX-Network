do_1 = "Extend the release tool to emit one artifact manifest listing name, version, registry, immutable digest, signature, SBOM and attestation references, source revision and rollback identity for every published artifact."
do_2 = "Add a verification step that fetches each published artifact, checks its bytes against the manifest digest and halts the release before promotion naming the failing artifact."
