verify_cmd = "make platform-release-check platform-release-plan beta-contract-check"
symbols = ["ArtifactManifest","release_pipeline verify"]
touches = ["platform/release/src/main.rs","platform/release/registries.kvx",".github/workflows/platform.yml","platform/docs/content/beta.md","tools/ci/beta-contract-check.sh"]
