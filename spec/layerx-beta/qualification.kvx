[observation.6.11.6508]
task = "6.11"
file = "programs/sdk/rust/src/payments.rs programs/sdk/rust/src/capability.rs programs/crates/layerx-programs-runtime/tests/payment_preparation.rs"
symbol = "ProgramPaymentCapabilities PaymentGrant"
observed = "The SDK now builds one canonical mixed grant set containing ordinary capabilities, funding grants and multiple ProgramSpend payouts. Ordering matches runtime authority keys, including lexicographic seed bytes rather than the encoded length prefix. Duplicate keys are refused even with different ceilings. Zero ceilings, local capacity overflow, protocol grant-count overflow and short output buffers are refused without changing the set or short output. Maximum-length seeds at the full grant count decode through the real ABI-v2 runtime decoder."
assumption = "cargo test --locked --manifest-path programs/Cargo.toml -p layerx-programs-runtime --test payment_preparation exits 0 (4 tests). SDK/runtime all-target Clippy with -D warnings and package-scoped cargo fmt --check exit 0. Evidence: qual-logs/pay5/mixed-grants-qualified-test.log, mixed-grants-qualified-clippy.log and mixed-grants-qualified-fmt.log. This completes grant composition but does not resolve native signer/account admission or establish native settlement."
severity = "note"

[observation.6.11.6509]
task = "6.11"
file = "programs/fixtures/pay5/payments-merchant.wasm programs/crates/layerx-programs-runtime/src/merchant_tests.rs"
symbol = "merchant_stages_one_funding_leg_and_two_exact_owner_payouts merchant_discards_all_staged_legs_when_either_payout_is_refused"
observed = "The real merchant WASM fixture stages a funding leg and exact merchant/collector program-account payouts. Runtime execution verifies the derived source, owner program, seed, asset, destinations and amounts. Removing any grant or reducing any ceiling causes a refusal with no surviving transfer effects; zero legs, an overdrawn split and malformed calldata also refuse. The tests use the real executor and authenticated-context type and leave storage unchanged."
assumption = "cargo build --locked --manifest-path programs/sdk/rust/examples/payments-merchant/Cargo.toml --target wasm32-unknown-unknown --release exits 0. cargo test --locked --manifest-path programs/Cargo.toml -p layerx-programs-runtime --lib merchant_tests exits 0 (3 tests); runtime all-target Clippy with -D warnings exits 0. Evidence: qual-logs/pay5/merchant-continuation-build.log, merchant-execution.log and merchant-runtime-clippy.log. These are runtime guest/effect tests, not native deploy/call or kernel settlement proofs."
severity = "note"

[observation.6.11.6510]
task = "6.11"
file = "src/protocol/lxp_kernel.c include/layerx/lxp_kernel.h src/protocol/lxp_module_ctx.c src/ledger/lx_account_id.c include/layerx/lxp_ledger.h src/ledger/lx_account_registry.c tests/programs/test_call_activity.c"
symbol = "lxp_kernel_bind_ledger_admission snapshot_bind_call_admission kernel_snapshot_payer_balance lxp_ctx_ledger_execution_sequence lx_account_name_parse"
observed = "The native Programs identity/account integration remains blocked by shared interfaces outside the granted additive paths. Kernel ledger admission snapshots authority.principal as account_id, call admission records principal as payer, and prepared payer lookup resolves principal as an account ID. The module-context consumer checks those exact admission facts. The shared account-name parser has no agent:<DID>:asset:<hex64> case. Existing native protocol-3 Programs fixtures explicitly put actor account IDs into authority.principal and use account names that omit the signed DID prefix. Raw source evidence with line numbers: qual-logs/pay5/native-account-boundary.log."
assumption = "Required integration changes are independent signer/account admission and payer binding in src/protocol/lxp_kernel.c and the corresponding facts in include/layerx/lxp_kernel.h, canonical per-asset account parsing/kind/registration in the shared ledger paths, and migration of native fixture setup while preserving every ownership, balance, asset, fee, sequence and receipt assertion. These paths were not modified. The granted downstream paths alone do not repair the shared payer/admission contract. Native successful merchant/token payment fixtures, actual registry publication receipts and native allowance/settlement rollback proof remain unqualified; the committed runtime and registry-input fixtures do not establish them."
severity = "blocker"

