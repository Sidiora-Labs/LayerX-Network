symbol = "account_proof_export_preserves_exact_native_verified_bytes lifecycle_routes_submit_real_signed_activities_and_verify_state_receipts local_gateway_committed_payment_reads local_gateway_lifecycle local_gateway_successful_send_latency local_gateway_websocket_receipt_wake public_read_selectors_use_real_node_and_refuse_missing_evidence supervisor_reset_rebuilds_genesis_and_replays_once"
observed = "The aggregate standalone gateway lifecycle target passes 12 of 20 tests and retains eight unrelated failures. Two core fixtures require immediate HTTP 200 and receive typed HTTP 202 pending with the exact activity. The committed fee read receives JSON-RPC -32602 invalid_asset_activity where its assertion requires a fee. The legacy lifecycle verifier observes a receipt digest mismatch. One twenty-SEND latency run receives typed -32001 pending after seventeen completed samples. The unauthenticated WebSocket case returns HTTP 400 where its assertion requires 401. The empty DID-account read returns an authenticated HTTP 200 empty list where its assertion requires 503. Supervisor reset cannot start because socat is unavailable. Evidence: qual-logs/pay6/pay6h-gateway-local-full-final.log."
assumption = "The assertions and typed refusals remain unchanged. The focused local_gateway_rpc and grant-draw-renewal targets pass independently, so these aggregate failures do not invalidate their exact results."
severity = "blocker"

[observation.6.7.6608]
task = "6.7"
file = "src/ledger/lx_account_id.c platform/hosted/core/tests/boundary.rs platform/hosted/gateway/src/rpc.rs platform/hosted/gateway/src/ws.rs platform/hosted/gateway/openrpc.json"
