[observation.2.1.1]
task = "2.1"
file = "cmd/layerxd/lxp_daemon_process.c"
symbol = "apply_canonical_activity apply_canonical_batch executor_run admission_journal_recover"
observed = "The durable admission journal preserves an acknowledged activity when downstream application returns a failure before canonical publication, and restart replays that preserved record. The existing executor has only success or fail-stop outcomes, while apply_canonical_activity and apply_canonical_batch can return state-dependent pre-publication errors after admission (for example an identity becoming frozen or a signing key becoming invalid behind earlier queued state changes). No existing canonical rejection transition advances the Programs feed frontier for such a record, so repeated restart can repeatedly encounter the same preserved head. Dropping it, assigning a canonical sequence at admission, or fabricating a rejection receipt would change sequencer and consensus semantics beyond task 2.1."
assumption = "Task 2.1 remains fail-closed and preserves the acknowledged bytes. A follow-up protocol task must define and qualify a canonical terminal rejection transition, including receipt identity, sequence consumption, WAL publication and retry semantics, before the node may retire this class of record without a successful canonical apply."
severity = "blocker"

[observation.2.1.2]
task = "2.1"
file = "agent/crates/layerx-sdk/src/program_http.rs"
symbol = "agent-test-client-submit boundary-check"
observed = "The unchanged shared agent-test-client-submit target runs the changed layerx-client submit integration test successfully (5 passed) and then fails its strict repository-wide boundary-check with ambient-nondeterminism at program_http.rs. The same exact cargo run --manifest-path agent/tools/boundary-check/Cargo.toml --locked --quiet -- agent command exits 1 with the same finding from the root checkout at the task's qualification baseline; both program_http.rs and the checker are byte-unchanged from task base 6eef3d06."
assumption = "Task 2.1 leaves the strict shared target and the out-of-scope SDK source unchanged. Its verify_cmd uses agent-test-client-submit-focused to execute only the task-owned submit integration suite; the repository-wide ambient-clock violation remains visible and must be repaired by the owner of program_http.rs before agent-test-client-submit can pass."
severity = "blocker"

[observation.2.1.3]
task = "2.1"
file = ".codegraph"
symbol = "cg guard --strict cg review"
observed = "In the isolated task worktree, cg guard --strict exited 0 but reported 'no task in progress - nothing to measure against', so no scope pass was claimed, and bounded cg review timed out silently after 120.45 seconds. After integration under active task 2.1, cg sync completed in 2.76 seconds and the exact Git diff remained limited to the declared task paths plus the owner's separate spec/workflow.kvx edit. Codify status still compared the tree to snapshot a89579585fb7 from 2026-08-28 rather than Git base 6eef3d06, so cg changes reported 256 historical files and cg guard --strict reported 639 out-of-scope paths from already-committed work before timing out at 120.05 seconds. Root cg review again produced no output and timed out at 120.08 seconds."
assumption = "No guard or review pass is claimed. The stale Codify snapshot and non-terminating review are tool-state blockers rather than evidence against the task-scoped Git diff; the exact verify command, render check, Git diff-to-touch reconciliation and two independent source reviews remain the task evidence. Task completion may use the owner's authorized force override only after those substantive gates pass, while the Codify snapshot is repaired separately without rewriting committed project history."
severity = "blocker"

[observation.3.5.1]
task = "3.5"
file = "platform/ramps/toolkit/src/journal.rs"
symbol = "Event Journal::open"
observed = "At task base 15267435 the ramp journal Event enum is serialized internally tagged (serde tag = \"kind\") while RampOrder carries four u128 fields (layerx_amount, external_amount_minor, rate_numerator, fee_minor). serde 1.0.229 buffers internally tagged content through its Content deserializer, which rejects u128 with 'u128 is not supported', so every order_created record written by the journal was unreadable on reopen and Journal::open failed with RampError::Journal for any journal holding an order; no test at base reopened a journal, so the defect was invisible. Reproduced in this worktree by restoring the tag and running the new replay, torn-tail and fault-injection tests (4 of 9 tests failed at open_journal) and by a throwaway round-trip probe of Event::OrderCreated that returned Error(\"u128 is not supported\")."
assumption = "Replay equivalence (req 9 ac_5) cannot be proven while the durable format cannot be read back, so the repair is task-scoped: Event is now externally tagged (rename_all snake_case, deny_unknown_fields kept), which deserializes each variant directly from the parser and round-trips u128. The record hash chain, deny_unknown_fields validation and every field are unchanged; only the JSON shape of the event object changes from {\"kind\":\"order_created\",...} to {\"order_created\":{...}}. No ramp journal written at or before the task base can have been replayed, and no deployed beta ramp exists yet, so there is no journal to migrate; if the owner requires the tagged shape instead, u128 fields would need a custom string encoding, which is a wider change than this task."
severity = "note"

