[observation.6.11.terminal-authenticated-discriminator]
task = "6.11"
file = "agent/sdk/python/layerx_sdk/program_wire.py"
symbol = "decode_and_verify_program_terminal TransferCapability::authorize V2ActivityRecord::write_canonical_evidence"
observed = "Both supplied native artifacts, /root/lx-lanes/native/qual-logs/item5-executed-native.json and /root/lx-lanes/native/platform/sdk/conformance/fixtures/receipt-programs-executed-v3.json, pass receipt signature, activity-id binding and terminal/call-graph digest checks. Authenticated protocol/module/guest-ABI/runtime versions are 3/4/2/1. The receipt binds outcome encoding, terminal kind/result, runtime/ABI, fee/metering versions and usage, occupancy commitments, transfer root, terminal root and graph root. Its CALL_OUTCOME event additionally binds program, principal, activity, frame and event-envelope digest (src/modules/programs/event.c:197-236); it does not carry transfer legs or transfer-set version. execution-v4 binds runtime, fee/metering versions, outputs, usage, optional trace, program, guest ABI, result/response and graph (execute.rs:2072-2152). Graph evidence binds principal, graph limits and caller/callee/depth edges (calls.rs:356-375), not capability sets or transfer sources. Guest ABI2 produces both transfer-set versions: transfer.rs:330-341 selects V2 from root ProgramSpend, nested ProgramSpend, or Program/ProgramFunding sources. abi/capability.rs:519-536 permits caller-owned ProgramSpend to originate on an edge; absence of root ProgramSpend alone cannot classify all nested executions. The activity-id-bound native call supplies guest ABI and root capability grants, but those bytes are absent from the standalone terminal decoder inputs. In these artifacts its sole Transfer402 grant has maximum_amount 1. Permission maxima are not general applied-leg evidence. The candidate response is empty, graph length is 86, receipt amount is zero, and its sole effect is the CALL_OUTCOME event. No existing receipt or terminal field independently identifies transfer-set V1 versus V2 without the authority attachment, and no applied principal leg list is supplied for canonical_kernel_legs/root reconstruction (transfer.rs:1183-1230)."
assumption = "No byte-format change is permitted. Presence or absence of the authority wrapper cannot itself replace an independent discriminator. Root equality against another committed copy does not reconstruct the applied root. Implementation stops before Python and before other SDK changes. python3 qual-logs/inspect-discriminator.py > qual-logs/terminal-discriminator.log 2>&1 exits 0 as an inspection: original and mutated-transfer-root outcomes both reject with invalid transfer authority presence; this is not a passing principal-only verifier or a successful root-reconstruction negative test. The native fixtures were read without regeneration. Required make/SDK/ABI-drift gates were not run because the prerequisite evidence contract is unavailable. programs/abi-frozen.sha256 remains byte-identical to HEAD."
severity = "blocker"

