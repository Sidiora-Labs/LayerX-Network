[observation.3.4.15]
task = "3.4"
severity = "note"
file = "platform/hosted/tests/beta-cluster.sh platform/hosted/tests/sequencer-pins.py platform/hosted/tests/test_sequencer_pins.py"
symbol = "encode_trust_history provision"
observed = "Cluster trust-history production now emits protocol 3 and pin provisioning requires exactly protocol 3. Real OpenSSL sequencer identities pass through the sourced shell encoder and production pin consumer with exact output assertions. Versions 0, 1, 2, 4 and 65535 refuse without publishing pin files; domain, entry count, truncation, trailing bytes, network, epoch, first/last batch, revocation and public-key mutations preserve refusal. Seventeen trust tests and eighteen Human tests pass in qual-logs/reg2/reg2e-trust-python.log. Registry locked tests, strict all-targets Clippy, formatting and shell syntax pass in reg2e-trust-registry.log, reg2e-trust-clippy.log, reg2e-trust-fmt.log and reg2e-trust-shell.log. beta-ledger-check passes in reg2e-trust-ledger.log."
assumption = "The cluster generator and pin consumer require one protocol version; legacy verification support in the registry remains unchanged. Real cluster/image/ingress/PVC qualification is still unavailable on this host, and local source/native qualification does not establish hosted deployment success."
