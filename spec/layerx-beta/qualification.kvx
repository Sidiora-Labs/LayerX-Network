[observation.6.8.125]
task = "6.8"
severity = "blocker"
file = "human/crates/layerx-human-identity-provider/src/state.rs human/crates/layerx-human-security-provider/src/state.rs platform/hosted/tests/beta-cluster.sh platform/hosted/authority/README.md platform/hosted/registry/src/routes.rs"
symbol = "account_fields provision RecoveryReceipt::verify ingest_recovery_receipt secrets_generate internal_principals_provision deployment_proof_unavailable"
observed = "LXIP operation 1 returns only principal, DID, recovery root, threshold and delay; it produces no protocol owner account, authority reference, capabilities or receipt-backed identity and key policies. Recovery ingest verifies canonical receipt encoding and signed historical inclusion but contains no operator Ed25519 key-set commitment derivation to reuse. human_secrets_generate executes before contracts and identity/gateway provisioning; human_policy_publish also precedes identity provisioning. Gateway key responses and identity session responses are deleted. Registry ingress refuses deployment_proof_unavailable and produces no admission/deployment journal. The authority executable has no configuration-validation mode."
assumption = "Complete Human evidence provisioning requires real owner-account and authority registration outputs, receipt-backed principal policies, a canonical recovery commitment verifier, preserved non-secret tenant/principal bindings, corrected bootstrap ordering and real registry journal pairs. CLI-only provider changes and a single call before human_secrets_generate cannot establish these missing facts. No commitment algorithm, authority identifier, receipt or journal is fabricated. Retained-network consumed limits and checkpoint-authority Secret publication require upstream evidence; cluster and image gates are unavailable on the build host."

