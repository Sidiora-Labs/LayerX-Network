[observation.3.7.custody-first-genesis]
task = "3.7"
file = "contracts/config/StaticConfig.sol"
symbol = "Config hashForProtocol PaxeerBetaDeploymentValidator PaxeerBetaDeploy"
observed = "Custody-first genesis is circular with the settlement deployment: StaticConfig requires three distinct nonzero genesis commitments (LXGD/LXRR roots) as constructor inputs and hashes them into the component config, so they are part of the vault runtime bytecode; the custody credit profile pins that vault runtime SHA256 and address into genesis; and PaxeerBetaDeploy derives deployment and address prediction from already-produced genesis artifacts. No script ordering in platform/hosted/paxeer/deploy-contracts.sh can satisfy both without manufacturing roots. Evidence: lane custody-funding-2 pass 2 STATUS.md item 4 and NEEDS.md; PR #105."
assumption = "Owner decision: the beta bootstraps with ordinary genesis and registers the vault through the existing custody-credit registration path after genesis; the custody-first genesis path remains unqualified for the beta and any contract-level resolution (post-genesis commitment setter behind validator and timelock, two-phase vault, or removing the runtime pin from the profile) is deferred to a later protocol change. No settlement contract, validator, deploy script or profile check is altered for the beta on this basis."
