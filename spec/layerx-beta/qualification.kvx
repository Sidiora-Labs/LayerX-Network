[observation.6.7.4028]
task = "6.7"
file = "platform/middleware/seller/src/commitment.ts platform/middleware/seller/src/index.ts platform/middleware/buyer/src/index.ts agent/sdk/python/layerx_sdk/x402.py agent/sdk/python/layerx_sdk/x402_http.py agent/sdk/typescript/src/x402/receive.ts agent/sdk/python/layerx_sdk/x402_receive.py spec/402lxp/protocol.md"
symbol = "paymentPayer paymentPurpose verifyPaymentReceipt verify_payment_receipt encodeAssetRegister encode_asset_register"
observed = "Metered and subscription challenges require an explicit nonzero lowercase payer and purpose hash. The receive core, embedded payer grant, verified receipt source and successful settlement payer are bound in both languages; grant settlements repeat and buyers verify the challenged purpose. Executed receipts cannot satisfy batched offers, and real signed batch inclusion is verified only with caller-configured network and sequencer authorization. Native Asset registration codecs derive kind-1 ids, preserve explicit kind-2 ids, emit the exact version-1 big-endian signer vector and refuse malformed metadata, bounds and custody. TypeScript SDK tests, all middleware builds, 21 TypeScript payment tests, 34 Python SDK tests, 42 Python payment tests, Python Ruff, signer payment vectors, native Asset registry and Receive tests pass. Evidence: qual-logs/pay6/pay6d-sdk-typescript.log, pay6d-middleware-build-rerun.log, pay6d-payments-typescript-rerun.log, pay6d-sdk-python.log, pay6d-payments-python-rerun.log, pay6d-python-lint-rerun.log, pay6d-signer-payments.log and pay6d-native-asset-receive.log."
assumption = "The aggregate middleware conformance result remains 25 of 29 with the same four base-reproduced contradictions recorded in observation.6.7.4025. Passing codec and proof gates do not establish native draw execution or hosted deployment."
severity = "note"

[observation.6.7.4029]
task = "6.7"
file = "agent/crates/layerx-crypto/src/disclosure.rs agent/crates/layerx-crypto/src/payments.rs src/modules/asset/lx_asset_registry.c platform/hosted/gateway/src/lib.rs platform/hosted/gateway/tests/local/lifecycle.rs"
symbol = "RECEIVE_FIELD_COUNT Payment::decode IssueGrant verify_submission local_gateway_rpc"
observed = "The shared signer disclosure and payment decoder require Asset ordinal 6 tag 0x5201 with field_count 8 and finish after the short core. Native and payment middleware require the canonical 733-byte field_count-10 Receive with receiver authorization and the 346-byte payer grant. The signer ordinal-7 decoder separately requires a generic 0x2001 grant structure while native ordinal 7 decodes the canonical payer grant directly. Gateway verify_submission invokes this disclosure for Asset transfer activities, so canonical grant issue and Receive activities cannot traverse the current production gateway signing boundary. The isolated local_gateway_rpc attempt built the real native and hosted binaries but stopped before gateway startup because /usr/bin/redis-server is absent. Gateway unit tests pass 35 checks; both real-Redis integration tests stop on the same missing executable. Evidence: qual-logs/pay6/pay6d-native-binaries.log, pay6d-hosted-binaries.log, pay6d-hosted-rpc.log and pay6d-gateway-tests.log."
assumption = "The signer and gateway files are outside payment-middleware ownership and must be reconciled to the native canonical grant and Receive without bypassing disclosure. A TLS Redis prerequisite is also required before rerunning executed and batched metered draw and recurring renewal through POST /rpc. No acknowledgement, pending result, offline fixture or successful build is treated as settlement evidence."
severity = "blocker"

