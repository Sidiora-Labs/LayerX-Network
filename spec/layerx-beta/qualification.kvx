[observation.6.1.5]
task = "6.1"
file = "scripts/PaxeerBetaDeploy.s.sol"
symbol = "_predictGuarantorBond _deployGuarantorBond StaticConfig.hashForProtocol"
observed = "The settlement runner decodes LXGD/LXRR before deploying or predicting Blueprint, timelock, asset registry, vault and bond. StaticConfig.validateForProtocol requires three distinct nonzero genesis commitments; hashForProtocol includes them in the component config hash embedded in vault runtime. A custody profile pins the vault address and runtime SHA256 before its native genesis is built. The current deployment contract therefore cannot be split solely in deploy-contracts.sh without changing the genesis-dependent configuration contract. GuarantorBond additionally requires the fixed USDL token and asset; CheckpointRegistry construction requires genuine native genesis roots. The retained settlement-deploy.log contains only Error: EVM error and does not identify an internal revert."
assumption = "A custody-first configuration and deployment interface is required from the Solidity owner. Preserve constructor, runtime pin, prediction and genesis checks; do not substitute WETH for USDL, manufacture roots, or present the WETH evidence deployment as a complete settlement suite. A disposable paxd reproduction or sanitized internal failure evidence is still required to diagnose prediction."
severity = "blocker"

