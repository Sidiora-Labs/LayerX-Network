symbol = "human_secrets_generate human_secrets_apply start_human_owner RemoteHumanAuthority::connect"
observed = "The Human graph is co-located with the native node, using shareProcessNamespace and its memory socket volume. The owner uses the existing authorized UID 4021 and GID 4020; the API and Unix providers use UID 4020. Human Service port 9443 targets the separate container port 9447. A Human-owned egress policy admits only journeys and approvals to that node port. Secret generation creates bounded component configuration, random keys, distinct authority audiences, a session operator secret and KMS server/client certificates with UID-owned private staging. Registered authority, recovery, module registry, real Programs probe/journal and custody contract bindings remain mandatory policy inputs. The provider image build and COPY lines remain commented until their crates land. Current agentd startup additionally requires a verified Programs reader; its Human authority client does not configure the generated private CA. Those sources are unchanged."
assumption = "bash -n platform/hosted/tests/beta-cluster.sh platform/hosted/human/material.sh platform/hosted/human/entrypoint.sh exits 0; qual-logs/hm6/bash-n.log. make platform-hosted-topology-check exits 0 after the Human egress and YAML formatting corrections, including both parsers and existing negative regressions; qual-logs/hm6/topology-formatted.log. bash tools/ci/beta-contract-check.sh and make beta-ledger-check exit 0 before this appended observation; qual-logs/hm6/contract.log and ledger.log. git diff --check exits 0; qual-logs/hm6/diff-final.log. Both kubectl apply --dry-run=client attempts fail to retrieve OpenAPI from an unconfigured API server; qual-logs/hm6/kubectl-node.log and kubectl-human.log. Validation is not disabled. Secret generation, image builds, provider processes, peer-credential refusal, KMS exchange and cluster readiness have not been executed. Static topology is not runtime qualification."
