[observation.6.8.120]
task = "6.8"
severity = "blocker"
file = "platform/hosted/registry/src/main.rs platform/hosted/registry/src/routes.rs platform/hosted/registry/src/builder.rs platform/hosted/gateway/src/main.rs"
symbol = "serve_connection isolated_route request_worker Registrar::open HermeticBuilder::new environment_digest program_registry_ready"
observed = "The retained cluster has three Running gateway pods with readiness HTTP 503. A verified TLS GET /readyz reports durable_store, core_agent_boundary and independent_receipt_authority ready, and program_registry unavailable. Gateway container logs are empty. The registry TCP probe passes but direct requests with the gateway client certificate and the registry DNS name fail during TLS with curl exit 35. The registry process has 256 to 258 threads, while its configured default connection bound is 128. Live request workers are attached inside /workers/request-*/worker and read builder toolchain files under /opt/layerx-builder/rootfs; process samples show successive workers doing this repeatedly. Source inspection shows /healthz takes registrar_gate, starts an isolated worker, and calls Registrar::open, which invokes HermeticBuilder::new and environment_digest with no hashing deadline before routing healthz. Requests queue behind that work for up to 1800 seconds; the gateway outbound I/O bound is 8 seconds and its readiness probe retains the default 1-second timeout. Evidence: qual-logs/au40/gateway-readiness.log, gateway-events.log, gateway-container.log, registry-health-mtls.log, registry-health-mtls.exit and registry-process-samples.log. The previous full gate exit remains 2 in qual-logs/au39/task-6.8.exit."
assumption = "Registry request initialization and serialized readiness must be repaired in the registry implementation while preserving builder integrity verification, worker isolation, connection bounds and request deadlines. The gateway readiness conjunction and probes remain unchanged. Connection saturation is consistent with the observed thread count and immediate TLS refusal; no instrumented active-connection counter was collected. This is a registry implementation dependency, not a qualified gateway repair. The full gate was not rerun and the retained cluster remains available for diagnosis."

[observation.6.8.121]
task = "6.8"
severity = "blocker"
file = "platform/hosted/registry/src/builder.rs platform/hosted/registry/src/main.rs platform/hosted/registry/src/routes.rs platform/hosted/registry/tests/readiness.py docs/wiki/Quickstart.md"
symbol = "HermeticBuilder::new environment_metadata Registrar::open_with_builder route_request"
observed = "The listener retains the startup-verified builder and passes it through bounded parent-owned worker IPC; workers retain cgroup attachment, quota validation, request deadlines and per-build copied-environment and executable verification. Health bypasses the registrar serialization lock while replaying durable evidence and checking the node without writing the protocol cursor. A background metadata and inotify detector clears readiness on changed inputs and fully re-verifies against the startup digest before restoring readiness; stale monitor results refuse after two seconds. The original metadata-only mutation test failed on a rapid same-size write with identical timestamps. Its assertion is unchanged; inotify invalidation repairs this gap. Strict locked Clippy passes on the final Rust source (qual-logs/au41/clippy-watch.log, exit 0). The aggregate cargo test invocation exits 101 because root cannot allocate an inotify instance, returning EMFILE (qual-logs/au41/test-watch.log). All seven library tests pass under the actual registry UID/GID 4030 (qual-logs/au41/lib-tests-4030.log, exit 0). All five binary tests, including real stopped-child cgroup attachment and cleanup, and all six journal tests pass under root (qual-logs/au41/remaining-tests.log, exit 0). The real-binary concurrent-build latency and temporary-rootfs mutation test is written but unexecuted. Quickstart now describes the separate agent boundary export, absent-agentd unset and Human endpoint selected by env_write."
assumption = "Deployment qualification is blocked by the existing disk preflight: 18 GiB free versus 30 GiB required, exit 1 in qual-logs/au41/cluster-preflight.log. No space bound or kernel watch limit was raised. No image was rebuilt or loaded and the retained cluster was not modified. The exact full wrapper was not run; qual-logs/au39/task-6.8.exit retains its previous failed result. The wrapper tears down the cluster and calls build_images for every image, which also conflicts with rebuilding only the changed image; the required script change is outside the granted paths and is recorded in NEEDS.md. No live health latency, rootfs mutation refusal or cluster pass is claimed. Codify review and guard each reached their 60-second limit with exit 124; no graph qualification is claimed."

