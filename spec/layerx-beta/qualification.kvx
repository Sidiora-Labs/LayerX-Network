[observation.3.4.10]
task = "3.4"
severity = "blocker"
file = "platform/hosted/registry/journal-pvc.yaml platform/hosted/registry/deployment.yaml platform/hosted/human/provision-owner-job.yaml platform/hosted/human/provision.sh platform/hosted/tests/beta-cluster.sh"
symbol = "LAYERX_REGISTRY_JOURNAL human_evidence_provision trusted_boundary_apply"
observed = "A shared ReadWriteOnce journal PVC is rendered and applied with boundary prerequisites. Registry and owner-provisioning Job mount the same journal subpath at their identical LAYERX_REGISTRY_JOURNAL path; registry initializes mode 0700 under UID 4030, Job mounts read-only, and registry affinity colocates with the node used by the pinned owner Job. YAML assertions verify claim, path, subpath, readonly policy and colocation; shell syntax, Human Python tests and registry manifest contract pass in qual-logs/reg2/journal-manifests.log, journal-shell.log, journal-human-tests.log and journal-registry-manifest-test.log. The merged tree has only provision-owner-job.yaml: its binaries provision identities and accounts, not journal evidence. provision.sh invokes provision.py --validate-evidence-inputs and --assemble on the host with a host-local --journal path before beta-cluster.sh applies the registry StatefulSet."
assumption = "The mount is a source checkpoint, not activated journal consumption. Startup ordering must create the registry and its journal subpath before evidence collection. An explicit protected PVC-to-host export or actual in-cluster assembler is still required. UID 4020 cannot read UID 4030 private journal files, and the existing parsers require the executing user to own copied files; changing modes or accepting foreign ownership would weaken the contract. No Kubernetes, image, scheduling or mounted-volume gate ran."

