[observation.6.7.6613]
task = "6.7"
file = "tests/support/lxgb_metadata.rs platform/hosted/core/tests/boundary.rs platform/hosted/gateway/tests/local/lifecycle.rs cmd/layerx-genesis/lxp_genesis_build_cli.c"
symbol = "build_genesis funded_genesis local_gateway_rpc local_gateway_lifecycle local_gateway_grant_draw_and_subscription_renewal_latency local_gateway_successful_send_latency"
observed = "Every local gateway harness target fails before reaching a single assertion on this revision. All four panic in the generated cluster fixture at core_fixture.rs line 144: build/bin/layerx-genesis-build exits 1 with no diagnostic on the request the fixture writes. The refusal reproduces outside the harness: a 770-byte version 2 LXGB request whose header is the fixture header and whose metadata comes from the shared support module is refused with exit 1 by the same binary, and the builder is silent because lxp_genesis_builder_cli_main returns 1 without printing. The shared fixture emits an asset record that lx_asset_record_decode refuses, the condition already recorded in observation 6.1.5801. With the shared fixture change carried on the open lane/day-g12 branch applied locally and uncommitted, the same target starts a real cluster and runs for 12.75 seconds before failing on a later assertion. Evidence: qual-logs/c3/15c.log, qual-logs/c3/15d.log, qual-logs/c3/15e.log, qual-logs/c3/15f.log, qual-logs/c3/genesis-repro.log and qual-logs/c3/15d-with-pr248.log."
assumption = "This branch changes no file on that path: the fixture, the support module, the builder and the core boundary source are byte-identical to the published tree here. Until the fixture emits a record the registry accepts, no local gateway harness gate can qualify anything on this revision."
severity = "blocker"

[observation.6.7.6614]
task = "6.7"
file = "platform/hosted/gateway/tests/local/lifecycle.rs platform/hosted/gateway/src platform/hosted/core/src/public_reads.rs"
symbol = "assert_unavailable_reads local_gateway_rpc lx_listAssets lx_getBalances"
observed = "With the fixture refusal of observation 6.7.6613 lifted locally so the cluster starts, local_gateway_rpc fails inside the published helper assert_unavailable_reads at lifecycle.rs line 944: the answer carries no error member where the assertion requires JSON-RPC -32001, so the read resolves instead of refusing. An earlier state of this branch replaced that helper with one asserting the resolved shapes, which would have made the test follow the current behaviour; the replacement was withdrawn and the published helper is restored byte for byte, so the disagreement between the published read behaviour and the published assertion stays visible in the tree. Evidence: qual-logs/c3/15d-with-pr248.log."
assumption = "The read contract and its assertion are owned outside this transport row. Nothing was relaxed here: the branch leaves both the assertion and the behaviour exactly as published and records the conflict instead of resolving it."
severity = "blocker"

[observation.6.7.6615]
task = "6.7"
file = "platform/hosted/gateway/tests/local/lifecycle.rs platform/hosted/gateway/src platform/hosted/authority"
symbol = "local_gateway_rpc lx_sendActivity authority_unavailable"
observed = "With both the fixture refusal of observation 6.7.6613 and the read-contract disagreement of observation 6.7.6614 lifted locally, local_gateway_rpc reaches the first authenticated submission and receives JSON-RPC -32001 "Submission unavailable" whose data carries error code authority_unavailable, where lifecycle.rs line 868 requires a result whose commitment is executed. The run therefore never reaches the commitment assertion this branch changes, which sits later in the same test. Evidence: qual-logs/c3/15d-read-contracts-and-pr248.log."
assumption = "The receipt-authority service was started by the harness from binaries this run built from the published platform workspace. Whether the refusal is a harness prerequisite or a service defect is undetermined here, so it is recorded rather than attributed."
severity = "suspect"

[observation.6.7.6616]
task = "6.7"
file = "platform/hosted/gateway/tests/local/lifecycle.rs spec/402lxp/protocol.md"
symbol = "local_gateway_rpc lx_sendActivity finalised"
observed = "The single assertion this branch changes in the local gateway harness requires an unavailable finalised commitment to answer a typed JSON-RPC -32001 carrying requested_commitment and state with no result member, where the published assertion requires a result whose state is pending and whose commitment has been downgraded to executed. It could not be exercised on this revision for the three reasons in observations 6.7.6613, 6.7.6614 and 6.7.6615, each of which stops local_gateway_rpc earlier in the same test. The assertion compiles: the harness test target builds with exit 0 and rustfmt reports no change for the file."
assumption = "The anti-downgrade rule the assertion pins is the rule this branch writes into spec/402lxp/protocol.md and the one both SDK draw paths and the payment conformance suites enforce. The assertion stays in the tree unqualified rather than being dropped, and the gate is reported as not run."
severity = "note"

