[observation.6.11.6402]
task = "6.11"
file = "platform/cli/src/wallet.rs platform/cli/src/wallet_send.rs platform/cli/src/wallet_signing.rs platform/cli/src/wallet_encoding.rs platform/cli/tests/wallet_send.rs platform/cli/tests/fixtures/native-send.c"
symbol = "execute_write prepare_send PreparedPayment::from_send Send::encode native_send_and_authorization_bytes_match"
observed = "CLI Send and token transfer use the disclosed shared native debit signer, then the shared canonical envelope encoder with an independently authenticated identity sequence. Token writes use the shared Payment codec; local duplicate Send, registration and envelope byte encoders are removed. The shared wire account-name builder is used. Typed SDK balance, asset and fee reads retain upstream errors; typed submission errors are not consumed as admission success. Activity identifiers are derived locally from signed bytes and output before submission. Success requires SDK receipt verification at the requested commitment. The native C differential fixture now signs its original large-amount and sequence vector with OpenSSL Ed25519; Rust compares the complete bytes and authorization message, verifies the signed envelope, and retains every bound and binding refusal. Receive and payer-grant fixtures remain 733 and 346 bytes. CLI full tests, fmt --check and all-target Clippy with -D warnings pass. Crypto, SDK, wire and types full tests, fmt --check and all-target Clippy pass from the agent workspace. Evidence: qual-logs/pay3/pay3f-tests-final.log, pay3f-wallet-fixtures.log, pay3f-cli-fmt-final.log, pay3f-cli-clippy-final.log, pay3f-agent-tests.log, pay3f-agent-fmt.log and pay3f-agent-clippy.log."
assumption = "Qualification uses the generated platform lock retained outside version control pending workspace-owner integration. The published contract fixture is verbatim 75049011. No funded public Send, authenticated deployed token execution or live subscription delivery is implied by local qualification."
severity = "note"

[observation.6.11.6403]
task = "6.11"
file = "platform/Cargo.lock platform/cli/tests/wallet_commands.rs agent/crates/layerx-sdk/src/rpc_verification.rs"
symbol = "unpublished_registration_and_history_preserve_local_keys acknowledgement_is_not_inclusion finality_requires_the_exact_trusted_context_and_header"
observed = "The added CLI command test confirms unpublished registration and history return their typed errors without changing local key metadata. SDK evidence tests retain acknowledgement refusal and exact trusted-context/header finality checks. After passing source qualification with the generated lock, the tracked platform lock was restored. cargo check --manifest-path platform/cli/Cargo.toml --locked exits 101 because that lock needs an update. Generated lock and binary patch remain in qual-logs/pay3/pay3f-platform-Cargo.lock and pay3f-platform-lock.patch. Scoped cargo clean exits zero; worktree target size is recorded in pay3f-disk.log. Logs: pay3f-wallet-commands-final.log, pay3f-sdk-verification.log, pay3f-locked-check.log and pay3f-clean.log."
assumption = "The workspace lock update is required before locked reproducibility can be claimed. Source test success is not a public deployment or funded execution claim."
