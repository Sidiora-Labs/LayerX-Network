[observation.6.8.6908]
task = "6.8"
severity = "blocker"
file = "platform/hosted/tests/beta-cluster.sh platform/hosted/webhooks/Dockerfile"
symbol = "build_images preflight_disk"
observed = "The exact bash qual-logs/au39/run-gate-3.sh wrapper exits 2 at source e7ebdebe. The required pre-run Docker builder and dangling-image prunes reclaim no space; deleting only the disposable layerx-au32 cluster that the wrapper recreates raises free space from 28 GiB to 43 GiB. Topology checks pass and the testnet-control, gateway, faucet and registry images build. During export of the fifth image, layerx-webhooks, free space falls to 1316016128 bytes; only the wrapper-owned Docker client is terminated before host exhaustion. Its completed Rust compilation is followed by BuildKit context canceled, and the wrapper records exit 2. Evidence: qual-logs/au39/task-6.8.log, qual-logs/au39/task-6.8.exit, build/beta-cluster/logs/build-layerx-webhooks.log and qual-logs/au43e/capacity.log. Post-failure permitted prunes reclaim 12.65 GB of build cache and 985.2 MB of dangling images, leaving 13 GiB free, below the unchanged 30 GiB preflight."
assumption = "This is a capacity stop, not a compiler failure. A retry without additional safe capacity would refuse at preflight and cannot exercise the cluster. The live registry route negatives, cluster deployment, hosted smoke, retained-up gate and image publication remain unqualified. No disk bound, assertion, task status or unrelated worktree was changed."

[observation.6.8.6909]
task = "6.8"
severity = "blocker"
file = "platform/hosted/tests/beta-cluster.sh spec/layerx-beta/handoff/HANDOFF-2026-09-05.md"
symbol = "tools_install build_images cluster_create load_images builder_release_publish"
observed = "At revision 462a533b5d20cada93bd157944a3b98d234d257e, bash qual-logs/au39/run-gate-3.sh exits 2. The pinned kind v0.30.0, kubectl v1.34.1 and Calico v3.30.3 downloads match the tracked SHA-256 values. The topology phase passes with 43 edges and no failures; every one of the seventeen current-source images builds, records a SHA-256 image digest and loads into both kind nodes. Kind emits its initial control-plane readiness warning, then the tracked Calico rollout succeeds and both nodes satisfy the Ready condition. The registry node boundary installs on layerx-au32-worker. builder_release_publish then refuses because the configured /root/lx/authority/qual-logs/au39/builder-rootfs does not exist. The documented owner image ghcr.io/sidiora-labs/layerx-builder-environment:v1 is not readable without registry authority, and read-only inspection of the documented sandbox image exits 255 with SSH permission denied. Evidence: qual-logs/au39/task-6.8.log, task-6.8.exit, provision-cluster-tools.log, publish-images-check.log, image-digests.tsv, builder-environment-manifest.err and builder-environment-ssh.err."
assumption = "The prior capacity blocker is superseded on this host. The remaining failure is the absent owner-delivered hermetic builder environment, not a tracked cluster-script or image-build defect. No substitute builder bytes, gate weakening, task-status change or protected input was created. Service deployment, hosted smoke, teardown, retained-up qualification, live ingress assertions and publication remain unqualified. The disposable cluster is retained with the built images for inspection."

[observation.6.8.6910]
task = "6.8"
severity = "blocker"
file = "platform/hosted/tests/beta-cluster.sh platform/hosted/human/provision.py platform/hosted/paxeer/deploy-contracts.sh"
symbol = "environment_digest beta_cluster_up owner_registration require_tools"
observed = "At revision 5faba40ae2ea30cdff42d34200932c7dc5fbc850, the owner-delivered /root/layerx-builder-env/rootfs matches environment-tree-digest ce9d7198af2267188c27812b001cd203ed32cc3c5f370f453abc3ad39b902f01 under the tracked environment_digest byte-and-mode routine. The first exact bash qual-logs/au39/run-gate-3.sh run builds and loads all seventeen images, installs the registry boundary and exits 2 because the default Foundry path selects forge 1.8.1 while deploy-contracts.sh requires 1.7.1. The existing host version store contains verified forge and cast 1.7.1; selecting that directory through the untracked wrapper lets the second exact run build and load all seventeen images, publish the hermetic builder release, deploy and seal the settlement suite and provision two identity principals. It then exits 2 because protected human-evidence-input/owner-registration.json is absent. The real program-deployment activity and matching registry admission/deployment journal pair were produced before the refusal. Evidence: qual-logs/au43g/environment-digest.log, foundry-pin.log, full-gate-attempt-1.log, full-gate-attempt-1.exit, full-gate-attempt-2.log, full-gate-attempt-2.exit and qual-logs/au39/task-6.8.exit."
assumption = "Human provisioning requires authenticated Governance owner-registration evidence from its authority; no production writer or supplied protected file exists in this checkout or host inputs. It must not be synthesized or bypassed. Hosted service application, smoke, normal teardown, retained-up qualification, image publication and anonymous pull verification remain unqualified. The partial disposable cluster is retained."

[observation.6.8.6911]
task = "6.8"
severity = "blocker"
file = "platform/hosted/human/provision.py platform/hosted/human/provision.sh platform/hosted/human/owner_native.py platform/hosted/human/native_manifest.py platform/hosted/human/owner_custody.py platform/hosted/tests/beta-cluster.sh"
symbol = "owner_registration human_evidence_provision produce human_native_provision registry_deployment_produce human_journal_deploy"
observed = "The checked-out revision 81a092ed7955 contains only the protected owner-registration reader: human_evidence_provision invokes --validate-owner-registration before the owner Job, while beta_cluster_up already produces the signed program deployment and journal pair before entering that function. The retained full-gate log refuses exactly: /root/lx/authority/build/beta-cluster/human-evidence-input/owner-registration.json: required protected JSON unavailable or invalid. Repository object 7e59755de01faa33869691b017f535a4e6b60d3a contains the real native producer and cluster hook: it derives the owner account from the LXIP DID, binds fresh owner and rotation keys, authenticates a real custody credit, submits Governance identity, rotation and recovery activities, verifies sequencer receipts and independent receipt-authority documents, then atomically writes and revalidates owner-registration.json. That object is not an ancestor of the checked-out revision and follows required Governance registration, checkpoint, guardian, LXIP admission and custody-production objects on a divergent integration line. Evidence: qual-logs/au43g/full-gate-attempt-2.log and full-gate-attempt-2.exit."
assumption = "The owner producer and all authority-bearing prerequisites must be integrated in their recorded order before this lane can execute the real Human input production path. Running the checked-out consumer cannot create the missing evidence. No registration file, owner secret, producer fragment or weakened validation was substituted. The current build server has no Docker, kubectl, kind or live disposable cluster, so the full gate, publication, manifest inspection and retained listener checks were not rerun."

[observation.6.8.6912]
task = "6.8"
severity = "blocker"
file = "tests/bridge/custody_credit.py paxeer-network/rpc/block.go paxeer-network/consensus/internal/p2p/giga_router.go platform/hosted/human/owner_custody.py"
symbol = "header EncodeTmBlock translateGlobalBlock bootstrap"
observed = "At revision 0b879c11915eb0c945c4137395751dc0b2c8bfa4, the exact full gate builds and loads all seventeen images, creates the two-node kind cluster, reaches Ready after the tracked Calico rollout, installs the registry node boundary and starts both disposable Paxeer origins. The first invocation exits 2 because its host Python lacks Crypto; selecting an untracked virtual environment with pycryptodome lets the one retry pass that import and deploy the real beta timelock, asset registry, wrapped-native token and vault. It then exits 2 at /root/lx/authority/build/beta-cluster/human-evidence-input: custody bootstrap refused; retain artifacts for reconciliation. Direct invocation preserves the internal refusal: tests/bridge/custody_credit.py header rejects block header hash while create_profile evaluates common_finalized. The Ethereum response reports fields whose RLP Keccak differs from its hash. Both independently TLS- and genesis-verified RPC origins report hashes exactly equal to their corresponding Comet block_id hashes. Source confirms EncodeTmBlock intentionally publishes BlockID.Hash, while translateGlobalBlock assigns the SHA-256 Autobahn canonical-protobuf header hash and exposes only a sparse Comet header downstream. Evidence: qual-logs/au43i/full-gate-attempt-1.log, full-gate-attempt-1.exit, full-gate-attempt-2.log, full-gate-attempt-2.exit, custody-diagnostic-2.log, paxeer-header-diagnostic.log and consensus-hash-binding.log."
assumption = "The existing custody header-hash, quorum, ancestry, account-proof, receipt-trie and transaction-trie checks remain intact. The owned Human producer cannot reconstruct the Autobahn header hash because the Ethereum response omits the lane, lane block number, payload hash and finalized QC. Accepting the declared hash or deleting the RLP check would weaken custody evidence. The Paxeer RPC/evidence producer must expose a cryptographically verifiable Autobahn header and finality proof, or a self-consistent canonical Ethereum header/hash contract, before owner custody and the full cluster gate can pass. Image publication, manifest verification, hosted smoke and retained-up qualification were not reached."

[observation.6.8.6913]
task = "6.8"
severity = "blocker"
file = "platform/hosted/tests/beta-cluster.sh platform/Makefile.inc"
symbol = "beta_cluster_up require_tools platform-beta-cluster-down"
observed = "The full cluster gate was not run for this branch and no exit code exists for it. command -v kind and command -v kubectl both return nothing on this workstation while command -v docker resolves to /usr/bin/docker; qual-logs/c6/gate-18.log records that probe at exit 1, and the same probe repeated on the rebased head finds both still absent. platform/hosted/tests/beta-cluster.sh up and make platform-beta-cluster-down both invoke kind and kubectl directly, so the gate cannot enter cluster creation, image loading, hosted smoke, retained-up qualification or image publication here. What could be exercised was exercised at revision f52a5937890a and is recorded: bash -n over provision.sh and beta-cluster.sh parses clean (qual-logs/c6/gate-11.log, exit 0), and the script own argument refusal bash platform/hosted/tests/beta-cluster.sh invalid exits 64 exactly as its usage text documents (qual-logs/c6/gate-12.log, exit 0 asserting 64); bash -n over both scripts was repeated on the rebased head with exit 0."
assumption = "Cluster qualification for this branch stays open and has to be run on a host that provides kind and kubectl together with the unchanged preflight bounds. No preflight bound, tool requirement or gate was skipped, weakened or replaced by a substitute, and no cluster result is claimed."

[observation.6.8.6914]
task = "6.8"
severity = "note"
file = "platform/hosted/tests/topology-regressions.py platform/Makefile.inc"
symbol = "named RESOLVED_EDGES HUMAN_EDGES SEPARATELY_OPERATED_EDGES platform-hosted-topology-check"
