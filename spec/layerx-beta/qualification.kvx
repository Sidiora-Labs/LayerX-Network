symbol = "publish-crates-io LAYERX_RELEASE_DOWNLOAD publish-nuget LAYERX_RELEASE_NUGET_BASE"
observed = "To give every artifact a fetchable registry location the crates-io job now requires a beta index override LAYERX_RELEASE_CRATES_IO_INDEX to be a sparse+https:// index (it reads the dl template from <index>/config.json) and the nuget job resolves the PackageBaseAddress/3.0.0 resource from the v3 service index at LAYERX_RELEASE_NUGET_SOURCE (default https://api.nuget.org/v3/index.json) in its configure step; both are single HTTPS reads of public registry metadata and run on workflow_dispatch as well as on tags. The Go module proxy zip and the repository-signed NuGet package differ from the built bytes, so their manifest entries carry digest_of=registry-bytes captured by the install step after the byte-for-byte content comparison; on an untagged run those registries retain source-archive and built-bytes digests with published=false and verify halts on them as not published rather than presenting them as verified."
assumption = "A git-based crates index override is not supported for the beta; owners who set LAYERX_RELEASE_CRATES_IO_INDEX use a sparse index."
severity = "note"

