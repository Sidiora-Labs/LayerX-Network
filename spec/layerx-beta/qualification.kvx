[observation.6.6.3800]
task = "6.6"
file = "src/paxeer/lxp_bond_client.c cmd/layerx-guarantor/settlement.py tests/paxeer/membership-sync-chain.py"
symbol = "membership_commitment lxp_paxeer_membership_commitment membership expected_commitment"
observed = "The membership commitment preimage now absorbs the observed block number immediately after the observed epoch, so every commitment produced before this change differs from the commitment produced for the same set afterwards. Observation 6.6.3700 assumed the extension would not change the hash because the preimage already reserved an eight-byte governance sequence slot; that reservation covers lastGovernanceSequence, which stays zero on a GuarantorBond that has applied no governance action, but the block number is a new field and the eight bytes it contributes shift the whole tail of the preimage. tests/paxeer/membership-sync-chain.py recomputes the commitment independently in Python and had to insert the same field."
assumption = "A mirror commitment that cannot name the block its read was taken at cannot be replayed against an archive node, so the block number belongs inside the commitment rather than beside it. No commitment is persisted across the change other than the bond binding file this lane introduces, which carries its own version and is rewritten on every bind."
severity = "note"

[observation.6.6.3801]
task = "6.6"
file = "cmd/layerx-guarantor/settlement.py cmd/layerx-guarantor/settlement.c cmd/layerx-guarantor/main.c"
symbol = "membership wire_encode gp_settlement_membership gp_settlement_bond_bind"
observed = "custodiedValue() and minimumBondBps() are now read from GuarantorBond at the same block as the rest of the membership read and carried in the membership wire frame, whose fixed prefix grows from 40 to 76 bytes. gp_settlement_bond_bind initialises an unset lxp_paxeer_bond_state from those chain values and, once the state is initialised, refuses any later divergence with LXP_ERR_CONTEXT_MISMATCH. Observation 6.6.3703 recorded that the node's configured custodied value and basis points are the authority for its own eligibility threshold; with the chain as the source of the first bind, the equality lxp_paxeer_membership_sync enforces between minimumBond() and the natively derived ceiling is a re-derivation of the contract's mulDiv rather than a comparison against node configuration. The configured-value path is still exercised by tests/paxeer/membership_sync_driver.c, which takes the custodied value and basis points as arguments and drives the refusal."
assumption = "A guarantor that adopts a bond floor it did not derive itself cannot detect a contract that reports a floor inconsistent with its own custody parameters, so the floor is recomputed natively from the chain's custody inputs and the two must agree. Sourcing the custody inputs from the chain rather than from node configuration keeps a single authority for the value, and pinning them after the first bind keeps a mid-run custody change visible as a refusal instead of a silent threshold move."
severity = "note"

[observation.6.6.3802]
task = "6.6"
file = "src/paxeer/lxp_bond_client.c include/layerx/lxp_paxeer.h tests/test_paxeer_bond.c"
symbol = "lxp_paxeer_bond_deposit lxp_paxeer_bond_deposit_evidence lxp_paxeer_bond_deposit_record"
observed = "lxp_paxeer_bond_deposit previously took a guarantor id and an amount and added the amount to the mirror's bond record. It now takes lxp_paxeer_bond_deposit_evidence carrying the chain id, the GuarantorBond address, the transaction hash, the block number, the block timestamp and the membership version the receipt was read at, and it records the receipt without moving any bond amount: the mirror's bond amounts remain exactly what the membership read returned. The deposit is refused unless the mirror is BOUND, unless the evidence is at or behind the mirror's membership version and block number, and, when the evidence is at exactly the mirror's version, unless the receipt's totalBond equals the mirror's bond amount for that guarantor. tests/test_paxeer_bond.c previously used the deposit call to fund two guarantors before checking eligibility and now sets those bond amounts through lxp_guarantor_set_apply, which is where governed membership actually sets them."
assumption = "A deposit is inbound evidence about external state, not an instruction to move mirrored state; if the mirror and the receipt disagree about a guarantor's total the disagreement is a refusal rather than something to reconcile by arithmetic. Deposits observed behind the mirror carry no amount assertion because later membership transitions may legitimately have changed the total."
severity = "note"

[observation.6.6.3803]
task = "6.6"
file = "cmd/layerx-guarantor/main.c cmd/layerx-guarantor/settlement.c"
symbol = "deposits_ingest binding_store binding_restore gp_settlement_bond_deposit"
observed = "Observation 6.6.3701 recorded that gp_settlement_membership_sync had no caller in the daemon. The producer now holds an lxp_paxeer_bond_state, all three former gp_settlement_membership call sites in cmd/layerx-guarantor/main.c go through gp_settlement_bond_bind, and a batch is refused with LXP_ERR_ATTESTATION_THRESHOLD unless the resulting availability is LXP_PAXEER_MEMBERSHIP_SYNC_BOUND. Every bond-stage pass restores the encoded binding from <state>/paxeer-bond.binding, ingests any receipt named <state>/bond-deposits/<64 hex guarantor id>-<64 hex transaction hash> that is not already proved, and rewrites the binding. lxp_paxeer_bond_state is 73688 bytes and gp_settlement_membership_view is of the same order, so both are heap allocated in the producer's historical and attestation paths rather than placed on a worker thread stack."
assumption = "A file dropped into the deposit directory is an operator assertion that a transaction hash is worth verifying, not that it is valid; the daemon resolves it against the chain through the settlement helper and refuses the batch if the receipt does not verify. A malformed file name is a refusal rather than a skip so that a typo cannot silently drop evidence."
severity = "note"

[observation.6.6.3804]
task = "6.6"
file = "cmd/layerx-guarantor/settlement.py tests/daemon/guarantor-settlement.py"
symbol = "configuration wire_encode test_wire_membership_and_registration"
observed = "The custody parameters were added to the membership frame rather than to the config frame because the config mode is resolved entirely from the settlement document and the environment and is asserted to stay offline by tests/daemon/guarantor-settlement.py::test_configuration_real_vector_public_keys_and_environment, which calls it with no RPC available. tests/daemon/guarantor-settlement.py::test_wire_membership_and_registration is not an owned path of this lane but encodes the membership frame's byte offsets and had to move with the 76-byte prefix; the same test now also covers the new 120-byte deposit frame."
assumption = "A helper mode that a test pins as offline must stay offline, so a chain read belongs in a mode that already performs chain reads. Updating a test that asserts the exact byte layout of a frame that changed is not a weakening of the test; the assertions were re-derived from the new layout and one more frame was added to it."
severity = "note"

[observation.6.6.3805]
task = "6.6"
file = "tests/daemon/guarantor-integration.c cmd/layerx-guarantor/settlement.h"
symbol = "verify_certificate gp_settlement_membership gp_settlement_membership_view"
observed = "tests/daemon/guarantor-integration.c:87 called gp_settlement_membership with the six-argument form and stopped compiling once the membership read returned a gp_settlement_membership_view, so build/tests/lxp_test_guarantor_integration failed with -Werror 'too many arguments to function'. The call site now allocates a gp_settlement_membership_view on the heap, copies the set, threshold, maximum delay and minimum bond out of it and frees it; every assertion the test makes on those four values is unchanged. The view is heap allocated because it embeds a full lxp_guarantor_set and the function already keeps one on its stack."
assumption = "A test that reads the membership through the production entry point has to move with that entry point's signature. Copying the four values it already asserted on out of the view leaves the assertions exactly as written, so this is a mechanical port rather than a change of what the test proves."
severity = "note"

[observation.6.6.3806]
task = "6.6"
file = "platform/hosted/node/bootstrap.sh tests/daemon/guarantor-integration.py human/Cargo.lock tests/daemon/guarantor-publication-chain.py"
symbol = "test-daemon-guarantor-integration test-daemon-guarantor-settlement"
observed = "make CC=gcc test-daemon-guarantor-integration exits 2 before any guarantor code runs: tests/daemon/guarantor-integration.py:118 invokes platform/hosted/node/bootstrap.sh, which refuses with 'bootstrap: --genesis-metadata requires an authoritative LXGB v2 metadata file'. make CC=gcc test-daemon-guarantor-settlement exits 2 after tests/daemon/guarantor-settlement-chain.py has already printed its own success record, when tests/daemon/withdraw-custody.py reaches tests/daemon/guarantor-publication-chain.py:158 and cargo build --locked --manifest-path human/Cargo.toml -p layerx-paxeer-client exits 101 with 'the lock file human/Cargo.lock needs to be updated but --locked was passed'. Neither path is touched by this change: git diff origin/main HEAD -- platform/hosted/node/bootstrap.sh tests/daemon/guarantor-integration.py human/ is empty. The bootstrap refusal is the metadata argument recorded for the hosted node harness and the lock staleness is the same human workspace lock already recorded against the Human image build."
assumption = "Both failures are reproduced by files this change does not touch and occur before the guarantor binds any membership, so they are pre-existing and are recorded rather than repaired here. make CC=gcc test-daemon-guarantor-unit, which runs the guarantor core, the mTLS exchange and tests/daemon/guarantor-settlement.py, exits 0."
severity = "blocker"

[observation.6.11.2400]
task = "6.11"
file = "include/layerx/lxp_result.h"
symbol = "LXP_ERR_SEQUENCE_EXHAUSTED LXP_RESULT_CODES"
observed = "The refusal for a terminal account sequence needs a result code of its own so a caller can tell an exhausted sequence apart from a mismatched one. There is no include/layerx/lxp_errors.h in the tree; every consensus result code is declared by the LXP_RESULT_CODES X-macro table in include/layerx/lxp_result.h, so LXP_ERR_SEQUENCE_EXHAUSTED was appended there at line 74 as -307, the next free value in the sequencing domain after LXP_ERR_CONDITION_UNMET at -306. No existing value was renumbered. Because lxp_terminal_rejection_applies at src/protocol/lxp_kernel.c:4682 classifies by lxp_result_domain and returns true for LXP_RESULT_DOMAIN_SEQUENCING, the new code is published as a terminal rejection with no change to that function, and tests/protocol/lxp_test_result.c covers its name, domain, fatality and uniqueness through the same table."
assumption = "Appending a value at the end of the sequencing domain adds a code that no released receipt can already carry, so it is additive rather than a renumbering; a code that shares -305 with LXP_ERR_SEQUENCE_MISMATCH would have made a permanently unusable account indistinguishable from a caller that simply guessed the wrong sequence."
severity = "note"

[observation.6.11.2401]
task = "6.11"
file = "src/ledger/lxp_ledger_internal.h src/ledger/lxp_apply.c src/ledger/lxp_journal.c"
symbol = "lxp_sequence_terminal_check lxp_balance_restore_snapshot"
observed = "Both account sequence increments live in different translation units: src/ledger/lxp_apply.c:325 in lxp_apply_transfer and src/ledger/lxp_journal.c in lxp_apply_transfer_set. The predicate that refuses a terminal sequence is defined once in src/ledger/lxp_apply.c:71 and has to be visible to lxp_journal.c. Declaring it in the public include/layerx/lxp_transfer.h would widen the ledger surface that tools/ci/symbol-allowlist.sh polices, so the declaration was added to the private src/ledger/lxp_ledger_internal.h, which is included by src/ledger/lxp_journal.c alone and already carries exactly this pattern for lxp_balance_restore_snapshot, also defined in lxp_apply.c."
assumption = "Duplicating the predicate as a static helper in each file would let the two increment sites drift apart, which is the failure this row exists to close, so one definition with a private declaration was preferred over two copies."
severity = "note"

[observation.6.11.2402]
task = "6.11"
file = "agent/crates/layerx-types/src/result.rs"
symbol = "KnownResult SequenceExhausted"
observed = "agent/crates/layerx-types/src/result.rs mirrors the C result table by hand, listing SequenceMismatch = -305, Retriable and ConditionUnmet = -306, Terminal at lines 119 and 120 and then jumping to InsufficientBalance = -400. The new LXP_ERR_SEQUENCE_EXHAUSTED = -307 has no Rust counterpart, so a Rust client decoding a receipt that carries -307 cannot name it or classify it as terminal. Nothing in the build reads include/layerx/lxp_result.h to check the two tables against each other, so the omission does not fail any gate."
assumption = "agent/crates/layerx-types is outside this row's owned paths and adding a variant to a public enum is an API change for that crate, so the C side is left authoritative and the missing mirror is recorded rather than added. The absence of an automated parity check between the C table and the Rust enum is the underlying gap and it predates this change."
severity = "suspect"

[observation.6.11.2403]
task = "6.11"
file = "Makefile"
symbol = "test_escrow_dispute test_stream_lifecycle PROGRAMS_RUNTIME_LIB"
observed = "The link rules for build/tests/test_escrow_dispute at Makefile:496 and build/tests/test_stream_lifecycle at Makefile:612 name only $(TEST_LIBRARY), while every neighbouring module test rule also names $(PROGRAMS_RUNTIME_LIB) and depends on the programs-build order-only prerequisite. Both targets therefore fail to link with undefined references to the Rust programs-sandbox entry points the testing library calls, among them layerx_programs_interface_validate, layerx_programs_consume_program_spend_authorization, layerx_programs_schedule_plan, layerx_programs_call_begin and layerx_programs_occupancy_finalize_rust. The failure is a property of those two link lines alone: this row adds no symbol to either binary and changes no Makefile rule, and the same two link failures were reproduced on an unmodified checkout of revision 7e0cd0c86 built in a separate worktree."
assumption = "Adding $(PROGRAMS_RUNTIME_LIB) to those two rules would change how the whole test matrix links and belongs to whoever owns the build description, so the defect is recorded rather than repaired here."
severity = "suspect"

[observation.6.11.2405]
task = "6.11"
file = "src/ledger/lxp_apply.c src/ledger/lxp_journal.c src/ledger/lxp_send.c src/ledger/lxp_receive.c"
symbol = "lxp_sequence_terminal_check lxp_precondition_check lxp_send_validate verify_receiver"
observed = "An account whose next_sequence has reached UINT64_MAX cannot advance again: one more increment wraps it to zero and every sequence it already consumed becomes replayable. The refusal is placed so that the terminal value is unusable rather than wrapped. lxp_sequence_terminal_check refuses when either the debit source leg->from or the account named by context->sequence_account stands at UINT64_MAX, and it is called from lxp_precondition_check before any balance moves, again in lxp_apply_transfer before lxp_balance_apply_leg, and in lxp_apply_transfer_set immediately before the increment, where a refusal rolls the journal back and reports failed_leg with leg_count zero. lxp_send_validate at src/ledger/lxp_send.c:263 and verify_receiver at src/ledger/lxp_receive.c:350 answer LXP_ERR_SEQUENCE_EXHAUSTED before the mismatch comparison, so an exhausted account is never reported as a sequence guess. The check is deliberately not gated on protocol_system_capability, and the existing occupancy carve-out is preserved: a leg whose debit_authority_kind is LXP_AUTH_OCCUPANCY_RESPONSIBILITY consumes no sequence and is unaffected. A terminal account keeps its balance and can still be credited as the recipient of a leg, because only the debit source and the sequence account are examined."
assumption = "The default chosen for this row is that the terminal value is unusable: the account keeps its funds and can still receive, but cannot debit. No recovery or rotation path is introduced, because reassigning or resetting a consumed sequence space is an account-lifecycle change beyond this row."
severity = "note"

[observation.6.11.2406]
task = "6.11"
file = "Makefile tests/modules/test_escrow_dispute.c tests/modules/test_stream_lifecycle.c"
symbol = "test-escrow-dispute test-stream-lifecycle test-escrow-open test-budget-create test-stream-settle test-service-dispute test-perps-margin"
observed = "The seventeen ledger-consumer targets that this change could plausibly disturb - test-escrow-open, test-escrow-capture, test-escrow-timeout, test-escrow-invariants, test-escrow-dispute, test-budget-create, test-budget-spend, test-budget-delegate, test-budget-revoke, test-stream-open, test-stream-settle, test-stream-lifecycle, test-service-dispute, test-perps-margin, test-perps-funding, test-perps-liquidation and test-perps-insurance - were run together with make -k on this revision. The batch exits 2 with exactly two failures, both at link time: build/tests/test_escrow_dispute and build/tests/test_stream_lifecycle, the two rules recorded in observation 6.11.2403. Every one of the other fifteen builds and passes. On revision 7e0cd0c86, the revision this change was first written against, the same batch failed all seventeen, and an unmodified checkout of that revision in a separate worktree failed exactly the same seventeen names; the fifteen runtime failures were resolved on main between that revision and this one, and the two link failures survive because no rule was touched."
assumption = "The two remaining failures cannot be caused by this change: they are link errors for undefined Rust programs-sandbox symbols in two rules that omit the runtime library, and this change adds no symbol to either binary. make CC=gcc test, which is this row's gate, contains none of the seventeen and passes."
severity = "note"

[observation.2.3.4600]
task = "2.3"
file = "cmd/layerx-verify/lxp_verify_cli.h cmd/layerx-verify/lxp_verify_cli.c platform/hosted/node/bootstrap.sh"
symbol = "lxp_verify_trust_root lxp_verify_trust_root_load"
observed = "The standalone verifier needed a trust root and the deployed system has exactly one artifact that a relying party can pin without contacting the network: the signed genesis manifest. platform/hosted/node/bootstrap.sh:452-461 writes SEQUENCER_PRIVATE into the genesis signer key file and hands that file to layerx-genesis-build, so the manifest signer_public_key recorded in genesis.manifest is the same key that signs batch headers through lxp_batch_sign and receipts through lxp_receipt_sign. The manifest therefore carries the whole authority key set that offline verification needs: the signing authority for headers and receipts, the guarantor key records that carry checkpoint attestations, the network id and the genesis state root. lxp_verify_trust_root_load parses the manifest with lxp_genesis_parse in LXP_GENESIS_INPUT_MANIFEST mode, verifies its signature with lxp_genesis_verify_signature, bounds the network id, protocol version and guarantor count, computes the manifest commitment and copies the guarantor records out with bonded derived from the recorded bond."
assumption = "Pinning the genesis manifest is the trust root a relying party can obtain once and keep, and it is the only trust root the deployment already publishes. The verifier never accepts a signing key offered by the responder; the pinned key is the only authority it will honour."
severity = "note"

[observation.2.3.4601]
task = "2.3"
file = "cmd/layerx-verify/lxp_verify_cli.c cmd/layerxd/lxp_daemon_process.c"
symbol = "lxp_verify_bundle_offline protocol_version"
observed = "The trust root records the network protocol version and cmd/layerxd/lxp_daemon_process.c:4880 sets the daemon's protocol version from the genesis manifest, but the batch header does not inherit that value: cmd/layerxd/lxp_daemon_process.c:1436 and :3190 set header.protocol_version from the submitted activity, and admission only requires lxp_protocol_version_supported. Requiring header.protocol_version to equal the genesis protocol version would therefore refuse evidence the daemon legitimately produces, so lxp_verify_bundle_offline requires only that the header version is supported and binds the header to the trust root through network id equality and the pinned signing key, which is the same binding cmd/layerxd/lxp_daemon_evidence.c:402 verify_signed_header applies."
assumption = "The header's protocol version is a property of the activity that was sealed, not of the network the manifest pins, so it is not a trust-root binding. Network id equality plus the pinned authority key are the bindings that actually constrain which network and which sequencer the evidence came from."
severity = "note"

[observation.2.3.4602]
task = "2.3"
file = "cmd/layerx-verify/lxp_verify_cli.c cmd/layerx-verify/lxp_verify_main.c include/layerx/lxp_tools.h"
symbol = "lxp_verify_cli_main lxp_verify_main"
observed = "cmd/layerx-verify already held lxp_verify_main, a library entry point declared in include/layerx/lxp_tools.h that replays a checkpoint against a guarantor certificate and a data availability bundle and is linked into build/tests/test_tools and the guarantor integration test. It is not a program entry point and is not reachable from a shell. The new command line is added as lxp_verify_cli_main in a separate translation unit with cmd/layerx-verify/main.c as the only thin main, so the existing helper and its callers are untouched and the two names do not collide."
assumption = "An existing library helper that tests link against must keep its name and its callers. Adding the program entry point beside it rather than renaming it keeps every existing link line valid."
severity = "note"

[observation.2.3.4603]
task = "2.3"
file = "cmd/layerxd/lxp_daemon_evidence.c cmd/layerx-verify/lxp_verify_cli.c tests/tools/test_verify_cli.c"
symbol = "write_signed_header lxp_verify_bundle_offline"
observed = "The proof material a responder returns carries the sequencer id, the signing public key, a first and last authorized batch number, the canonical batch header and the header signature, but only the canonical header and the signature are covered by a signature. Exercising every single-byte mutation of a real proof bundle against lxp_verify_bundle_offline shows that the eight bytes of the last authorized batch number are the only bytes a responder can change without the verifier noticing: widening the range still leaves the header's own batch number inside it. The verifier does not treat those bytes as authority. It pins the public key to the genesis manifest, rejects any other key with LXP_ERR_AUTH_SCOPE, and builds its own lxp_sequencer_authorization whose first and last batch numbers are both the batch the signed header names, so a widened range grants nothing; moving the range so that the header's batch falls outside it is still refused with LXP_ERR_AUTH_SCOPE. tests/tools/test_verify_cli.c asserts all three behaviours and skips exactly those eight bytes in the exhaustive mutation loop."
assumption = "An unsigned field in responder-supplied material can only be used to narrow trust, never to establish it. Deriving the authorized batch range from the signed header rather than from the envelope removes the field from the trust decision entirely, which is why mutating it is harmless rather than a gap."
severity = "note"

[observation.6.11.3300]
task = "6.11"
file = "src/protocol/lxp_kernel.c src/ledger/lxp_journal.c src/modules/programs/call.c"
symbol = "program_spend_authorized_set program_spend_leg_authority source_authorities_check"
observed = "The capability-checked program-spend wrapper admitted exactly one program-owned debit leg per set. It looped over the source authorities and returned LXP_ERR_UNAUTHORIZED_DEBIT unless every authority matched exactly one leg (matching_leg_count != 1U), then required program_spend_count == 1U and redeemed a single permit for that one leg. Generalising the authorization to ordinary program calls needs N program-owned legs in one set, so the per-authority cardinality rule is replaced by a per-leg resolution: program_spend_leg_authority at src/protocol/lxp_kernel.c:1120 walks the authority list for one leg and refuses with LXP_ERR_UNAUTHORIZED_DEBIT unless exactly one authority names that leg source, which is the same rule source_authorities_check enforces at src/ledger/lxp_journal.c:70-111 and the same authority lxp_precondition_check resolves at src/ledger/lxp_apply.c:150-215. The surviving per-authority rule is only that an authority must cover at least one leg (src/protocol/lxp_kernel.c:1199-1200). Every leg still resolves to exactly one authority and every program-owned leg still redeems its own permit bound to source, destination, asset, amount, reason, supply mode and the transfer-set root (src/protocol/lxp_kernel.c:1226-1231), so no leg can borrow another leg's authorization. The former program_spend_count == 0U branch returning LXP_ERR_UNKNOWN_FIELD was unreachable: lxp_kernel_apply_transfer_set calls the wrapper only after finding at least one LXP_AUTH_PROGRAM_SPEND authority, and the wrapper is static with no other caller."
assumption = "The row default is that a program spend requires an explicit capability granted by the account owner and bounded per call, which the guest-visible grant already expresses; the wrapper's job is to bind an authorized set to redeemed permits, not to cap the number of legs a single call may authorize. LXP_MAX_TRANSFER_SET_LEGS still bounds the set and the Rust permit batch is bounded by the same constant at programs/crates/layerx-programs-runtime/src/ffi_transfer.rs:25. No refusal is removed: the raw ledger still refuses LXP_AUTH_PROGRAM_SPEND outright at src/ledger/lxp_apply.c:278,285 and src/ledger/lxp_journal.c:129-134, and the wrapper is still reachable only through lxp_kernel_apply_transfer_set with kernel->apply_transfer_set == lxp_kernel_canonical_ledger_apply."
severity = "note"

[observation.6.11.3301]
task = "6.11"
file = "src/protocol/lxp_kernel.c src/ledger/lxp_apply.c programs/crates/layerx-programs-runtime/src/transfer.rs"
symbol = "program_spend_authorized_set lxp_apply_transfer_set"
observed = "Each permit is bound to the transfer-set root the wrapper computes from set->legs before delegating to the ordinary ledger. lxp_apply_transfer_set compacts zero-amount legs out of the set before it computes the root it actually applies, so a set carrying a zero-amount leg would have the ledger apply a different root from the one every permit was bound to. The wrapper therefore refuses any zero-amount leg with LXP_ERR_ZERO_AMOUNT at src/protocol/lxp_kernel.c:1210, before any permit is redeemed, rather than redeeming permits against a root the ledger will not use."
assumption = "This is a strengthening on a path that no producer reaches: the Rust transfer law rejects a zero amount before a leg is ever built (programs/crates/layerx-programs-runtime/src/abi/mod.rs:988-990 returns AmountBounds for amount == 0) so no program-owned set carries a zero-amount leg. Owner-authorized sets do not enter the wrapper and keep the ledger's existing compaction behaviour unchanged."
severity = "note"

[observation.6.11.3302]
task = "6.11"
file = "programs/crates/layerx-programs-runtime/src/ffi_transfer.rs programs/crates/layerx-programs-runtime/src/ffi_call.rs"
symbol = "ActiveProgramSpend issue_program_spend_for_set layerx_programs_consume_program_spend_authorization"
observed = "The single permit the wind-down settlement issued required the debited program account to be spent from the owner program's root frame (frame_path all zero, depth zero), and a runtime test asserts that a non-root frame is refused. An ordinary program call spends from whichever frame holds the grant, which the capability check has already bound to the caller and which may be nested, so the same root-frame rule would refuse every nested call. The permit therefore carries an explicit owner_root_frame flag (programs/crates/layerx-programs-runtime/src/ffi_transfer.rs:39): the wind-down issuer passes true and keeps the exact frame rule it had, the ordinary call issuer passes false and relies on the capability check that already bound the frame. The consumer applies the frame rule only when the flag is set (ffi_transfer.rs:440-441). The original refusal test is preserved verbatim and a new test covers the nested frame the call issuer allows."
assumption = "Frame binding for an ordinary call is established by the capability check rather than by the permit: abi/capability.rs:486 permits_program_spend matches the grant's owner program, source account, destination, asset and maximum amount against the request, and a denied request aborts the call. The permit's remaining bindings (owner program, seed, source, staging program, destination, asset, amount and transfer-set root) are unchanged for both issuers, and the batch is still refused unless every permit it issued was redeemed (ffi_transfer.rs:147-153)."
severity = "note"

[observation.6.11.3303]
task = "6.11"
file = "include/layerx/programs.h programs/crates/layerx-programs-runtime/src/ffi_call.rs src/modules/programs/call.c"
symbol = "layerx_programs_call_transfer_begin CKernel::apply_and_verify_402lxp_set"
observed = "Carrying the one-shot program-spend token from the Rust transfer law into the C Programs call activity requires the token to cross the FFI boundary, which widens layerx_programs_call_transfer_begin by one uint64_t parameter. That declaration lives in include/layerx/programs.h:610 and its Rust extern declaration and only caller live in programs/crates/layerx-programs-runtime/src/ffi_call.rs:1130 and :1788-1807, neither of which is in this change's owned paths; both were edited because the definition in src/modules/programs/call.c:1481 cannot change signature alone. The Rust caller also refuses the settlement when the ledger did not redeem every permit the set authorized (ffi_call.rs:1804). Separately, this change's hunks in src/modules/programs/call.c fall in transfer_source_authority_add and layerx_programs_call_transfer_apply, adjacent to a separately landed change that adds a funding-into-program-account source in the same function."
assumption = "The signature widening is additive and has exactly one caller and one definition in the repository, so no other call site can observe the old arity; a zero token is the reserved value meaning no program-owned leg, which layerx_programs_call_transfer_apply pairs against the presence of a program-source leg at src/modules/programs/call.c:1834-1836. The adjacency to the funding source is a textual merge concern in one function, not a behavioural one: that change adds a new source kind and this one labels the existing PROGRAM source kind LXP_AUTH_PROGRAM_SPEND and threads the token, and both stand together on the merged revision."
severity = "note"

[observation.6.11.3304]
task = "6.11"
file = "programs/crates/layerx-programs-runtime/src/host/mod.rs programs/crates/layerx-programs-runtime/src/ffi_call.rs src/protocol/lxp_kernel.c tests/programs/test_call_activity.c"
symbol = "RuntimeState::with_abi execute_authorized_v2_budgeted synthesize_program_call_failure"
observed = "At activity level a denied host request is a hard abort, not a refused host call with a status. RuntimeState::with_abi at programs/crates/layerx-programs-runtime/src/host/mod.rs:986 records a CompositionRefusal::Authority whenever the meter is an activity meter, so a program spend the capability set does not admit makes execute_authorized_v2_budgeted return Err(Composition(Authority(CapabilityEscalation))), which programs/crates/layerx-programs-runtime/src/ffi_call.rs:2854 maps to NON_CANONICAL. The C kernel then synthesizes a pre-runtime failure (src/protocol/lxp_kernel.c:2401-2429) whose terminal kind is LXP_PROGRAM_TERMINAL_FAILURE and whose result code is LXP_ERR_NON_CANONICAL (-3), with a zero transfer root. The guest never observes the host status constants STATUS_DENIED or the more specific LXP_ERR_PROGRAM_REFUSED or LXP_ERR_UNAUTHORIZED_DEBIT, so an unauthorized program spend and a malformed activity are indistinguishable from the receipt alone. The end-to-end coverage added here asserts the code the runtime actually produces, and asserts additionally that no balance moves and that the caller sequence still advances."
assumption = "This mapping predates this change and is unmodified by it; the refusal itself is genuine and complete, so this is recorded rather than repaired. Making an unauthorized program spend distinguishable in the receipt would change the pre-runtime failure contract and the terminal encoding, which belong to the receipt-transition work rather than to program-spend authorization. Because the runtime can never present the kernel a mismatched permit end to end, the wrapper's own refusals are additionally asserted directly against lxp_kernel_apply_transfer_set in tests/programs/test_call_activity.c: a missing token, a foreign origin module, an authority naming another account, duplicate authorities, a zero-amount leg, a well-formed program-owned leg with no permit, and an owner-authorized set that carries a token."
severity = "note"

[observation.6.11.3305]
task = "6.11"
file = "programs/crates/layerx-programs-runtime/tests/interpreter_program.rs Makefile"
symbol = "built_interpreter_runs_success_vectors_through_the_real_candidate_runtime programs-interpreter-conformance programs-test"
observed = "cargo test --workspace for the programs workspace, run bare as the local gate list writes it, exits 101 with exactly one failing target: layerx-programs-runtime --test interpreter_program, whose two tests panic at crates/layerx-programs-runtime/tests/interpreter_program.rs:51 because LAYERX_INTERPRETER_WASM does not name a built interpreter Wasm. Sixty-nine other targets report ok, including every LayerX-owned lib and integration target, both vendored crates and every doc target. No make target runs the workspace bare: programs-interpreter-conformance builds the interpreter for wasm32-unknown-unknown and supplies LAYERX_INTERPRETER_WASM at Makefile:3168-3170, and programs-test supplies the same path before cargo test --locked --workspace at Makefile:3180. Building that artifact and supplying the variable makes the identical workspace command exit 0 with 70 targets ok and 769 tests passed. Evidence: qual-logs/cargo-programs.log at exit 101 and qual-logs/cargo-programs-conformance.log at exit 0."
assumption = "The bare failure is an absent build artifact rather than a defect, and it is untouched by this change: git diff origin/main HEAD -- programs/crates/layerx-programs-runtime/tests programs/vendor programs/Cargo.toml programs/Cargo.lock is empty. Recorded so the gate list can state which of the two forms it means; this branch reports the artifact-supplied form as its programs workspace gate and reports the bare form beside it with its exit code rather than omitting it. An earlier revision of this branch also saw the vendored parity-wasm and wasmi lib suites fail in this workspace; on this base both pass, 103 of 103 and 61 of 61, so that failure is not carried forward."
severity = "note"

[observation.6.11.3306]
task = "6.11"
file = "programs/crates/layerx-programs-runtime/src/lib.rs programs/crates/layerx-programs-runtime/src/ffi_transfer.rs programs/crates/layerx-programs-sandbox/Cargo.toml Makefile"
symbol = "ffi_transfer host-ffi"
observed = "The FFI modules of layerx-programs-runtime, including ffi_transfer and its unit tests, are behind the host-ffi feature (programs/crates/layerx-programs-runtime/src/lib.rs:43-56), which no default build enables. cargo test --workspace therefore compiles neither the module nor its tests: the crate's lib target ran 146 tests and none of them was an ffi_transfer test. The program-spend permit tests, both the two that already existed and the three added here, run only under cargo test -p layerx-programs-runtime --lib --features host-ffi, which passes all five. Makefile:3011-3017 builds and lints the workspace with --features layerx-programs-sandbox/host-ffi, but no make target runs the workspace tests with it."
assumption = "The feature gate is correct: the module declares extern C entry points the native library provides, so a default rlib test build should not carry it. The consequence is that the runtime half of the transfer law is not covered by the workspace test gate, which is recorded for the owner of the programs gate list rather than changed here. This change adds the featured command as its own gate so the five permit tests are executed rather than silently filtered out."
severity = "note"

[observation.6.11.3307]
task = "6.11"
file = "programs/Cargo.toml programs/crates/layerx-programs-runtime/Cargo.toml"
symbol = "cargo test --workspace --doc CARGO_TARGET_DIR"
observed = "The doctest phase of cargo test --workspace for the programs workspace is not reproducible when several worktrees share one CARGO_TARGET_DIR. In the workspace run nine --doc targets aborted with 23 instances of E0463 can't find crate, and an immediately following cargo test --workspace --doc --no-fail-fast aborted ten with 26, in both cases naming dependency rlibs that the very rustdoc command line passes with --extern and an absolute path: for example layerx-programs-registry --doc could not find layerx_proof while it was invoked with --extern layerx_proof=<target>/debug/deps/liblayerx_proof-f3c4fb919da91ddc.rlib, and layerx-program-sdk --doc could not find sha2 while invoked with --extern sha2=<target>/debug/deps/libsha2-15cfd8b3df73f306.rlib. Both files were present minutes later with fresh timestamps. Cargo holds the build-directory lock through the build phase and releases it before running test binaries, so another worktree compiling the same workspace with a different feature set (a concurrent cargo build --locked --workspace --features layerx-programs-sandbox/host-ffi was observed) replaces or removes those rlibs while rustdoc is still resolving them. No lib or integration target is affected, only the doctest phase; two later runs of the same command from this worktree against the same shared directory, taken while thirteen other worktrees were active, reported every doc target ok, so the failure is intermittent and contention-dependent rather than reproducible."
assumption = "This is a property of the shared target directory the local gate instructions prescribe, not of this branch: none of the failing doc targets is touched here, and the failures name missing files rather than compilation errors in documented code. A confirming run in a private target directory was attempted and could not be completed: the volume did not have enough free space for a second full build of this workspace, so the attempt was stopped and its directory removed. The later contention-free-enough runs recorded above did not reproduce the failure, which is why this is recorded as a suspect rather than a defect. Recorded so the owner of the programs gate list can decide whether the workspace doctest phase needs a per-worktree target directory or whether --doc should be excluded from that gate."
severity = "suspect"

[observation.6.11.3308]
task = "6.11"
file = "tests/programs/test_call_activity.c src/protocol/lxp_kernel.c"
symbol = "execute_artifact_fixture_activity kernel_program_signer_binding program_owned_spend_case"
observed = "The Programs fixture harness now signs every activity it executes at LXP_PROTOCOL_VERSION_STATE_COMMITMENT rather than only the dumped conformance vectors, and kernel_program_signer_binding at src/protocol/lxp_kernel.c:65-84 refuses LXP_ERR_AUTH_SCOPE unless a Programs activity at that protocol version resolves an authority whose actor and principal both equal the signer identity's DID identifier and whose verified_key equals the activity's 32-byte authority field, then verifies the signature. The program-owned spend coverage added here was first written against a revision where the harness left such an activity unsigned and accepted a resolved authority whose principal was the fee account identifier; on this revision its deploy leg returned LXP_ERR_BAD_SIGNATURE and then LXP_ERR_AUTH_SCOPE before any program-owned debit was reached."
assumption = "The fixture was rebound to the signer identity rather than exempted from the binding: its signer public key is derived from the seed the harness signs with, its resolved authority carries the DID identifier as both principal and actor, its verified_key is that public key, its kind is LXP_AUTHORITY_OWNER with an explicit Programs module scope and an lxp_authority_hash computed over that key, and its fee account is named agent:did:lxp:program-spend:main so the account binds to the same DID. Nothing in the binding is relaxed and no refusal is skipped: the granted, ungranted and grant-ceiling cases now run as genuinely signed, identity-bound activities, which is strictly stronger than the unsigned execution they were written against."
severity = "note"
[observation.4.1.5200]
task = "4.1"
file = ".github/workflows/publish-images.yml platform/hosted/tests/publish-images.sh"
symbol = "on.push.tags resolve_release_binding require_gated_publication"
observed = "The workflow built and published every beta image on each push to main and repointed the moving ghcr.io/sidiora-labs tag beta on each one with no test gate (former publish-images.yml lines 3-5 and 36-37, publish-images.sh lines 58-61). The branch trigger is gone: the workflow now fires only on the sdk-v tags platform/docs/content/beta.md line 176 declares as release_tag_format and on workflow_dispatch with a required 40-hex release_candidate input, and its four jobs are gate, publish, attest and promote in that dependency order, where gate runs make build test scan-consensus with CC=gcc and make beta-ledger-check on the published revision and exports it as the only revision the later jobs accept. publish-images.sh refuses to run without an explicit mode and requires exactly one release binding: --release-tag resolves the name under refs/tags to a commit, --release-candidate takes a 40-hex commit, and either must abbreviate to the revision the build inventory carries. Publication additionally requires GITHUB_ACTIONS, GITHUB_REPOSITORY and LAYERX_PUBLISH_GATE_REVISION equal to the release commit, refuses a build revision marked dirty, and for a release candidate requires the GitHub compare status against LAYERX_PUBLISH_DEFAULT_BRANCH to be identical or behind."
assumption = "The release candidate reaches the run as an explicit dispatch input rather than being read out of the beta contract, because the contract row that names it is added by a separate change; the two agree whenever the run is dispatched with the revision that contract names. Reusing the declared sdk-v release tag format avoids a second tag namespace for the same revision."
severity = "note"

[observation.4.1.5201]
task = "4.1"
file = ".github/workflows/publish-images.yml platform/hosted/tests/publish-images.sh"
symbol = "generate_sboms sign_images verify_published promote_tags"
observed = "Every image now carries an SPDX SBOM produced by syft scan and validated to be an SPDX-2 document whose name is the scanned repository and whose package list is not empty. The push phase pushes only the immutable revision tag, compares the registry manifest digest with the pushed image's RepoDigests, signs that digest keyless with cosign and attaches the SBOM as a cosign spdxjson attestation. A matrix job then attests build provenance per published digest with actions/attest-build-provenance and push-to-registry. The promote phase verifies, for each digest, the cosign signature and the spdxjson attestation against a certificate identity regexp pinned to this workflow path and the GitHub Actions OIDC issuer, compares the attested SPDX package set with the SBOM the build produced, verifies build provenance through gh attestation verify bound to the repository, the signer workflow, the SLSA v1 predicate type and the release commit, and only then repoints the release tag and the moving beta tag with cosign copy, re-reading each moved tag's registry digest and refusing any that does not resolve to the verified digest. Locally bash -n on publish-images.sh and on beta-images.sh exit 0, actionlint 1.7.7 on the workflow exits 0, and publish-images.sh --self-test exits 0: it accepts --check on the real inventory, refuses seventeen malformed inventories, missing and doubled release bindings, a short-form candidate, a candidate and a tag that do not name the built revision, publication outside GitHub Actions, an unset and a mismatched gate revision and a dirty build revision, and then runs one full --dry-run that produced seventeen real SPDX SBOMs and the publication plan."
assumption = "A dry run that resolves the release binding, scans every image and writes the plan exercises every decision the publisher makes before it first contacts a registry, so the refusals it establishes hold for the real publication path as well."
severity = "note"

[observation.4.1.5202]
task = "4.1"
file = "platform/hosted/tests/publish-images.sh .github/workflows/publish-images.yml"
symbol = "push_images sign_images verify_published promote_tags"
observed = "No registry-facing step of this pipeline was executed. Pushing, cosign sign, cosign attest, actions/attest-build-provenance, cosign verify, cosign verify-attestation, gh attestation verify and cosign copy all need GHCR credentials and a Sigstore OIDC token that exist only inside the gated workflow job, and publish-images.sh refuses them outside GitHub Actions by design. The local dry run and self-test ran against an inventory whose seventeen entries name real local Docker images that are re-tags of debian:bookworm-slim rather than images built from the seventeen Dockerfiles: the publisher validates each entry's canonical name, image ID, revision tag and local presence, none of which depend on image content, and syft scanned those images for real. Registry publication, the signature and attestation verification and the tag promotion therefore remain unqualified, as observation 6.8.146 already records for the earlier publisher."
assumption = "The image content does not enter any decision publish-images.sh makes before the registry is contacted, so a content-independent inventory qualifies the publisher's own logic and nothing more. Only a workflow run with GHCR credentials can establish that the pushed digests, signatures, SBOM attestations and provenance verify."
severity = "blocker"

[observation.4.1.5203]
task = "4.1"
file = "platform/hosted/tests/publish-images.sh platform/hosted/tests/beta-cluster.sh"
symbol = "parse_arguments preflight_disk main"
observed = "publish-images.sh refuses to run without an explicit mode, so beta-cluster.sh publish-images at line 1971 no longer publishes when it is invoked with no arguments; it forwards its arguments unchanged, so beta-cluster.sh publish-images --check and the two phase invocations behave as before. beta-cluster.sh is outside this change and was not edited. The publish job still builds the image set through beta-cluster.sh images, whose preflight_disk at line 165 refuses when either the build directory or the Docker root has less than LAYERX_BETA_MIN_FREE_GIB free, default 24, which is more free space than a hosted ubuntu-24.04 runner has after its default image; that refusal would stop the run before anything is pushed."
assumption = "A publisher that publishes by default when invoked with no arguments is the wrong default for a script that can move a moving tag, so requiring the mode is a refusal and not a regression. Whether the hosted runner can build seventeen images at all is a property of the build step this change did not touch."
severity = "suspect"

[observation.6.1.5800]
task = "6.1"
file = "platform/hosted/node/bootstrap.sh contracts/config/checkpoint-settlement.json agent/crates/layerx-client/tests/availability_daemon.rs"
symbol = "genesis request has an unexpected length GUARANTOR_COUNT certificate_threshold"
observed = "platform/hosted/node/bootstrap.sh:450 required the LXGB v2 genesis request to measure exactly 395 bytes plus the genesis metadata, while the request the script assembles at lines 424 to 449 carries one 81-byte guarantor record per guarantor. The fixed part of the request is 89 bytes before the guarantor array (4 magic, 1 envelope version, 2 protocol version, 4 network id, 8 timestamp, 2 parameter count and one 66-byte parameter, 2 guarantor count) and 225 bytes after it (32 asset id, 4 metering version, nine 8-byte coefficients, 8 activation batch, 1 authority kind, 4 fee schedule version, seven 8-byte prices, six 8-byte demand parameters), which cmd/layerx-genesis/lxp_genesis_build_cli.c parse_request decodes in that order, so the length is 314 + 81 * GUARANTOR_COUNT + metadata and 395 describes a single-guarantor request only. GUARANTOR_COUNT is the certificate threshold read at bootstrap.sh:287 from .finality_policy.certificate_threshold, which contracts/config/checkpoint-settlement.json ships as 2, so the script built an 851-byte request against a 770-byte expectation and refused before layerx-genesis-build ran. The bound now follows the threshold. With it corrected the bootstrap runs to completion against the shipped settlement document: it generates two sorted secp256k1 guarantor keys, emits an 851-byte request, and layerx-genesis-build accepts it and prints the network 77 genesis state root, the treasury account and the data and run directories. agent/crates/layerx-client/tests/availability_daemon.rs now reads the request the bootstrap produced, requires its envelope version, its single parameter, its guarantor count equal to the certificate threshold of the settlement document, one 81-byte record per guarantor with a zero bond, a compressed public key prefix and strictly ascending identifiers, one written guarantor private key per record, and the total length 89 + 81 * count + 225 + metadata. This supersedes observation 6.11.150, which recorded the same arithmetic without changing either side. Evidence: qual-logs/test-daemon-availability.log and qual-logs/proof-fixture-corrected.log."
assumption = "The number of guarantor records the script emits is the authority for the length it accepts, so the assertion is derived from GUARANTOR_COUNT rather than from a fixed size, and neither the settlement document nor the request layout was changed."
severity = "note"

[observation.6.1.5801]
task = "6.1"
file = "tests/support/lxgb_metadata.py tests/support/lxgb_metadata.rs src/modules/asset/lx_asset_registry.c cmd/layerx-genesis/lxp_genesis_build_cli.c"
symbol = "issuer_valid lx_asset_record_decode metadata append"
observed = "The shared LXGB v2 metadata fixture emits an asset record the genesis builder refuses. tests/support/lxgb_metadata.py:9-10 and tests/support/lxgb_metadata.rs:12-18 both build a version 3 asset record whose custody kind byte is 1, whose custody reference length is 0 and whose issuer kind byte is 2. src/modules/asset/lx_asset_registry.c:561-572 issuer_valid requires custody_kind to equal issuer_kind and requires a non-empty custody reference whenever issuer_kind is 2, so lx_asset_record_decode at line 697 returns LXP_ERR_NON_CANONICAL for that record, and cmd/layerx-genesis/lxp_genesis_build_cli.c parse_request fails at line 203 with the same result. Decoding the exact fixture bytes returns status -3; the same bytes with custody kind 2 and a non-empty custody reference decode as LXP_OK, and with issuer kind 1 and no reference they also decode as LXP_OK but are then refused at lxp_genesis_build_cli.c:204, which rejects issuer_kind 1 in genesis metadata, so the only shape the builder accepts is issuer kind 2 with custody kind 2 and a non-empty custody reference. The rule was introduced with issuer_valid and neither fixture was moved with it. Both fixtures are unchanged here. Every harness that builds genesis through them is affected: tests/daemon/program-admission.sh, tests/daemon/pay1.py, tests/test_lxgb_producers.py, tests/bridge/qualify_credit.py, platform/hosted/core/tests/boundary.rs, platform/hosted/authority/tests/real_node.rs, platform/hosted/agent-boundary/tests/real_node.rs and agent/crates/layerx-agentd/tests/support/real_authority.rs. Evidence: qual-logs/probe-asset-record.log."
assumption = "The asset record contract in the module is authoritative and the two fixtures are stale against it. Choosing between the custody shape and a native-issuance shape changes the genesis state root that every one of those harnesses builds, and both fixtures are shared root test helpers, so neither was edited here and no assertion was relaxed."
severity = "blocker"

[observation.6.1.5802]
task = "6.1"
file = "cmd/layerxd/lxp_daemon_lni.c tests/daemon/lxp_test_program_admission.c agent/crates/layerx-client/tests/availability_daemon.rs"
symbol = "LNI_VERSION_MINOR LNI_MINOR handshake"
observed = "The daemon and the native admission client disagree on the LNI wire version. cmd/layerxd/lxp_daemon_lni.c:47-48 advertises LNI 1.5 in every node info response, while tests/daemon/lxp_test_program_admission.c:50-51 pins LNI_MINOR to 4 and its handshake at line 352 refuses any response whose minor version is not exactly 4, so build/tests/lxp_test_program_admission fails at line 812 with 'handshake(descriptor) == 0' against a daemon that started correctly. agent/crates/layerx-client/tests/availability_daemon.rs:177 pins the same expectation through HandshakeConfig built_interface_version Version::V1_4. The daemon minor moved from 4 to 5 with the typed committed Asset and fee reads and neither client moved with it. This refusal is only reachable once the genesis request length bound accepts the shipped certificate threshold; before that the harness never started a daemon. Evidence: qual-logs/proof-fixture-corrected.log, where the bootstrap completes, the sequencer and replica start and the admission client refuses at the handshake."
assumption = "The wire version is a protocol decision that belongs with the LNI surface and its clients together, not with a bootstrap length bound, so neither the advertised version nor either client expectation was changed here."
severity = "blocker"

[observation.6.1.5803]
task = "6.1"
file = "platform/hosted/node/bootstrap.sh cmd/layerx-genesis/lxp_genesis_build_cli.c"
symbol = "genesis metadata length is outside request bounds GENESIS_BUILD_REQUEST_MAX_BYTES"
observed = "platform/hosted/node/bootstrap.sh:202 bounds the genesis metadata above by 15989 bytes, which is the builder limit GENESIS_BUILD_REQUEST_MAX_BYTES of 16384 at cmd/layerx-genesis/lxp_genesis_build_cli.c:18 minus 395, the fixed size of a single-guarantor request. With the certificate threshold at its maximum of 32 the fixed part is 2906 bytes, so metadata that the script admits can still carry the request past the builder limit and be refused by read_regular_file with LXP_ERR_IO rather than by a bootstrap message. The shipped threshold of 2 and the 375-byte metadata the harnesses produce are far inside both bounds, so nothing fails today. The check runs during argument validation, before the settlement document is read at line 279 and the guarantor count is known at line 287, so making it follow the threshold means moving the settlement document read ahead of it, which is a restructuring of the argument-handling section rather than a change to the request assembly."
assumption = "The upper bound is a latent single-guarantor constant with no current failure, and correcting it requires reordering a section of the script that other work also touches, so only the request length assertion was changed here."
severity = "note"

[observation.3.3.8000]
task = "3.3"
file = "Makefile tests/modules/test_service_helpers.h"
symbol = "test test-escrow-open test-budget-create test-stream-open test-service-offer test-wave-9"
observed = "Supersedes observation 3.3.3104. The aggregate make test target, at Makefile:269 on 88f0268fb, ended at test-terminal-rejection and named no module test target, so every escrow, budget, stream, service and perpetuals suite was reachable only individually or through a wave aggregate that make test does not invoke. The target now also depends on the five escrow targets, the five budget targets, the five stream targets, the six service targets and test-wave-9, so a regression in any of those modules fails the aggregate gate. The six service tests each carried their own copy of the kernel bring-up, the big-endian payload builders, the identifier and open_ctx helpers, the dispatch wrapper and the event and record assertions; those helpers now live once in tests/modules/test_service_helpers.h as static inline functions, which gcc does not warn about when a translation unit leaves one unused, and the six files fell from 2757 to 2205 lines against a 140-line header with no assertion changed. The header is the second prerequisite of each of the six link rules so the recipes keep $< as the .c file. Evidence: qual-logs/test-aggregate.log and qual-logs/module-target-sweep.log, where all twenty-two module targets report exit 0."
assumption = "The Makefile hunks are confined to the aggregate test prerequisite list and the module test link rules, because other lanes are adding rules elsewhere in the same file. The asset targets are deliberately not added here: they belong to the lanes rewriting src/modules/asset and adding them from this lane would collide with that work."
severity = "note"

[observation.6.11.8001]
task = "6.11"
file = "Makefile"
symbol = "test_escrow_dispute test_stream_lifecycle TEST_LIBRARY PROGRAMS_RUNTIME_LIB programs-build"
observed = "Supersedes observation 6.11.2800 and confirms it on 88f0268fb, where the two rules are unchanged at Makefile:496-500 and Makefile:612-616. Both linked only $(TEST_LIBRARY) with no $(PROGRAMS_RUNTIME_LIB), no programs-build order-only prerequisite and no -ldl -lm, and both failed on the layerx_programs_sandbox_*, layerx_programs_authorize_402lxp_leg, layerx_programs_module_cache_invalidate_upgrade, layerx_programs_migration_execute_activity and layerx_programs_interface_validate symbols that sandbox.c, transfer.c and deploy.c reference from the archive the rules do link; the baseline link failure is recorded in qual-logs/baseline-link.log with ld exit 1. Both rules now match the four escrow rules beside them: $(TEST_LIBRARY) $(PROGRAMS_RUNTIME_LIB) as prerequisites, | programs-build as an order-only prerequisite, and $(TEST_LIBRARY) $(PROGRAMS_RUNTIME_LIB) $(TEST_LIBRARY) -lcrypto -pthread -ldl -lm on the link line. make CC=gcc test-escrow-dispute test-stream-lifecycle test-service-dispute exits 0 in qual-logs/test-modules.log."
assumption = "The repeated $(TEST_LIBRARY) after $(PROGRAMS_RUNTIME_LIB) is the shape the working escrow rules already use and is required because the sandbox archive resolves back into the testing archive; it is not a workaround introduced here."
severity = "note"

[observation.6.11.8002]
task = "6.11"
file = "tests/modules/test_service_dispute.c"
symbol = "escrow_hold_seed escrow_hold_unchanged lx_escrow_state_put lx_escrow_lookup lx_escrow_module_iface state_root"
observed = "Supersedes observation 6.11.2801, which is already answered on 88f0268fb: test_service_dispute.c uses the context-based escrow key-value API and names no lx_escrow_store, so the file compiles and the target now links and passes. The dispute test additionally proves the cross-module property that a service dispute moves no escrow value. It registers lx_escrow_module_iface() beside lx_service_module_iface(), seeds one open escrow hold whose agreement reference is the disputed agreement through lx_escrow_state_put on an escrow module context, records the hold record and the escrow subtree root from lx_escrow_module_iface()->state_root, runs the dispute, and then re-reads both: the subtree root is byte-identical and lx_escrow_lookup returns the same state, locked_amount, captured_amount, owner, escrow_account, beneficiary, asset_id and agreement reference. Evidence: qual-logs/test-modules.log, make CC=gcc test-service-dispute exit 0."
assumption = "The hold is seeded and read through the module interface rather than the store so the assertion covers the same path the kernel uses; the pre-existing dispute assertions on transfer_calls, event_effects and the applier pointer are unchanged."
severity = "note"

[observation.6.11.8003]
task = "6.11"
file = "Makefile"
symbol = "test test-wave-9 test-perps-market test-perps-book test-perps-margin test-perps-funding test-perps-liquidation test-perps-insurance"
observed = "Supersedes observation 6.11.3209. test-wave-9, which groups the six perpetuals suites at Makefile:822-823, is now a prerequisite of the aggregate make test target, so a perpetuals regression fails make CC=gcc test instead of being reachable only through core-test-all at Makefile:2905, which make test does not invoke. Evidence: qual-logs/module-target-sweep.log records test-wave-9 exit 0 and qual-logs/test-aggregate.log records the aggregate run that now reaches it."
assumption = "test-wave-9 is added as a single prerequisite rather than the six perpetuals targets individually, so the wave grouping stays the one place the perpetuals suite list is maintained."
severity = "note"

[observation.6.11.8004]
task = "6.11"
file = "src/protocol/lxp_module_ctx.c tests/modules/test_service_dispute.c"
symbol = "lxp_module_ctx_commit staged_count escrow_hold_seed"
observed = "Observation 6.11.3210 still holds on 88f0268fb: lxp_module_ctx_commit at src/protocol/lxp_module_ctx.c:651 flushes the staged writes into the store without resetting ctx->staged_count, while lxp_module_ctx_rollback at :1003 does reset it. This was checked against the cross-module escrow assertion added to the service dispute test and it does affect it: reading lx_escrow_module_iface()->state_root from the same context that committed the seeded hold would observe the staged residue. The test therefore opens a fresh escrow module context after each commit before reading the subtree root or looking the hold up, and the reason is stated in the file so the pattern is not later simplified away. No change was made to lxp_module_ctx_commit here."
assumption = "src/protocol is outside this row's owned paths and the row instructs that this be recorded rather than fixed, so the residue is worked around in the test only. Clearing staged_count in commit is the fix and would let a committed context be reused directly."
severity = "suspect"

[observation.6.11.8005]
task = "6.11"
file = "tests/modules/test_escrow_capture.c tests/modules/test_escrow_dispute.c src/modules/asset/lx_asset_registry.c"
symbol = "lx_asset_register issuer_valid issuer_kind custody_kind name_length issuer_did32"
observed = "Repairing the two link rules made two escrow suites executable for the first time and both then failed at setup, exit 1 before any escrow assertion. issuer_valid at src/modules/asset/lx_asset_registry.c:561-597 requires issuer_kind in {1,2}, custody_kind equal to issuer_kind, a name_length in 1..LX_ASSET_NAME_MAX and a non-zero issuer_did32, and lx_asset_register returns LXP_ERR_NON_CANONICAL otherwise. The asset fixtures in test_escrow_capture.c and test_escrow_dispute.c set none of those fields, so the registration that seeds the escrow asset was refused. The fixtures had gone stale because the two suites could not link and so never ran while the registry validation was tightened. Both now set symbol_length, name, name_length, issuer_kind, issuer_did32 and custody_kind exactly as the already-passing tests/modules/test_escrow_open.c:129-140 and tests/modules/test_escrow_timeout.c:70-82 do, and both suites pass in qual-logs/escrow-repaired.log."
assumption = "The fixtures were brought in line with the registry's existing rules; no registry check was relaxed and no escrow assertion was changed. This is the concrete cost of a test target that cannot link: the suite drifts silently out of date behind the link failure."
severity = "note"
[observation.6.1.8600]
task = "6.1"
file = "tests/daemon/lxp_test_program_admission.c cmd/layerxd/lxp_daemon_lni.c agent/schema/lni/v1.kvx"
symbol = "LNI_MINOR LNI_VERSION_MINOR handshake decode_envelope send_envelope"
observed = "The LNI 1.5 bump is additive on the wire and the native admission client now speaks it. cmd/layerxd/lxp_daemon_lni.c:72-75 adds the request and response tags 32 to 35 for the typed committed asset read and fee estimate, send_node_info adds the capability names asset_read and fee_estimate to all five role capability sets, and both new handlers refuse a request whose minor is below 5 at lines 2271 and 2568. No existing tag, field or capability changed meaning, which is exactly what agent/schema/lni/v1.kvx:6 permits a minor release to do, and that schema already declares minor 5 at line 4. The daemon does negotiate the minor on the request side: decode_envelope at cmd/layerxd/lxp_daemon_lni.c:1179-1180 accepts every envelope whose major is 1 and whose minor is at most the implemented 5 and refuses a higher minor with LXP_ERR_VERSION_UNSUPPORTED, and each feature gates on the minor that introduced it (1 at line 2494, 2 at lines 3155, 3224, 3285 and 3361, 4 at line 2946, 5 at lines 2148, 2271 and 2568), so an older client is served the message set its own minor defines. What the daemon does not do is echo the request minor: send_envelope stamps LNI_VERSION_MAJOR and LNI_VERSION_MINOR at lines 1206-1207 into every response, so every response carries 1.5. tests/daemon/lxp_test_program_admission.c:51 pinned LNI_MINOR to 4 and its handshake at line 352 requires response.minor to equal that pin exactly, so it refused at line 812 with 'handshake(descriptor) == 0'. The pin is now 5, which is what the two other native LNI clients already require exactly: tests/test_daemon_lni_admission.c:48 and tests/daemon/lxp_test_pay1.c:126. The equality at line 352 is unchanged and was not turned into a lower bound. Raising the pin also raises the minor this client sends on every request, and no request it sends changes meaning at 5: its receipt selectors are 33 and 9 bytes (lines 428, 497, 596, 643 and 796), never the 34 or 10 byte shapes send_receipt reads a trailing wait_publication byte from at line 2148. Evidence: qual-logs/test-program-admission.log, where make CC=gcc test-program-admission exits 0 and the client completes its handshake, admission, receipt and simulation exchanges against a real layerxd, and qual-logs/test-program-admission-mainfixture.log for the refusal that precedes it. This resolves observation 6.1.5802."
assumption = "The daemon's implemented wire version is the truth and its clients follow it. Lowering LNI_VERSION_MINOR to match a stale client, or relaxing the client's exact-version check into a lower bound, would each hide the next split rather than the current one, so neither was done. Reaching the handshake at all required a local, uncommitted correction of tests/support/lxgb_metadata.py to the custody shape lx_asset_record_decode accepts, which is observation 6.1.5801 and belongs to another change; with the shipped fixture the harness stops at layerx-genesis-build and never starts a daemon. That correction is recorded in qual-logs/probe-asset-record-local.log and is not part of this change."
severity = "note"

[observation.6.1.8601]
task = "6.1"
file = "agent/crates/layerx-client/tests/availability_daemon.rs agent/crates/layerx-client/src/lni/handshake.rs agent/crates/layerx-client/src/lni/schema.rs"
symbol = "built_interface_version validate SCHEMA"
observed = "The Rust real-daemon harness still declares itself built for LNI 1.4 while the crate it exercises declares 1.5. agent/crates/layerx-client/tests/availability_daemon.rs pins Version::V1_4 at lines 21, 47, 95, 117, 177, 194 and 202, including the HandshakeConfig built_interface_version it hands to perform at line 177, while agent/crates/layerx-client/src/lni/schema.rs:439-443 builds the client SCHEMA at Version::V1_5. Unlike the native client this does not refuse: validate at agent/crates/layerx-client/src/lni/handshake.rs:160 compares only the major component of the peer interface version, so a client built for 1.4 is a valid peer of a 1.5 node and the handshake is accepted, and perform at line 135 sends the node info request at minor 0 regardless. The cost is coverage rather than a refusal: at minor 4 that harness can never reach the 1.5 request set, so the asset read and fee estimate paths added at cmd/layerxd/lxp_daemon_lni.c:2271 and 2568 have no real daemon test. The file is outside this change and was not edited. Evidence: qual-logs/test-daemon-availability-rerun.log, where all three probe stages accept the 1.5 daemon."
assumption = "Major-only compatibility is the rule the schema states, so a 1.4 client against a 1.5 daemon is correct rather than broken, and moving those pins is a coverage decision for the crate that owns the harness, not a fix for the refusal this change addresses."
severity = "note"

[observation.6.1.8602]
task = "6.1"
file = "cmd/layerxd/lxp_daemon_lni.c tests/daemon/lxp_test_program_admission.c tests/daemon/lxp_test_pay1.c tests/test_daemon_lni_admission.c"
symbol = "LNI_VERSION_MAJOR LNI_VERSION_MINOR LNI_MAJOR LNI_MINOR"
observed = "Nothing ties the LNI wire version the daemon implements to the version its native clients require. The daemon keeps LNI_VERSION_MAJOR and LNI_VERSION_MINOR in a file-local enum at cmd/layerxd/lxp_daemon_lni.c:47-48, and each of the three native LNI clients carries its own private copy: tests/daemon/lxp_test_program_admission.c:50-51, tests/test_daemon_lni_admission.c:47-48 and, as a literal, tests/daemon/lxp_test_pay1.c:126. There is no shared header, generated constant or check that reads agent/schema/lni/v1.kvx, whose schema section is the written record of the version at lines 3 and 4, so a bump can land in the daemon while a client keeps the previous number and nothing fails until that client next runs against a real daemon. That is how the 4 against 5 split arose and it will recur at the next minor. A single source of truth, for example an installed header the daemon and every native client include and that the schema document is checked against, would make the split impossible; adding one touches include/ and cmd/layerxd, both outside this change."
assumption = "Four independent copies of one protocol constant are the defect rather than any one of the copies, and consolidating them is a change to the daemon and the installed headers that belongs with the LNI surface, so only the stale copy was corrected here."
severity = "suspect"

[observation.6.1.8603]
task = "6.1"
file = "cmd/layerxd/lxp_daemon_lni.c"
symbol = "send_asset_read send_fee_estimate evidence_refusal"
observed = "The two message handlers added with LNI 1.5 report a version mismatch with the wrong result. send_asset_read at cmd/layerxd/lxp_daemon_lni.c:2271 and send_fee_estimate at line 2568 both fold the minor gate into the same condition as their payload validation and answer any request whose minor is below 5 with LXP_ERR_NON_CANONICAL, so a client that legitimately speaks 1.4 and asks for an asset read is told its bytes are malformed rather than that the message does not exist at its version. Every other version gate in the same file reports LXP_ERR_VERSION_UNSUPPORTED: lines 3155-3158, 3224-3229, 3285-3292 and 3361-3369 select that result explicitly when the minor is below 2, and decode_envelope at lines 1179-1180 returns it for a minor above the implemented one. No test asserts either result for these two tags, so nothing fails today. Correcting it changes a wire-visible refusal code and belongs with the LNI surface rather than with a client version pin."
assumption = "A version gate and a canonicality gate are different refusals and the surrounding file already distinguishes them, so the two new handlers are inconsistent with their own file; the daemon was left exactly as written because changing a refusal code is a protocol decision and this change owns only the client pin."
severity = "suspect"

[observation.6.1.8604]
task = "6.1"
file = "agent/crates/layerx-client/tests/availability_daemon.rs platform/hosted/node/bootstrap.sh"
symbol = "assert_genesis_request genesis-request.lxgb"
observed = "The genesis request assertion reads a file the bootstrap deletes. assert_genesis_request at agent/crates/layerx-client/tests/availability_daemon.rs:302 reads data/work/genesis-request.lxgb under the harness work directory, and platform/hosted/node/bootstrap.sh:423 does build the request there, but line 642 removes the whole work directory at the end of a successful bootstrap, after the signer key is unlinked and the treasury document is written. The directory is therefore absent from every completed bootstrap. With the LNI version split fixed the native admission harness runs to completion and exits 0, all three availability probe stages pass against a real layerxd, and make CC=gcc test-daemon-availability then fails at availability_daemon.rs:303 with 'bootstrap genesis request: No such file or directory (os error 2)'. Either the bootstrap has to retain the request, for instance beside the other genesis artefacts it keeps in the genesis directory, or the assertion has to read it from where it is kept. Both files are outside this change. Evidence: qual-logs/test-daemon-availability-rerun.log and qual-logs/genesis-request-path.log, which lists the completed data directory and the removal line."
assumption = "The bootstrap decides what a node keeps and the harness reads what the bootstrap leaves, so the assertion is reading the wrong path rather than the bootstrap keeping the wrong files; choosing between retaining the request and relocating the read changes what a production data directory contains, which is not a client version pin."
severity = "blocker"

[observation.6.1.8605]
task = "6.1"
file = "tests/daemon/lxp_test_program_admission.c"
symbol = "availability_batches found"
observed = "The availability batch stage of the native admission client polls for a published receipt on a fixed budget and missed it once under parallel load. availability_batches at tests/daemon/lxp_test_program_admission.c:593-636 submits nine deploy activities in sequence and, for each one, sends a receipt lookup up to 200 times with a 10 millisecond pause, then requires found at line 635, so one activity has 2 seconds from acknowledgement to publication. In three consecutive runs of make CC=gcc test-daemon-availability on the same tree and the same binaries the first run failed at line 635 and then at line 821 while the second and third completed the whole stage and both later probe stages, so the stage is timing sensitive rather than wrong. checked_receipt at line 495 and governance_registration at line 640 poll the same way but pause 50 milliseconds at lines 530 and 698, a budget five times larger, and neither has failed. The acknowledgement that precedes the poll succeeded in the failing run, so the activity was admitted and queued and only its publication was late. Evidence: qual-logs/test-daemon-availability.log for the failure and qual-logs/test-daemon-availability-rerun.log and qual-logs/test-daemon-availability-run3.log for the two passes."
assumption = "A poll budget is not an assertion about the protocol, so the wait was left exactly as written rather than widened to make a loaded machine pass; whether 2 seconds is the intended publication bound for this stage, or whether it should match the 10 seconds the other two stages allow, is a decision for the harness owner."
severity = "suspect"

[observation.3.1.8300]
task = "3.1"
file = "src/ledger/lxp_receipt.c include/layerx/lxp_receipt.h tests/ledger/test_receipt.c"
symbol = "lxp_ledger_receipt_build LXP_LEDGER_RECEIPT_MODULE_ID LXP_LEDGER_RECEIPT_MODULE_VERSION lxp_receipt_decode"
observed = "This supersedes observation 3.1.3601. lxp_ledger_receipt_build now stamps the executing module identity: it sets module_id to LXP_LEDGER_RECEIPT_MODULE_ID and module_version to LXP_LEDGER_RECEIPT_MODULE_VERSION, both declared in include/layerx/lxp_receipt.h, so every ledger and gateway receipt decodes through lxp_receipt_decode instead of being refused with LXP_ERR_NON_CANONICAL by the non-zero module identity check in src/protocol/lxp_receipt.c. The identity is the asset module: lxp_ctx_bind_ledger_receipt in src/protocol/lxp_module_ctx.c refuses any ledger admission whose ctx->module_id is not LXP_MODULE_ASSET and whose activity type is not LXP_MODULE_ASSET << 16 | operation, and lx_asset_module_iface declares abi_version 1. The header constant is tied to the registry value by a _Static_assert in src/ledger/lxp_receipt.c rather than by calling lx_asset_module_iface, because referencing the module interface from the ledger translation unit pulls lxp_kernel.o and the programs module objects into every binary that links only build/liblayerx.a and leaves ten layerx_programs_* symbols undefined; tests/ledger/test_receipt.c cross-checks both constants against lx_asset_module_iface()->module_id and ->abi_version and links the programs runtime for that purpose. The same fix also unblocks encoding: lxp_receipt_validate_supply requires module_id equal to LXP_MODULE_ASSET whenever supply_binding_version is 1, so a supply-bound ledger receipt could not previously even encode. Receipt bytes and signatures produced by lxp_ledger_receipt_issue and by lxp_gateway_send_settle change, because module_id and module_version are covered by the canonical encoding and the digest; the beta chain is disposable and no committed artifact pins the old bytes. Decoding every committed receipt artifact with the protocol codec returns LXP_OK with module_id 1 and module_version 1 for receipt-positive-v1, receipt-positive-v2, receipt-positive-v3 and tests/fixtures/receipt-supply-v2.bin, because their generators already overwrote the identity before signing, so no fixture or vector required regeneration. tests/ledger/test_receipt.c now decodes the receipt read back from the write-ahead log, compares every field, re-verifies the signature, re-encodes the decoded receipt and compares the bytes, requires the unsigned encoding to be refused with LXP_ERR_BAD_SIGNATURE when a signature is demanded, and requires a re-signed copy with a zero module identity to decode as LXP_ERR_NON_CANONICAL. The gateway and direct receipt equality asserted in tests/test_gateway_send.c is unchanged because the identity is stamped in the shared builder both paths reach. Evidence: qual-logs/make-test.log, qual-logs/make-gateway.log, qual-logs/make-receipt-suite.log, qual-logs/make-replay-golden.log."
assumption = "The executing module of a ledger receipt is the asset module at abi_version 1, which is what the module context and the kernel ledger projection both require and what three existing call sites already patch onto ledger receipts by hand. The identity belongs in the ledger receipt builder rather than in src/network, so gateway and direct receipts continue to agree byte for byte."
severity = "note"

[observation.3.1.8301]
task = "3.1"
file = "platform/sdk/conformance/fixtures/generate_receipt_fixture.c src/modules/asset/lx_asset_registry.c"
symbol = "world_init lx_asset_register issuer_valid"
observed = "The conformance receipt fixture generator cannot run on this revision, independently of the receipt identity change. build/bin/generate_receipt_fixture prints 'fixture: world initialisation failed' and exits 1. An instrumented copy of world_init reports lx_asset_registry_init LXP_OK, lx_asset_register LXP_ERR_NON_CANONICAL, lx_account_registry_init LXP_OK and both lx_asset_account_open calls LXP_ERR_ASSET_MISMATCH, the last two being consequences of the unregistered asset. The refusal is issuer_valid at src/modules/asset/lx_asset_registry.c:561-572, which requires issuer_kind to be 1 or 2, custody_kind to equal issuer_kind, a non-zero name_length and a non-zero issuer_did32. generate_receipt_fixture.c:104-109 sets only asset_id, symbol, symbol_length, custody_kind and custody_reference, leaving issuer_kind, name_length and issuer_did32 zero, so the record is refused at the first condition. The failure is reproduced with the ledger receipt change reverted and is therefore pre-existing; it is the same class of breakage that the fix for tests/network/test_gateway_kv.c addressed after issuer_valid was introduced. The generator is not wired into any make target and its committed outputs receipt-positive-v1, receipt-positive-v2, receipt-positive-v3 and tests/fixtures/receipt-supply-v2.bin all still decode as LXP_OK, so no gate depends on it."
assumption = "The asset record contract in the module is authoritative and the fixture generator's world is stale against it. The file is a conformance fixture tool outside the ledger receipt paths this issue owns, and repairing its world changes the fixture bytes every SDK conformance consumer compares against, so it was left as written."
severity = "suspect"

[observation.3.1.8302]
task = "3.1"
file = "src/ledger/lxp_receipt.c src/protocol/lxp_receipt.c platform/sdk/conformance/fixtures/generate_receipt_fixture.c"
symbol = "lxp_ledger_receipt_build parameter_version lxp_receipt_encode"
observed = "lxp_ledger_receipt_build still leaves parameter_version zero. The canonical encoding carries the field and the decoder does not constrain it, so a ledger receipt with parameter_version zero encodes, decodes and verifies; but generate_receipt_fixture.c:297 and tests/tools/test_verify_cli.c both set parameter_version to 1 on a settled receipt before signing, so the committed conformance artifacts carry 1 where a live settlement carries 0. Nothing selects behaviour on the value today. Deciding what a ledger receipt's parameter version means requires the fee and metering parameter set that produced the settlement, which the ledger receipt input does not carry, so the field was not invented here."
assumption = "A parameter version is a statement about the parameter set in force at execution, and the ledger receipt input carries no such reference, so stamping a constant would assert something the builder cannot know. Only the module identity, which the module context does determine, was set."
severity = "note"

[observation.3.1.8303]
task = "3.1"
file = "src/network/lxp_gateway_kv.c src/protocol/lxp_receipt.c"
symbol = "gateway_receipt_record_write gateway_receipt_record_read lxp_receipt_encode lxp_receipt_decode"
observed = "The gateway invoice store encodes settled receipts with its own record format because ledger receipts could not be decoded back by the protocol codec, as observation 3.1.3601 recorded. With the module identity now stamped by lxp_ledger_receipt_build, a settled gateway receipt round-trips through lxp_receipt_encode and lxp_receipt_decode, so the bespoke gateway record encoder and its decode-and-compare are no longer forced by the codec. Replacing it would change the persisted invoice record bytes and therefore the gateway key/value state root, which is a src/network change this issue is explicitly barred from making."
assumption = "The gateway record format is a src/network concern owned elsewhere, and the reason it exists has been removed rather than the format itself, so the duplication is recorded and not collapsed."
severity = "note"

[observation.3.6.4300]
task = "3.6"
file = "agent/crates/layerx-mcp/src/server.rs agent/crates/layerx-agentd/src/tenant.rs platform/cli/src/toolset.rs"
symbol = "TOOL_CATALOGUE tool_operation authorize_tool SERVED faucet.request"
observed = "The faucet MCP tool was added to platform/cli/src/toolset.rs SERVED rather than to agent/crates/layerx-mcp/src/server.rs TOOL_CATALOGUE. Two MCP surfaces exist and they do not share a catalogue. The layerx-mcp crate routes every call through layerx-agentd: authorize_tool at agent/crates/layerx-mcp/src/server.rs:666 resolves the tool name through tool_operation at line 687 and returns ServerError::InvalidInvocation for any name that has no Operation, and the Operation enum plus the scope aliases that admit it live in layerx-agentd, outside this row's owned paths. Adding faucet.request to TOOL_CATALOGUE without a matching Operation variant and an agentd scope alias would produce a tool that is advertised and always refuses, which is a placeholder. The surface layerx mcp serve actually serves is toolset.rs SERVED, which reaches the hosted gateway directly, so faucet.request was placed there and reaches the same lx_requestFunds method the CLI and SDK use."
assumption = "The daemon-routed catalogue is the right long-term home once agentd carries a faucet Operation and its scope alias. Recorded because the row named agent/crates/layerx-mcp/src/server.rs and this implementation deliberately did not touch it."
severity = "note"

[observation.3.6.4301]
task = "3.6"
file = "platform/hosted/testnet/deployment.yaml platform/hosted/gateway/deployment.yaml platform/hosted/tests/beta-cluster.sh"
symbol = "LAYERX_GATEWAY_FAUCET_URL LAYERX_GATEWAY_FAUCET_SERVICE_TOKEN_FILE LAYERX_FAUCET_SERVICE_CLAIM_TOKEN_FILE"
observed = "lx_requestFunds proxies to the faucet over a new service route, POST /v1/faucet/service-claims, that is admitted only by a shared secret the faucet reads from LAYERX_FAUCET_SERVICE_CLAIM_TOKEN_FILE (platform/hosted/faucet/src/main.rs:218-223 and 285). No hosted manifest sets that key, sets the gateway's LAYERX_GATEWAY_FAUCET_URL or LAYERX_GATEWAY_FAUCET_SERVICE_TOKEN_FILE, mounts a secret holding the shared token into either pod, or admits app=layerx-gateway in the faucet NetworkPolicy ingress. Both ends are therefore unconfigured on the beta cluster: the faucet answers 404 not_found for the service route (platform/hosted/faucet/src/main.rs:976-978) and the gateway answers -32001 with data.code faucet_not_configured rather than pretending to claim. Until the manifests carry the secret, the two variables and the gateway-to-faucet edge, the public faucet method refuses on the cluster while POST /v1/faucet/claims keeps working unchanged."
assumption = "platform/hosted/testnet/deployment.yaml, platform/hosted/gateway/deployment.yaml and platform/hosted/tests/beta-cluster.sh are outside this row's owned paths, so the wiring was not added here and is recorded in the lane's NEEDS.md as well. It mirrors the identity-client mount beside it: one secret, two mountPaths, three environment variables and one NetworkPolicy ingress rule."
severity = "blocker"

[observation.3.6.4302]
task = "3.6"
file = "platform/hosted/faucet/src/main.rs platform/hosted/gateway/src/rpc_faucet.rs"
symbol = "service_claim settle service_scope idempotency"
observed = "A service claim keys the identity quota bucket on the principal the caller names, not on the calling service, so a principal that claims through lx_requestFunds shares one identity window with its own direct POST /v1/faucet/claims (platform/hosted/faucet/src/main.rs:993-1003). Only the network bucket is scoped, as service:<principal>, so one gateway pod's peer address cannot become a single global choke point for every principal behind it. The gateway additionally derives the faucet idempotency key deterministically from the principal, the DID and the signer key (platform/hosted/gateway/src/rpc_faucet.rs), so a repeated request settles onto the same reservation instead of consuming a second grant. Two consequences follow: the calling service is trusted to name the principal honestly, which is what the shared service token establishes, and the per-window bound in the row's default holds across both entry points rather than per entry point."
assumption = "This is the row's DEFAULT decision. Keying the identity window on the bare principal is the only construction that closes the double-claim window between the two routes; scoping the network bucket per principal is the only one that keeps a shared proxy from exhausting the peer bucket for everyone."
severity = "note"

[observation.3.6.4303]
task = "3.6"
file = "docs/wiki/PublicRpc.md docs/wiki/Cli.md"
symbol = "lx_register layerx register"
observed = "docs/wiki/PublicRpc.md stated that the gateway provides 15 lx_* methods and its Methods table omitted lx_register, which had already been added to platform/hosted/gateway/openrpc.json and dispatched from platform/hosted/gateway/src/rpc.rs before this row started; docs/wiki/Cli.md documents no layerx register command although platform/cli/src/main.rs:64 declares it. Adding lx_requestFunds made the count 17. The count and the lx_requestFunds row were corrected here, and lx_register was added to the same table because leaving one of the two onboarding methods undocumented beside the other would be misleading. The layerx register row in the Cli.md command table was not added, because that table belongs to the command's own row."
assumption = "The onboarding pair is documented together in PublicRpc.md; the missing Cli.md row for layerx register is left for whoever owns that command."
severity = "note"

[observation.3.6.4304]
task = "3.6"
file = "docs/wiki"
symbol = "path:line citations"
observed = "Thirteen wiki pages cite platform/cli/src/main.rs, platform/cli/src/toolset.rs, platform/hosted/faucet/src/main.rs, platform/hosted/gateway/src/main.rs and platform/hosted/gateway/src/rpc.rs by line number, and more than four hundred of those citations moved when this row inserted code into those five files. They were remapped from the exact diff hunk arithmetic, except where code was lifted into a new function: the faucet route, where preflight and settle were extracted out of route, and the gateway config(), where the protocol reads were extracted into configured_protocol(). Hunk arithmetic maps a citation in those regions into the extracted helper rather than the code it named, so they were remapped by following the moved lines, and one citation that straddled a split was repointed by symbol. A separate check found that several of the gateway environment-variable citations in HostedGateway.md and HostedRegistry.md already named the wrong lines before this row started, so remapping preserves their existing drift rather than correcting it. Nothing in the tree verifies these citations, so any future edit to a cited file silently rots every page that points into it."
assumption = "A checker that resolves each path:line citation and fails when the cited range no longer contains what the sentence claims would make the wiki verifiable, but it is a new tool outside this row. Recorded so the next editor of these files knows the citations must be remapped rather than left alone."
severity = "suspect"

[observation.3.6.4305]
task = "3.6"
file = "platform/emulator/build.rs Makefile"
symbol = "build.rs make build programs cargo build CARGO_TARGET_DIR"
observed = "platform/emulator/build.rs:28-30 runs make build in the repository root, and that target runs cd programs && cargo build --locked --workspace --features layerx-programs-sandbox/host-ffi. The inner cargo inherits CARGO_TARGET_DIR from the environment, so any outer invocation of the form CARGO_TARGET_DIR=<dir> cargo test -p layerx-platform-cli deadlocks: the inner cargo blocks on the build-directory lock the outer cargo already holds, and the outer cargo waits for it forever. Nothing times out and no error is printed; the outer process simply parks with no compiler children and keeps the target directory locked against every other consumer. Invoking the outer build as cargo test --target-dir <dir> instead does not reproduce it, because the flag is not exported and the nested programs build takes the worktree-local programs/target lock."
assumption = "Makefile:3032 already exposes PROGRAMS_CARGO, which lets a caller hand the nested programs build its own CARGO_TARGET_DIR, but it defaults to plain cargo, so inheriting the outer target directory is the out-of-the-box behaviour. Making that default safe is a Makefile and build-script change outside this row's owned paths, so it was not made here; the gates in this row were run with --target-dir and with PROGRAMS_CARGO pointed at the worktree-local programs target."
severity = "suspect"

[observation.3.6.4306]
task = "3.6"
file = "platform/hosted/faucet/src/main.rs"
symbol = "route ClaimRequest service_claim_fields"
observed = "platform/hosted/faucet/src/main.rs:1036 deserialises the POST /v1/faucet/claims body straight into ClaimRequest with serde_json::from_slice. Serde admits a JSON array wherever a struct is expected as long as the element order matches the field order, so a body of [\"did:layerx:alice\", \"<64 hex>\"] is accepted as a claim even though the documented request shape is an object and ClaimRequest carries deny_unknown_fields. The service-claim route added by this row refuses that shape: service_claim_fields at 967-977 parses the body as a serde_json::Value and requires it to be an object before deserialising it."
assumption = "The public claim route should require an object as well, so the two faucet entry points agree on what a claim looks like on the wire. That route is outside this row's issue, so only the new one was tightened."
severity = "note"

[observation.3.6.4307]
task = "3.6"
file = "platform/hosted/gateway/src/main.rs"
symbol = "config configured_protocol"
observed = "Adding one field to the Config literal in config() took that function to 101 lines and clippy::too_many_lines, denied by the workspace lint table, refused the build. The bound cannot be met by the faucet line alone, so the network identifier, LXP wire version and protocol network identifier reads and their three validity checks were lifted out of config() into configured_protocol() returning a ProtocolConfig. config() is the only caller and its behaviour and error strings are unchanged; the extraction is what made room for the field, not a cosmetic tidy."
assumption = "config() is at the lint bound, so the next field added to Config will force another extraction. Splitting it by concern (outbound identity, secrets, protocol, endpoints) would give it room, but that is a wider refactor than this row owns."
severity = "note"

[observation.3.7.2700]
task = "3.7"
file = "src/modules/asset/lx_asset_registry.c tests/modules/test_asset_withdraw_activity.c"
symbol = "module_execute module_execute_impl execute_withdrawal"
observed = "make CC=gcc test-asset-withdraw-activity exits 2 printing case 0 line 151, the assertion that a well formed withdraw activity dispatches with LXP_OK. module_execute resolves the asset id for the supply binding through a switch over ordinals 1, 4, 6, 7, 8, 10 and 11 whose default arm answers LXP_ERR_UNKNOWN_ACTIVITY, so ordinal 9 is refused before module_execute_impl runs, and module_execute_impl is the only caller of execute_withdrawal. The withdraw execution path is therefore unreachable through lxp_kernel_dispatch even though the module advertises LX_ASSET_WITHDRAW in activity_types and lxp_kernel_module_for_activity resolves it. The same target fails identically with the same message on a tree with this branch's changes removed; evidence qual-logs/baseline-withdraw.log and qual-logs/baseline2.log beside this branch's qual-logs/test-asset-withdraw-activity.log. The target is not reachable from the make test target and is not in this row's gate set."
assumption = "The refusal predates this change and belongs to the withdrawal owner: the repair is a case 9 arm in that switch that takes the asset id from the withdraw payload, which also decides whether a withdrawal receipt carries a supply binding. Neither the switch nor the test was touched here, because widening the switch changes which receipts carry a supply binding and that is a consensus visible decision outside the pause and unpause scope of this row."
severity = "blocker"

[observation.3.7.2701]
task = "3.7"
file = "include/layerx/lxp_fee.h src/protocol/lxp_fee.c"
symbol = "LXP_ASSET_FEE_PRICE_COUNT asset_ordinals lxp_fee_compute"
observed = "Asset pause and unpause are now real transitions that native and hosted admission accept, but the version 2 fee schedule cannot price them. LXP_ASSET_FEE_PRICE_COUNT is 8 at include/layerx/lxp_fee.h line 21 and asset_ordinals at src/protocol/lxp_fee.c line 7 lists 1, 4, 5, 6, 7, 8, 10 and 11; lxp_fee_compute searches that table for any asset activity when parameters->version is 2 and answers LXP_ERR_UNKNOWN_ACTIVITY when the ordinal is absent. A node running the version 2 schedule therefore refuses to price an ordinal 2 or ordinal 3 activity even though the module executes it. The committed default schedule is version 1, which prices by the numeric activity type and needs no table, so the two ordinals are payable there."
assumption = "The price table, its canonical encoding, its governance codec and every fixture that pins a version 2 schedule change together in one revision, and all of those live outside this row's owned paths. No price entry was added and the count was not widened, because either change alters the canonical fee parameter encoding and the genesis material derived from it."
severity = "blocker"

[observation.3.7.2702]
task = "3.7"
file = "src/modules/asset/lx_asset_registry.c src/protocol/lxp_module_ctx.c src/protocol/lxp_receipt.c"
symbol = "module_execute lxp_ctx_bind_asset_supply lxp_receipt_validate_supply"
observed = "Pause and unpause execute through module_execute_impl and asset_execute_typed but keep the early return in module_execute that skips lxp_ctx_bind_asset_supply, so their receipts carry no supply binding. Binding them is not currently possible: lxp_ctx_bind_asset_supply builds a probe receipt whose operation is the submitted ordinal and hands it to lxp_receipt_validate_supply, whose switch at src/protocol/lxp_receipt.c line 540 accepts operations 1, 4, 5, 6, 7, 8, 10 and 11 and answers LXP_ERR_NON_CANONICAL for everything else. Since neither ordinal changes total_units, the omitted binding hides no supply movement, but a verifier that expects every asset receipt to carry one will not find it on these two."
assumption = "The operation allow list of lxp_receipt_validate_supply is consensus visible receipt structure owned by the receipt path, not by the asset module, so it was left exactly as written and the early return was kept rather than widening the allow list to make a binding possible."
severity = "note"

[observation.3.7.2703]
task = "3.7"
file = "agent/crates/layerx-crypto/src/payments.rs agent/crates/layerx-crypto/src/disclosure.rs agent/crates/layerx-crypto/tests/payments.rs platform/hosted/core/src/main.rs"
symbol = "Payment ASSET_SUBMISSION_ORDINALS decoded_fields payment_monetary_fields validate_submission_payload"
observed = "Adding 2 and 3 to ASSET_SUBMISSION_ORDINALS is inert on its own. validate_submission_payload calls layerx_crypto::disclosure::bind for every asset ordinal, bind routes the payload through decoded_fields, and decoded_fields dispatched only asset ordinals 1, 4, 6, 7, 8, 10 and 11, so an admitted pause or unpause would have been refused with DisclosureError::UnsupportedActivity and reported as invalid_asset_activity. Hosted admission of the two ordinals therefore required Payment::Pause and Payment::Unpause variants with their activity type, validation, encoding and decoding, the monetary field mapping and the widened decoded_fields dispatch, all inside agent/crates/layerx-crypto, which is outside the paths this row names."
assumption = "The crate is the disclosure mirror of the native payload codecs and cannot describe an activity the native module executes without these variants, so the addition was made rather than shipping an ordinal list that admission would reject; the change is additive, no existing variant, fixture or assertion was altered, and the only test edit is the match arm in agent/crates/layerx-crypto/tests/payments.rs that must enumerate the two new variants for the compiler."
severity = "note"

[observation.3.7.2704]
task = "3.7"
file = "platform/hosted/core/tests/boundary.rs cmd/layerx-genesis/lxp_genesis_build_cli.c src/protocol/lxp_genesis.c"
symbol = "build_genesis build_artifacts lxp_genesis_build_fresh_empty"
observed = "Every one of the fourteen tests in platform/hosted/core/tests/boundary.rs fails at boundary.rs line 144 on this revision because build/bin/layerx-genesis-build exits 1 on the LXGB version 2 request build_genesis constructs, so cargo test -p layerx-platform-core exits 101 (qual-logs/cargo-platform-core.log). The refusal is silent: lxp_genesis_builder_cli_main maps any non LXP_OK from build_artifacts to exit status 1 and the harness command helper prints only stderr, which is empty. A syscall trace of the same invocation shows the tool opening the request and the signer key and calling exit_group(1) before it creates the output directory (qual-logs/genesis-build-strace.log), so it refuses inside build_artifacts before any artifact is written, in parse_request or lxp_genesis_build_fresh_empty. The refusal is not caused by asset pause and unpause: rebuilding the same binary from this revision with this branch's C changes reverted (qual-logs/c-hunks.patch) refuses an identically constructed request with the identical exit status (qual-logs/gb/baseline-run.log, request generator qual-logs/gb/mkreq.py), and cmd/layerx-genesis and src/protocol/lxp_genesis.c are unchanged between this branch's merge base and the current main, so the refusal follows from the ledger and asset changes merged into main in that range. The ten unit tests in platform/hosted/core/src/main.rs pass, including this branch's asset_pause_and_unpause_are_admitted_and_malformed_bodies_are_refused."
assumption = "The genesis builder and the boundary harness are owned by the hosted core and genesis paths, not by the asset module, so nothing in either was touched and no assertion was relaxed to make the target exit 0; the gate is reported as failing for a reason that reproduces without this branch's changes. The harness also requires LAYERX_TEST_SOCAT_BIN, which no Makefile target or workflow in the repository sets, so supervisor_reset_rebuilds_genesis_and_replays_once panics on the unset variable on any tree."
severity = "blocker"

[observation.3.6.7500]
task = "3.6"
file = "platform/hosted/tests/topology-regressions.py"
symbol = "RESOLVED_EDGES HUMAN_EDGES SEPARATELY_OPERATED_EDGES named"
observed = "The regression pinned the resolved topology as two integers, forty without the Human manifest and forty two with it, and the tree resolves forty one and forty three, so make platform-hosted-topology-check exited 2 on an unmodified checkout as observation 3.7.4405 recorded. Reconstructing the checker and the nine manifests at the revision that wrote those integers and diffing the resolved edge set against the current tree shows exactly one added resolved edge, Deployment layerx-testnet/layerx-gateway -> layerx-pending-core.layerx-testnet.svc.cluster.local:9443 [env LAYERX_GATEWAY_PUBLIC_CORE_URL], and one moved note edge, LAYERX_HUMAN_WEB_ORIGIN, which resolves off cluster and is not counted. The added edge is the public read source declared at platform/hosted/gateway/deployment.yaml:78, documented at platform/hosted/gateway/README.md:13 and docs/wiki/HostedGateway.md:222 and 245, admitted by the layerx-gateway egress rule for layerx-plane trusted-boundary on 9443 and by layerx-node-ingress at the node pod, and reaching a declared Service whose targetPort core-tls is a container port; observation 6.2.919 records the same edge being admitted when it was added. Both integers are replaced by named edge tuples: RESOLVED_EDGES holds the forty one edges the eight manifests resolve, HUMAN_EDGES holds the two the Human manifest resolves and the baseline must leave failing, SEPARATELY_OPERATED_EDGES holds the one status publisher edge, and named() compares the checker's labelled rows against those tuples for duplicates, unnamed edges and named edges that disappeared before asserting the length. Every count the regression asserts is now len() of a named tuple, and the two Human failures are asserted by name rather than by the number two."
assumption = "An edge label carries the caller workload, the host, the port and the configuration key that declares it, so it names the connection a reviewer must approve; a count does not. Naming the resolved, Human and separately operated sets makes an added or removed edge a named diff and keeps a future addition from being absorbed by editing a literal. No assertion was relaxed: the mutation refusals, the parser parity check, the namespace precedence case and the node literal block case are unchanged, and the mutation bound that read len(result) > 2 now reads len(result) > len(HUMAN_EDGES), which is the same bound expressed through the named set."
severity = "note"

[observation.3.7.7501]
task = "3.7"
file = "platform/Makefile.inc"
symbol = "platform-hosted-agentd-check platform-hosted-topology-check"
observed = "platform/hosted/agentd/manifest_check.py had no caller anywhere in the tree and platform/hosted/agentd/probe.sh was reached only from platform/hosted/tests/beta-cluster.sh:1720, which needs a cluster, so neither surface was exercised by any check target. platform/Makefile.inc now declares platform-hosted-agentd-check, which parses the probe with sh -n and runs the manifest check, and platform-hosted-topology-check depends on it, so the hosted check target that already owns the manifest topology also proves the agentd Service, its mutually authenticated boundary, the loopback port disjointness of the node pod and the ingress closure, together with the thirteen mutations manifest_check.py refuses."
assumption = "probe.sh asserts properties of a deployed Service and cannot run without a cluster, so the target parses it and leaves the live assertions to the bring-up that already calls it; manifest_check.py reads platform/hosted/node/deployment.yaml and platform/hosted/human/material.py from the tree and needs nothing deployed, so it runs in full. The target is added to .PHONY beside the other hosted check targets and no existing recipe line was changed."
severity = "note"

[observation.4.3.8900]
task = "4.3"
file = "Makefile platform/emulator/build.rs"
symbol = "PROGRAMS_CARGO PROGRAMS_TARGET_DIR PROGRAMS_WORKSPACE_CARGO programs-build PROGRAMS_RUNTIME_LIB"
observed = "platform/emulator/build.rs:28-34 runs make build in the repository root, and every platform-workspace cargo command that compiles layerx-platform-emulator already holds the .cargo-lock of its own CARGO_TARGET_DIR while that build script runs. make build reaches programs-build (Makefile:3068) through the order-only | programs-build prerequisite that build: layerx-guarantor pulls in (Makefile:3397-3401), and programs-build ran cd programs && $(PROGRAMS_CARGO) build with PROGRAMS_CARGO ?= cargo (Makefile:3052), so the nested cargo inherited the caller's CARGO_TARGET_DIR and waited on the build-directory lock its own ancestor held; neither ever finished and every other process sharing that target directory queued behind the pair. programs-build and the $(PROGRAMS_RUNTIME_LIB) rule (Makefile:3065) now run through PROGRAMS_WORKSPACE_CARGO = env CARGO_TARGET_DIR='$(PROGRAMS_TARGET_DIR)' $(PROGRAMS_CARGO) with PROGRAMS_TARGET_DIR := $(CURDIR)/programs/target (Makefile:3053-3054), so the nested build always owns the checkout's own programs/target, which is where PROGRAMS_RUNTIME_LIB (Makefile:3055) is read from; build.rs also removes CARGO_TARGET_DIR and CARGO_BUILD_TARGET_DIR from the environment it hands to make. Evidence: qual-logs/lock-probe.log reproduces the hang and the repair on one revision - with a process holding <probe>/debug/.cargo-lock and CARGO_TARGET_DIR=<probe> exported, the parent revision's Makefile prints 'Blocking waiting for file lock on build directory' and is still blocked when its 45s budget expires (exit 137), while this revision's Makefile completes the same make build in the same environment with exit 0. qual-logs/programs-target-dir-before-after.log shows the same make -n programs-build printing bare cargo build before and the pinned env CARGO_TARGET_DIR=<checkout>/programs/target cargo build after. qual-logs/emulator-check.log records cargo check -p layerx-platform-emulator run from platform/ with CARGO_TARGET_DIR set to a scratch directory, exit 0, with no 'Blocking waiting for file lock' line, and qual-logs/emulator-check-pstree.log records the cargo -> build-script-bu -> make -> sh -> cargo subtree with the nested cargo in state R, its own CARGO_TARGET_DIR reading <checkout>/programs/target and no lock of the scratch build directory open on it, while the outer cargo holds that scratch build-directory lock. make -n build exits 0 (qual-logs/make-n-build.log) and make CC=gcc build/bin/layerx-guarantor exits 0 with the archive written to the checkout's programs/target/debug (qual-logs/make-guarantor.log)."
assumption = "PROGRAMS_CARGO keeps its ?= default and its meaning - the cargo program to run, which .github/workflows/programs-conformance.yml:83 and :97 override with a pinned toolchain - so the target-directory pin is a separate variable used only by the two programs-workspace build recipes rather than folded into PROGRAMS_CARGO. Folding it in would also force the three programs-porting-v2-references reference crates, which each declare their own [workspace], out of the porting/*/reference-v2/target directories the lint and activity steps read back. PROGRAMS_RUNTIME_LIB stays spelled relative so make programs/target/debug/liblayerx_programs_sandbox.a, which agent/crates/layerx-crypto/tests/generate-native-payments.sh:7 invokes by that exact name, still matches the rule; it names the same file as PROGRAMS_TARGET_DIR because make runs from the repository root."
severity = "note"

[observation.4.3.8901]
task = "4.3"
file = "Makefile"
symbol = "programs-interpreter-conformance programs-interpreter-bench programs-porting-v2-references"
observed = "programs-build and $(PROGRAMS_RUNTIME_LIB) are pinned to the checkout's programs/target, but the remaining programs-* recipes still honour an inherited CARGO_TARGET_DIR while reading their artifacts back from a fixed path. programs-interpreter-conformance (Makefile:3223-3225) and programs-interpreter-bench (Makefile:3229-3232) build the interpreter with $(PROGRAMS_CARGO) and then pass LAYERX_INTERPRETER_WASM=$$(pwd)/target/wasm32-unknown-unknown/release/layerx_programs_interpreter.wasm, and programs-porting-v2-references (Makefile:3237-3247) builds three reference crates and then reads porting/*/reference-v2/target/wasm32-unknown-unknown/release/*.wasm. With CARGO_TARGET_DIR exported in the environment those builds write elsewhere and the step that follows reads a path that was never produced. Not changed here: this change owns the programs-build deadlock only, and the repair for these recipes is a per-invocation --target-dir rather than one shared pin, because each reference-v2 crate is its own workspace."
assumption = "Recorded rather than repaired because the fix belongs to the interpreter and porting recipes, which are outside the two rules this change owns. No check was relaxed and no artifact path was moved to make anything pass."
severity = "suspect"
[observation.4.2.5300]
task = "4.2"
file = "platform/release/registries.kvx platform/docs/content/beta.md"
symbol = "image_registry ghcr"
observed = "Container images are release artifacts but could not be added as an eighth entry of release.registries. tools/ci/beta-contract-check.sh compares the Ecosystem column of the Artifact set table in platform/docs/content/beta.md against release.registries for equality in both directions, and platform/docs/content/beta.md is outside this lane's owned paths, so an eighth registry id would fail the contract check on a document the lane may not edit. The declaration is therefore a separate namespace: release.image_registries lists the image registry ids and [image_registry.ghcr] carries ecosystem, artifact, distribution ghcr.io/sidiora-labs, signing, provenance, sbom, verification, platforms and the seventeen beta image names taken from platform/hosted/tests/beta-images.sh. platform/release/src/main.rs validates that namespace beside the package registries, layerx-platform-release --plan emits one image_registry line after the seven registry lines, and beta-contract-check.sh checks the image registry entry and the manifest images list against it without touching the Artifact set table."
assumption = "The Artifact set table of the beta contract is the SDK package ecosystem set and stays that way; the container image set is a second artifact class that the manifest carries and the contract check enforces separately. A follow-up owning platform/docs/content/beta.md can add an image table and point the contract check at it without changing the schema."
severity = "note"

[observation.4.2.5301]
task = "4.2"
file = "platform/release/src/main.rs"
symbol = "release_pipeline_verify verified_images"
observed = "layerx-platform-release -- verify re-fetches package bytes from each registry and hashes them against the manifest digest, but it does not re-fetch image bytes. An OCI image is content addressed by its registry manifest digest, so the binding verify enforces for an image is the digest pin itself: the manifest entry must carry repository equal to the declared distribution plus the image name, reference equal to repository@digest, a well formed sha256 digest, a non empty tag, platform, signature, SBOM and attestation reference with sha256 digests for the SBOM and the attestation, the published and pull_check flags, and a source_revision equal to the manifest revision. A reference moved off its digest, an unpublished image, a failed pull check or a foreign revision halts the release before promotion in the same message as a failing package artifact. Retained image SBOM and attestation files are hashed and compared with the recorded digests at emission time, where the bytes are present in the publication bundle."
assumption = "Digest pinning plus a signature and attestation reference is the correct verification for a content addressed registry: fetching the bytes again could only confirm what the digest already states, and cosign and the registry are not available to the verifier on this path."
severity = "note"

[observation.4.2.5302]
task = "4.2"
file = "platform/docs/content/beta.md"
symbol = "artifact_manifest prose"
observed = "The beta contract prose that describes the artifact manifest states it lists every published artifact with its name, version, registry, digest, signature, SBOM and attestation references, registry location, source revision and rollback identity, and describes -- verify as fetching every artifact from its registry. After this change the manifest also carries an images list with the image name, tag, digest, platform, repository, digest pinned reference, signature, SBOM and attestation references and their digests, and -- verify reports images on a second summary line without fetching their bytes. The prose is unchanged because platform/docs/content/beta.md is outside this lane's owned paths; the contract check enforces the new image fields regardless of what the prose says, so the two do not contradict, the prose is only silent about images."
assumption = "Prose that is silent about a second artifact class is stale rather than wrong; the owner of the beta contract document extends the manifest paragraph and adds an image table when the image publication workflow lands."
severity = "note"

[observation.4.2.5303]
task = "4.2"
file = "platform/release/src/main.rs platform/docs/content/beta.md"
symbol = "ArtifactManifest images layerx/artifact-manifest/1"
observed = "images is a required field of the artifact manifest and parse_artifact_manifest refuses a manifest whose images list is empty, but the schema identifier stays layerx/artifact-manifest/1. No manifest has been emitted yet: platform/release/artifact-manifest.json does not exist in the tree and platform/docs/content/beta.md line 180 carries artifact_manifest_status = not_emitted, so the added field invalidates no committed or published document and there is no consumer pinned to the earlier shape of schema 1."
assumption = "A schema identifier may gain a required field while no document of that schema has been emitted; the first emitted manifest defines schema 1 in full. Once platform/release/artifact-manifest.json is committed with the first tagged release, any further required field needs layerx/artifact-manifest/2 and a migration for the committed document."
severity = "note"

[observation.6.5.5100]
task = "6.5"
file = "platform/hosted/identity/src/store.rs platform/hosted/identity/src/main.rs"
symbol = "Principal StoredSession Store::principal Store::subject_tenant create_principal create_session lookup_session"
observed = "POST /v1/principals required, validated and echoed a tenant but the store dropped it: Principal held only the subject and the principal map was keyed by the subject alone, so provisioning the same subject under a second tenant silently replaced the first tenant's signer key set, account and audiences. Principal and StoredSession now carry the tenant, the principal map is tenant then subject, and the store keeps a subject to tenant binding that refuses any principal whose subject is already bound to a different tenant; the service answers that refusal with 409 subject_tenant_conflict rather than overwriting. Sessions are minted only for a principal of the resolved tenant, the stored session records that tenant, and introspection resolves the principal as (session tenant, session subject), so a session can never be answered with another tenant's principal. The snapshot, the journal records and the replay path all carry the tenant, and replay refuses a journal or snapshot that binds one subject to two tenants or that keys a principal under a tenant other than its own."
assumption = "A subject is globally unique across tenants because the gateway mints it as a tenant-domain-separated hash of the signer key (platform/hosted/gateway/src/rpc_register.rs subject), so refusing the second tenant's claim is stricter than keying alone and removes the ambiguity that sub-only introspection would otherwise carry."
severity = "note"

[observation.6.5.5101]
task = "6.5"
file = "platform/hosted/identity/src/store.rs"
symbol = "Snapshot State::restore Store::open"
observed = "The on-disk snapshot shape changed from principals keyed by subject to principals keyed by tenant then subject, and Principal now requires a tenant field under serde deny_unknown_fields. An identity state directory written by the previous build therefore fails to deserialize and Store::open returns an error, which main propagates so layerx-identity exits 2 at startup instead of coming up with a partial view. There is no automatic upgrade because the old records carry no tenant to migrate to."
assumption = "Refusing to start on an unreadable store is correct for a principal service; an existing beta identity state directory has to be re-provisioned rather than upgraded, which the disposable beta deployment allows."
severity = "note"

[observation.6.5.5102]
task = "6.5"
file = "platform/hosted/identity/src/main.rs platform/hosted/tests/beta-cluster.sh platform/hosted/gateway/tests/local/lifecycle.rs"
symbol = "SessionRequest create_session identity_provision"
observed = "POST /v1/sessions takes an optional tenant. When it is present the tenant is validated and the session is refused with 404 principal_not_found unless the subject is bound to exactly that tenant; when it is absent the tenant is resolved from the store's subject binding and recorded on the session. The field is optional because platform/hosted/tests/beta-cluster.sh:1443 and platform/hosted/gateway/tests/local/lifecycle.rs:188 mint sessions with a subject only and neither file is an owned path of this lane; making the field mandatory would refuse both callers."
assumption = "Resolving the tenant from a subject that the store binds to exactly one tenant is exact rather than a fallback, so the recorded tenant is the same either way. Once those two callers send the tenant the field can be made mandatory."
severity = "note"

[observation.6.5.5103]
task = "6.5"
file = "platform/hosted/identity/tests/service.rs platform/hosted/identity/src/store.rs"
symbol = "principal_tenant_is_required_bounded_and_echoed cross_tenant_state_on_disk_is_refused"
observed = "principal_tenant_is_required_bounded_and_echoed created one subject under two different tenants and asserted 200 for both, which is exactly the replacement the row requires to be refused. Its two accepted cases now use distinct subjects, so the tenant name bounds and the echoed response it was written to prove are still asserted unchanged, and the case it used to cover incidentally is now asserted explicitly: a second tenant claiming a bound subject answers 409 subject_tenant_conflict. The new store test cross_tenant_state_on_disk_is_refused first failed because a store that has never been reopened holds its principals in the journal and not in the snapshot, so overwriting the journal erased the record the conflict was supposed to collide with; the test now covers a conflict inside one journal, a journal that claims a subject the snapshot bound elsewhere, a session naming a principal of another tenant, a snapshot keyed under the wrong tenant, a snapshot holding one subject under two tenants, and a principal with no tenant at all."
assumption = "An assertion that a behaviour is permitted has to move when the behaviour becomes a refusal; the replacement asserts the refusal rather than dropping the case, and everything the original test proved about tenant validation is still proved."
severity = "note"

[observation.6.5.5104]
task = "6.5"
file = "platform/hosted/identity/src/main.rs"
symbol = "GatewayShape DeveloperShape SubjectShape RampShape introspection_shape"
observed = "The four introspection shapes are unchanged and still identify a session by its subject alone, with no tenant field, so platform/hosted/gateway, platform/hosted/webhooks, dashboard, faucet, testnet and the ramp consumer are unaffected by this change. That remains sound only because the store refuses to bind one subject to two tenants. If that binding is ever relaxed so that a subject may exist in more than one tenant, every one of these shapes has to carry the tenant, otherwise a consumer cannot tell two tenants' principals apart."
assumption = "Not widening a response shape that six services parse is the smaller change; the constraint that makes it safe is recorded here so relaxing the binding cannot silently reintroduce cross-tenant confusion."
severity = "note"

[observation.2.2.2200]
task = "2.2"
file = "src/ledger/lxp_apply.c src/ledger/lxp_journal.c src/state/lxp_authority.c"
symbol = "allowance_check lxp_allowance_charge_leg lxp_authority_check_debit lxp_authority_charge_debit allowance_required"
observed = "The transfer transition now charges a resolved grant per debit leg before the balance moves, which is the row default. The binding is checked inside lxp_precondition_check at src/ledger/lxp_apply.c:306 through allowance_check at :154, which reads the scope without touching it: lxp_authority_check_debit at src/state/lxp_authority.c:518 rolls the period on a copy and runs lxp_authority_spend_check against that copy. The mutation is a separate entry, lxp_allowance_charge_leg at src/ledger/lxp_apply.c:174, called once per leg from lxp_apply_transfer at :417 and from lxp_apply_transfer_set at src/ledger/lxp_journal.c:243, immediately before lxp_balance_apply_leg. Splitting check from charge is what keeps lxp_precondition_check callable by everything that reads it as a pure predicate while the single-leg and transfer-set paths each charge exactly once. Refusals are typed by the authority domain and are terminal-rejection applicable: LXP_ERR_AUTH_ALLOWANCE for a delegated debit that presents no grant, LXP_ERR_AUTH_SCOPE for a module outside the grant mask or a kind that does not match the presented grant, LXP_ERR_ASSET_MISMATCH for an asset the grant does not meter, LXP_ERR_UNAUTHORIZED_DEBIT when the debited account is not the grantor, and LXP_ERR_GRANT_EXHAUSTED for a per-activity, lifetime or period cap. lxp_authority_charge_allowance at src/state/lxp_authority.c:465 remains atomic on a copy, so an exhausted draw leaves the scope byte-identical."
assumption = "Charging per debit leg before the balance mutation is the row default. The check stays where every caller already runs it and the charge is a separate exported entry so no caller can perform the mutation twice for one leg; the declaration lives in the private src/ledger/lxp_ledger_internal.h rather than the public include/layerx/lxp_transfer.h so a module object cannot reach it, matching the placement of lxp_balance_restore_snapshot and lxp_sequence_terminal_check."
severity = "note"

[observation.2.2.2201]
task = "2.2"
file = "cmd/layerxd/lxp_daemon_process.c"
symbol = "lxp_authority_resolve_activity lxp_authority_grant lxp_transfer_context allowance"
observed = "The daemon resolves every activity's grant into a stack local and discards it: lxp_authority_grant grant at cmd/layerxd/lxp_daemon_process.c:1128 and :2907 and lxp_authority_grant grants[] at :3326, filled by lxp_authority_resolve_activity at :1185, :2957 and :3438. None of the three sites hands the resolved scope to the ledger through lxp_transfer_context.allowance, and none writes a charged scope back to the tag-5 governance grant record that lxp_authority_grant_lookup reads at src/state/lxp_authority.c:334. The ledger now charges whatever grant a caller presents and the transfer set restores it on rollback, but until a caller both presents the resolved scope and persists it after the transition commits, a delegated draw that the ledger charged would be invisible to the next activity and the lifetime cap would never advance."
assumption = "Presenting the resolved scope and persisting it belongs to the daemon and module wiring rows, not to the ledger transition. The ledger side is written so the caller keeps ownership: lxp_transfer_allowance holds a pointer to the caller's live scope, so a caller that resolves a grant, executes and then writes the same scope back to the grant record needs no new state."
severity = "blocker"

[observation.2.2.2202]
task = "2.2"
file = "src/protocol/lxp_module_ctx.c src/network/lxp_gateway_send.c"
symbol = "restore_transfer_snapshots lxp_module_ctx_rollback lxp_journal_open lxp_journal_rollback"
observed = "Two outer unwind paths restore balances only. restore_transfer_snapshots at src/protocol/lxp_module_ctx.c:990, reached from lxp_module_ctx_rollback at :1007, replays lxp_module_account_snapshot entries that carry balance, asset id and next sequence and nothing else. The gateway opens its own journal at src/network/lxp_gateway_send.c:519 and rolls it back at :83; lxp_journal_open zeroes the journal, so that outer journal carries no allowance and its rollback restores none. An inner transfer set that charged a grant and committed would therefore keep the charge if either outer path later unwound the balances. The inner rollback is complete: lxp_balance_restore_snapshot at src/ledger/lxp_apply.c:369 restores the pre-charge scope before it restores any account, so a set that fails at any leg leaves the scope exactly as it was."
assumption = "Both files are outside this row's owned paths. Extending either unwind to carry the allowance means giving the module context snapshot and the gateway transaction the same three journal fields the ledger journal now carries, not new state."
severity = "suspect"

[observation.2.2.2203]
task = "2.2"
file = "src/modules/budget/lx_budget_spend.c src/modules/budget/lx_budget_close.c src/ledger/lxp_apply.c"
symbol = "lx_budget_spend_prepare lx_budget_record spent_this_period allowance_required"
observed = "The Budget module meters its own record rather than an lxp_authority_scope: lx_budget_spend_prepare charges lx_budget_record before it emits the set and then sets set.context.debit_authority_kind = LXP_AUTH_BUDGET_ALLOWANCE at src/modules/budget/lx_budget_spend.c:119, and lx_budget_close.c:55 does the same for the defund path. Both reach the ledger through the module context, which stamps origin_module_id with the emitting module id, so allowance_required at src/ledger/lxp_apply.c:125 admits a budget authorization with no grant scope only when the origin is LXP_MODULE_BUDGET. Every other origin presenting LXP_AUTH_BUDGET_ALLOWANCE, and every origin presenting LXP_AUTH_DELEGATED_CAPABILITY, must hand the ledger a chargeable scope. The carve-out is explicit and commented rather than a silent fallback, because the alternative is either double-metering the budget record or leaving the delegated kind unmetered."
assumption = "Two independent meters for one budget draw would disagree, so the ledger defers to the module that already charged. If the Budget module is later moved onto a persisted authority grant, the carve-out is the single line to delete."
severity = "note"

[observation.2.2.2204]
task = "2.2"
file = "src/ledger/lxp_send.c src/ledger/lxp_receive.c"
symbol = "lxp_send_execute lxp_receive_execute debit_authority_kind origin_module_id"
observed = "The send and receive paths take the debit authorization kind straight from the decoded activity and leave origin_module_id zero: src/ledger/lxp_send.c:349-350 assigns context.debit_authority_kind from send->authorization.kind, which the decoder admits anywhere in LXP_AUTH_OWNER..LXP_AUTH_PROTOCOL_MODULE at :253-254, and src/ledger/lxp_receive.c:456-457 does the same for receive->receiver_authorization.kind. A submission declaring LXP_AUTH_DELEGATED_CAPABILITY therefore used to debit with no allowance consulted at all. It is now refused with LXP_ERR_AUTH_ALLOWANCE unless the caller presents the grant, which closes the declared-kind bypass but does not yet make a delegated send work: that needs the send path to resolve the grant for the declared kind and bind it to the context."
assumption = "Both files are owned by another row, so the refusal is enforced in the ledger and the resolve-and-present wiring is recorded rather than written here. No production caller sets LXP_AUTH_DELEGATED_CAPABILITY today, so the refusal changes no passing path: make CC=gcc test is green."
severity = "note"

[observation.2.2.2205]
task = "2.2"
file = "include/layerx/lxp_transfer.h src/ledger/lxp_ledger_internal.h src/ledger/lxp_journal.c"
symbol = "lxp_transfer_allowance lxp_transfer_context lxp_ledger_journal lxp_allowance_charge_leg"
observed = "Three files outside the row's listed owned paths were touched, all minimally. include/layerx/lxp_transfer.h gains the lxp_transfer_allowance descriptor at :48-52, the lxp_transfer_context.allowance pointer at :74 and the three lxp_ledger_journal fields at :96-98; the transfer context and the journal are both defined there, so the fields cannot live anywhere else. src/ledger/lxp_ledger_internal.h gains the lxp_allowance_charge_leg declaration. src/ledger/lxp_journal.c gains one line, the charge call at :243 inside the transfer-set leg loop. The allowance is a pointer member so a const lxp_transfer_context * still reaches a mutable scope, which is what lets lxp_precondition_check keep its const signature."
assumption = "No other row owns include/layerx/lxp_transfer.h or src/ledger/lxp_ledger_internal.h. The one line in src/ledger/lxp_journal.c is inside the leg loop the sequence row already reworked and merged, so the two changes do not overlap."
severity = "note"

[observation.3.7.8500]
task = "3.7"
file = "Makefile platform/hosted/human/test_provision.py platform/hosted/human/test_owner_request.py"
symbol = "human-test-hosted-provisioning HUMAN_TARGET_DIR LAYERX_HUMAN_IDENTITY_PROVIDER_BIN identity_provider_binary"
observed = "Observation 3.7.5003 recorded three hosted Human provisioning tests failing because nothing in the tree built human/target/debug/layerx-human-identity-provider before pytest ran. Makefile:2069-2080 now declares human-test-hosted-provisioning: it refuses when the invoking python3 lacks cryptography, pytest or PyYAML, builds -p layerx-human-identity-provider from human/Cargo.toml with --locked into $(HUMAN_TARGET_DIR)/debug, asserts the binary is executable and runs python3 -m pytest platform/hosted/human -q with LAYERX_HUMAN_IDENTITY_PROVIDER_BIN set to that path. human-test (Makefile:2064) takes the target as a prerequisite, so the suite is reached from the aggregate Human test target and from workspace-test (Makefile:2972). HUMAN_TARGET_DIR is CARGO_TARGET_DIR when the environment exports one and $(CURDIR)/human/target otherwise: with no CARGO_TARGET_DIR the recipe prints --target-dir <checkout>/human/target and hands the tests <checkout>/human/target/debug/layerx-human-identity-provider (qual-logs/human-target-default.log). test_provision.identity_provider_binary is the single discovery point, imported by test_owner_request, and raises FileNotFoundError naming the missing path and the target instead of skipping. Evidence: make human-test-hosted-provisioning exits 0 with 39 passed (qual-logs/human-test-hosted-provisioning.log); the same suite with LAYERX_HUMAN_IDENTITY_PROVIDER_BIN pointing at an absent file exits 1 with those three tests failed, 36 passed and none skipped (qual-logs/provider-absent-refusal.log)."
assumption = "The target lives in the root Makefile beside the other human-* recipes rather than in platform/Makefile.inc because the binary is built from the human workspace and human/ has no make entry of its own. No assertion was relaxed and no test was skipped, renamed or deleted; the three tests still drive the real provider binary."
severity = "note"

[observation.3.7.8501]
task = "3.7"
file = "human/Cargo.lock"
symbol = "human-build human-test human-test-unit layerx-human-identity-provider"
observed = "human/Cargo.lock does not describe the human workspace dependency graph at b01a0d6df. With the tree own lock at that revision, cargo build --manifest-path human/Cargo.toml --locked -p layerx-human-identity-provider exits 101 with the message that the lock file needs to be updated but --locked was passed (qual-logs/human-lock-stale.log, qual-logs/human-lock-stale.exit). Every human recipe passes --locked - human-build at Makefile:2058-2062, human-test at Makefile:2064-2067, human-test-unit at Makefile:2081 - so each of them fails before compiling anything. Resolving once without --locked is purely additive: it adds tungstenite 0.30.0, pulled in by the layerx-sdk path dependency that layerx-explorer-index carries, the path crate layerx-program-sdk from programs/sdk/rust, and ten transitive crates beside versions already locked - block-buffer 0.12.1, chacha20 0.10.2, const-oid 0.10.2, cpufeatures 0.3.1, crypto-common 0.2.2, digest 0.11.3, hybrid-array 0.4.15, rand 0.10.2, rand_core 0.10.1 and sha1 0.11.0 - while removing no package and replacing no locked version (qual-logs/human-lock-repair.log). The repaired lock is committed here because the gate of this change builds from that workspace."
assumption = "The committed lock is the one cargo itself writes for the manifests at this revision, produced twice with identical bytes; cargo update was not run, no generate-lockfile was used and no existing version moved."
severity = "note"

[observation.3.7.8502]
task = "3.7"
file = "human/crates/layerx-human-service/src/custody/provider.rs agent/crates/layerx-crypto/src/disclosure.rs"
symbol = "AmountRole SupplyCap PerDrawMaximum GrantAllowance PROVIDER_MAGIC"
observed = "With the lock repaired the human workspace still does not compile at b01a0d6df: rustc reports E0004 at human/crates/layerx-human-service/src/custody/provider.rs:968, non-exhaustive patterns AmountRole::SupplyCap, AmountRole::PerDrawMaximum and AmountRole::GrantAllowance not covered (qual-logs/human-lock-repair.log). The three variants were added to agent/crates/layerx-crypto/src/disclosure.rs:64-75 by commit 61f591217 and the custody provider request encoder, which mirrors the canonical transport encoder of that crate field for field, was not extended with them. layerx-human-identity-provider depends on layerx-human-service, so nothing in the human workspace builds and neither human-build nor human-test can reach a compiler. The match now carries the tags the canonical encoder assigns to the same structure, SupplyCap 3, PerDrawMaximum 4 and GrantAllowance 5 at agent/crates/layerx-crypto/src/disclosure.rs:922-926, and the provider binary then builds with --locked (qual-logs/human-provider-build.log, exit 0)."
assumption = "The file lies outside the declared paths of this change and the three-line hunk was taken because every gate here builds through it; the tag values are read from the canonical encoder rather than chosen, and nothing else in the file is touched. The LXKP provider wire has no counterpart in the repository - PROVIDER_MAGIC occurs only in this encoder and its decoder, the LXSP magic in server/production_auth.rs:37 being an unrelated wire - and no test pins the encoded request bytes, so the three tags remain unproven against the external signer; a test that pins this encoding belongs with the owner of the custody provider contract."
severity = "suspect"

[observation.3.7.8503]
task = "3.7"
file = "docs/wiki/Human-Owner-Registration.md docs/wiki/HumanOwnerRegistration.md"
symbol = "recovery-guardians.json guardian_set members rotation custody"
observed = "Observation 3.7.5002 recorded that both wiki pages still described the removed per-member cluster operator label and independent flag and the old per-role seed file layout. Both pages now describe what the tools implement: enrollment by a separate guardians.py enroll process into the mode-0700 custody directory <secrets>/human-guardians/<role>-e<epoch> that holds nothing but the mode-0600 32-byte seed (platform/hosted/human/guardians.py:15-53); the binding signature over LX:HUMAN:GUARDIAN:BINDING:v1 plus NUL, epoch u16be, role-length u16be, role, identity32 and public-key32 (platform/hosted/human/owner_native.py:155-158); the assemble process that verifies every signature and publishes recovery-guardians.json, recovery-guardian-bindings.json and recovery-policy.json without opening a custody directory (guardians.py:114-128); the authorize process that signs LX:HUMAN:GUARDIAN:ROTATION:v1 from the outgoing custody seed (guardians.py:57-83, owner_native.py:160-162); the document fields version, threshold, public_keys and the signed members, each member carrying role, identity, public_key, epoch, custody, signature and rotation with rotation null at epoch one and otherwise the preceding member document and its rotation signature (owner_native.py:200-218); and what guardian_set re-verifies before the native producer uses any key - distinct roles, operator identities, public keys and custody directories, a custody directory named <role>-e<epoch> under human-guardians, a public_keys manifest equal to the sorted verified member keys, a document threshold equal to the recovery policy threshold and a version equal to the highest member epoch (owner_native.py:185-241), with the epoch bound 64 of GUARDIAN_EPOCH_MAXIMUM (owner_native.py:18). Both pages keep the recovery commitment definition unchanged and state that three provisioning processes with disjoint custody directories on one host are not independent operators and that independent operation remains a production onboarding requirement."
assumption = "The duplicated pair is kept as it is: docs/wiki/HumanOwnerRegistration.md carries the encoding reference and links docs/wiki/Human-Owner-Registration.md for the provisioning narrative, and each page was corrected in place rather than merged, because the split predates this change."
severity = "note"

[observation.3.7.8504]
task = "3.7"
file = "platform/hosted/tests/beta-cluster.sh"
symbol = "layerx-human-guardian-guarantor-1 human-guardians seed epoch"
observed = "The guardian documentation now describes rotation to later epochs, and the cluster path that publishes guardian seeds reads a fixed epoch. platform/hosted/tests/beta-cluster.sh:1870-1873 creates Secret layerx-human-guardian-<role> from $SECRETS_DIR/human-guardians/<role>-e1/seed for each of guarantor-1, guarantor-2 and sequencer, while the ConfigMap layerx-human-guardian-bindings it applies next (beta-cluster.sh:1874-1875) carries whatever recovery-guardian-bindings.json assemble produced. A guardian rotated to epoch two would therefore publish its retired epoch-one seed beside a bindings document naming the successor key. Nothing in the tree rotates a beta guardian today: beta-cluster.sh:1862-1868 enrols each role once and never calls guardians.py authorize, so no deployed cluster is affected."
assumption = "Recorded rather than repaired: beta-cluster.sh is outside the paths of this change, and the repair is to resolve the active epoch from the enrollment evidence the same way guardians.py active_epoch does rather than to pin e1 in the shell."
severity = "note"

[observation.3.6.9200]
task = "3.6"
file = "platform/hosted/gateway/deployment.yaml"
symbol = "LAYERX_GATEWAY_IDENTITY_PROVISIONING_TOKEN_FILE identity-provisioning"
observed = "Observation 6.5.4200 recorded that lx_register cannot reach POST /v1/principals on the cluster because that route is admitted only for the provisioning service token (platform/hosted/identity/src/main.rs:874-879) and the gateway pod held only its own gateway-scoped token. The gateway Deployment now sets LAYERX_GATEWAY_IDENTITY_PROVISIONING_TOKEN_FILE to /run/layerx/identity-provisioning/token (platform/hosted/gateway/deployment.yaml:85), mounts /run/layerx/identity-provisioning read only (line 114) and projects exactly one key of the existing Secret layerx-identity-service-tokens into it, items key provisioning path token (line 127). The projection is deliberate: the Secret also carries the gateway, webhooks, dashboard, faucet, testnet and ramp tokens (platform/hosted/tests/beta-cluster.sh:556-564) and a whole-Secret mount would hand every one of them to the gateway pod. The token itself is still generated by bring-up and reaches the pod only as a mounted file; no token value appears in any manifest."
assumption = "The provisioning token stays the credential that admits principal creation, and the gateway is the one public surface that creates principals, so projecting that single key into the gateway pod is the smallest mount that makes lx_register answer on the cluster. Observation 3.6.9201 records the capability that comes with the token."
severity = "note"

[observation.3.6.9201]
task = "3.6"
file = "platform/hosted/identity/src/main.rs platform/hosted/gateway/deployment.yaml"
symbol = "Service::Provisioning create_session create_principal"
observed = "The identity service gates two routes on the same provisioning token: POST /v1/principals (platform/hosted/identity/src/main.rs:874-879) and POST /v1/sessions (lines 880-885), and refuses introspection for that caller (lines 868-873). create_session mints a bearer session for a named subject, so the token is not scoped to principal creation. Mounting the provisioning key into the gateway pod to make lx_register answer therefore also gives the gateway process a credential that can mint a session for any subject the identity store holds, including principals the gateway did not create. The gateway code never calls /v1/sessions (platform/hosted/gateway/src/rpc_register.rs deliberately mints no session), so the capability is unused, but it is present in the pod's filesystem and a gateway compromise would reach it. The narrow repair is a seventh identity service role that admits POST /v1/principals and refuses POST /v1/sessions, mounted here in place of provisioning; that is a change to platform/hosted/identity, which is outside this row's owned paths."
assumption = "Wiring the token as the row and observation 6.5.4200 require is correct for making the shipped onboarding path work, and the resulting capability is recorded rather than silently accepted. Splitting the provisioning role belongs to the owner of the identity service; until then the gateway pod holds a session-minting credential it does not use."
severity = "blocker"

[observation.3.6.9202]
task = "3.6"
file = "platform/hosted/gateway/deployment.yaml platform/hosted/testnet/deployment.yaml platform/hosted/tests/beta-cluster.sh"
symbol = "LAYERX_GATEWAY_FAUCET_URL LAYERX_GATEWAY_FAUCET_SERVICE_TOKEN_FILE LAYERX_FAUCET_SERVICE_CLAIM_TOKEN_FILE layerx-gateway-faucet-client"
observed = "Observation 3.6.4301 recorded that neither end of the lx_requestFunds proxy was configured, so the gateway answered -32001 faucet_not_configured and the faucet answered 404 not_found for POST /v1/faucet/service-claims. Both ends are now wired around one shared Secret, layerx-gateway-faucet-client, holding the single key token, which mirrors layerx-gateway-component-client: bring-up writes the value once (platform/hosted/tests/beta-cluster.sh:521) and applies it once (line 790), and the two pods that need it mount the same Secret. The gateway sets LAYERX_GATEWAY_FAUCET_URL to https://layerx-faucet-public.layerx-testnet.svc.cluster.local:443 and LAYERX_GATEWAY_FAUCET_SERVICE_TOKEN_FILE to /run/layerx/faucet/token (platform/hosted/gateway/deployment.yaml:86-87), mounting the Secret read only at /run/layerx/faucet (lines 115 and 128). The faucet sets LAYERX_FAUCET_SERVICE_CLAIM_TOKEN_FILE to /run/layerx/gateway-faucet/token (platform/hosted/testnet/deployment.yaml:147), mounting the same Secret read only at /run/layerx/gateway-faucet (lines 168 and 175). The hostname is the one the faucet server certificate carries: bring-up issues it for DNS:layerx-faucet-public.layerx-testnet.svc.cluster.local among others (platform/hosted/tests/beta-cluster.sh:395-396), and the gateway verifies the upstream against LAYERX_GATEWAY_OUTBOUND_CA_DER, so any other spelling of the Service name would fail the handshake. Port 443 is the port Service layerx-faucet-public declares, targetPort https, which is container port 9443 of the faucet pod. Policy on both ends admits the edge: a new gateway egress rule to app=layerx-faucet on TCP 9443 (platform/hosted/gateway/deployment.yaml:191-192) and a new layerx-faucet-public-ingress rule from app=layerx-gateway on TCP 9443 (platform/hosted/testnet/deployment.yaml:310-311). The ingress rule is explicit rather than relying on the 0.0.0.0/0 rule beside it, so the gateway keeps reaching the faucet if the public CIDR rule is ever narrowed. No token value is written into a manifest; both ends read the file."
assumption = "One Secret shared by the caller and the callee is the pattern already in the tree for a service token (layerx-gateway-component-client is mounted by the gateway, the pending core and the agent boundary), so the faucet service claim token follows it rather than introducing a second shape. The public faucet route POST /v1/faucet/claims is untouched."
severity = "note"

[observation.3.6.9203]
task = "3.6"
file = "platform/hosted/tests/topology-regressions.py"
symbol = "RESOLVED_EDGES"
observed = "LAYERX_GATEWAY_FAUCET_URL adds one resolved edge to the hosted topology, so it is named in RESOLVED_EDGES (platform/hosted/tests/topology-regressions.py:31) rather than absorbed by a count, as the named-edge regression from observation 3.6.7500 requires. The edge is Deployment layerx-testnet/layerx-gateway -> layerx-faucet-public.layerx-testnet.svc.cluster.local:443 [env LAYERX_GATEWAY_FAUCET_URL]. Its authority: the variable is declared by the gateway itself at platform/hosted/gateway/src/rpc_faucet.rs:8 and is the URL lx_requestFunds proxies to, the Deployment declares it at platform/hosted/gateway/deployment.yaml:86, Service layerx-faucet-public is declared in the same manifest set at platform/hosted/testnet/deployment.yaml:177-184 and exposes port 443 with targetPort https, which is container port 9443 of the layerx-faucet pod, the callee side is admitted by the layerx-faucet-public-ingress rule for app=layerx-gateway and the caller side by the layerx-gateway egress rule for app=layerx-faucet, and the gateway egress policy already admits DNS. The checker reports the edge ok on both parsers and the regression's named() refuses it if it ever disappears or changes host, port or variable."
assumption = "An edge is approved by name with the manifest, code and policy lines that authorise it; the count the regression asserts stays len() of the named tuple."
severity = "note"

[observation.3.7.9204]
task = "3.7"
file = "platform/hosted/tests/beta-cluster.sh"
symbol = "secrets_generate secrets_apply layerx-gateway-faucet-client"
observed = "The gateway-to-faucet service token is provisioned the way every other hosted service token is: write_token generates 32 random bytes as lowercase hex with umask 077 into $SECRETS_DIR/gateway-faucet.token (platform/hosted/tests/beta-cluster.sh:342-345 and 521) and secrets_apply creates Secret layerx-gateway-faucet-client from that file under the key token (line 790). Nothing is hard coded and nothing is echoed. The applied-cluster proof of this wiring did not run: kind and kubectl are absent on this workstation, so beta-cluster.sh up cannot execute and no pod was ever scheduled with the new mounts. What did run is the manifest evidence: make platform-hosted-topology-check, which parses all nine manifests with both parsers, resolves the new edge and checks it against NetworkPolicy on both ends, python3 platform/hosted/tests/topology-regressions.py for the named-edge sets and the nine mutation refusals, bash -n on beta-cluster.sh, and a parse of both edited manifests with PyYAML and with the checker's own builtin parser confirming the projected volume, the two mounts and the three variables are the values the services read."
assumption = "Manifest-level proof is the strongest evidence obtainable without a cluster; the first bring-up on real infrastructure is the remaining step and is stated as not run rather than implied."
severity = "note"

[observation.3.6.9205]
task = "3.6"
file = "docs/wiki/HostedFaucet.md"
symbol = "LAYERX_FAUCET_SERVICE_CLAIM_TOKEN_FILE environment table"
observed = "docs/wiki/HostedFaucet.md:297 documents LAYERX_FAUCET_SERVICE_CLAIM_TOKEN_FILE and ends the row with the sentence that the Deployment does not set this key. platform/hosted/testnet/deployment.yaml:147 now sets it, so that sentence is stale. docs/wiki is outside this row's owned paths, so the line was not edited here; the request is recorded in this lane's NEEDS.md. The two rows above and below it, for LAYERX_FAUCET_WINDOW_SECONDS and LAYERX_FAUCET_CLAIM_AMOUNT, carry the same sentence and remain correct."
assumption = "A documentation row that describes a manifest is corrected by the owner of that page rather than by a manifest row reaching outside its paths; the contradiction is recorded so the page and the manifest are not left silently disagreeing."
severity = "note"

[observation.3.6.9206]
task = "3.6"
file = "platform/hosted/faucet/src/main.rs platform/hosted/testnet/deployment.yaml"
symbol = "admit_network preflight LAYERX_FAUCET_NETWORK_REQUEST_LIMIT"
observed = "The faucet admits every claim route, the service route included, through admit_network, whose Redis key is derived from the peer address alone (platform/hosted/faucet/src/main.rs:642-648, called from preflight at line 935). Service claims arrive from gateway pods, so the whole public lx_requestFunds path shares one bucket per gateway pod address rather than per end user. At the values the manifest sets, LAYERX_FAUCET_NETWORK_REQUEST_LIMIT 60 in LAYERX_FAUCET_NETWORK_REQUEST_WINDOW_SECONDS 60 (platform/hosted/testnet/deployment.yaml:156-157) against the gateway's own thirty claims a minute per process (platform/hosted/gateway/src/rpc_faucet.rs:12), the gateway limit binds first for a single gateway process, but the gateway Deployment runs three replicas behind one Service and the faucet runs three replicas, so which bucket binds depends on how the Service spreads connections. The per-principal and per-DID quotas are unaffected: the service route keys the identity window on the caller-supplied principal and only the network bucket is scoped service:<principal> (platform/hosted/faucet/src/main.rs:955-957 and 997-1007)."
assumption = "Peer-address network admission is the faucet's existing shape and was not changed here; the note records that a proxied claim path makes that bucket per gateway pod rather than per client, so the two limits should be chosen together if the faucet is ever exposed to a larger public."
severity = "note"

[observation.3.7.9400]
task = "3.7"
file = "include/layerx/lxp_fee.h src/protocol/lxp_fee.c cmd/layerxd/lxp_daemon_lni.c tests/support/lxgb_metadata.rs tests/support/lxgb_metadata.py agent/crates/layerx-client/src/payments.rs docs/wiki/Assets.md docs/wiki/Modules.md platform/hosted/gateway/openrpc.json"
symbol = "LXP_ASSET_FEE_PRICE_COUNT LXP_FEE_PARAMS_V1_BYTES LXP_FEE_PARAMS_V2_BYTES asset_ordinals lxp_asset_fee_name lxp_fee_params_encode lxp_fee_params_decode lxp_fee_schedule send_fee_estimate"
observed = "Observation 3.7.2701 is closed. The version 2 asset price table is widened from eight entries to ten: asset_ordinals in src/protocol/lxp_fee.c reads 1, 2, 3, 4, 5, 6, 7, 8, 10 and 11 and lxp_asset_fee_name gains fee.asset.pause and fee.asset.unpause in ordinal position, so lxp_fee_schedule resolves both through the same lxp_gov_param_enact call the other eight prices use and lxp_fee_compute adds the resolved price to base_fee alongside the per encoded byte, per execution unit and per storage unit components metered for every other asset ordinal. Neither ordinal is given a constant, a zero or a borrowed price in the code, and an absent named parameter still fails the whole schedule with the parameter bounds refusal rather than pricing the ordinal at zero. The canonical fee parameter encoding is consensus visible and grows from 215 to 247 bytes, with the price count at offset 86 reading 10 and the ten prices at 87 plus 16i. The two canonical lengths are named LXP_FEE_PARAMS_V1_BYTES and LXP_FEE_PARAMS_V2_BYTES in include/layerx/lxp_fee.h and every site that repeated the literals now derives from them: the encoder and decoder in src/protocol/lxp_fee.c, the fee estimate response buffer in cmd/layerxd/lxp_daemon_lni.c, the shared LXGB metadata generators for Rust and Python in tests/support, the hosted gateway local harness and the layerx-client fee estimate reader, which also checks the price count byte. A version 2 schedule encoded at the old 215 byte length no longer decodes: lxp_fee_params_decode refuses the length as non canonical, so any persisted governance fee.schedule value and any genesis metadata artifact carrying a version 2 schedule has to be rebuilt from the current generators before a node will read it."
assumption = "The encoded length is reachable from the daemon response buffer, the two shared LXGB metadata generators, the hosted gateway local harness and the layerx-client reader, and all of those were moved onto the named constants in the same revision, because a partial move would leave a node that cannot parse its own fee estimate response. Two statements outside src/protocol were made false by the widening and were corrected with it: the version 2 pricing sentence in docs/wiki/Modules.md and the priced asset ordinal list in the lx_estimateFee description of platform/hosted/gateway/openrpc.json. Nothing else in either file was touched, and the cluster registry ordinal lists in the gateway harness and README, which advertise admission rather than pricing, were left as written."
severity = "note"

[observation.3.7.9401]
task = "3.7"
file = "src/protocol/lxp_receipt.c tests/protocol/lxp_test_receipts.c"
symbol = "lxp_receipt_validate_supply lxp_ctx_bind_asset_supply supply_binding_version"
observed = "Observation 3.7.2702 asked whether asset ordinals 2 and 3 belong in the operation allow list of lxp_receipt_validate_supply. Supply binding version 1 promises exactly one thing about a receipt: on an asset module receipt whose result code is LXP_OK and whose asset is non zero, the receipt carries total_units_before and total_units_after, and the validator recomputes the total the operation implies and answers LXP_FATAL_SUPPLY_MISMATCH when the receipt disagrees. Operation 10 implies before plus amount, operation 11 implies before minus amount, operation 1 implies zero before and zero after, and operations 4, 5, 6, 7 and 8 imply the total is unchanged. Pause and unpause move no units, so the total they imply is the unchanged one, and the decision recorded here is that they join that group rather than remain outside the list. With them absent the validator answered LXP_ERR_NON_CANONICAL, the answer reserved for an operation the binding version cannot describe, and it made a binding impossible to construct for two operations whose supply effect is exactly known; admitting them adds a real equality check instead of removing one, and lxp_ctx_bind_asset_supply can now build its probe receipt for them. tests/protocol/lxp_test_receipts.c walks operations 2, 3, 4, 5, 6, 7 and 8, requires LXP_OK when the two totals are equal and LXP_FATAL_SUPPLY_MISMATCH when they differ, and keeps the refusals for operation 9 and for a receipt whose module is not the asset module."
assumption = "The operation allow list is consensus visible receipt structure, because lxp_receipt_encode validates the supply binding before it writes any bytes, so widening it changes which receipts encode at all. The promise of binding version 1 is read off the validator itself, since no document in the tree states the operation set. Reserved ordinal 9 stays refused and no other arm of the switch was touched."
severity = "note"

[observation.3.7.9402]
task = "3.7"
file = "src/modules/asset/lx_asset_registry.c"
symbol = "module_execute lxp_ctx_bind_asset_supply"
observed = "With operations 2 and 3 admitted by lxp_receipt_validate_supply a pause or unpause receipt can now carry a supply binding, but none does. module_execute in src/modules/asset/lx_asset_registry.c returns module_execute_impl directly when value->ordinal is 2 or 3, before the switch that resolves the asset id and before the asset_load pair, so lxp_ctx_bind_asset_supply is never reached on that path and the receipt keeps supply_binding_version 0. Every other executed asset ordinal loads the record before and after execution and binds the pair. A verifier that expects every asset receipt to carry a binding still finds none on these two, which is the second half of what observation 3.7.2702 reported."
assumption = "The asset module is outside the paths this row owns, which name src/protocol/lxp_receipt.c for the allow list only, so the early return was left exactly as written and is recorded here instead. The repair is to give ordinals 2 and 3 the asset id from their typed pause payload in the same switch the other ordinals use and let module_execute fall through to the bind call; the totals are unchanged across both transitions, so the binding is the equality case the validator now accepts."
severity = "suspect"

[observation.3.7.9403]
task = "3.7"
file = "tests/test_genesis_manifest.c src/modules/asset/lx_asset_registry.c"
symbol = "check_version lxp_kernel_module_for_activity activity_types LX_ASSET_WITHDRAW"
observed = "make CC=gcc test-genesis exits 2 on a tree whose only changes are the fee price table, the receipt supply allow list and their tests and fixtures. test_genesis_manifest prints genesis line 203: lxp_kernel_module_for_activity(&kernel, ((uint32_t)LXP_MODULE_ASSET << 16U) | 9U, kernel.epoch, &entry) != LXP_OK and then genesis line 301: check_version(LXP_PROTOCOL_VERSION_STATE_COMMITMENT) == 0. The assertion at tests/test_genesis_manifest.c line 202 requires asset ordinal 9 to be unresolvable on a state commitment genesis, and activity_types in src/modules/asset/lx_asset_registry.c line 11 advertises LX_ASSET_WITHDRAW, so the kernel resolves ordinal 9 and the refusal the test requires does not happen. Neither file is touched by this change: git diff --name-only over this branch lists only the fee, receipt, fixture, harness and documentation paths, and both files are byte identical to the branch base. The same test also enumerates the ordinals it requires resolvable as 1, 4, 6, 7, 8, 10 and 11 and asserts nothing about 2 and 3, so the widened price table and the widened supply allow list do not reach it. This is the genesis side of the withdraw dispatch gap observation 3.7.2700 reports from the execution side."
assumption = "Recorded rather than repaired: the asset module activity table and the genesis manifest test are outside the paths this row owns, and the two sides disagree about whether ordinal 9 is a declared asset activity. Whichever way it is settled, one of them has to change, and neither was touched here. make CC=gcc test-genesis is not a gate this row requires and is not reachable from the aggregate make test target."
severity = "blocker"

[observation.3.7.9404]
task = "3.7"
file = "Makefile"
symbol = "test core-test-all test-wave-12 test-fees test-receipts test-asset-registry test-genesis"
observed = "The aggregate test target does not run the fee, receipt, asset registry or genesis tests. Its prerequisite list spans Makefile lines 269 to 286 with two later additions at line 1366 and line 3502, and none of them names test-fees, test-receipts, test-asset-registry or test-genesis. test-fees is reached only through test-wave-12 at Makefile line 1100 and test-receipts, test-asset-registry and test-genesis only through core-test-all at Makefile line 2925, which also pulls test-wave-12. So make CC=gcc test can exit 0 while the three tests that cover the asset fee schedule, the receipt supply binding and the asset registry have not been built or run, and the genesis manifest failure recorded above is invisible to it. All four were run individually here: test-fees, test-receipts and test-asset-registry exit 0 and test-genesis exits 2."
assumption = "Recorded rather than repaired because the aggregate target's prerequisite list is shared by every native lane and adding four targets to it changes what every other lane's aggregate gate runs. The repair is to fold the fee, receipt, asset registry and genesis targets into the aggregate list, which requires the genesis failure above to be settled first."
severity = "note"

[observation.3.1.7900]
task = "3.1"
file = "src/ledger/lxp_send_store.c include/layerx/lxp_ledger.h src/ledger/lxp_send.c src/ledger/lxp_receive.c"
symbol = "lxp_send_store_admit lxp_send_history lxp_send_store_lookup"
observed = "Closes observation 3.1.3602. The sixty-fifth distinct idempotency key no longer refuses on any ledger path. lxp_send_execute and lxp_receive_execute now delegate duplicate detection and admission to a shared ledger-level store in src/ledger/lxp_send_store.c: lxp_send_store_lookup (line 106) reads the fixed window and then the overflow history, and lxp_send_store_admit (line 137) spills the whole window into that history and empties it when the window is full, exactly where the LXP_ERR_ARENA_EXHAUSTED refusal used to sit (src/ledger/lxp_send.c:326, src/ledger/lxp_receive.c:410). The history is a sorted, dynamically grown array of lxp_send_store_record behind a stable lxp_send_history pointer, and the spill is atomic and metered: it counts the window records the history does not already hold, grows the history to fit them, charges that count times LXP_SEND_HISTORY_RECORD_BYTES of storage against the store's meter through lxp_meter_charge_storage in one call, and only then inserts, so a refused charge leaves window and history exactly as they were and lxp_send_store_total never counts a record twice, so the only remaining bound is the storage ceiling of the execution's meter and the allocator. A store that carries no meter cannot spill at all: lxp_send_store_admit returns LXP_ERR_ARENA_EXHAUSTED at src/ledger/lxp_send_store.c:147 when store->meter is NULL, which is the exact refusal the fixed array used to raise, so an unbudgeted caller keeps its old bound rather than gaining unmetered growth. No production caller reaches that refusal on this revision: both gateway paths drain their window into key/value state before delegating, and src/modules/asset/lx_asset_execution.h:348 runs a single receive against a freshly allocated store. LXP_SEND_HISTORY_RECORD_BYTES is 161 at include/layerx/lxp_ledger.h:78: 32 idempotency-key bytes plus 32 activity-hash bytes plus the 97-byte canonical projection the gateway already meters as LXP_GATEWAY_KV_PROJECTION_BYTES (src/network/lxp_gateway_internal.h:12), so a ledger key and a gateway key cost the same. Replay semantics are byte-identical for every receipt an unspilled window can hold: the window is scanned first, in its original order and with its original activity-hash-before-key precedence, and a key found in the history returns LXP_ERR_SEQUENCE_REUSED for a matching activity hash and LXP_ERR_IDEMPOTENT_REPLAY with the stored projection and replayed set otherwise. A keyed binary search over the history is outcome-identical to the old linear scan because an activity hash covers the encoded send including its idempotency key and each key appears at most once across window and history, which is the same equivalence lxp_gateway_idempotency_precheck already relies on. tests/ledger/test_send.c and tests/ledger/test_receive.c drive 67 and 66 distinct keys through the ledger entry points with no gateway, and assert the spilled counts, the metered byte total, the reuse and replay outcomes for a spilled record and the gas refusal when the storage ceiling is one byte short of the spill, which leaves the history empty and the window intact. A third block drives sixty-five sends through a store with no meter and pins the old refusal. Evidence: qual-logs/ledger-tests.log, qual-logs/make-test.log."
assumption = "History is bounded only by gas and storage metering, per the issue default; where there is no meter there is no budget, so there is no growth. The fixed sixty-four-entry array survives as the write-through window because three gateway files still index it directly; it is no longer a refusal bound on any path."
severity = "note"

[observation.3.1.7901]
task = "3.1"
file = "src/network/lxp_gateway_kv.c src/network/lxp_gateway_send.c src/network/lxp_gateway_receive.c include/layerx/lxp_ledger.h"
symbol = "lxp_gateway_window_reserve send_transaction_abort gateway_receive_claim_locked LXP_SEND_STORE_CAPACITY"
observed = "The fixed lxp_send_store.records array at include/layerx/lxp_ledger.h:177 could not be deleted outright because three gateway files read and write it directly: lxp_gateway_kv.c:764-771 copies the whole store by value and clears the array with sizeof(store->records), lxp_gateway_send.c:97-100 and :546 index records by position to undo an aborted settlement, and lxp_gateway_receive.c:73-75 and :395 do the same for a claim. Those files are outside this issue's owned paths, so the array stays as the write-through window and the new overflow history hangs off a stable pointer added after count, which keeps the gateway's by-value copies and its abort restore correct: growth happens behind the pointer, and history insertion is idempotent for an identical record so restoring a stale window cannot corrupt it. The gateway drains its own window into metered key/value state before delegating, so the ledger spill is unreachable from the gateway and no gateway behaviour changes. Once those three files move to lxp_send_store_lookup, lxp_send_store_admit, lxp_send_store_append and lxp_send_store_total the array and LXP_SEND_STORE_CAPACITY can be retired and the two histories collapsed into one. Evidence: qual-logs/gateway-tests.log, exit 0 for test-gateway-send, test-gateway-receive and test-gateway-kv unchanged."
assumption = "The gateway key/value history and the ledger history are two implementations of the same contract on this revision; unifying them is a gateway-owned change."
severity = "note"

[observation.3.1.7902]
task = "3.1"
file = "include/layerx/lxp_ledger.h tests/network/test_gateway_kv.c platform/sdk/conformance/fixtures/generate_receipt_fixture.c"
symbol = "lxp_send_environment lxp_receive_environment meter"
observed = "The meter the history charges against is reached through lxp_send_store.meter rather than through a new field on lxp_send_environment or lxp_receive_environment. Both environments are built by positional compound literals in six places, of which tests/network/test_gateway_kv.c:137 and platform/sdk/conformance/fixtures/generate_receipt_fixture.c:137 are outside this issue's owned paths, and the native build refuses a new trailing field at every one of them under -Werror=missing-field-initializers. The store, by contrast, is always produced by memset, calloc or lxp_send_store_init, so carrying the meter there adds no initialiser site. This is a placement decision, not a semantic one: the meter charged is the same execution meter in both shapes, and lxp_send_store_init takes it explicitly."
assumption = "A struct field appended to a widely initialised aggregate is a cross-lane change under the repository's warning settings, so the field was placed on the type that no caller initialises positionally."
severity = "note"

[observation.3.1.7903]
task = "3.1"
file = "interop/deploy/mirror/Dockerfile agent/crates/layerx-types/build.rs interop/Cargo.toml"
symbol = "COPY include build script LXP_RESULT_CODE_LIST"
observed = "agent/crates/layerx-types now carries a build script that reads include/layerx/lxp_result.h and fails the build when the normative LXP_RESULT_CODE_LIST table and the Rust protocol_result_codes! mirror in src/result.rs disagree by name, value or position. interop/deploy/mirror/Dockerfile builds layerx-mirror, which depends on layerx-types (interop/Cargo.toml:25), from a context that copies agent, human and interop (lines 6-8) but not include, so that image build cannot find the header and the build script panics. Every other consumer already has the header in its context: the Makefile builds from the repository root, the agent workspace resolves it three levels above the crate, and platform/hosted/human/Dockerfile copies the whole tree. The one-line fix is COPY include ./include next to line 6. The Dockerfile is outside this issue's owned paths and no silent fallback was added to the build script, because a parity gate that skips itself when it cannot see the table is not a gate."
assumption = "The header is the normative table and the mirror follows it, so the check must be unconditional; making the image build see the header is a deployment-owned change."
severity = "blocker"

[observation.3.1.7904]
task = "3.1"
file = "agent/crates/layerx-types/src/result.rs include/layerx/lxp_result.h"
symbol = "protocol_result_codes SequenceExhausted ProgramRefused"
observed = "The new parity gate found the Rust mirror missing two codes the C table declares, not one. LXP_ERR_SEQUENCE_EXHAUSTED at -307 (include/layerx/lxp_result.h:74) is the code the hand-off named, and LXP_ERR_PROGRAM_REFUSED at -736 (include/layerx/lxp_result.h:137) had drifted out of the mirror earlier and independently. Both were added at agent/crates/layerx-types/src/result.rs:124 and :187, in table order, with the retriability the C table's terminal ranges imply. No other entry differed by name, value or position, so the mirror and the table are now identical and the build script enforces it on every compilation of the crate."
assumption = "The C table is normative for both the wire values and their order; the Rust mirror is a follower and was corrected to match rather than the table being adjusted."
severity = "note"

[observation.3.1.7905]
task = "3.1"
file = "src/modules/asset/lx_asset_execution.h"
symbol = "free store idempotency"
observed = "The asset module callocs an lxp_send_store for a single lxp_receive_execute and releases it with a bare free at src/modules/asset/lx_asset_execution.h:327 and :351. That is correct on this revision because a one-record window never reaches the spill in lxp_send_store_admit and so never allocates an overflow history, but it becomes a leak the moment that path admits more than one receive against the same store. lxp_send_store_release exists for exactly this and frees the history and the records array before clearing the struct. The file is owned by other work in flight and was not touched."
assumption = "The single-receive shape of that call site holds on this revision, so the bare free is latent rather than an active leak."
severity = "note"
[observation.4.1.9800]
task = "4.1"
file = "interop/deploy/mirror/Dockerfile interop/crates/layerx-interop-service/Cargo.toml agent/crates/layerx-proof/Cargo.toml agent/crates/layerx-types/build.rs platform/hosted/tests/beta-cluster.sh"
symbol = "COPY build context layerx-mirror"
observed = "The mirror image declared a partial build context: COPY agent, COPY human and COPY interop at former interop/deploy/mirror/Dockerfile lines 6-8. Three roots its build reads sat outside it, and only one of them is the header the layerx-types build script added. cargo loads every workspace member manifest before it compiles anything, so cargo build --manifest-path interop/Cargo.toml -p layerx-mirror first fails on interop/crates/layerx-interop-service/Cargo.toml:18, whose path dependency layerx-platform-gateway resolves to platform/hosted/gateway, then on layerx-proof's path dependency layerx-programs-runtime under programs/crates, and only then reaches the build script that reads include/layerx/lxp_result.h; the platform omission therefore predates the parity gate. The Dockerfile now uses COPY . ., the form the other sixteen image Dockerfiles and platform/ramps/Dockerfile use, so the build stage receives the whole tracked tree that beta-cluster.sh build_context packs at line 204. Proof without a registry write: for every Dockerfile named in platform/hosted/tests/beta-images.sh plus interop/deploy/mirror and platform/ramps, every COPY source that reads the context resolves inside the tracked tree; cargo metadata --no-deps loads every workspace member of every manifest each Dockerfile builds from that context layout; the real layerx-types build script, compiled with rustc and run with CARGO_MANIFEST_DIR pointing into the layout, reads the header and the result-code parity holds; the former three-root context is shown to refuse both of those checks and to carry no include/layerx/lxp_result.h; and docker build --check reports no warnings on all nineteen Dockerfiles. No repository check compares a Dockerfile COPY source against the context the image is built from, so a partial context stays silent until the image is built."
assumption = "The build context of an image Dockerfile in this repository is the whole tracked tree, which is what beta-cluster.sh packs and what every other image Dockerfile already copies, so naming individual roots is the deviation rather than the rule."
severity = "note"

[observation.4.1.9801]
task = "4.1"
file = "interop/Cargo.lock agent/crates/layerx-sdk/Cargo.toml interop/deploy/mirror/Dockerfile .github/workflows/mirror-live.yml"
symbol = "cargo build --locked layerx-sdk tungstenite"
observed = "With the build context repaired the mirror image still cannot build from a clean checkout, for a reason outside this issue: interop/Cargo.lock no longer matches the manifests it locks. agent/crates/layerx-sdk/Cargo.toml:20 requires tungstenite =0.30.0 with the native-tls feature, layerx-sdk enters the interop workspace graph through the layerx-intents path dependency at interop/Cargo.toml:31, and the interop lock's layerx-sdk entry at interop/Cargo.lock:848-860 lists no tungstenite. cargo metadata --manifest-path interop/Cargo.toml --locked exits 101 with the lock file needs to be updated, both with the crates.io index reachable and offline. Without --locked the resolver adds fourteen packages (tungstenite, sha1 0.11.0, digest 0.11.3, block-buffer 0.12.1, crypto-common 0.2.2, hybrid-array 0.4.15, rand 0.10.2, rand_core 0.10.1, chacha20 0.10.2, cpufeatures 0.3.1, const-oid 0.10.2, data-encoding 2.11.1, thiserror 2.0.20, thiserror-impl 2.0.20) and introduces second major versions of crypto-common, digest, cpufeatures, chacha20 and rand beside the ones already locked. Both RUN lines of interop/deploy/mirror/Dockerfile pass --locked, as do .github/workflows/mirror-live.yml:29, .github/workflows/mirror-verification-live.yml:26 and the two commands interop/README.md:64-65 documents, so every one of them refuses on this revision. agent/Cargo.lock, human/Cargo.lock and platform/Cargo.lock all resolve under --locked without change; interop is the only stale workspace lock."
assumption = "The lock is the stale side rather than the manifest: the SDK requirement is carried by every other workspace lock, and the duplicate major versions a plain regeneration introduces have to be judged against the workspace dependency bans by the owner of that lock."
severity = "blocker"

[observation.4.1.9802]
task = "4.1"
file = "platform/hosted/tests/beta-images.sh platform/release/registries.kvx interop/deploy/mirror/kubernetes.yaml tools/ci/beta-contract-check.sh"
symbol = "IMAGE_NAMES image_registry.ghcr images"
observed = "layerx-mirror is built by a Dockerfile in this repository but is in no published image set: platform/hosted/tests/beta-images.sh:3-4 names seventeen images and platform/release/registries.kvx:90 declares the same seventeen under [image_registry.ghcr]. The entry was deliberately left unadded on this change because both consequences fall outside this issue's owned paths. tools/ci/beta-contract-check.sh:927-946 and its manifest image check require the declared list and the release manifest to name the same images, so an eighteenth name in beta-images.sh alone would put the two lists into disagreement. And beta-cluster.sh build_images at line 214 builds every name in IMAGE_NAMES before publish-images.sh is reached, so adding a name that cannot build (observation 4.1.9801) would stop the publication of the seventeen that can. The entry to add once the interop lock resolves is layerx-mirror in IMAGE_NAMES with 'ghcr.io/sidiora-labs/layerx-mirror:0.1.0 interop/deploy/mirror/Dockerfile' in image_source, and the same name in the registries.kvx image list. interop/deploy/mirror/kubernetes.yaml:22 separately pins ghcr.io/layerx/layerx-mirror-publisher@sha256:REPLACE_WITH_PINNED_DIGEST, which is neither the canonical ghcr.io/sidiora-labs organisation, nor the image name the Dockerfile would publish under, nor a real digest."
assumption = "An image is published only when the image table, the release registry declaration and the manifest agree, so a single-file addition would be a false claim of publication rather than a partial one."
severity = "blocker"

[observation.4.1.9803]
task = "4.1"
file = "platform/hosted/tests/publish-images.sh platform/hosted/tests/beta-cluster.sh"
symbol = "mode_check read_inventory preflight_disk"
observed = "publish-images.sh --check exits 1 with missing regular image inventory build/beta-cluster/images on a checkout whose images have not been built: read_inventory at line 132 requires a local inventory naming every beta image and a docker image inspect that resolves each recorded ID, and only beta-cluster.sh images writes that file. No image was built and none was pushed here: free space on the build filesystem stayed between 10 and 18 GiB against the 24 GiB default LAYERX_BETA_MIN_FREE_GIB that beta-cluster.sh preflight_disk at line 165 requires, so the seventeen table images and the mirror image were all left unbuilt, and the COPY-source, workspace-manifest, build-script and docker build --check proofs recorded in observation 4.1.9800 stand in their place. bash -n on publish-images.sh and beta-images.sh, the check the publish workflow gate job runs, exits 0."
assumption = "An inventory of images that were not built cannot be fabricated for the check, so the publisher's inventory path stays unexercised on this revision and only the parse and context layer is established."
severity = "note"


[observation.6.1.8700]
task = "6.1"
file = "tests/support/lxgb_metadata.py tests/support/lxgb_metadata.rs src/modules/asset/lx_asset_registry.c src/modules/asset/lx_asset_custody.c cmd/layerx-genesis/lxp_genesis_build_cli.c"
symbol = "metadata append custody_reference issuer_valid lx_asset_record_decode"
observed = "The shared LXGB v2 genesis metadata fixture pair now emits the only asset record shape the genesis builder accepts, and the two emitters stay byte-identical. tests/support/lxgb_metadata.py:23-24 and tests/support/lxgb_metadata.rs:21-33 build the version 3 record with custody kind 2, a custody reference of 32 bytes and issuer kind 2, so issuer_valid at src/modules/asset/lx_asset_registry.c:561-572 holds on both counts it previously failed: custody_kind equals issuer_kind and the reference is non-empty when issuer kind is 2. The reference is twelve zero bytes followed by the low twenty bytes of the asset identifier, which is the vault-address layout tests/daemon/owner_checkpoint.py:72 builds for a real custody record and the length src/modules/asset/lx_asset_custody.c:236 requires, and both emitters refuse an all-zero reference. Neither issuer_valid nor the refusal of issuer kind 1 in genesis metadata at cmd/layerx-genesis/lxp_genesis_build_cli.c:204 was touched; the fixture moved to the rule. Decoding the emitted bytes through lx_asset_record_decode returns LXP_OK with custody_kind 2, custody_reference_length 32 and issuer_kind 2, and re-encoding the decoded record reproduces the same 186 bytes. The record grows from 154 to 186 bytes and the metadata from 407 to 439 on this revision, where the version 2 fee schedule carries the ten-entry price table at 247 bytes, which stays inside the bound 219 < metadata <= 16384 - request that platform/hosted/paxeer/prepare-beta.py:65 and tests/bridge/custody_genesis.py:49 impose, and the 219-byte truncation tests/test_lxgb_producers.py requires the builder to refuse is still refused. Both emitters pin the same 439-byte vector by length and sha256 38d5d09e3fc241bd6b6f924e4fe656f48954a61055ddec048f1eb636a72c8fe4, the python emitter through a self-check and the rust emitter through the unit test emits_the_shared_vector, and the two were compared byte for byte over eight further input triples through a driver compiled from tests/support/lxgb_metadata.rs itself. Ten consumers read the pair: tests/daemon/program-admission.sh:30, tests/daemon/pay1.py:14, tests/test_lxgb_producers.py:13 and tests/bridge/qualify_credit.py:19 on the python side; platform/hosted/core/tests/boundary.rs:4-5, platform/hosted/authority/tests/real_node.rs:4-5, platform/hosted/agent-boundary/tests/real_node.rs:4-5 and agent/crates/layerx-agentd/tests/support/real_authority.rs:2-3 include the rust side directly, and agent/qualification/pay2/build.rs:33-37 and platform/hosted/gateway/tests/local/build.rs:47-51 copy it into OUT_DIR. Evidence: qual-logs/probe-asset-record.log, qual-logs/emitter-parity.log, qual-logs/lxgb-producers.log, qual-logs/pay1-runtime.log, qual-logs/test-bridge-credit.log and qual-logs/program-admission-bootstrap.log, where the genesis the fixture feeds builds and prints the network 77 state root. This resolves observation 6.1.5801."
assumption = "The asset record contract in src/modules/asset is the authority and the fixture follows it. The custody shape is the only one left once cmd/layerx-genesis/lxp_genesis_build_cli.c:204 refuses issuer kind 1 in genesis metadata, so no choice between shapes remained. No committed fixture and no committed expected state root is produced from the emitter at test time, so nothing downstream was regenerated; every consuming harness builds genesis into a temporary directory and compares roots it computes itself."
severity = "note"

[observation.6.1.8701]
task = "6.1"
file = "tests/daemon/program-admission.sh tests/daemon/lxp_test_program_admission.c cmd/layerxd/lxp_daemon_lni.c"
symbol = "program-admission handshake LNI_MINOR LNI_VERSION_MINOR"
observed = "make test-program-admission runs end to end on this revision, exit 0. The genesis request that tests/daemon/program-admission.sh builds through the corrected metadata fixture is accepted by layerx-genesis-build, the bootstrap prints the network 77 genesis state root, the treasury account and the data and run directories, the sequencer and the replica start, and build/tests/lxp_test_program_admission completes: a malformed CALL, DEPLOY and UPGRADE are refused and a canonical deployment is acknowledged and receipted at sequence 1. The target was blocked on two independent refusals. The first was the asset record shape, which observation 6.1.5801 recorded and observation 6.1.8700 resolves. The second was the LNI version split that observation 6.1.5802 recorded, where the client pinned minor 4 against a daemon advertising minor 5; that split is aligned on this revision and the handshake at tests/daemon/lxp_test_program_admission.c:352 now accepts the version cmd/layerxd/lxp_daemon_lni.c:48 advertises. Neither version constant was touched here. Evidence: qual-logs/test-program-admission.log and qual-logs/program-admission-bootstrap.log."
assumption = "The wire version belongs with the LNI surface and its clients together, not with a test fixture, so both sides were left exactly as written and only the record shape was corrected."
severity = "note"

[observation.6.1.8702]
task = "6.1"
file = "tests/fixtures/pay1-retired-genesis.manifest tests/fixtures/pay1-retired-issuance.lxs tests/test_genesis_builder_cli.c"
symbol = "--migrate-snapshot-issuance pay1-retired-genesis.manifest"
observed = "The two committed pay1-retired fixtures are not derived from the metadata emitter and were left unchanged by the fixture correction. tests/test_genesis_builder_cli.c:139-250 is their only consumer; it feeds the retired snapshot to layerx-genesis-build --migrate-snapshot-issuance and never calls the emitter, and its assertions at lines 186-190 require the snapshot to carry the retired \":issuance\" key scheme and to carry no \"module:asset:value:\" key, so the pair cannot be regenerated by the current builder from a current snapshot. The manifest carries a \"Custody token\" record only because it is a frozen artifact of the run that produced it. Its stale expected root is already recorded on main as observation 6.11.2604 and is not affected by the emitter shape."
assumption = "A frozen migration fixture records what an earlier writer produced, so it does not follow a change to the live emitter; regenerating it needs a snapshot in the retired key scheme, which is a separate piece of work."
severity = "note"

[observation.6.1.8703]
task = "6.1"
file = "platform/hosted/agent-boundary/tests/real_node.rs platform/hosted/authority/tests/real_node.rs platform/hosted/core/tests/boundary.rs agent/crates/layerx-agentd/tests/support/real_authority.rs"
symbol = "lxgb_metadata append real_node boundary"
observed = "One of the four rust consumers of tests/support/lxgb_metadata.rs was exercised against a real node and three were not. cargo test --manifest-path platform/Cargo.toml --locked -p layerx-platform-agent-boundary --test real_node compiled platform/hosted/agent-boundary/tests/real_node.rs, which includes the emitter at lines 4-5, and ran its fifteen tests. The emitter's own vector test lxgb_metadata::tests::emits_the_shared_vector passed inside that target, as did lifecycle::native_c_lifecycle_fixtures_bind_payload_signature_and_idempotency and webhook_credential_configuration_refuses_shared_or_invalid_material. The genesis the fixture feeds was accepted: build_genesis at real_node.rs:281-328 panics if layerx-genesis-build refuses and again if paxeer-registration-request.lxrr is absent, and every one of the remaining twelve tests ran past both and failed later at real_node.rs:401 with 'sequencer exited early with exit status: 1: layerxd: bootstrap logs failed with result -904'. That stage is cmd/layerxd/lxp_daemon_process.c:5149-5181, which opens or creates five 64 MiB logs through open_log at line 3664 after the genesis manifest has been read, so it is downstream of anything the metadata record decides, and -904 is LXP_ERR_IO. On this same revision make CC=gcc test-program-admission, make CC=gcc test-program-simulate, make CC=gcc test-daemon-maintenance-publication and tests/daemon/pay1.py each bootstrapped a real layerxd sequencer and a replica through that identical stage and exited 0, while the failing run held fifteen node harnesses at once and free space on the shared build volume fell below 26G. The cause of the -904 was not established here and cmd/layerxd is outside the paths this change owns. A re-run at the rebased head was started and never obtained the shared platform build lock, and its output replaced the first run's file, so qual-logs/rust-agent-boundary.log now holds only that lock wait. The three commands not run are cargo test --manifest-path platform/Cargo.toml -p layerx-platform-authority --test real_node, the same for -p layerx-platform-core --test boundary, and cargo test --manifest-path agent/Cargo.toml -p layerx-agentd, each against the shared workspace target directory, with free space on that volume at 24G across twenty lanes."
assumption = "The emitter is shared source with a pinned cross-language vector, so parity plus the native genesis gates establish the bytes; the rust harnesses add coverage of their own service paths. The one that ran shows the corrected record is accepted by the real builder inside a rust harness and that what still stops it is a daemon log failure the native harnesses do not reproduce, which belongs to whoever owns that surface."
severity = "note"

[observation.6.1.8704]
task = "6.1"
file = "platform/hosted/core/tests/boundary.rs cmd/layerx-genesis/lxp_genesis_build_cli.c tests/support/lxgb_metadata.py"
symbol = "build_genesis genesis_request build_artifacts parse_request"
observed = "The silent refusal that observation 3.7.2704 records at platform/hosted/core/tests/boundary.rs:144 has the same cause as observation 6.1.5801 and is cleared by the record shape correction. The request build_genesis writes at boundary.rs:871-892 was reconstructed byte for byte outside the harness, with the same fixed network id, protocol version, governance parameter, single guarantor record, asset id, metering and fee schedule, and fed to build/bin/layerx-genesis-build with a signer key of its own. With the metadata suffix the fixture emitted before the correction the request is 770 bytes and the builder exits 1 with no stdout, no stderr and no output directory, which matches the syscall trace in that observation: the tool opens the request and the signer key and calls exit_group before creating any artifact. With the metadata suffix tests/support/lxgb_metadata.py emits after the correction the request is 834 bytes and the builder exits 0 and writes all four artifacts, the manifest, the snapshot, the Paxeer deployment descriptor and the registration request. platform/hosted/core/tests/boundary.rs was already one of the consumers this correction covers, through the include at boundary.rs:4-5. The silence itself is a separate defect and was not repaired here: lxp_genesis_builder_cli_main maps every non-LXP_OK result from build_artifacts to exit status 1 without printing which stage refused or which typed result it returned, so a caller sees only the status. Evidence: qual-logs/core-boundary-request.log."
assumption = "The boundary harness and the builder are owned elsewhere, so neither was edited; only the shared fixture the harness includes was corrected, and the builder's missing diagnostic is recorded rather than added because cmd/layerx-genesis is outside the paths this change owns."
severity = "note"

[observation.6.1.8705]
task = "6.1"
file = "tests/daemon/program-admission.sh tests/bridge/qualify_credit.py tests/storage/lxp_test_maintenance_publication.c"
symbol = "test-program-simulate test-daemon-maintenance-publication test-bridge-maintenance-publication lxp_genesis_materialize"
observed = "The remaining make targets that reach the corrected fixture through the two python consumers were run on this revision. make CC=gcc test-program-simulate exits 0: the simulation route returns signed evidence without publishing a receipt and the malformed CALL, DEPLOY and UPGRADE refusals still hold. make CC=gcc test-daemon-maintenance-publication exits 0: durable activity and maintenance sequences stay contiguous across a real daemon publication and six replica maintenance attachments match the retained signed headers, leaves and proofs. make CC=gcc test-bridge-maintenance-publication exits 2, and it exits 2 for the reason observation 6.11.162 already records on main and not for anything this change decides: tests/bridge/qualify_credit.py builds the genesis manifest from the corrected metadata and layerx-genesis-build accepts it, then tests/storage/lxp_test_maintenance_publication.c:541 fails lxp_genesis_materialize(manifest, &f->arena, &f->kernel) == LXP_OK because the fixture registers the programs, asset and bridge modules at lines 537 to 539 and leaves governance unregistered at index two. The failure is therefore past the point the fixture governs and its own credit sibling, make CC=gcc test-bridge-credit, exits 0 on the same qualify_credit.py path. Evidence: qual-logs/test-program-simulate.log, qual-logs/test-daemon-maintenance-publication.log and qual-logs/test-bridge-maintenance-publication.log."
assumption = "A target that fails inside a test fixture's own module registration is that fixture's defect, already recorded against its owning lane, so it is reproduced and cited here rather than repaired from a change that only owns the metadata emitter."
severity = "note"

[observation.6.1.9100]
task = "6.1"
file = "tools/ci/lni-version-parity.sh Makefile agent/schema/lni/v1.kvx"
symbol = "LNI_VERSION_MAJOR LNI_VERSION_MINOR LNI_MAJOR LNI_MINOR SCHEMA LNI_V1_SOURCE"
observed = "This settles observation 6.1.8602. The interface version the daemon implements is now tied to agent/schema/lni/v1.kvx by a check rather than by convention. tools/ci/lni-version-parity.sh reads major and minor from the schema section of that document and requires the same pair from every independent copy: the daemon enum at cmd/layerxd/lxp_daemon_lni.c:47-48, the two native client enums at tests/daemon/lxp_test_program_admission.c:50-51 and tests/test_daemon_lni_admission.c:47-48, the literal response minor the native payment client pins at tests/daemon/lxp_test_pay1.c:126, and the client crate, whose SCHEMA initialiser at agent/crates/layerx-client/src/lni/schema.rs:440 must build at the schema minor and whose Version constants must be exactly the revisions 0 through that minor, no more and no fewer. It also resolves the include_str argument at agent/crates/layerx-client/src/lni/schema.rs:4 and requires it to be the same file the check read the version from, so the crate cannot embed one document and declare another. No version value was changed anywhere; every copy already held 1.5 and the check passes on the tree. Each extraction requires exactly one declaration it can read, so reformatting a declaration out of the patterns reach fails the check loudly rather than passing silently. The target is make test-lni-version-parity and the aggregate test target depends on it, so a split fails make test with no binary built. Evidence: qual-logs/lni-version-parity.log for the tree and qual-logs/lni-version-parity-negative.log, which runs ten cases against scratch copies of the six files: the unaltered copy passes and nine deliberate divergences each exit 1, covering a daemon left one minor behind, each of the three native clients left behind, the client crate building its schema one minor behind, the client crate declaring a revision the schema has not reached, a schema bumped ahead of every implementation, a crate embedding a different document, and a daemon declaration reformatted beyond the checks reach."
assumption = "The schema document is the single source and the parity check reads it, so the check is about the implemented interface version and not about which version a peer is built for. The many Version::V1_4 call sites under platform/hosted, agent/tests and agent/crates/layerx-client/tests are deliberately out of scope: agent/crates/layerx-client/src/lni/handshake.rs:160 compares only the major component, so a peer built for an older minor is a valid peer and its pin is a coverage decision, which observation 6.1.8601 already records."
severity = "note"

[observation.6.1.9101]
task = "6.1"
file = "cmd/layerxd/lxp_daemon_lni.c tests/daemon/lxp_test_program_admission.c"
symbol = "send_asset_read send_fee_estimate typed_read_version_gate expect_typed_read"
observed = "This settles observation 6.1.8603. send_asset_read and send_fee_estimate folded their minor gate into the same condition as their payload validation and answered every request below minor 5 with LXP_ERR_NON_CANONICAL, telling a client that legitimately speaks 1.4 that its bytes were malformed rather than that the message does not exist at its version. Both now select the result the way the four version gates beside them do, with request->minor < 5U choosing LXP_ERR_VERSION_UNSUPPORTED and every other branch of the same condition keeping LXP_ERR_NON_CANONICAL, so a genuinely malformed payload at minor 5 is still refused as non-canonical. No existing assertion pinned either result, so nothing was relaxed to make this pass. typed_read_version_gate in the native admission client now pins both: against a real daemon it sends a canonical asset read and a canonical fee estimate at minor 4 and requires refusal class 1 with LXP_ERR_VERSION_UNSUPPORTED, sends each with a truncated payload at minor 5 and requires refusal class 1 with LXP_ERR_NON_CANONICAL, then sends both canonically at minor 5 and requires the typed responses, tags 33 and 35, each carrying format version 1. The minor the two messages were introduced at is named TYPED_READ_MINOR in the client so the below-version request follows the feature rather than the client pin. These two tags had no real daemon test before this; the positive half is the first. The test fails against the previous refusal code: qual-logs/test-program-admission-before-refusal-change.log stops at lxp_test_program_admission.c:452 with expect_error(descriptor, 60U, 1U, LXP_ERR_VERSION_UNSUPPORTED) == 0 and exits 2 with the daemon reverted and everything else unchanged, while qual-logs/test-program-admission.log and qual-logs/test-program-simulate.log both exit 0 with it restored."
assumption = "A version gate and a canonicality gate are different refusals, the surrounding file already distinguishes them, and the daemons typed version refusal is the truth; the wire-visible refusal code for a below-5 minor therefore changes from non-canonical to version-unsupported for these two tags only, and the payload refusal is untouched."
severity = "note"

[observation.6.1.9102]
task = "6.1"
file = "tests/support/lxgb_metadata.py platform/hosted/node/bootstrap.sh tests/daemon/program-admission.sh"
symbol = "metadata lx_asset_record_decode layerx-genesis-build"
observed = "make CC=gcc test-program-admission cannot reach a daemon on this base. The harness builds its genesis metadata from tests/support/lxgb_metadata.py, and with the shipped emitter platform/hosted/node/bootstrap.sh stops with bootstrap: layerx-genesis-build refused the genesis request before any layerxd is started, so the gate exits 2 with no client run: qual-logs/test-program-admission-shipped-fixture.log. This is the custody record shape recorded as observation 6.1.5801 and is unrelated to this change: layerx-genesis-build links cmd/layerx-genesis and build/liblayerx.a only and contains none of the files changed here. With the corrected emitter applied locally and left uncommitted, exactly as observation 6.1.8600 describes, the same gate exits 0 and the full client run completes, which is the evidence in qual-logs/test-program-admission.log and qual-logs/test-program-simulate.log. The correction is not part of this change and tests/support/lxgb_metadata.py is unmodified in it."
assumption = "The fixture emitter belongs to the change that owns tests/support, so it was borrowed for the duration of the run and reverted; recording the shipped-fixture failure beside the corrected-fixture pass keeps both facts visible rather than presenting a green gate that the shipped tree does not produce."
severity = "blocker"

[observation.6.1.9103]
task = "6.1"
file = "tests/support/lxgb_metadata.py tests/daemon/program-admission.sh cmd/layerxd/lxp_daemon_lni.c"
symbol = "metadata custody_reference typed_read_version_gate"
observed = "This supersedes the blocker in observation 6.1.9102, which is left as written. That block recorded make CC=gcc test-program-admission exiting 2 before any layerxd was started, because the shipped tests/support/lxgb_metadata.py emitted a custody record shape layerx-genesis-build refused, and it recorded the corrected emitter being applied locally and left uncommitted so the gate could run at all. The corrected emitter is now on main: tests/support/lxgb_metadata.py emits the accepted shape with a non-zero paxeer custody reference and pins its own vector. With it in the tree and nothing applied locally, the same gate exits 0 from the shipped tree at 601ac0c36249d116c6da2b09faccc5baff7a7bec, the bootstrap completes, a real layerxd serves the client, and both stages of the run report: the typed committed reads refuse a below-5 minor as unsupported, refuse a malformed payload as non-canonical and answer at minor 5, and the malformed CALL, DEPLOY and UPGRADE activities are refused while the canonical deployment is acknowledged and receipted at sequence 1. make beta-ledger-check exits 0 on the same head. Evidence: qual-logs/test-program-admission-shipped-fixture-601ac0c36.log and qual-logs/beta-ledger-check-601ac0c36.log. The version parity check and the two corrected refusal codes recorded in observations 6.1.9100 and 6.1.9101 are unchanged by this and were not re-derived; only the fixture that blocked the harness moved."
assumption = "A blocker that a later change on main resolved is superseded rather than rewritten, so 6.1.9102 keeps the state of the tree it was written against and this block records the state that replaced it. The gate is now green from the shipped tree with no local correction, so the caveat attached to the earlier evidence no longer applies to this head."
severity = "note"

[observation.6.2.4700]
task = "6.2"
file = "platform/hosted/gateway/src/ws.rs platform/hosted/gateway/openrpc.json agent/crates/layerx-sdk/src/rpc_subscription.rs agent/sdk/typescript/src/rpc-subscription.ts"
symbol = "selector resume_window resume advance command subscriptionNotification"
observed = "The WebSocket surface had no cancellation and no resume contract. platform/hosted/gateway/src/ws.rs identified a subscription by its position in a Vec, so removing one would have renumbered the survivors, and a notification carried only params.subscription and params.result, so a client that lost its connection could not state where its stream stopped; openrpc.json said as much (notifications are live, not a durable replay). lx_unsubscribe now takes the identifier issued on that connection and answers {\"result\": true}. Identifiers come from a per-connection counter (Subscriptions::next) instead of a position, so the remaining subscriptions keep their identifiers and their cursors and a released identifier is never reissued; an identifier that is not active on the connection is refused with -32602, and POST /rpc refuses lx_unsubscribe with -32004 like lx_subscribe. Every notification now carries params.cursor, the receipt-feed position at which it was delivered, as a canonical decimal string: the hub publishes (position, event) pairs so a receipt is stamped with its own global_sequence and an idle wake with the position the feed has consumed. lx_subscribe accepts that cursor as a trailing positional argument on all three topics. On resume the gateway reads chain_head_sequence, refuses a cursor above it with -32602 and a gap wider than MAX_RESUME (16) with -32005 without creating the subscription, then replays through the same notification path it uses live: every receipt event after the cursor for receipts, and the current snapshot once for checkpoints and account. Replayed frames are written after the acknowledgement and before any live frame, and advance() drops a live receipt at or below the cursor so the overlap between the replay and the running feed is never delivered twice. Both SDK decoders moved with the third params key and both gained the resume entry point (RpcClient::subscribe_from, JsonRpcClient.subscribeFrom) and a cancellation: RpcSubscription::unsubscribe drains at most 16 in-flight notifications, advancing the cursor past them, before it reads the acknowledgement, and the TypeScript generator sends lx_unsubscribe on teardown over a still-open socket and waits up to five seconds for that acknowledgement."
assumption = "The cursor is the receipt-feed position because it is the only sequence the gateway shares with every topic; checkpoint and account subscriptions therefore resume by re-reading the current snapshot once rather than by replaying per-topic history the gateway does not retain. The 16-position window matches the fan-out queue depth, so a client further behind than the gateway would have queued for it is told to reconcile through reads instead of being handed a partial replay it could mistake for a complete one. A notification without a canonical cursor is refused by both SDKs rather than defaulted, so a gateway that predates this contract is detected instead of being read as position zero."
severity = "note"

[observation.6.2.4701]
task = "6.2"
file = "platform/hosted/gateway/src/rpc.rs platform/hosted/gateway/tests/local/lifecycle.rs"
symbol = "schema_lists_every_public_method dispatch local_gateway_websocket_receipt_wake"
observed = "platform/hosted/gateway/src/rpc.rs::schema_lists_every_public_method held the number of methods in openrpc.json as a literal alongside the list of names it checks, so every change that publishes a method had to settle the same line twice and two changes collided on it here: lx_unsubscribe, and lx_requestFunds arriving at a rebase. The assertion now declares the published set once, as the published array, and compares methods.len() against published.len(); the count is therefore derived from the declared set rather than written down beside it. Because each declared name must appear exactly once and the totals must agree, the schema must publish exactly that set and nothing else, which is what the literal was there to say. lx_unsubscribe joins the set, and openrpc.json carries those 18 distinct names. platform/hosted/gateway/tests/local/lifecycle.rs::local_gateway_websocket_receipt_wake pins the acknowledgements of the first three subscriptions as \"1\", \"2\" and \"3\" and the notifications' params.subscription as \"1\" and \"3\"; the per-connection counter reproduces those identifiers exactly for a connection that never unsubscribes, and that test is untouched. It reads params.result and does not bound the size of params, so the added params.cursor does not disturb it."
assumption = "Deriving the count from the declared set is not a relaxation: an undeclared method in the schema still fails the assertion, and a declared method missing from the schema still names itself in the failure. It removes the second place a later change would have had to settle, leaving the declaration as the only one. The subscription identifier is documented as one-based and issued in order, and the counter preserves both, so no assertion of the harness had to move for the cancellation to exist."
severity = "note"

[observation.6.2.4702]
task = "6.2"
file = "docs/wiki/PublicAPI.md docs/wiki/PublicRpc.md platform/hosted/gateway/openrpc.json"
symbol = "lx_register lx_requestFunds"
observed = "The published method table in docs/wiki/PublicAPI.md carried neither lx_register nor lx_requestFunds, which platform/hosted/gateway/openrpc.json publishes and platform/hosted/gateway/src/rpc_register.rs and platform/hosted/gateway/src/rpc_faucet.rs dispatch, and its count sentence still read 15 while the schema served 18. Both rows and both count sentences were completed here, so docs/wiki/PublicAPI.md and docs/wiki/PublicRpc.md each describe the same 18 method names the schema publishes, and neither count was chosen to agree with the prose: both are the number of distinct methods in openrpc.json."
assumption = "Completing a published-surface table is part of publishing a method on that surface, so the two onboarding rows were written rather than only recorded; the counts are taken from the schema so that a later method addition contradicts the docs visibly instead of silently."
severity = "note"

[observation.6.2.4703]
task = "6.2"
file = "platform/hosted/gateway/tests/local/lifecycle.rs platform/hosted/gateway/src/ws.rs"
symbol = "local_gateway_websocket_receipt_wake"
observed = "The cancellation and the resume contract are covered by the gateway crate's own tests (selector cursors, the resume window per topic, the live-cursor rule, the cancellation parameters and the identifier release) and by the two SDK suites, all of which run without a cluster. The one gate that exercises GET /rpc/ws against a real daemon, local_gateway_websocket_receipt_wake in the standalone harness at platform/hosted/gateway/tests/local, was not run on this revision: it needs the native daemon and four platform binaries built first and a serialized target directory, and both that target directory and the platform target were held by other qualification runs throughout this work. No claim is made here about the replay or the cancellation over a real socket."
assumption = "A gate that did not run is recorded as not run rather than inferred from the unit coverage that did run. The harness assertions that touch the WebSocket path were left untouched, so the gate remains available to whichever revision runs it next."
severity = "note"

[observation.6.1.4800]
task = "6.1"
file = "cmd/layerxd platform/hosted/core/src/main.rs platform/hosted/core/src/lib.rs platform/hosted/node/deployment.yaml"
symbol = "read_secret build_send send_authorization LAYERX_CORE_TREASURY_KEY_FILE LAYERX_CORE_TREASURY_SIGNER_SOCKET"
observed = "The treasury signing client was expected in cmd/layerxd, but no file under cmd/layerxd names the treasury in any form: the daemon never holds or uses the treasury identity. The single component that signs with it is the hosted core, which reads the seed at platform/hosted/core/src/main.rs:259 through read_secret(\"LAYERX_CORE_TREASURY_KEY_FILE\") and signs 32-byte domain digests at platform/hosted/core/src/lib.rs in build_send and send_authorization. platform/hosted/core is outside this change's paths, so the bootstrap now publishes LAYERX_CORE_TREASURY_SIGNER_SOCKET into core.env alongside the existing environment and the deployment still projects the treasury material into the core boundary container, which continues to read it from a file."
assumption = "Writing a signing client into cmd/layerxd would have added an unused code path, and rewriting the core custody path would have edited a crate owned elsewhere. The signer speaks a request-per-signature protocol over a unix socket, so the remaining core change is to replace the file read at main.rs:259 with a client over LAYERX_CORE_TREASURY_SIGNER_SOCKET and drop the treasury projection from the core boundary container."
severity = "note"

[observation.6.1.4801]
task = "6.1"
file = "platform/hosted/node/bootstrap.sh contracts/config/checkpoint-settlement.json"
symbol = "GUARANTOR_COUNT GUARANTOR_ENTRIES certificate_threshold"
observed = "platform/hosted/node/bootstrap.sh:485 requires the genesis request to be exactly 395 bytes plus the metadata length, but the request it builds at lines 459 to 484 carries one 81-byte guarantor entry per guarantor and its fixed prefix is 395 + 81 * (GUARANTOR_COUNT - 1) + metadata. GUARANTOR_COUNT comes from .finality_policy.certificate_threshold of the settlement document at line 307, and contracts/config/checkpoint-settlement.json carries certificate_threshold 2, so the script builds an 851-byte request against a 770-byte expectation and refuses with 'genesis request has an unexpected length'. The same refusal reproduces from an unmodified checkout with the repository settlement document, which makes the shipped configuration unbootstrappable and takes platform/hosted/core/tests/boundary.rs, tests/daemon/pay1.py and tests/daemon/program-admission.sh with it, none of which override the document."
assumption = "The length assertion and the settlement document belong to the genesis request work, not to treasury custody, so both were left exactly as written. The treasury boundary tests in platform/hosted/node/tests/signer-test.py pass --settlement-document naming a copy of the repository document whose certificate threshold is one, which is inside the 1..32 range the script itself admits, so they exercise the real bootstrap end to end without touching either side of the conflict."
severity = "blocker"

[observation.6.1.4802]
task = "6.1"
file = "platform/hosted/node/tests/node-test.sh platform/hosted/node/tests/bootstrap-test.py platform/hosted/node/bootstrap.sh"
symbol = "platform-test-node GENESIS_METADATA"
observed = "platform/hosted/node/bootstrap.sh:211 requires --genesis-metadata to name an authoritative LXGB v2 metadata file, and neither platform/hosted/node/tests/node-test.sh at its supervisor invocation nor platform/hosted/node/tests/bootstrap-test.py:31 passes it, so both refuse before any node starts. platform/hosted/node/deployment.yaml also omits it from the layerxd arguments. This is independent of the length conflict recorded at 6.1.4801 and of the probe lock recorded at 6.1.4803; all three stand between make platform-test-node and a running node."
assumption = "Generating LXGB v2 metadata inside the shell harness and inside the manifest is genesis request work rather than treasury custody, so the tests and the manifest were left as written and the treasury boundary was covered by platform/hosted/node/tests/signer-test.py, which builds the metadata through tests/support/lxgb_metadata.py and runs the real bootstrap."
severity = "blocker"

[observation.6.1.4803]
task = "6.1"
file = "platform/hosted/node/tests/probe/Cargo.lock platform/hosted/node/tests/node-test.sh platform/Makefile.inc"
symbol = "layerx-node-probe platform-test-node"
observed = "make CC=gcc platform-test-node exits 101 at its first step: node-test.sh builds platform/hosted/node/tests/probe with --locked and cargo refuses because the lock needs updating. cargo update --offline --dry-run in that directory reports nineteen packages to relock, adding chacha20, digest, rand, sha1, thiserror and tungstenite among others, so the probe lock predates dependency changes in the path crates it borrows from agent/crates and platform/hosted/core. The bash -n step of the same target passes over bootstrap.sh, supervisor.sh and node-test.sh."
assumption = "The lock drift comes from crates outside this change and repairing it would not reach a running node while 6.1.4801 and 6.1.4802 stand, so it is recorded for the lane that moved those dependencies."
severity = "blocker"

[observation.6.1.4804]
task = "6.1"
file = "platform/hosted/registry/tests/native_deployment.rs cmd/layerxd"
symbol = "start_cluster cluster_producer_signs_built_program_for_live_treasury real_deployment_produces_verified_canonical_journal_pair"
observed = "The cluster deployment producer in platform/hosted/tests/beta-cluster.sh now asks the treasury signer for its public key and its signature instead of reading the seed, and platform/hosted/registry/tests/native_deployment.rs starts a real signer over the cluster treasury material and points the producer environment at its socket. The target compiles, but no test in it can run on this revision: start_cluster fails while spawning layerxd with 'bootstrap configuration failed with result -402'. real_deployment_produces_verified_canonical_journal_pair, which this change does not touch, fails identically, so the cluster fixture is refused before any producer code runs. A control run of the same command over origin/main 5e3417aa32df5699748f1ba69e7d104fd70884a5 copies of the six platform files this change touches, with the native binaries built from the same tree, fails on all three tests with the same result -402 at native_deployment.rs:371, so the refusal is present without any of this change."
assumption = "The daemon refuses its own bootstrap configuration in a fixture this change does not touch, and the control run over origin/main copies of the touched files reproduces the refusal, so the producer path could not be executed against a live cluster here for reasons this change does not reach. The treasury request and reply contract the producer now depends on is covered directly by platform/hosted/node/tests/signer-test.py against the same signer program."
severity = "blocker"

[observation.6.1.4805]
task = "6.1"
file = "platform/hosted/node/Dockerfile platform/hosted/node/deployment.yaml"
symbol = "treasury-signer treasury-material layerx-node-keys"
observed = "The signer container runs /opt/layerx/signer/signer.py from the node image, so platform/hosted/node/Dockerfile copies platform/hosted/node/signer into /opt/layerx/signer next to the existing checkpoint authority; without that line the container block would name a program the image does not carry. In the manifest the layerx-node-keys secret is now projected twice: the keys volume selects sequencer.key alone and the layerxd container keeps it for --sequencer-key, while a treasury-material volume selects treasury.key alone and is mounted only by the signer container and by the core boundary, which still reads the seed from a file as recorded at 6.1.4800. The daemon container therefore no longer mounts the treasury seed."
assumption = "The Dockerfile line is a deviation from the paths this change was scoped to, taken because the container block would otherwise be a manifest for a program the image does not contain. Removing the treasury projection from the core boundary as well would stop a component that has no signer client yet, so it was left mounted and recorded instead."
severity = "note"

[observation.6.1.4806]
task = "6.1"
file = "spec/layerx-beta/report.md tools/ci/beta-report.sh spec/layerx-beta/qualification.kvx"
symbol = "ledger_digest observation_records beta-report"
observed = "spec/layerx-beta/report.md is generated from the ledger and records ledger_digest as a sha256 over spec/layerx-beta/qualification.kvx together with per-severity and per-task record counts. Two branches that each append observations and regenerate the report produce different digests and different counts on the same lines, so the file cannot be content-merged: git merge-tree between this branch and main reports qualification.kvx auto-merging and spec/layerx-beta/report.md as the only conflict, and the conflict returns for every branch as soon as any other lane merges. The digest is a hash of the merged ledger, which no side of the merge holds, so no textual resolution is correct."
assumption = "The resolution is to take either side and re-run tools/ci/beta-report.sh on the merged ledger, which is what the render step does; recording the property rather than changing the generator or removing the file from the commit, both of which are outside this row."
severity = "note"

[observation.6.1.4807]
task = "6.1"
file = "tests/support/lxgb_metadata.py tests/support/lxgb_metadata.rs src/modules/asset/lx_asset_registry.c cmd/layerx-genesis/lxp_genesis_build_cli.c"
symbol = "metadata issuer_valid lx_asset_record_decode parse_request"
observed = "issuer_valid at src/modules/asset/lx_asset_registry.c:561 now requires custody_kind to equal issuer_kind and requires a non-empty custody reference when issuer_kind is 2, and lx_asset_record_decode calls it. The shared genesis metadata fixture tests/support/lxgb_metadata.py and its Rust twin tests/support/lxgb_metadata.rs still emit custody_kind 1 with issuer_kind 2 and a zero-length custody reference, so lx_asset_record_decode refuses the record with LXP_ERR_NON_CANONICAL, parse_request in cmd/layerx-genesis/lxp_genesis_build_cli.c returns -3, and layerx-genesis-build refuses every request built from that fixture. The refusal is not specific to this change: origin/main 9b7ebfa3aa copy of platform/hosted/node/bootstrap.sh, run unmodified against the same fixture and the same native binaries, fails identically at the same step, and an instrumented copy of the builder reports after parse_request=-3. parse_request also refuses issuer_kind 1 outright, so raising custody_kind to 2 and giving the record a non-empty custody reference is the only shape both the ledger invariant and the genesis path admit; with that record origin/main bootstrap.sh completes and prints its genesis state root. Eleven consumers read this fixture, among them platform/hosted/core/tests/boundary.rs, platform/hosted/agent-boundary/tests/real_node.rs, platform/hosted/authority/tests/real_node.rs, agent/crates/layerx-agentd/tests/support/real_authority.rs, tests/daemon/pay1.py and platform/hosted/node/tests/signer-test.py, whose two bootstrap cases fail on this and this alone."
assumption = "The fixture is shared repository test support rather than treasury custody, and correcting it moves the genesis asset record and therefore the genesis state root for every consumer that pins one, which cannot be qualified from this row. Both sides were left exactly as written: the ledger invariant that introduced the requirement and the fixture that no longer satisfies it. The twelve signer and provider cases in platform/hosted/node/tests/signer-test.py that do not build a genesis request continue to pass."
severity = "blocker"

[observation.6.1.4808]
task = "6.1"
file = "platform/hosted/node/tests/probe/Cargo.lock agent/crates/layerx-client/Cargo.toml platform/hosted/node/tests/node-test.sh platform/Makefile.inc"
symbol = "layerx-node-probe layerx-client node-test"
observed = "agent/crates/layerx-client/Cargo.toml:13 declares sha2 = \"=0.10.9\", but the checked-in lock of the standalone probe workspace, platform/hosted/node/tests/probe/Cargo.lock:644, still records layerx-client with the five dependencies layerx-crypto, layerx-proof, layerx-types, layerx-wire and rustls and no sha2. platform/hosted/node/tests/node-test.sh:36 builds that probe with --locked --offline, so cargo refuses with \"the lock file needs to be updated but --locked was passed\" before any node behaviour runs, and the platform-test-node target at platform/Makefile.inc:141 fails at its first probe step with exit 101. The probe is a private workspace outside the platform and agent workspaces, so nothing in the ordinary workspace gates updates its lock when a path dependency gains a crate."
assumption = "The probe lock belongs to the node test harness rather than to the treasury signer boundary, and refreshing a Cargo.lock outside the crates this row owns is not this row's change; the failure precedes every node-test assertion, so it hides rather than reports node behaviour."
severity = "blocker"

[observation.6.1.4809]
