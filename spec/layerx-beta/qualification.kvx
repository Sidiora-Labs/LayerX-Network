[observation.6.11.156]
task = "6.11"
file = "src/protocol/lxp_genesis.c tests/bridge/test_credit.c tests/bridge/qualify_credit.py platform/hosted/agent-boundary/tests/real_node/lifecycle.rs"
symbol = "lxp_genesis_materialize LXP_MODULE_GOVERNANCE test-credit"
observed = "The four-package platform test run exits 101 with three agent-boundary lifecycle failures, each reporting that build/tests/bridge/test-credit failed with credit check failed at line 194 on lxp_genesis_materialize. 06c54ca48 requires the kernel handed to lxp_genesis_materialize to hold four modules with governance at index two whenever the manifest carries a bridge profile, but tests/bridge/test_credit.c registers programs, asset and bridge only. Both files are byte-identical to 0717c87ca and to f89cb11c0. make test-bridge-credit, whose whole path is byte-identical to 0717c87ca and never touches this branch's custody harness, reproduces the same refusal, so the failure is independent of the harness the lifecycle tests use. The bridge credit target is not reachable from the make test target, so the condition is not observed there. The reason is the module set and not the manifest: a copy of the test built outside the tree with one added registration of the governance module, and nothing else changed, completes the whole credit qualification against the same retained artifacts. The refusal also holds for any manifest, because the materializer requires governance at index two whenever the protocol version is the state commitment version and requires a single module otherwise, while this kernel always holds programs, asset and bridge. Evidence: qual-logs/rebase-205-8.log, qual-logs/bridge-credit-probe.log and qual-logs/credit-retained-probe.log."
assumption = "tests/bridge/test_credit.c now registers the governance module between the asset and the bridge module, in the same order and through the same interface as the fresh-genesis path of 06c54ca48 in src/protocol/lxp_genesis.c, tests/test_genesis_manifest.c and the daemon, completing that contract change for the last caller left behind; the repair is recorded in 1e818156a108a46587d85405df58ea0d6820ad7c. The materializer, its module requirement, the manifest, the credit inputs and every credit assertion are unchanged. make CC=gcc test-bridge-credit then passes all nine credit checks and the three agent-boundary lifecycle tests pass. The custody producer these tests spawn additionally imports Crypto.Hash from pycryptodome, which the interpreter on the default path does not provide; that is a local prerequisite and is supplied by the interpreter recorded in the gate commands, not by any change in the tree."
severity = "blocker"

[observation.6.11.157]
task = "6.11"
