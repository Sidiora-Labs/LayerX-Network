[observation.6.11.159]
task = "6.11"
file = "platform/hosted/gateway/tests/local/verifier.rs agent/crates/layerx-wire/src/hash.rs cmd/layerxd/lxp_daemon_batch_wal.c cmd/layerxd/lxp_daemon_lni.c cmd/layerx-guarantor/runtime.c"
symbol = "local_gateway_lifecycle receipt_execution_batch_id execution_batch_id lxp_daemon_batch_bind_prefix"
observed = "With the fixture adapter repaired and the principal tenant supplied, local_gateway_lifecycle passes provisioning and fails in the verifier the lifecycle script runs: verifier.rs:116 requires the batch identifier recomputed from the committed receipt to equal the identifier the daemon bound, and the two 32-byte values differ. platform/hosted/gateway/tests/local/verifier.rs and platform/hosted/gateway/tests/lifecycle-boundary.sh are byte-identical to 0717c87ca and to f89cb11c0. cmd/layerxd/lxp_daemon_batch_wal.c, its header and cmd/layerx-guarantor/runtime.c are byte-identical to 0717c87ca, which already carries this branch's write-ahead work, and the batch-bind region of cmd/layerxd/lxp_daemon_lni.c carries no difference from 0717c87ca. agent/crates/layerx-wire/src/hash.rs differs from 0717c87ca in one hunk only, the asset account tail inside canonical_payload, so receipt_execution_batch_id and execution_batch_id are byte-identical to 0717c87ca. The two sides disagree on the preimage: lxp_daemon_batch_bind_prefix builds the 88-byte program form for every execution, while the wire crate builds it only for module 9 operation 3, and the verified receipt is module 9 operation 4 ordinal 0. Evidence: qual-logs/rebase-205-9a.log."
assumption = "Both sides of the mismatch are decided by sources byte-identical to 0717c87ca, so the divergence is reproducible from an unmodified checkout once the harness compiles. Reconciling them changes the batch identifier contract between the daemon and the wire crate, which is protocol surface outside this branch's paths, so neither preimage, neither helper and no assertion was altered."
severity = "blocker"

