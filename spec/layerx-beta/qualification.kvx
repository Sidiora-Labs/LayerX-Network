[observation.6.2.7200]
task = "6.2"
file = "platform/hosted/core/src/public_reads.rs agent/crates/layerx-sdk/src/rpc_verification.rs agent/crates/layerx-sdk/tests/account_reads.rs platform/hosted/gateway/openrpc.json"
symbol = "did_accounts VerifiedRpcBalances verified_balances lx_getBalances"
observed = "The DID account listing recorded at observation 6.2.4101 and observation 6.11.161 now serves the read contract of the single-account reads. did_accounts already requested VerificationLevel::STATE_PROVEN and refused an empty listing with 503 did_account_listing_unavailable; it still stamped every entry with the literal state_proven and the listing with authenticated_node_snapshot, a label no proof establishes. Each entry now carries verification_label of the level layerx_client::read::did_accounts verified for it, an entry whose achieved level has no label refuses the whole listing with the same typed 503, and the listing label names the weakest level any entry achieved, so lx_getBalances, which the gateway maps unchanged to /v1/dids/{did}/accounts and to -32001 on refusal, carries the same labels. The SDK gains VerifiedRpcBalances::from_rpc_result and RpcClient::verified_balances, which verify every served entry through VerifiedRpcAccount::from_rpc_result, require ascending distinct account identifiers, the agent:{did}: owner prefix on every proven account name, a non-empty listing and a listing label equal to the weakest entry level; account_reads.rs adds three tests covering the served listing, each refusal and the lx_getBalances round trip. No build, compile or test ran in this lane: rustfmt --check on the three touched Rust files, git diff --check and a JSON parse of openrpc.json were the only checks executed, and the boundary assertion at platform/hosted/core/tests/boundary.rs was left as written."
assumption = "The row owns the core listing handler, the gateway lx_getBalances dispatch, the SDK balances verification and their tests; the gateway dispatch needed no code change because read_response already forwards the core result body and maps 503 to -32001. The owner builds and tests once the change is on main, so this record claims no gate."
severity = "note"

[observation.6.1.7700]
task = "6.1"
file = "platform/hosted/node/tests/bootstrap-test.py platform/hosted/node/bootstrap.sh"
symbol = "test_real_genesis_sets"
observed = "platform/hosted/node/tests/bootstrap-test.py now builds the LXGB v2 metadata suffix through tests/support/lxgb_metadata.py and passes --asset and --genesis-metadata, so the bootstrap it drives no longer refuses at argument validation. Its assertions at lines 84-85 still pin the request bootstrap.sh stopped emitting: a length of 314 + 81 * count bytes and the prefix LXGB followed by version byte 1, while bootstrap.sh:460-484 writes version byte 2 and appends the metadata suffix, so the request is 314 + 81 * count + len(metadata) bytes. With the metadata supplied, test_real_genesis_sets reaches those two assertions and they fail against the request the script really writes. Neither assertion was edited. Build and test were not run in this lane; this follows from reading both files."
assumption = "The two assertions describe the retired version 1 request and the row forbids editing assertions, so they are left as written and the disagreement is recorded here. Correcting them to the version 2 shape is a test-only change with no effect on the shipped bootstrap."
severity = "suspect"

[observation.6.1.7701]
task = "6.1"
file = "platform/hosted/node/tests/node-test.sh platform/hosted/core/tests/boundary.rs"
symbol = "LAYERX_TEST_SOCAT_BIN supervisor_arguments"
observed = "platform/hosted/node/tests/node-test.sh:35-40 now resolves socat from LAYERX_TEST_SOCAT_BIN when it is set, refusing with socat_invalid when it does not name an executable file, and otherwise from the first socat on PATH, refusing with socat_missing when none exists, and passes the result to both supervisors as --socat. platform/hosted/core/tests/boundary.rs:2253-2256 still panics when LAYERX_TEST_SOCAT_BIN is unset and no Makefile target sets it, so supervisor_reset_rebuilds_genesis_and_replays_once keeps failing on any tree until that harness takes the same default. Build and test were not run in this lane."
assumption = "platform/hosted/core/tests/boundary.rs is outside the paths of this change, so only the hosted node harness received the default."
severity = "note"

[observation.6.1.7702]
task = "6.1"
file = "platform/hosted/node/deployment.yaml platform/hosted/tests/beta-cluster.sh"
symbol = "layerx-node-genesis-metadata --genesis-metadata"
observed = "The sequencer container in platform/hosted/node/deployment.yaml:123-124 now passes --genesis-metadata /run/layerx/genesis/metadata.lxgb, mounted at line 155 with subPath from key metadata.lxgb of ConfigMap layerx-node-genesis-metadata declared at line 805, so bootstrap.sh:211 sees a regular file and not the ..data symlink a plain ConfigMap mount presents. The ConfigMap is not optional: a pod without it does not start rather than bootstrapping without the authoritative Asset records. platform/hosted/tests/beta-cluster.sh applies the node manifest without publishing that ConfigMap, so cluster bring-up refuses at pod start until it publishes the authoritative LXGB v2 metadata under that name the way it publishes layerx-node-settlement. The metadata bytes are an authoritative artifact carrying real salts and were not invented here. Build and test were not run in this lane."
assumption = "The manifest change is one argument, one volume and one volumeMount, the minimum that makes the argument name a file that exists; publishing the ConfigMap belongs to platform/hosted/tests/beta-cluster.sh, which is outside the paths of this change."
severity = "blocker"

[observation.3.7.9500]
task = "3.7"
file = "src/modules/asset/lx_asset_registry.c src/protocol/lxp_kernel.c tests/test_genesis_manifest.c tests/modules/test_asset_registry.c docs/wiki/Modules.md"
symbol = "module_execute lxp_kernel_bind_ledger_admission lxp_kernel_withdraw_execution_sequence check_version"
observed = "Asset ordinal 9 was advertised in activity_types but module_execute resolved the supply-binding asset id through a switch whose default arm answered LXP_ERR_UNKNOWN_ACTIVITY, so execute_withdrawal was unreachable through lxp_kernel_dispatch (observation 3.7.2700). module_execute now routes ordinal 9 straight to module_execute_impl, which is the existing withdraw transition (withdrawal_context, execute_withdrawal, lx_asset_withdraw_request) with its rollback on a failed transfer set and its withdrawal record; no supply binding is attached because lxp_receipt_validate_supply refuses operation 9 and the allow list in src/protocol/lxp_receipt.c is outside this change. Ordinals 2 and 3 take their asset id from the typed pause payload in the same switch and fall through to lxp_ctx_bind_asset_supply, closing observation 3.7.9402. Reading the dispatch path showed a second gap: since the generic asset branch of lxp_kernel_bind_ledger_admission was introduced, a withdraw bound through lxp_kernel_dispatch received facts without actor, verified key or a principal account snapshot, so lxp_kernel_withdraw_execution_sequence answered LXP_ERR_CONTEXT_MISMATCH for every dispatched withdraw, including tests/modules/test_asset_withdraw_activity.c case 0 and cases 18 to 26, whichever way module_execute dispatched. The binding now records actor, verified key, account_present and next_sequence for LX_ASSET_WITHDRAW exactly as it does for LX_ASSET_ACCOUNT_OPEN, other asset ordinals are untouched, and the sequence resolver keeps every fact check but takes the signed account_sequence, which lxp_apply enforces against the debited account, when the admission was bound with no principal (account_id and principal both zero and no account snapshot); a bound principal that is not the debited account still refuses. tests/test_genesis_manifest.c required asset ordinal 9 to be unresolvable on a state commitment genesis while activity_types advertised it (observation 3.7.9403); the test now requires all eleven declared ordinals to resolve and undeclared ordinal 12 to refuse. tests/modules/test_asset_registry.c gains a supply-binding case (register, pause, refused pause, unpause receipts through lxp_kernel_dispatch) and a withdraw dispatch case (principal mismatch refused with state root unchanged, then debit, receipt without supply binding, committed withdrawal record, then LXP_ERR_WITHDRAWAL_ALREADY_SETTLED). Build and test were not run in this lane: make CC=gcc test-asset-withdraw-activity, test-asset-registry, test-genesis, test and beta-ledger-check were not executed here, and the owner's build on main is the first to compile and run these changes."
assumption = "src/protocol/lxp_kernel.c and tests/test_genesis_manifest.c lie outside the declared paths of this change and were edited because the row's own gate cannot pass without them: the ledger admission facts are the kernel's, and the genesis assertion contradicts the settled position that every advertised ordinal dispatches to a real transition. The no-principal path in the sequence resolver is taken only when the admission recorded no principal at all, which lxp_kernel_dispatch produces for a caller that resolved none; the daemon always resolves the agent main account as principal (cmd/layerxd/lxp_daemon_lni.c lni_principal), so a live withdraw takes the fact-checked path. tests/modules/test_asset_withdraw_activity.c and its assertions are unchanged. The version 2 fee schedule, the receipt supply allow list, the hosted and native submission registries that still refuse ordinal 9, and spec/layerx-protocol/spec.kvx do_1, which still calls ordinal 9 reserved, were not touched."
severity = "note"

[observation.6.1.7600]
task = "6.1"
file = "platform/hosted/core/src/main.rs platform/hosted/core/src/lib.rs platform/hosted/core/src/custody.rs platform/hosted/core/tests/boundary.rs platform/hosted/core/tests/signer.rs platform/hosted/node/deployment.yaml docs/wiki/HostedNode.md docs/wiki/HostedCore.md"
symbol = "SocketSigner TreasurySigner SeedSigner build_send_with_signer SendError LAYERX_CORE_TREASURY_SIGNER_SOCKET LAYERX_CORE_TREASURY_KEY_FILE treasury-material"
observed = "The hosted core no longer holds the treasury seed. platform/hosted/core/src/main.rs:259 reads LAYERX_CORE_TREASURY_SIGNER_SOCKET, connects SocketSigner (platform/hosted/core/src/custody.rs) to the treasury signer socket, asks it for the treasury public key and derives the treasury DID from that answer; the former read of LAYERX_CORE_TREASURY_KEY_FILE through read_secret and parse_seed is gone and parse_seed is removed from the library. config() fails with 'LAYERX_CORE_TREASURY_SIGNER_SOCKET is required' when the variable is unset and with 'LAYERX_CORE_TREASURY_SIGNER_SOCKET: treasury signer socket <path> is not available' when nothing listens there, so main exits 2 before either listener opens. Signing goes through the TreasurySigner trait: build_send_with_signer in platform/hosted/core/src/lib.rs takes &dyn TreasurySigner for both the owner authorization digest and the envelope signature, binds the disclosure with layerx_crypto::disclosure::bind and SigningRequest::new before asking for the 32-byte SignaturePreimage digest, and verifies every returned signature under the signer's public key; build_send and build_send_with_identity_sequence keep their seed signatures as wrappers over SeedSigner so every existing call site in the probe, the gateway harness and the registry tests compiles unchanged; the gateway harness is not left untouched, though, because platform/hosted/gateway/tests/local/build.rs and agent/qualification/pay2/build.rs copy the text of platform/hosted/core/tests/boundary.rs into their own fixture and therefore inherit its new signer start. fund_send maps both arms of SendError through one send_refusal helper: SendError::Signer becomes refusal(503, treasury_signer_unavailable, retry 5) and SendError::Invalid the existing 422 send_unbuildable. Because admin_result wraps the fund handler and the admin plane rewrites every status at or above 500 outside /livez and /readyz to 422, a client of /admin/v1/testnet/fund observes 422 treasury_signer_unavailable with Retry-After 5, and 422 is the status the durable idempotency journal records for that key. SocketSigner speaks the contract of platform/hosted/node/signer/signer.py: one request line, one JSON reply bounded at 4096 bytes, connection closed; it refuses replies whose echoed digest or public key differ, whose signature is not 128 lowercase hex characters, whose public key is not a canonical non-weak Ed25519 key or whose DID is not did:layerx: plus that key. In platform/hosted/node/deployment.yaml the core-boundary container no longer mounts treasury-material and no longer carries LAYERX_CORE_TREASURY_KEY_FILE; its start script requires LAYERX_CORE_TREASURY_SIGNER_SOCKET from core.env alongside the sequencer identity and treasury asset, and the run volume it already mounts carries /run/layerx/node/treasury-signer.sock, whose signer admits uid 4021. The treasury-material volume is now mounted by the treasury-signer container alone. docs/wiki/HostedNode.md now records the treasury seed mount in a treasury-signer table of its own at /run/layerx/treasury/treasury.key rather than as a row under the sequencer container heading, which mounts no treasury material, and docs/wiki/HostedCore.md replaces LAYERX_CORE_TREASURY_KEY_FILE with LAYERX_CORE_TREASURY_SIGNER_SOCKET in its config table and adds treasury_signer_unavailable, 503 then 422 with retry 5, to its failure-status table. Tests: platform/hosted/core/tests/signer.rs starts the real signer.py over a random seed and asserts SocketSigner reports the seed's public key, that a socket signature verifies and equals the in-process signature over the same digest, that build_send_with_signer over the socket returns a SignedSend byte-identical to build_send_with_identity_sequence over the seed, that an absent socket and a relative path are refused at connect, that a stopped signer surfaces as SendError::Signer and that request validation refuses before reaching the signer. platform/hosted/core/tests/boundary.rs starts every core boundary through the real signer instead of a key file and asserts the environment carries no LAYERX_CORE_TREASURY_KEY_FILE; core_refuses_to_start_without_the_treasury_signer_socket proves exit 2 with the variable naming refusal for an absent socket and for an unset variable and that the core port never opens; core_takes_the_treasury_identity_from_the_signer_socket proves the running core refuses to fund its own treasury DID as learned from the socket while funding another DID reaches the node, and that the socket and seed paths agree on the bytes of a treasury SEND; with the signer stopped it also proves both planes still answer /livez 200 and that an admin fund is still refused typed. The treasury_signer_unavailable branch itself is not reachable through the boundary harness: fund_send connects the node and reads a treasury account holding the funded amount before it signs, and the harness genesis allocates nothing to the treasury and discards the asset issuer seed, so every boundary fund refuses at node_unavailable or treasury_account_unavailable first. The mapping is covered instead by fund_refusal_tests in platform/hosted/core/src/main.rs, which drives the real send_refusal and the real admin_result and requires 503 with retry 5 in the core shape and 422 carrying the same code and retry after the admin rewrite. Both fixture build scripts substitute a quoted absolute path for the env!(CARGO_BIN_EXE_layerx-core-boundary) token and assert it occurs exactly once, so all three spawn sites in boundary.rs call the single core_binary() helper at line 86 and the occurrence count was deliberately kept at one; the gateway local and the PAY2 qualification harnesses therefore still adapt the fixture, and the core boundary they start now comes up behind the real platform/hosted/node/signer/signer.py that start_treasury_signer spawns from the repository root. Build and test were not run in this lane: cargo test -p layerx-platform-core, the signer suite and the yaml load are the owner's build on main; the only checks run here were rustfmt --check on the touched Rust files, a PyYAML safe_load_all of deployment.yaml, git diff --check and the report render."
assumption = "This supersedes observation 6.1.4800, whose remaining core change is now made. The core is started only over the socket and never falls back to a key file even when the bootstrap ran with --treasury-key, because the deployment always runs the signer and a fallback would keep a seed-reading path in the component the boundary exists to remove; the local seed path of the bootstrap still serves the daemon-only harnesses that never start a core. platform/hosted/gateway/tests/local/build.rs and agent/qualification/pay2/build.rs lie outside this change's paths, so their one-occurrence fixture contract was honoured by hoisting the binary path into one helper inside boundary.rs rather than by raising the counts those build scripts assert. docs/wiki/HostedCore.md lies outside this row's declared paths and was edited anyway, because its config table named the deleted LAYERX_CORE_TREASURY_KEY_FILE and cited the lines that now connect the signer, and its failure-status table carried no row for the refusal this change introduces; publishing a document that contradicts the shipped binary is worse than reaching one file further."
severity = "note"

[observation.5.1.7000]
task = "5.1"
file = "human/Cargo.lock agent/tests/qualify/Cargo.lock agent/Cargo.lock"
symbol = "cargo update --workspace --offline"
observed = "formerly observation.5.1.40. formerly observation.5.1.7. formerly observation.5.1.1 (renumbered after rebase). formerly observation.5.1.1 (renumbered after rebase). formerly observation.5.1.focused-lock-reconciliation. cargo update --workspace --offline --manifest-path human/Cargo.toml and cargo update --workspace --offline --manifest-path agent/tests/qualify/Cargo.toml exit 0; logs qual-logs/r15/human-lock.log and qualify-lock.log. cargo metadata --locked --offline --manifest-path agent/Cargo.toml exits 0 for the complete workspace, with agent-metadata.json and agent-metadata.err. The same locked offline metadata command with --format-version 1 for human/Cargo.toml and agent/tests/qualify/Cargo.toml exits 0; human-metadata.json, qualify-metadata.json and their .err/.exit files retain evidence. No existing package version, source or checksum changes; no removals. Human changes only the layerx-mirror dependency edge base64 0.22.1 -> 0.23.1, required by interop/crates/layerx-mirror/Cargo.toml:9 and interop/Cargo.toml:24 (=0.23.1). Both versions were already locked. The qualify lock adds 79 previously absent package records; exact patch qual-logs/r15/qualify-lock.diff."
assumption = "Root requirements are agent/tests/qualify/Cargo.toml:9-12, agent/crates/layerx-sdk/Cargo.toml:12-20, agent/crates/layerx-proof/Cargo.toml:12-13 and agent/crates/layerx-client/Cargo.toml. New SDK mirror, HTTP and URL requirements and proof runtime requirements account for the new transitive closure. Feature unification adds signature to ed25519-dalek and serde_derive to serde; version-qualified references disambiguate der, getrandom and windows-sys. sha3 and keccak records are reordered without version changes. agent/Cargo.lock is unchanged. Package old/new and direct requiring manifest lines follow; cargo-registry paths are relative to /root/.cargo/registry/src/: arrayref: absent -> 0.3.9; required by blake3 ^0.3.5 at cargo-registry/index.crates.io-1949cf8c6b5b557f/blake3-1.5.0/Cargo.toml:34 | arrayvec: absent -> 0.7.8; required by blake3 ^0.7.4 at cargo-registry/index.crates.io-1949cf8c6b5b557f/blake3-1.5.0/Cargo.toml:37 | autocfg: absent -> 1.5.1; required by num-traits ^1 at cargo-registry/index.crates.io-1949cf8c6b5b557f/num-traits-0.2.19/Cargo.toml:47 | base64: absent -> 0.23.1; required by layerx-mirror =0.23.1 at interop/crates/layerx-mirror/Cargo.toml:9 | blake3: absent -> 1.5.0; required by layerx-programs-runtime =1.5.0 at programs/crates/layerx-programs-runtime/Cargo.toml:25 | bytes: absent -> 1.12.1; required by http ^1 at cargo-registry/index.crates.io-1949cf8c6b5b557f/http-1.5.0/Cargo.toml:58 | constant_time_eq: absent -> 0.3.1; required by blake3 ^0.3.0 at cargo-registry/index.crates.io-1949cf8c6b5b557f/blake3-1.5.0/Cargo.toml:44 | core-foundation: absent -> 0.9.4; required by security-framework ^0.9.4 at cargo-registry/index.crates.io-1949cf8c6b5b557f/security-framework-2.11.1/Cargo.toml:60 | core-foundation-sys: absent -> 0.8.7; required by security-framework ^0.8.6 at cargo-registry/index.crates.io-1949cf8c6b5b557f/security-framework-2.11.1/Cargo.toml:63 | der: absent -> 0.8.2; required by ureq ^0.8.0 at cargo-registry/index.crates.io-1949cf8c6b5b557f/ureq-3.4.0/Cargo.toml:158 | displaydoc: absent -> 0.2.7; required by icu_properties ^0.2.3 at cargo-registry/index.crates.io-1949cf8c6b5b557f/icu_properties-2.3.0/Cargo.toml:104 | downcast-rs: absent -> 1.2.1; required by wasmi_core ^1.2 at cargo-registry/index.crates.io-1949cf8c6b5b557f/wasmi_core-0.13.0/Cargo.toml:40 | errno: absent -> 0.3.14; required by rustix ^0.3.10 at cargo-registry/index.crates.io-1949cf8c6b5b557f/rustix-1.1.4/Cargo.toml:211 | fastrand: absent -> 2.5.0; required by tempfile ^2.1.1 at cargo-registry/index.crates.io-1949cf8c6b5b557f/tempfile-3.27.0/Cargo.toml:80 | form_urlencoded: absent -> 1.2.2; required by url ^1.2.2 at cargo-registry/index.crates.io-1949cf8c6b5b557f/url-2.5.8/Cargo.toml:81 | getrandom: absent -> 0.4.3; required by tempfile >=0.3.0, <0.5 at cargo-registry/index.crates.io-1949cf8c6b5b557f/tempfile-3.27.0/Cargo.toml:95 | http: absent -> 1.5.0; required by ureq-proto ^1.1.0 at cargo-registry/index.crates.io-1949cf8c6b5b557f/ureq-proto-0.6.1/Cargo.toml:58 | httparse: absent -> 1.10.1; required by ureq-proto ^1.8.0 at cargo-registry/index.crates.io-1949cf8c6b5b557f/ureq-proto-0.6.1/Cargo.toml:63 | icu_collections: absent -> 2.3.0; required by icu_normalizer ~2.3.0 at cargo-registry/index.crates.io-1949cf8c6b5b557f/icu_normalizer-2.3.0/Cargo.toml:151 | icu_locale_core: absent -> 2.3.0; required by icu_properties ^2.3.0 at cargo-registry/index.crates.io-1949cf8c6b5b557f/icu_properties-2.3.0/Cargo.toml:117 | icu_normalizer: absent -> 2.3.0; required by idna_adapter ^2.2 at cargo-registry/index.crates.io-1949cf8c6b5b557f/idna_adapter-1.2.2/Cargo.toml:50 | icu_normalizer_data: absent -> 2.3.0; required by icu_normalizer ~2.3.0 at cargo-registry/index.crates.io-1949cf8c6b5b557f/icu_normalizer-2.3.0/Cargo.toml:155 | icu_properties: absent -> 2.3.0; required by idna_adapter ^2.2 at cargo-registry/index.crates.io-1949cf8c6b5b557f/idna_adapter-1.2.2/Cargo.toml:54 | icu_properties_data: absent -> 2.3.0; required by icu_pr