task = "6.11"
file = "programs/sdk/rust programs/crates/layerx-programs-runtime programs/crates/layerx-programs-registry programs/fixtures/pay5 programs/porting/evm/MIGRATION.md programs/porting/solana/MIGRATION.md"
symbol = "ProgramPaymentCapabilities reference_interface merchant_tests lxt20_tests"
observed = "Final-source package-scoped cargo fmt --check, cargo clippy --locked --all-targets -- -D warnings and cargo test --locked for layerx-program-sdk, layerx-programs-runtime and layerx-programs-registry all exit 0. Both token-lxt20 and payments-merchant pass standalone formatting, locked WASM release Clippy/build and byte-for-byte comparison with their committed WASM fixtures. Native make -j16, make -j16 programs-core-test, programs-module-boundaries, programs-abi-drift, beta-ledger-check and git diff --check all exit 0."
assumption = "Exact commands, exits and log paths are in qual-logs/pay5/gates.tsv. Final gate logs are qual-logs/pay5/final-*.log with sibling .exit files; the reproducible local command runner is qual-logs/pay5/final_gates.py. CARGO_BUILD_JOBS=16 and MAKEFLAGS=-j16 are set; runtime tests use the real interpreter artifact named in observation 6.11.135. Inherited workspace formatting/parity-wasm failures remain as recorded at the merge base. Native merchant/token successful payment execution and registry receipt publication remain blocked as recorded in observation 6.11.139. Cluster and image gates were not run."
severity = "note"

[observation.6.11.6512]
task = "6.11"
file = "programs/crates/layerx-programs-runtime/src/dynamic_spend.rs programs/crates/layerx-programs-runtime/src/ffi_interface.rs programs/crates/layerx-programs-runtime/src/ffi_call.rs programs/crates/layerx-programs-runtime/src/calls.rs"
symbol = "CallerAuthorizedSpend::constrain_grants authorize_interface_call"
observed = "Dynamic interface admission now narrows the actual runtime capability set before root or nested guest execution. For the executing program, only descriptor-matching asset/recipient spend keys survive, and each retained ceiling is the minimum of the caller grant and published descriptor ceiling. Other-program grants remain subject to the existing owner-frame and nested narrowing rules. This closes the case where valid calldata could otherwise leave an overly broad caller grant available to guest code. Tests verify removal of undescribed recipients/assets, ceiling reduction, preservation of the original caller grants and absence of program spending on descriptor-free entries of a dynamic interface."
assumption = "The focused dynamic_spend test exits 0 (2 tests). The initial Clippy refusal for using an underscore-prefixed argument was repaired without suppression. The complete final gate runner was repeated after this change: all scoped formatting/Clippy/tests, both guest build/fixture comparisons, native build/core/boundary checks, beta-ledger-check and whitespace checks exit 0. Evidence: qual-logs/pay5/descriptor-narrowing-test.log, descriptor-narrowing-clippy.log, final-*.log and gates.tsv. The independent native payer/account integration blockers in observation 6.11.139 remain."
severity = "note"

