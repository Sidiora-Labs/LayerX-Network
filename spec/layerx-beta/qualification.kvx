severity = "blocker"

[observation.6.11.163]
task = "6.11"
file = "platform/hosted/core/tests/boundary.rs platform/hosted/gateway/tests/local/lifecycle.rs platform/hosted/gateway/src/http.rs platform/hosted/gateway/src/ws.rs"
symbol = "local_gateway_websocket_receipt_wake request valid_upgrade"
observed = "local_gateway_websocket_receipt_wake requires the unauthenticated upgrade GET /rpc/ws to answer 401 and receives 400. The shared request helper the harness borrows from the core fixture writes Connection: close into every request, and the upgrade case adds its own Connection: Upgrade header, so the request carries that header twice; the gateway request parser refuses any repeated header name before ws::valid_upgrade or the key authentication is reached. Connection: close belongs to this branch's own boundary.rs work, which the merge recorded at observation 6.11.141 had replaced wholesale with the native lane version and which the rebase restored, so the collision is already present in this branch's own 63ef8df81, where boundary.rs carries Connection: close and lifecycle.rs carries the same 401 assertion. platform/hosted/gateway/src/http.rs and platform/hosted/gateway/src/ws.rs are byte-identical across 63ef8df81, f89cb11c0 and the integrated tip. Evidence: qual-logs/rebase-205-9c.log."
assumption = "The parser is right to refuse a repeated header and the 401 refusal was never reached, so the collision is a defect in this branch's own request construction. The upgrade path now writes its own request carrying a single Connection: Upgrade header, mirroring the shared helper and reusing its transport and response parsing; the repair is recorded in d2b13ac99813fb2197e6ea23d44a7f7abc5ac048. platform/hosted/gateway/src/http.rs, ws.rs, the 401 assertion and the parse_http connection assertion are unchanged, every other request the core boundary target sends still carries Connection: close, and local_gateway_websocket_receipt_wake then passes the unauthenticated refusal and the whole receipt wake. Its subscription reader accepts only text frames while the gateway sends a ping every five seconds, so a run whose first subscription response arrives later than that reads the ping instead; the passing runs complete in about two seconds."
severity = "blocker"

[observation.3.7.3900]
task = "3.7"
file = "contracts/CheckpointRegistry.sol test/CheckpointRegistry.t.sol platform/hosted/paxeer/deploy-contracts.sh"
symbol = "_validateHeader CHECKPOINT_ORDER_VERSION registerCheckpoint"
observed = "Supersedes observation 3.7.53 for the contract side of the same-epoch contradiction. The refusal that record captured came from the header bound header.epoch <= finalisedEpoch. Current source refuses only regression, contracts/CheckpointRegistry.sol:372 reads header.epoch < finalisedEpoch, and the policy is published as CHECKPOINT_ORDER_VERSION 2 at contracts/CheckpointRegistry.sol:43. git log -S attributes both to ffd3f5892 and git merge-base --is-ancestor confirms ffd3f5892 is an ancestor of bae8bf98e5159986569235e7993b3895c997391e. Rerun at that revision from contracts/: forge test --match-contract CheckpointRegistryTest --match-test EqualEpoch|EpochRegression|SequenceGap|ZeroEpoch passes all five ordering tests, the full CheckpointRegistryTest suite passes 33 of 33, and forge test passes 165 tests in 14 suites with none failed and none skipped; forge build compiles 69 files with Solc 0.8.27 and exits 0. testEqualEpochConsecutiveBatchesRegisterAndPreserveAncestry at test/CheckpointRegistry.t.sol:929 registers exactly the successor shape 3.7.53 recorded as refused, batchNumber finalisedBatchNumber plus one and firstSequence finalisedLastSequence plus one at an epoch equal to finalisedEpoch, and asserts recorded ancestry, while epoch regression, checkpoint gaps at equal and higher epoch, repeated activity ranges, replay and zero epoch stay refused at test/CheckpointRegistry.t.sol:946 through 989. Logs: /root/lx-lanes/day/P3/qual-logs/forge-same-epoch.log, forge-checkpoint-registry.log, forge-test.log and forge-build.log."
assumption = "The contract-side contradiction is closed in source; no contract bound, header field, attestation, signed input or test assertion is changed by this record. Acceptance by a live settlement still depends on the registry actually deployed carrying this ordering policy, which observation 3.7.3901 records separately because no deployed address is available to compare. Deployment finalisation requires CHECKPOINT_ORDER_VERSION 2 at platform/hosted/paxeer/deploy-contracts.sh:524, so a registry deployed before ffd3f5892 is refused at finalisation rather than reinterpreted."
severity = "note"

[observation.3.7.3901]
task = "3.7"
file = "platform/hosted/paxeer/deploy-contracts.sh contracts/config/checkpoint-settlement.json platform/hosted/tests/beta-cluster.sh"
symbol = "phase_deploy paxeer_contracts_deploy settlement_publish"
observed = "The deployed-versus-compiled bytecode comparison that closing 3.7.53 against a live settlement requires cannot be performed, because no CheckpointRegistry address deployed on the persistent Paxeer chain is recorded anywhere in the repository. platform/hosted/paxeer/deploy-contracts.sh:76 defaults the deployment record to platform/hosted/paxeer/deployments/beta.json and phase_deploy writes its addresses object at lines 386 through 409; that path is absent from the worktree and from history, git log --all for platform/hosted/paxeer/deployments prints nothing. deploy-contracts.sh:413 writes the beta settlement domain into contracts/config/checkpoint-settlement.json, which declares only the vectors domain, chain 31337, settlement_contract 0x2e234dae75c793f67a35089c9d99245e1c58470b. platform/hosted/tests/beta-cluster.sh:1349 through 1353 reads .addresses.checkpoint_registry from a bring-up deployment.json and settlement_publish at lines 1356 through 1367 publishes it as ConfigMap layerx-node-settlement; neither the record nor the ConfigMap exists on this host, where kubectl and kind are not installed. Read-only probes of 127.0.0.1:18545 return eth_chainId 0x7d, chain 125, and eth_getCode 0x85FcD13735F4309833A503EE804ea32395851479 returns 2348 runtime bytes byte-identical to platform/hosted/paxeer/contracts/BetaUsdl.runtime.hex with keccak256 0x147d22ddd370f14c2df03ed1d37f0c67f8a4559f6c6ca58a6969ad229da5ec46, while 0x2e234dae75c793f67a35089c9d99245e1c58470b, the only other settlement address the repository records, returns no code: the persistent chain carries the genesis-seeded token and no recorded settlement suite. The comparison target compiled here from contracts/ is the CheckpointRegistry runtime object in build/forge-artifacts/CheckpointRegistry.sol/CheckpointRegistry.json, 17630 bytes, keccak256 0x45995def161e99fe49fb188ef19a2bc964cfd7a4c358bbb4f876619d89d05366, with no CBOR metadata trailer to strip because foundry.toml:10 sets bytecode_hash none and foundry.toml:11 sets cbor_metadata false and the artifact settings repeat bytecodeHash none and appendCBOR false, so the comparison would be exact byte equality against an eth_getCode result with nothing removed from either side. Evidence: /root/lx-lanes/day/P3/qual-logs/deployed-bytecode-compare.log produced by /root/lx-lanes/day/P3/qual-logs/bytecode-compare.py."
assumption = "No address was guessed and no transaction was sent; only eth_chainId and eth_getCode were issued against the persistent chain. Closing 3.7.53 against a deployment needs the bring-up owner to record the deployed CheckpointRegistry address, chain id and bonded set as the beta settlement domain and deployment record, which platform/docs/content/beta.md:257 already names as the owner input the repository does not hold. Until that record exists a registry deployed before ffd3f5892 remains possible on any long-lived chain, and deploy-contracts.sh:524 refuses such a registry at finalisation by requiring CHECKPOINT_ORDER_VERSION 2, so the exposure is an unrecorded deployment rather than a silent acceptance."
severity = "blocker"
[observation.2.2.2100]
task = "2.2"
file = "cmd/layerxd/lxp_daemon_lni.c"
symbol = "grant_id lxp_authority_hash"
observed = "The node interface simulation path still builds its authority at the call site: cmd/layerxd/lxp_daemon_lni.c:2758 declares a zero grant identifier, lines 2839 to 2848 synthesize a scope whose per-activity, total and per-period ceilings are all UINT64_MAX, and line 2855 derives the authority hash from that zero identifier. The replay, single-activity and batch execution paths in cmd/layerxd/lxp_daemon_process.c and the guarantor path in cmd/layerx-guarantor/runtime.c now resolve the same authority through lxp_authority_resolve_activity against persisted grant state, so a simulated execution and the real execution of the same activity no longer agree on the authority hash the kernel binds into the execution binding and the programs modules fold into program state."
assumption = "cmd/layerxd/lxp_daemon_lni.c is outside this change's owned paths, so the site is recorded rather than rewired. The same call carries the resolution the other four sites use once its owner adopts it: lxp_authority_resolve_activity takes the kernel, the refreshed identity, the activity, the owner-key validity the caller already computes, the batch timestamp, the 300000 millisecond window this file already uses at line 2864 and the global sequence."
severity = "blocker"

[observation.2.2.2101]
task = "2.2"
file = "platform/emulator/core/emulator_core.c"
symbol = "grant_id lxp_authority_hash"
observed = "The emulator authority helper declares a zero grant identifier at platform/emulator/core/emulator_core.c:767, sets the kind to owner unconditionally at line 798 and derives the authority hash from the zero identifier at line 799, so an emulated execution reports an authority hash the node no longer produces for the same activity and cannot observe a session grant or a revoked grant at all."
assumption = "platform/emulator/core/emulator_core.c is outside this change's owned paths. The emulator holds a kernel and an identity store, so the same lxp_authority_resolve_activity entry applies without new state."
severity = "blocker"

[observation.2.2.2102]
task = "2.2"
file = "src/state/lxp_authority.c include/layerx/lxp_authority.h"
symbol = "lxp_authority_owner_grant lxp_authority_spend_check lxp_authority_charge_allowance"
observed = "The owner grant lxp_authority_owner_grant derives carries no spend ceilings: maximum_per_activity, maximum_total and maximum_per_period stay zero, and its module mask and ordinal range are exactly the envelope lxp_authority_envelope_declare reads from the kernel's enabled module registrations, never UINT64_MAX. Owner authority is bounded by the account balance and by the signed activity window instead of by an allowance. lxp_authority_spend_check at src/state/lxp_authority.c:443 and lxp_authority_charge_allowance at src/state/lxp_authority.c:465 have no caller outside the same file, so no execution path reads the ceilings a resolved scope carries."
assumption = "Zero ceilings on an owner scope are the absence of an allowance, not an exhausted allowance, because nothing charges against an owner scope today. A transition that starts charging allowances must distinguish the two before it reads an owner scope, and the persisted delegated and budget grant kinds already carry real ceilings that lxp_grant_encode validates."
severity = "note"

[observation.2.2.2103]
task = "2.2"
file = "src/protocol/lxp_kernel.c src/modules/programs/transfer.c src/modules/programs/call.c src/modules/programs/winddown.c"
symbol = "kernel_execution_binding authority_hash"
observed = "The authority hash is consensus visible. src/protocol/lxp_kernel.c:567 binds it into the execution binding that a prepared batch must reproduce at commit, and src/modules/programs/transfer.c:112, src/modules/programs/call.c:1336 and src/modules/programs/winddown.c:851 fold its four words into program derivations. Deriving it from a resolved grant identifier instead of the zero identifier the four call sites synthesized changes those derivations for every program activity, so receipts and state roots recorded against the previous synthesis do not replay against this resolution."
assumption = "The change is intentional and is the point of resolving authority: a receipt that commits to a zero grant identifier commits to no grant at all. Every node executing the same activity resolves the same grant from the same persisted state, so the daemon replay, single-activity and batch paths and the guarantor agree; the node interface simulation path recorded at observation 2.2.2100 does not yet."
severity = "note"

[observation.2.2.2104]
task = "2.2"
file = "cmd/layerxd/lxp_daemon_process.c src/state/lxp_authority.c"
symbol = "lxp_authority_envelope_declare lxp_governance_activity"
observed = "A governance activity submitted to a node running a protocol version below the state commitment version reaches the authority resolution with no governance module registered: cmd/layerxd/lxp_daemon_process.c:4810 registers lxp_governance_module_iface only at LXP_PROTOCOL_VERSION_STATE_COMMITMENT while the per-activity type filter admits lxp_governance_activity at every version. The declared envelope therefore omits the governance module bit and lxp_authority_check_scope refuses with LXP_ERR_AUTH_SCOPE before execution, where the previous synthesis carried the activity into lxp_kernel_execute_activity and recorded an unknown-module refusal in a receipt."
assumption = "Both outcomes refuse the activity, and the surrounding block already treats an authority failure as a hard error rather than a refusal receipt, so the resolution joins an existing class rather than creating one. Widening the activity type filter to follow the registered module set belongs to the filter's owner."
severity = "note"

[observation.6.2.4100]
task = "6.2"
file = "platform/hosted/core/src/public_reads.rs agent/crates/layerx-client/src/read.rs agent/crates/layerx-client/src/client.rs cmd/layerxd/lxp_daemon_lni.c"
symbol = "account verify_state_value require_account_read_capabilities send_account_read"
observed = "The core public account read asked layerx_client::Client::account for VerificationLevel::UNVERIFIED, so /v1/accounts/{id} and /v1/accounts/{id}/balance, the sources of lx_getAccount and lx_getBalance, served a value and its proof material while naming no level, and a node answering with no proof material at all was served as a 200 that no receiver could check. read.rs verify_state_value verifies every non-empty proof material identically whatever level was requested, and only its empty-evidence branch consults the requested level, so raising the request to STATE_PROVEN changes exactly one served outcome: an empty-evidence response is now the typed MissingEvidence refusal answered as 503 account_evidence_unavailable. The request keeps RootSelector::Latest because read_context selects a checkpoint root only from CHECKPOINT_FINALISED, and require_account_read_capabilities demands HistoricalProofs only when requires_historical_account_proofs holds, which is also only from CHECKPOINT_FINALISED, so no additional node capability is required. cmd/layerxd answers an ACCOUNT_READ_REQUEST with proof material on success or a typed refusal, so no successful read loses its evidence. The served object gained a verification member naming the level the proof actually established: state_proven, or checkpoint_finalised and settlement_anchored when the evidence carries a checkpoint report."
assumption = "Refusing an unverifiable account read is the honest public contract and matches the proof-gated receipt and proof routes on the same boundary, so the row's default of proving at the core was taken rather than serving an unverified value with a lower label. Evidence: qual-logs/platform-tests.log, where account_proof_export_preserves_exact_native_verified_bytes now verifies the served proof material offline against the cluster sequencer key, and qual-logs/agent-tests.log."
severity = "note"

[observation.6.2.4101]
task = "6.2"
file = "platform/hosted/core/src/public_reads.rs platform/hosted/gateway/src/rpc.rs"
symbol = "did_accounts lx_getBalances authenticated_node_snapshot"
observed = "did_accounts still reads at VerificationLevel::UNVERIFIED and labels its answer authenticated_node_snapshot, so /v1/dids/{did}/accounts and the lx_getBalances method that resolves to it remain the one public account-shaped read whose values carry no state proof. The enumeration is a DID-scoped listing rather than a point read, so it has no single nested account proof to verify and cannot reuse the account read's evidence path unchanged, and the same route is the subject of the unresolved read contract recorded at observation 6.2.940 and observation 6.11.161."
assumption = "The DID listing contract is owned elsewhere and its refusal shape is still contested, so the route was left exactly as written rather than given a label the evidence does not support."
severity = "note"

[observation.6.2.4102]
task = "6.2"
file = "agent/crates/layerx-client/tests/availability_daemon.rs tests/daemon/program-admission.sh"
symbol = "real_daemon_availability_refusals bootstrap"
observed = "cargo test -p layerx-sdk -p layerx-client exits 101 on one target: real_daemon_availability_refusals drives tests/daemon/program-admission.sh build --availability-batches with the native binaries built from this worktree, and the harness exits 1 during bootstrap with 'bootstrap: genesis request has an unexpected length' before any account read runs. Every other target passes, including the account read coverage this row added. No C source, harness script or genesis path is modified on this branch, so the harness refusal is reproducible from an unmodified checkout. Evidence: qual-logs/agent-tests.log and qual-logs/availability-harness.log."
assumption = "The genesis request length disagreement lies in the native bootstrap path, outside this row's owned files, so it is recorded for its owning lane rather than repaired here."
severity = "blocker"

[observation.6.2.4103]
task = "6.2"
file = "agent/crates/layerx-client/tests/supply_receipt.rs"
symbol = "canonical_native_supply_receipt_round_trips expect_used"
observed = "cargo clippy -p layerx-sdk -p layerx-client --all-targets exits 101 before reaching any file this row touches: supply_receipt.rs calls expect() twice, at lines 32 and 33, and the agent workspace denies clippy::expect_used. The two lints are the only clippy failures in either crate; clippy over the crate libraries and over both tests this row owns exits 0. Evidence: qual-logs/agent-clippy.log and qual-logs/agent-clippy-owned.log."
