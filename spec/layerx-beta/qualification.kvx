[observation.3.4.12]
task = "3.4"
severity = "note"
file = "platform/hosted/human/provision.sh platform/hosted/human/provision.py platform/hosted/registry/tests/native_deployment.rs"
symbol = "human_journal_materialize materialize_journal assert_human_materialization"
observed = "Human journal collection now creates a bounded temporary UID-4030 pod colocated with the registry, mounting the same PVC and journal subpath read-only. It copies into a private host staging directory, validates with the unchanged journal_records reader, writes and fsyncs mode-0600 records, verifies exact bytes and atomically renames the protected directory. The native deployment test exercises actual produced pairs through materialization, preserves existing destination bytes on refusal, and refuses missing partners, wrong modes, symlinks, hard links and empty records. Registry locked tests, all-targets Clippy and format checks pass; Human pytest passes eighteen tests and both shell scripts pass syntax validation. Logs: qual-logs/reg2/reg2d-registry-test-final.log, reg2d-clippy-final.log, reg2d-fmt-final.log, reg2d-human.log and reg2d-shell.log. Initial task-scoped raw-string and function-length Clippy findings were repaired without changing checks."
assumption = "The registry container forbids exec by its cgroup design, so copying directly from that container is not usable. The separate read-only export pod preserves writer ownership and requires no ownership or mode relaxation. Kubernetes scheduling, mounted-volume copying and images remain unqualified on this server; local materialization is not cluster evidence."

