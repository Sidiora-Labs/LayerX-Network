[observation.6.1.52]
task = "6.1"
file = "src/modules/asset/lx_asset_custody.c include/layerx/lx_asset.h tests/modules/test_asset_withdraw.c"
symbol = "lx_asset_withdraw_request lx_withdrawal_state_encode lx_withdrawal_state_decode"
observed = "The native asset request stages an immutable request record in module KV under withdrawal: followed by the existing nullifier. The 182-byte value encodes version 2, network ID, withdrawal ID, account ID, asset ID, amount, payout recipient and request checkpoint ID in big-endian order. The public strict decoder checks exact lengths, version and recomputed nullifier key. The runtime withdrawal store keeps its existing representation and lookup behavior. Failed transfer application rolls back the staged fact. The real withdrawal test commits the module context and proves the recorded value against the composite root, then rejects truncated records, wrong versions and altered nullifier or amount bytes. make -j16 and the asset, bridge and state-proof targets exit 0; the bridge target also executes all 149 Solidity tests. Evidence: qual-logs/set1/withdraw-make.log, withdraw-tests-ready.log and final-state.log. The initial native test invocation lacked forge on PATH and exited 2; the pinned-Foundry rerun exits 0."
assumption = "The direct native module request path is qualified at 19fa5a6d. A module-context commit is required for durability. The immutable fact records request creation, not later settlement status. Signed activity dispatch and replay-generated withdrawal records remain unqualified."
severity = "note"

[observation.6.1.53]
task = "6.1"
file = "src/state/lxp_state_root.c src/modules/asset/lx_asset_registry.c src/modules/bridge/lxp_bridge_withdraw.c contracts/EmergencyExit.sol contracts/WithdrawalClaims.sol human/crates/layerx-paxeer-client/src/exit.rs human/crates/layerx-paxeer-client/src/withdraw.rs"
symbol = "lx_account_state_leaf_material activity_types lxp_withdrawal_nullifier executeExit queueClaim encode_publication"
observed = "The account-registry path and native request commitment gaps in observation 6.1.48 are implemented. Three settlement interfaces remain unresolved. The committed account record carries an Ed25519 authority but no EVM recipient, whereas executeExit and verify_balance_proof authenticate the recipient through the old balance leaf. The native withdrawal request checkpoint ID is included in its nullifier and now in committed KV, while the Solidity Withdrawal tuple and Rust CheckpointProof use one checkpoint hash for request identity and inclusion-root certification. Requiring a committed record to contain the hash of its own inclusion checkpoint makes that state-root commitment circular. Finally the registered asset activity table advertises no withdrawal operation; its executable signed replay path handles SEND and cannot create the new request record."
assumption = "A recipient-binding authorization format/verifier, separate request-anchor and inclusion-checkpoint semantics with their required relationship, and an authorized signed native withdrawal activity are required. No recipient check, nullifier domain or certificate equality is removed. Production claim/exit consumers, publication EVIDENCE_VERSION and deployment finalization expectation remain on version 1. Version-2 producer publication and deposit-root registration are not implemented, and the three fetch_published integration paths are not qualified. Empty balance vectors cannot substitute for the three replayed account records."
severity = "blocker"

