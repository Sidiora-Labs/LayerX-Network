symbol = "publish-crates-io publish-npm publish-pypi publish-go-modules publish-maven-central publish-swiftpm publish-nuget"
observed = "The seven publication jobs and release-promotion were verified structurally by make platform-release-check, the 37 layerx-platform-release tests and a PyYAML parse, but no publication was executed: cosign and syft are not installed on the qualification host and no publish token, signing key, trusted publisher or beta registry override exists here. Owner inputs are referenced by name only: secrets LAYERX_RELEASE_CRATES_IO_TOKEN, LAYERX_RELEASE_NPM_TOKEN (optional; empty selects npm OIDC trusted publishing), LAYERX_RELEASE_GO_TAG_TOKEN, LAYERX_RELEASE_MAVEN_CENTRAL_TOKEN, LAYERX_RELEASE_NUGET_API_KEY, LAYERX_RELEASE_SWIFTPM_REMOTE, LAYERX_RELEASE_GPG_PRIVATE_KEY, LAYERX_RELEASE_GPG_PASSPHRASE; a PyPI trusted publisher registered for platform.yml; repository variables LAYERX_RELEASE_CRATES_IO_INDEX, LAYERX_RELEASE_NPM_REGISTRY, LAYERX_RELEASE_PYPI_REPOSITORY_URL, LAYERX_RELEASE_PYPI_INDEX_URL, LAYERX_RELEASE_GO_PROXY, LAYERX_RELEASE_MAVEN_UPLOAD_URL, LAYERX_RELEASE_MAVEN_REPOSITORY_URL, LAYERX_RELEASE_SWIFTPM_URL, LAYERX_RELEASE_NUGET_SOURCE."
assumption = "The first tagged run under owner inputs is the executed evidence for req 8.2 and 8.6; until it runs, publication is blocked on the named inputs, not passed. Two override limits are known: publishing to an alternative Cargo registry through LAYERX_RELEASE_CRATES_IO_INDEX additionally requires registry = \"beta\" on the internal dependencies of the release revision, and npm --provenance is accepted only by registries that implement npm provenance, so a private LAYERX_RELEASE_NPM_REGISTRY without it fails the publish step rather than silently publishing without an attestation."
severity = "blocker"

