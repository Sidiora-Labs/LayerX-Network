observed = "formerly observation.5.1.37. formerly observation.5.1.8. formerly observation.5.1.2 (renumbered after rebase). formerly observation.5.1.focused-replay-compiler-prerequisite. Read-only diagnosis: tools/lxp_qual_replay_matrix.sh:24-27 explicitly refuses absent clang-18; lines 41-42 select clang-18 for both optimization levels. tools/lxp_replay_matrix.sh:21-22 and tools/ci/replay-matrix.sh:26 also pin that executable. The searched CI workflows install unversioned clang, not clang-18; no clang-18 pin appears in docs. ls /usr/bin/clang* exits 2 with: ls: cannot access '/usr/bin/clang*': No such file or directory. command -v finds gcc-13 at /usr/bin/gcc-13 and neither clang nor clang-18. Evidence: qual-logs/r15/compiler-pins.log and host-clang.log."
assumption = "Compiler provisioning is external to this repair. No compiler was installed and make qualify-replay was not rerun. The executable requirement remains intact."
severity = "blocker"

