file = "spec/layerx-platform/qualification.kvx"
symbol = "observation.38.5.1 observation.38.5.3 observation.38.5.6 observation.38.5.8"
observed = "W4-L40-F007: the platform ledger describes registry isolation, mTLS, cgroup enforcement, crash and deployment behaviour and host provisioning as designed or simulated but not executed, while the platform task list reads as implemented."
assumption = "These records are never rewritten. Task 3.7 gives their work an executable path through the existing hosted-boundary, webhook fault-injection and node-provision boundary scripts on the beta cluster; task 5.1 links each from the gate record that executes it, or records a blocked gate naming the owner input. The platform feature status is not changed by this feature."
severity = "note"

[observation.0.5]
task = "4.3"
file = "tools/qualification/release_runner.py"
symbol = "ReleaseRunner._preflight LAYERX_QUALIFICATION_DRIVER EXTERNAL_GATES"
observed = "The existing qualification runner requires an absolute, digest-pinned external driver executable to produce evidence.json for platform-qualify-adoption, programs-qualify, interop-qualify, multichain-qualify, human-qualify-ui and human-qualify-usability, and no such driver exists anywhere in the repository. platform-qualify therefore cannot complete as written. Its first local command is make human-qualify, which itself requires the ui and usability external gates."
assumption = "Under the full-surface bar the driver is a missing functional component, not a gap to record. Task 4.3 adds tools/qualification/beta_driver.py implementing the runner's contract for the four functional external gates, plus a beta-qualify runner gate that substitutes a human-qualify-functional gate (no perf, ui or usability) for human-qualify. platform-qualify and human-qualify are left unchanged for production. If the owner wants performance budgets counted as functional, human-qualify-perf moves into human-qualify-functional before task 4.3 starts."
severity = "blocker"

[observation.0.6]
