[observation.6.11.6439]
task = "6.11"
file = "platform/emulator/build.rs Makefile"
symbol = "PROGRAMS_TARGET_DIR programs-build"
observed = "Running the platform workspace clippy gate inflates the worktree programs target directory to about 9.9G against about 2.1G for a plain native build, because platform/emulator/build.rs re-enters make build, which runs the nested cargo build into PROGRAMS_TARGET_DIR while the outer invocation is a clippy run, so the nested build produces a second complete artifact set beside the plain build and test artifacts, plus an incremental cache of about 1.8G. With the native, programs and platform gates in flight together the directory exhausted the device and make CC=gcc programs-test failed with No space left on device while linking layerx-programs-runtime test binaries; that run is recorded as void and rerun. Evidence: qual-logs/c2/8.log, qual-logs/c2/8r.log, qual-logs/c2/programs-clean.log."
assumption = "The nested programs build should not inherit the outer invocation kind, so a lint run over the platform workspace does not duplicate the whole programs artifact set in the shared worktree target directory."
severity = "note"

