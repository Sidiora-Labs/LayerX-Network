[observation.6.2.920]
task = "6.2"
file = "platform/hosted/gateway/tests/local/funding.rs platform/hosted/gateway/tests/local/lifecycle.rs platform/hosted/gateway/tests/local/deposit_recipient.py platform/Cargo.lock"
symbol = "sign_disclosed local_gateway_successful_send_latency"
observed = "The signer integration accepts independently disclosed identity-envelope and source-account sequences. The funded fixture now signs through the production disclosure-bound LocalSigner and credits a distinct recipient agent main account through a second real custody deposit on disposable chain 31337. The former system:fees recipient was correctly refused with native result -208. Twenty successful gateway HTTPS JSON-RPC executed SENDs, each with matching activity ID, result code zero and verified sequencer signature, measured p50 2946178 us and p99 4196111 us before transport changes. After coalescing writes, enabling TCP_NODELAY and releasing the commit-notification mutex during receipt scans, twenty successful SENDs measured p50 2106405 us and p99 3404539 us. Batched replay returned inclusion evidence in 363379 us; finalised replay returned executed/pending in 5817963 us under the unchanged deadline. Evidence: qual-logs/pay4/g-funded-agent-latency.log and g-funded-final.log, both exit 0. Native producers were rebuilt from base 4ad5b4c15d1a01e3e1f9ccb56011fc7843c54157 with the qualified working-tree receipt-wait change."
assumption = "The 250 ms p50 threshold remains unmet. This harness has no finalised guarantor certificate, so the finalised result proves bounded pending behavior only. Standard locked platform build exits 101 because the integrated layerx-mcp dependency on layerx-sdk is absent from protected platform/Cargo.lock. Qualification uses an untracked alternate lockfile containing only that dependency addition; the tracked lockfile is unchanged. Exact commands and raw logs are in qual-logs/pay4/g-gate-commands.md. No persistent chain was used."
severity = "blocker"

[observation.6.2.921]
task = "6.2"
file = "cmd/layerxd/lxp_daemon_lni.c platform/hosted/core/src/main.rs platform/hosted/core/tests/boundary.rs platform/hosted/gateway/src/http.rs platform/hosted/gateway/src/store.rs src/replica/lxp_history.c cmd/layerxd/lxp_daemon_main.c"
symbol = "send_receipt receipt_commit_generation executor_run lxp_receipt_lookup"
observed = "Receipt history scans formerly held the global commit-notification mutex and serialized readers with publication notifications. A generation check now protects notification ordering while scans run outside the mutex; generation changes retain the original monotonic deadline. Four real concurrent receipt readers receive the exact committed receipt, and existing absent-receipt, oversized-wait, malformed-selector and already-present assertions remain intact. The concurrency fixture durably admits the real signed activity before occupying all four native connection workers, joins those readers, then checks the core replay response. The initial fixture exhausted all four workers before submission and correctly received 503; the worker bound was not widened. Gateway HTTP and Redis frames are coalesced in zeroizing buffers and owned TCP endpoints disable Nagle delays."
assumption = "The syscall-traced baseline is diagnostic only: it timed out on SEND 15 and failed the unchanged executed-success assertion. Retained numeric spans show median core submission 346740 us, core receipt wait 3419135 us, gateway authentication 637060 us and gateway activity processing 10242278 us under tracing; these are not benchmark results. Raw diagnostics: qual-logs/pay4/g-profile-syscalls.log, g-profile-spans.log and g-profile-summary.json. The native executor waits for a nonempty queue with a condition variable; its separate 100 ms health loop and idle listener polls do not delay queued submission. Native lxp_receipt_lookup scans the published history from offset zero. Indexed authenticated history reads and executor/history cost reduction require changes outside the receipt-wait ownership boundary, preserving corruption, duplicate, signature and durability checks."
severity = "blocker"

