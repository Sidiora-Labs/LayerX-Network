[observation.6.5.2]
task = "6.5"
file = "platform/hosted/identity/tests/service.rs"
symbol = "readiness_fails_when_the_store_is_not_writable"
observed = "The retained final assertion expects 200 from /readyz after the state directory is removed and an empty directory is recreated while the service keeps running; the implementation answers 503 store_unavailable. req.14.6 requires 200 only when the store is writable, and store.rs check_available defines writable as the open journal descriptor still being the file in the directory whose identity the store opened: after deletion the journal descriptor references an unlinked inode and every acknowledged write would be lost, and after recreation the directory inode differs, so the service refuses with restart required. Answering 200 there would be a false-ready that acknowledges writes into an unlinked journal, which is the defect observation 6.5.1 repaired. The implementation is correct and the assertion is wrong."
assumption = "Replace the final 200 expectation with 503 store_unavailable and the same retry-after body, and prove recovery by spawning a fresh server on the recreated directory and asserting its /readyz is 200. platform/hosted is outside the paths this reconciliation was permitted to edit, so the test was not changed here."
severity = "blocker"

