symbol = "commit_prepared_batch_wal lxp_kernel_finalize_batch_publication_records lxp_replay_execute lxp_programs_replay_finalize"
observed = "Daemon batch publication has no occupancy maintenance record. cmd/layerxd/lxp_daemon_batch_wal.c requires last_sequence = first_sequence + activity_count - 1 and receipt proof leaf_count = activity_count. src/protocol/lxp_kernel.c requires the same sequence cardinality and binds the settled root to the last activity receipt. src/replica/lxp_replay.c requires an additional receipt and sequence for protocols 2 and 3 and invokes batch_finalize; lxp_programs_replay_finalize produces a real occupancy settlement record and changes the canonical state root. These contracts disagree. Adding settlement after publication would bypass the durable publication digest and leave the signed header root behind the state. The conflicting checks and execution code remain intact. Source evidence is captured in qual-logs/item4-occupancy-contract.log. The requested docs/wiki/Programs.md and docs/programs*.md do not exist in this checkout."
assumption = "Platform req.36 ac.5 and task.29.5 require deterministic occupancy charging with canonical evidence and replay. An explicitly versioned maintenance publication contract must reconcile preparation, WAL recovery, signed roots, and replica replay before an occupancy read route can publish that evidence. Existing per-activity occupancy fields do not establish batch settlement."
severity = "blocker"

