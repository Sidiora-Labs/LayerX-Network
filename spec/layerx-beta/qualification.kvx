[observation.6.11.6420]
task = "6.11"
file = "platform/cli/src/wallet_send.rs agent/crates/layerx-crypto/src/disclosure.rs agent/crates/layerx-crypto/src/signer.rs src/ledger/lxp_send.c"
symbol = "Send::prepare decode_send SigningRequest::new lxp_send_authorization_message"
observed = "The CLI-local Send payload and authorization-message encoders match the real native lxp_send.c encoder in a compiled differential fixture. The unsigned envelope retains identity sequence 17 while the payload retains source sequence 72623859790382856. The shared decode_send still rejects unequal sequences. SigningRequest requires a validated Disclosure and provides no public request constructor for the separate native Send debit-authorization preimage. Source evidence: qual-logs/pay3/pay3c-signing-boundary.log."
assumption = "The local encoder does not change the signer boundary or supply identity state. Send submission requires separate-sequence disclosure support and a disclosed native debit-authorization signing API. Token submission requires an authenticated identity.next_sequence read. No account sequence substitution or raw-key signer bypass is authorized by the local encoder grant."
severity = "blocker"

[observation.6.11.6421]
task = "6.11"
file = "platform/cli/src/wallet.rs platform/cli/src/config.rs agent/crates/layerx-client/src/evidence.rs"
symbol = "verify_receipt check_checkpoint_bytes checked_checkpoint"
observed = "Wallet receipt verifies the sequencer signature and requested activity ID but has no batched/finalised wait pipeline. The retained public RPC implementation exports receipt inclusion with signed_header and proof fields, and checkpoint/context canonical bytes. The existing checkpoint verification functions for those raw bytes are private; its public checkpoint entry point requires FrameTransport. CLI configuration contains a sequencer key pin but no independently configured sequencer identity, authorized batch range, or guarantor authority. Source evidence: qual-logs/pay3/pay3c-core-public-reads.rs and qual-logs/pay3/pay3c-checkpoint-boundary.log."
assumption = "Commitment waiting remains incomplete. Complete CLI trust configuration and receipt/header/proof binding, then consume an exposed verifier for canonical checkpoint/context material with independently configured authority. A response commitment label or admission acknowledgement cannot establish any verification level. Wallet write confirmation cannot be qualified before the required identity and signing interfaces are available."
severity = "blocker"

[observation.6.11.6425]
task = "6.11"
file = "agent/crates/layerx-crypto/src/signer.rs agent/crates/layerx-crypto/src/payments.rs agent/crates/layerx-sdk/src/wallet.rs platform/cli/src/wallet.rs"
symbol = "SigningRequest sign_disclosed Wallet::send"
observed = "Revision 98733556 supplies transport disclosure version 3 and independently disclosed identity and source sequences. The public signer still accepts only a request whose digest matches a complete activity Disclosure. It exports no separate native Send debit-authorization signing entry point. The shared Payment enum has no Send variant; Wallet::send takes an already authorized canonical payload. Source inventory: qual-logs/pay3/pay3d-signer-api.log and pay3d-signer-exports.log."
assumption = "Send and token transfer cannot construct the inner authorization through the required shared signer. Supply a public disclosed native debit-authorization API and shared Send encoder. The CLI-local Send encoder remains a differential fixture; raw private-key signing is not a substitute for the missing boundary."
severity = "blocker"

[observation.6.11.6426]
task = "6.11"
file = "platform/cli/src/rpc.rs agent/crates/layerx-sdk/src/rpc.rs platform/hosted/gateway/openrpc.json"
symbol = "positional_requests_match_published_contract RpcClient::call"
observed = "Token info and list now issue lx_getAsset and lx_listAssets instead of rejecting them before transport. The retained positional_requests_match_published_contract test asserts that lx_getAsset with a valid identifier must fail local request construction. The focused contract test exits 101 at that unchanged assertion. Evidence: qual-logs/pay3/pay3d-item3-contract.log. The SDK has no typed asset metadata or enumeration methods; these two reads use the CLI RPC transport."
assumption = "The requested token-info route and the inherited negative contract assertion conflict. The assertion remains intact. The gateway and SDK owners must publish the extended asset-read contract, and authority is required to replace the obsolete negative expectation with positive coverage. Other wallet command and native differential tests pass; this does not qualify public RPC execution."
severity = "blocker"

[observation.6.11.6427]
task = "6.11"
file = "platform/cli/src/wallet.rs platform/cli/src/rpc.rs platform/cli/README.md"
symbol = "execute_payment wallet_receipt read_policy rpc_error"
observed = "Token registration, mint, burn and account opening prepare canonical shared payments, print disclosure before shared signing, submit through the SDK and require verified receipt commitments bound to the locally computed activity ID. RPC receipt waits accept independently supplied sequencer scope and checkpoint context pins. DID listing errors retain code, message and data. Formatting and all-target Clippy with -D warnings exit 0. cargo test --manifest-path platform/cli/Cargo.toml --no-fail-fast exits 101 solely at the retained lx_getAsset local-rejection assertion; all other tests pass, including the real encrypted credential store, emulator wallet paths, native Send differential fixture, policy bounds and error-preservation tests. Logs: qual-logs/pay3/pay3d-final-fmt.log, pay3d-final-clippy.log, pay3d-final-test.log and pay3d-readme-syntax.log."
assumption = "Send and token transfer still require the missing shared debit-authorization API. Token metadata/list reads use the CLI RPC transport because typed SDK methods are absent. These source and local-test results do not establish successful integrated public-RPC token execution or finality. Workspace Cargo.lock dependency regeneration is outside the owned CLI crate and is requested separately. No cluster, image or persistent-chain gates were run."
severity = "blocker"

[observation.6.11.6428]
task = "6.11"
file = "agent/crates/layerx-sdk/src/wallet.rs platform/cli/src/wallet.rs platform/cli/tests/fixtures/openrpc.json"
symbol = "prepare_payload execute_payment transfer"
observed = "The published gateway OpenRPC snapshot dfbb7bf42241a74b2a59fe61323250f7b2865a0e specifies lx_getSequence(account_id) as a source-account snapshot. SDK prepare_payload calls get_sequence with options.actor DID and requires authenticated_node_snapshot identity state. The published gateway rejects that selector, so token create, mint, burn and open-account cannot reach signing through this contract. The CLI preserves upstream refusal; it does not substitute source-account sequence for identity.next_sequence. Raw comparison: qual-logs/pay3/pay3e-identity-contract.log. Independent disclosure source 7 and envelope 19 signing and byte-substitution refusal pass in qual-logs/pay3/pay3e-independent-sequences.log."
assumption = "A separately specified authenticated identity-sequence read must be coordinated between gateway and SDK owners. Send additionally requires the queued inner debit-authorization signer and shared encoder. Funded unequal-sequence CLI SEND and live token execution have not run."
severity = "blocker"

[observation.6.11.6429]
