[observation.6.11.3000]
task = "6.11"
file = "Makefile tests/modules/test_stream_lifecycle.c tests/modules/test_escrow_dispute.c"
symbol = "test-stream-lifecycle test-escrow-dispute PROGRAMS_RUNTIME_LIB"
observed = "make CC=gcc test-stream-lifecycle exits 2 at the link step, not at any assertion. The recipe at Makefile:612-616 links tests/modules/test_stream_lifecycle.c against $(TEST_LIBRARY) alone with -lcrypto -pthread, while build/liblayerx-testing.a contains src/protocol/lxp_kernel.o, whose closure references the Rust staticlib symbols layerx_programs_call_begin, layerx_programs_occupancy_finalize_rust, layerx_programs_sandbox_admit_host, layerx_programs_sandbox_cancel_host, layerx_programs_sandbox_lifecycle_validate, layerx_programs_sandbox_destroy_host, layerx_programs_sandbox_destroy_terminal, layerx_programs_settle_wind_down_402lxp_leg, layerx_programs_authorize_402lxp_leg, layerx_programs_module_cache_invalidate_upgrade, layerx_programs_migration_execute_activity and layerx_programs_interface_validate; the link ends with make: *** [Makefile:615: build/tests/test_stream_lifecycle] Error 1. Every other kernel-linked test names $(PROGRAMS_RUNTIME_LIB) between two copies of the library and adds -ldl -lm, the precedent being Makefile:356-361, and the two stream tests that do reach the kernel, Makefile:572-577 and Makefile:601-606, already do. The escrow dispute recipe at Makefile:496-500 carries the identical omission. The failure predates this branch and reproduces on an unmodified tree. Linking the same translation unit by hand with the missing archive and libraries, gcc -Iinclude -Ibuild/generated -DLXP_TESTING with the repository CFLAGS over tests/modules/test_stream_lifecycle.c build/liblayerx-testing.a programs/target/debug/liblayerx_programs_sandbox.a build/liblayerx-testing.a -lcrypto -pthread -ldl -lm, produces a binary that runs the whole lifecycle suite and exits 0."
assumption = "Makefile is outside this issue's owned paths, so the recipe was left exactly as written and the suite was proven through the equivalent manual link instead. The repair is to add $(PROGRAMS_RUNTIME_LIB) and -ldl -lm to both recipes with programs-build as an order-only prerequisite, exactly as Makefile:356-361 does. No assertion in tests/modules/test_stream_lifecycle.c was altered to reach a link."
severity = "blocker"

[observation.6.11.3001]
task = "6.11"
file = "src/modules/stream/lx_stream_open.c src/modules/stream/lx_stream_settle.c src/modules/stream/lx_stream_lifecycle.c"
symbol = "fund_context lx_stream_draw_context lxp_kernel_apply_transfer_set"
observed = "make CC=gcc test-stream-open and make CC=gcc test-stream-settle both exited 1 on an unmodified tree before this branch. Every stream transfer context was built without source authorities, and lxp_kernel_apply_transfer_set refuses a set whose source_authorities is NULL or whose source_authority_count is zero with LXP_ERR_NON_CANONICAL, so no stream leg could ever be applied and funding, drawing and refunding were all unreachable. The funding context now names the payer under LXP_AUTH_OWNER, and the draw and refund contexts name the stream account under LXP_AUTH_PROTOCOL_MODULE, which is the only authorization lx_stream_authority_check accepts for a stream-kind account, alongside reasons LXP_REASON_STREAM_DRAW and LXP_REASON_STREAM_REFUND."
assumption = "The refusal in lxp_kernel_apply_transfer_set and the custody check in lx_stream_authority_check are both correct and unchanged; the missing source authority was the module's own defect and is repaired inside this issue's owned paths."
severity = "note"

[observation.6.11.3002]
task = "6.11"
file = "include/layerx/lx_stream.h src/modules/stream/lx_stream_execution.h cmd/layerxd platform/emulator"
symbol = "lx_stream_runtime lxp_ctx_module_runtime lxp_kernel_bind_module_runtime"
observed = "A stream may only fund, draw or refund an asset whose lxp_transfer_asset_state the host has published, and the stream module cannot read the asset module's key-value state from its own context. It therefore reads the permitted asset states from lxp_ctx_module_runtime, the shape lx_asset_runtime already uses, through the new lx_stream_runtime struct. No host binds a runtime at LXP_MODULE_STREAM: neither cmd/layerxd nor platform/emulator calls lxp_kernel_bind_module_runtime for that module id, so until one does, every LX_STREAM_OPEN and LX_STREAM_TOP_UP dispatch refuses with LXP_ERR_ASSET_MISMATCH instead of moving value. The refusal is deliberate and is asserted in tests/modules/test_stream_open.c before the fixture binds its own runtime."
assumption = "Refusing an unknown asset is the safe direction and no silent fallback was added. Binding the runtime belongs to the daemon and the emulator, which are outside this issue's owned paths."
severity = "blocker"

[observation.6.11.3003]
task = "6.11"
file = "src/protocol/lxp_kernel.c tests/modules/test_stream_open.c"
symbol = "lxp_kernel_bind_module_runtime"
observed = "lxp_kernel_bind_module_runtime refuses a NULL runtime with LXP_ERR_NON_CANONICAL at src/protocol/lxp_kernel.c:938-940, so a host that has installed a module runtime can never take it away and the binding is monotonic for the life of the kernel. The stream dispatch test asserts that refusal directly rather than assuming a bind and unbind cycle."
assumption = "The refusal is intentional: the argument is a raw void pointer, so a NULL bind would be indistinguishable from a module that was never bound. It is recorded because the property is stated nowhere else and because it means a host cannot use this entry point to revoke a published asset permission set."
severity = "note"

[observation.6.11.3004]
task = "6.11"
file = "src/modules/stream/lx_stream_state.c src/modules/stream/lx_stream_record.c src/protocol/lxp_genesis.c"
symbol = "lx_stream_state_key lx_stream_result_key lx_stream_record_encode lx_stream_result_save"
observed = "Stream state is now canonical module key-value state. Each stream is one 541-byte record under the key prefix stream: followed by its 32-byte identifier, and each settled or closed economic outcome is one 67-byte record under the prefix result: followed by its 32-byte idempotency key, carrying the transfer set root, the paid and refunded amounts, the ordinal and the leg count, so replaying a key reproduces the original receipt byte for byte. Both key forms are 39 bytes. This changes the module state root wherever the stream module is live. The genesis module table row for the stream module keeps LXP_GENESIS_MODULE_GATE_ENABLE_FLAG with enabled false, so no genesis snapshot, manifest or state-root fixture changes on this branch."
assumption = "Canonical key-value state is the only state the kernel commits and the only state a snapshot restores, so a module that keeps records anywhere else cannot survive a restart. Enabling the module at genesis and regenerating the affected fixtures is a separate change that must move every module row at once."
severity = "note"

[observation.6.11.3005]
task = "6.11"
file = "Makefile src/modules/stream/lx_stream_record.c src/modules/stream/lx_stream_meter.c"
symbol = "test-stream-accrual test-stream-meter LIBRARY"
observed = "Makefile:583-587 and Makefile:592-596 link test_stream_accrue and test_stream_meter against $(LIBRARY) alone with no Rust staticlib, so any symbol either test reaches must have a link closure that never touches src/protocol/lxp_kernel.o. The record codec and the accrual and meter arithmetic therefore live in context-free translation units: the 541-byte record codec and its validation moved into the new src/modules/stream/lx_stream_record.c, and src/modules/stream/lx_stream_meter.c keeps only the pure meter arithmetic, with the key-value write that a meter attestation performs done by the dispatch layer in src/modules/stream/lx_stream_execution.h. The split is imposed by the link topology of those two recipes, not by the module design."
assumption = "The two recipes are outside this issue's owned paths and were left as written. Keeping the arithmetic and the codec free of the module context is a real constraint that also keeps those two suites independent of the programs runtime."
severity = "note"

[observation.6.11.3006]
task = "6.11"
file = "Makefile"
symbol = "test core-test-all test-stream-open test-stream-accrual test-stream-meter test-stream-settle test-stream-lifecycle"
observed = "The make test target at Makefile:269-277 names no stream target. The five stream targets are reachable only through core-test-all at Makefile:2878-2879, which make test does not invoke, so a regression in the stream module cannot fail the aggregate gate. The five targets were therefore run individually and their logs recorded beside the aggregate run."
assumption = "Adding the stream targets to make test is a Makefile change outside this issue's owned paths, so the coverage was proven by running each target instead."
severity = "suspect"

[observation.6.11.3007]
task = "6.11"
file = "spec/layerx-beta/report.md tools/ci/beta-report.sh spec/layerx-beta/qualification.kvx"
symbol = "beta-report"
observed = "spec/layerx-beta/report.md is generated from the ledger and the contract by tools/ci/beta-report.sh and is committed in the same change as the ledger append that produced it. Because every branch that appends an observation regenerates the whole file, its counts and its per-task tables differ on every such branch, so any two concurrently open branches conflict on it even when their ledger appends merge cleanly. This branch was rebased onto a moving main six times; report.md conflicted on every one of them and qualification.kvx raised a conflict marker on none. The resolution for the report is mechanical and identical each time: take main's report.md, re-run tools/ci/beta-report.sh, and continue, after which tools/ci/beta-report.sh --check exits 0. The silent side is the ledger: on two of those rebases the marker-free merge consumed the closing severity line of main's final block, observation 5.4.7800 on one and observation 6.6.3704 on the other, together with the blank line separating it from the first block appended here, so that block would have reached main without its severity key and the ledger check would have refused the result. git diff reported no deleted line for it. The block-by-block comparison of main's ledger against this one caught both, and the file was rebuilt as main's content followed by the blocks appended here before the push."
assumption = "Committing the rendered report keeps the published evidence in step with the ledger, which is the reason the file is tracked, so it was regenerated rather than dropped from any commit. The conflict is inherent to tracking a whole-file rendering of an append-only record; resolving it by re-rendering never loses a ledger block, and the two ledger integrity checks confirmed after each rebase that every block main holds is present here byte for byte."
severity = "note"

[observation.6.5.4200]
task = "6.5"
file = "platform/hosted/gateway/deployment.yaml platform/hosted/tests/beta-cluster.sh platform/hosted/gateway/src/rpc_register.rs"
symbol = "LAYERX_GATEWAY_IDENTITY_PROVISIONING_TOKEN_FILE layerx-identity-service-tokens configured_token"
observed = "POST /v1/principals is accepted by the identity service only for the provisioning service token (platform/hosted/identity/src/main.rs line 874 routes it behind the provisioning caller), and the gateway pod does not hold that token. platform/hosted/gateway/deployment.yaml line 121 mounts only the secret layerx-gateway-identity-client at /run/layerx/identity and line 84 points LAYERX_GATEWAY_IDENTITY_TOKEN_FILE at its single gateway-scoped token; the provisioning token is written into a different secret, layerx-identity-service-tokens, under the key provisioning (platform/hosted/tests/beta-cluster.sh lines 562 and 814, read at line 1417). lx_register therefore reads its credential from a second variable, LAYERX_GATEWAY_IDENTITY_PROVISIONING_TOKEN_FILE, which is optional: when it is unset the method answers -32001 with data.code registration_not_configured instead of pretending to register. Until the deployment mounts the provisioning key into the gateway pod and sets that variable, the public registration path refuses on the beta cluster."
assumption = "platform/hosted/gateway/deployment.yaml and platform/hosted/tests/beta-cluster.sh are outside this row's owned paths, so the mount and the variable were not added here; the request is recorded in the lane's NEEDS.md as well. The wiring is one extra volume entry, one mountPath and one environment variable, mirroring the identity client mount beside it."
severity = "blocker"

[observation.6.5.4201]
task = "6.5"
file = "platform/hosted/identity/src/store.rs platform/hosted/gateway/src/rpc_register.rs"
symbol = "put_principal Store::principals subject"
observed = "Store::put_principal at platform/hosted/identity/src/store.rs line 107 inserts into the principal map by sub, so a second POST /v1/principals for an existing sub replaces its allowed_signer_public_keys rather than refusing. Any caller that can choose sub can therefore rebind another principal's signing keys. The public method closes this at the gateway rather than at the store: the subject is not a parameter, it is derived as beta. followed by the first thirty-two hexadecimal characters of a domain-separated SHA-256 over the length-prefixed tuple (layerx-register-subject-v1, tenant, signer public key), and the caller must present an Ed25519 signature over the sibling binding digest (layerx-register-binding-v1, tenant, signer public key) before the gateway spends its provisioning token. A caller can consequently only ever write the principal that its own key already owns, and replaying the call is idempotent. The overwrite in the store is untouched and remains reachable by every other provisioning-token holder."
assumption = "platform/hosted/identity is outside this row's owned paths, so no refusal was added to put_principal; the safe behaviour of the public path is enforced by derivation and proof of possession at the gateway. A later change that makes put_principal refuse a sub whose allowed_signer_public_keys would change does not break this method, because it writes the same key set every time."
severity = "note"

[observation.6.5.4202]
task = "6.5"
file = "platform/hosted/gateway/src/rpc_register.rs"
symbol = "REGISTER_WINDOW consume_registration REGISTRATIONS_PER_MINUTE"
observed = "The row's default is self-registration bounded by a rate limit, and the bound implemented here is a per-process minute window: a static mutex holds (minute, count) and refuses beyond thirty registrations in the same minute with -32005 and data.code registration_rate_limit. The gateway Deployment runs more than one replica, so the effective cluster budget is thirty per replica per minute, not thirty per minute. The limiter is deliberately split into a pure consume(window, minute) that the tests exercise against a local tuple and a consume_registration() that locks the static, so a later shared-counter implementation replaces only the second function."
assumption = "A shared limiter would need the gateway's redis handle and a key namespace agreed with the other rate-limited public methods, which is a cross-lane decision; the process-local bound was chosen because it is honest, testable and strictly tighter than no bound. Registration is idempotent, so a refused call costs the caller a retry and nothing else."
severity = "note"

[observation.6.5.4203]
task = "6.5"
file = "platform/cli/src/account.rs platform/hosted/core/src/main.rs"
symbol = "account::create unavailable_capability /v1/accounts"
observed = "layerx account create against a hosted environment posts to /v1/accounts (platform/cli/src/account.rs line 57) and the hosted core answers that path as an unavailable capability (platform/hosted/core/src/main.rs line 1295 lists /v1/accounts in unavailable_capability), so the published account-creation command cannot succeed against beta. The new layerx register command does not go through that path: it calls lx_register on the gateway, which provisions an identity principal bound to a local signing key, and it neither creates nor needs a core account. The two commands are therefore not substitutes - registration establishes who the caller is, account opening establishes where value sits - and the second half of the onboarding path is still unserved."
assumption = "platform/hosted/core is outside this row's owned paths and the account shape is an owner decision recorded elsewhere; layerx account create was left exactly as written rather than repointed at the new method."
severity = "blocker"

[observation.6.5.4204]
task = "6.5"
file = "platform/hosted/gateway/src/rpc.rs platform/hosted/gateway/openrpc.json"
symbol = "schema_lists_every_public_method"
observed = "The gateway test schema_lists_every_public_method asserts the exact method count of openrpc.json, and this change raises it from fifteen to sixteen. Two sibling changes add one public method each in the same way, so the assertion line and the methods array are the only places the three meet. The additions here were shaped to keep that meeting small: the lx_register entry is the first element of the methods array, the dispatch is a three-line block placed immediately after the method name is read in rpc.rs rather than inside the existing match, and the module declaration, the Config field and its initialiser are one line each. Integrating all three needs the count raised to eighteen once, and nothing else."
assumption = "The count assertion is a real check on the schema and was not loosened or replaced by a lower bound; the conflict is expected and mechanical."
severity = "note"

[observation.6.5.4205]
task = "6.5"
file = "platform/emulator/build.rs Makefile"
symbol = "layerx-platform-emulator build script programs-build PROGRAMS_CARGO"
observed = "cargo test --manifest-path platform/Cargo.toml -p layerx-platform-cli deadlocks whenever CARGO_TARGET_DIR is exported, which is how the shared-target qualification environment runs every platform gate. layerx-platform-cli depends on layerx-platform-emulator, whose build script runs make build in the repository root (platform/emulator/build.rs line 31). The C build orders programs-build ahead of the objects that need the sandbox archive, and programs-build runs cd programs && $(PROGRAMS_CARGO) build (Makefile line 3002) with PROGRAMS_CARGO defaulting to plain cargo (line 2987). That inner cargo inherits the exported CARGO_TARGET_DIR, so it blocks forever on the build-directory lock the outer cargo already holds. Observed directly: the outer cargo sat in state Sl for twenty-eight minutes with its build-script child parked on make and two grandchild shells parked on cd programs && cargo build, no rustc process alive in the tree. Running the same gate with PROGRAMS_CARGO='env -u CARGO_TARGET_DIR cargo' completes, because the inner build then writes to programs/target, which is also the only place the Makefile looks for it - PROGRAMS_RUNTIME_LIB is the literal path programs/target/debug/liblayerx_programs_sandbox.a (line 2988), so redirecting the inner build anywhere else breaks the link instead."
assumption = "Neither platform/emulator/build.rs nor the Makefile was changed: both are outside this row's owned paths, and the safe repair is a one-line env -u CARGO_TARGET_DIR (or an explicit programs/target) on the programs-build recipe rather than anything this row could decide. The gate was run with the environment override and its log records that invocation."
severity = "blocker"

[observation.6.6.4000]
task = "6.6"
file = "paxeer-network/consensus/config/autobahn.go paxeer-network/consensus/node/setup.go paxeer-network/consensus/internal/autobahn/consensus/persist/persist.go"
symbol = "AutobahnFileConfig.Validate AutobahnFileConfig.ConsensusPersistentStateDir UnsafeTestOnlyDisablePersistence buildGigaConfig NewPersister newNoOpPersister"
observed = "persist.NewPersister returns newNoOpPersister whenever it is handed no state dir, and that no-op persister reports every write as a success while discarding it, so a validator configured without persistent_state_dir kept its whole consensus safety state in memory and came back after a restart with no record of the views it had entered or the votes it had cast, which is the shape that produces equivocation and slashing. AutobahnFileConfig.Validate checked validators, max_txs_per_block, max_txs_per_second, block_interval, view_timeout and dial_interval and never looked at persistent_state_dir, and node/setup.go's buildGigaConfig copied the field straight into the consensus config, so both layers accepted the unsafe configuration silently. Validate now refuses an absent persistent_state_dir with ErrPersistentStateDirRequired, refuses a blank one with ErrPersistentStateDirBlank, and refuses the combination of a state dir and the opt-out with ErrPersistenceOptOutConflict. buildGigaConfig no longer reads the field: it derives the dir through the checked accessor ConsensusPersistentStateDir, so the construction site of the consensus config refuses the no-op persister on its own rather than trusting that Validate already ran. The single way to reach the no-op persister is the new boolean unsafe_test_only_disable_persistence, which is named for what it costs, defaults to false so every existing config file and every config that simply omits the dir fails closed, and is mutually exclusive with persistent_state_dir so a config cannot state both intents at once."
assumption = "An opt-out is kept rather than removed because throwaway test networks legitimately run in memory and the data-layer WAL in internal/p2p/giga_router.go piggybacks on the same option; making the opt-out an explicit, unsafely named field keeps that use working while removing the silent default. The field defaults to false, so this is a refusal for any operator config that previously relied on an absent persistent_state_dir."
severity = "note"

[observation.6.6.4001]
task = "6.6"
file = "paxeer-network/consensus/cmd/tendermint/commands/gen_autobahn_config.go"
symbol = "MakeGenAutobahnConfigCommand persistent-state-dir"
observed = "The gen-autobahn-config command defaults --persistent-state-dir to data/autobahn and documents that passing --persistent-state-dir= empty disables persistence and runs in-memory only. With the state dir now required, the empty form writes a config file carrying neither persistent_state_dir nor unsafe_test_only_disable_persistence, and the node refuses that file at load with ErrPersistentStateDirRequired. The default path is unaffected: paxeer-network/docker/localnode/scripts/step4_config_override.sh invokes the command without the flag and therefore still gets data/autobahn. The generator needs a matching explicit flag so that an operator who wants an in-memory test network emits unsafe_test_only_disable_persistence instead of an unloadable file."
assumption = "cmd/tendermint/commands is outside this lane's owned paths, so the generator was left as it is. The failure mode it now produces is fail-closed and its message names the field the operator must set, but the flag it advertises no longer does what it says."
severity = "blocker"

[observation.6.6.4002]
task = "6.6"
file = "paxeer-network/consensus/autobahn/types/msg.go paxeer-network/consensus/internal/autobahn/consensus/inner_test.go paxeer-network/consensus/internal/autobahn/consensus/persist/blocks_test.go paxeer-network/consensus/internal/autobahn/data/state_test.go"
symbol = "types.Sign makePrepareQC testSignedProposal TestLaneQC TestNewInnerCurrentViewPrepareQCInvalidSignatureError TestPersistBlockAndLoad TestPushQCStaleQCDoesNotCorruptState"
observed = "go test ./... in paxeer-network/consensus exits 1 with three packages panicking at autobahn/types/msg.go:167 with autobahn signing key is not bound to a committee: internal/autobahn/consensus at inner_test.go:797 through makePrepareQC, internal/autobahn/consensus/persist at blocks_test.go:17 through testSignedProposal, and internal/autobahn/data at state_test.go:154 through TestLaneQC. The panic aborts each test binary, so the remaining tests in those three packages never run. The failures predate this lane: the same three panics reproduce on the unmodified worktree, and go list -deps -test shows that none of the three packages compiles against consensus/config or consensus/node, the only non-test packages this lane changed, so this lane's edits are not in those binaries at all."
assumption = "The signing key is bound to a committee by the test fixtures in those packages, which are outside this lane's owned paths, so the failures are recorded rather than repaired. The two persist tests this lane added were run selectively and pass; the aborted binary is what hides them in an aggregate run."
severity = "blocker"

[observation.6.6.4003]
task = "6.6"
file = "paxeer-network/consensus/internal/libs/clist paxeer-network/consensus/rpc/jsonrpc/server/http_server_test.go paxeer-network/consensus/.gitignore paxeer-network/consensus/internal/p2p/pex paxeer-network/consensus/internal/autobahn/consensus/persist/persist_test.go"
symbol = "TestGCRandom TestServeTLS TestReactorErrorsOnReceivingTooManyPeers TestPersistWriteErrorReturnsError TestPersistWriteErrorDoesNotAdvanceSeq TestLoadPersistedOSErrorPropagates"
observed = "Three further failure shapes appear in the same aggregate run, none of them in a package that compiles against consensus/config or consensus/node. internal/libs/clist hangs in TestGCRandom until the ten minute test timeout in both runs of the suite. rpc/jsonrpc/server fails TestServeTLS, which calls ServeTLS with the fixture pair test.crt and test.key at http_server_test.go:93: test.crt is tracked, but test.key is matched by the *.key rule at .gitignore:64 and is therefore absent from every checkout, so the test cannot pass in a fresh clone; it surfaced as open test.key: no such file or directory in the second run and as a ten minute hang in the first, because the test only reads the ServeTLS error channel for 100 milliseconds before issuing the HTTPS request. internal/p2p/pex is flaky between the two runs: TestReactorErrorsOnReceivingTooManyPeers hung to the ten minute timeout in the first and the package passed in 0.721s in the second. Separately, three persist tests fail whenever the suite runs as uid 0: TestPersistWriteErrorReturnsError, TestPersistWriteErrorDoesNotAdvanceSeq and TestLoadPersistedOSErrorPropagates all revoke write permission on the state directory with chmod and then require an error, but the effective user bypasses Unix permission checks so every call succeeds. persist.go already documents that limitation for its own writability probe, saying that checking permission bits is not reliable because root bypasses permission checks on Unix, so the probe uses a temp file instead; the three tests still use the bit-based approach that comment rejects."
assumption = "None of these tests is in this lane's issue and no assertion in them was touched. TestServeTLS needs its key fixture generated at test time or exempted from the *.key ignore rule; the three chmod tests need a mechanism that denies writes to the effective user regardless of privilege, or an explicit skip when the effective user can bypass permissions. Both belong with the owners of those test fixtures."
severity = "blocker"

[observation.6.11.3200]
task = "6.11"
file = "src/modules/perps/lx_perps_dispatch.c src/modules/perps/lx_perps_state.c include/layerx/lx_perps.h src/protocol/lxp_genesis.c"
symbol = "lx_perps_module_iface activity_types module_decode module_validate module_execute"
observed = "The perpetuals module now dispatches every ordinal it advertises. lx_perps_module_iface lists eleven ascending activity types 0x00060001 through 0x0006000b - market create, market halt, oracle push, order place, order cancel, position open, position increase, position close, funding tick, liquidate and auto-deleverage - and module_decode, module_validate and module_execute cover all eleven, where before only market create had a path. All module state is canonical key-value state under six prefixes: market: (39-byte key, 622-byte record), oracle: (39, 72), funding: (40, 57), deficit: (40, 56), order: (70, 170) and position: (73, 211), so every record survives a restart through the ordinary snapshot path and contributes to the module subtree root. The genesis module table row for the perpetuals module at src/protocol/lxp_genesis.c:55-56 keeps LXP_GENESIS_MODULE_GATE_ENABLE_FLAG with enabled false and was not touched, so no genesis snapshot, manifest or state-root fixture changes on this branch."
assumption = "A module that keeps state outside the kernel key-value space cannot be replayed or snapshotted, so every ordinal writes canonical records only. Enabling the module at genesis and regenerating the affected fixtures is a separate change that must move every disabled module row at once."
severity = "note"

[observation.6.11.3201]
task = "6.11"
file = "src/protocol/lxp_module_ctx.c src/ledger/lxp_journal.c src/modules/perps/lx_perps_liquidate.c include/layerx/lx_perps.h"
symbol = "emit_transfer_set transfer_applied lxp_apply_transfer_set lx_perps_liquidation_legs_build"
observed = "A module context may emit at most one transfer set for the life of an activity: src/protocol/lxp_module_ctx.c:1333 refuses a second emission with LXP_ERR_BALANCE_BYPASS once ctx->transfer_applied is set at line 1394. Every perpetuals operation that moves value therefore builds one multi-leg set rather than a sequence of single-leg transfers, and because lxp_apply_transfer_set at src/ledger/lxp_journal.c:241-243 runs lxp_precondition_check per leg against the actual per-source authority table, each distinct debit source in a set needs its own lxp_transfer_source_authority entry. lx_perps_liquidation_legs_build gained the authorities, capacity and authority_count parameters for this reason, and lx_perps_source_authority_add was added so the liquidation and auto-deleverage builders can accumulate one entry per source without duplicates. The four perpetuals test binaries that moved value - position, funding, liquidate and insurance - exited 1 on the base commit bae8bf98e because their fixtures emitted several single-leg sets on one context and left context.source_authorities empty; the rewritten fixtures drive the kernel dispatch entry point instead and pass."
assumption = "The one-set-per-activity rule and the per-source authority table are ledger invariants, not perpetuals policy, so the module was shaped around them rather than the other way round. Neither check was relaxed."
severity = "note"

[observation.6.11.3202]
task = "6.11"
file = "src/modules/perps/lx_perps_position.c src/ledger/lxp_journal.c src/modules/perps/lx_perps_dispatch.c"
symbol = "lx_perps_authority_check execute_position_close lxp_apply_transfer_set"
observed = "lx_perps_authority_check at src/modules/perps/lx_perps_position.c:8-23 permits a debit from an LX_ACCOUNT_AGENT_MARGIN account only for the reasons MARGIN_RELEASE, TRADING_LOSS, LIQUIDATION_FEE and ADL. FUNDING is not among them, so accrued funding can never be paid straight out of a margin account. Position close therefore emits one two-leg set: the margin balance is released to the owner main account with reason MARGIN_RELEASE under the module authority, and the funding settlement is the second leg - owner main to the side funding pool under the owner's own authority when the trader owes, or the side pool to owner main under the module authority when the trader is owed. This is only correct because lxp_apply_transfer_set interleaves lxp_precondition_check and lxp_balance_apply_leg per leg at src/ledger/lxp_journal.c:241-243, so the released margin is already credited to the main account before the funding debit is checked against it."
assumption = "Widening lx_perps_authority_check to accept FUNDING from a margin account would remove the guarantee that a margin balance leaves only through a settlement reason, so the ordering was changed instead of the check. The dependency on per-leg interleaving is recorded because a future change to batch all precondition checks ahead of all applications would break close."
severity = "suspect"

[observation.6.11.3203]
task = "6.11"
file = "src/modules/perps/lx_perps_dispatch.c include/layerx/lx_perps.h"
symbol = "execute_funding_tick book_mid_price lx_perps_funding_rate long_funding_account_id short_funding_account_id"
observed = "The funding tick takes its mark from the resting order book mid and its index from the latest accepted oracle price, clamps the resulting rate to the market's maximum_funding_rate_bps, and moves the amount between the two system funding accounts named in the market record - a positive rate moves the long pool to the short pool. The amount is computed on matched open interest, the smaller of the long and short open notional held in the funding state record, so the two sides always fund each other and the pools are not drained by an unbalanced book. When the book has no two-sided quote, or matched open interest is zero, the rate is forced to zero and the tick only advances the funding index and last_funding_timestamp_ms. A tick before funding_interval_ms has elapsed is refused with LXP_ERR_NOT_YET_VALID. The two funding pool accounts must be capitalized before a market runs: the pool that pays is debited like any other account, so an empty pool refuses the tick with LXP_ERR_INSUFFICIENT_BALANCE."
assumption = "This is the row's DEFAULT decision recorded as required. Funding on matched open interest with a book-mid mark is the conventional construction and the only one that keeps the pools conserved without an external subsidy; the capitalization requirement is a genesis or treasury concern outside this issue's owned paths and is recorded rather than solved here."
severity = "note"

[observation.6.11.3204]
task = "6.11"
file = "src/modules/perps/lx_oracle_checks.c src/modules/perps/lx_perps_dispatch.c"
symbol = "lx_oracle_deviation_check maximum_deviation_basis_points"
observed = "lx_oracle_deviation_check computes the allowed move as maximum_deviation_basis_points applied to the previously accepted price and refuses LXP_ERR_ORACLE_DEVIATION when the absolute difference exceeds it. The basis-point field is bounded at 10000, so a single accepted observation can at most double the price, and no configuration permits a larger single step. Any scenario that needs a fourfold price move - the liquidation and auto-deleverage fixtures do - has to push the price in successive observations. This is a real rate limit on how fast a market can reprice, not a fixture artifact: a genuine gap larger than the configured band cannot be admitted at all until enough observations have walked the price across it."
assumption = "The ceiling is intentional protection against a single bad observation. It is recorded because it means an oracle outage spanning a large real move leaves the market unable to catch up in one observation, and liquidations during that window price off a stale-but-admitted price."
severity = "suspect"

[observation.6.11.3205]
task = "6.11"
file = "src/modules/perps/lx_oracle_checks.c src/modules/perps/lx_oracle_halt.c src/modules/perps/lx_perps_dispatch.c"
symbol = "lx_oracle_key_set_check lx_oracle_staleness_check lx_oracle_bounds_check market_loaded"
observed = "None of the oracle admission checks consults the halted flag: lx_oracle_key_set_check, lx_oracle_staleness_check, lx_oracle_deviation_check and lx_oracle_bounds_check all ignore it, and src/modules/perps/lx_oracle_halt.c only exposes the flag and a separate refusal helper. A halted market therefore still accepts oracle pushes and keeps its price current. Halting is enforced in dispatch instead, by market_loaded with refuse_halted set for the ordinals that move value or open risk - order place, position open, position increase, funding tick and liquidate - which return LXP_ERR_MARKET_HALTED. The market test proves the refusal through the funding tick rather than through an oracle push for this reason."
assumption = "Continuing to accept observations while halted is the useful behaviour, because the price must be current again the moment the market resumes. It is recorded because a reader would reasonably expect a halt to stop every ordinal, and because the halt boundary lives entirely in dispatch and would be lost by any caller that reaches the oracle helpers directly."
severity = "note"

[observation.6.11.3206]
task = "6.11"
file = "src/modules/perps/lx_perps_dispatch.c src/modules/perps/lx_perps_liquidate.c"
symbol = "execute_liquidate lx_perps_liquidate_execute deficit_accumulate lx_perps_liquidation_legs_build"
observed = "Liquidation computes the trading loss at the current mark and then caps the amount it will actually settle at the margin balance plus the insurance balance, recording the uncovered residue as a deficit record under the deficit: prefix for the market. Without the cap lx_perps_liquidation_legs_build refuses the whole liquidation with LXP_ERR_INSUFFICIENT_BALANCE whenever the loss exceeds what the system holds, which would leave an underwater position open and unliquidatable. lx_perps_liquidate_execute additionally refuses with LXP_FATAL_INVARIANT unless the margin account is exactly zero after the emission, so a liquidation always drains the margin account completely: the trading loss leg takes what it can, the fee legs take from what is left, and the residual margin is released to the owner. The liquidator fee is split by liquidator_share_bps with the insurance share rounded up, and both fee legs are skipped when nothing remains."
assumption = "This is the row's DEFAULT decision. Capping at available capacity and recording the shortfall is the only construction that both closes the position and keeps the ledger conserved; the alternative - refusing the liquidation - is strictly worse for solvency. The deficit record is what the auto-deleverage ordinal consumes."
severity = "note"

[observation.6.11.3207]
task = "6.11"
file = "src/modules/perps/lx_perps_dispatch.c src/modules/perps/lx_perps_insurance.c include/layerx/lx_perps.h"
symbol = "execute_adl validate_adl lx_perps_adl_execute LX_PERPS_DISPATCH_MAX_ADL"
observed = "Auto-deleverage consumes the deficit record a liquidation left behind. Each named position must be open and strictly profitable at the current mark - a non-positive unrealized result is refused with LXP_ERR_AGREEMENT_STATE - and each contributes at most the smaller of its unrealized profit and its margin balance. lx_perps_adl_execute sorts the candidates by position identifier so the set is order-independent, draws from them in that order until the deficit is covered, and refuses the whole activity with LXP_ERR_INSUFFICIENT_BALANCE when the named set cannot cover it, leaving the deficit record intact for another attempt with more counterparties. The deficit record is deleted only on full coverage. A position whose margin reaches zero is closed and its open interest removed. The command carries at most LX_PERPS_DISPATCH_MAX_ADL, sixteen, positions, which is the bound imposed by the maximum legs a single transfer set can hold."
assumption = "This is the row's DEFAULT decision. Taking only from profitable counterparties, only up to their profit, is the standard socialized-loss rule and the only one that cannot take a counterparty below its own entry. The sixteen-position bound comes from the transfer set leg limit and is recorded because a deficit larger than sixteen counterparties can cover needs several activities."
severity = "note"

[observation.6.11.3208]
task = "6.11"
file = "src/modules/perps/lx_perps_dispatch.c include/layerx/lx_perps.h"
symbol = "execute_order_place lx_perps_order_place_execute LX_PERPS_DISPATCH_MAX_FILLS"
observed = "Order placement moves no value. lx_perps_order_place_execute always reports zero transfer legs; it checks the order's initial margin requirement, the ceiling of price times quantity times initial_margin_ratio_bps over 10000, against the balance of the named margin account that is not already committed to resting orders, refusing LXP_ERR_MARGIN_INSUFFICIENT otherwise, and that check runs before matching so a rejected order never partially fills. Matching is bounded at LX_PERPS_DISPATCH_MAX_FILLS, eight, resting orders per placement; the residue rests. Margin is only debited when a position is opened or increased, so a filled order does not by itself move a balance."
assumption = "This is the row's DEFAULT decision: fills are book state, and the position ordinals are the only ones that move margin, which keeps the one-transfer-set-per-activity rule satisfiable for a placement that crosses several levels. The eight-fill bound is recorded because a placement that would cross more levels leaves the remainder resting rather than refusing."
severity = "note"

[observation.6.11.3209]
task = "6.11"
file = "Makefile"
symbol = "test core-test-all test-wave-9 test-perps-market test-perps-book test-perps-margin test-perps-funding test-perps-liquidation test-perps-insurance"
observed = "The make test target at Makefile:267-274 names no perpetuals target. The six perpetuals suites are grouped in test-wave-9 at Makefile:819-820 and are reachable only through core-test-all at Makefile:2827-2835, which make test does not invoke, so a regression in the perpetuals module cannot fail the aggregate gate. make CC=gcc test-wave-9 was therefore run explicitly beside the aggregate run and its log recorded."
assumption = "Adding test-wave-9 to make test is a Makefile change outside this issue's owned paths, so the coverage was proven by running the wave target directly. The request is recorded for whoever owns the Makefile."
severity = "suspect"

[observation.6.11.3210]
task = "6.11"
file = "src/protocol/lxp_module_ctx.c tests/modules/test_perps_market.c"
symbol = "lxp_module_ctx_commit staged"
observed = "lxp_module_ctx_commit at src/protocol/lxp_module_ctx.c:651 flushes the staged key-value writes into the store but does not clear ctx->staged, so a context reused after a commit still carries the writes it already published. A key-value iteration on such a context visits every committed record a second time and any read-back count is doubled. Every read-back assertion in the six perpetuals fixtures therefore opens a fresh context first."
assumption = "The kernel opens a new context per activity, so no production path reuses a committed context and the residue is harmless there. It is recorded because it is invisible at the call site and any test or tool that holds a context across a commit silently double-counts."
severity = "suspect"

[observation.6.11.3211]
task = "6.11"
file = "src/modules/perps/lx_perps_dispatch.c src/protocol/lxp_module_ctx.c"
symbol = "emit_identifier_event lxp_ctx_emit_event"
observed = "emit_identifier_event at src/modules/perps/lx_perps_dispatch.c:437 assembles every perpetuals event body as two 32-byte identifiers followed by an ordinal-specific tail and refuses a tail that would not fit its buffer with LXP_ERR_LENGTH_LIMIT. The buffer holds 128 bytes, which admits the longest tail any ordinal produces - the funding tick's two signed 17-byte encodings, and the auto-deleverage count plus 16-byte deficit amount - against the 256-byte body limit lxp_ctx_emit_event enforces. An earlier 96-byte buffer left only 32 bytes of tail and made the funding tick unreachable; the buffer was widened rather than the guard removed."
assumption = "The guard is the load-bearing check and was left exactly as written; only the buffer it measures grew, and it still sits well inside the kernel's own 256-byte limit."
severity = "note"

[observation.6.11.6500]
task = "6.11"
file = "src/modules/programs/call.c programs/crates/layerx-programs-runtime/src/transfer.rs include/layerx/lxp_transfer.h src/protocol/lxp_module_ctx.c src/ledger/lxp_apply.c"
symbol = "transfer_source_validate layerx_programs_call_transfer_apply TransferSource::account"
observed = "Principal-funded Programs transfers compare leg.from.id to authority.principal, look up the sequence account by authority.principal and encode principal bytes as the source account. The shared payments contract instead identifies the actor by signer DID and derives native/per-asset accounts independently. SDK preparation now produces the existing native registration payload, program-account derivation and bounded funding/spend requests, but does not reconcile this identity/account boundary."
assumption = "Complete DID/per-asset program funding requires an authenticated owner-to-account mapping and identity.next_sequence integration across the module context, ledger, Programs transfer evidence and native call tests. Do not substitute an account ID for the signer DID or relax source ownership assertions. The merchant guest is built but its settlement round trip remains unqualified."
severity = "blocker"

[observation.6.11.6501]
task = "6.11"
file = "programs/crates/layerx-programs-registry/src/interface.rs programs/crates/layerx-programs-runtime/src/validate.rs programs/sdk/rust/src/lxt20.rs"
symbol = "InterfaceCapability ProgramInterface::bind exact_interface_capability_mask"
observed = "The LXT-20 request codec covers transfer, approve, transfer_from, balance_of, allowance, total_supply and metadata with committed canonical calldata vectors. Registry interfaces currently encode concrete ProgramSpend destinations and ceilings and require exact imported capability masks. No generic dynamic-recipient interface representation, published LXT-20 interface hash, token-lxt20 settlement reference or token native deploy/call evidence was produced. Codec/parser tests are not execution tests."
assumption = "A complete token interface needs agreed canonical discovery semantics for caller-authorized dynamic recipients, native consumer conformance and a real settlement reference with atomic allowances and refusal coverage. Existing interface bounds and exact capability checks remain intact."
severity = "blocker"

