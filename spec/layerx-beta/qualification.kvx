[observation.6.11.154]
task = "6.11"
file = "platform/hosted/identity/src/main.rs platform/hosted/gateway/tests/local/lifecycle.rs"
symbol = "PrincipalRequest tenant local_gateway_lifecycle local_gateway_rpc local_gateway_websocket_receipt_wake"
observed = "With the fixture adapter repaired, all three local gateway lifecycle tests fail at the same assertion: the principal provisioning call to /v1/principals answers 400 where 200 is required. 38de71338 made tenant a required field of PrincipalRequest under deny_unknown_fields in the identity service, and validates it as a subject without a colon. No revision of platform/hosted/gateway/tests/local/lifecycle.rs contains the word tenant: neither 0717c87ca, nor f89cb11c0, nor the integrated tip, so the provisioning body carries sub, allowed_signer_public_keys, account and audiences only. platform/hosted/identity/src/main.rs is byte-identical to 0717c87ca. The identity service tests and platform/hosted/tests/beta-cluster.sh do send tenant, so the local harness is the only caller left behind. Evidence: qual-logs/rebase-205-9a.log, qual-logs/rebase-205-9b.log and qual-logs/rebase-205-9c.log."
assumption = "The refusal is reproducible from an unmodified checkout of 0717c87ca once the fixture adapter compiles, and it stayed unnoticed because the harness had not compiled since 72c986271. Both provisioning bodies now carry the beta tenant that platform/hosted/identity/tests/service.rs and platform/hosted/tests/beta-cluster.sh already send, a subject without a colon shaped exactly like theirs, completing the contract change of 38de71338 for the last callers left behind; the repair is recorded in 1b7a3c8dbc89f80c1109912a8afe18bd34af84a4. Only the two provisioning bodies changed: platform/hosted/identity/src/main.rs, PrincipalRequest, its validation and every one of the six harness tests and their assertions are unchanged, and this branch's own lifecycle.rs edits remain in place. Provisioning is then admitted with 200 and all three tests proceed past it."
severity = "blocker"

