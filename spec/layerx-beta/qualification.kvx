[observation.6.2.936]
task = "6.2"
file = "platform/hosted/gateway/src/http.rs platform/hosted/gateway/src/store.rs platform/hosted/gateway/src/main.rs platform/hosted/gateway/src/rpc.rs platform/hosted/core/src/main.rs platform/hosted/core/tests/boundary.rs platform/hosted/gateway/tests/local/lifecycle.rs cmd/layerxd/lxp_daemon_lni.c platform/hosted/authority/src/main.rs"
symbol = "request_authorized_traced command reserve_activity authority complete_activity await_receipt journal_write serve_connection assert_funded_commitments"
observed = "Monotonic SEND spans cover ingress, authentication, canonical verification, reservation, component submission, native admission and publication wait, receipt authority and verification, journal commits and completion. Authenticated Redis reuse, bounded HTTP keep-alive, append-only fsynced journals and single RPC signature verification reduce twenty-SEND p50/p99 from 1905191/3220361 us to 698890/1178527 us. Aligned gateway/core overhead beyond native falls from 1026339/2239358 us to 246797/435914 us, so the 100000 us p50 target remains unmet. Final reservation, authority and completion-persistence p50 values are 7963, 106440 and 9727 us. The unchanged finalised-success assertion fails after all twenty executed SENDs and batched evidence because the production RPC returns typed -32001 pending evidence without a matching signed checkpoint. Reused LNI receipt connections were removed after native measured the next request deadline before its idle frame read and returned -303 with PeerShutdown. Strict clippy, focused unit and real daemon-down journal tests, touched-file rustfmt and diff checks pass; workspace-wide cargo fmt --all --check retains formatting drift outside the touched paths. Evidence: qual-logs/pay4/j/before-funded-local-native.log, before-stage-summary.json, after-funded-published-source-rerun.log, after-published-stage-summary.json, clippy-published-source.log, core-journal-unit-final.log, core-boundary-journal-final.log, rustfmt-touched-check-final-rerun.log, diff-check-final-rerun2.log and fmt-check-final-rerun.log."
assumption = "Authority publication notification, authority-side connection reuse, native per-request deadline placement, and positive checkpoint evidence require their owning contracts. No durability, authentication, receipt, finality, assertion or typed refusal was weakened."
severity = "blocker"

[observation.6.2.937]
task = "6.2"
file = "cmd/layerxd/lxp_daemon_lni.c platform/hosted/authority/src/main.rs platform/hosted/authority/src/human.rs platform/hosted/authority/tests/real_node.rs platform/hosted/core/tests/boundary.rs platform/hosted/gateway/src/main.rs platform/hosted/gateway/tests/local/checkpoint_settlement.py platform/hosted/gateway/tests/local/funding.rs platform/hosted/gateway/tests/local/lifecycle.rs"
symbol = "serve_connection send_receipt handle_connection lookup_receipt by_activity submit_upstreams authority_response finalise_first_batch assert_funded_commitments"
observed = "The authenticated authority now accepts bounded persistent TLS requests and exposes a publication-notified lookup backed by the native receipt-commit condition. The gateway overlaps that lookup and independent maintained-evidence verification with component execution, then constant-time matches the authority-verified receipt to the component receipt before completion. Native LNI idle-frame and request execution deadlines are separate. The same twenty funded SEND harness passes with end-to-end p50/p99 516916/1014150 us, native total 438334/869645 us, and aligned gateway/core overhead 92564/356591 us, meeting the 100000 us overhead p50 bound. Before values were 698890/1178527 us end to end, 458158/882122 us native, and 246797/435914 us overhead. New native prepare, commit/WAL and publication p50/p99 values are 30919/126980, 122230/270614 and 156941/430292 us. Reservation, authority verification and completion persistence p50/p99 values are 6269/57743, 18511/49134 and 6771/32742 us; the residual post-join authority match is 22/249 us. A disposable Paxeer chain with real bond and checkpoint registry contracts produces and registers exact batch-1 finality evidence; the authenticated checkpoint read succeeds, while a later unfinalised SEND retains typed -32001 pending evidence. Evidence: qual-logs/pay4/k/funded-send-overlap-final.log and measurement-summary.md."
assumption = "Nested stage percentiles are diagnostic and not additive. Native commit/WAL and publication remain independently owned performance work. The positive finality assertion covers the registered first batch and does not reclassify later batches without matching checkpoint evidence."
severity = "note"

