[observation.5.1.11]
task = "5.1"
file = "platform/emulator/src/native_call.rs platform/sdk/conformance/fixtures/native-program-call-v3.json tests/programs/test_call_activity.c src/modules/programs/call.c"
symbol = "exact_native_json_and_scope_bindings native_json_and_octet_routes_retain_original_signed_bytes"
observed = "formerly observation.5.1.focused-native-call-fixture-binding. cargo test --locked --manifest-path platform/Cargo.toml -p layerx-platform-emulator --lib native_call exits 0 on detached origin/main 0c95c0cfd06a962d31dd192f1b43fff5b4e347e8 (two tests pass; qual-logs/r15/main-native-call.log), and 101 on unchanged native base 97e7e9097daeab58d18d801d8e7297692f3fc9d1 (both fail with native signed activity does not match request; native-baseline.log). The same command exits 0 after the fixture repair (native-repaired.log). The detached worktree was removed; remove-main.exit is 0. Commit 60136f34b76885cebb63e5c3eebdc3335e966534 regenerated the signed fixture through the C encoder and real kernel decoder but did not update this emulator request fixture."
assumption = "The production matcher, signed bytes and hash preimages are unchanged. tests/programs/test_call_activity.c:440-475 encodes the 106-byte layout; lines 2312-2362 explicitly generate ABI 2, calldata 0061ff10, one transfer capability with asset 0x22, recipient 0x33 and amount 7, and a present access declaration containing the corresponding write entry. The generator calls lxp_programs_call_decode against programs_module_registration_v4 before emitting native-program-call-v3. src/modules/programs/call.c:1745-1818 validates the same ABI and exact field layout. The test request now independently reconstructs those fields. Its guest ABI mismatch mutation changes from 2 to 1 because 2 is now the signed value; the strict mismatch assertion and all other malformed, scope, duplicate-field, legacy-JSON and signed-byte preservation assertions remain. No test assertion is weakened and no canonical fixture is edited."
severity = "note"

