file = "human/schema/human-api/v1.kvx"
symbol = "record.ResponseEnvelope"
observed = "The frozen baseline declares record.ResponseEnvelope.fields as ok:boolean, result:object, trace:TraceId, so result stays a required member while the encoding rule says result matches the response type only when ok is true and every golden failure vector omits it. error:ApiError was therefore added as an optional member. The generated decodeResponseEnvelope still requires response.result and would reject a failure envelope; the generated execute() reads ok, trace and error individually and decodes every failure vector into HumanApiError, which e2e/api-client.test.ts asserts."
assumption = "Declaring result optional is a breaking declaration change under the additive-only rule and the frozen baseline, so it needs owner authority (a baseline refresh or a major bump); the envelope as declared is consistent with the wire encoding for every path the client actually uses."
severity = "suspect"

