[observation.6.1.67]
task = "6.1"
file = "contracts/crypto/Ed25519.sol contracts/libraries/NativeStateProof.sol contracts/libraries/NativePublicationVerifier.sol contracts/CheckpointRegistry.sol contracts/EmergencyExit.sol contracts/WithdrawalClaims.sol contracts/custody/LayerXVault.sol scripts/PaxeerBetaDeploy.s.sol platform/hosted/paxeer/deploy-contracts.sh"
symbol = "Ed25519.verify verifyBalance verifyWithdrawal executeExit queueClaim publishCheckpointWitnesses registerDepositRoot setDepositRootAuthority"
observed = "Pure Solidity SHA-512, field arithmetic, canonical point decompression and the cofactorless RFC 8032 equation verify Ed25519 signatures without secp256k1 substitution. All five pure Ed25519 RFC vectors, SHA-512 padding boundaries, every signature-byte mutation and scalar, encoding and small-order refusals pass. Native exit and withdrawal overloads verify committed account or withdrawal witnesses, separate request/inclusion checkpoints and recorded ancestry. Recipient signatures bind the committed account authority and exact requested message. Both exit overloads consume account/asset/inclusion balances once, preventing a second valid signed anchor from spending the same proven balance. Publication version 2 validates native witnesses and exact recorded certificates; legacy vector domains remain explicit and mixed or unknown versions are refused. Deposit registration verifies the actual configured Ed25519 signature. Governance deployment now grants the selector and schedules/executes an explicit public key through the retained timelock; finalization requires the executed matching key and evidence version 2. forge fmt --check, forge build and forge test exit 0 with 160 tests passed and none skipped. Logs are qual-logs/set1/e-final-forge-fmt.log, e-final-forge-build.log and e-final-forge-test.log. Deployment shell syntax and twelve invalid-input refusals pass in authority-deploy-shell.log. Real timelock and deployment tests pass in authority-deploy-test-final.log."
assumption = "Constructor-installed verifier helpers have no replacement setter and preserve blueprint runtime hash checks. Final runtime sizes are registry 17581, publication verifier 12921, Ed25519 verifier 6620, exit 14931, vault 10059 and claims 13680 bytes; initcode and runtime measurements are in qual-logs/set1/e-final-contract-sizes.json. Earlier oversized inlined crypto, constructor-address hash mismatch and new fixture setup failures were repaired without relaxing code-size, blueprint, custody, timelock or assertion checks. Solidity native publication and signed exit are tested; this is not autonomous producer rollout or production deployment evidence."
severity = "note"

