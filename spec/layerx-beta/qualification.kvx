[observation.6.1.81]
task = "6.1"
file = "cmd/layerxd/lxp_daemon_lni.c agent/crates/layerx-client/tests/availability_daemon.rs tests/daemon/availability-settlement.py"
symbol = "send_availability finalized_fetch"
observed = "Tag 18 refuses every selected batch above latest_finalized_batch with LXP_ERR_DA_MISSING (-804), including explicit batch selection. Candidate DA is required before independent replay and attestation, while registration requires attestations. This prevents both initial checkpoint production and advancement beyond an existing finalized head. The availability harness asserts pre-registration refusal and obtains successful retrieval only after the finality fixture has already signed and registered a certificate. Source evidence: qual-logs/gp1/candidate-fetch-source.txt."
assumption = "An additive authenticated candidate-batch fetch must expose complete durable sealed bodies before registration without weakening finalized-only consumer selectors, root checks or existing refusal assertions. Producer implementation and end-to-end qualification remain incomplete."
severity = "blocker"

[observation.6.1.82]
task = "6.1"
file = "docs/wiki/Guarantor.md spec/layerx-protocol/docs/guarantors.md contracts/libraries/CanonicalCheckpoint.sol tests/daemon/availability-settlement.py"
symbol = "ATTESTATION_DOMAIN CHECKPOINT_DOMAIN registerCheckpoint"
observed = "Beta checkpoint construction uses an empty validity proof; no generated validity proof is claimed. The intended two beta guarantors are operated by the same cluster and provide no operational independence. The guarantor specification section 5 describes the older LXP1/guarantor-attest preimage, while implemented C and Solidity domains and cross-language checkpoint vectors use LXP/v2/guarantor-attestation and LXP/v2/checkpoint-certificate with terminating NUL bytes."
assumption = "Producer encoding follows the implemented verifiers and vectors. Production operator independence remains an onboarding requirement. Empty beta validity proofs and shared operation do not establish production independence or proof generation."
severity = "note"

[observation.6.1.83]
task = "6.1"
file = "cmd/layerx-guarantor/lni.c tests/daemon/guarantor-integration.py cmd/layerxd/lxp_daemon_lni.c"
symbol = "LXP_GUARANTOR_CANDIDATE_SELECTOR lxp_guarantor_lni_fetch"
observed = "The producer requests tag 18 selector 05 followed by one big-endian uint64 batch number. A real two-guarantor genesis, Anvil chain 31337, deployed contracts, bonded identities, native sequencer and authority replica produce nine signed batches. Independent runtime replay verifies all nine batches, including maintenance receipts. Tag 12 verifies the signed first header; selector 05 then refuses with -105 and the integration exits 1 before signing or registration. Evidence: qual-logs/gp1/integration-real.log and qual-logs/gp1/runtime-repair-1.log."
assumption = "The additive sealed-candidate selector is required in the daemon; selectors 01 through 04 and all existing finalized-only refusal assertions remain unchanged. Two-producer signing, finality feedback, tag-14 retrieval and existing verifier acceptance are asserted by the compiled integration but remain unreached until candidate retrieval succeeds."
severity = "blocker"

[observation.6.1.84]
task = "6.1"
file = "cmd/layerx-guarantor/runtime.c cmd/layerx-guarantor/settlement.py platform/hosted/node/deployment.yaml docs/wiki/Guarantor.md"
symbol = "gp_runtime_open gp_runtime_oracle membership"
observed = "The independent runtime verifies genesis and executes real kernel transitions without the sequencer private key. Direct owner authority matches the node adapter. Nonempty oracle inputs and rotated signer histories lacking complete authorization reconstruction refuse explicitly. The deployed topology provisions two distinct signing identities, two mutual-TLS processes and a dedicated checkpoint submitter, but both guarantors share the cluster operator and provide no operational independence. Certificates carry empty validity proofs and use implemented v2 domain tags."
assumption = "Production independence requires independent operator onboarding. Supporting nonempty oracle input or rotated guarantor histories requires a complete verified authority adapter; neither capability is claimed by the beta producer. Prior specification-domain drift remains recorded in observation 6.1.82."
severity = "note"

