[observation.6.11.6505]
task = "6.11"
file = "programs/crates/layerx-programs-registry/src/interface.rs programs/crates/layerx-programs-runtime/src/dynamic_spend.rs programs/crates/layerx-programs-runtime/src/ffi_interface.rs src/modules/programs/call.c"
symbol = "CallerAuthorizedSpend authorize_interface_call catalog_interface"
observed = "CallerAuthorizedSpend interface tag 10 binds asset, ceiling and big-endian calldata offsets for recipient and amount. Interfaces carrying it use LayerX/program-interface/v2 with ABI 2; old shapes claiming tag 10 are refused. Existing interface encodings remain v1. The descriptor maps to the existing exact ProgramSpend import bit and never creates a grant. Native root and nested call admission reads the published interface from module state, verifies its digest and code/ABI binding and checks the descriptor against the current caller's narrowed ProgramSpend grant. The existing owner-frame and cumulative host spend checks remain active."
