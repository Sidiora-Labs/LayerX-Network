[observation.2.3.4]
task = "2.3"
file = "human/crates/layerx-human-service/src/server/movement_provider.rs human/crates/layerx-human-service/src/custody/provider.rs human/crates/layerx-human-kms/src/wire.rs"
symbol = "PlanningRequest PrincipalKeyBinding ProviderSignRequest"
observed = "PlanningRequest carries principal, tenant, operation, action key, JSON body, trace and time but no authenticated wallet binding, custody key reference or account/authority planning context. DepositStartRequest supplies money only; ExitStartRequest supplies confirmation only. PrincipalKeyBinding and ProviderSignRequest construction is private to custody. LXKP supports Ed25519 activity key operations and validates canonical LayerX disclosure; it has no EVM wallet resolution, secp256k1 transaction signing, nonce reservation or submission lookup operation."
assumption = "A movement provider cannot infer principal ownership, payout binding or EVM signing authority from request aliases or an Ed25519 public key. Principal-scoped planning and EVM custody contracts must be supplied before successful planning and settlement execution can be qualified."
severity = "blocker"

