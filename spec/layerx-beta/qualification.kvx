task = "6.11"
file = "platform/hosted/core/tests/boundary.rs platform/hosted/core/src/public_reads.rs platform/hosted/gateway/tests/local/lifecycle.rs platform/hosted/gateway/src/rpc.rs cmd/layerxd/lxp_daemon_lni.c"
symbol = "public_read_selectors_use_real_node_and_refuse_missing_evidence assert_unavailable_reads did_accounts send_did_accounts lx_getBalances"
observed = "The second boundary failure is the DID account read contract recorded at observation 6.2.940: the assertion requires /v1/dids/did:layerx:alice/accounts to refuse 503 did_account_listing_unavailable and the integrated source answers 200 with an empty account list and authenticated_node_snapshot verification. 847f86f18 wrote that assertion when no revision defined send_did_accounts in cmd/layerxd/lxp_daemon_lni.c; this branch added both send_did_accounts and the did_accounts handler before 63ef8df81 without revisiting it, and the assertion, the handler and the daemon function are each byte-identical across 63ef8df81, f89cb11c0, 0717c87ca and the integrated tip. The same contract decides the first divergence of local_gateway_rpc: assert_unavailable_reads requires error code -32001 for lx_listAssets, lx_getAsset, lx_estimateFee and lx_getBalances, lx_getBalances resolves to the same /v1/dids/ accounts selector, and platform/hosted/gateway/src/rpc.rs maps an upstream 200 carrying a result to a result, so no error code is present. Every file under platform/hosted/gateway/src is byte-identical to f89cb11c0. The assertion is present in the integrated boundary.rs because the rebase restored the whole signer lane version of that file, which the merge recorded at observation 6.11.141 had replaced wholesale with the native lane version; twelve of its fourteen tests pass. Evidence: qual-logs/rebase-205-8.log and qual-logs/rebase-205-9b.log."
assumption = "The assertion and the source it contradicts both belong to this branch and are unchanged since the commits that qualified them, so read-contract reconciliation is the same deferred work recorded at 6.2.940. Editing the assertion would weaken a real refusal check and deleting the restored tests would discard branch coverage that otherwise passes, so boundary.rs, lifecycle.rs, the handler and the daemon were all left exactly as written."
severity = "blocker"

[observation.6.11.162]
task = "6.11"
file = "tests/storage/lxp_test_maintenance_publication.c src/protocol/lxp_genesis.c"
symbol = "lxp_genesis_materialize test-bridge-maintenance-publication"
observed = "tests/storage/lxp_test_maintenance_publication.c registers the programs, asset and bridge modules at lines 537 to 539 and then fails the same lxp_genesis_materialize refusal at line 541 that 06c54ca48 introduced for kernels without governance at index two, so make CC=gcc test-bridge-maintenance-publication exits 2. The file is byte-identical to 0717c87ca and to f89cb11c0, the target is not reachable from the make test target and it is not part of this qualification's gate set. Evidence: qual-logs/bridge-maintenance-probe.log."
