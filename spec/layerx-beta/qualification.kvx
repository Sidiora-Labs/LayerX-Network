[observation.6.11.6404]
task = "6.11"
file = "platform/cli/src/wallet.rs platform/cli/src/wallet_signing.rs platform/hosted/gateway/src/rpc.rs platform/hosted/core/src/main.rs"
symbol = "execute_write prepare_send lx_sendActivity lx_getReceipt"
observed = "A disposable funded network-7332 stack returns the treasury's authenticated main account d5a7ff07a1824a000e52864b5284a64803deaee6856e82f70ca34379b3796147, Asset 3673832cc4f73f988b740811de43a356827a596cb00e727b7db388a225e22336, balance 100000000000000 and account next_sequence 0. The exact wallet send command uses recipient did:layerx:ce7bffe9a3a06a58e0b622e55ffc42eaab22162dd8ec8a93663e22b16b3d49df, amount 1, fee-limit 1000, wait executed and the independently authenticated identity next_sequence 1. It signs activity c45cddee34ef1d82444d5ac884987b1367d5c1ca7225eacf21ce6db7ad2659a2, but lx_sendActivity returns -32001 with requested_commitment executed, state pending and upstream state unknown. Separate `layerx wallet receipt c45cddee34ef1d82444d5ac884987b1367d5c1ca7225eacf21ce6db7ad2659a2 --wait executed` and `--wait batched` commands both exit 1 after preserving the exact activity id; no receipt, batch id or commitment is returned. The exact open-account command for the funded Asset signs activity 4f9fbd79a898cdedc953fef1706c7704dcecafd4736a1c26030ba5e22a87d8a2 and receives activity_refused because the only registered Asset is already bound to the main account. Evidence: qual-logs/pay3/pay3g-funded-wallet-balance-2.log, pay3g-funded-wallet-send-executed-2.log, pay3g-funded-wallet-receipt-executed-2.log, pay3g-funded-wallet-receipt-batched-2.log and pay3g-funded-wallet-open-account-2.log."
assumption = "The CLI prints the locally derived activity id before submission and does not treat admission, pending or unknown state as success. Executed and batched receipt evidence and creation of a distinct per-asset account remain blocked by the hosted execution path; no receipt or commitment identifier exists to record."
severity = "blocker"

[observation.6.11.6405]
task = "6.11"
file = "platform/cli/src/main.rs platform/cli/src/programs.rs programs/sdk/rust/examples/token-lxt20/README.md platform/hosted/gateway/src/main.rs platform/hosted/core/src/main.rs"
symbol = "program_client deploy discover_call_head render_call_result"
observed = "The locked wasm32 build of the LXT-20 example exits 0 and is byte-identical to programs/fixtures/pay5/token-lxt20.wasm. The scoped gateway transport submits the fixture and its code-bound interface for immutable program 5555555555555555555555555555555555555555555555555555555555555555 with account sequence 1, fee limit 1000 and zero previous root. The gateway admits activity 7df9ec38dab259576ce92219b2dd5ade9134796b884dc6a23083700fc4c7339d but returns outcome unknown without a receipt. Registry discovery then returns HTTP 503 program_registry_invalid or program_registry_unavailable. The initialize call uses the README calldata 4c581400012000000000 and stops before signing or submission because no authenticated active program head exists; therefore no gateway outcome or response hex exists to decode under the README bounded-bytes contract. Evidence: qual-logs/pay3/pay3g-lxt20-build-locked.log, pay3g-funded-lxt20-deploy-2.log, pay3g-funded-lxt20-discover-2.log and pay3g-funded-lxt20-initialize-call-2.log."
assumption = "Artifact validation and admitted signed deployment bytes do not establish deployment. The registry, execution receipt and response decoder must receive real authenticated committed evidence before an LXT-20 outcome can be reported."
severity = "blocker"

[observation.6.11.6406]
task = "6.11"
file = "platform/hosted/gateway/tests/local/funding.rs platform/hosted/gateway/tests/local/lifecycle.rs platform/hosted/gateway/src/rpc.rs platform/hosted/core/src/main.rs"
symbol = "payer_grant send_payment lx_sendActivity lx_getReceipt"
observed = "The disposable funded 402 qualification signs canonical Asset ordinal-7 payer grant fb1c691efc84309761d4813169d1b99bd72e931b28754e1ca42708b4de08d443 as activity 4237fbf0dc747dfb7524df3d7c1e34c058829b12f8ca02674575ebb95d5419e0 at identity sequence 1 and submits it through authenticated gateway JSON-RPC. The exact command is the locked local test `local_gateway_grant_draw_and_subscription_renewal_latency --exact --nocapture`. The test exits 101 at its bounded lx_getReceipt deadline because no executed receipt is published; no draw, batch inclusion or recurring renewal executes. Evidence: qual-logs/pay3/pay3g-funded-harness-grant-build-locked.log and pay3g-funded-payer-grant.log."
assumption = "The signed grant and retained activity id establish attempted real issuance only. Without its sequencer-signed receipt, the grant is not claimed issued and no acknowledgement is reclassified as success."
severity = "blocker"

[observation.6.11.6407]
task = "6.11"
file = "platform/hosted/gateway/src/http.rs platform/hosted/gateway/src/public_reads.rs platform/hosted/core/src/main.rs platform/cli/src/rpc.rs"
symbol = "request public_reads RpcClient"
observed = "Authenticated wallet commands expose a gateway-to-core idle-connection failure: a first lx_getBalances or lx_getSequence after credential-store key derivation can return JSON-RPC -32001 with component_unavailable while twenty immediate repeated lx_getSequence calls pass. Keeping real authenticated reads active during the CLI unlock interval permits the same wallet command to consume valid snapshots. The core boundary records unexpected end of file for the failing connection. Evidence: qual-logs/pay3/pay3g-funded-sequence-read-stability-2.log, pay3g-funded-wallet-balance-2.log, pay3g-funded-wallet-send-executed-2.log and the disposable stack boundary stderr."
assumption = "The gateway HTTP client must discard or retry a stale pre-request keep-alive before exposing component_unavailable. The CLI retains the typed upstream error and does not add an unverified fallback."
severity = "blocker"

[observation.6.11.6408]
task = "6.11"
file = "platform/hosted/gateway/openrpc.json platform/cli/src/wallet.rs"
symbol = "create_wallet WalletCommand::History"
observed = "The merged published OpenRPC contract contains no authenticated DID registration, main-account opening or DID activity-history method. Wallet create and history therefore retain typed not-published refusals, and history remains outside the advertised working help surface. The funded qualification uses the disposable stack principal and main account created by its local gateway lifecycle setup rather than claiming hosted registration coverage."
assumption = "Publish authenticated request and response schemas for DID registration, main-account creation and DID-scoped history before enabling those hosted commands. Emulator registration does not qualify the hosted contract."
severity = "blocker"

