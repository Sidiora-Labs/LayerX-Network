symbol = "encode_grant PaymentTool"
observed = "Shared ordinal-6 Receive still emits the legacy 0x5201 structure without the canonical 733-byte authorization and payer grant; encode_grant still uses structure_header(0x2001) instead of the required 346-byte ordinal-7 payer grant. No Receive or IssueGrant CLI write is enabled; current CLI payment construction uses Register, OpenAccount, Mint and Burn. Asset 9 remains reserved. MCP payment tools expose wallet.send, token.create, token.mint and token.transfer; burn, open-account, info and list are absent from that surface. README explicitly documents the smaller MCP surface. Evidence: qual-logs/pay3/pay3e-payment-codecs.log and pay3e-mcp-surface.log."
assumption = "Signer/native/payment integration owners must correct ordinals 6 and 7 with differential interoperability evidence before enabling those shared write paths. Missing MCP operations require existing daemon signing/read and scope enforcement; CLI/MCP parity is not established."
severity = "blocker"

[observation.6.11.6430]
task = "6.11"
file = "platform/cli/src/rpc.rs platform/cli/src/rpc_subscription.rs platform/cli/src/wallet.rs platform/cli/tests/fixtures/openrpc.json platform/Cargo.lock"
symbol = "positional_requests_match_published_contract subscribe wallet_receipt"
observed = "The retained OpenRPC fixture is refreshed verbatim from dfbb7bf42241a74b2a59fe61323250f7b2865a0e. Existing assertion logic is retained, with valid lx_getAsset moved to positive inputs and missing asset arguments retained as negative inputs. Fee estimation and authenticated receipt/checkpoint/account WebSocket requests use the published transport. Subscription identifiers and notifications are correlated; notifications are explicitly unverified and establish no commitment. HTTP subscription requests, missing credentials, malformed responses and upstream errors fail closed. Wallet history is hidden from help and retains wallet_history_unavailable. The CLI SDK and WebSocket dependencies are recorded in platform/Cargo.lock. Final format, all-target Clippy with -D warnings, locked full CLI tests and ledger check pass; SDK exact-checkpoint/wrong-header and ack-refusal tests pass. Logs: qual-logs/pay3/pay3e-final-fmt.log, pay3e-final-clippy.log, pay3e-final-test.log, pay3e-final-ledger.log, pay3e-rpc-focused.log and pay3e-sdk-evidence.log."
assumption = "Hosted DID registration/history have no published backend. Live authenticated gateway fee/asset reads, subscription delivery and token execution remain unqualified. No public deployment, cluster or image gate is implied by local tests."
severity = "note"

[observation.6.11.6400]
task = "6.11"
file = "agent/crates/layerx-sdk/src/rpc.rs agent/crates/layerx-sdk/src/wallet.rs platform/cli/src/rpc.rs platform/cli/src/wallet.rs platform/cli/tests/fixtures/openrpc.json"
symbol = "get_sequence prepare_payload execute_write positional_requests_match_published_contract"
observed = "The SDK get_sequence method at a1cb3cda still emits one selector argument, while the public OpenRPC description at 75049011 requires DID plus identity selector for identity.next_sequence. The CLI explicitly sends lx_getSequence with [did, identity], requires matching DID, authenticated_node_snapshot and canonical decimal next_sequence, and uses shared envelope/disclosure signing plus SDK submission and commitment verification. Source-account sequence remains independently read and bound. The retained contract first-parameter schema still says hex64 despite its described DID identity form. Single-DID requests remain refused."
assumption = "SDK Wallet callers require a separate typed identity-sequence method and the published schema must express the conditional selector. Account sequence cannot substitute for identity sequence."
severity = "blocker"

