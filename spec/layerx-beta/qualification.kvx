[observation.6.11.6555]
task = "6.11"
file = "programs/vendor/wasmi-0.31.2/src/engine/bytecode/tests.rs programs/vendor/wasmi-0.31.2/src/engine/bytecode/mod.rs programs/vendor/wasmi-0.31.2/src/engine/tests.rs"
symbol = "size_of_instruction assert_func_body Instruction::Observe"
observed = "The base branch already declares Instruction::Observe(u64) at programs/vendor/wasmi-0.31.2/src/engine/bytecode/mod.rs:82, so size_of::<Instruction>() is 16 bytes there while the vendored upstream guard in bytecode/tests.rs still asserted 8; that guard is therefore red on the base branch independently of this change. This branch raises the asserted size to 16 and rewrites assert_func_body so the translated stream is compared after the metering Observe boundaries are removed and branch offsets are re-based across them, while adding assertions that every observation resolves source metadata whose program_counter equals the encoded counter, that its canonical instruction bytes are non-empty, that observation program counters strictly increase, that no non-observation instruction carries metadata, that at least one observation is present, and that the normalized instruction count equals the expected count. The upstream trailing unexpected-instruction check becomes that exact length equality."
assumption = "This supersedes observation 6.11.6526. size_of::<Instruction>() is the single constant relaxed relative to upstream and it is re-baselined to the representation the base branch already has, not to conceal a change made here; deleting the guard instead would remove the representation check altogether. No behavioural assertion of the translator was dropped, the instruction stream is still compared element for element, only with the metering instructions this repository injects normalized out. Evidence: qual-logs/g9-programs-test.log, in which engine::bytecode::tests::size_of_instruction and the translation tests pass."
severity = "note"

[observation.6.11.6556]
task = "6.11"
file = "interop/Cargo.lock agent/crates/layerx-sdk/Cargo.toml"
symbol = "interop-test-ucp interop-test-mandates interop-test-visa-tap interop-test-x402"
observed = "make CC=gcc interop-test-ucp interop-test-mandates interop-test-visa-tap interop-test-x402 exits 2 with the lock file interop/Cargo.lock needs to be updated but --locked was passed. The interop workspace depends on the agent SDK, which pins tungstenite = \"=0.30.0\" with the native-tls feature at agent/crates/layerx-sdk/Cargo.toml:20, and the checked-in interop/Cargo.lock contains no tungstenite entry. The condition belongs to the base branch: this branch changes no interop manifest and no lock file, and git diff origin/main HEAD -- interop/Cargo.lock is empty. Repeating the same four suites with cargo test --manifest-path interop/Cargo.toml -p layerx-ucp -p layerx-ap2 -p layerx-visa-tap -p layerx-x402 without --locked exits 0 with every suite passing."
assumption = "The stale lock belongs to whichever change introduced the agent SDK websocket pin, not to the token and payment work here, so interop/Cargo.lock was restored byte for byte after the relocked run and is not committed. Evidence: qual-logs/g11-interop.log (exit 2) and qual-logs/g11b-interop-relocked.log (exit 0) with their exit and sha files."
severity = "blocker"

