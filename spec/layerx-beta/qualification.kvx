[observation.3.7.66]
task = "3.7"
file = "cmd/layerxd/lxp_daemon_process.c cmd/layerxd/lxp_daemon_batch_wal.c src/storage/lxp_log.c"
symbol = "apply_canonical_batch commit_prepared_batch_wal publish_canonical_batch lxp_log_sync"
observed = "A complete real LNI run executed 20 native Sends with signed receipts and byte-identical committed reads after restart. P50 microseconds are prepare 40169, WAL commit 152461, availability 20661, publication 214951, authenticated history 660 and total 411891. Within WAL commit, p50 is prepared-slot sync 33813, durable-byte verification 15221, kernel commit 999, checkpoint persistence 59557 and observer publication 99958. Publication p50 includes setup 32447, proof construction 14, local authority storage 46241, activity evidence 19927, replica handshake 51767 and account evidence 113895. The native target remains unmet. A before trace measured 49 sequencer sync calls per Send; 19 completed post-change traced Sends measured 46. The prepared batch now uses exactly one fdatasync and no finalize sync. Median post-change placement is 14 evidence-log, 6 canonical-log, 4 receipt-authority-log, 4 program-feed-log, 4 history, 4 checkpoint-persistence, 3 LNI-admission, 2 availability-file, 2 availability-log and 2 batch-log sync calls, plus the one prepared-batch sync. Evidence: qual-logs/pay1/pay1i-timing-after-complete.log, pay1i-timing-after-summary.json, pay1i-profile-before-strace.json, pay1i-profile-after-strace.json and pay1i-after-strace.*."
assumption = "Availability persistence and checkpoint persistence overlap the WAL observer, and replica publication overlaps local evidence while receipt visibility still waits for every attested artifact. No fixed sleep or polling interval remains in execution through authenticated history. The local polling run does not establish hosted end-to-end latency. Recovery-safe coalescing of the remaining per-log data and marker sync boundaries requires the shared storage log implementation outside this lane's owned paths; replay, ordering and marker strictness remain unchanged."
severity = "blocker"

[observation.3.7.67]
task = "3.7"
file = "cmd/layerxd/lxp_daemon_process.c cmd/layerxd/lxp_daemon_batch_wal.c cmd/layerxd/lxp_daemon_evidence.c src/state/lxp_state_root.c src/storage/lxp_log.c src/storage/lxp_log_recover.c src/storage/lxp_snapshot_store.c"
symbol = "apply_canonical_batch run_postcommit write_prepared_record lx_account_registry_proofs lxp_durability_group_commit"
observed = "PAY1j-native-send-coalesced-v1: matched 20-Send real LNI runs record p50 total 415791 microseconds before and 80748 after. After critical-path p50 is prepare 42859, WAL preparation 520, WAL commit 32554, durable slot sync plus validated encoding 31249, exact durable-byte readback 263, kernel commit 1055, receipt publication handoff 35 and authenticated history 688 microseconds. Ordered post-commit p50 is observer 1577, checkpoint 1074, publication 51823, authority 20281, activity evidence 5174, cached account paths 26229, shared durability sync 20731 and asynchronous replica publication 44785 microseconds. Every sequencer-signed receipt and committed Asset, fee and DID-account proof read is byte-identical across the stop/start matrix; all 20 post-commit and replica results are zero. A passing seccomp-filtered strace run captures exactly five sync syscalls for each of all 20 Sends: three existing admission journal and compaction syncs, one prepared-WAL fdatasync and one coalesced publication syncfs. Native replay passes and the Docker AArch64 digest equals all GCC and Clang host variants at 56be4ba5acd85b64850c393bc1f27ceb8c32e887a3a95c225235989db0b6f172. Evidence: qual-logs/pay1/pay1j-before-summary.json, pay1j-after-final-summary.json, pay1j-after-final-post-summary.json, pay1j-after-final12-harness.log, pay1j-after-final12/sequencer.log, pay1j-sync-final-summary.json, pay1j-sync-final2-sends.log, pay1j-sync-traces-final2, pay1j-focused-final.log and pay1j-crossarch-exact-final.log."
assumption = "The prepared WAL retains full semantic validation before encoding and reads the durable slot back for an exact byte comparison before kernel commit. Observer, checkpoint, local logs and account evidence remain ordered behind the committed kernel boundary and become visible only after the shared filesystem durability sync; replica publication starts after that durable boundary and the single in-flight worker is joined before the next replica to preserve order. The measurements qualify the native LNI path on this host, not a hosted gateway percentile."
severity = "note"

