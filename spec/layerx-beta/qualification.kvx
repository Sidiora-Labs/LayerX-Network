[observation.6.2.4104]
task = "6.2"
file = "platform/hosted/core/tests/boundary.rs platform/hosted/node/bootstrap.sh platform/hosted/core/src/public_reads.rs"
symbol = "supervisor_reset_rebuilds_genesis_and_replays_once public_read_selectors_use_real_node_and_refuse_missing_evidence did_accounts"
observed = "cargo test -p layerx-platform-core reproduces the two boundary failures already recorded at observation 6.11.160 and observation 6.11.161, twelve of fourteen tests passing. supervisor_reset_rebuilds_genesis_and_replays_once still fails inside the copied bootstrap script, which cannot find contracts/config/checkpoint-settlement.json from the disposable test root and refuses the certificate threshold, and public_read_selectors_use_real_node_and_refuse_missing_evidence still fails on the DID listing assertion, receiving 200 with an empty account list and authenticated_node_snapshot where 503 did_account_listing_unavailable is required. Both failures precede any account read assertion and neither route is changed by this row; account_proof_export_preserves_exact_native_verified_bytes, proof_and_sequence_reads_refuse_invalid_or_absent_real_node_evidence and the remaining ten tests pass. Evidence: qual-logs/platform-tests.log."
assumption = "Both failures are the ones already recorded against their owning tasks and both lie outside this row's files, so the harness, the bootstrap script and the DID handler were left exactly as written."
severity = "blocker"

[observation.6.2.4105]
task = "6.2"
file = "agent/crates/layerx-client/src/read.rs agent/crates/layerx-client/src/evidence.rs"
symbol = "verify_state_value verify_account_evidence"
observed = "read.rs verify_state_value and the evidence.rs verify_account_evidence this row added now perform the same nested account verification: decode the evidence, bind the root selector and account, pin the sequencer key, and run verify_nested_account or verify_nested_account_maintenance. They are not interchangeable, because verify_state_value additionally requires the signed header's response authorization to equal the live handshake authorization and a Latest selector to name the currently sealed batch, neither of which an offline receiver of exported bytes can evaluate. Routing the live read through the shared verifier would need those two live checks factored out of the shared body."
assumption = "read.rs is outside this row's owned files and the duplication is exact rather than divergent, so the live read path was left unchanged and the consolidation is recorded for the owner of the point-read path."
severity = "note"

[observation.3.7.4400]
task = "3.7"
file = "platform/hosted/human/material.py platform/hosted/node/deployment.yaml cmd/layerx-guarantor/exchange.c cmd/layerx-guarantor/main.c"
symbol = "PROGRAM_LISTEN LAYERX_AGENT_PROGRAM_LISTEN guarantor-1 lxp_guarantor_exchange_listen"
observed = "The node pod placed two unrelated listeners on the same loopback port. platform/hosted/human/material.py wrote LAYERX_AGENT_PROGRAM_LISTEN as 127.0.0.1:9451 into the layerx-human-agent-config secret, and the human-owner container's readiness probe in platform/hosted/node/deployment.yaml queried http://127.0.0.1:9451/healthz, while the guarantor-1 container of the same pod declares containerPort 9451 and cmd/layerx-guarantor/exchange.c binds htonl(INADDR_LOOPBACK) on the port named by LAYERX_GUARANTOR_LISTEN_PORT, opened unconditionally from cmd/layerx-guarantor/main.c. Containers of one pod share a network namespace, so whichever of the two started second could not bind and the pod could never satisfy wait_for_pod_ready app=layerx-node."
assumption = "The guarantor exchange port is protocol surface fixed by the two guarantor identities, their peer URLs and the topology check, while the agent program listener is a private readiness surface named only by the generated agent configuration and its own probe. The listener was therefore moved to 127.0.0.1:9453 in material.py and in the human-owner readiness probe; no guarantor value, assertion or port was touched, and platform/hosted/agentd/manifest_check.py now proves every loopback port of the pod is claimed by exactly the containers entitled to it."
severity = "note"

[observation.3.7.4401]
task = "3.7"
file = "platform/hosted/node/deployment.yaml platform/hosted/human/material.py platform/hosted/human/entrypoint.sh"
symbol = "human-owner human-entrypoint LAYERX_AGENT_MODE"
observed = "The hosted stack was recorded as carrying no agentd. The daemon is in fact deployed: the human-owner container of the layerx-node StatefulSet runs /usr/local/bin/human-entrypoint agent, platform/hosted/human/entrypoint.sh execs layerx-agentd with the material it installs, and platform/hosted/human/material.py sets LAYERX_AGENT_MODE to human-owner. What was absent is publication and proof: no Service selected the daemon, nothing outside the pod could reach it, and platform/hosted/tests/beta-cluster.sh recorded the absence in place of the qualification agent URL rather than checking anything."
assumption = "The deployed daemon is the real agentd, so the work is to publish and prove the surface it already serves rather than to add a second copy of it. A layerx-agentd Service, a mutually authenticated boundary container, a manifest gate and a cluster probe were added; the daemon, its mode and its entry point are unchanged."
severity = "note"

[observation.3.7.4402]
task = "3.7"
file = "agent/crates/layerx-agentd/src/main.rs agent/crates/layerx-agentd/src/human_owner_mode.rs platform/hosted/node/deployment.yaml"
symbol = "config serve_human_owner LAYERX_AGENT_PROGRAM_LISTEN LAYERX_AGENT_HUMAN_NODE_LNI agentd-boundary"
observed = "agentd cannot be published as a workload of its own. Its configuration refuses to start unless LAYERX_AGENT_PROGRAM_LISTEN begins with 127.0.0.1:, and its human-owner mode requires the node's LNI unix socket and an owner socket guarded by SO_PEERCRED, all of which exist only inside the node pod. A Service can therefore reach the daemon only through a process that shares that network namespace."
assumption = "Rather than relax the loopback refusal or duplicate the daemon, the deployment publishes the surface through an agentd-boundary container in the same pod that terminates TLS with the layerx-agentd-tls identity, requires a client certificate the internal CA issued, and forwards to 127.0.0.1 alone. Only the readiness surface is published: the bearer that GET /healthz demands is still enforced inside the daemon, the owner unix socket and its peer-credential check are never relayed, the boundary mounts nothing but its own identity and the trust root, and the existing layerx-node ingress policy leaves the boundary port closed to every cluster workload, so the surface is reachable only through the API server."
severity = "assumption"

[observation.3.7.4403]
task = "3.7"
file = "platform/hosted/node/deployment.yaml platform/hosted/human/material.py"
symbol = "agentd-boundary layerx-agentd PROGRAM_LISTEN"
observed = "Two changes fall outside the shape this work was scoped to. The Service is appended at the end of platform/hosted/node/deployment.yaml as scoped, but the boundary container and its volume must sit inside the StatefulSet, so two hunks land in the middle of that file; the container is placed immediately after agent-boundary, away from the daemon containers and from the end of the container list. The port repair also touches platform/hosted/human/material.py, which is the only source of the agent program listener value."
assumption = "A boundary that shares the pod network namespace is the only way to publish a loopback-only listener, and a Service that resolves to a colliding, never-ready pod would be evidence of nothing, so both changes are required for the published surface to be real. The mid-file hunks are as far from the container list boundaries as the pod layout allows."
severity = "note"

[observation.3.7.4404]
task = "3.7"
file = "platform/hosted/tests/beta-cluster.sh platform/hosted/agentd/probe.sh platform/hosted/agentd/manifest_check.py"
symbol = "agentd_check qualification_url beta_cluster_up"
observed = "beta-cluster.sh now issues the layerx-agentd server and client identities, applies the layerx-agentd-tls secret, forwards the Service, calls agentd_check once the node pod reports ready, and passes the real address to the qualification driver in place of the record of absence. The bring-up itself could not be executed here: kind and kubectl are absent from this environment, so no cluster exists to stand up."
assumption = "The cluster path is exercised only by its own gates: the shell parses, and platform/hosted/agentd/manifest_check.py loads the manifest and proves the boundary, the Service, the port disjointness of the pod and the ingress closure, together with thirteen mutations that must be refused. The probe asserts the three properties a ready deployment must show, and it is wired into the bring-up so that a cluster that does not show them fails the bring-up rather than being recorded as unavailable."
severity = "note"

[observation.3.7.4405]
task = "3.7"
file = "platform/hosted/tests/topology-regressions.py platform/hosted/tests/topology-check.sh platform/Makefile.inc"
symbol = "baseline platform-hosted-topology-check"
observed = "make platform-hosted-topology-check exits 2 on an unmodified tree. platform/hosted/tests/topology-check.sh resolves every edge of the nine hosted manifests with no failure under both parsers, and platform/hosted/tests/topology_check.py passes with its seven refusals, but platform/hosted/tests/topology-regressions.py:26 asserts the baseline without the Human manifest holds exactly forty resolved edges and the tree holds forty one, and line 88 asserts the complete topology holds forty two where the tree holds forty three. Both parsers report the same forty four edges, one external and zero failed, before and after the agentd Service is added, so the counts those assertions pin moved when hosted edges were added by other work and the failure reproduces on an unmodified checkout of the branch point."
assumption = "The assertion is a real regression fence over a count that other lanes changed, so raising the number here would weaken a check that belongs to the topology owner and would hide whichever addition moved it. Both literals were left exactly as written; the agentd Service adds no edge and no failure to either parser."
severity = "blocker"

[observation.3.7.4406]
task = "3.7"
file = "platform/hosted/tests/beta-cluster.sh"
symbol = "beta_cluster_render secrets_generate module_registry_generate"
observed = "beta-cluster.sh render, the one cluster path that needs no cluster, cannot run in this environment either: secrets_generate calls module_registry_generate, which runs the layerx-node image through docker to produce the module registry, and the beta image tags name a local build that does not exist, so docker refuses the pull and the render exits before ca_generate reaches the new agentd identities or manifests_render reaches the boundary container."
assumption = "Building the beta images is the images subcommand of the same script and is not part of this work, so the render was left as it is. The manifest that render would emit is checked directly instead: platform/hosted/agentd/manifest_check.py loads platform/hosted/node/deployment.yaml, and the certificate and secret hunks are covered by the shell parse."
severity = "note"

[observation.6.11.2600]
task = "6.11"
file = "src/protocol/lxp_genesis.c include/layerx/lxp_genesis.h"
symbol = "module_table lxp_genesis_module_plan_resolve lxp_genesis_module_enable_key"
observed = "Genesis module registration is now a single table at src/protocol/lxp_genesis.c:39 with one row per module id and four gate kinds declared in include/layerx/lxp_genesis.h: ALWAYS for Programs, STATE_COMMITMENT for Asset and Governance, CUSTODY_PROFILE for Bridge and ENABLE_FLAG for Escrow, Budget, Stream, Service and Perps. lxp_genesis_module_plan_resolve at line 228 is the one place that turns a manifest into a registration plan, and lxp_genesis_state_root, lxp_genesis_materialize, cmd/layerx-genesis/lxp_genesis_builder.c materialize_snapshot, cmd/layerxd/lxp_daemon_process.c load_genesis_settlement_anchor and open_process, cmd/layerx-guarantor/runtime.c and cmd/layerx-module-registry/main.c all consume that plan instead of their own hardcoded register sequences, so the module count is derived from the table rather than restated. The five ENABLE_FLAG rows carry default_enabled false, so the resolved plan, the projected genesis state root and every consumer stay byte-identical to the previous hardcoded Programs plus Asset plus Governance plus optional Bridge sequence until a genesis governance parameter turns one on; consequently no genesis fixture needed regeneration and tests/fixtures holds no genesis fixture of this lane. The flag key is the 32-byte zero-padded string module-enable: followed by the module iface name and the value is 31 zero bytes then 0 or 1; lxp_genesis_module_enable_key at line 113 is the only constructor, module_enable_flag at line 136 refuses a duplicate parameter with LXP_ERR_SEQUENCE_REUSED and a non-canonical value with LXP_ERR_NON_CANONICAL, and module_enable_flags_known at line 160 refuses any module-enable parameter that names a module without an ENABLE_FLAG row with LXP_ERR_UNKNOWN_MODULE, so an unrecognised flag cannot be ignored. Enabling one of the five slots is a one-line change of default_enabled in its existing row; adding a second row for the same module id is refused by module_table_validate as a duplicate."
assumption = "Defaulting the five slots off keeps the genesis root and every existing snapshot unchanged while the modules that own dispatch land, so the per-module lanes flip default_enabled in the row that already exists rather than appending a row. tests/test_genesis_module_table.c covers the gates, the enable-flag encoding, the refusals and the root change when a flag-gated module is enabled, but the table alone does not qualify any module dispatch."
severity = "note"

[observation.6.11.2601]
task = "6.11"
file = "cmd/layerx-module-registry/main.c cmd/layerx-module-registry/test_registry.py"
symbol = "lxp_genesis_module_plan_default module_registry_verify"
observed = "Before the shared table cmd/layerx-module-registry/main.c selected Programs and Asset and added Bridge for a custody profile, omitting Governance, while cmd/layerxd registered Governance at genesis and advertises it over the LNI. platform/hosted/tests/beta-cluster.sh module_registry_verify compares the registry document against the daemon module list, so the registry advertised one module fewer than the node it describes. Deriving the registry selection from lxp_genesis_module_plan_default removes the divergence by construction: the registry now emits module 7 with ordinals 1, 2, 3, 5 and 6 and keeps its ascending module-id ordering and its per-module validity refusal. cmd/layerx-module-registry/test_registry.py gained the module 7 row and its bridge insertion index moved from 1 to 2 to preserve ascending order."
assumption = "The registry document is a description of what the node registers, so a divergence between it and the daemon genesis path is a registry defect rather than a fixture choice. The cluster comparison itself was not re-run in this lane."
severity = "note"

[observation.6.11.2602]
task = "6.11"
file = "cmd/layerx-module-registry/test_registry.py src/modules/asset/lx_asset_registry.c"
symbol = "expected modules module 1 ordinals activity_types"
observed = "python3 cmd/layerx-module-registry/test_registry.py fails on the Asset row independently of the module table. Line 24 requires module 1 to advertise ordinals 1 through 9 while src/modules/asset/lx_asset_registry.c:11-16 lists eleven activity types, LX_ASSET_MINT and LX_ASSET_BURN having been added after the fixture was written, so the binary prints 1 through 11. The same failure was reproduced by compiling the unmodified cmd/layerx-module-registry/main.c and node.c from origin/main and running the unmodified test_registry.py from origin/main against them, so it is present without any change from this lane. Both the fixture and the registry were left exactly as written; only the Governance row and the bridge insertion index were changed here. Evidence: qual-logs/module-registry.log and qual-logs/module-registry-main.log."
assumption = "Either the Asset module intends to disclose mint and burn and the fixture is stale, or the fixture is the contract and mint and burn must not be advertised. Deciding that belongs with the Asset ordinal owner, and editing the expectation to match the binary would weaken the check that catches an undeclared ordinal."
severity = "blocker"

[observation.6.11.2603]
task = "6.11"
file = "tests/test_genesis_manifest.c src/modules/asset/lx_asset_registry.c"
symbol = "lxp_kernel_module_for_activity LX_ASSET_WITHDRAW"
observed = "build/tests/test_genesis_manifest fails at tests/test_genesis_manifest.c:203, which requires that Asset ordinal 9 does not resolve through lxp_kernel_module_for_activity, while src/modules/asset/lx_asset_registry.c:11-16 advertises LX_ASSET_WITHDRAW as ordinal 9 so the lookup succeeds. The failure was reproduced on a pristine tree by stashing every change in this lane, rebuilding and running make CC=gcc test-genesis-bootstrap, which failed at the identical assertion at origin/main line 196, so it does not come from the module table. This is the same withdraw contradiction recorded at 789b73c2d, where the module documentation reserves ordinal 9 and the hosted core refuses it while the registry and the daemon admit it. The assertion and the registry list were both left intact. Evidence: qual-logs/test-genesis-manifest.log and qual-logs/test-genesis-manifest-main.log."
assumption = "The assertion and the advertised ordinal are both deliberate and disagree, so the reconciliation belongs to the Asset ordinal owner. Relaxing the assertion would delete the only native check that a reserved ordinal stays undispatchable."
severity = "blocker"

[observation.6.11.2604]
task = "6.11"
file = "tests/test_genesis_builder_cli.c tests/fixtures/pay1-retired-genesis.manifest"
symbol = "signed_snapshot_migration_fixture lxp_genesis_verify_signature"
observed = "build/tests/test_genesis_builder_cli exits 1 with no output. The failing step is tests/test_genesis_builder_cli.c:182, where lxp_genesis_verify_signature on tests/fixtures/pay1-retired-genesis.manifest returns LXP_ERR_ROOT_MISMATCH; the leftover temporary directory shows the test completed both lxp_genesis_build_artifacts cases and the protocol 2 case and reaches signed_snapshot_migration_fixture at line 139 before failing. A diagnostic linked against build/liblayerx.a that parses the fixture, initialises an arena and verifies the signature reported protocol_version 3, network_id 77 and LXP_ERR_ROOT_MISMATCH, and the identical diagnostic linked against a liblayerx.a rebuilt from a pristine tree with every change of this lane stashed reported the same three values, so the stored genesis_state_root of that fixture is stale on origin/main and the table reproduces the same root. Regenerating the fixture requires the signer key that produced it, which is not in the tree. The fixture, the assertion and the migration path were all left unchanged. Evidence: qual-logs/test-genesis-builder-cli.log and qual-logs/test-genesis-builder-cli-main.log."
assumption = "A signed fixture whose genesis root no longer matches the computed root has to be re-signed by whoever holds its signer key, which is out of reach from this lane and out of its owned paths, so it is recorded rather than repaired. The migration path itself was never exercised, so nothing here says whether it works."
severity = "blocker"
[observation.2.1.3500]
task = "2.1"
file = "src/protocol/lxp_kernel.c include/layerx/lxp_kernel.h cmd/layerxd/lxp_daemon_process.c cmd/layerxd/lxp_daemon_main.c tests/protocol/lxp_test_terminal_rejection.c"
symbol = "lxp_terminal_rejection_applies lxp_kernel_terminal_rejection lxp_kernel_prepare_terminal_rejection apply_canonical_batch apply_canonical_activity replay_execute_activity executor_run"
observed = "The canonical terminal rejection transition that observation 2.1.1 requires before a preserved acknowledged activity may be retired now exists, so an acknowledged activity whose apply refuses no longer stops the node. lxp_kernel_terminal_rejection at src/protocol/lxp_kernel.c:4702 opens the state journal at the offered global sequence, produces a sequencer-signed refusal receipt whose result_code is the refusal, whose fee_charged and effect count are zero and whose previous_state_root is the live root, records that receipt through receipt_store so the same canonical activity id afterwards resolves to LXP_ERR_IDEMPOTENT_REPLAY carrying it, commits the journal, advances the kernel state root and fires the commit observer that is the Programs state feed frontier. lxp_kernel_prepare_terminal_rejection at 4822 stages the same transition as an lxp_kernel_prepared_batch, so the batch path writes the refusal to the batch write-ahead log before the kernel commits it. apply_canonical_batch at cmd/layerxd/lxp_daemon_process.c:3549, apply_canonical_activity at 2974 and replay_execute_activity at 1186 take that transition instead of returning the refusal, so executor_run at cmd/layerxd/lxp_daemon_main.c:126 observes LXP_OK with one consumed activity and the fail-stop block at line 133 is not reached. tests/protocol/lxp_test_terminal_rejection.c drives the whole transition over a real signed asset send on a real kernel, state store, identity store, asset runtime, programs runtime and state feed: refusal receipt identity and signature, batch write-ahead record classified DISCARD_BASE before the commit and FINALIZE_SETTLED after it, consumption of the offered global sequence, the occupancy sweep chaining onto the refusal receipt, frontier advance, the idempotent second application, and an independently opened second node that reproduces the receipt byte for byte and reaches the same lxp_kernel_batch_boundary. Evidence: qual-logs/make-test.log and qual-logs/test-terminal-rejection.log."
assumption = "The follow-up protocol task observation 2.1.1 names is this transition, so a preserved admission record whose apply refuses for a state-dependent reason is now retired by a canonical receipt rather than by a repeated restart. Task 2.1 admission remains unchanged: it still preserves the acknowledged bytes, and the refusal is still produced by the executor rather than at admission."
severity = "note"

[observation.2.1.3501]
task = "2.1"
file = "src/protocol/lxp_kernel.c cmd/layerxd/lxp_daemon_main.c"
symbol = "lxp_kernel_terminal_rejection receipt_store lxp_identity_consume_sequence lxp_daemon_reserve_batch_maintenance"
observed = "A terminal rejection consumes the offered global sequence and nothing else. It does not call lxp_identity_consume_sequence, so the actor account sequence, its balance, the recipient balance and the fee treasury are all unchanged, and a refused activity therefore does not burn the actor nonce it never spent. Anti-replay is instead the idempotency record written through receipt_store under the canonical activity id, which makes a second application of the same bytes return LXP_ERR_IDEMPOTENT_REPLAY carrying the stored refusal receipt rather than a second sequence consumption. Under protocol versions that use occupancy the batch coordinator still runs its sweep after the refusal, so lxp_kernel_prepare_batch_maintenance chains an occupancy receipt at the next sequence onto the refusal receipt resulting root and the daemon consumes the extra reserved sequence exactly as it does after a successful batch."
assumption = "Charging no fee and consuming no actor sequence is the decision this row records: the refusal is a sequencer-attributable outcome of an already acknowledged activity, not an actor-authorised state change, so the only canonical resource it may consume is the global sequence the acknowledgement already promised. A future metering task that decides refusals must be paid for has to change the receipt shape and the fee accounting together."
severity = "note"

[observation.2.1.3502]
task = "2.1"
file = "src/protocol/lxp_kernel.c cmd/layerxd/lxp_daemon_process.c"
symbol = "lxp_terminal_rejection_applies terminal_rejection_module_supported apply_canonical_batch"
observed = "Terminal rejection is deliberately narrower than the set of non-OK results. lxp_terminal_rejection_applies at src/protocol/lxp_kernel.c:4682 admits only the codec, envelope, authority, sequencing, ledger, arithmetic, metering and module result domains, so LXP_OK, LXP_ERR_IDEMPOTENT_REPLAY, every fatal result and the batch and storage domains keep the fail-stop behaviour, which means a node fault such as LXP_ERR_IO, LXP_ERR_LOG_CORRUPT or LXP_ERR_ARENA_EXHAUSTED is never converted into a consensus outcome attributed to a submitter. The daemon narrows it further: terminal_rejection_module_supported at cmd/layerxd/lxp_daemon_process.c:1068 requires a module the replay path can reproduce, apply_canonical_batch takes the branch only when no prepared batch exists, a batch timestamp was read and the failure is unambiguously attributable to the first offered activity, and replay_execute_activity takes it only when the recorded receipt already agrees with the refusal, timestamp, module identity and module version it is about to reproduce. A refusal that fails these tests still returns the original result and still stops the node."
assumption = "Fail-stop remains the correct answer for anything that is not attributable to the offered activity, so the narrower classifier is not a gap. Extending the set later requires the same replay reproduction proof, because a receipt the replay path cannot rebuild byte for byte is a divergence rather than a rejection."
severity = "note"

[observation.2.1.3503]
task = "2.1"
file = "cmd/layerxd/lxp_daemon_process.c"
symbol = "replay_execute_activity apply_canonical_batch lxp_daemon_batch_bind_prefix redo_prepared_batch_wal"
observed = "The success path of replay_execute_activity derives the execution batch_id from an eighty byte preimage of current_state_root, activity_id, global_sequence and batch_number at cmd/layerxd/lxp_daemon_process.c:1271 and never sets execution.activity_root, while the live batch path binds the same fields through lxp_daemon_batch_bind_prefix, whose preimage is eighty-eight bytes of base_state_root, activity_merkle_root, first_sequence, last_sequence and batch_number and which also sets activity_root. Both fields are part of the canonical receipt encoding, so replaying a single-activity batch that the live path published under a protocol version that uses occupancy reproduces a different receipt and redo_prepared_batch_wal reports LXP_FATAL_REPLAY_DIVERGENCE. The divergence is present on the base revision and is unrelated to refusals; the terminal rejection branch added at line 1186 avoids it by calling lxp_daemon_batch_bind_prefix itself whenever the protocol version uses occupancy and by falling back to the eighty byte preimage only for the legacy version."
assumption = "Repairing the success path means changing which bytes a replayed receipt commits to for every existing single-activity batch, which is a canonical identity change outside a terminal rejection row, so the success path is left exactly as written and only the new branch binds the prefix the live path binds."
severity = "suspect"

[observation.2.1.3504]
task = "2.1"
file = "cmd/layerxd/lxp_daemon_process.c cmd/layerxd/lxp_daemon_lni.c cmd/layerxd/lxp_daemon_main.c"
symbol = "apply_canonical_batch lxp_daemon_reserve_batch_maintenance admission_journal_recover executor_run"
observed = "When a terminal rejection is attributed to the first activity of a batch that offered more than one, apply_canonical_batch shrinks count to one exactly as the existing retry_prefix_count path does, and the surviving activities stay queued for the next batch. If a maintenance reservation was restored from the admission journal at cmd/layerxd/lxp_daemon_lni.c:638 for a larger count, lxp_daemon_reserve_batch_maintenance at cmd/layerxd/lxp_daemon_main.c:22 then answers LXP_ERR_CONTEXT_MISMATCH because the restored reservation and the shrunk count differ, and the node fail-stops with that result instead of the refusal that caused the shrink. The same is true of the pre-existing retry_prefix_count shrink, and the base revision fail-stops in this window as well, so the outcome is not a regression, only a less informative result code."
assumption = "The window requires a batch that reserved maintenance, then crashed before consuming it, and then refused its first activity on the recovered state that had already prepared it successfully. Making the reservation shrinkable would change how a restored reservation binds the sequence it reserved, which is admission and sequencing behaviour outside this row, so the reservation call is left exactly as written."
severity = "note"

[observation.4.2.6100]
task = "4.2"
file = "agent/tools/sdk-gen/templates/python.tpl agent/tools/sdk-gen/templates/python.pyi.tpl agent/sdk/python/layerx_sdk/generated/client.py agent/sdk/python/layerx_sdk/generated/client.pyi"
symbol = "agent_sdk_generator agent_sdk_drift_gate PYTHON_TEMPLATE PYTHON_STUB_TEMPLATE"
observed = "Four of the lint findings under agent/sdk/python sit in agent/sdk/python/layerx_sdk/generated/client.py and client.pyi: the deprecated typing.Mapping import in both files and the two module-level type variables named T and R in the stub, which the private-name rule requires to begin with an underscore. agent/tools/sdk-gen/src/main.rs:846 and :850 declare both paths as generator outputs and agent_sdk_drift_gate compares every generated byte with the committed tree, so a hand edit to either file makes cargo run --manifest-path agent/tools/sdk-gen/Cargo.toml --locked -- --check fail with generated SDK drift. The two files are rendered from agent/tools/sdk-gen/templates/python.tpl and python.pyi.tpl through include_str, and neither template placeholder carries the affected lines."
assumption = "The generated files were not hand-edited. The import line and the two type variable names were changed in the two templates instead, the pair was regenerated with cargo run --manifest-path agent/tools/sdk-gen/Cargo.toml --locked -- --write, and the drift gate and cargo test for the same manifest both pass afterwards, 8 tests with none failed. The templates lie outside the agent/sdk/python paths this work owns, so the edit is recorded here; the TypeScript output and the guarantee documents are unchanged and the golden assertions in agent/tools/sdk-gen/tests/golden.rs name none of the changed lines."
severity = "note"

[observation.2.4.6101]
task = "2.4"
file = "agent/sdk/python/layerx_sdk/x402_http.py agent/sdk/python/layerx_sdk/x402_rpc.py agent/sdk/python/layerx_sdk/production.py agent/sdk/python/layerx_sdk/x402_draw.py agent/sdk/python/layerx_sdk/mirror.py"
symbol = "_object PaymentRpc.call ProductionClient._dispatch PreparedGrantDraws._resolve _digest"
observed = "Six type-check findings and three blind-except findings name remedies that would change the observable error surface. x402_http._object and PaymentRpc.call raise ValueError with a machine-readable code as the single refusal channel of those modules, roughly fifty sites, and platform/middleware/conformance/pay6/test_http.py and test_rpc.py assert ValueError on those paths, so raising TypeError there would escape every existing handler. ProductionClient._execute translated any third-party transport exception into a redacted PlatformSdkError raised with from None, matching the seven from None sites in agent_http.py that keep transport detail out of the rendered traceback, and the lint rule is cleared only by re-raising, logging or narrowing the caught set. PreparedGrantDraws returned None for any non-PaymentRpcError failure of the payment RPC, which pay6 test_draw.py depends on for an unreachable endpoint."
assumption = "No refusal was relaxed and no caught set was narrowed. The type checks were inverted into affirmative branches that return on the accepted type and raise the same exception with the same message afterwards; mirror.py raises TypeError only at its two pure isinstance guards, whose callers already catch TypeError alongside ValueError in the same handler and answer MirrorVerificationError MALFORMED either way. The two boundaries were split into ProductionClient._dispatch and PreparedGrantDraws._resolve, which translate the caught exception into a private carrier that preserves it as the cause, leaving the redacted from None raise and the return None outcome exactly as they were. pytest agent/sdk/python passes 34 tests with 39 subtests, the pay6 conformance suite passes 42 tests and the three platform/sdk/conformance scripts exit 0."
severity = "note"

[observation.4.2.6102]
task = "4.2"
file = "agent/sdk/python/pyproject.toml agent/sdk/python/tests"
symbol = "layerx-sdk tool.pytest.ini_options agent-test-sdk-py"
observed = "pytest agent/sdk/python invoked from the repository root exited 2 with nine collection errors, ModuleNotFoundError No module named layerx_sdk, on origin/main as well as here. The suite has no package marker under agent/sdk/python/tests, so the import-mode prepend path pytest inserts is agent/sdk/python/tests and never agent/sdk/python, and layerx_sdk is not installed in the environment. Makefile:2633 works around it by exporting PYTHONPATH=agent/sdk/python and driving the same suite through unittest discover instead. The condition is already recorded at observation.6.11.157."
assumption = "A tool.pytest.ini_options table declaring pythonpath = [\".\"] and testpaths = [\"tests\"] was added to agent/sdk/python/pyproject.toml, which makes that directory the pytest root and puts it on the interpreter path, so pytest agent/sdk/python now collects and passes 34 tests with 39 subtests. This is a change of test invocation rather than of any lint finding, taken because the row names that exact command as a gate. Nothing else reads the table: agent/sdk/python/build_backend.py builds the wheel from layerx_sdk and examples only and never reads pyproject.toml, and tools/ci/release-version.py:134 matches the [project] table alone, so the wheel bytes and the release version check are unchanged. No test, assertion or bound was altered."
severity = "note"

[observation.5.4.5401]
task = "5.4"
file = "platform/docs/content/beta.md spec/layerx-beta/qualification.kvx tools/ci/beta-report.sh"
symbol = "release_candidate revision_binding beta_report"
observed = "The go/no-go report has no release-candidate revision to bind to, so it counts no gate record as evidence and decides no-go for that reason before any surface is considered. decision.revision_binding requires the report to count only gates whose revision is the release candidate; tools/ci/beta-report.sh resolves that revision from --revision, from LAYERX_BETA_RELEASE_CANDIDATE, or from the Identity key release_candidate of platform/docs/content/beta.md, and the Identity table at platform/docs/content/beta.md:12-23 declares no such key. All 48 gate records in this ledger carry revision e68e3cf8b7144318a34b475c3843b0a8ba38053e, which git cat-file -t resolves to a commit but which git merge-base --is-ancestor reports is not an ancestor of the branch head 786289ac9f4ac6d37028d5545336683cb772d355, so those records describe a revision the current tree does not contain. Their outcomes are 22 pass, 24 fail and 2 blocked, so even if that revision were named the release candidate, 24 of the recorded gates failed. Rendered evidence: spec/layerx-beta/report.md sections Decision and Release-candidate binding, produced by tools/ci/beta-report.sh with exit 0, log /root/lx-lanes/day/L3/qual-logs/beta-report.log."
assumption = "Naming the release candidate is an owner act, not a repository edit: the value must identify the immutable revision the beta gates were executed against. The report treats an absent, unset, none, undeclared or non-40-hex value as undeclared and refuses to treat any gate as evidence rather than falling back to the newest revision present, so no rung can be raised by history. Nothing here changes a gate record, a revision or an outcome."
severity = "blocker"

[observation.5.4.5402]
task = "5.4"
file = "Makefile platform/Makefile.inc tools/ci/beta-report.sh platform/docs/content/beta.md"
symbol = "platform-test-reference-apps platform-test-middleware platform-hosted-topology-check test-contracts"
observed = "Seventeen surface rows of the canonical contract cannot reach their required beta rung even if every gate command the repository defines passes on the release candidate, because no command exercises them at that rung. The report computes this ceiling from the evidence map of tools/ci/beta-report.sh and prints it under Evidence map coverage as surfaces_no_target_can_prove_at_required_rung. Rows are named rather than cited by line because the contract and the Makefile are both moving. The four reference-app rows of platform/docs/content/beta.md, required runtime_proven, reach only statically_coherent: the platform-test-reference-apps recipe in platform/Makefile.inc runs node platform/examples/run-reference-apps.mjs --check, whose checkManifest at platform/examples/run-reference-apps.mjs:24-72 validates the manifest and returns without starting an application, while runScenario at platform/examples/run-reference-apps.mjs:74-123, which spawns the applications and performs a checkout, is invoked only from .github/workflows/platform.yml:1530 as --scenario testnet and from no make target. The four middleware rows, required runtime_proven, reach only tested through the npm run conformance step of platform-test-middleware in platform/Makefile.inc. The rows integration-express, integration-next, integration-fastapi and integration-spring, required runtime_proven, reach only built: platform-test-middleware builds the express and next packages and byte-compiles the FastAPI package, and platform-build-all packages the Spring example, while the real-integration targets platform-real-agent-integration, platform-real-ios-integration and platform-real-android-integration cover only the agent frameworks, iOS and Android. The row settlement-contracts, required runtime_proven, reaches only tested through the test-contracts recipe in Makefile, forge test --offline --root ., and no target deploys the settlement suite to a chain and drives it. The row agent-mcp, required runtime_proven, reaches only tested through the agent-test-mcp-scope, agent-test-mcp-readonly and agent-test-mcp-write cargo tests. The row human-service, required runtime_proven, reaches only tested: every human-qualify-journeys, human-qualify-fabrication and human-qualify-faults expansion at tools/qualification/release_runner.py:243-257 is a cargo test of layerx-human-service or layerx-explorer-index, and the real-stack Playwright targets human-e2e-journeys, human-e2e-settings, human-e2e-explorer and human-test-e2e drive the web application at http://127.0.0.1:3105 rather than certifying the service. The row hosted-tests, required deployment_proven, reaches only statically_coherent because the platform-hosted-topology-check recipe in platform/Makefile.inc runs bash platform/hosted/tests/topology-check.sh as a static analysis of the manifests. The row reference-ramp, required deployment_proven, reaches runtime_proven through the ramp sandbox and has no deployment gate."
assumption = "The evidence map that produces this ceiling is a declaration inside tools/ci/beta-report.sh, biased so that a target raises the lowest rung its recipe genuinely establishes; a target whose recipe proves more than the map claims would only be under-counted, never over-counted. The gap recorded here is in the gate set, not in the ledger: it is closed by adding commands that exercise these surfaces at their required rung and recording those commands as gate records, not by lowering a required rung, editing a reached rung or widening a map entry. No required rung, contract row or map entry was changed to make any surface appear higher than its evidence."
severity = "blocker"

[observation.5.4.5403]
task = "5.4"
file = "tools/ci/beta-contract-check.sh platform/docs/content/beta.md platform/middleware/examples platform/hosted/agentd"
symbol = "derived middleware-examples hosted-agentd Surfaces_and_journeys"
observed = "make beta-contract-check fails on the branch point with two violations, contract: surface hosted-agentd (hosted) is missing from Surfaces and journeys and contract: surface middleware-examples (functional) is missing from Surfaces and journeys, and fails identically with and without the report rows added to the contract by this change, so it is a pre-existing failure and not a consequence of it. tools/ci/beta-contract-check.sh:545-546 derives one hosted surface per directory of platform/hosted and :547-549 derives one functional surface per directory of platform/middleware excluding only conformance, then :573-575 raises a violation for every derived surface the contract does not list. platform/hosted now holds agentd beside the sixteen directories the contract covers, and platform/middleware holds agent, buyer, conformance, examples, merchant and seller, so hosted-agentd and middleware-examples are derived while the Surfaces and journeys table of platform/docs/content/beta.md lists neither. Both strings appear nowhere in the repository outside this derivation. Adding a directory under platform/hosted or platform/middleware therefore fails this check until the contract gains a matching row, which is the failure mode here rather than a defect in either directory. Evidence: /root/lx-lanes/day/L3/qual-logs/beta-contract-check.log, exit 2, and a baseline run with the contract change stashed, recorded in the same lane."
assumption = "Closing this requires owner decisions this record does not take: whether platform/hosted/agentd is a beta hosted surface and whether platform/middleware/examples is a shipped middleware package, and for each either a Surfaces and journeys row with its required rung, journey and source, or an exclusion beside conformance at tools/ci/beta-contract-check.sh:547-549. Both files are outside the paths this change owns, so nothing was edited to make the check pass and the check was not weakened."
severity = "blocker"

[observation.5.4.5404]
task = "5.4"
file = "Makefile tools/ci/beta-contract-check.sh tools/ci/beta-report.sh"
symbol = "beta-report beta-contract-check"
observed = "Task 5.4 asks for a beta-report make target beside the other beta checks and for the contract check to fail when the contract and the report disagree. The check itself is implemented and runs: tools/ci/beta-report.sh --check re-renders the report from the ledger and the contract and exits 1 when the report on disk differs from what that evidence renders, when a Surfaces and journeys row states a reached rung the report does not record, when the contract keys report_path or report_status disagree with the report, or when readiness_claim is true while any surface is below its required rung or the decision is not go. Both failure paths were exercised in this lane: editing the decision line of spec/layerx-beta/report.md produced exit 1 with 'is not the report this evidence renders', and a copy of the contract with the reached rung of native-core raised to runtime_proven produced exit 1 with 'states reached rung runtime_proven but the report records source_present'. The wiring is what is missing: the .PHONY line that declares beta-ledger-check and beta-contract-check in Makefile declares no beta-report target and no such target exists, and tools/ci/beta-contract-check.sh does not invoke tools/ci/beta-report.sh --check, so nothing runs the agreement check automatically."
assumption = "Makefile and tools/ci/beta-contract-check.sh are outside the paths this change owns, and other work is in flight on both, so the two hunks are recorded as a request rather than applied here: a beta-report target running tools/ci/beta-report.sh next to the two existing check targets and added to their .PHONY line, and a tools/ci/beta-report.sh --check invocation at the end of tools/ci/beta-contract-check.sh whose exit status is propagated. Until they are applied the agreement check must be invoked explicitly, and task 5.4's verify_cmd make beta-report beta-ledger-check beta-contract-check cannot run as written."
severity = "note"

[observation.6.1.2900]
task = "6.1"
file = "src/modules/budget/lx_budget_spend.c src/modules/budget/lx_budget_create.c src/modules/budget/lx_budget_close.c src/protocol/lxp_kernel.c src/ledger/lxp_journal.c"
symbol = "lx_budget_bind_source_authority lxp_kernel_apply_transfer_set source_authorities_check"
observed = "Before this change four of the five budget targets exited non-zero on an unmodified checkout: test_budget_create, test_budget_spend, test_budget_delegate and test_budget_close each returned 1 while test_budget_period returned 0. Every budget transfer emission built an lxp_transfer_context with source_authorities NULL and source_authority_count zero, and lxp_kernel_apply_transfer_set at src/protocol/lxp_kernel.c refuses any set without a source authority table with LXP_ERR_NON_CANONICAL, so no budget transfer could reach source_authorities_check at src/ledger/lxp_journal.c:69. Evidence: qual-logs/baseline-budget.log."
assumption = "The kernel refusal is the canonical rule and was left exactly as written; the budget module now supplies the one-entry source authority table that the rule requires, through lx_budget_bind_source_authority, from every emission site in the module."
severity = "note"

[observation.6.1.2901]
task = "6.1"
file = "src/modules/budget/lx_budget_spend.c src/modules/budget/lx_budget_period.c include/layerx/lxp_module.h"
symbol = "lx_budget_spend_prepare lx_budget_rollover lx_budget_epoch_begin LXP_MODULE_MAX_STAGED_WRITES"
observed = "Budget records held in canonical module key-value state roll their period lazily: lx_budget_spend_prepare calls lx_budget_rollover on the record it is about to charge, so a record is advanced when it is next touched rather than at the epoch boundary. lx_budget_epoch_begin keeps its existing bulk behaviour over the runtime store. A bulk rollover of key-value records would have to stage one write per record inside a single module context, and LXP_MODULE_MAX_STAGED_WRITES caps a context at 64 staged writes, so the bulk form cannot cover a store larger than that cap."
assumption = "Lazy rollover and bulk rollover agree on the resulting record for every record that is read or charged, because both call the same lx_budget_rollover with the same batch timestamp; a record that is never touched is never observed in a stale period. The staged write cap was left as written."
severity = "note"

[observation.6.1.2902]
task = "6.1"
file = "tests/modules/test_budget_create.c tests/modules/test_budget_close.c tests/modules/test_budget_delegate.c src/protocol/lxp_module_ctx.c"
symbol = "emit_transfer_set lxp_module_ctx_init transfer_applied"
observed = "emit_transfer_set at src/protocol/lxp_module_ctx.c refuses a second transfer set on the same module context with LXP_ERR_BALANCE_BYPASS unless the module is Programs, and only lxp_module_ctx_commit clears transfer_applied. Three of the store-path budget tests drove several value-moving calls through one context that was initialised once, so every emission after the first was refused. Each of those tests now initialises a fresh module context before each further emission, which is the lifecycle the kernel gives one activity, and matches what tests/modules/test_budget_spend.c already did."
assumption = "Every existing assertion in those tests was preserved verbatim, including the transfer_calls counts in tests/modules/test_budget_close.c; only context initialisation was added."
severity = "note"

[observation.6.1.2903]
task = "6.1"
file = "tests/modules/test_budget_create.c Makefile"
symbol = "test-budget-create dispatch_path store_path"
observed = "The full seven-ordinal dispatch suite for the budget module is hosted inside tests/modules/test_budget_create.c alongside the pre-existing store-path coverage, rather than in a new test file. A new test binary requires its own rule in the Makefile and an entry in the aggregate list, and the Makefile is outside this change set."
assumption = "Both halves run under the existing test-budget-create target, which also runs tools/lxp_check_sole_writer.sh, so no gate coverage is lost by combining them."
severity = "note"

[observation.6.1.2904]
task = "6.1"
file = "src/modules/budget/lx_budget_module.c include/layerx/lxp_module.h src/modules/asset/lx_asset_registry.c"
symbol = "budget_authorized_signer LX_BUDGET_AMEND LX_BUDGET_DELEGATE_ADD LX_BUDGET_DELEGATE_REMOVE"
observed = "The amend and the two delegate ordinals change record state without moving value, so they emit no transfer set, and only lxp_apply_transfer_set advances an account next_sequence. There is no module context interface that advances a signer sequence for a non-monetary activity, so two distinct signed activities of those ordinals can carry the same account_sequence. The asset module has the same shape for its registration ordinal. Within one budget record the effect is bounded: a repeated delegate add is refused with LXP_ERR_SEQUENCE_REUSED and a repeated delegate remove with LXP_ERR_UNAUTHORIZED_DELEGATE, and budget_authorized_signer now requires account_sequence to equal the signer next_sequence exactly, refusing a lower value with LXP_ERR_SEQUENCE_REUSED and a higher one with LXP_ERR_SEQUENCE_GAP."
assumption = "Adding a sequence-advancing interface to lxp_module_ctx would change a protocol surface shared by every module, so it is recorded rather than introduced here. Idempotency keys and the activity identifier remain the deduplication surface above the module."
severity = "note"

[observation.6.1.2905]
task = "6.1"
file = "src/modules/budget/lx_budget_close.c src/modules/budget/lx_budget_create.c"
symbol = "drain lx_budget_record_validate lx_budget_record_encode"
observed = "The store-path drain in src/modules/budget/lx_budget_close.c sets per_period_limit to spent_this_period when a budget is drained, which yields a zero limit whenever the current period has no spend. lx_budget_record_validate refuses a zero per_period_limit and lx_budget_record_encode validates before encoding, so a record reduced that way cannot be written back to canonical key-value state. The dispatch close path therefore leaves the limit as configured and relies on the closed flag, which already refuses fund, amend, delegate, spend and close."
assumption = "The store-path behaviour and the validation rule disagree, and both were left exactly as written: the existing store-path assertions in tests/modules/test_budget_close.c depend on the reduced limit and the validation rule is the canonical encoding contract."
severity = "note"

[observation.6.1.2906]
task = "6.1"
file = "src/protocol/lxp_genesis.c"
symbol = "module_table module_table_validate LXP_GENESIS_MODULE_GATE_ENABLE_FLAG"
observed = "The genesis module table already carries the budget row with LXP_GENESIS_MODULE_GATE_ENABLE_FLAG and enabled false, and module_table_validate refuses a duplicate module identifier, so no registration row was added by this change. The enable flag was not flipped: flipping it changes the genesis state root and every snapshot fixture derived from it."
assumption = "The dispatch, canonical key-value state, events and refusals are exercised at module level against a kernel that registers the module directly, so the coverage does not depend on the genesis gate. Enabling the module in genesis and regenerating the affected fixtures is left as one coordinated change across all gated modules."
severity = "note"

[observation.6.11.2800]
task = "6.11"
file = "Makefile"
symbol = "test_escrow_dispute test_stream_lifecycle TEST_LIBRARY PROGRAMS_RUNTIME_LIB"
observed = "The link rule for build/tests/test_escrow_dispute at Makefile lines 493 to 497 names only $(TEST_LIBRARY): it carries no $(PROGRAMS_RUNTIME_LIB), no programs-build order-only prerequisite and no -ldl -lm, so the link fails on the layerx_programs_sandbox_* symbols that src/modules/programs/sandbox.c references from the archive it does link. The rule for build/tests/test_stream_lifecycle at lines 609 to 613 has the same shape. Both were written by 0c9c3ded1 and are byte-identical on main bae8bf98e, so make CC=gcc test-escrow-dispute cannot link on an unmodified checkout either. Running the target through the Makefile's own hook, make CC=gcc EXTRA_LDFLAGS=\"programs/target/debug/liblayerx_programs_sandbox.a -ldl -lm\" test-escrow-dispute, links and the rewritten dispute test passes, which places the defect in the rule rather than in the test or the module."
assumption = "The Makefile is outside this row's owned paths, so both rules were left exactly as written and the supplementary dispute gate was run through EXTRA_LDFLAGS instead. Repairing them means adding $(PROGRAMS_RUNTIME_LIB), the programs-build prerequisite and -ldl -lm to the two rules, matching the four escrow rules beside them."
severity = "blocker"

[observation.6.11.2801]
task = "6.11"
file = "tests/modules/test_service_dispute.c include/layerx/lx_escrow.h"
symbol = "service_to_escrow lx_escrow_store lx_escrow_state_put"
observed = "Escrow hold state moved from a caller-owned lx_escrow_store array into module-scoped kernel KV, so the lx_escrow_store type and the store pointer on every escrow request no longer exist. tests/modules/test_service_dispute.c is the only file outside src/modules/escrow and tests/modules/test_escrow*.c that referred to them: it declares lx_escrow_store escrow at line 147, zeroes it at line 170, seeds a hold with lx_escrow_state_put(&escrow, &escrow_record) at line 300 and sets capture_request.store at line 305. The file no longer compiles, so make CC=gcc test-service-dispute and make CC=gcc core-test-all cannot build it; the gate set of this row (make CC=gcc test, make beta-ledger-check) does not reach it. The adaptation is mechanical: delete the declaration, the memset and the store assignment, and swap the order of the remaining two calls at lines 300 to 303 so lxp_module_ctx_init for LXP_MODULE_ESCROW runs first and the seed becomes lx_escrow_state_put(&ctx, &escrow_record), which is what the escrow tests do."
assumption = "tests/modules/test_service*.c is owned by the service-module row, which is rewriting the same file, so the four lines were left exactly as written and the request is recorded here and in the lane's NEEDS.md rather than applied across the ownership boundary."
severity = "blocker"

[observation.6.11.2802]
task = "6.11"
file = "cmd/layerxd/lxp_daemon_process.c cmd/layerxd/lxp_daemon_protocol.c cmd/layerx-guarantor/runtime.c"
symbol = "lxp_kernel_bind_module_runtime lx_escrow_runtime LXP_MODULE_ESCROW"
observed = "Escrow dispatch resolves the account registry and the asset registry through the module runtime that lxp_kernel_bind_module_runtime installs, exactly as the asset and programs modules do, and refuses with LXP_ERR_MODULE_DISABLED when no runtime is bound. No production process binds one: layerxd binds LXP_MODULE_ASSET at cmd/layerxd/lxp_daemon_process.c line 4957 and LXP_MODULE_PROGRAMS at cmd/layerxd/lxp_daemon_protocol.c line 665, and the guarantor binds the same two at cmd/layerx-guarantor/runtime.c lines 873 and 943. Until one of those call sites also builds an lx_escrow_runtime over the process account and asset registries, every escrow activity submitted to a node is refused before it reaches the module, whatever the genesis enable flag says."
assumption = "cmd/layerxd and cmd/layerx-guarantor are outside this row's owned paths, so the binder was not added here; the module was qualified at module level with the runtime bound in the tests. The binding is a one-site change per process, mirroring the asset runtime already assembled beside it."
severity = "blocker"

[observation.6.11.2803]
task = "6.11"
file = "src/protocol/lxp_genesis.c"
symbol = "module_table LXP_GENESIS_MODULE_GATE_ENABLE_FLAG"
observed = "The row that registers this module in the genesis module table is supplied by the table row of the genesis-table change and carries the enable flag clear, so a genesis built from the default table still materialises without the escrow module. No second row was appended here because module_table_validate refuses a duplicate module id, and the flag was not flipped because flipping it changes the genesis state root and every snapshot fixture that pins it."
assumption = "The escrow module stays default-disabled in genesis, and one later change flips the flags of all the new modules together and regenerates the fixtures in a single revision. The dispatch, the KV state and the events are therefore qualified at module level, with the kernel registration and the module runtime built directly in the tests."
severity = "note"

[observation.6.11.2804]
task = "6.11"
file = "src/modules/escrow/lx_escrow_capture.c src/modules/escrow/lx_escrow_timeout.c src/protocol/lxp_module_ctx.c"
symbol = "lx_escrow_capture_execute lx_escrow_epoch_begin lxp_effect_buffer_add lxp_ctx_emit_transfer_set"
observed = "Three decisions were taken inside this row's default. First, a capture or release against a hold whose expiry has passed is refused with LXP_ERR_HOLD_EXPIRED before any hold state, ledger balance or idempotency record is touched, so the epoch sweep in lx_escrow_epoch_begin stays the only writer of the timed-out transition and a refused activity leaves no trace. Second, the sweep collects at most LX_ESCROW_SWEEP_CAPACITY holds per epoch and refuses the whole epoch with LXP_ERR_ARENA_EXHAUSTED rather than settling a prefix, because a partial sweep would move funds for some holds and silently defer others. Third, the kernel allows one transfer set per module context (lxp_ctx_emit_transfer_set sets ctx->transfer_applied, cleared only by lxp_module_ctx_commit) and lxp_effect_buffer_add refuses a non-increasing (module_id, ordinal) pair with LXP_ERR_UNSORTED_SEQUENCE while lxp_module_ctx_init resets ctx->next_effect_ordinal to zero, so a caller that re-initialises a context must re-initialise its effect buffer as well; the escrow tests do both between economic operations."
assumption = "These follow the row's default of implementing fully rather than deferring, and none of them relaxes an existing check. The effect-buffer coupling is a property of the kernel, not of this module, and is recorded so the next module lane that re-initialises a context does not read the refusal as a module defect."
severity = "note"

[observation.6.11.2805]
task = "6.11"
file = "tests/test_genesis_manifest.c src/modules/asset/lx_asset_registry.c include/layerx/lx_asset.h"
symbol = "check_version lxp_kernel_module_for_activity activity_types LX_ASSET_WITHDRAW"
observed = "make CC=gcc test-genesis-bootstrap exits 1 on the state-commitment protocol version: tests/test_genesis_manifest.c line 203 requires lxp_kernel_module_for_activity to refuse the asset activity whose ordinal is 9, and it resolves. LX_ASSET_WITHDRAW is 0x00010009 (include/layerx/lx_asset.h line 29) and the asset module advertises it in activity_types at src/modules/asset/lx_asset_registry.c lines 11 to 16, so the sorted lookup finds it and answers LXP_OK. The refusal the test asserts and the advertised ordinal contradict each other in the tree as published. The same target fails identically on an unmodified checkout of main 055ec44d7, built from a tree with no escrow change in it, so the contradiction is independent of this branch; evidence qual-logs/genesis-tests-mainref.log beside this branch's qual-logs/genesis-tests.log. The target is not reachable from the make test target and is not in this row's gate set."
assumption = "Neither the assertion nor the advertised ordinal was touched: one of them is wrong and deciding which belongs to the asset-module and genesis-table owners, not to this row. The escrow row of the genesis module table is gated by its enable flag and defaults to disabled, so no escrow module is registered on the path this test walks."
severity = "blocker"

[observation.3.1.3600]
task = "3.1"
file = "src/network/lxp_gateway_kv.c include/layerx/lxp_kernel.h src/network/lxp_gateway_internal.h"
symbol = "lxp_gateway_kv lxp_gateway_kv_put LXP_KERNEL_MAX_MODULE_KV LXP_MODULE_MAX_VALUE_BYTES"
observed = "The gateway settlement path holds no lxp_module_ctx and no lxp_kernel, and the kernel module key/value store it would have to borrow is itself fixed: include/layerx/lxp_kernel.h:17-20 caps a kernel at 512 module entries, 128 key bytes, 1024 value bytes and 64 staged writes per activity, while one persisted invoice record is 655 bytes for an effect-free receipt and grows with the receipt effect list. Routing invoice and idempotency state through lxp_ctx_kv_put would therefore have replaced the 256-entry invoice array with a 512-entry kernel-wide array and refused every record above 1024 bytes, so the bookkeeping was persisted in a growable canonical key/value store owned by the gateway, built on the same state commitment conventions as src/state/lxp_state_proof.c: LXP_DOMAIN_STATE_LEAF leaves over u32 big-endian key and value lengths, LXP_DOMAIN_STATE_NODE internal nodes, keys ordered by memcmp over the common prefix then shorter first, and the empty root defined as the leaf domain over no bytes. lxp_gateway_kv_put charges the net byte delta of every write to lxp_meter_charge_storage, so the only remaining limit on invoice and idempotency count is the storage ceiling of the settlement meter."
assumption = "Canonical module key/value state means a deterministic commitment over sorted key/value pairs with metered growth, not the fixed kernel array, whose bounds are smaller than the state being persisted. The gateway store is confined to src/network and no kernel, module context or ledger file was changed to reach it."
severity = "note"

[observation.3.1.3601]
task = "3.1"
file = "src/ledger/lxp_receipt.c src/protocol/lxp_receipt.c src/network/lxp_gateway_kv.c"
symbol = "lxp_ledger_receipt_build lxp_receipt_decode gateway_receipt_record_write gateway_receipt_record_read"
observed = "lxp_ledger_receipt_build (src/ledger/lxp_receipt.c:13-57) never assigns module_id, module_version or parameter_version, so every receipt the gateway settles carries module_id 0 and module_version 0. lxp_receipt_encode accepts such a receipt and produces canonical bytes, but lxp_receipt_decode refuses them with LXP_ERR_NON_CANONICAL at src/protocol/lxp_receipt.c:792-795, which requires a non-zero module_id and module_version. A settled gateway receipt is therefore encodable and returnable over the wire but cannot be decoded back by the protocol codec, so the persisted invoice record uses an explicit gateway record encoding in the same style as lx_perps_market_encode: fixed big-endian fields, a length-prefixed effect list, refusal of any receipt carrying a program outcome, and a decode-and-compare of the encoded record against the original receipt before the write is admitted."
assumption = "The missing module identity on ledger receipts belongs to the ledger receipt builder and its callers rather than to the gateway, and setting it inside src/network would change receipt bytes and signatures and break the equality tests/test_gateway_send.c asserts between the gateway receipt and the direct ledger receipt, so neither the builder nor the protocol codec was changed."
severity = "blocker"

[observation.3.1.3602]
task = "3.1"
file = "src/ledger/lxp_send.c src/ledger/lxp_receive.c include/layerx/lxp_ledger.h"
symbol = "lxp_send_execute lxp_receive_execute LXP_SEND_STORE_CAPACITY"
observed = "lxp_send_execute refuses with LXP_ERR_ARENA_EXHAUSTED once the store holds LXP_SEND_STORE_CAPACITY records (src/ledger/lxp_send.c:332) and lxp_receive_execute does the same for its idempotency window (src/ledger/lxp_receive.c:414), with the capacity fixed at 64 in include/layerx/lxp_ledger.h:76. The gateway now keeps the authoritative duplicate history in metered key/value state and treats lxp_send_store as a write-through window: it checks the persisted history immediately before delegating, and when the window is full it mirrors every record it holds into the store and empties it, so gateway settlement is no longer bounded at 64 keys. Both ledger refusals and the 64-entry array are untouched, so any caller that reaches lxp_send_execute or lxp_receive_execute without the gateway still refuses the sixty-fifth distinct idempotency key."
assumption = "The ledger primitives and their capacity constant are outside the gateway paths this issue owns, so the bound was left in place and worked around rather than raised."
severity = "note"

[observation.3.1.3603]
task = "3.1"
file = "src/network/lxp_gateway_kv.c src/network/lxp_gateway_send.c src/network/lxp_gateway_receive.c"
symbol = "lxp_gateway_window_reserve gateway_send_settle_locked gateway_receive_claim_locked"
observed = "lxp_gateway_window_reserve mirrors every record of a full lxp_send_store into the persisted key/value history and then clears the array, including records a non-gateway writer placed in the same store. Duplicate detection for those records is preserved, because the gateway pre-check reads the persisted history for the same idempotency key before delegating, but a writer that reads lxp_send_store->records directly instead of calling lxp_send_execute would no longer see them. No such reader exists in this revision; the store is read only by lxp_send_execute, lxp_receive_execute and the gateway."
assumption = "The store is a ledger-internal replay window rather than a public listing, so compacting it while preserving refusal behaviour is sound. If a future caller enumerates the array directly it must read the persisted history instead."
severity = "note"

[observation.3.1.3604]
task = "3.1"
file = "tests/test_gateway_send.c tests/test_gateway_receive.c tests/network/test_gateway_kv.c Makefile"
symbol = "test-gateway-kv core-test-all"
observed = "Removing the fixed invoice array required the two existing gateway tests to stop reaching into lxp_gateway_invoice_registry->records and to assert against the persisted state instead, and the new coverage that crosses both former limits needed a build rule, so tests/test_gateway_send.c, tests/test_gateway_receive.c, tests/network/test_gateway_kv.c and the Makefile were changed alongside the owned gateway sources. No assertion was relaxed: every previous check was replaced by an equal or stronger one over the key/value count, stored byte total and state root, and the new target was added to core-test-all rather than replacing an existing one. make CC=gcc test does not reach any gateway target, so the three gateway tests were run as a separate gate."
assumption = "Tests that read a removed data structure cannot be left untouched, and a new test that is not wired into a target does not run, so both were treated as part of this change rather than as separate work."
severity = "note"

[observation.3.3.3100]
task = "3.3"
file = "src/modules/service/lx_service_module.c src/modules/service/lx_service_agreement.c include/layerx/lx_service.h"
symbol = "module_execute lx_service_agreement_propose_execute lx_service_agreement_accept_execute LX_SERVICE_AGREEMENT_PROPOSED"
observed = "Before this change the service module advertised thirteen activity types and its execute entry point returned LXP_OK for every one of them without emitting an effect or writing a byte of state, so agreement formation was unobservable. Making agreement formation real forced a decision about which side is authorised for which ordinal, because a single-step form in which the buyer both proposes and forms the agreement lets a buyer bind a provider to a delivery deadline and a dispute window without the provider ever signing. service.agreement_propose (ordinal 3) is now buyer-authorised and creates the agreement in a new LX_SERVICE_AGREEMENT_PROPOSED state; service.agreement_accept (ordinal 4) is now provider-authorised, refuses any agreement not in that state, re-checks the offer for withdrawal, prior acceptance and expiry, moves the agreement to LX_SERVICE_AGREEMENT_FORMED and marks the offer accepted. The offer's delivery deadline, acceptance window and dispute window are copied into the agreement at propose time with overflow refusals, so both sides see the same windows before either is bound."
assumption = "spec/layerx-protocol/design.md section 12.5 names both service.agreement_propose and service.agreement_accept but does not say which principal authorises each, and the deployed code implemented neither, so no existing behaviour is contradicted. The lane default is to implement fully, and the two-step form is the only reading in which service.agreement_accept has work to do. LX_SERVICE_AGREEMENT_PROPOSED was appended as state 8 rather than renumbering the existing states, so every previously encoded state value keeps its meaning."
severity = "note"

[observation.3.3.3101]
task = "3.3"
file = "src/modules/service/lx_service_module.c spec/layerx-protocol/design.md"
symbol = "activity_types lx_service_effect_audit LX_SERVICE_ACCEPT LX_SERVICE_REJECT LX_SERVICE_OFFER_WITHDRAW LX_SERVICE_COMMIT_ABANDON"
observed = "The module advertises thirteen ordinals and none of them is named settle or cancel. The settlement half of the lifecycle is service.accept and service.reject, which move a delivered agreement to ACCEPTED or REJECTED and record the rejection reason and the contested deliverable hashes; the cancellation half is service.offer_withdraw, which retires an unaccepted offer, and service.commit_abandon, which returns a committed agreement to FORMED. No service ordinal produces a value leg: design.md lines 998 to 1002 state Transfers emitted: none, and lx_service_effect_audit refuses at LXP_FATAL_INVARIANT if any effect in the buffer carries LXP_EFFECT_TRANSFER or the monetary flag, and at LXP_ERR_UNKNOWN_ACTIVITY if the activity type is not one the interface declares. Value movement for a service agreement remains an escrow transfer that references the same agreement identifier."
assumption = "Implementing settle and cancel as literally named ordinals would widen the module's activity vocabulary beyond the thirteen the design document fixes and beyond what the registry, the daemon and the hosted core admit. The four existing ordinals cover the same lifecycle transitions, so the vocabulary was left at thirteen."
severity = "note"

[observation.3.3.3102]
task = "3.3"
file = "src/protocol/lxp_kernel.c src/modules/service/lx_service_acceptance.c src/modules/escrow/lx_escrow_timeout.c src/modules/budget/lx_budget_period.c"
symbol = "lxp_kernel_register_module lx_service_epoch_begin lx_service_acceptance_default lx_escrow_epoch_begin lx_budget_epoch_begin"
observed = "The module interface declares epoch_begin and epoch_end and lxp_kernel_register_module refuses a registration whose epoch_begin or epoch_end is null at src/protocol/lxp_kernel.c:991, but no line in src/, cmd/ or platform/ ever calls either hook. lx_service_epoch_begin implements the default acceptance outcome the design requires: it sweeps every agreement still in LX_SERVICE_AGREEMENT_DELIVERED whose acceptance window has closed and applies the offer's declared default outcome, setting default_applied and the outcome sequence and timestamp. With no caller, a buyer who simply never answers leaves the agreement DELIVERED for ever and the declared default never fires. lx_escrow_epoch_begin and lx_budget_epoch_begin have the same problem. The service sweep is proven by tests/modules/test_service_acceptance.c, which drives it directly through the module context and asserts that a delivered agreement past its window becomes ACCEPTED with default_applied set while an already accepted and an already rejected agreement are left alone."
assumption = "The kernel is outside this lane's owned paths, so the missing call site is recorded rather than added. The hook is implemented, registered and covered by tests so that the only remaining work is the kernel-side invocation."
severity = "blocker"

[observation.3.3.3103]
task = "3.3"
file = "src/modules/service/lx_service_state.c include/layerx/lx_service.h include/layerx/lxp_kernel.h"
symbol = "lx_service_delivery_put lx_service_delivery_lookup lx_service_deliverable_prefix LXP_MODULE_MAX_VALUE_BYTES"
observed = "A delivery carries up to LX_SERVICE_MAX_DELIVERABLES, which is 16, and each deliverable is a 32-byte hash, an 8-byte artifact size and a 32-byte availability reference. A single record holding a full delivery would be about 1289 bytes, above the LXP_MODULE_MAX_VALUE_BYTES cap of 1024 that lxp_ctx_kv_put enforces. Rather than lower the deliverable bound, the delivery is stored as a 138-byte header under the delivr:1 prefix keyed by delivery identifier plus one 73-byte record per deliverable under the delitm:1 prefix keyed by delivery identifier and index, so the largest single value written is 138 bytes and a full 16-item delivery costs 17 staged writes against the LXP_MODULE_MAX_STAGED_WRITES budget of 64. lx_service_delivery_lookup reads the header, then reads exactly deliverable_count item records, so a truncated item set fails the lookup rather than returning a short delivery."
assumption = "LX_SERVICE_MAX_DELIVERABLES and LXP_MODULE_MAX_VALUE_BYTES are both declared bounds and neither was changed. Splitting the record keeps both intact and keeps the per-activity staged-write count inside the kernel budget."
severity = "note"

[observation.3.3.3104]
task = "3.3"
file = "Makefile tests/modules/test_service_offer.c tests/modules/test_service_dispute.c"
symbol = "test test-wave-8 test-service-offer test-service-dispute"
observed = "The aggregate make test target at Makefile:267 does not depend on any module test target: the six service targets, and likewise the asset, escrow, budget, stream, oracle and perps targets, are reachable only individually or through the wave aggregates such as test-wave-8 at Makefile:1447. A service regression therefore cannot fail make CC=gcc test. This lane ran make CC=gcc test and, separately, the six service targets, and recorded both. The Makefile is also fixed to exactly six tests/modules/test_service_*.c files with no shared service test header, so each of the six duplicates the kernel bring-up, the payload builders and the event assertion helper it needs."
assumption = "The Makefile is outside this lane's owned paths, so neither the missing test dependency nor a seventh test file was added. The six existing files were rewritten in place against the new context and key-value API and all six pass."
severity = "blocker"

[observation.3.3.3105]
task = "3.3"
file = "tests/modules/test_service_dispute.c src/modules/escrow"
symbol = "lx_escrow_store lx_escrow_state_put lx_escrow_capture_execute counting_applier lx_service_effect_audit"
observed = "The previous tests/modules/test_service_dispute.c proved that a service dispute moves no value by building an escrow store with lx_escrow_store, seeding balances with lx_escrow_state_put, calling lx_escrow_capture_execute and asserting that the escrow and provider balances and the transfer call count were unchanged at the end. That store-based escrow API is being replaced with canonical module key-value state in another lane, so the escrow half was dropped rather than pinned to an API that is going away. The invariant is preserved inside the service module: the rewritten test installs a transfer applier on the kernel through lxp_kernel_set_capabilities that counts every call and returns LXP_FATAL_INVARIANT, drives the whole lifecycle from offer publication through dispute resolution, and asserts the counter is still zero, that the applier is still installed, that every effect the module emitted is LXP_EFFECT_EVENT with monetary false and module id LXP_MODULE_SERVICE, and that lx_service_effect_audit refuses a transfer effect, a monetary effect, an over-length effect buffer and an undeclared activity type."
assumption = "The service module is the subject under test and it never reaches the ledger, so a counting applier that fails loudly if it is ever called is equivalent evidence for that claim. A cross-module test that also exercises escrow capture belongs where both modules' current APIs are owned."
severity = "note"

[observation.6.11.2500]
task = "6.11"
file = "spec/layerx-protocol/design.body.md docs/wiki/Modules.md include/layerx/lxp_ledger.h src/ledger/lx_account_registry.c src/ledger/lxp_apply.c"
symbol = "lx_account lx_account_validate_canonical lxp_precondition_check design 12.1"
observed = "spec/layerx-protocol/design.md section 12.1 described asset state as the asset registry, the account registry and a balance tree keyed by (account_id, asset_id). No such third structure exists. include/layerx/lxp_ledger.h:47-61 gives each lx_account record one account id, one asset_id with a has_asset flag and one lxp_u128 balance; src/ledger/lx_account_registry.c:119-123 refuses a record that carries a balance or an asset id while unbound; src/ledger/lxp_apply.c:171-175 refuses a debit whose leg asset is not the debited record's asset and :245-248 binds an unbound credit destination to the leg's asset once; src/ledger/lxp_apply.c:138-148 answers a balance read for any other asset with ERR_ASSET_MISMATCH. The account registry indexed by account id is therefore already the per-(account, asset) balance state, which is also what the design's own struct lx_account in section 7.1 models."
assumption = "The record-per-pair model is ratified as the intended design rather than the tree wording, so section 12.1 now states that no separate balance structure exists and new sections 8.2 and 8.3 document the model, its asset-binding rules and the per-asset sequence semantics against the cited sources. No code was changed. The registry's fixed capacity is deliberately not restated in the documentation so the durable-index work owns that number alone."
severity = "note"

[observation.6.11.2501]
task = "6.11"
file = "spec/layerx-protocol/design.body.md include/layerx/lxp_ledger.h src/ledger/lx_account_id.c src/protocol/lxp_module_ctx.c"
symbol = "lx_account_kind lx_asset_issuance_name lx_account_migrate_retired_issuance"
observed = "Two further statements in the same design sections did not match the implementation. Section 8 listed enum lx_account_kind as ending LX_ACCT_SYS_FUNDING = 7, INSURANCE = 8, FEES = 9, RESERVE = 10, WITHDRAW = 11, while include/layerx/lxp_ledger.h:19-33 defines FUNDING_LONG = 7, FUNDING_SHORT = 8, INSURANCE = 9, FEES = 10, PAXEER_RESERVE = 11, PAXEER_WITHDRAWALS = 12 and MODULE_VALUE = 13; that byte is committed by every account state leaf (src/state/lxp_state_root.c:247), so the stale numbering was consensus-visible. Section 12.1 and docs/wiki/Modules.md also named an asset's issuance account asset:<hex64 asset_id>:issuance, but src/ledger/lx_account_id.c:214-242 derives the id from that string and stores the record under module:asset:value:<hex64 account_id>, which is what src/protocol/lxp_module_ctx.c:468-495 stages at registration; the older string survives only as a name that lx_account_migrate_retired_issuance renames on load."
assumption = "Both were corrected in the documentation because the account kind byte and the canonical account name are exactly what the account leaf commits, so the leaf shape cannot be documented accurately while they disagree. Section 8 now carries the header's own identifiers and values and both documents name the module-value form with its id derivation. No code was changed."
severity = "note"

[observation.6.11.2502]
task = "6.11"
file = "src/state/lxp_state_root.c src/state/lxp_snapshot.c src/ledger/lx_account_id.c"
symbol = "account_state_leaf_material lx_account_registry_retired_issuance_root lxp_snapshot_load_retired_issuance"
observed = "account_state_leaf_material (src/state/lxp_state_root.c:220-265) migrates a copy of a retired issuance record when allow_retired_issuance is set, checks that the copy renames cleanly, and then commits the original record's stored name and fields into the leaf; the migrated copy is never committed. lx_account_registry_retired_issuance_root is the only caller path, and src/state/lxp_snapshot.c:998-1078 uses it to recompute a legacy snapshot's account root, module-zero subtree root and canonical state root over an untouched copy of the loaded records while the working registry is renamed in place, refusing the load unless at least one record was renamed."
assumption = "Committing the stored retired name is read as deliberate root continuity - the recorded roots were produced before the rename, so reproducing them requires the pre-rename name - rather than a missed assignment. Section 8.3 documents it that way. Nothing was changed; if the intent is otherwise this note is the anchor for the owning lane."
severity = "assumption"

[observation.6.11.2503]
task = "6.11"
file = "spec/layerx-beta/requirements.md spec/layerx-beta/tasks.md spec/layerx-protocol/requirements.md"
symbol = "specgen render"
observed = "Running the spec render at bae8bf98e5159986569235e7993b3895c997391e rewrote four files. One, spec/layerx-protocol/design.md, is this change's own regenerated output. The other three were already stale against their kvx sources before this change and none of them is rendered from a file this change touched: spec/layerx-beta/requirements.md acceptance criteria 3 and 4 of the trusted-boundary requirement, spec/layerx-beta/tasks.md tasks 6.1 to 6.3, and spec/layerx-protocol/requirements.md acceptance criteria 12 to 14 of the asset requirement, whose rendered text carries the module-value issuance account and the pause/unpause admission exclusion that the checked-in markdown still omits."
assumption = "The drift belongs to the lanes that edited those spec.kvx sections without re-rendering, so the three files were restored to their committed state and only the regenerated design.md is carried here. Renderer output for spec/layerx-protocol/design.md is byte-identical to the two-line generation banner followed by design.body.md, which was verified before and after the edit."
severity = "note"

[observation.5.4.6800]
task = "5.4"
file = "platform/hosted/gateway/openrpc.json platform/hosted/gateway/src/rpc.rs"
symbol = "lx_sendActivity -32005 lx_getReceipt"
observed = "The two ground-truth files for the public method contract disagree in two places. openrpc.json declares the -32005 message for lx_sendActivity as \"Read unavailable\" while rpc.rs emits \"Submission unavailable\" for every code on the submit path. openrpc.json also states that a successful lx_getReceipt result includes receipt bytes and a result_code, while the core route that serves it returns exactly activity_id and receipt; the repository's own gateway local-harness test decodes the code out of the receipt bytes instead of reading a field. The public documentation was written against the route, not against the schema."
assumption = "Neither file was edited from this row. The schema and the route are owned by the gateway lane; documenting the route's actual shape does not settle which of the two should change."
severity = "suspect"

[observation.5.4.6801]
task = "5.4"
file = "platform/hosted/core/src/main.rs platform/hosted/gateway/src/ws.rs"
symbol = "receipt route identifier case"
observed = "Identifier case is handled inconsistently across the public surface. The gateway selector parses either case, and the WebSocket account topic silently lowercases the account id it is given, but the core receipt route refuses any activity id containing an uppercase hexadecimal digit with HTTP 400, which the gateway maps to JSON-RPC -32602. The same identifier therefore succeeds on one public method and is refused as malformed on another."
assumption = "The refusal is the stricter behaviour and was not relaxed. The documentation now states the asymmetry rather than the previous claim that identifiers may be either case everywhere."
severity = "note"

[observation.5.4.6802]
task = "5.4"
file = "docs/wiki/Cli.md platform/cli/src/credential.rs"
symbol = "credential.rs line anchors"
observed = "The CLI page carries roughly fourteen line-number citations into platform/cli/src/credential.rs that predate a revision which removed about forty-five lines from that file. The anchors corrected here are the ones whose surrounding claim was also wrong; the remainder still name the right symbol but point a few lines off. Line anchors into that file will keep drifting until the page cites symbols instead of ranges."
assumption = "Only anchors attached to a claim that was independently checked were moved, so no citation was silently re-pointed at text that does not support it."
severity = "note"

[observation.5.4.6803]
task = "5.4"
file = "programs/sdk/rust/src/lxt20.rs programs/fixtures/pay5 programs/sdk/rust/examples"
symbol = "LXT-20 account-bound-set/v1"
observed = "Several published pages describe an LXT-20 reference program, its request codecs, a payments-merchant example, a programs/fixtures/pay5 fixture directory with a native round-trip replay, and a LayerX/programs/402LXP/account-bound-set/v1 transfer-authority wrapper accepted by the Go, JVM, Swift and .NET SDKs. None of those paths and no occurrence of that wrapper tag exist in this tree. The two porting migration guides are 363 and 328 lines here and carry no LXT-20 section, so the citations into lines beyond those bounds resolve to nothing."
assumption = "The material was kept and relabelled as absent from this tree rather than deleted, because it describes a contract that a later revision is expected to land; the line-range citations that could not resolve were replaced with section names."
severity = "note"

[observation.5.4.6804]
task = "5.4"
file = "spec/layerx-beta/qualification.kvx"
symbol = "documentation source assertions"
observed = "The source assertions this documentation lane originally recorded pinned three lane heads that are no longer reachable from any remote ref; their common ancestor with the current lane heads is roughly nine hundred commits back on each side, so the pinned reads now return entirely different trees. The claims were therefore re-verified against the merged working tree instead, and the schema-contract check was moved from a piped git show onto the tracked openrpc.json."
assumption = "Re-verifying against the merged tree is strictly stronger than re-reading an orphaned revision, so no assertion was dropped in the exchange."
severity = "note"

[observation.5.4.7800]
task = "5.4"
file = "Makefile tools/ci/beta-contract-check.sh platform/docs/content/beta.md"
symbol = "beta-report beta_contract_check hosted-agentd middleware-examples"
observed = "The wiring observation 5.4.5404 recorded as a request and the blocker observation 5.4.5403 recorded as an owner decision are both closed by this change, and the closure is one change because each half depends on the other. Makefile now declares beta-report on the .PHONY line beside beta-ledger-check and beta-contract-check and runs tools/ci/beta-report.sh, so task 5.4's verify_cmd make beta-report beta-ledger-check beta-contract-check runs as written. tools/ci/beta-contract-check.sh now normalises its contract path to an absolute path, reduces it to a root-relative argument so the report renders with the same contract identity string it carries on disk, runs tools/ci/beta-report.sh --check --contract with it after its own python check, and returns the contract status when that is non-zero and the report status otherwise, so both checks always run and both violation lists are printed. Three runs exercise the propagation: the unmodified tree exits 0 with both summaries, a tree with a line appended to spec/layerx-beta/report.md exits 1 with 'beta-report: spec/layerx-beta/report.md is not the report this evidence renders', and a tree with the middleware-examples row deleted from the contract exits 1 with both the contract violation and the report violation. The two derived surfaces are now listed in Surfaces and journeys: hosted-agentd (hosted, required deployment_proven, source platform/hosted/agentd) and middleware-examples (functional, required runtime_proven, source platform/middleware/examples). Neither derivation at tools/ci/beta-contract-check.sh was removed, narrowed or given a new exclusion; the check reads exactly as it did. Evidence: qual-logs/beta-contract-check.log, qual-logs/beta-report.log, qual-logs/beta-report-check.log, qual-logs/beta-ledger-check.log."
assumption = "Both new rows state reached rung source_present, which is what the evidence supports: no gate record exists on any release-candidate revision, tools/ci/beta-report.sh records source_present for every surface, and its --check agrees with the contract. The journey text of each row describes only what the directory holds. platform/hosted/agentd holds manifest_check.py, which asserts that platform/hosted/node/deployment.yaml publishes the layerx-agentd Service behind the agentd-boundary container with its mutual-TLS volumes and NetworkPolicy, and probe.sh, which asserts that the deployed Service answers ready only for an internal-CA client certificate carrying the agent program bearer and refuses both the missing bearer and the missing client certificate. platform/middleware/examples holds public-rpc.mjs, which drives the seller middleware build, and public_rpc.py, which drives layerx_sdk, each reading the public RPC sequence, claiming faucet funding and verifying a signed payment activity against executed or batched commitment. Neither surface is named in the beta-report evidence map, so no gate command in the repository can raise either above source_present today; that ceiling is the report's own output and no rung was claimed to hide it."
severity = "note"

[observation.6.6.3700]
task = "6.6"
file = "src/paxeer/lxp_bond_client.c cmd/layerx-guarantor/settlement.c cmd/layerx-guarantor/settlement.py"
symbol = "lxp_paxeer_membership_commitment gp_settlement_membership_sync membership wire_encode"
observed = "The membership mirror binds the Paxeer chain id, the GuarantorBond address, membershipVersion, the observed epoch and a canonical commitment over the decoded set, but it cannot bind the block number the read was taken at or GuarantorBond's governance sequence. cmd/layerx-guarantor/settlement.py membership() resolves a block number for the eth_call batch and drops it, and wire_encode's membership frame carries only version, threshold, maximum attestation delay, member count, minimum bond and the 85-byte per-member record, so gp_settlement_membership at cmd/layerx-guarantor/settlement.c:219 has neither field to hand to lxp_paxeer_membership_sync. lxp_guarantor_set.last_governance_sequence therefore stays zero in the mirror and is hashed as zero into the commitment preimage."
assumption = "membershipVersion is monotone in GuarantorBond and is enough to order and refuse rollbacks, so the commitment is canonical for a given version without the block number. Extending the membership frame with the observed block number and lastGovernanceSequence is a change to the settlement helper's wire and to its C decoder; the commitment preimage already reserves an eight-byte governance sequence field so that extension does not change the hash for records whose sequence is zero."
severity = "note"

[observation.6.6.3701]
task = "6.6"
file = "cmd/layerx-guarantor/main.c cmd/layerx-guarantor/settlement.c"
symbol = "gp_settlement_membership_sync gp_settlement_membership"
observed = "gp_settlement_membership_sync reads GuarantorBond membership through the Paxeer RPC client and binds it into lxp_paxeer_bond_state, but the guarantor daemon does not call it yet: cmd/layerx-guarantor/main.c calls gp_settlement_membership directly at lines 190, 231 and 511 and keeps only lxp_guarantor_set, so the daemon holds no lxp_paxeer_bond_state and never observes the sync availability. The chain-backed path is exercised by tests/paxeer/membership-sync-chain.py through tests/paxeer/membership_sync_driver.c."
assumption = "The producer and attestation paths in main.c are governed by their own qualification and changing where the daemon holds bond state would alter behaviour beyond the membership boundary, so the entry point is left unchanged and the binding is reachable through the settlement boundary and its driver."
severity = "note"

[observation.6.6.3702]
task = "6.6"
file = "Makefile"
symbol = "test-paxeer-membership-sync test-paxeer-membership-chain"
observed = "The two new membership targets are appended at the end of the Makefile rather than beside the other paxeer test rules near line 1090, because the chain driver's prerequisites expand GUARANTOR_OBJECTS and LAYERXD_OBJECTS, which are defined at line 3284 and are empty when a rule is read before that point. The unit target is attached to the aggregate test target with a separate prerequisite-only line, the same form used for test-daemon-guarantor at line 3339, so the existing recipe lines are untouched. test-paxeer-membership-chain is not attached to test because it requires anvil, forge and the settlement helper's Python dependencies."
assumption = "A prerequisite-only append is the repository's existing way of extending an aggregate target without rewriting it, and placing the block after the guarantor variable definitions is required for the driver to link at all."
severity = "note"

[observation.6.6.3703]
task = "6.6"
file = "src/paxeer/lxp_bond_client.c contracts/GuarantorBond.sol"
symbol = "lxp_paxeer_membership_sync minimumBond custodiedValue minimumBondBps"
observed = "GuarantorBond.minimumBond() derives the bond floor from custodiedValue and minimumBondBps on chain, and lxp_paxeer_bond_init derives the same floor from the configured custodied value and basis points. lxp_paxeer_membership_sync requires the two to be equal and answers LXP_ERR_CONTEXT_MISMATCH when they are not, rather than adopting the chain's value into the mirror. tests/paxeer/membership-sync-chain.py drives the refusal against a live GuarantorBond whose custodiedValue is 1000 at 1000 basis points while the caller declares 2000."
assumption = "The GuarantorBond deployment named in the cluster configuration is the authority for membership, and the custodied value and basis points a node is configured with are the authority for its own eligibility threshold. Silently adopting the chain's floor would let a mismatched configuration attest under a threshold it never accepted, so the divergence is refused and both values are left as written."
severity = "note"

[observation.6.6.3704]
task = "6.6"
file = "src/paxeer/lxp_bond_client.c src/protocol/lxp_protocol.c contracts/GuarantorBond.sol"
symbol = "LXP_PAXEER_MEMBERSHIP_TAG lxp_domain_tag sealGenesisBondedSet"
observed = "The membership commitment prefixes its sha256 preimage with the literal tag LXP/Paxeer/membership-mirror/v1 including its terminating NUL instead of adding an entry to the lxp_domain_tag table in src/protocol/lxp_protocol.c and a matching LXP_DOMAIN_ constant. The Paxeer side already commits this way: GuarantorBond.sealGenesisBondedSet hashes sha256(abi.encode(\"LXP/Paxeer/genesis-bonded-set/v2\", ...))."
assumption = "The commitment is a settlement-boundary artefact rather than a consensus domain, and the protocol domain table is shared by the kernel, so a literal tag matching the Paxeer contract convention keeps the tag space additive without renumbering the protocol domains. Moving it into lxp_domain_tag later changes no bytes as long as the same tag string and NUL terminator are used."
severity = "note"
[observation.3.7.5000]
task = "3.7"
file = "platform/hosted/human/guardians.py platform/hosted/human/owner_native.py platform/hosted/tests/beta-cluster.sh"
symbol = "enroll assemble guardian_set guardian_enrollment_key"
observed = "Each recovery guardian is now enrolled by its own process into its own custody directory human-guardians/<role>-e<epoch> under the secrets root, holding only that guardian's mode-0600 Ed25519 seed; the enrolling key signs a canonical binding over domain LX:HUMAN:GUARDIAN:BINDING:v1, the epoch, the role, the operator identity and its own public key. Assembly is a separate process that opens no custody directory: it reads the public enrollment documents, verifies every signature and publishes recovery-guardians.json, recovery-guardian-bindings.json and recovery-policy.json. The native producer re-verifies every binding through guardian_set before it uses the guardian keys, requiring distinct roles, operator identities, public keys and custody directories, a published key manifest that matches the members, a custody path whose name matches the role and epoch it claims, and a document threshold equal to the recovery policy threshold. The recovery commitment preimage is unchanged: SHA-256 of LX:HUMAN:RECOVERY:v1, NUL, u16be threshold, u16be count and the sorted Ed25519 public keys. The cluster script runs three enroll processes and one assemble process and publishes each seed Secret from its own directory."
assumption = "Three provisioning processes with disjoint custody directories on one host are not independent operators: separation is enforced by directory ownership and signature verification, not by separate machines or people. Independent operators and one pod per guardian remain production onboarding properties. Publication of the guardian Secrets and the binding ConfigMap still requires live cluster qualification, which this build server cannot run."
severity = "note"

[observation.3.7.5001]
task = "3.7"
file = "platform/hosted/human/guardians.py platform/hosted/human/owner_native.py"
symbol = "authorize enrolled guardian_member_key guardian_rotation_message"
observed = "Rotation enrolls the successor into a new custody directory at the next epoch, and a separate authorize process reads only the outgoing guardian's custody directory to sign LX:HUMAN:GUARDIAN:ROTATION:v1 over the epoch, role, operator identity, outgoing key and successor key. Assembly rebuilds the whole chain from epoch one and refuses a missing, mismatched or foreign-signed authorization; the consumer verifies the chain recursively, requiring each predecessor to carry the same role and operator identity, the preceding epoch, a different key and a different custody directory. A rotation yields a new guardian set, a new recovery commitment and a new recovery policy written into its own output directory; existing documents are never replaced, and enrollment refuses an epoch whose predecessor is absent."
assumption = "Rotation preserves the role and the operator identity; replacing the operator is a fresh enrollment rather than a key rotation. Chain depth is bounded at 64 epochs. Submitting a rotated commitment to the chain reuses the producer's existing native recovery activity, which registers once per evidence directory, so a rotated set is provisioned from its own evidence directory; that submission is not exercised without a live node."
severity = "note"

[observation.3.7.5002]
task = "3.7"
file = "platform/hosted/human/guardians.py platform/hosted/human/owner_native.py docs/wiki/Human-Owner-Registration.md"
symbol = "assemble guardian_set recovery-guardians.json"
observed = "recovery-guardians.json now carries version, threshold, public_keys and the signed members instead of public_keys alone, because it is the only guardian document the native producer input Secret and the container input list mount (platform/hosted/human/provision.sh:263, platform/hosted/human/native_manifest.py:23) and the producer image copies only provision.py and owner_native.py into the container (platform/hosted/human/Dockerfile:26). recovery-guardian-bindings.json holds the identical document and remains the ConfigMap copy. The per-member cluster operator label and the independent flag are replaced by the operator identity, the custody directory, the epoch, the binding signature and the rotation chain, so the document states verifiable facts rather than a claim of independence. docs/wiki/Human-Owner-Registration.md still describes the removed fields and the old per-role seed file layout."
assumption = "The wiki page, the Dockerfile and the two mount lists lie outside this change's paths, and the document shape was chosen so that no file outside them has to change for the in-cluster producer to consume the signed bindings. Updating the wiki page and adding guardians.py to the producer image if the enrollment tool is ever run inside the cluster are recorded as follow-ups."
severity = "note"

