observed = "The hosted registry StatefulSet references a prebuilt image with no Dockerfile in the repository, unlike testnet, gateway, faucet, webhooks and dashboard, and its cgroup and quota boundary is a host systemd unit ordered before kubelet. The hosted stack therefore cannot be rebuilt from source at a revision without additions."
assumption = "Task 3.7 adds platform/hosted/registry/Dockerfile and installs the boundary unit on registry nodes as part of beta cluster bring-up, so the beta cluster runs every hosted image from the release-candidate revision. The image tag in the manifest is pinned to the built digest by the bring-up script for the beta run and the manifest itself is not weakened."
severity = "assumption"

[observation.1.1.1]
task = "3.6"
file = "platform/hosted/gateway/deployment.yaml"
