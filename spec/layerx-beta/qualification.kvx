assumption = "Secret application and Human movement-policy consumption require cluster qualification, unavailable on this host. The private key remains only in its persistent 0600 file; it is not exported as a Secret. The authority path is provisioned but producer settlement publication remains blocked by observation 6.1.44."
severity = "note"

