[observation.6.11.terminal-authority-contract]
task = "6.11"
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
symbol = "layerx_programs_call_execute_rust transfer_source_validate decode_and_verify_program_terminal"
observed = "The real protocol-3 ABI2 executed output has a 470-byte terminal beginning with LXP/program-execution-with-occupancy/v1 plus NUL. Its u32BE inner length at offset 40 is 250; execution-v4 begins at offset 44, and the occupancy attachment is 172 bytes. Verified signed terminal root is 11a5171bf5abffdcb4cb08feb311fff5ff2da7d54b65429bb37d1896cf902ba3 and program transfer root is 358fc5da5f924471737532b75054a2974dd1d00a0db450ef8f839157911aff93. Receipt signature, activity binding and both artifact commitments verify before Python rejects transfer authority presence. C call.c transfer_source_validate accepts principal-authorized legs after exact principal, frame and catalog checks; terminal_begin requires the exact applied kernel transfer root. Rust transfer.rs chooses transfer-set-v1 for principal-only transfers without ProgramSpend, and ffi_call.rs:2734-2737 omits their authorization attachment through is_v2. C and Rust agree on that path. Python, TypeScript, Go, JVM, Swift and .NET terminal verifiers instead require an attachment for every nonzero candidate transfer root. The candidate execution-v4 payload contains no transfer legs from which those verifiers can independently reconstruct the missing root. The referenced receipt-programs-executed-v3.json is absent from this checkout. Evidence: /root/lx-lanes/terminal/qual-logs/terminal-contract.log; inspection command python3 qual-logs/inspect-terminal.py exits 1 for the absent fixture after reporting the native verification rejection."
assumption = "Making authority optional would remove the existing transfer-root reconstruction guarantee. Emitting additional authority bytes changes the signed terminal root and needs an explicit historical replay compatibility decision under spec/layerx-platform/spec.kvx req.28 ac_4, plus the shared conformance artifact. No C/runtime disagreement is asserted; the unresolved contradiction is between their existing evidence grammar and the SDK requirement. Runtime, SDK checks, signatures, transfer roots and fixtures remain unchanged. Required aggregate gates were not run; programs/abi-frozen.sha256 is byte-identical to HEAD."
severity = "blocker"
