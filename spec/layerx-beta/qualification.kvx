[observation.6.10.11]
task = "6.10"
file = "agent/crates/layerx-agentd/src/approval/expiry.rs agent/crates/layerx-agentd/src/approval/mod.rs agent/crates/layerx-agentd/src/policy/approval.rs agent/crates/layerx-agentd/tests/approval_ordering/mod.rs agent/crates/layerx-agentd/tests/approval_semantics.rs"
symbol = "ApprovalExpiry::decide ApprovalService::approve PreparedDecision::replace_hold"
observed = "Source inspection identifies a grant preparation that releases the store mutex without persisting the decision, followed by a registry claim and unconditional decision write. A rejection can persist during that interval, producing AlreadyDecided instead of Conflict or allowing the prepared grant to overwrite a durable rejection. The service now holds a decision lock across preparation, claim and persistence; reads that expire holds and explicit recovery use the same lock. Prepared decisions carry the exact expected pending bytes, checked under the store mutex before either the local write or the existing atomic hold-to-released replacement. The original concurrent approval semantics test remains unchanged. New real-store tests use barriers at grant preparation and rejection entry and verify restart recovery, and separately refuse a stale prepared grant after a durable rejection. rustfmt exits 0 (qual-logs/r22/rustfmt.log, rustfmt-repair.log and rustfmt-final.log). Strict SDK and agentd all-target Clippy exits 0 (qual-logs/r22/clippy-qualified.log); its earlier task-scoped closure and function-length errors are repaired without changing lint configuration. SDK tests exit 0 (qual-logs/r22/sdk-test.log). Both new regressions pass (qual-logs/r22/approval-ordering.log, exit 0). Agentd all-targets exits 0 (qual-logs/r22/agentd-test.log), and approval_semantics exits 0 in five further runs (qual-logs/r22/approval-semantics-1.log through approval-semantics-5.log). The boundary qualification gate exits 0 (qual-logs/r22/boundary-gate.log). Its final three lines report ten targets, 256 runs per target, and the allowlist check passing; the gate reports address passed and thread unsupported-pinned-stdlib. make check exits 0 before and after rebase (qual-logs/r22/check.log and check-final.log)."
assumption = "The service uses the daemon's sole ApprovalExpiry owner. The durable registry retains its atomic released-submission and decision transaction; no persistence fallback or assertion relaxation is introduced."
severity = "note"

