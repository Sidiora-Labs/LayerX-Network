symbol = "authenticate_cumulative_use with_authenticated_cumulative_use cumulative_evidence execute_payment wait"
observed = "The policy boundary accepts cumulative use only as an opaque value issued after exact activity decoding, activity-id binding, sequencer receipt authentication, signed batch inclusion, complete activity-leaf occupancy, consecutive batch numbering, state-root chaining and exact global-sequence coverage. Duplicate, forged, mismatched, incomplete and overflowed windows are refused. Grant issue and draw MCP routes use Submit with distinct scopes; activity.wait remains Wait-only. Wallet receipts retain the exact signed activity and verified inclusion material for this ingress. Asset registration, receive, payer grant, mint, burn and every Programs transfer leg disclose their monetary caps, amounts and parties. Full layerx-agentd, layerx-crypto, layerx-sdk and layerx-mcp tests exit 0; the funded path additionally proves the incomplete-window refusal before its positive MCP executions. Evidence: qual-logs/pay2/final/test-agentd.log, test-crypto-sdk-mcp.log and qual-logs/pay2/funded/run-final.log."
assumption = "Cumulative evidence counts only successful activities signed by the requested actor within the authenticated window. It does not disclose caller-supplied totals to policy and does not treat executed-only receipts or acknowledgements as batch evidence."
severity = "note"

