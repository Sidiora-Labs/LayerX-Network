do_2 = "Prefer expressing a restriction as a protocol capability grant, session key scope, budget or payer grant wherever the protocol offers an equivalent, and record the protocol object identifier when it does."
do_3 = "Expose the report through the contract, the command line and the audit trail with the same content."
