[task.9.2]
title = "Bind agents to DIDs verified against the core"
status = "done"
wave = 8
requires = ["9.1","7.4"]
do_1 = "Implement agent registration that resolves the DID against current protocol state through the boundary and refuses registration for an unknown or frozen identity."
do_2 = "Record the identity binding with the head sequence it was verified at, and re-verify it before first use after a restart rather than trusting the stored copy."
do_3 = "Reject a registration that supplies identity facts as configuration instead of verifying them, and prove the absence of such a path in test."
