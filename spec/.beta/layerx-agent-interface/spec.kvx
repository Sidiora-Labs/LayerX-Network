status = "done"
wave = 9
requires = ["13.4"]
do_1 = "Record every submission in a durable outbox before transmission and retain it until a terminal state of executed, failed, expired or superseded."
do_2 = "Implement the state machine over prepared, signed, queued, submitted, acknowledged, unknown, executed, failed and expired, recording every transition with its cause."
do_3 = "Expose the current state and its evidence through the contract, with unknown reported as unknown rather than as an error."
