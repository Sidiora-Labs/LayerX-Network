[task.9.3]
title = "Implement the session lifecycle and token binding"
status = "done"
wave = 8
requires = ["9.2"]
do_1 = "Implement session open recording agent DID, tenant, presented authority, permitted activity types, expiry, opening client and policy version, refusing an open that omits any of them."
do_2 = "Issue session tokens bound to tenant, agent, scope and expiry, and treat a token strictly as a daemon authenticator that is never protocol authority."
do_3 = "Verify at open time that the presented protocol authority exists, is currently valid and is unrevoked, and refuse otherwise."
do_4 = "Support many concurrent sessions per agent and many agents per tenant with independent state, and prove closing one leaves others untouched."
do_5 = "Add tests covering an expired token, a token from another tenant, a token whose scope omits the operation and a session whose authority was never registered in protocol state."
