[task.14.5]
title = "Augment records with checkpoint proofs as finality advances"
status = "done"
wave = 9
requires = ["14.4","5.4"]
do_1 = "Follow checkpoint progress and augment stored submission records with the activity inclusion proof, the state inclusion proof, the checkpoint identifier, the guarantor certificate and the settlement reference."
do_2 = "Verify each augmentation before recording it and never alter a pre-checkpoint receipt field."
do_3 = "Raise the recorded verification level only to the level the verified evidence supports."
do_4 = "Allow a caller to wait for a declared level with an explicit deadline and return the level actually reached when the deadline elapses."
do_5 = "Add tests covering a checkpoint that never finalises, a certificate that arrives sub-threshold and a settlement reference that does not match."
