do_2 = "Implement state inclusion verification against a named resulting_state_root and verify that root against the batch header that claims it."
do_3 = "Verify the batch header signature against the sequencer identity authorised for that batch number, refusing a header signed by an unauthorised identity."
do_4 = "Raise the achieved level to batch-included and state-proven only when the corresponding check actually passed, never as a default."
