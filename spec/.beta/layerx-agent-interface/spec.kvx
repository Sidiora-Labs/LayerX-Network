requires = ["2.5"]
do_1 = "Implement the canonical encoding of unsigned integers, byte strings, tagged unions, ordered maps and sequences exactly as the protocol codec defines them, with one legal encoding per logical value."
do_2 = "Implement the decoder to reject non-minimal integers, indefinite-length items, duplicate map keys, out-of-order map keys, padding and trailing bytes, returning the protocol result-code domain for each rejection class."
do_3 = "Enforce declared length limits during decode before allocating, and bound total allocation per decode so a hostile message cannot exhaust memory."
do_4 = "Guarantee that decoding then re-encoding reproduces the original bytes exactly, and prove it as a property test over generated values as well as over the corpora."
