# spec.kvx - LayerX Agent Interface. SINGLE SOURCE OF TRUTH for this feature.
#
# requirements.md / design.md / tasks.md next to this file are GENERATED from it
# by spec/specgen. Never hand-edit those; edit this file and regenerate.
#
# Drive the work with:  cg spec next -> cg spec start <id> -> cg spec done <id>
# Provenance for every statement here: docs/00-source-brief.md
# Upstream normative source: spec/layerx-protocol/spec.kvx (the protocol wins).

[meta]
feature      = "layerx-agent-interface"
title        = "LayerX Agent Interface - The Rust Interaction Layer"
kind         = "interaction-layer-specification"
version      = "1.0.0"
status       = "draft"
language     = "Rust"
repo_root    = "agent/"
upstream     = "spec/layerx-protocol (C17 core; normative for all protocol behaviour)"
intro        = "The LayerX Agent Interface is the Rust interaction layer through which autonomous agents reach the LayerX protocol. It provides agent identity, sessions, capabilities, budgets and policy enforcement; activity preparation, local signing, submission and receipt tracking; verified balances, history, checkpoints, proofs and data-availability retrieval; streaming events and durable subscriptions; MCP servers exposing scoped read and write tools; a Rust SDK plus generated TypeScript and Python SDKs; and rate limits, idempotency, audit trails, observability and tenant isolation. One rule governs the entire layer: it never invents or directly changes protocol state. Every mutation becomes canonical signed LayerX bytes submitted to the core, and every claimed result is backed by a core-produced receipt or proof that this layer verified for itself. layerx-agentd reaches the core only through a stable, versioned protocol boundary - never by opening the node database and never by binding internal C structures - so that the two sides upgrade independently and the agent layer never becomes a second consensus implementation. These requirements are normative; the design and the task plan beside them are compiled from this file."

# Decisions locked before implementation begins. These supersede any ambiguity
# in docs/00-source-brief.md. Where they touch protocol behaviour they defer to
# spec/layerx-protocol/spec.kvx, which is normative for the protocol itself.
[decision]
language            = "Rust 2021 for the entire interaction layer, in its own workspace at agent/. The protocol runtime stays C17. No Rust translation unit links into the consensus runtime, and no crate in agent/ is a build dependency of src/."
placement           = "The agent workspace lives in this repository at agent/ so spec, core and interaction layer share one Codify graph, but it builds, tests, versions and releases independently of the C core."
non_authority       = "The interaction layer holds no protocol authority. It can refuse, prepare, sign with an explicitly provisioned protocol session key, submit, verify and report. It can never author an effect, never write state, and never assert an outcome the core did not produce."
boundary            = "layerx-agentd speaks to the core only over the LayerX Node Interface (LNI): a versioned, canonical-binary request, response and streaming protocol carrying canonical LayerX bytes plus the proofs required to verify them. Unix domain socket is the default transport; TCP with mutual TLS is permitted for remote deployment."
boundary_prohibits  = "No crate in agent/ may open the node SQLite projection, link a SQLite driver, read the append-only log files directly, or bind any struct layout declared in include/layerx/. An optional stable C ABI transport is permitted only with opaque handles and canonical byte buffers, never with shared struct layouts."
no_second_consensus = "The agent layer decodes, verifies, re-hashes and compares. It never executes a state transition, never applies a transfer, never derives a state root from activities and never predicts admission as though it were a decision. Where it must estimate, the estimate is labelled a projection and carries no receipt."
policy_is_negative  = "Local policy, capability scopes and budget mirrors are restrictions only. They can refuse an activity that the protocol would have accepted; they can never authorise one the protocol would reject, and their approval is never evidence of authority."
signing             = "Signing is local to the key holder. agentd does not hold agent primary keys. It signs only under a protocol-level session key an operator explicitly provisioned to it, whose scope and expiry the state machine enforces independently of anything agentd believes."
unknown_is_terminal = "A submission whose fate cannot be determined is reported as unknown, never as success and never as failure, and is resolved only by looking up the receipt for its idempotency key."
sdk_generation      = "The Rust SDK is authored; the TypeScript and Python SDKs are generated from the same contract schema by the same generator. Hand-editing generated output is a build failure."
mcp_scope           = "MCP servers expose the agent-api contract as tools under an explicit scope. Read tools return verified core bytes; write tools prepare and submit canonical activities and return receipts. No MCP tool returns a claimed outcome that is not backed by a receipt or proof."

[design]
include = "design.body.md"

[tasks]
heading          = "Implementation Plan: LayerX Agent Interface"
overview_include = "tasks.overview.md"
notes_include    = "tasks.notes.md"

# --------------------------------------------------------------------------
# REQUIREMENTS
# --------------------------------------------------------------------------

[req.1]
title = "Non-Authority of the Interaction Layer"
story = "As an autonomous agent operator, I want the Rust interaction layer to be structurally incapable of inventing protocol state or asserting an unbacked result, so that every effect my agents cause is a protocol effect and every number they act on is evidence rather than an opinion held by middleware."
ac_1 = "WHEN any component of the interaction layer effects a change of protocol state THE layer SHALL do so exclusively by constructing a canonical LayerX activity, obtaining a signature over its canonical bytes from a key the LayerX state machine binds to the acting identity, and submitting those exact bytes to the core over the node interface, and SHALL possess no other path by which protocol state can change."
ac_2 = "THE layer SHALL NOT write, cache as authoritative, patch, reconcile or otherwise mutate any protocol state store, SHALL NOT open the node append-only log or SQLite projection for reading or writing, and SHALL treat every protocol value it holds as a copy of core-produced bytes whose provenance and verification status travel with it."
ac_3 = "WHEN the layer reports a balance, a transfer outcome, an escrow or budget state, a service lifecycle state, a position, a fee charged or any other protocol fact THE layer SHALL return only values decoded from core-produced bytes and SHALL attach a verification status recording exactly which of sequencer signature, activity inclusion proof, state inclusion proof and checkpoint certificate were verified locally for that value."
ac_4 = "IF a value cannot be verified to the level a caller requested THEN THE layer SHALL either return it explicitly marked unverified together with the reason, or refuse the request, and SHALL NOT silently downgrade the verification level or omit the status."
ac_5 = "THE layer SHALL compute no protocol outcome of its own, SHALL NOT apply transfers, evaluate module transitions, derive state roots from activities, or determine admissibility as a decision, and WHERE it estimates a prospective result for user guidance THE layer SHALL label the value a projection, SHALL exclude it from every receipt-shaped structure and SHALL never return it in a field a caller could mistake for an executed outcome."
ac_6 = "IF a submission is acknowledged, times out, fails in transport, or completes with an indeterminate response THEN THE layer SHALL record the terminal state as unknown, SHALL NOT report success and SHALL NOT report failure, and SHALL resolve the state only by retrieving the receipt for that idempotency key from the core."
ac_7 = "IF the core returns a failure result code for an activity THEN THE layer SHALL surface that exact code and its canonical meaning, SHALL NOT reinterpret, soften, retry-until-success or substitute a locally derived explanation for it, and SHALL NOT present a failed activity as pending merely because a retry is scheduled."
ac_8 = "THE layer SHALL NOT hold, mint, escrow, net, aggregate or sweep value on behalf of an agent outside protocol accounts, SHALL NOT maintain any internal ledger of owed or owing amounts that is not a mirror of core-produced receipts, and SHALL make any locally tracked amount reconstructible from receipts alone."
ac_9 = "WHEN the layer is stopped, its databases deleted and its process restarted against the same core THE layer SHALL reconstruct every protocol-derived answer it previously served from the core alone, and SHALL lose only local artefacts such as policy configuration, subscription cursors, audit history and idempotency records that it declares as local."
ac_10 = "WHERE a component would need to be trusted for a protocol fact to be believed THE layer SHALL provide the caller with the underlying core-produced bytes and proofs sufficient to verify that fact independently of the layer, and the qualification suite SHALL demonstrate that verification succeeding against a hostile layer implementation that alters the reported value."

[req.2]
title = "The Stable Node Interface Boundary"
story = "As a protocol operator, I want the agent layer to reach the core only through one versioned protocol boundary, so that the core can be refactored, re-indexed or upgraded without breaking agents, and the agent layer can never quietly grow into a second implementation of consensus."
ac_1 = "THE layer SHALL communicate with the core exclusively through the LayerX Node Interface, a versioned request, response and streaming protocol whose messages are canonically encoded and whose payloads are canonical LayerX bytes plus the proofs required to verify them, and SHALL define no other channel to the core."
ac_2 = "THE layer SHALL NOT link a SQLite driver, open the node database file, read the append-only activity log or its segment files, memory-map node state, or depend on any file layout private to the node, and CI SHALL fail the build when a dependency or symbol reference violating this appears anywhere in the agent workspace."
ac_3 = "THE layer SHALL NOT declare, generate or bind any struct, union or enum layout from include/layerx, SHALL NOT depend on C field order, padding, packing or type widths, and WHERE the optional C ABI transport is used THE layer SHALL exchange only opaque handles and canonical byte buffers through a published stable ABI header that carries its own version."
ac_4 = "WHEN a connection to the core is established THE layer SHALL perform a version handshake exchanging node interface version, protocol_version, network_id, node role, chain head sequence, latest sealed batch number, latest finalised checkpoint and the sequencer public key currently authorised, and SHALL refuse to operate against a network_id or protocol_version it was not configured for."
ac_5 = "IF the core advertises a node interface version whose major component differs from the one the layer was built against THEN THE layer SHALL refuse the connection with an explicit incompatibility error naming both versions, and SHALL NOT attempt best-effort interpretation of its messages."
ac_6 = "WHERE the core advertises a capability the layer does not know, or omits a capability the layer knows, THE layer SHALL continue to operate using the intersection, SHALL report every unavailable capability explicitly through its own status surface, and SHALL fail requests that need a missing capability with an unavailable error rather than emulating the capability locally."
ac_7 = "IF the core is unreachable, is behind, or reports a degraded mode THEN THE layer SHALL continue to serve reads it can still verify while marking their staleness with the head sequence and checkpoint they are relative to, SHALL refuse to acknowledge submissions it cannot deliver, and SHALL NOT invent an admission decision on the core behalf."
ac_8 = "WHEN the layer performs any read whose answer is protocol-visible THE layer SHALL request the accompanying proof material and verify it locally through layerx-proof before returning the value, and SHALL treat a core response that lacks requested proof material as an unverified answer rather than as a verified one."
ac_9 = "THE layer SHALL define the node interface schema as a versioned artefact under source control with golden encoding vectors, SHALL require any change to it to be additive within a major version, and SHALL run a boundary conformance suite against a real running node rather than against any simulated or in-process substitute."
ac_10 = "IF the boundary does not yet expose a capability this specification requires THEN THE layer SHALL report that gap explicitly in its capability report and SHALL fail the dependent request as unavailable, and SHALL NOT satisfy it by reading node internals, by reconstructing the answer from partial data, or by returning a plausible substitute."

[req.3]
title = "layerx-types: Canonical Domain Types"
story = "As an SDK author, I want one Rust type vocabulary that mirrors the protocol structures exactly and refuses to represent anything the protocol cannot express, so that an invalid activity is unconstructible rather than merely rejected later."
ac_1 = "THE crate layerx-types SHALL define the LayerX domain vocabulary, including the activity envelope with its exact twelve fields, module payload types, the activity receipt, the 402LXP receipt, batch headers, checkpoint certificates, account identifiers, asset identifiers, result codes and verification status, and SHALL derive each definition from spec/layerx-protocol rather than restating it independently."
ac_2 = "THE crate SHALL represent every consensus-critical numeric value as an exact fixed-width integer type, SHALL provide the 128-bit and 256-bit widths the protocol requires, and SHALL make it impossible to construct a protocol value from a floating-point number anywhere in the public API."
ac_3 = "THE crate SHALL represent account identifiers only through the protocol namespaces agent main, agent budget, agent escrow, agent margin, system liquidity, system insurance, system fees, system paxeer reserve and system paxeer withdrawals, and SHALL reject construction of any identifier outside that namespace at the type boundary."
ac_4 = "THE crate SHALL define result codes as an exhaustive typed taxonomy partitioned by the same domains the protocol defines, SHALL preserve the exact numeric code across the boundary, and SHALL provide a total mapping from numeric code to a typed variant that preserves unknown codes verbatim instead of collapsing them into a generic error."
ac_5 = "WHEN a domain type carries a length-bounded element THE crate SHALL enforce the protocol declared maximum at construction, SHALL reject an over-long value with a typed error rather than truncating it, and SHALL make the bound a compile-time or constructor-time property rather than a runtime convention."
ac_6 = "THE crate SHALL make every protocol-derived value carry its provenance, so that a value obtained from a verified receipt, a value obtained from an unverified read and a value produced by a local projection are distinguishable by type or by an inseparable status field."
ac_7 = "THE crate SHALL contain no input or output, no clock read, no network access and no global mutable state, and SHALL depend on no crate that performs any of those, so that types can be used inside signing devices and constrained hosts."
ac_8 = "WHEN the protocol adds a module, an activity type or a result code THE crate SHALL accommodate it by extension without changing the meaning of existing variants, and SHALL record the protocol version each definition was derived from."
ac_9 = "THE crate SHALL provide conversions to and from the canonical wire representation only through layerx-wire, SHALL expose no ad-hoc serialisation of consensus-critical structures such as a derived JSON or debug format used for hashing or signing, and SHALL mark any human-readable rendering as non-canonical."
ac_10 = "THE crate SHALL be validated against the protocol conformance vectors so that every type it defines round-trips the published vectors exactly, and a vector the crate cannot represent SHALL be a build-breaking failure rather than a skipped test."

[req.4]
title = "layerx-wire: Byte-Exact Canonical Codec"
story = "As an agent operator, I want the Rust encoder to produce exactly the bytes the C core would produce and the Rust decoder to reject exactly what the core rejects, so that a signature made on this side is valid on that side and no representation gap exists between the two implementations."
ac_1 = "THE crate layerx-wire SHALL implement the canonical binary encoding of every protocol structure such that encoding a value produces bytes byte-identical to those the C reference implementation produces for the same logical value, and SHALL be validated against the published conformance corpora on every build."
ac_2 = "WHEN layerx-wire decodes bytes it SHALL reject every non-canonical form the protocol rejects, including non-minimal integer encodings, indefinite-length items, duplicate map keys, out-of-order map keys, unused padding and trailing bytes, and SHALL return the same result-code domain the core returns for each rejection class."
ac_3 = "WHEN a value decodes successfully THE crate SHALL guarantee that re-encoding it reproduces the original bytes exactly, and the round-trip property SHALL be enforced by both the conformance corpora and a property test over generated values."
ac_4 = "THE crate SHALL compute activity_id, payload_hash and every other identifier as the domain-separated hash of canonical bytes using the same domain tags as the core, and SHALL be proven equal to the core output for every identifier in the conformance corpora."
ac_5 = "THE crate SHALL enforce every declared length limit during decoding, SHALL reject an over-long element before allocating memory to hold it, and SHALL bound total allocation per decode so that a hostile message cannot exhaust memory."
ac_6 = "THE crate SHALL contain no panicking path reachable from decoding arbitrary bytes, SHALL return typed errors instead, and SHALL be fuzzed continuously with corpora seeded from the protocol conformance vectors, with any panic, hang, or unbounded allocation treated as a build-breaking defect."
ac_7 = "IF the crate encounters an unknown protocol version, an unknown activity type or an unknown field identifier in a consensus-critical structure THEN THE crate SHALL reject the input deterministically rather than skipping or best-effort interpreting the unrecognised content."
ac_8 = "THE crate SHALL provide the exact byte string that a signature covers for every signable structure, SHALL expose it as the only input a signer is given, and SHALL guarantee that the bytes submitted to the core are byte-identical to the bytes that were signed."
ac_9 = "THE crate SHALL treat any JSON, text or debug rendering as non-canonical and SHALL forbid its use as a hashing, signing or comparison input, and CI SHALL fail if a consensus-critical hash is computed over anything other than canonical bytes."
ac_10 = "WHEN the differential harness runs THE crate SHALL be compared against the C implementation over both the published vectors and randomly generated structures, and any divergence in produced bytes, computed digests or rejection classification SHALL fail the build."

[req.5]
title = "layerx-crypto: Keys, Signing and Custody"
story = "As an agent operator, I want signing to happen where the key lives, under an explicit disclosure of what is being signed, so that neither the daemon nor a compromised tool can obtain signing power it was not deliberately given."
ac_1 = "THE crate layerx-crypto SHALL implement Ed25519 signing and verification for agent identity over domain-separated canonical bytes, SHALL implement secp256k1 verification for Paxeer-facing certificates, and SHALL reject non-canonical or malleable signature encodings exactly as the core does."
ac_2 = "THE crate SHALL define a signer abstraction with at least a local in-process signer, an operating-system keystore signer and a remote signer that never exports private key material, and SHALL make the signing interface identical across them so that key location is a deployment choice rather than a code change."
ac_3 = "WHEN a signer is asked to sign THE crate SHALL provide the exact canonical byte string together with a structured disclosure of what those bytes mean, including activity type, actor, authority, amounts, counterparties, fee limit, expiry and idempotency key, and SHALL make signing opaque bytes without a disclosure impossible through the public API."
ac_4 = "IF the structured disclosure does not decode back to byte-identical canonical bytes THEN THE crate SHALL refuse to sign, because a disclosure that does not match the bytes is a lie about what is being authorised."
ac_5 = "THE crate SHALL hold private key material only in memory that is zeroized on drop, SHALL exclude key material from every debug rendering, log, metric, trace, error message and panic payload, and SHALL fail a build-time check if a key type implements an unredacted debug format."
ac_6 = "WHEN keys are stored at rest THE crate SHALL encrypt them under an operator-supplied secret with an authenticated cipher and a memory-hard key derivation, SHALL bind the ciphertext to the identity and network it belongs to, and SHALL refuse to load a keystore whose authenticated data does not match the expected identity or network."
ac_7 = "WHEN a session key is issued for delegated use THE crate SHALL require an explicit expiry, an explicit permitted activity type set and an explicit revocation sequence to accompany it, SHALL refuse to issue an unbounded session key, and SHALL make the resulting authority exactly the protocol session-key authority rather than a layer-local notion."
ac_8 = "THE crate SHALL enforce domain separation for every signature purpose, SHALL make it impossible to reuse a signature produced for one purpose or network in another, and SHALL bind every signature preimage to network_id and protocol_version."
ac_9 = "THE crate SHALL provide constant-time comparison for secrets and digests and SHALL avoid secret-dependent branching and secret-dependent memory access in its own code paths."
ac_10 = "WHEN a remote signer is used THE crate SHALL treat a refusal, a timeout or an unreachable signer as a refusal to sign, SHALL never fall back to a lower-assurance key, and SHALL surface the failure without producing any partially signed artefact."

[req.6]
title = "layerx-proof: Independent Verification"
story = "As an agent operator, I want every proof the protocol offers to be checkable by my own process, so that trust in a receipt derives from arithmetic I performed rather than from the reputation of whoever handed it to me."
ac_1 = "THE crate layerx-proof SHALL verify a signed receipt from its bytes alone by recomputing its canonical encoding, checking the sequencer signature against the sequencer key authorised for that batch, and confirming internal consistency of amounts, before and after balances and chained state roots."
ac_2 = "THE crate SHALL verify an activity inclusion proof by recomputing activity_merkle_root from the leaf and the proof path under the protocol domain tags, and SHALL reject any proof that relies on reinterpreting an internal node as a leaf or that carries a path length inconsistent with the committed tree."
ac_3 = "THE crate SHALL verify a state inclusion proof against a named resulting_state_root, SHALL verify that root against the batch header it claims, and SHALL verify the batch header signature against the authorised sequencer identity for that batch number."
ac_4 = "THE crate SHALL verify a checkpoint certificate by checking that at least the configured guarantor threshold of distinct bonded guarantor signatures verify over the checkpoint identifier, SHALL reject duplicate signers counted twice, and SHALL report the achieved count and threshold rather than a bare boolean."
ac_5 = "WHEN data availability bytes are retrieved THE crate SHALL verify them by re-hashing the served bytes and comparing against the committed data_availability_root and the corresponding chunk inclusion proof, and SHALL classify a mismatch as an availability failure with the mismatching commitment and the served bytes retained as evidence."
ac_6 = "THE crate SHALL express the outcome of verification as an explicit level, distinguishing at minimum unverified, sequencer-signed, batch-included, state-proven, checkpoint-finalised and settlement-anchored, and SHALL never collapse those levels into a single verified flag."
ac_7 = "THE crate SHALL perform verification without contacting the network, without reading a clock for any verification decision, and without requiring any index or database, so that verification succeeds from bytes on disk in an air-gapped environment."
ac_8 = "IF any verification input is missing, malformed or internally inconsistent THEN THE crate SHALL return a typed verification failure naming the exact check that failed, and SHALL NOT return a partial success or a downgraded level as though the check had been performed."
ac_9 = "THE crate SHALL be tested against negative corpora containing altered amounts, altered recipients, re-signed receipts, truncated proof paths, sub-threshold certificates, duplicated guarantor signatures, swapped leaf and node domains and mismatched roots, and SHALL reject every one of them."
ac_10 = "THE crate SHALL expose verification as a public API usable independently of the rest of the layer, so that a counterparty holding only receipt bytes and the published keys can confirm a payment without running agentd, the SDKs or any LayerX node."

[req.7]
title = "layerx-client: Boundary Client"
story = "As an SDK author, I want one Rust client that speaks the node interface, submits activities, tracks receipts and returns only verified reads, so that every higher layer inherits the same guarantees instead of reimplementing them."
ac_1 = "THE crate layerx-client SHALL implement the node interface for submission, receipt retrieval, verified reads, proof retrieval, data-availability retrieval and event streaming, and SHALL be the only crate in the workspace that opens a connection to the core."
ac_2 = "WHEN the client submits an activity THE client SHALL send exactly the signed canonical bytes it was given, SHALL NOT re-encode, normalise, reorder or augment them, and SHALL fail rather than transmit bytes that differ in any way from the bytes covered by the signature."
ac_3 = "WHEN a submission is acknowledged THE client SHALL treat the acknowledgement as admission evidence only, SHALL NOT treat it as execution, and SHALL consider the activity resolved only when a core-produced receipt for it has been retrieved and verified."
ac_4 = "WHEN a submission is retried THE client SHALL resend byte-identical bytes under the same idempotency key, SHALL treat the return of an existing receipt as the correct outcome of the retry, and SHALL NOT construct a new activity, a new idempotency key or a new sequence for a retry of the same intent."
ac_5 = "IF a submission attempt ends without a determinate outcome THEN THE client SHALL classify it as unknown, SHALL resolve it by receipt lookup under the idempotency key, and SHALL apply bounded jittered backoff to that resolution rather than resubmitting indefinitely."
ac_6 = "WHEN the client performs a read THE client SHALL request the proof material appropriate to the caller requested verification level, SHALL verify it through layerx-proof before returning, and SHALL return the achieved level with every value."
ac_7 = "WHEN the client streams events THE client SHALL deliver them in strict global_sequence order, SHALL detect and report any gap in sequence rather than closing it silently, and SHALL expose a resumable cursor that survives disconnection and process restart."
ac_8 = "THE client SHALL apply explicit deadlines, connection limits and message size limits to every boundary call, SHALL surface backpressure to the caller instead of buffering without bound, and SHALL never let a slow read starve submission delivery."
ac_9 = "THE client SHALL treat every transport-level error class distinctly, separating connection failure, deadline exceeded, protocol incompatibility, unavailable capability, core-side rejection and verification failure, and SHALL never map a verification failure onto a transport error or the reverse."
ac_10 = "THE client SHALL be usable directly by an embedding application with no daemon present, so that the guarantees of this layer do not depend on running agentd."

[req.8]
title = "Agent Identity and Sessions"
story = "As an agent operator, I want the daemon to model agents and sessions explicitly and bind them to protocol identities and session keys, so that authority is always traceable to a DID and a key the state machine can revoke."
ac_1 = "WHEN an agent is registered with the daemon THE daemon SHALL bind it to exactly one LayerX DID that exists in current protocol state, SHALL verify that binding against the core rather than accepting it as configuration, and SHALL refuse registration for an unknown or frozen identity."
ac_2 = "WHEN a session is opened THE daemon SHALL record the agent DID, the tenant, the authority the session may present, the permitted activity types, the expiry, the client that opened it and the policy version in force, and SHALL refuse to open a session that omits any of those."
ac_3 = "THE daemon SHALL derive session authority exclusively from a protocol session key or capability grant already registered in protocol state, SHALL verify that the presented authority is currently valid and unrevoked at open time, and SHALL NOT invent an authority record that has no protocol counterpart."
ac_4 = "WHILE a session is open THE daemon SHALL re-evaluate the underlying protocol authority before every write it prepares, and SHALL refuse to prepare or submit under an authority that has expired, been rotated out, been revoked, or fallen outside its declared scope since the session opened."
ac_5 = "WHEN a session expires, is closed, or its underlying authority is revoked THE daemon SHALL immediately refuse further use of it, SHALL cancel pending prepared activities bound to it that have not yet been submitted, and SHALL NOT retroactively affect activities the protocol already executed."
ac_6 = "THE daemon SHALL issue session tokens that are bound to the tenant, the agent, the scope and the expiry, SHALL treat a token as an authenticator to the daemon only and never as protocol authority, and SHALL make clear in every response which protocol authority was actually used."
ac_7 = "IF a caller presents a token for an agent in a different tenant, or a token whose scope does not name the requested operation, THEN THE daemon SHALL refuse with an explicit authorisation error and SHALL record the refusal in the audit trail."
ac_8 = "THE daemon SHALL support many concurrent sessions per agent and many agents per tenant, SHALL keep per-session state independent, and SHALL ensure that closing one session never disturbs another session sequence, budget accounting or subscription cursor."
ac_9 = "WHEN a primary key rotation or account recovery is observed in protocol state THE daemon SHALL invalidate every session whose authority no longer verifies, SHALL report the invalidation reason to the affected clients, and SHALL NOT continue to serve writes under a superseded key."
ac_10 = "THE daemon SHALL persist session and identity records durably, SHALL restore them on restart, and SHALL revalidate every restored session against protocol state before honouring it rather than trusting its own stored copy."

[req.9]
title = "Capabilities and Scoped Authority"
story = "As an agent operator, I want to hand a sub-agent or a tool a narrow capability and know the narrowing is real, so that the worst case of a compromised tool is bounded by both the daemon and the protocol."
ac_1 = "THE daemon SHALL express a capability as an explicit set of permitted activity types, permitted counterparties, permitted assets, amount ceilings, rate ceilings, purpose constraints and an expiry, and SHALL reject a capability that leaves any of those dimensions unspecified rather than defaulting it open."
ac_2 = "WHEN a capability is used THE daemon SHALL enforce that the prepared activity falls inside every dimension of the capability, SHALL refuse on the first dimension that is exceeded, and SHALL name the exceeded dimension in the refusal."
ac_3 = "THE daemon SHALL guarantee that a capability can only narrow the underlying protocol authority, SHALL reject at creation time any capability that would permit an activity type, asset, counterparty or amount the underlying protocol authority does not already permit, and SHALL never present a capability as authorisation to the core."
ac_4 = "WHEN a capability is attenuated to derive a narrower capability THE daemon SHALL compute the intersection of every dimension, SHALL forbid a derived capability from exceeding its parent in any dimension, and SHALL record the derivation chain so that any exercised capability is traceable to the root authority."
ac_5 = "WHEN a capability, its parent, or the underlying protocol authority is revoked THE daemon SHALL refuse every subsequent use of the whole subtree, and SHALL apply the revocation to prepared but unsubmitted activities."
ac_6 = "THE daemon SHALL evaluate capability checks deterministically from recorded state and the prepared activity, SHALL NOT consult ambient context such as caller network address, process identity or wall-clock convenience for the decision, and SHALL produce the identical decision for the identical inputs."
ac_7 = "IF a capability names a spending ceiling THEN THE daemon SHALL account consumption against it from verified receipts rather than from submission attempts, SHALL count a failed activity as unconsumed, and SHALL never let concurrent uses of the same capability exceed the ceiling in aggregate."
ac_8 = "WHERE the protocol offers an equivalent enforceable construct, including capability grants, session key scopes, budgets and payer grants, THE daemon SHALL prefer to express the restriction in protocol state so that it is enforced by the state machine, and SHALL record which restrictions are protocol-enforced and which are daemon-enforced only."
ac_9 = "THE daemon SHALL make every capability decision visible in the audit trail with the capability identifier, its derivation chain, the decision, the deciding dimension and the resulting activity identifier when one was produced."
ac_10 = "THE daemon SHALL treat a daemon-enforced-only restriction as advisory in its reporting, SHALL state plainly in the capability report that it binds only while the daemon is in the path, and SHALL NOT describe it as a protocol guarantee."

[req.10]
title = "Budgets and Spend Control"
story = "As an agent operator, I want spending caps that hold even when the daemon is bypassed, restarted or raced, so that a runaway agent cannot spend past the limit I set by exploiting a gap between my controls and the ledger."
ac_1 = "WHEN an operator sets a spending limit THE daemon SHALL offer to express it as a protocol budget or capability grant so that the state machine enforces it, SHALL create that protocol object through an ordinary signed activity, and SHALL report the resulting protocol object identifier."
ac_2 = "WHERE a limit exists only in the daemon THE daemon SHALL label it explicitly as daemon-enforced, SHALL state that bypassing the daemon bypasses the limit, and SHALL NOT report it as equivalent to a protocol budget."
ac_3 = "THE daemon SHALL derive budget consumption exclusively from verified receipts and protocol budget state, SHALL treat its own local accounting as a cache that is reconciled against the core, and SHALL correct itself to the protocol figure whenever the two differ."
ac_4 = "WHEN a prepared activity would exceed a limit THE daemon SHALL refuse to prepare or submit it, SHALL name the limit, the ceiling, the consumed amount and the requested amount in the refusal, and SHALL leave no reservation behind for a refused request."
ac_5 = "WHILE multiple concurrent requests draw on one limit THE daemon SHALL serialise the reservation decision so that concurrent or reordered requests cannot exceed the ceiling in aggregate, and SHALL release a reservation deterministically when the activity reaches a terminal state or the reservation window expires."
ac_6 = "IF the daemon cannot determine the terminal state of an activity that held a reservation THEN THE daemon SHALL keep the reservation held and the amount unavailable until the receipt is resolved, and SHALL NOT release it optimistically."
ac_7 = "WHEN a recurring budget window rolls over THE daemon SHALL take the window boundary and the remaining allowance from protocol state rather than from a local timer, so that its view of the window matches the deterministic protocol view exactly."
ac_8 = "THE daemon SHALL support limits scoped to a tenant, an agent, a session, a capability and a counterparty simultaneously, SHALL apply every applicable limit, and SHALL refuse if any single one is exceeded."
ac_9 = "THE daemon SHALL expose the reconciliation state of every budget, including the last verified receipt applied, the protocol figure, the local figure and any divergence, and SHALL raise an explicit alert rather than silently adopting the local figure when they diverge."
ac_10 = "WHEN the daemon restarts THE daemon SHALL rebuild spend accounting from persisted receipts and protocol state before accepting a write, and SHALL refuse writes against a limit whose accounting has not yet been reconciled."

[req.11]
title = "Policy Enforcement"
story = "As an agent operator, I want a deterministic, explainable policy engine that refuses by default, so that I can reason about what my agents may do and prove afterwards why any particular action was allowed or refused."
ac_1 = "THE daemon SHALL evaluate every write request against a policy set before preparation, SHALL deny by default when no rule permits the request, and SHALL never allow a request merely because no rule denied it."
ac_2 = "THE policy engine SHALL evaluate deterministically from the request, the session, the capability, the reconciled budget state and the loaded policy version alone, SHALL NOT consult wall-clock convenience, random values, load or non-deterministic ordering, and SHALL yield the identical decision for identical inputs."
ac_3 = "WHEN a policy decision is produced THE daemon SHALL record the decision, the policy version, every rule that matched, the deciding rule and the reason, and SHALL make that record retrievable for the lifetime of the audit retention window."
ac_4 = "THE daemon SHALL support a dry-run evaluation that returns the decision and its explanation without preparing, signing or submitting anything, and SHALL guarantee dry-run has no side effect other than an audit entry."
ac_5 = "WHEN a policy set is updated THE daemon SHALL version it, SHALL apply a new version only to requests received after activation, SHALL retain prior versions for audit reconstruction, and SHALL validate a policy set before activation, rejecting one that fails validation while continuing under the previous version."
ac_6 = "IF policy evaluation fails, times out or encounters an internal error THEN THE daemon SHALL deny the request, because a policy engine that fails open is not a control."
ac_7 = "THE policy engine SHALL be able to constrain at least activity type, counterparty, asset, amount, cumulative rate, purpose, capability, session, agent, tenant, time window and required approval, and SHALL express thresholds as exact integers rather than floating-point values."
ac_8 = "WHERE a policy requires human or external approval THE daemon SHALL hold the request in an explicit awaiting-approval state, SHALL expire it deterministically if approval does not arrive within its declared window, and SHALL never auto-approve on expiry."
ac_9 = "THE daemon SHALL make plain in every policy decision that policy is a local restriction, SHALL NOT represent a policy allow as protocol authorisation, and SHALL still submit only activities the protocol independently authorises."
ac_10 = "THE daemon SHALL ship a policy test harness that evaluates a policy set against recorded request corpora and reports the decisions, so that an operator can verify a policy change before activating it."

[req.12]
title = "Activity Preparation and Local Signing"
story = "As an agent operator, I want preparation and signing to be separate steps with a disclosure in between, so that whatever signs can see exactly what it is authorising and the daemon can never obtain a signature for something it did not show."
ac_1 = "WHEN a caller requests preparation THE daemon SHALL construct the complete unsigned canonical activity, including actor, authority, account_sequence, timestamp_bound, idempotency_key, fee_limit, payload and payload_hash, SHALL return its exact canonical bytes, and SHALL return the domain-separated byte string a signature must cover."
ac_2 = "WHEN preparation returns THE daemon SHALL accompany the bytes with a structured disclosure of their meaning, including activity type, actor, authority, every counterparty, every amount, the asset, the fee limit, the expiry and the idempotency key, and SHALL guarantee the disclosure was decoded from the same bytes rather than assembled from the request."
ac_3 = "THE daemon SHALL take account_sequence and every other protocol-derived preparation input from core state, SHALL NOT guess or increment a sequence locally beyond what the core reports, and SHALL fail preparation when the required core state is unavailable rather than assuming a value."
ac_4 = "WHEN an activity is signed THE signing component SHALL sign exactly the bytes preparation produced, and THE daemon SHALL verify before submission that the signature verifies over the exact bytes it is about to send, refusing to submit otherwise."
ac_5 = "IF any field of a prepared activity is altered after signing THEN THE daemon SHALL detect the alteration through signature verification against the exact bytes and SHALL refuse submission, so that a modified activity can never be submitted under an earlier signature."
ac_6 = "THE daemon SHALL support external signing, in which preparation output leaves the daemon, a signature is produced elsewhere and returned, and the daemon submits without ever holding the key, and SHALL treat this as the default posture for agent primary keys."
ac_7 = "WHERE the daemon is provisioned with a protocol session key it MAY sign directly, and in that case THE daemon SHALL confine its signing to the activity types, expiry and scope the protocol session key declares, and SHALL record every self-signed activity distinctly in the audit trail."
ac_8 = "WHEN preparation sets timestamp_bound and fee_limit THE daemon SHALL derive them from explicit caller input or explicit configured defaults, SHALL include them in the disclosure, and SHALL never widen a caller supplied bound."
ac_9 = "THE daemon SHALL expire prepared activities that are not submitted within their declared window, SHALL release any reservation they held, and SHALL refuse to submit a prepared activity whose timestamp_bound has already passed relative to the core reported batch time."
ac_10 = "THE daemon SHALL NOT store signed activity bytes beyond the retention needed to complete submission and receipt resolution, SHALL store no private key material at any point in this flow, and SHALL redact payload contents in logs according to the configured redaction policy while keeping the activity identifier."

[req.13]
title = "Submission, Idempotency and Receipt Tracking"
story = "As an agent operator, I want submission to be exactly-once in effect and honest about uncertainty, so that a network failure costs me a retry rather than a duplicate payment or a false report of success."
ac_1 = "WHEN an activity is submitted THE daemon SHALL record it in a durable outbox before transmission, SHALL transmit the exact signed bytes, and SHALL retain the record until the activity reaches a terminal state of executed, failed, expired or superseded."
ac_2 = "THE daemon SHALL track each submission through an explicit state machine of prepared, signed, queued, submitted, acknowledged, unknown, executed, failed and expired, SHALL record every transition with its cause, and SHALL expose the current state and its evidence to the caller."
ac_3 = "WHEN a submission is retried THE daemon SHALL resend byte-identical bytes carrying the original idempotency_key, SHALL NOT re-prepare or re-sign the activity, and SHALL treat an existing receipt returned by the core as the authoritative outcome of the retry."
ac_4 = "IF the daemon cannot determine whether a submission was executed THEN THE daemon SHALL hold the submission in unknown, SHALL continue resolution attempts under bounded jittered backoff, SHALL keep any associated reservation held, and SHALL report unknown to the caller rather than success or failure."
ac_5 = "WHEN a receipt is obtained THE daemon SHALL verify it through layerx-proof before recording a terminal state, SHALL store the exact receipt bytes, and SHALL make the stored bytes retrievable unchanged by activity identifier, idempotency key and global sequence."
ac_6 = "THE daemon SHALL provide caller-supplied idempotency keys for its own request surface, SHALL return the original result for a repeated request carrying a key already settled, and SHALL reject with a conflict error a repeated key whose request body differs from the original."
ac_7 = "WHEN the daemon restarts THE daemon SHALL recover its outbox, SHALL resume resolution of every non-terminal submission, and SHALL neither resubmit an activity already executed nor drop an activity that was signed and queued but never transmitted."
ac_8 = "WHEN a receipt is later covered by a checkpoint THE daemon SHALL augment its stored record with the activity inclusion proof, the state inclusion proof, the checkpoint identifier, the guarantor certificate and the settlement reference, SHALL verify each before recording it, and SHALL NOT alter any pre-checkpoint field of the receipt."
ac_9 = "THE daemon SHALL expose the verification level of every tracked submission, SHALL allow a caller to wait for a declared level with an explicit deadline, and SHALL return the level actually reached when the deadline elapses rather than an assumed one."
ac_10 = "IF an activity is rejected by the core THEN THE daemon SHALL record the exact result code, SHALL classify it as retriable or terminal from the protocol taxonomy rather than by guesswork, SHALL NOT retry a terminal rejection, and SHALL surface the code unmodified to the caller."

[req.14]
title = "Verified Reads: Balances, History, Checkpoints and Proofs"
story = "As an agent operator, I want every read to arrive with the evidence that makes it true, so that my agents act on protocol facts rather than on a cache the middleware assembled."
ac_1 = "WHEN a balance is requested THE layer SHALL return the value derived from core-produced state together with the account identifier, the asset, the global sequence and the batch or checkpoint the value is relative to, and SHALL return the verification level actually achieved."
ac_2 = "WHERE a caller requests a proven balance THE layer SHALL retrieve and verify a state inclusion proof against the named state root and verify that root through its batch header signature or its checkpoint certificate, and SHALL refuse to answer at that level rather than downgrade silently."
ac_3 = "WHEN history is requested THE layer SHALL return core-produced canonical bytes for activities, receipts and events in strict global_sequence order, SHALL provide stable cursors for pagination, and SHALL guarantee that a resumed page continues exactly where the previous page ended with no gap and no repetition."
ac_4 = "WHEN a caller re-hashes served history bytes THE layer SHALL have preserved them exactly, so that recomputation reproduces the committed activity, receipt, event and oracle roots for the batches covered."
ac_5 = "WHEN a checkpoint is requested THE layer SHALL return the checkpoint certificate, its header commitments, the guarantor signature set with the achieved count and threshold, and the settlement reference where one exists, and SHALL verify the certificate before returning it."
ac_6 = "THE layer SHALL expose the current chain head, the latest sealed batch and the latest finalised checkpoint with every read that is sensitive to freshness, so that staleness is a value the caller can see rather than an assumption."
ac_7 = "WHERE the layer caches a protocol value THE layer SHALL cache the core-produced bytes together with their verification evidence, SHALL revalidate against the core before serving a value past its declared freshness bound, and SHALL never serve a cached value at a verification level higher than the evidence it holds."
ac_8 = "IF the core cannot serve a read THEN THE layer SHALL return an unavailable error naming the missing capability or range, and SHALL NOT reconstruct the answer from partial data, from its own projection, or from a previous unrelated response."
ac_9 = "THE layer SHALL never return a computed aggregate as a protocol fact without labelling it, and WHERE it offers derived views such as totals, spend summaries or position rollups THE layer SHALL identify each contributing receipt so the aggregate is reconstructible and auditable."
ac_10 = "THE layer SHALL provide an export that emits the receipts, proofs, certificates and headers needed for a third party to verify a stated set of facts offline with layerx-proof and no access to the layer."

[req.15]
title = "Data Availability Retrieval"
story = "As an agent operator, I want to fetch the underlying data behind a checkpoint and confirm it hashes to what was committed, so that I can replay history myself instead of trusting that somebody still has it."
ac_1 = "THE layer SHALL retrieve availability data by checkpoint identifier, batch number, global sequence range or activity identifier through the node interface, and SHALL return the canonical bytes as served."
ac_2 = "WHEN availability bytes are retrieved THE layer SHALL verify each chunk against its inclusion proof under the committed data_availability_root and SHALL verify the reassembled bytes re-hash to the committed roots before treating the retrieval as successful."
ac_3 = "IF served bytes do not verify THEN THE layer SHALL classify the retrieval as an availability failure, SHALL retain the served bytes and the mismatching commitment as evidence, SHALL report which check failed, and SHALL NOT return the bytes as valid history."
ac_4 = "THE layer SHALL retrieve the five availability classes the protocol names, being the activity batch, the receipts, the oracle inputs, the state-diff material and the recovery metadata, and SHALL report which classes were obtained and which were missing."
ac_5 = "THE layer SHALL support retrieval from multiple providers, SHALL treat a provider that serves non-verifying bytes as failed for that request, and SHALL never merge bytes from two providers into one unverified result."
ac_6 = "WHEN retrieval is used to support replay THE layer SHALL emit the retrieved history in a form an independent verifier can consume without any index or database, and SHALL document the exact ordering and framing it produces."
ac_7 = "THE layer SHALL bound retrieval by explicit size, chunk-count and deadline limits, SHALL stream large retrievals rather than buffering them whole, and SHALL surface progress and partial completion honestly."
ac_8 = "IF availability data behind an unfinalised checkpoint cannot be obtained THEN THE layer SHALL report the checkpoint as unavailable for verification purposes and SHALL NOT report any fact at checkpoint-finalised level against it."
ac_9 = "THE layer SHALL record every availability failure in the audit trail with the checkpoint, the batch, the chunk index, the provider and the failing check, so that repeated withholding is visible rather than lost in retries."
ac_10 = "THE layer SHALL make retrieval and verification available as a standalone operation, so that an operator can audit availability without submitting any activity or holding any key."

[req.16]
title = "Streaming Events and Durable Subscriptions"
story = "As an agent operator, I want an event stream that is ordered, resumable and honest about gaps, so that my agents can react to protocol effects without polling and without silently missing one."
ac_1 = "THE layer SHALL stream protocol events derived only from core-produced event records, SHALL deliver them in strict global_sequence order, and SHALL NOT synthesize, infer, reorder or enrich an event with a value the core did not produce."
ac_2 = "WHEN a subscription is created THE layer SHALL record it durably with its filter, its start position, its delivery target and its owning tenant, agent and scope, and SHALL restore and resume it after a daemon restart from its last acknowledged cursor."
ac_3 = "WHEN events are delivered THE layer SHALL guarantee at-least-once delivery with a monotonic cursor, SHALL include a deduplication identifier derived from the event identity, and SHALL document plainly that consumers must deduplicate on it."
ac_4 = "IF a gap in global_sequence is detected THEN THE layer SHALL surface it as an explicit gap event naming the missing range, SHALL attempt backfill from the core, and SHALL NOT continue delivering past the gap as though the stream were contiguous."
ac_5 = "WHEN a subscriber is slow or unreachable THE layer SHALL apply bounded buffering and explicit backpressure, SHALL retry with bounded jittered backoff, SHALL mark the subscription as lagging with its lag in sequences, and SHALL never drop an event silently to keep up."
ac_6 = "THE layer SHALL support filtering by agent, account, activity type, module, asset, counterparty and result class, SHALL evaluate filters deterministically, and SHALL apply tenant and scope restrictions before any filter so that a filter can never widen visibility."
ac_7 = "WHEN a subscription is created from a historical position THE layer SHALL backfill from durable history and transition to live delivery without a gap or a duplicate at the seam, and SHALL make the transition point observable."
ac_8 = "WHERE events are delivered to an external endpoint THE layer SHALL authenticate the delivery, SHALL sign or otherwise bind the payload so a receiver can confirm origin, SHALL include the underlying receipt or event bytes needed for verification, and SHALL retry failures without duplicating side effects on the receiving side beyond at-least-once semantics."
ac_9 = "THE layer SHALL expose subscription health including cursor position, lag, last delivery, failure count and last error, and SHALL retain undelivered events only within a declared, enforced retention bound after which the subscription is marked truncated rather than silently repaired."
ac_10 = "WHEN a subscription is deleted or its owning session, capability or tenant is revoked THE layer SHALL stop delivery immediately, SHALL retain its audit record, and SHALL NOT deliver buffered events after revocation."

[req.17]
title = "MCP Servers and Scoped Tools"
story = "As an agent operator, I want model-facing tools that are scoped, auditable and incapable of asserting an unbacked result, so that connecting an LLM to my funds is bounded by the same controls as any other client."
ac_1 = "THE crate layerx-mcp SHALL expose the agent-api contract as MCP tools, SHALL separate read tools from write tools explicitly, and SHALL declare for every tool the scope it requires, the mutations it can cause and the evidence it returns."
ac_2 = "WHEN an MCP server starts THE server SHALL bind to exactly one tenant and one scope set, SHALL derive its authority from a session and capability created through the normal daemon path, and SHALL expose no tool outside that scope."
ac_3 = "WHEN a read tool returns THE tool SHALL return only core-produced values with their verification level attached, and SHALL NOT return a summary, an estimate or an inference presented as a protocol fact."
ac_4 = "WHEN a write tool is invoked THE tool SHALL follow the prepare, disclose, sign, submit and track path exactly as any other client, SHALL return the receipt or the honest non-terminal state, and SHALL NOT report success before a verified receipt exists."
ac_5 = "WHERE a write tool would exceed a configured threshold THE server SHALL require explicit approval before submission, SHALL present the disclosure to the approver, and SHALL expire an unapproved request deterministically rather than proceeding."
ac_6 = "THE server SHALL treat all tool arguments and all model-supplied text as untrusted input, SHALL validate them against the contract schema before use, and SHALL NOT allow instructions embedded in data, resource content or tool results to widen scope, alter a capability, change an approval requirement or redirect a counterparty."
ac_7 = "THE server SHALL apply the same policy, capability, budget, rate limit and audit path as every other client, SHALL be incapable of bypassing them, and SHALL record every tool invocation with its arguments digest, decision and outcome."
ac_8 = "IF a tool cannot complete THEN THE tool SHALL return a typed error naming the failing stage and the protocol result code where one exists, and SHALL NOT return prose that a model could mistake for a completed action."
ac_9 = "THE server SHALL bound tool result size, SHALL paginate large results with stable cursors, and SHALL never truncate a result silently in a way that could read as completeness."
ac_10 = "THE server SHALL support read-only deployment in which every write tool is absent rather than merely refused, so that a read-only integration cannot be talked into a mutation."

[req.18]
title = "Rust SDK and Generated TypeScript and Python SDKs"
story = "As an application developer, I want three SDKs that behave identically because they are generated from one contract, so that a guarantee I rely on in Rust is not quietly missing in TypeScript or Python."
ac_1 = "THE workspace SHALL define the agent-api contract as a single versioned schema artefact from which the Rust SDK types, the TypeScript SDK and the Python SDK are all derived, and SHALL treat that schema as the source of truth for the client surface."
ac_2 = "THE Rust SDK SHALL expose identity and session management, capability and budget management, policy dry-run, activity preparation, signing integration, submission and tracking, verified reads, proof verification, availability retrieval and subscriptions, and SHALL be usable with or without a running daemon."
ac_3 = "THE TypeScript and Python SDKs SHALL be generated from the schema by a generator in this workspace, SHALL be regenerated and diffed in CI, and a hand-edit to generated output SHALL fail the build."
ac_4 = "THE generated SDKs SHALL preserve the guarantees of this layer, including verification levels on every read, honest unknown submission state, idempotency key handling, typed protocol result codes and refusal to present unverified values as results."
ac_5 = "WHEN a generated SDK represents an amount or any consensus-critical integer THE SDK SHALL use an exact integer representation in that language, SHALL NOT use a floating-point number for it, and SHALL fail rather than lose precision at the language boundary."
ac_6 = "THE workspace SHALL run a cross-SDK parity suite that exercises the identical scenarios through the Rust, TypeScript and Python SDKs against the same daemon and asserts identical observable behaviour, including identical error taxonomy and identical verification levels."
ac_7 = "WHEN the contract schema changes THE workspace SHALL enforce compatibility rules, SHALL permit only additive changes within a major version, SHALL fail CI on a breaking change that does not carry a major version increment, and SHALL publish a compatibility matrix of SDK version against contract version against node interface version."
ac_8 = "THE SDKs SHALL NOT embed private key handling that exports key material, SHALL integrate with external signers through an explicit interface, and SHALL make the default posture one in which the SDK never holds an agent primary key."
ac_9 = "THE SDKs SHALL ship runnable examples covering payment with receipt verification, an HTTP 402 style settlement, budget-constrained delegated spending, a service lifecycle interaction and offline verification of a receipt by a counterparty."
ac_10 = "THE SDKs SHALL document precisely which guarantees are protocol-enforced and which are daemon-enforced, and SHALL NOT describe a daemon-enforced restriction as a protocol guarantee anywhere in generated documentation."

[req.19]
title = "Rate Limits, Quotas and Backpressure"
story = "As a platform operator, I want limits that protect the node and separate tenants from each other, so that one agent cannot degrade the service for everyone or push load into the core that the core did not ask for."
ac_1 = "THE daemon SHALL apply configurable rate limits per tenant, per agent, per session, per capability and per operation class, SHALL apply every applicable limit, and SHALL refuse when any one is exceeded."
ac_2 = "WHEN a limit is exceeded THE daemon SHALL return a typed rate-limit error carrying the limit, the window, the remaining quota and a retry-after hint, and SHALL NOT queue the request indefinitely in place of refusing it."
ac_3 = "THE daemon SHALL enforce limits deterministically from recorded counters and the request, SHALL make the decision independent of instance-local timing artefacts where the deployment is multi-instance, and SHALL document the consistency model of its counters plainly."
ac_4 = "THE daemon SHALL apply admission control to outbound boundary traffic so that retries, backfills and subscription catch-up cannot saturate the node interface, and SHALL prioritise submission delivery and receipt resolution over bulk reads under contention."
ac_5 = "WHEN the core signals backpressure or unavailability THE daemon SHALL propagate it to callers as backpressure rather than absorbing it into unbounded internal queues, and SHALL bound every internal queue with an explicit capacity and a defined overflow behaviour."
ac_6 = "THE daemon SHALL bound every request by an explicit deadline, SHALL cancel downstream work when a caller disconnects, and SHALL never leave an orphaned submission whose fate nobody is resolving."
ac_7 = "THE daemon SHALL apply quotas to durable resources including subscriptions, prepared activities, outbox entries, audit retention and stored receipts, and SHALL refuse creation past a quota rather than degrading an existing tenant."
ac_8 = "IF a retry storm, a hot loop or a pathological client is detected THEN THE daemon SHALL shed load for that client specifically, SHALL record the shedding decision, and SHALL NOT shed load for unrelated tenants to compensate."
ac_9 = "THE daemon SHALL never let a rate limit, a quota or shedding cause a duplicate economic effect, so that a refused retry leaves the idempotency record and the outbox in a state that resolves to exactly one outcome."
ac_10 = "THE daemon SHALL expose current limit configuration and live utilisation per tenant so that a limit refusal is diagnosable without reading logs."

[req.20]
title = "Audit Trail and Observability"
story = "As a compliance owner, I want an append-only record of every decision and every mutation attempt with its evidence, so that I can reconstruct what happened without trusting a narrative assembled after the fact."
ac_1 = "THE daemon SHALL record in an append-only audit log every authentication, session lifecycle event, capability decision, policy decision, budget reservation, preparation, signature request, submission, terminal outcome, subscription change, configuration change and administrative action."
ac_2 = "WHEN an audit entry is written THE entry SHALL carry the tenant, the agent, the session, the capability, the policy version, the request identifier, the idempotency key, the decision, the reason, the resulting activity identifier where one exists and the verification level reached."
ac_3 = "THE audit log SHALL be append-only and tamper-evident through a hash chain over its entries, SHALL make any excision or reordering detectable, and SHALL be verifiable by a tool shipped with the workspace."
ac_4 = "THE daemon SHALL never write private key material, full signed activity payload contents beyond the configured retention, session token values, or unredacted secret configuration into audit entries, logs, metrics, traces or error messages."
ac_5 = "WHEN an activity reaches a terminal state THE audit trail SHALL be sufficient to reconstruct why it was allowed, what exact bytes were submitted, which authority was used, and what the core returned, using the audit entries and stored receipt bytes alone."
ac_6 = "THE daemon SHALL emit metrics covering submission outcomes by result class, unknown-state population and age, verification levels achieved, boundary latency and error classes, policy and capability decisions, budget utilisation, subscription lag and rate-limit refusals, and SHALL label them by tenant without embedding high-cardinality identifiers such as activity identifiers in metric labels."
ac_7 = "THE daemon SHALL emit distributed traces that span the request from caller through policy, preparation, signing, submission and receipt resolution, and SHALL propagate a request identifier that appears in logs, traces and audit entries alike."
ac_8 = "THE daemon SHALL expose health surfaces distinguishing liveness, readiness to accept writes, boundary connectivity, verification backlog, unknown-state backlog and degraded modes, and SHALL report not-ready rather than accepting writes it cannot deliver."
ac_9 = "IF the audit log cannot be written THEN THE daemon SHALL refuse the operation that would have been audited, because an unaudited mutation attempt is not permitted."
ac_10 = "THE daemon SHALL support exporting an audit slice for a tenant, an agent or a time range together with the receipts and proofs it references, so that an external reviewer can verify the protocol facts independently."

[req.21]
title = "Tenant Isolation"
story = "As a platform operator, I want tenants separated in keys, data, limits and failure domains, so that one tenant can neither observe another nor degrade another through any path the layer exposes."
ac_1 = "THE daemon SHALL scope every stored object, including identities, sessions, capabilities, budgets, policies, prepared activities, outbox entries, receipts, subscriptions and audit entries, to exactly one tenant, and SHALL make a cross-tenant read or write structurally impossible in the storage access path rather than filtered at the edge."
ac_2 = "WHEN any request is served THE daemon SHALL resolve the tenant from the authenticated principal, SHALL ignore any tenant identifier supplied in the request body or headers as authoritative, and SHALL refuse a request whose target object belongs to another tenant."
ac_3 = "THE daemon SHALL isolate key material and signer configuration per tenant, SHALL never allow a tenant to use another tenant signer, and SHALL scope every external signer binding to its tenant."
ac_4 = "THE daemon SHALL apply limits, quotas and load shedding per tenant so that one tenant exhausting its quota does not consume another tenant capacity, and SHALL reserve capacity for submission delivery and receipt resolution across tenants under contention."
ac_5 = "THE daemon SHALL scope subscriptions, streams and MCP servers to a tenant, and SHALL guarantee that no filter, cursor, backfill or error message can expose an event, an identifier or an existence fact from another tenant."
ac_6 = "IF an internal error occurs THEN THE daemon SHALL ensure the error message, the trace and the metric labels carry no data belonging to another tenant, and SHALL NOT include raw object identifiers from a failed cross-tenant lookup."
ac_7 = "THE daemon SHALL support per-tenant configuration of policy, redaction, retention, verification level defaults and approval requirements, and SHALL apply a tenant configuration only to that tenant."
ac_8 = "THE workspace SHALL include an isolation test suite that attempts cross-tenant access through every public surface, including the API, the SDKs, the MCP tools, subscriptions, exports and error paths, and SHALL treat any leakage, including a distinguishable existence or timing signal in the API surface, as a build-breaking defect."
ac_9 = "WHEN a tenant is deleted THE daemon SHALL remove or irreversibly key-destroy its data according to the configured retention policy, SHALL retain only what an explicitly configured legal retention requires, and SHALL record the deletion in the audit trail."
ac_10 = "THE daemon SHALL make tenancy visible in every audit entry, metric and trace so that isolation is observable rather than asserted."

[req.22]
title = "Deployment, Configuration and Degraded Modes"
story = "As a platform operator, I want the daemon to be explicit about its configuration and honest when it is degraded, so that a partial outage produces refusals I can see rather than answers I should not have trusted."
ac_1 = "THE daemon SHALL load configuration from explicit files and environment with a documented precedence, SHALL validate it fully at startup, and SHALL refuse to start on an invalid, ambiguous or unsafe configuration rather than substituting a default."
ac_2 = "THE daemon SHALL require explicit configuration of network_id, node endpoint, expected protocol version, tenant set, policy source, signer configuration and verification level defaults, and SHALL treat an unset security-relevant setting as a startup failure rather than a permissive default."
ac_3 = "WHEN the daemon starts THE daemon SHALL perform the boundary handshake, SHALL report the node interface version, protocol version, network identifier, capability intersection and any missing capability, and SHALL refuse writes until the handshake succeeds."
ac_4 = "IF the core becomes unreachable THEN THE daemon SHALL enter a degraded read mode in which it serves only values it can still verify, marks their staleness, refuses preparation that needs live core state, refuses submission acknowledgement, and continues resolving unknown submissions when connectivity returns."
ac_5 = "IF the core reports a halted, emergency or data-unavailable mode THEN THE daemon SHALL propagate that state in its own health and read responses, SHALL refuse to report facts at a verification level the core state no longer supports, and SHALL NOT continue to advertise finality it cannot verify."
ac_6 = "WHEN the daemon is upgraded THE daemon SHALL migrate its local stores forward with an explicit versioned migration, SHALL refuse to start against a store from a newer version, and SHALL never require a receipt, proof or protocol fact to be re-derived from anything other than the core during migration."
ac_7 = "THE workspace SHALL publish a compatibility matrix of daemon version against node interface version against contract version against SDK version, and SHALL verify at least the supported range in CI against a real node."
ac_8 = "THE daemon SHALL support graceful shutdown that stops accepting new work, completes or durably records in-flight submissions, flushes audit entries, and exits without leaving a submission whose state is unrecoverable from the outbox."
ac_9 = "THE daemon SHALL provide an operator surface to inspect and act on unknown submissions, stalled subscriptions, budget divergence and verification backlog, and SHALL make every operator action itself audited and non-mutating with respect to protocol state."
ac_10 = "THE daemon SHALL expose no administrative path that alters a recorded receipt, a verification level, an audit entry or a protocol-derived value, so that no operator action can make the layer assert something the core did not produce."

[req.23]
title = "Agent Layer Qualification and Conformance"
story = "As a protocol steward, I want the interaction layer qualified against the real core under adversarial conditions, so that its guarantees are demonstrated rather than described."
ac_1 = "THE workspace SHALL run a differential conformance suite that compares layerx-wire encodings, digests, identifiers and rejection classifications against the C reference implementation over the published vectors and generated inputs, and SHALL fail the build on any divergence."
ac_2 = "THE workspace SHALL run a boundary conformance suite against a real running node covering every node interface message, its error cases, its streaming behaviour, its version negotiation and its capability reporting, and SHALL NOT satisfy it with an in-process substitute for the node."
ac_3 = "THE workspace SHALL run a no-fabrication suite in which a deliberately hostile node returns altered balances, altered receipts, re-signed receipts, sub-threshold certificates, truncated proofs, reordered events and withheld availability data, and SHALL demonstrate that the layer reports a verification failure or unavailability in every case and never surfaces the altered value as a result."
ac_4 = "THE workspace SHALL run a fault-injection suite covering connection loss at every stage of submission, process kill between signing and transmission, duplicate delivery, delayed acknowledgement, restart mid-resolution and clock disturbance, and SHALL demonstrate exactly-once economic effect and honest unknown reporting in every case."
ac_5 = "THE workspace SHALL prove idempotency end to end by submitting the same intent through repeated retries, concurrent duplicates and post-restart resubmission and asserting exactly one receipt and one economic effect."
ac_6 = "THE workspace SHALL run the cross-tenant isolation suite, the policy adversarial suite and the MCP untrusted-input suite as build gates, and SHALL treat any escape as a build-breaking defect rather than a tracked issue."
ac_7 = "THE workspace SHALL fuzz every parser and every externally reachable decoder, including the wire codec, the node interface framing, the contract request surface and the policy loader, and SHALL treat a panic, hang or unbounded allocation as a defect."
ac_8 = "THE workspace SHALL run a soak test that sustains submission, streaming and verification load for an extended period and asserts no unbounded memory growth, no unbounded queue growth, no leaked reservations and no growing population of unresolved unknown submissions."
ac_9 = "THE workspace SHALL forbid unsafe code outside an explicitly enumerated and justified allowlist, SHALL run the test suite under the address and thread sanitizers where the toolchain supports it, and SHALL fail the build on a sanitizer report."
ac_10 = "THE workspace SHALL publish, as a release gate, a qualification report stating which guarantees are protocol-enforced, which are daemon-enforced, which suites were run, what the results were and which capabilities the node did not expose, and SHALL make an unmet gate block release rather than being waived silently."

# --------------------------------------------------------------------------
# TASKS
# --------------------------------------------------------------------------

[task.1]
section = "Wave 1 - Foundations and Domain Types"
title = "Establish the Rust agent workspace and its engineering gates"
status = "pending"

[task.1.1]
title = "Create the agent workspace and its build entry points"
status = "done"
wave = 1
do_1 = "Create the Cargo workspace at agent/ with the nine member crates layerx-types, layerx-wire, layerx-crypto, layerx-proof, layerx-client, layerx-agent-api, layerx-agentd, layerx-mcp and layerx-sdk, each with its declared purpose and no member depending on a crate above it in that order."
do_2 = "Pin the Rust edition, the minimum supported toolchain and the resolver in the workspace manifest, and commit a toolchain file so every machine and CI runner builds with the identical compiler."
do_3 = "Add the agent-build, agent-test, agent-lint, agent-fuzz and agent-check make targets to the repository Makefile, each delegating to cargo inside agent/ and none of them entering the C build."
do_4 = "Keep the C build untouched: prove that make build and the existing protocol test targets succeed with the agent workspace present and that no C target gains a Rust dependency."
do_5 = "Add a workspace README fragment that states the non-authority rule and the boundary rule as the first two paragraphs a contributor reads."
