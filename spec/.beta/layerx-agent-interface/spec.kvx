[task.14.2]
title = "Implement idempotency records and conflict detection"
status = "done"
wave = 9
requires = ["14.1"]
do_1 = "Implement caller-supplied idempotency keys across every mutating contract operation, storing the request digest and the original result."
do_2 = "Return the original result for a repeated key and a typed conflict error for a repeated key whose request body differs."
do_3 = "Carry the protocol idempotency_key through preparation and submission so one caller intent maps to exactly one protocol idempotency key."
do_4 = "Persist idempotency records durably with an explicit retention and prove that retention expiry cannot cause a duplicate economic effect within the protocol retention window."
do_5 = "Add a concurrency test issuing the same key from many callers simultaneously and asserting exactly one economic result."
