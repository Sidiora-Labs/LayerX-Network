[task.9.4]
title = "Re-evaluate protocol authority before every write"
status = "done"
wave = 8
requires = ["9.3"]
do_1 = "Re-resolve the underlying protocol authority against core state before every preparation and refuse when it has expired, rotated, been revoked or fallen out of scope."
do_2 = "Cache the authority resolution only within an explicit freshness bound and revalidate past it rather than trusting the session record."
do_3 = "Name the failing authority condition in the refusal so a caller can distinguish expiry from revocation from scope."
do_4 = "Report in every response which protocol authority was actually used for the activity."
do_5 = "Add tests covering revocation between session open and preparation, and rotation between preparation and submission."
