status = "done"
wave = 10
requires = ["20.2","15.5"]
do_1 = "Enter a degraded read mode when the core is unreachable, serving only values that can still be verified and marking their staleness with the head and checkpoint they are relative to."
do_2 = "Refuse preparation that needs live core state and refuse submission acknowledgement while degraded, while continuing to resolve unknown submissions when connectivity returns."
