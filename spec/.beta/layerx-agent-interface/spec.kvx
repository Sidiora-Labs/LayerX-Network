[task.6]
section = "Wave 5 - The Node Boundary"
title = "Define and qualify the LayerX Node Interface"
status = "pending"

[task.6.1]
title = "Specify the node interface schema and its version rules"
status = "done"
wave = 5
requires = ["2.5"]
do_1 = "Author the node interface schema as a versioned artefact under source control declaring every request, response and stream message, with node info, submit, receipt lookup, account read, history range, batch header, checkpoint, proof bundle, availability fetch and event subscribe as the initial message set."
do_2 = "Declare that every payload carrying protocol data is opaque canonical LayerX bytes plus the proof material required to verify it, so the schema never restates a protocol structure in a second encoding."
do_3 = "Define the version rule as a major and minor pair where minor changes are additive only, and record golden encoding vectors for every message so a change to the encoding is visible as a diff."
do_4 = "Define the capability list a node advertises, so a node that cannot serve availability retrieval or historical proofs is describable rather than merely failing."
do_5 = "Document the schema in docs/node-boundary.md alongside the framing, transport and handshake rules and keep the document generated from or checked against the schema."
