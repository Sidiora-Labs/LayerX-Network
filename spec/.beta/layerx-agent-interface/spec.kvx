[task.14.6]
title = "Recover the outbox on restart without duplication or loss"
status = "done"
wave = 9
requires = ["14.2","14.3"]
do_1 = "Recover the outbox on start, resume resolution of every non-terminal submission, and refuse writes until recovery completes."
do_2 = "Neither resubmit an activity already executed nor drop an activity that was signed and queued but never transmitted."
do_3 = "Reconstruct reservations, ceilings and budget accounting from persisted receipts before accepting a write."
do_4 = "Implement graceful shutdown that stops accepting work, durably records in-flight submissions and flushes audit entries."
do_5 = "Add a kill-and-restart test at every stage of the write path asserting exactly-once economic effect across the restart."
