[task.10]
title = "Implement capabilities and their attenuation"
status = "pending"

[task.10.1]
title = "Implement the capability model and its dimensions"
status = "done"
wave = 8
requires = ["9.3"]
do_1 = "Implement the capability record with permitted activity types, permitted counterparties, permitted assets, amount ceilings, rate ceilings, purpose constraints and expiry, rejecting a capability that leaves any dimension unspecified."
do_2 = "Implement evaluation that checks a prepared activity against every dimension and refuses on the first exceeded dimension, naming it."
do_3 = "Make evaluation deterministic from the recorded capability and the prepared activity alone, with no ambient input, and prove identical decisions for identical inputs."
