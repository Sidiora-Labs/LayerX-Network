[task.10.2]
title = "Enforce narrowing against the underlying protocol authority"
status = "done"
wave = 8
requires = ["10.1"]
do_1 = "Resolve the underlying protocol authority at capability creation and reject any capability that would permit an activity type, asset, counterparty or amount that authority does not already permit."
do_2 = "Forbid presenting a capability to the core as authorisation, and prove in test that no submission path carries a capability identifier as protocol authority."
do_3 = "Record for every dimension whether it is protocol-enforced or daemon-enforced only."
