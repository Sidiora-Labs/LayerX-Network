do_2 = "Assert no unbounded memory growth, no unbounded queue growth, no leaked reservations and no growing population of unresolved unknown submissions."
do_3 = "Assert subscription lag returns to baseline after induced stalls and that no event is lost across the soak."
do_4 = "Record resource curves and attach them to the qualification report."
do_5 = "Wire the soak into a scheduled CI job with the report as its artefact."
