reqs = ["2.1","2.9","2.3"]

[task.6.2]
title = "Implement framing, transports and connection limits"
status = "done"
wave = 5
requires = ["6.1"]
do_1 = "Implement length-prefixed canonical framing with an explicit maximum message size, rejecting an over-long frame before allocating for it."
do_2 = "Implement the Unix domain socket transport as the default and the mutual-TLS TCP transport for remote deployment, with identical message semantics on both."
do_3 = "Implement connection limits, per-connection deadlines and stream multiplexing such that a slow read cannot starve submission delivery on the same connection."
do_4 = "Return typed transport errors distinguishing connection failure, deadline, frame violation and peer shutdown, and never map any of them onto a verification or core-rejection error."
do_5 = "Fuzz the framing decoder and add tests covering truncated frames, oversized frames, interleaved streams and abrupt peer loss."
