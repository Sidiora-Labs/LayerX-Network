title = "Implement the handshake, capability intersection and refusal rules"
status = "done"
wave = 5
requires = ["6.2"]
do_1 = "Implement the handshake exchanging node interface version, protocol version, network identifier, node role, chain head, latest sealed batch, latest finalised checkpoint and the currently authorised sequencer public key."
do_2 = "Refuse the connection with an explicit incompatibility error naming both versions when the major node interface version differs from the built-against version, with no best-effort interpretation."
do_3 = "Refuse to operate against a network identifier or protocol version the layer was not configured for, and make that refusal a startup failure rather than a per-request one."
do_4 = "Compute the capability intersection, expose every unavailable capability through a capability report, and fail dependent requests as unavailable rather than emulating them."
do_5 = "Add tests covering a newer node, an older node, a wrong network, a missing capability and a node that changes its advertised sequencer key across reconnects."
