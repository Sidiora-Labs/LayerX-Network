[task.14.4]
title = "Verify, store and serve receipt bytes unchanged"
status = "done"
wave = 9
requires = ["14.3","5.2"]
do_1 = "Verify every retrieved receipt through layerx-proof before recording a terminal state and record the achieved verification level with it."
do_2 = "Store the exact receipt bytes and serve them unchanged by activity identifier, idempotency key and global sequence."
do_3 = "Record the exact protocol result code for a rejection, classify it as terminal or retriable from the protocol taxonomy, and never retry a terminal rejection."
do_4 = "Surface the result code unmodified to the caller with no local reinterpretation or substituted explanation."
do_5 = "Add tests asserting byte equality between stored and served receipts and asserting no retry occurs for each terminal code class."
