# qualification.kvx - Sidiora fee-token executed-evidence ledger.
#
# Two record shapes live here. Both are append-only. No record is edited or
# removed once written; a rerun appends a new record beside the old one.
#
# [observation.<task>.<n>]  - the shape every feature uses (workflow.kvx
#   [qualification_log]): an assumption, an unrelated or pre-existing failure,
#   a cross-task contradiction, a missing external interface, or a repair that
#   would require weakening a check. Written once, never re-investigated and
#   never re-run. Keys: task, file, symbol, observed, assumption, severity
#   (blocker | suspect | assumption | note). At most six lines per entry.
#
# [gate.<task>.<n>]  - an EXECUTED gate. Written only after running the named
#   command, from that run's own output; never written for a command that did
#   not run and never written to record an expectation. Keys:
#     task        = "3.1"                       task that ran the gate
#     reqs        = ["15.1","15.2"]             acceptance criteria it qualifies
#     revision    = "<40-hex commit>"           commit the command ran against
#     command     = "go test -count=1 ./modules/evm/..."
#     environment = "<os/arch/toolchain identity>"
#     started_at  = "<UTC timestamp>"
#     outcome     = "pass"                      pass | fail | blocked
#     evidence    = "<log path the gate printed>"
#     note        = "free text; for blocked, the owner action required"
#
# Task-level verify_cmd runs are NOT recorded here: a task records its result
# through cg spec done. This ledger carries the three legs of the wave 3 gate
# and the observations any task makes along the way.
#
# No record carries a hostname, an IP address, an internal URL, a credential or
# the name of an agent or a working branch.

[observation.1.1.1]
revision = "17c8ed319f18cbe5a003614c4ee082c2c3c0b122"
command = "cat precompiles/oracle/oracle.go"; exit_code = 0
log_path = ".logs/context.log"
observed = "The oracle precompile returns ErrOraclePrecompileRetired for every rate query."
assumption = "Sponsorship must fail closed until an independently authorized change supplies oracle rates; this task does not alter the precompile."

[observation.2.4.1]
revision = "17c8ed319f18cbe5a003614c4ee082c2c3c0b122"
command = "go run github.com/bufbuild/buf/cmd/buf@v1.58.0 --version"
exit_code = 1
log_path = ".logs/proto-toolchain.log"
observed = "The pinned Buf executable is absent and its Go invocation cannot write to the shared module cache."
assumption = "The authorized manual protobuf update is required in this environment."

[observation.2.4.2]
revision = "17c8ed319f18cbe5a003614c4ee082c2c3c0b122"
command = "cortex_guard"
exit_code = 127
log_path = ".logs/guard.log"
observed = "The required guard executable is unavailable."
assumption = "Publication remains restricted to the requested branch with no chain interaction."

[observation.2.4.3]
task = "2.4"
file = "contracts/src/BatchCallAndSponsor.sol"
observed = "The oracle keeper stores LastUpdateTimestamp in milliseconds, but _readRate compares it directly with block.timestamp in seconds and rejects a current keeper-produced timestamp with StaleOracleRate."
assumption = "Keeper-produced rates require matching timestamp units in the contract freshness check and behavior coverage; oracle availability remains a separate recorded blocker."
severity = "note"

[observation.2.4.4]
task = "2.4"; file = "contracts/src/BatchCallAndSponsor.sol"
symbol = "_readRate"
observed = "Review comment 4107937019 repeats the timestamp-unit mismatch recorded in observation.2.4.3; the contract remains unchanged."
assumption = "Freshness validation requires matching units and coverage for keeper-produced rates; oracle availability remains a separate recorded blocker."
severity = "note"

[observation.2.1.1]
revision = "974fcd706f687617f9b4a1e3aa6e2d0b85981143"
command = "cat modules/layerxbridge/types/genesis.go"; exit_code = 0
log_path = ".logs/scope-conflict.log"
observed = "GenesisState.Validate requires every asset denom to equal the existing chain-derived Denom, which rejects the required Sidiora subdenom; the validator is outside task 2.1 touches."
assumption = "The genesis compatibility change requires separately authorized scope; this task leaves the existing assertion intact."

[observation.2.1.2]
revision = "974fcd706f687617f9b4a1e3aa6e2d0b85981143"
command = "timeout 2m go vet ./modules/layerxbridge/types ./modules/layerxbridge/keeper"; exit_code = 124
log_path = ".logs/vet.log"
observed = "Touched-package go vet exceeded its bounded run without emitting diagnostics."
assumption = "Lint qualification remains incomplete; no unchanged lint rerun is performed."

[observation.2.3.1]
task = "2.3"; file = "contracts/test/BatchCallAndSponsorTest.t.sol"; symbol = "testDigestsBindEveryQuoteFieldAndChain"
revision = "92d9139d9bdc4cae205b19744f48715e6ef6f56d"
observed = "Review comment 4107298019 identifies missing account-signature rejection coverage after a chain ID change; the test checks only quoteDigest after that change."
assumption = "Task 1.1 owns this test outside task 2.3 touches; its owner must add the regression coverage."
severity = "note"

[observation.2.3.2]
task = "2.3"; file = "spec/sidiora-fee-token/qualification.kvx"; symbol = "observation schema"
revision = "92d9139d9bdc4cae205b19744f48715e6ef6f56d"
observed = "Review comment 4107298026 identifies existing records that follow requirement 15.3 evidence fields but omit metadata required by this file's header."
assumption = "The append-only rule and conflicting schema declarations require preserving both existing records and declarations until the feature owner reconciles them."
severity = "suspect"

