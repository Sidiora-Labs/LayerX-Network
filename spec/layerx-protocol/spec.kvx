do_3 = "Implement lx_asset_nullifier_seen so a settlement or a further withdrawal presenting an already recorded nullifier is rejected with WITHDRAWAL_ALREADY_SETTLED and no withdrawal can pay twice."
do_4 = "Keep total LayerX supply unchanged at request time, retiring value against system:paxeer-reserve only when a finalised settlement reference is presented, so the withdrawal path never burns."
