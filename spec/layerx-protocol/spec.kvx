do_2 = "Implement lx_escrow_open_execute to emit exactly one leg from agent owner main to agent owner escrow subaccount with reason LXP_REASON_ESCROW_LOCK, and no other monetary effect."
do_3 = "Record beneficiary, arbiter, asset, locked amount, captured amount, state, expiry timestamp, dispute window, terms hash and agreement reference through lx_escrow_state_put, all under the escrow module namespace."
do_4 = "Model the hold lifecycle as the explicit states Open, PartiallyCaptured, Captured, Released, Disputed, Resolved and TimedOut, rejecting any transition not defined for the current state with LX_ERR_ESCROW_STATE."
