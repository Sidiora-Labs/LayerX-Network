[task.4]
title = "Implement checked fixed-width integer arithmetic"
status = "pending"

[task.4.1]
title = "Implement the 128-bit unsigned type with checked addition and subtraction"
status = "done"
wave = 1
requires = ["1.1","1.2"]
do_1 = "Add include/layerx/lxp_u128.h defining lxp_u128 as a struct of hi and lo uint64 words, so bare plus, minus and multiply do not compile on an amount."
do_2 = "Implement lxp_u128_add returning the overflow result code and lxp_u128_sub returning the underflow result code, never wrapping, saturating or truncating."
do_3 = "Implement lxp_u128_cmp, lxp_u128_is_zero and the 16-byte big-endian conversions the codec uses for amounts and fee limits."
do_4 = "Prove correctness by exhaustive boundary tests at zero, one, max minus one, max and every carry and borrow boundary of the low word."
do_5 = "Assert under UndefinedBehaviorSanitizer that no signed overflow and no undefined shift exists anywhere in the amount path."
