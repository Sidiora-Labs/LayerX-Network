wave = 13
requires = ["19.3"]
do_1 = "Define the custody contract surface to accept exactly six inputs: a finalised checkpoint certificate, membership or balance proofs against its state root, withdrawal nullifiers, guarantor signatures, challenge-window state and emergency-exit eligibility."
do_2 = "Implement lxp_checkpoint_register to submit only the header commitments of a checkpoint, never individual activity envelopes, payloads or receipts."
do_3 = "Implement lxp_paxeer_verify_cert on the contract side to count distinct bonded guarantor signatures over the checkpoint hash and advance the registered finalised state root."
do_4 = "Keep the contract free of any LayerX business logic: no perps order, no market or funding rule, no service agreement, no escrow or budget rule and no ordinary transfer is interpretable by it."
