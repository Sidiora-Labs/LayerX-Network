title = "Implement signed magnitude arithmetic and the fixed rounding rules"
status = "done"
wave = 1
requires = ["4.2"]
do_1 = "Define lxp_i128 as a sign-magnitude struct so negativity is explicit, while balances stay unsigned and negativity therefore stays unrepresentable."
do_2 = "Implement lxp_i128_add and lxp_i128_sub with checked magnitude arithmetic and a canonical zero that is never a negative zero."
do_3 = "Express every ratio as uint32 basis points where ten thousand is exactly unity, with lxp_u128_mul_bps_floor and lxp_u128_mul_bps_ceil as the only ratio entry points."
do_4 = "Implement lxp_u128_mul_div_floor as the multiply-then-divide primitive that every price, fee, funding and accrual computation must call."
do_5 = "Fix the rounding direction per site so fees round up and payouts round down, and test that rounding never creates or destroys a unit of any asset."
