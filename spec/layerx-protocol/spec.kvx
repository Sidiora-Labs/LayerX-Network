[task.21]
title = "Build the governance module, fees and resource metering"
status = "pending"

[task.21.1]
title = "Hold protocol parameters as versioned state"
status = "done"
wave = 12
requires = ["17.3"]
do_1 = "Implement lxp_param_table mapping parameter identifiers to value, activation epoch, proposed value and proposal id, iterated in canonical byte-lexicographic key order."
do_2 = "Implement lxp_param_version so every execution resolves parameters through an explicit version and every receipt records the parameter_version in force."
do_3 = "Implement lxp_param_set_bounds declaring the legal range and target module of every key, so an out-of-bounds or unknown key is rejected rather than clamped."
do_4 = "Implement lxp_param_get as the only read path, forbidding any module from caching a parameter across an epoch boundary."
do_5 = "Test that replaying a historical batch resolves the parameter values of that batch epoch, not the newest values."
verify_cmd = "make test-governance"
symbols = ["lxp_param_table","lxp_param_get","lxp_param_version","lxp_param_set_bounds"]
