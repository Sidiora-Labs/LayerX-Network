[task.5.3]
title = "Implement crash recovery and partial tail truncation"
status = "done"
wave = 2
requires = ["5.2"]
do_1 = "Implement lxp_log_recover scanning the last segment forward, validating magic and CRC and truncating at the first invalid or short record, treating a partial tail as a crash artifact and never as a fork."
do_2 = "Load the newest snapshot at or before durable head, replay forward, recompute state roots and compare them against the recorded receipts."
do_3 = "Halt with the replay divergence fatal code on any mismatch, because the binary and the history disagree and continuing would serve state the node cannot justify."
do_4 = "Resume at the next unused global sequence with no re-execution, duplication or skipping of any already sealed activity."
do_5 = "Test recovery from an abort at every write boundary, asserting each activity is either fully contained or fully excluded and no partially applied transfer set is ever observable."
