[task.13.4]
title = "Settle streams through the ledger kernel with underfunded clamping"
status = "done"
wave = 7
requires = ["13.2"]
do_1 = "Implement lx_stream_settle_amount as newly accrued minus already settled, and lx_stream_settle_execute emitting one leg from the payer stream subaccount to the recipient main account with reason LXP_REASON_STREAM_DRAW."
do_2 = "Clamp a settlement that exceeds the stream subaccount balance to the available balance, mark the stream underfunded through lx_stream_mark_underfunded, and suspend further accrual from that settlement timestamp."
