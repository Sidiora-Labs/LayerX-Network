reqs = ["20.1","20.10","4.9","5.6"]

[task.21.2]
title = "Enact parameter changes with activation delay and staged rollout"
status = "done"
wave = 12
requires = ["21.1"]
do_1 = "Implement lxp_gov_param_propose to record target_module, parameter_key, proposed_value, activation_epoch and rollout_scope as an ordered activity signed by the governance authority."
do_2 = "Reject a proposal naming an activation_epoch earlier than the current epoch plus the minimum activation delay, an unknown module or key, or a value outside declared bounds, with no state change beyond sequence and fee."
do_3 = "Implement lxp_gov_activation_apply to apply the new value atomically at the first batch whose epoch equals the pending activation epoch and to increment parameter_version at that deterministic boundary."
do_4 = "Implement lxp_gov_stage_cohort so a staged rollout applies only to the enumerated cohort by module, market or account set, leaving every other cohort on the prior value until its own stage activates."
do_5 = "Reject retroactive application outright and preserve the original versioned transition function for sequences already sealed."
do_6 = "Test that two replicas activating from different starting snapshots compute the identical resulting_state_root at the activation boundary."
verify_cmd = "make test-governance-activation"
symbols = ["lxp_gov_param_propose","lxp_gov_param_enact","lxp_gov_activation_apply","lxp_gov_stage_cohort"]
touches = ["src/modules/governance/lxp_gov_param.c","tests/test_governance_activation.c"]
reqs = ["20.2","20.3","20.4","20.5"]

[task.21.3]
title = "Implement scoped emergency pause and emergency mode"
status = "done"
wave = 12
requires = ["21.1"]
do_1 = "Implement lxp_gov_emergency_halt to apply a pause at the declared scope of one module, one market or the whole network, recorded as an ordered activity."
do_2 = "Implement lxp_pause_scope_check so every submitted activity inside a paused scope is rejected with the paused-scope result code while activities outside that scope remain fully executable."
do_3 = "Keep ordering, sealing, distribution and checkpointing running while paused, and keep receipts, inclusion proofs and balance proofs servable so withdrawal and exit paths stay usable."
do_4 = "Implement lxp_gov_emergency_resume requiring an explicit signed governance activity, never elapsed wall-clock time and never an implicit background timer."
do_5 = "Reject any governance activity that would write a balance, mint or burn supply, alter an issued receipt, rewrite a sealed batch or substitute a state root."
do_6 = "Test module-scoped, market-scoped and network-scoped pauses independently, including that a paused perps market still permits order cancellation paths defined by that module."
verify_cmd = "make test-governance-emergency"
symbols = ["lxp_gov_emergency_halt","lxp_gov_emergency_resume","lxp_pause_scope_check","lxp_gov_module_enable"]
touches = ["src/modules/governance/lxp_emergency.c","tests/test_governance_emergency.c"]
reqs = ["20.6","20.7","20.8","20.9"]

[task.21.4]
title = "Compute fees deterministically and charge them as a transfer"
status = "done"
wave = 12
requires = ["21.1"]
do_1 = "Implement lxp_fee_compute as a versioned integer-only function of activity type, canonical encoded byte length, metered execution units and metered storage units, using checked fixed-width arithmetic only."
do_2 = "Apply exactly one rounding rule that rounds any fractional base unit upward, and prove bit-identical results across compilers, optimisation levels and architectures."
do_3 = "Implement lxp_fee_charge to move the fee as a 402LXP transfer from the actor main account to system fees, through the single balance-mutation primitive and no other path."
do_4 = "Record the charged amount in the receipt field fee_charged and guarantee it never exceeds the declared fee_limit."
do_5 = "Implement lxp_fee_schedule resolved from governance parameters at the batch epoch so historical fees stay reproducible after later parameter changes."
do_6 = "Test per-asset conservation: the sum of fee debits equals the sum of fee treasury credits over a long replay."
