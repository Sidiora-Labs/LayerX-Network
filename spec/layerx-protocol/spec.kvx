[task.8.3]
title = "Implement versioned transition dispatch in fixed order"
status = "done"
wave = 4
requires = ["6.5","6.6","8.2"]
do_1 = "Implement lxp_kernel_execute_activity in fixed order: decode, envelope and module enablement checks, identity and authority resolution with signature verification, exact sequence equality, timestamp bound, idempotency short-circuit, fee computation against the limit, journal open, validate then execute, commit or roll back, then fee charge and sequence consumption and idempotency record and receipt on both paths, then state root chaining."
do_2 = "Select the transition version recorded for the batch rather than the newest available version, so replay of old history is unaffected by later upgrades."
do_3 = "Record in each receipt the module version under which the activity executed, and apply a new module version only from a declared epoch boundary onward."
do_4 = "On a module failure discard every state write that activity attempted, leave every other module unchanged, and still consume the account sequence and charge the metered fee for a well-formed authorised activity."
do_5 = "Forbid a validate implementation from mutating state and assert that property against the test module the suite registers."
do_6 = "Test that a failure receipt carries the failure result code, zero module effects and correctly chained state roots."
verify_cmd = "make test-dispatch"
symbols = ["lxp_kernel_execute_activity","lxp_kernel_dispatch","lxp_module_version_for_epoch","lxp_kernel_step_order"]
touches = ["src/protocol/lxp_kernel.c","include/layerx/lxp_kernel.h","tests/protocol/lxp_test_dispatch.c"]
reqs = ["4.6","4.8","5.6","26.6"]

[task.8.4]
title = "Implement the event and receipt emission path"
status = "done"
wave = 4
requires = ["3.4","8.3"]
do_1 = "Implement lxp_effect_buffer collecting module effects sorted by module id and effect ordinal, and require every monetary effect to be a transfer effect carrying a transfer set root."
do_2 = "Trap on any other monetary effect kind, because such an effect is a kernel bug rather than a module error."
do_3 = "Emit events only through lxp_ctx_emit_event and commit them under the batch event merkle root, providing no module-private or process-local channel by which an effect could become observable without appearing in that commitment."
do_4 = "Build the ActivityReceipt with activity id, global sequence, previous state root, resulting state root, activity root, result code, effects, fee charged, batch id and sequencer signature, every value computed by the protocol from the resulting state."
do_5 = "Sign the receipt over the domain-separated canonical encoding of the receipt without its own signature, verifiable against the published sequencer key with no further interaction with the node."
do_6 = "Reject any client-supplied assertion of a result, an effect, a resulting balance or a state root."
verify_cmd = "make test-receipts"
symbols = ["lxp_effect_buffer","lxp_ctx_emit_event","lxp_receipt_build","lxp_receipt_sign","lxp_receipt_encode"]
touches = ["src/protocol/lxp_receipt.c","include/layerx/lxp_receipt.h","tests/protocol/lxp_test_receipts.c"]
reqs = ["2.9","4.10","12.1","12.4"]

[task.8.5]
title = "Compute and chain the state root"
status = "done"
wave = 4
requires = ["3.4","5.6","8.4"]
do_1 = "Implement lxp_state_root as a pure function of state composing each module subtree root under the kernel domain tags into a single root."
do_2 = "Iterate every account, grant, order, position and effect collection in canonical byte-lexicographic key order, never in insertion, allocation, hash-seed or pointer order."
do_3 = "Recompute each asset total units against the account tree at every seal and return the supply mismatch fatal code on divergence rather than continuing."
do_4 = "Chain previous state root to resulting state root per activity and not only per batch, so the receipt at a global sequence names the resulting root of the preceding sequence."
do_5 = "Test that two nodes with different allocation patterns and optimisation levels produce byte-identical roots for the identical history."
verify_cmd = "make test-state-root"
symbols = ["lxp_state_root","lxp_state_subtree_root","lxp_state_root_chain","lxp_state_supply_check"]
touches = ["src/state/lxp_state_root.c","include/layerx/lxp_state.h","tests/state/lxp_test_state_root.c"]
reqs = ["5.1","5.4","6.5","13.5"]

[task.8.6]
title = "Enforce the execution guard and prove golden replay"
status = "done"
wave = 4
requires = ["8.5"]
do_1 = "Extend the link-time symbol allowlist to forbid time, clock_gettime, gettimeofday, rand, random, getenv, getpid, gethostname, stat and every socket or HTTP entry point in execution translation units."
do_2 = "Implement lxp_determinism_guard_check so a transition path reaching a forbidden call halts the node rather than producing a state root it cannot justify."
do_3 = "Add tests/replay holding a golden activity history together with its recorded per-batch state roots, receipts and event roots."
do_4 = "Implement lxp_kernel_replay executing the golden history from genesis with no index database as an input, asserting byte-identical roots at every batch boundary."
do_5 = "Run the golden replay at two optimisation levels and on a second CPU architecture in CI, failing on a single differing byte with the replay divergence fatal code."
do_6 = "Assert that reducing the worker pool to zero threads changes no output byte, which is the operational definition that the threading model is not part of consensus."
verify_cmd = "make test-replay-golden"
