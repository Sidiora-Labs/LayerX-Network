[task.17]
section = "Waves 10-12 - Sequencing, Replay, Guarantors and Availability"
title = "Build the sequencer and the activity batch"
status = "pending"

[task.17.1]
title = "Define the BatchHeader and its canonical serialisation"
status = "done"
wave = 10
requires = ["2.3","3.4","8.5"]
do_1 = "Declare struct lxp_batch_header in include/layerx/lxp_batch.h carrying exactly protocol_version, network_id, epoch, batch_number, first_sequence, last_sequence, previous_state_root, resulting_state_root, activity_merkle_root, receipt_merkle_root, event_merkle_root, data_availability_root, oracle_root, timestamp_ms and sequencer_id, every field a fixed-width integer or a fixed-length hash."
do_2 = "Implement lxp_batch_header_encode and lxp_batch_header_decode on the canonical binary codec, rejecting trailing bytes, non-minimal integers, optional fields and any unknown field identifier with a deterministic result code."
do_3 = "Implement lxp_batch_header_hash under the domain tag `LX:BATCH_HEADER:v1` so a header digest can never be confused with a merkle leaf, an internal node or an activity id."
do_4 = "Add golden encoding vectors and a round-trip test proving that re-encoding any successfully decoded header reproduces the original bytes exactly."
do_5 = "Ship fuzz/fuzz_batch_header.c so the header decoder is total over arbitrary input and never allocates unbounded memory."
