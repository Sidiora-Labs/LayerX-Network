[task.8.2]
title = "Implement the module context capability surface"
status = "done"
wave = 4
requires = ["8.1"]
do_1 = "Provide namespaced state access through lxp_ctx_kv_get, lxp_ctx_kv_put, lxp_ctx_kv_del and lxp_ctx_kv_iter, with the kernel prefixing every key by module id so a module physically cannot address another module subtree."
do_2 = "Make lxp_ctx_emit_transfer_set the only monetary capability a module has, so every monetary effect compiles into one or more authenticated 402LXP transfers applied by the single kernel primitive."
do_3 = "Expose the deterministic environment as batch timestamp, epoch, global sequence, parameter read, gas charge and arena allocation, and nothing else."
do_4 = "Define no now function, no random function, no HTTP function and no set-balance function, so determinism and the no-direct-balance-write invariant are enforced by what does not exist."
do_5 = "Add a CI check asserting that no module translation unit links the ledger apply internals and that the account balance field is unreachable from the module ABI."
do_6 = "Test that a module attempting a balance write outside the transfer primitive aborts the transition with the balance bypass code, leaves every balance unchanged and emits no success receipt."
verify_cmd = "make test-module-ctx"
