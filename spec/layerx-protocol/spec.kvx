[task.7]
section = "Waves 3-4 — Identity, Authority and the Activity Kernel"
title = "Implement identity, keys, capabilities and delegated authority"
status = "pending"

[task.7.1]
title = "Implement DID identities, account derivation and sequence discipline"
status = "done"
wave = 3
requires = ["3.1","5.6","6.1"]
do_1 = "Add src/state/lxp_identity.c with lxp_identity carrying status, primary key, pending key, rotation timestamps, next sequence, revocation sequence, recovery root, recovery threshold and the optional EVM payout binding."
do_2 = "Derive the DID identifier as a domain-separated 32-byte commitment over the canonical encoding of the DID string, identical on every node and architecture and stable for the account lifetime."
do_3 = "Derive account identifiers for the namespaces agent main, agent budget, agent escrow and agent margin, and reject with the unknown namespace code any account outside the declared set."
do_4 = "Require account_sequence to equal next_sequence exactly, rejecting a lower value as a replay and a higher value as a gap, and never queueing a gap."
do_5 = "Consume the sequence exactly once by incrementing it on both the success and the failure path, so a failed activity cannot be replayed under the same sequence."
do_6 = "Reject any activity whose actor did does not resolve to an identity that is active or recovering and not frozen."
verify_cmd = "make test-identity"
symbols = ["lxp_identity","lxp_identity_register","lxp_did_id_derive","lxp_account_id_derive","lxp_identity_consume_sequence"]
touches = ["src/state/lxp_identity.c","include/layerx/lxp_identity.h","tests/state/lxp_test_identity.c"]
reqs = ["2.5","3.1","10.2","10.3","13.9"]

[task.7.2]
title = "Encode session keys and capability grants"
status = "done"
wave = 3
requires = ["2.3","7.1"]
do_1 = "Define lxp_authority_grant with grant id, grantor, grantee, kind, key, scope, not_before, not_after, grantor revocation sequence, revoked flag and grantor signature."
do_2 = "Define lxp_authority_scope with module mask, activity type ordinal range, asset, maximum per activity, maximum total, spent total, period length, maximum per period, spent this period, period start and purpose hash."
do_3 = "Require every session key to carry an explicit expiration, an explicit set of permitted activity types and an explicit revocation sequence, treating a key missing any bound as invalid."
do_4 = "Compute grant_id as the content hash of the canonical grant encoding so a grant is content-addressed and cannot be silently amended in place."
do_5 = "Reject a capability grant omitting the authorised holder, the asset, the maximum single amount, the total or recurring allowance, the expiration, the permitted purpose or the revocation sequence."
