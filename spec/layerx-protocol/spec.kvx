touches = ["src/protocol/lxp_fee.c","src/modules/governance/lxp_fee_params.c","tests/test_fees.c"]
reqs = ["26.1","26.4","7.4","13.1"]

[task.21.5]
title = "Meter execution and storage against fee_limit"
status = "done"
wave = 12
requires = ["21.4"]
do_1 = "Implement lxp_meter_ctx accumulating execution units and net state storage bytes for the activity currently executing on the single writer."
do_2 = "Implement lxp_meter_charge_exec and lxp_meter_charge_storage at every metered site, pricing storage growth at the storage rate parameter in force for that batch."
do_3 = "Implement lxp_meter_exhausted to abort with the deterministic resource exhaustion result code when either metered quantity exceeds its governance ceiling."
do_4 = "Reject any envelope lacking fee_limit or encoding it as a floating point or ambiguous numeric value, and require the actor spendable balance to be at least fee_limit at admission."
do_5 = "Reject with the arithmetic overflow result code rather than wrapping, saturating or truncating at any step of metering accumulation or treasury credit."
