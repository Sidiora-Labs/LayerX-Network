do_2 = "Implement lxp_withdrawal_nullifier as a domain-separated deterministic function of network_id, withdrawal_id, account, asset, amount and checkpoint_id, recorded identically on both ledgers."
do_3 = "Implement the Paxeer claim path to require a balance or membership proof against a finalised checkpoint state root plus threshold guarantor signatures, and to reject an already-recorded nullifier before doing any other work."
do_4 = "Implement lxp_paxeer_challenge_window to hold payouts while the window is open and to cancel payouts and slash attesting guarantors when a fraud, availability or equivocation challenge succeeds."
do_5 = "Implement lxp_bridge_withdraw_finalize to retire the withdrawal against the reserve mirror exactly once per nullifier."
do_6 = "Test double payment attempts by resubmission, by an alternative inclusion proof, by a later checkpoint and after a settlement-chain reorganisation."
