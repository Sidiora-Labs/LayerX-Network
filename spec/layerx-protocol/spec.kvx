# spec.kvx - LayerX Protocol. SINGLE SOURCE OF TRUTH for this feature.
#
# requirements.md / design.md / tasks.md next to this file are GENERATED from it
# by `cg spec render` (or spec/specgen). Never hand-edit those; edit this file.
#
# Drive the work with:  cg spec next -> cg spec start <id> -> cg spec done <id>
# Provenance for every statement here: docs/00-source-brief.md

[meta]
feature      = "layerx-protocol"
title        = "LayerX Protocol - Canonical Activity, Execution and Accounting Layer"
kind         = "protocol-specification"
version      = "1.0.0"
status       = "draft"
language     = "C17"
repo_root    = "."
reference    = "legacy Go implementation (external, read-only behavioural reference)"
intro        = "LayerX is the canonical activity, execution and accounting layer for autonomous agents. Paxeer provides custody, checkpoint finality, economic guarantees and dispute settlement, but never processes ordinary agent activity. An ordinary LayerX action never requires a Paxeer transaction: millions of activities collapse into one periodic checkpoint. Within LayerX, 402LXP is the single financial doorway. Every monetary effect in the system compiles into one or more authenticated balance transfers through one internal primitive, and no module may write a balance directly. These requirements are normative; the design and the task plan beside them are compiled from this file."

# Decisions locked before implementation begins. These supersede any ambiguity
# in docs/00-source-brief.md.
[decision]
language          = "C17 reference implementation. No C-plus-plus, C-sharp, Go, Rust or JavaScript in the protocol runtime."
repo_root         = "The implementation lives in this repository so spec and code share one Codify graph. This supersedes the brief proposal of a separate implementation directory."
legacy_reference  = "The external legacy Go implementation stays untouched and read-only. It is a behavioural reference, never translated file by file."
wire              = "Canonical binary protocol. The JSON and HTTP gateway is optional and never defines consensus behaviour."
sequencing        = "One active sequencer initially, with a bonded quorum of independent Paxeer guarantors that each fully replay every batch before attesting."
authority_of_log  = "The append-only activity log is the authority. SQLite indexes and materialised state are rebuildable projections."
modules           = "Payments, escrow, budgets, streams, services and perps are protocol modules over a minimal kernel. Crossverse is an oracle adapter outside the kernel."
paxeer_scope      = "Paxeer is used only for custody, checkpoint registration, guarantees, disputes and exits."
activity_scope_v1 = "Version 1 covers the COMPLETE agent work lifecycle, not only economically meaningful actions. Task commitments, tool execution attestations, deliveries, acceptances and disputes are first-class ordered and attested activities in the service module, carrying no direct monetary effect. Any value they imply still moves through 402LXP. This resolves the open scope question at the end of the brief."
guarantee_honesty = "Threshold guarantor attestation is NOT a validity proof. It is an economic guarantee backed by bonds and slashing for equivocation. Validity proofs can be added later without changing the activity protocol."

[design]
include = "design.body.md"

[tasks]
heading          = "Implementation Plan: LayerX Protocol"
overview_include = "tasks.overview.md"
notes_include    = "tasks.notes.md"

# --------------------------------------------------------------------------
# REQUIREMENTS
# --------------------------------------------------------------------------

[req.1]
title = "Division of Responsibility Between LayerX and Paxeer"
story = "As an autonomous agent operator, I want LayerX to own every ordinary agent activity while Paxeer owns only custody, checkpoint finality, economic guarantees and dispute settlement, so that my agents can act millions of times without ever originating, paying for or waiting on a Paxeer transaction."
ac_1 = "WHEN an agent submits any ordinary LayerX activity, including an identity or authority update, a 402LXP transfer, an escrow, budget or stream operation, a service lifecycle action, a perps order, or an oracle observation, THE protocol SHALL admit, order, execute, receipt and serve that activity entirely inside LayerX and SHALL NOT require, originate or await any Paxeer transaction as a precondition of its execution or of its receipt becoming available."
ac_2 = "WHEN a checkpoint epoch closes THE protocol SHALL collapse every activity accepted in that epoch, regardless of count, into exactly one Paxeer checkpoint registration carrying only the header commitments protocol_version, network_id, epoch, batch_number, first_sequence, last_sequence, previous_state_root, resulting_state_root, activity_merkle_root, receipt_merkle_root, event_merkle_root, data_availability_root, oracle_root, timestamp and sequencer_id, and SHALL NOT transmit individual activity envelopes, payloads or receipts to Paxeer."
ac_3 = "THE protocol SHALL confine every Paxeer contract input to a finalized checkpoint certificate, a membership or balance proof evaluated against a registered checkpoint state root, a withdrawal nullifier, guarantor signatures and bonds, challenge-window state, and emergency-exit eligibility, and SHALL define no other contract-visible input."
ac_4 = "IF a Paxeer contract interface would require the contract to interpret a perps order, a market or funding rule, a service agreement, a delivery or acceptance, an escrow or budget rule, or an ordinary agent-to-agent transfer, THEN THE protocol SHALL treat that interface as non-conformant and SHALL NOT define, deploy or depend on it."
ac_5 = "THE protocol SHALL assign to LayerX exclusive authority over agent identities and delegated authority, activity ordering, balances and payments, holds, escrow, budgets, subscriptions and streaming payments, service agreements, deliveries and attestations, trading, positions, funding and liquidation, deterministic state execution, receipts and inclusion proofs, data availability, replay and state reconstruction, sequencer operation, and fees and resource metering."
ac_6 = "THE protocol SHALL assign to Paxeer exclusive authority over asset custody, deposits and withdrawals, LayerX checkpoint registration, guarantor bonds, checkpoint attestations, slashing for conflicting attestations, emergency exits, dispute resolution, and final settlement between LayerX and external assets."
ac_7 = "WHEN a deposit is presented for credit inside LayerX THE protocol SHALL credit the agent only after the deposit is proven against finalized Paxeer custody state, SHALL perform the credit as a 402LXP transfer from the account system:paxeer-reserve to the agent main account, and SHALL reject any deposit credit that lacks such proof or that reuses a deposit identifier already credited."
ac_8 = "WHEN a withdrawal is requested THE protocol SHALL first execute a 402LXP transfer from the agent account to the account system:paxeer-withdrawals, SHALL make the funds payable on Paxeer only after a finalized checkpoint whose state root covers that transfer, and SHALL make the withdrawal payable at most once by consuming a unique withdrawal nullifier, so that a second presentation of the same withdrawal is rejected."
ac_9 = "IF Paxeer is unreachable, congested, or has registered no checkpoint for longer than the configured checkpoint interval, THEN THE protocol SHALL continue to admit, order, execute and receipt ordinary activities without interruption and SHALL suspend only checkpoint registration, withdrawal payout on Paxeer, and dispute or emergency-exit finalisation."
ac_10 = "WHERE the LayerX sequencer refuses service, censors an agent, or becomes unavailable, THE protocol SHALL allow that agent to recover its custodied balance directly on Paxeer through the emergency-exit path using a balance proof against the most recently finalized checkpoint state root, without any cooperation from the sequencer."

[req.2]
title = "Canonical Activity Envelope and Activity Receipt"
story = "As an autonomous agent operator, I want every action to be expressed as one fully specified, self-authenticating activity envelope and answered with a protocol-computed receipt, so that outcomes are verifiable evidence rather than values my client or any intermediary asserted."
ac_1 = "WHEN an activity is submitted THE protocol SHALL require the envelope to carry exactly the fields protocol_version, network_id, activity_type, actor_did, authority, account_sequence, timestamp_bound, idempotency_key, fee_limit, payload_hash, payload and signature, and SHALL reject with a malformed-envelope result code any submission that omits a field, repeats a field, or carries an undeclared field."
ac_2 = "IF protocol_version is unsupported by the executing transition version, or network_id does not equal the network identifier of the executing chain, THEN THE protocol SHALL reject the activity, SHALL NOT consume account_sequence, SHALL NOT charge a fee, and SHALL make an envelope valid on one network permanently invalid on every other network."
ac_3 = "IF payload_hash is not byte-equal to the domain-separated hash of the canonical binary encoding of payload, THEN THE protocol SHALL reject the activity with a payload-binding result code before evaluating authority, and SHALL NOT consume account_sequence, charge a fee, or apply any state effect."
ac_4 = "WHEN verifying an activity THE protocol SHALL verify signature over the domain-separated canonical binary encoding of every envelope field except signature itself, SHALL reject any activity whose signature does not verify under a key that the state machine currently binds to authority, and SHALL perform this verification on the canonical bytes rather than on any re-serialized or gateway representation."
ac_5 = "WHEN an activity is accepted THE protocol SHALL require account_sequence to equal exactly the next expected sequence of actor_did, SHALL consume that sequence exactly once, SHALL reject a lower sequence as a replay and a higher sequence as a gap, and SHALL NOT allow any two distinct accepted activities to consume the same account sequence."
ac_6 = "IF the batch timestamp under which an activity would execute lies outside the interval expressed by timestamp_bound, THEN THE protocol SHALL reject the activity as expired or not-yet-valid, and SHALL make that rejection identical on every node because the comparison uses only the batch-supplied timestamp."
ac_7 = "WHEN two activities from the same actor_did carry the same idempotency_key THE protocol SHALL produce at most one economic result, SHALL return the receipt of the first accepted activity in answer to the later submission, and SHALL NOT apply the state transition a second time even if the later submission differs in payload."
ac_8 = "IF the metered fee computed for an activity exceeds fee_limit, THEN THE protocol SHALL reject the activity without applying its effects, and in every accepted case THE protocol SHALL set fee_charged to the computed fee and SHALL guarantee fee_charged is never greater than fee_limit."
ac_9 = "WHEN an activity is executed THE protocol SHALL emit an ActivityReceipt carrying activity_id, global_sequence, previous_state_root, resulting_state_root, activity_root, result_code, effects, fee_charged, batch_id and sequencer_signature, SHALL compute every one of those values itself from the resulting state, and SHALL ignore and reject any client-supplied assertion of a result, an effect, a resulting balance or a state root."
ac_10 = "IF any consensus-critical field in an activity, payload, receipt or batch header is encoded as a floating-point value, a platform-dependent or endianness-dependent value, or a number that cannot be decoded to an exact fixed-width integer, THEN THE protocol SHALL reject that encoding with a decode error and SHALL never coerce, round or approximate it."

[req.3]
title = "Identity, Keys and Delegated Authority"
story = "As an autonomous agent operator, I want DID-native accounts with rotatable session keys, scoped capability grants and enforceable delegated limits evaluated inside the state machine, so that I can safely lend narrow spending and trading power to sub-agents and revoke it with protocol-level certainty."
ac_1 = "THE protocol SHALL use the agent DID as the native account identity, SHALL derive every account address from that DID under the namespaces agent:did:main, agent:did:budget:id, agent:did:escrow:id and agent:did:margin:position, and SHALL reject any activity whose actor_did is not a registered identity in current state."
ac_2 = "WHEN an identity is created THE protocol SHALL bind exactly one primary key and SHALL permit any number of session keys, each carrying an explicit expiration, an explicit set of permitted activity types, and an explicit revocation sequence, and SHALL treat a session key that omits any of those bounds as invalid."
ac_3 = "WHEN an activity presents a capability grant as its authority THE protocol SHALL require the grant to specify the authorized holder, the asset, the maximum single amount, the total or recurring allowance, the expiration, the permitted purpose, the optional service or invoice identifier, and the revocation sequence, and SHALL reject the activity if the requested action exceeds any one of those bounds."
ac_4 = "WHILE a delegated spending or trading limit is in force THE protocol SHALL accumulate consumption against that limit inside state at execution time, SHALL reject the first activity that would carry cumulative consumption past the limit, and SHALL NOT permit concurrent or reordered submissions to exceed the limit in aggregate."
ac_5 = "WHEN a revocation of a session key or capability grant is executed at a given global sequence THE protocol SHALL reject every subsequent activity authorized by that key or grant, SHALL apply the revocation to activities already submitted but not yet executed, and SHALL NOT retroactively invalidate activities already executed before that sequence."
ac_6 = "IF the batch timestamp is at or after the expiration of the presented session key, capability grant, payer grant or allowance, THEN THE protocol SHALL reject the activity with an expired-authority result code, evaluated solely against the batch-supplied timestamp."
ac_7 = "IF the presented authority does not explicitly name the activity_type being executed, or names a broader scope than the module declares for that activity type, THEN THE protocol SHALL reject the activity with an out-of-scope-authority result code, and THE protocol SHALL never treat possession of a key as implying authority over an unnamed action."
ac_8 = "WHEN a primary key rotation or account recovery is requested THE protocol SHALL require authorisation from the current primary key or from a pre-registered recovery authority, SHALL apply the change only after the configured challenge delay measured in batch timestamps has elapsed, SHALL invalidate the superseded key for every activity executed at or after the effective sequence, and SHALL reject a competing rotation submitted during an open challenge delay."
ac_9 = "WHERE an agent binds an optional EVM payout address THE protocol SHALL require a signature from the EVM key over a domain-separated binding statement naming the DID and network_id, SHALL record the binding in state, and SHALL grant that address no authority to move, debit or authorise any LayerX balance."
ac_10 = "THE protocol SHALL evaluate every authorisation decision inside the deterministic state machine as part of the transition, SHALL NOT consult HTTP session state, gateway authentication, in-memory challenges or any transport-layer credential during execution, and SHALL produce the identical authorisation result code on every node for the identical activity even when the submitting gateway accepted the request."

[req.4]
title = "Activity Kernel and the Module Boundary"
story = "As an autonomous agent operator, I want a minimal kernel that understands only universal concepts, with payments, markets and service coordination built as isolated versioned modules above it, so that new business capability can ship without ever changing the law that governs balances and ordering."
ac_1 = "THE protocol SHALL restrict the kernel to identities, accounts, assets, authority, nonces and sequences, fees, state transitions, events, receipts, checkpoints and modules, and SHALL define no payment product, market rule, service workflow or oracle semantic inside the kernel."
ac_2 = "THE protocol SHALL implement payments, escrow, budgets, streams, service coordination, perpetual markets, governance and Paxeer bridging as the registered modules asset, escrow, budget, stream, service, perps, governance and bridge, each built on the kernel and none of them privileged above the kernel rules."
ac_3 = "WHEN a module is registered, whether at genesis or by a governance activity, THE protocol SHALL record its module identifier, its version and the exhaustive list of activity types it declares, and SHALL reject with an unknown-activity result code any activity whose activity_type is not declared by a currently registered module."
ac_4 = "THE protocol SHALL confine every module to writing only state under its own module namespace, SHALL require every monetary effect a module produces to be expressed as one or more authenticated 402LXP transfers applied by the kernel transfer primitive, and SHALL make a direct balance write by any module impossible rather than merely discouraged."
ac_5 = "THE protocol SHALL treat Crossverse strictly as an oracle and data adapter consumed by the perps module, SHALL admit external observations only as signed oracle activities that are ordered like any other activity, SHALL make the exact accepted oracle payload part of replayable history and part of oracle_root, and SHALL NOT permit the kernel or any module to contact Crossverse or any external data source during transition evaluation."
ac_6 = "WHEN a module version changes by governance activity THE protocol SHALL apply the new version only from a declared epoch boundary onward, SHALL record in each receipt the module version under which the activity executed, and SHALL replay each historical activity under its recorded version so that replay of old history is unaffected by later upgrades."
ac_7 = "WHEN a single logical operation spans multiple modules or multiple balance legs THE protocol SHALL execute it as one atomic transfer set with a single authorisation context, a single execution sequence and a single receipt, and SHALL roll back every leg and every module write if any leg violates an invariant."
ac_8 = "IF a module transition returns a failure result code or violates an invariant, THEN THE protocol SHALL discard all state writes attempted by that activity, SHALL leave every other module unchanged, SHALL still consume account_sequence and charge the metered fee for an otherwise well-formed and authorised activity, and SHALL emit a receipt bearing the failure result code."
ac_9 = "THE protocol SHALL express governance parameter changes and emergency controls as ordinary governance-module activities subject to the same envelope, authority, ordering, fee and receipt rules as any other activity, and SHALL provide no operator path that mutates state outside the ordered activity log."
ac_10 = "WHEN an activity is accepted THE protocol SHALL emit its events only through the kernel event stream, SHALL commit those events in event_merkle_root for the batch, and SHALL provide no module-private or process-local channel by which an effect can become externally observable without appearing in that commitment."

[req.5]
title = "Deterministic Execution"
story = "As an autonomous agent operator, I want any node on any machine to reproduce byte-identical state from the identical activity history, so that I can independently verify every balance and receipt rather than trusting the sequencer."
ac_1 = "WHEN two nodes execute the identical genesis manifest and the identical ordered activity history THE protocol SHALL produce byte-identical state roots, receipts, events and batch headers on every operating system, CPU architecture, endianness, compiler and optimisation level."
ac_2 = "THE protocol SHALL perform every consensus-critical computation in integer-only checked fixed-width arithmetic, including the 128-bit and 256-bit widths required by perps and fee arithmetic, and SHALL treat the presence of any floating-point operation in a transition path as a conformance failure."
ac_3 = "IF any arithmetic operation inside a transition would overflow, underflow, or divide by zero, THEN THE protocol SHALL fail that activity with an explicit arithmetic result code and roll back the entire activity, and SHALL NOT silently wrap, saturate, truncate or invoke undefined behaviour."
ac_4 = "WHEN a transition iterates a map, a set, or any collection of accounts, orders, positions, grants or effects THE protocol SHALL iterate in canonical byte-lexicographic key order, and SHALL NOT allow iteration order to depend on hash seeds, pointer addresses, memory layout, allocation order or insertion order."
ac_5 = "WHEN a computation requires rounding THE protocol SHALL apply the single specified rounding rule for that computation identically on every node, SHALL never let rounding create or destroy value, and SHALL guarantee that for every asset the sum of debits equals the sum of credits in every executed transfer set."
ac_6 = "WHEN a batch is executed or replayed THE protocol SHALL select the transition function version recorded for that batch rather than the newest available version, and SHALL make replay of the entire history from genesis reproduce every historical state root exactly after any subsequent protocol upgrade."
ac_7 = "THE protocol SHALL supply time to execution only as the batch header timestamp, SHALL require batch timestamps to be monotonically non-decreasing, and SHALL NOT read a wall clock, a monotonic clock, a timezone, a locale, or any scheduler timing during transition evaluation."
ac_8 = "THE protocol SHALL NOT read operating-system state during transition evaluation, including environment variables, filesystem enumeration, process or thread identifiers, uninitialised memory, or non-deterministic entropy sources, SHALL NOT perform any external network or HTTP call during transition evaluation, and SHALL derive any required unpredictability solely from values already committed in state."
ac_9 = "THE protocol SHALL apply state transitions from exactly one deterministic writer processing activities in strict global_sequence order, SHALL confine worker threads to signature verification, networking, indexing and other non-consensus work, and SHALL reduce the results of any parallel work into the single writer in a fixed deterministic order so that thread scheduling cannot alter outcomes."
ac_10 = "IF a node crashes at any write boundary, THEN on restart THE protocol SHALL resume from the last durably committed global_sequence with no partially applied activity and no duplicated effect, and SHALL reproduce from that point the identical resulting_state_root that an uninterrupted node produced."

[req.6]
title = "Canonical Binary Wire Format"
story = "As an autonomous agent operator, I want exactly one legal byte encoding for every logical protocol value, so that signatures, identifiers and commitments are unambiguous and no gateway or alternate representation can change what the protocol agreed to."
ac_1 = "THE protocol SHALL define exactly one valid byte encoding for every logical value using a canonical CBOR profile or a purpose-built canonical binary codec, and SHALL guarantee that re-encoding any successfully decoded value reproduces the original bytes exactly."
ac_2 = "IF received bytes contain a non-minimal integer encoding, an indefinite-length item, a duplicate map key, map keys not in canonical order, unused padding, or trailing bytes after the terminal item, THEN THE protocol SHALL reject the message with a non-canonical-encoding result code before evaluating authority, and SHALL NOT consume a sequence or charge a fee."
ac_3 = "THE protocol SHALL declare an explicit maximum length for every variable-length element, including the maximum activity size, payload size, DID length, authority chain depth, transfer-set leg count, effect count and batch activity count, and SHALL reject any message exceeding a declared limit rather than allocating to accommodate it."
ac_4 = "WHEN computing any hash THE protocol SHALL prefix the input with a distinct domain tag per purpose, covering at least activity_id, payload_hash, signature preimages, authorization_hash, context_hash, merkle leaves, merkle internal nodes, batch headers and checkpoint certificates, and SHALL guarantee that identical bytes hashed under two different domains yield different digests."
ac_5 = "WHEN constructing any merkle tree THE protocol SHALL hash leaves and internal nodes under different domain tags, SHALL specify a single deterministic rule for trees whose leaf count is not a power of two, and SHALL reject any proof that relies on reinterpreting an internal node as a leaf."
ac_6 = "IF a message carries an unknown protocol_version, an unknown activity_type, or an unknown field identifier in a consensus-critical structure, THEN THE protocol SHALL reject it deterministically with an unsupported-version or unknown-field result code, and SHALL NOT skip, ignore or best-effort interpret the unrecognised content."
ac_7 = "WHERE an optional JSON or HTTP gateway is deployed THE protocol SHALL treat it purely as a translation and transport surface that converts to canonical bytes before signature verification, SHALL decide consensus solely on those canonical bytes, and SHALL reject any submission whose JSON representation does not translate to exactly the bytes the signature covers."
ac_8 = "THE protocol SHALL verify Ed25519 signatures for agent identity and secp256k1 signatures for Paxeer-facing certificates over the domain-separated canonical byte string of the signed structure, SHALL reject signatures verified over any re-serialized, JSON or textual rendering, and SHALL reject non-canonical signature encodings such as high-order or malleable scalar forms."
ac_9 = "THE protocol SHALL guarantee that no two distinct byte strings decode to the same logical activity, SHALL define activity_id as the domain-separated hash of the canonical activity bytes, and SHALL therefore make any alteration of the encoding produce a different activity_id rather than a second valid form of the same activity."
ac_10 = "WHEN an independent implementation is run against the published conformance vectors THE protocol SHALL require it to reproduce byte-identical encodings, byte-identical digests and merkle roots, and identical rejection result codes for every malformed and non-canonical vector, in order to be considered conformant."

[req.7]
title = "402LXP as the Single Financial Gateway"
story = "As an autonomous agent operator, I want every monetary effect in LayerX to compile into one or more authenticated 402LXP balance transfers applied by a single balance-mutation primitive, so that there is exactly one financial doorway, one execution law and one auditable balance-transition model for the entire protocol."
ac_1 = "WHEN any protocol module (asset, escrow, budget, stream, service, perps, governance or bridge) produces a monetary effect THE protocol SHALL express that effect as one or more authenticated 402LXP transfers and SHALL apply them exclusively through the single internal balance-mutation primitive, in its single-transfer or atomic transfer-set form."
ac_2 = "IF a state transition attempts to change any account balance by any path other than the single internal balance-mutation primitive THEN THE protocol SHALL abort the transition with result code ERR_BALANCE_BYPASS, SHALL leave every balance unchanged, and SHALL NOT emit a success receipt."
ac_3 = "WHEN a node persists state THE protocol SHALL treat the append-only activity log and the 402LXP transfers recorded in it as the sole authority for balances, and SHALL forbid any direct database balance update, so that a SQLite index rebuilt purely by replaying the log reproduces every balance byte-for-byte."
ac_4 = "WHEN a payment-shaped action occurs THE protocol SHALL compile it into these exact legs: agent payment as payer main to payee main; service purchase as buyer main to provider main; refund as merchant main or escrow subaccount to buyer main; protocol fee as actor account to system fees."
ac_5 = "WHEN a custody-shaped action occurs THE protocol SHALL compile it into these exact legs: open escrow as owner main to owner escrow subaccount; capture escrow as owner escrow subaccount to provider main; release escrow as owner escrow subaccount to owner main; create budget as owner main to owner budget subaccount; spend budget as owner budget subaccount to recipient; stream payment as payer stream account to recipient."
ac_6 = "WHEN a Paxeer-facing action occurs THE protocol SHALL compile it into these exact legs: deposit as system Paxeer reserve mirror to agent main; withdrawal as agent main to system Paxeer withdrawals."
ac_7 = "WHEN a perps-module action occurs THE protocol SHALL compile it into these exact legs: perps margin as agent main to agent margin subaccount for the position; release margin as agent margin subaccount to agent main; trading loss as position margin subaccount to system liquidity for the market; trading profit as system liquidity for the market to agent main; funding payment as long funding account to short funding account; liquidation fee as position margin subaccount to liquidator main or system insurance; insurance payout as system insurance to the deficit account."
ac_8 = "WHERE a module holds non-monetary state such as an order, a service agreement, a task commitment, a tool execution attestation, a delivery, an acceptance, a dispute or a position, THE protocol SHALL allow that state to be created, ordered and attested with no direct monetary effect, and SHALL require any value movement it implies to execute as a separate authenticated 402LXP transfer."
ac_9 = "IF an activity payload carries a client-supplied resulting balance, new balance, or balance delta for any account THEN THE protocol SHALL reject the activity with result code ERR_CLIENT_SUPPLIED_BALANCE, because the protocol alone computes resulting balances."
ac_10 = "WHERE a new protocol module is introduced by a versioned transition function, THE protocol SHALL grant it monetary capability only as a protocol-module capability that authorises 402LXP transfers, and SHALL NOT expose any additional balance-mutation entry point, so that the count of balance-mutation primitives remains exactly one across all protocol versions."

[req.8]
title = "The SEND Operation"
story = "As an autonomous agent operator, I want SEND to push value from an account I control under an explicit, bounded and replay-proof authorisation, so that every debit of my agent is provably authorised, exactly-once, and impossible to forge, expire past, or overflow."
ac_1 = "WHEN a SEND activity is submitted THE protocol SHALL require the canonically encoded fields from, to, asset, amount, sequence, idempotency_key, expires_at, context_hash, conditions and authorization, and SHALL reject with result code ERR_MALFORMED_SEND any activity that omits a field, adds an unknown field, or is not canonically encoded."
ac_2 = "WHEN the protocol evaluates the authorization field THE protocol SHALL accept exactly one of six authorisation kinds, namely an owner direct signature, a session key, a delegated capability, a budget allowance, an escrow authority, or a protocol-module capability, and SHALL reject any other authorisation kind with result code ERR_UNKNOWN_AUTHORITY_KIND."
ac_3 = "IF the presented authorization does not control the from account, or is expired, revoked, key-rotated out, outside its declared spending or trading scope, or bound to a different network_id or protocol_version THEN THE protocol SHALL reject the SEND with result code ERR_UNAUTHORIZED_DEBIT and SHALL change no balance and consume no sequence."
ac_4 = "WHEN the protocol validates sequence THE protocol SHALL require it to be exactly equal to the next expected sequence of the account that the authorization controls, SHALL reject any lower or higher value with result code ERR_SEQUENCE_MISMATCH, and on success SHALL consume that sequence exactly once so that a byte-identical resubmission is rejected as a replay."
ac_5 = "IF the deterministic timestamp supplied by the batch containing the SEND is strictly greater than expires_at THEN THE protocol SHALL reject the SEND with result code ERR_EXPIRED, SHALL NOT apply it in any later batch, and SHALL NOT consume the sequence."
ac_6 = "IF amount is zero or not strictly greater than zero, or if the available balance of the from account in the named asset is strictly less than amount, THEN THE protocol SHALL reject the SEND with result code ERR_INVALID_AMOUNT or ERR_INSUFFICIENT_BALANCE respectively, and SHALL leave the from and to balances exactly as they were."
ac_7 = "IF the asset held by the from account and the asset credited to the to account are not the identical asset identifier, or the named asset is unknown to the protocol, THEN THE protocol SHALL reject the SEND with result code ERR_ASSET_MISMATCH."
ac_8 = "WHEN the protocol computes the debit and the credit THE protocol SHALL use checked fixed-width integer arithmetic with no floating-point values, SHALL reject with result code ERR_ARITHMETIC_OVERFLOW rather than wrapping if any subtraction would go below zero or any addition would exceed the asset maximum, and SHALL guarantee that the sum of all balance changes produced by the SEND is exactly zero for the named asset."
ac_9 = "WHEN the authorization is verified THE protocol SHALL require context_hash and conditions to be covered by the signed authorisation bytes, SHALL reject with result code ERR_CONTEXT_MISMATCH if the submitted context_hash differs from the one that was signed, and SHALL reject with result code ERR_CONDITION_UNMET if any declared condition does not hold at the deterministic execution timestamp."
ac_10 = "WHEN two SEND activities carry the same idempotency_key for the same authorising account THE protocol SHALL produce at most one economic result, SHALL return the receipt of the first accepted execution to every subsequent submission, and SHALL NOT apply a second transfer even if the later submission differs in amount, recipient or fee_limit."

[req.9]
title = "The RECEIVE Operation and Payer Grants"
story = "As an autonomous agent operator, I want a service to be able to pull payment from my account only inside a grant I previously signed, so that a recipient can collect what I owe without ever being able to debit an arbitrary account or exceed the limit, purpose, window or lifetime I authorised."
ac_1 = "WHEN a RECEIVE activity is submitted THE protocol SHALL require the canonically encoded fields from, to, asset, amount, grant_id, receiver_sequence, idempotency_key, context_hash, receiver_authorization and payer_grant, and SHALL reject with result code ERR_MALFORMED_RECEIVE any activity that omits a field or is not canonically encoded."
ac_2 = "IF a RECEIVE names a from account for which no valid, unexpired, unrevoked payer grant signed by an authority controlling that account and naming the submitting recipient exists THEN THE protocol SHALL reject with result code ERR_NO_PAYER_GRANT, so that a recipient can never debit an arbitrary account."
ac_3 = "WHEN the protocol validates a payer grant THE protocol SHALL require it to specify the authorised recipient, the asset, the maximum amount, whether the allowance is total or recurring together with the recurring window length, the expiration, the permitted purpose, an optional service or invoice identifier, and the revocation sequence, and SHALL reject with result code ERR_MALFORMED_GRANT any grant missing a required element."
ac_4 = "IF the submitting recipient is not the authorised recipient named in the grant, or the RECEIVE asset differs from the grant asset, or amount exceeds the grant maximum amount, or the from and to accounts do not match the grant, THEN THE protocol SHALL reject the RECEIVE with result code ERR_GRANT_SCOPE_VIOLATION and SHALL debit nothing."
ac_5 = "WHILE a grant declares a total allowance THE protocol SHALL track the cumulative amount already drawn under that grant_id and SHALL reject with result code ERR_GRANT_EXHAUSTED any RECEIVE whose amount would make the cumulative drawn total exceed the allowance, including the case where several RECEIVE activities are ordered in the same batch."
ac_6 = "WHILE a grant declares a recurring allowance THE protocol SHALL reset the remaining allowance to the full recurring amount at the deterministic start of each window, SHALL NOT carry unused allowance forward into the next window, and SHALL reject with result code ERR_GRANT_EXHAUSTED any RECEIVE exceeding the remaining allowance of the current window."
ac_7 = "IF the deterministic timestamp of the batch containing the RECEIVE is strictly greater than the grant expiration THEN THE protocol SHALL reject the RECEIVE with result code ERR_GRANT_EXPIRED, and SHALL treat any remaining allowance as permanently unusable."
ac_8 = "WHEN the payer submits a revocation whose revocation sequence is greater than or equal to the revocation sequence of a grant THE protocol SHALL make that grant unusable from the global sequence of the revocation onward, SHALL reject every later-ordered RECEIVE against it with result code ERR_GRANT_REVOKED, and SHALL leave already-executed transfers ordered before the revocation intact."
ac_9 = "IF the RECEIVE context_hash does not commit to the permitted purpose of the grant, or the grant names a service or invoice identifier and the RECEIVE does not reference that identifier, or that invoice identifier has already been settled, THEN THE protocol SHALL reject with result code ERR_PURPOSE_MISMATCH or ERR_INVOICE_ALREADY_SETTLED and SHALL move no value."
ac_10 = "WHEN a RECEIVE passes all grant checks THE protocol SHALL execute the identical internal transfer function used by SEND under the identical invariant checks, SHALL consume receiver_sequence exactly once, SHALL enforce that idempotency_key produces at most one economic result, and SHALL emit a receipt that differs from a SEND receipt only in the operation field and the authorisation evidence."

[req.10]
title = "Accounts and Subaccounts"
story = "As an autonomous agent operator, I want every locked, escrowed, budgeted and margined unit to sit in a real named account rather than a hidden balance column, so that I can trace every unit of value through one ledger and reconcile it against Paxeer custody."
ac_1 = "WHEN the protocol immobilises value for escrow, a budget, a stream, position margin, fees, liquidity, insurance or a Paxeer flow THE protocol SHALL represent that value as the balance of a real account reached by a 402LXP transfer, and SHALL NOT represent it as a reserved, held, locked or pending field attached to another account."
ac_2 = "WHEN the protocol derives an account name THE protocol SHALL accept exactly the namespace agent:<did>:main, agent:<did>:budget:<id>, agent:<did>:escrow:<id>, agent:<did>:margin:<position>, system:liquidity:<market>, system:insurance, system:fees, system:paxeer-reserve and system:paxeer-withdrawals, and SHALL reject with result code ERR_UNKNOWN_ACCOUNT_NAMESPACE any transfer leg naming an account outside that namespace."
ac_3 = "WHEN an account identifier is derived from its canonical namespace string THE protocol SHALL use a domain-separated commitment over the canonical binary encoding of that string, SHALL produce the identical identifier on every node, architecture and protocol implementation, and SHALL keep that identifier stable for the lifetime of the account."
ac_4 = "IF two distinct canonical namespace strings would derive the same account identifier, or an activity presents an account identifier that does not match the derivation of its declared namespace string, THEN THE protocol SHALL reject the activity with result code ERR_ACCOUNT_ID_MISMATCH."
ac_5 = "WHEN a transfer credits a namespace-valid account that does not yet exist THE protocol SHALL create it deterministically at that global sequence with a zero opening balance before applying the credit, and SHALL record its creation in the activity log so that replay recreates it identically."
ac_6 = "IF a request would close or delete an account whose balance in any asset is non-zero, or that is still referenced by an open escrow, budget, stream or position, THEN THE protocol SHALL reject the closure with result code ERR_ACCOUNT_NOT_EMPTY."
ac_7 = "WHEN an agent opens a perps position THE protocol SHALL physically move the margin as a 402LXP transfer from agent:<did>:main to agent:<did>:margin:<position>, SHALL treat the balance of that margin subaccount as the collateral of record for the position, and SHALL NOT satisfy the margin requirement by setting a reserved-margin field on the main account."
ac_8 = "WHEN a position is closed, settled or liquidated THE protocol SHALL drain the margin subaccount to zero through explicit 402LXP legs to the counterpart accounts, and SHALL reject any position closure that would leave residual value stranded in the margin subaccount."
ac_9 = "IF a debit is attempted from an agent budget, escrow, margin or stream subaccount using only an owner direct signature or a session key THEN THE protocol SHALL reject it with result code ERR_UNAUTHORIZED_DEBIT, because those subaccounts SHALL be debited only under the escrow authority, budget allowance or protocol-module capability that owns them."
ac_10 = "IF a debit is attempted against system:liquidity:<market>, system:insurance, system:fees, system:paxeer-reserve or system:paxeer-withdrawals without the protocol-module capability designated for that system account THEN THE protocol SHALL reject it with result code ERR_UNAUTHORIZED_DEBIT, and system accounts SHALL be created only by the genesis manifest or a governance activity."

[req.11]
title = "Atomic Transfer Sets and Conservation"
story = "As an autonomous agent operator, I want complex multi-leg operations such as liquidation to commit entirely or not at all under one authorisation and one receipt, so that no partially settled state, no invented value and no destroyed value can ever be observed on the ledger."
ac_1 = "WHEN a transfer set containing more than one leg is executed THE protocol SHALL either apply every leg or apply no leg, and SHALL NOT expose any intermediate state in which a proper subset of the legs has been applied to any reader, index, event stream or receipt."
ac_2 = "WHEN a transfer set is submitted THE protocol SHALL bind it to exactly one authorisation context, SHALL consume exactly one execution sequence for the authorising account, and SHALL emit exactly one receipt for the whole set rather than one receipt per leg."
ac_3 = "WHEN a position is liquidated THE protocol SHALL execute a single atomic transfer set whose legs are, in this order, position margin subaccount to system liquidity for the market, then position margin subaccount to the liquidation fee account, then system insurance to system liquidity for the market to cover any deficit, then remaining position margin subaccount to agent main."
ac_4 = "IF any leg of a transfer set violates any protocol invariant, including insufficient balance, asset mismatch, arithmetic overflow, unknown account namespace or missing authority, THEN THE protocol SHALL roll the entire set back, SHALL report the zero-based index and result code of the first failing leg, and SHALL NOT emit a success receipt for any leg."
ac_5 = "WHEN a transfer set is applied THE protocol SHALL enforce for every asset that the sum of debits equals the sum of credits within the set, and SHALL reject with result code ERR_CONSERVATION_VIOLATION any set whose net supply change for any asset is non-zero."
ac_6 = "WHEN a Paxeer deposit is credited THE protocol SHALL move value from system:paxeer-reserve to the agent main account as an ordinary conserving transfer set, so that the total LayerX supply of the asset is unchanged and remains equal to the value attested in Paxeer custody."
ac_7 = "WHEN a withdrawal is initiated THE protocol SHALL move value from the agent main account to system:paxeer-withdrawals as an ordinary conserving transfer set, and SHALL NOT reduce total LayerX supply until a finalized Paxeer settlement reference retires the withdrawal against system:paxeer-reserve."
ac_8 = "IF any module other than the bridge module operating under a finalized Paxeer proof attempts a transfer set that increases or decreases the total supply of an asset THEN THE protocol SHALL reject it with result code ERR_SUPPLY_MUTATION, because ordinary modules SHALL never mint or burn."
ac_9 = "WHEN a transfer set is executed THE protocol SHALL apply its legs in the exact declared order using checked integer arithmetic, and IF applying a leg in that order would drive any account balance below zero THEN THE protocol SHALL fail the entire set rather than reordering, netting or deferring legs."
ac_10 = "IF a node crashes at any write boundary while a transfer set is being applied THEN THE protocol SHALL, on restart and replay of the append-only activity log, converge to a state in which that set is either fully applied or entirely absent, with a state root identical to that of a node that never crashed."

[req.12]
title = "402LXP Receipts and Proofs"
story = "As an autonomous agent operator, I want every successful 402LXP operation to yield one durable receipt carrying protocol-computed before and after balances plus checkpoint proofs, so that any third party can verify the payment independently without trusting the sequencer or the service that was paid."
ac_1 = "WHEN a 402LXP operation succeeds THE protocol SHALL return a 402LXPReceipt containing protocol_version, transaction_id, operation, global_sequence, asset, amount, from, from_balance_before, from_balance_after, from_sequence, to, to_balance_before, to_balance_after, transfer_set_root, authorization_hash, context_hash, previous_state_root, resulting_state_root, batch_id, timestamp and sequencer_signature."
ac_2 = "WHEN the receipt records from_balance_before, from_balance_after, to_balance_before and to_balance_after THE protocol SHALL compute those values itself from the state it applied, and SHALL ignore or reject any client-submitted balance value, so that the before and after balances are evidence rather than client input."
ac_3 = "WHEN a single-leg operation is receipted THE protocol SHALL guarantee that from_balance_after equals from_balance_before minus amount and that to_balance_after equals to_balance_before plus amount for the named asset, and WHEN a multi-leg set is receipted THE protocol SHALL set transfer_set_root to a commitment over the canonical encoding of every leg in execution order."
ac_4 = "WHEN a receipt is issued THE protocol SHALL sign the canonical binary encoding of the receipt with the sequencer identity named in the batch header, and SHALL make that signature verifiable against the published sequencer key without any further interaction with the node."
ac_5 = "WHEN a receipt is issued THE protocol SHALL have already durably appended the corresponding activity and receipt to the append-only activity log, so that after any crash the same receipt is reproduced by replay and no acknowledged receipt is ever lost or altered."
ac_6 = "WHEN a caller queries by transaction_id, by idempotency_key or by global_sequence THE protocol SHALL return the identical receipt bytes that were originally issued, for as long as the corresponding history is retained."
ac_7 = "WHEN the batch containing a receipt is included in a checkpoint accepted by Paxeer THE protocol SHALL augment the retrievable receipt with activity_inclusion_proof, state_inclusion_proof, checkpoint_id, guarantor_certificate and paxeer_settlement_reference, without altering any pre-checkpoint field."
ac_8 = "WHEN a third party holds an augmented receipt THE protocol SHALL allow it to be verified independently by checking the sequencer signature, recomputing the activity merkle root from activity_inclusion_proof, verifying state_inclusion_proof against resulting_state_root, verifying that guarantor_certificate carries at least the configured guarantor threshold of valid bonded signatures over checkpoint_id, and matching paxeer_settlement_reference against the checkpoint registered on Paxeer."
ac_9 = "WHEN two submissions share an idempotency_key THE protocol SHALL return byte-identical receipt content for both, and SHALL maintain exactly one durable receipt per successful transfer or transfer set."
ac_10 = "IF an operation fails for any reason THEN THE protocol SHALL emit a failure result carrying the result code and the unchanged balances, SHALL NOT emit a signed 402LXPReceipt for it, and SHALL NOT include any balance change from it in any state root."

[req.13]
title = "Core Protocol Invariants"
story = "As an autonomous agent operator, I want the fourteen financial invariants of LayerX enforced at runtime on every state transition, so that a bug, a malicious module or a hostile activity aborts the transition instead of silently corrupting balances, receipts or checkpoints."
ac_1 = "WHILE any state transition is evaluated THE protocol SHALL enforce that every monetary mutation is a 402LXP transfer, and SHALL abort with ERR_INVARIANT_1 any transition that changes a balance outside a 402LXP transfer."
ac_2 = "WHILE any state transition is evaluated THE protocol SHALL enforce that every debit carries explicit authority resolvable to an owner signature, session key, delegated capability, budget allowance, escrow authority or protocol-module capability that controls the debited account, and SHALL abort with ERR_INVARIANT_2 otherwise."
ac_3 = "WHILE any state transition is evaluated THE protocol SHALL enforce that every RECEIVE is backed by a valid, unexpired, unrevoked and unexhausted payer grant naming the submitting recipient, and SHALL abort with ERR_INVARIANT_3 otherwise."
ac_4 = "WHILE any state transition is evaluated THE protocol SHALL enforce that no account balance in any asset becomes negative at any point, including intermediate points inside a transfer set, and SHALL abort with ERR_INVARIANT_4 otherwise."
ac_5 = "WHILE any state transition is evaluated THE protocol SHALL enforce that every normal transfer conserves supply so that for each asset the sum of debits equals the sum of credits, and SHALL abort with ERR_INVARIANT_5 otherwise."
ac_6 = "WHILE any state transition is evaluated THE protocol SHALL enforce that transfer sets are completely atomic, committing all legs or none, and SHALL abort with ERR_INVARIANT_6 rather than persisting a partially applied set."
ac_7 = "WHILE any state transition is evaluated THE protocol SHALL enforce that every successful transfer or transfer set yields exactly one durable receipt, and SHALL abort with ERR_INVARIANT_7 if zero receipts or more than one receipt would be produced."
ac_8 = "WHILE any state transition is evaluated THE protocol SHALL enforce that every idempotency key produces at most one economic result, and SHALL abort with ERR_INVARIANT_8 rather than applying a second economic effect under a key already settled."
ac_9 = "WHILE any state transition is evaluated THE protocol SHALL enforce that every account sequence is consumed exactly once, and SHALL abort with ERR_INVARIANT_9 on any reuse, gap or out-of-order consumption of an account sequence."
ac_10 = "WHILE any state transition is evaluated THE protocol SHALL enforce that no module writes balances directly and that all balance writes pass through the single balance-mutation primitive, and SHALL abort with ERR_INVARIANT_10 otherwise."
ac_11 = "WHILE any state transition is evaluated THE protocol SHALL enforce that external oracle data, including Crossverse prices, cannot directly alter a balance and may only be consumed as a signed oracle activity whose effects execute as authenticated 402LXP transfers, and SHALL abort with ERR_INVARIANT_11 otherwise."
ac_12 = "WHILE any state transition is evaluated THE protocol SHALL enforce that a Paxeer deposit credits a LayerX account only against a finalized custody proof, and SHALL abort with ERR_INVARIANT_12 on any deposit credit lacking such a proof."
ac_13 = "WHILE any state transition is evaluated THE protocol SHALL enforce that a Paxeer withdrawal pays at most once by consuming a unique withdrawal nullifier, and SHALL abort with ERR_INVARIANT_13 on any attempt to settle an already-consumed nullifier or to pay a withdrawal twice."
ac_14 = "WHILE history is replayed on any machine or architecture THE protocol SHALL enforce that replaying the same activity history produces identical balances, identical receipts and identical state roots, and SHALL abort with ERR_INVARIANT_14 at the first divergent global sequence rather than continuing."
ac_15 = "WHEN any activity, batch, transfer, transfer set, checkpoint application or replay step is executed THE protocol SHALL evaluate all fourteen invariants at runtime for that step, and SHALL NOT allow any build, configuration, governance parameter or emergency mode to disable an invariant check."
ac_16 = "IF any invariant check fails THEN THE protocol SHALL abort the entire state transition atomically leaving the previous state root intact, SHALL emit a violation record naming the invariant identifier, the offending global sequence and the offending account, SHALL NOT emit a success receipt, and SHALL halt the node rather than producing or attesting a divergent state root."

[req.14]
title = "Asset Module"
story = "As an autonomous agent operator, I want a fully reserved asset registry whose balances change only through authenticated 402LXP transfers, so that every unit I hold on LayerX is traceable, integer-exact and always reconcilable against Paxeer custody."
ac_1 = "WHEN an asset registration activity is accepted THE protocol SHALL record the asset id, symbol, name, decimals, supply cap, issuer identity, issuer kind, pause state and applicable Paxeer custody reference in the asset registry, and IF an asset with the same asset id already exists THEN THE protocol SHALL reject the activity with result code ASSET_ALREADY_REGISTERED and make no state change other than sequence and fee consumption."
ac_2 = "WHERE an amount appears in any accepted activity payload THE protocol SHALL interpret it as an unsigned fixed-width integer count of the smallest indivisible unit of the named asset, and SHALL reject with result code INVALID_AMOUNT any amount encoded as a decimal fraction, an exponent form or a floating point value, so that decimals are display metadata only and never participate in arithmetic."
ac_3 = "WHERE any module of the protocol produces a monetary effect THE protocol SHALL express that effect exclusively as one or more authenticated 402LXP transfers applied by the single balance mutation primitive, and SHALL reject with result code DIRECT_BALANCE_WRITE_FORBIDDEN any accepted activity or module effect that attempts to assign a balance value directly."
ac_4 = "IF a transfer leg would reduce a source account balance below zero THEN THE protocol SHALL reject the entire transfer or transfer set with result code INSUFFICIENT_FUNDS and SHALL leave every balance in the set exactly as it was before evaluation."
ac_5 = "IF crediting a destination account would exceed the maximum representable fixed-width balance THEN THE protocol SHALL reject the entire transfer or transfer set with result code BALANCE_OVERFLOW and SHALL never wrap, saturate or truncate the value."
ac_6 = "IF the asset of the source account differs from the asset of the destination account, or the transfer amount is zero, THEN THE protocol SHALL reject the transfer with result code ASSET_MISMATCH or INVALID_AMOUNT respectively and SHALL apply no leg of the enclosing transfer set."
ac_7 = "WHEN a deposit activity is processed THE protocol SHALL credit the named agent account only by executing a 402LXP transfer from the system Paxeer reserve mirror account to the agent main account, and only after verifying a finalised Paxeer custody proof bound to a finalised checkpoint; IF the proof is absent, unverifiable or references a checkpoint that is not yet finalised THEN THE protocol SHALL reject the deposit with result code DEPOSIT_PROOF_NOT_FINAL and credit nothing."
ac_8 = "IF a deposit activity presents a custody proof whose custody reference or deposit nullifier has already been consumed THEN THE protocol SHALL reject it with result code DEPOSIT_ALREADY_CREDITED, so that a replayed or resubmitted deposit proof produces at most one economic result for a given asset and custody reference."
ac_9 = "WHEN a withdrawal activity is accepted THE protocol SHALL debit the agent by executing a 402LXP transfer from the agent main account into the system Paxeer withdrawal account and SHALL record a unique withdrawal nullifier in the resulting state; IF a settlement or a further withdrawal activity presents an already recorded nullifier THEN THE protocol SHALL reject it with result code WITHDRAWAL_ALREADY_SETTLED so that no withdrawal can pay twice."
ac_10 = "WHILE a batch is being executed THE protocol SHALL enforce for every asset that the sum of debits equals the sum of credits across all legs. For Paxeer-custody assets, total circulating supply, defined as the sum of all agent, module and system account balances excluding the Paxeer reserve mirror and issuance account, never exceeds the custody amount attested by the most recent finalised Paxeer proof less the amount already settled out of the Paxeer withdrawal account. For native-issued assets, circulating supply is initial issuance units minus current issuance balance and SHALL NOT exceed a nonzero supply cap. IF reconciliation fails THEN THE protocol SHALL reject the offending activity and SHALL NOT produce a batch whose resulting state root violates the applicable supply invariant."

ac_11 = "Asset register (1), account_open (4), grant_revoke (8), mint (10) and burn (11) use big-endian version:u16=1 and reject unknown versions, truncation and trailing bytes. Register carries asset_id32, salt32, symbol_len:u8 and 1..16 ASCII bytes, name_len:u8 and 1..32 valid UTF-8 bytes, decimals:u8<=38, supply_cap:u128, issuer_kind:u8 (1 native, 2 paxeer_custody), custody_ref_len:u8 and at most 128 custody bytes. Native registration requires no custody reference and asset_id32 = SHA-256(LX:ASSET:v1 || actor_identity_id32 || salt32). Account_open carries asset_id32; grant_revoke carries grant_id32 and revocation_sequence:u64; mint and burn carry asset_id32, account_id32 and positive amount:u128. Receive (6) and grant_issue (7) reuse the existing receive and payer-grant canonical encodings. Opaque payloads are refused for these ordinals."
ac_12 = "Registration creates asset:<lowercase hex64 asset_id>:issuance as a module-value account with initial units equal to supply_cap, or u128 max when supply_cap is zero. Mint transfers issuance to destination under issuer authority; burn transfers an owned source to issuance. Total units are derived as initial issuance units minus current issuance balance and are not separately stored. The asset leaf commits the derivation inputs, issuer, name, decimals, cap and pause state. Conservation and the sole ledger writer remain unchanged. Authenticated receipts SHALL explicitly bind total_units before and after as well as both endpoint balances, using versioned canonical encoding and updated verifiers. Supply tampering SHALL be rejected; endpoint balances alone do not satisfy this requirement."
ac_13 = "Asset ordinals 1, 4, 6, 7, 8, 10 and 11 retain fee-parameter version 1: ceil((base_fee + per_activity_type_unit * complete_activity_type + per_encoded_byte * canonical_bytes + per_execution_unit * execution_units + per_storage_unit * storage_units) * multiplier_basis_points / 10000). Existing admission, replay and refusal policy applies unchanged. No new fee-parameter version or per-ordinal schedule is introduced; a per-ordinal schedule is a governance follow-up outside this branch."

[req.15]
title = "Escrow Module"
story = "As an autonomous agent operator, I want holds that physically move funds into an escrow subaccount with deterministic capture, release, expiry and dispute behaviour, so that counterparties can rely on funds being reserved and I can prove that escrowed value was never spendable from my main account."
ac_1 = "WHEN a hold creation activity is accepted THE protocol SHALL execute a 402LXP transfer of the exact hold amount from the owner main account to the escrow subaccount named for that hold identifier, and SHALL record the beneficiary, asset, amount, expiry timestamp and dispute window in escrow state; the hold SHALL have no monetary effect other than that transfer."
ac_2 = "WHILE a hold is active THE protocol SHALL keep the held funds in the escrow subaccount, so that any transfer attempting to source those funds from the owner main account is rejected with result code INSUFFICIENT_FUNDS, and SHALL reject with result code UNAUTHORIZED_ESCROW_SPEND any transfer out of the escrow subaccount that is not a capture, a release, an expiry release or a dispute resolution produced by the escrow module."
ac_3 = "WHEN an authorised capture activity for the full remaining hold amount is accepted THE protocol SHALL execute a 402LXP transfer of that amount from the escrow subaccount to the beneficiary account, set the escrow subaccount balance to zero and mark the hold closed."
ac_4 = "WHEN an authorised capture activity names an amount smaller than the remaining hold amount THE protocol SHALL execute a 402LXP transfer of exactly that amount from the escrow subaccount to the beneficiary account, reduce the remaining hold amount by exactly that amount and keep the hold active for the remainder."
ac_5 = "IF a capture amount exceeds the remaining hold amount, or the hold identifier is unknown, or the capturing authority is not the recorded beneficiary or an authority delegated by the owner THEN THE protocol SHALL reject the capture with result code CAPTURE_EXCEEDS_HOLD or UNAUTHORIZED_CAPTURE and SHALL move no funds."
ac_6 = "WHEN an authorised release activity is accepted THE protocol SHALL execute a 402LXP transfer of the entire remaining escrow subaccount balance back to the owner main account, leave the escrow subaccount at zero and mark the hold closed."
ac_7 = "WHEN the batch timestamp reaches or passes the recorded hold expiry and the hold is neither closed nor disputed THE protocol SHALL release the entire remaining escrow subaccount balance to the owner main account deterministically during that batch, and SHALL thereafter reject any capture against that hold with result code HOLD_EXPIRED."
ac_8 = "WHEN a dispute activity is accepted for an active hold and the batch timestamp is within the recorded dispute window THE protocol SHALL mark the hold disputed and SHALL reject subsequent capture, release and expiry release with result code HOLD_DISPUTED until a resolution is accepted; IF a dispute is raised after the dispute window has closed THEN THE protocol SHALL reject it with result code DISPUTE_WINDOW_CLOSED."
ac_9 = "WHEN a dispute resolution from the authority recorded for that hold is accepted THE protocol SHALL apply it as one atomic 402LXP transfer set whose legs split the escrow subaccount balance between the beneficiary and the owner main account, SHALL require that the sum of the legs equals the escrow subaccount balance exactly, SHALL leave the escrow subaccount at zero, and IF any leg violates an invariant THEN THE protocol SHALL roll back the whole set and leave the hold disputed."
ac_10 = "IF a capture, release or resolution activity is resubmitted with an idempotency key that has already produced an economic result THEN THE protocol SHALL move no additional funds and SHALL return the receipt of the original execution, so that every escrow idempotency key yields at most one monetary effect."

[req.16]
title = "Budget Module"
story = "As an autonomous agent operator, I want funded budget subaccounts with recurring allowances and delegated spenders, so that another agent can spend on my behalf inside limits I control and can revoke, while every spend is still an authenticated 402LXP transfer."
ac_1 = "WHEN a budget creation activity is accepted THE protocol SHALL fund the budget by executing a 402LXP transfer of the requested funding amount from the owner main account to the budget subaccount named for that budget identifier, and SHALL record the asset, per-period limit, period length in protocol time units, period start timestamp, rollover policy, delegate set, expiry and revocation sequence."
ac_2 = "WHEN a delegate submits a spend whose amount is within both the remaining period allowance and the budget subaccount balance THE protocol SHALL execute a 402LXP transfer of that amount from the budget subaccount to the named recipient and SHALL reduce the remaining period allowance by exactly that amount."
ac_3 = "IF a spend amount exceeds the remaining period allowance THEN THE protocol SHALL reject it with result code BUDGET_ALLOWANCE_EXCEEDED and move no funds, even when the budget subaccount holds enough balance to cover the amount."
ac_4 = "IF a spend amount is within the remaining period allowance but exceeds the budget subaccount balance THEN THE protocol SHALL reject it with result code INSUFFICIENT_BUDGET_FUNDS, so that allowance accounting alone never creates spendable value."
ac_5 = "IF the submitting identity is not in the recorded delegate set, or its capability has expired, or its capability scope does not cover the asset, recipient or amount THEN THE protocol SHALL reject the spend with result code UNAUTHORIZED_DELEGATE and SHALL make no monetary effect."
ac_6 = "WHEN the batch timestamp crosses one or more period boundaries THE protocol SHALL roll the budget over deterministically at the first activity in that batch which observes the boundary, advancing the period start by whole period lengths, and SHALL reset the remaining period allowance to the configured per-period limit; WHERE the rollover policy is carry-forward THE protocol SHALL add the unspent allowance to the new period up to the configured carry cap and discard the excess, and WHERE the policy is discard THE protocol SHALL drop all unspent allowance."
ac_7 = "WHEN the owner submits a defunding activity THE protocol SHALL execute a 402LXP transfer of the requested amount from the budget subaccount back to the owner main account and SHALL reduce the remaining period allowance so that it never exceeds the resulting budget subaccount balance."
ac_8 = "WHEN the owner submits a budget revocation THE protocol SHALL, in the same activity, execute a 402LXP transfer of the entire remaining budget subaccount balance to the owner main account, mark the budget revoked, and SHALL reject every later spend against that budget with result code BUDGET_REVOKED."
ac_9 = "IF a revocation or capability update carries a revocation sequence that is not strictly greater than the recorded revocation sequence THEN THE protocol SHALL reject it with result code STALE_REVOCATION, so that a replayed authorisation can never reinstate a revoked delegate."
ac_10 = "WHERE a budget authorises a recipient-initiated pull THE protocol SHALL require a signed payer grant naming the authorised recipient, asset, maximum amount, allowance kind, expiry, permitted purpose and revocation sequence, and SHALL reject with result code GRANT_SCOPE_VIOLATION any pull exceeding the grant, presented after expiry, or presented against a superseded revocation sequence."

[req.17]
title = "Stream Module"
story = "As an autonomous agent operator, I want time-based and metered payments that accrue from batch timestamps and settle through 402LXP transfers, so that continuous payment is exactly reproducible on replay and never depends on any node wall-clock."
ac_1 = "WHEN a stream open activity is accepted THE protocol SHALL execute a 402LXP transfer of the funding amount from the payer main account to the stream subaccount named for that stream identifier, and SHALL record the recipient, asset, rate, rate unit, start timestamp, optional end timestamp and total cap; opening a stream SHALL have no monetary effect other than that transfer."
ac_2 = "WHERE accrual for any stream is computed THE protocol SHALL derive elapsed time solely from batch header timestamps and derive metered quantity solely from accepted usage activities, and SHALL NEVER read operating system time, node wall-clock or any value outside the replayable activity history, so that replaying identical history yields identical accrued amounts."
ac_3 = "WHEN a settlement activity for a time-based stream is accepted THE protocol SHALL compute the newly accrued amount as rate multiplied by elapsed protocol time units using checked fixed-width integer arithmetic with rounding down to the smallest indivisible unit of the asset, SHALL subtract the amount already settled, and SHALL execute a 402LXP transfer of the difference from the stream subaccount to the recipient."
ac_4 = "IF a stream computation would produce a negative elapsed interval, or the batch timestamp presented is earlier than the timestamp of the last settlement for that stream, THEN THE protocol SHALL reject the settlement with result code NON_MONOTONIC_TIME and SHALL move no funds; IF the accrual product would exceed the maximum representable fixed-width value THEN THE protocol SHALL reject with result code ACCRUAL_OVERFLOW rather than wrapping."
ac_5 = "WHEN a usage attestation for a metered stream is accepted THE protocol SHALL accrue the metered units multiplied by the recorded unit price with the same rounding rule, and IF the cumulative meter reading in the attestation is lower than the last recorded cumulative reading, or the attestation is not signed by a meter authority recorded for the stream, THEN THE protocol SHALL reject it with result code METER_REGRESSION or UNAUTHORIZED_METER and accrue nothing."
ac_6 = "IF the accrued unsettled amount exceeds the stream subaccount balance THEN THE protocol SHALL settle only up to the available balance, SHALL mark the stream underfunded, SHALL suspend further accrual from that settlement timestamp, and SHALL NOT create debt or allow any account to become negative; WHEN a top-up transfer refunds the stream subaccount THE protocol SHALL resume accrual from the timestamp of the top-up activity."
ac_7 = "WHEN a pause activity from an authorised party is accepted THE protocol SHALL settle accrual up to the batch timestamp of the pause, SHALL accrue nothing for the paused interval, and WHEN a resume activity is accepted THE protocol SHALL accrue again only from the batch timestamp of the resume."
ac_8 = "WHEN a cancellation activity is accepted THE protocol SHALL perform final settlement as one atomic 402LXP transfer set that pays the accrued unsettled amount to the recipient and returns the entire remaining stream subaccount balance to the payer main account, leaving the stream subaccount at zero and the stream closed; IF any leg violates an invariant THEN THE protocol SHALL roll back the whole set and leave the stream open."
ac_9 = "IF a settlement, pause, resume or cancellation activity is submitted against a stream that is already closed, or is resubmitted with an idempotency key that has already produced an economic result, THEN THE protocol SHALL move no additional funds and SHALL respond with result code STREAM_CLOSED or return the receipt of the original execution."
ac_10 = "WHERE a stream reaches its recorded end timestamp or total cap THE protocol SHALL stop accrual at exactly that bound, SHALL cap the lifetime paid amount at the recorded total cap, and SHALL express every payment it has made only as 402LXP transfers out of the stream subaccount."

[req.18]
title = "Service Module and the Agent Work Lifecycle"
story = "As an autonomous agent operator, I want the complete lifecycle of agent work recorded as first-class ordered and attested activities that carry no direct monetary effect, so that offers, commitments, tool executions, deliveries and disputes are independently replayable evidence while any value they imply still moves through 402LXP transfers."
ac_1 = "WHERE any service activity implies a value movement THE protocol SHALL execute that movement only as one or more authenticated 402LXP transfers, typically through an escrow hold, and SHALL reject with result code MODULE_MAY_NOT_WRITE_BALANCE any service activity that attempts to encode a balance mutation of its own; offer, accept, commit, attest, deliver, accept-delivery, reject and dispute SHALL each have no direct monetary effect."
ac_2 = "WHEN an offer activity is accepted THE protocol SHALL assign it a global sequence, record the offering agent, asset, price, terms hash, deliverable specification hash, delivery deadline, acceptance window, dispute window and offer expiry, and SHALL include it in the activity merkle root of its batch."
ac_3 = "WHEN an acceptance activity references an open offer THE protocol SHALL bind it to the offer activity id and require an exact match of the recorded terms hash, and IF the offer has expired, has already been accepted, has been withdrawn, or the presented terms hash differs THEN THE protocol SHALL reject the acceptance with result code OFFER_UNAVAILABLE or TERMS_MISMATCH."
ac_4 = "WHEN a work commitment activity is accepted THE protocol SHALL record the committing provider identity, the agreement id, the deadline expressed as a protocol timestamp bound, and the identifier of any escrow hold the parties reference, and SHALL NOT itself move funds even when an escrow hold is named."
ac_5 = "WHEN a tool execution attestation is accepted THE protocol SHALL require a tool identifier, an input commitment hash, an output commitment hash, execution start and end timestamp bounds, and a signature from a key with attestation authority for the committing agent, SHALL order the attestation in the activity log and include its exact payload in the activity merkle root; IF the signature is invalid, the attesting key is revoked or expired, or a required commitment hash is absent THEN THE protocol SHALL reject the attestation with result code INVALID_ATTESTATION."
ac_6 = "WHEN a delivery activity is accepted THE protocol SHALL record every deliverable hash and its data-availability reference, and IF a deliverable hash does not match the deliverable specification hash committed in the accepted offer, or the batch timestamp is later than the recorded delivery deadline, THEN THE protocol SHALL reject the delivery with result code DELIVERABLE_MISMATCH or DELIVERY_DEADLINE_PASSED."
ac_7 = "WHEN the buyer submits an acceptance of delivery within the acceptance window THE protocol SHALL mark the agreement accepted and closed for delivery purposes, and SHALL require that any resulting payment be executed as a separate 402LXP escrow capture or transfer rather than as an effect of the acceptance activity itself."
ac_8 = "IF the acceptance window elapses with neither an acceptance nor a rejection recorded THEN THE protocol SHALL apply the default outcome recorded in the accepted offer terms deterministically during the first batch whose timestamp crosses the window end, and SHALL apply it identically on every replay of that history."
ac_9 = "WHEN the buyer submits a rejection within the acceptance window THE protocol SHALL record the rejection with its reason code and the deliverable hashes it contests, and SHALL hold the agreement in a disputable state until the recorded dispute window closes."
ac_10 = "WHEN a dispute activity is raised by a party to the agreement while the batch timestamp is inside the recorded dispute window THE protocol SHALL order it and record the evidence hashes it carries, and IF the raiser is not a party to the agreement or the batch timestamp is past the dispute window end THEN THE protocol SHALL reject it with result code UNAUTHORIZED_DISPUTANT or DISPUTE_WINDOW_CLOSED."

[req.19]
title = "Perps Module and the Oracle Adapter"
story = "As an autonomous agent operator, I want perpetual markets whose margin lives in real subaccounts and whose prices, funding and liquidations are deterministic integer computations over signed oracle activities, so that outcomes are reproducible byte for byte and bad market data halts a market instead of being guessed."
ac_1 = "WHEN a market creation activity is accepted THE protocol SHALL record the market id, quote asset, contract size, tick size, initial and maintenance margin ratios, funding interval, maximum oracle staleness, price bounds and permitted oracle key set, all as integer parameters, and SHALL reject a duplicate market id with result code MARKET_ALREADY_EXISTS."
ac_2 = "WHEN an order activity is accepted THE protocol SHALL match it against the resting book deterministically in canonical global sequence order under fixed price and sequence priority, and IF the order would require more initial margin than the agent can fund THEN THE protocol SHALL reject it with result code INSUFFICIENT_MARGIN before making any change to the book or to any balance."
ac_3 = "WHEN a position is opened or its margin is increased THE protocol SHALL move the initial or additional margin by a 402LXP transfer from the agent main account to the margin subaccount named for that position, and WHEN margin is released THE protocol SHALL move it back by a 402LXP transfer from the margin subaccount to the agent main account, so that margin is always a real account balance and never a reserved balance column."
ac_4 = "WHERE any price, notional, profit, loss, funding or liquidation value is computed THE protocol SHALL use checked fixed-width integer arithmetic with a single fixed rounding rule that rounds against the trader and in favour of the protocol, SHALL produce identical results across machines and architectures for identical history, and IF any intermediate computation would overflow THEN THE protocol SHALL reject the activity with result code ARITHMETIC_OVERFLOW rather than wrapping, saturating or truncating."
ac_5 = "WHEN an oracle observation is accepted THE protocol SHALL require a signature from a key in the market permitted oracle key set, SHALL order the observation as a signed oracle activity, SHALL commit its exact payload bytes into the replayable history and the batch oracle root, and SHALL apply no balance change as a result of the observation itself."
ac_6 = "IF an oracle observation is older than the configured maximum staleness at the batch timestamp, carries an observation sequence that is not strictly greater than the last accepted one for that market, falls outside the configured price bounds, or exceeds the configured deviation limit from the last accepted price THEN THE protocol SHALL reject the observation and halt the affected market rather than substituting, extrapolating or reusing a last-known price."
ac_7 = "IF no acceptable oracle observation exists for a market within the required freshness window THEN THE protocol SHALL halt that market, and WHILE a market is halted THE protocol SHALL reject new orders, position increases and liquidations for that market with result code MARKET_HALTED, SHALL suspend funding accrual for that market, SHALL permit only order cancellation and margin additions, and SHALL resume the market only when a fresh in-bound observation from a permitted oracle key is accepted."
ac_8 = "WHEN the funding interval elapses according to batch timestamps THE protocol SHALL settle funding as 402LXP transfers between the long and short funding accounts of that market using the deterministic integer funding rate, and SHALL require that the sum of debits equals the sum of credits for the funding settlement so that funding never mints or burns value."
ac_9 = "WHEN a position margin ratio falls below the maintenance margin ratio at the most recently accepted in-bound oracle price THE protocol SHALL liquidate the position as one atomic 402LXP transfer set whose legs move loss from the margin subaccount to the market liquidity pool, the liquidation fee from the margin subaccount to the liquidator and insurance accounts, any deficit cover from the insurance pool to the market liquidity pool, and any remaining margin from the margin subaccount to the agent main account; IF any leg violates an invariant THEN THE protocol SHALL roll back the entire set and leave the position open and unchanged."
ac_10 = "IF a liquidation loss exceeds the available position margin and the insurance pool balance THEN THE protocol SHALL record an explicit deficit against the insurance account, SHALL NOT mint value, SHALL NOT allow any account balance to become negative, and SHALL still express every monetary effect of the perps module and its oracle adapter exclusively as authenticated 402LXP transfers."

[req.20]
title = "Governance Module and Emergency Controls"
story = "As an autonomous agent operator, I want protocol parameters, activation delays, staged rollout and emergency pause to be explicit versioned protocol state changed only by ordered governance activities, so that operators can respond to incidents without any authority ever rewriting settled history or moving value outside the 402LXP transfer law."
ac_1 = "WHEN the protocol executes any activity THE protocol SHALL evaluate it against an explicit versioned parameter set identified by a parameter_version, and the resulting receipt SHALL identify the parameter_version that was in force for that execution."
ac_2 = "WHEN a governance parameter change activity signed by the governance authority is accepted THE protocol SHALL record it as an ordered activity carrying target_module, parameter_key, proposed_value, activation_epoch and rollout_scope, and SHALL keep the current value in force until the activation epoch is reached."
ac_3 = "IF a parameter change activity names an activation_epoch earlier than the current epoch plus the configured minimum activation delay, or names an unknown target_module or parameter_key, or a proposed_value outside the declared bounds for that key THEN THE protocol SHALL reject the activity with a governance validation error and SHALL make no state change."
ac_4 = "WHEN the first batch whose epoch equals a pending activation_epoch is sealed THE protocol SHALL apply the new parameter value atomically at that deterministic boundary and SHALL increment parameter_version, so every replica and guarantor replaying the same history computes the identical resulting_state_root."
ac_5 = "WHERE a parameter change declares a staged rollout THE protocol SHALL apply the new value only to the enumerated stage cohort, identified by module, market or account set, and SHALL leave every other cohort on the prior value until a later stage activation activity is itself accepted and activated."
ac_6 = "WHEN an emergency pause activity is accepted THE protocol SHALL apply the pause at the declared scope of a single module, a single market or the whole network, and SHALL thereafter reject every submitted activity inside that scope with a paused-scope error while leaving all activities outside that scope fully executable."
ac_7 = "WHILE any scope is paused or the network is in emergency mode THE protocol SHALL continue to order, seal, distribute and checkpoint batches, and SHALL continue to serve receipts, inclusion proofs and balance proofs against the last finalised checkpoint so that withdrawal and emergency-exit paths remain usable."
ac_8 = "WHEN emergency mode is entered or exited THE protocol SHALL emit an ordered governance activity recording the trigger, the scope, the entry epoch and the declared exit conditions, and exit SHALL require an explicit signed governance activity rather than elapsed wall-clock time or any implicit background timer."
ac_9 = "IF a governance activity attempts to write a balance, mint or burn supply, alter an issued receipt, rewrite a sealed batch, substitute a state root, or reassign history already covered by a finalised checkpoint THEN THE protocol SHALL reject that activity, because every monetary effect SHALL compile into one or more authenticated 402LXP transfers and settled history is immutable."
ac_10 = "IF a parameter change would alter the outcome of activities already included in a sealed batch THEN THE protocol SHALL reject the retroactive application and SHALL preserve the original versioned transition function for those sequence numbers, so historical replay reproduces the original results and roots exactly."

[req.21]
title = "Activity Batches and the Sequencer"
story = "As an autonomous agent operator, I want the sequencer to seal signed batches with contiguous global sequence numbers and deterministic timestamps that execution reads instead of the system clock, so that every node reconstructs identical state and no activity is lost, duplicated or reordered across crashes and sequencer changes."
ac_1 = "WHEN the sequencer seals a batch THE protocol SHALL produce a BatchHeader containing exactly protocol_version, network_id, epoch, batch_number, first_sequence, last_sequence, previous_state_root, resulting_state_root, activity_merkle_root, receipt_merkle_root, event_merkle_root, data_availability_root, oracle_root, timestamp and sequencer_id, serialised in the canonical binary encoding with no optional, platform-dependent or floating-point fields."
ac_2 = "WHEN a batch is sealed THE protocol SHALL assign contiguous global sequence numbers such that first_sequence equals the previous batch last_sequence plus one, every included activity occupies exactly one global sequence number, and no sequence number is skipped, duplicated or reused across the entire chain history."
ac_3 = "IF a presented batch has a previous_state_root that does not equal the resulting_state_root of batch_number minus one, or a first_sequence that is not contiguous with the prior batch, or a last_sequence less than first_sequence THEN THE protocol SHALL reject the batch, SHALL NOT advance state and SHALL NOT emit receipts for it."
ac_4 = "WHEN executing any activity THE protocol SHALL derive every time-dependent decision, including timestamp_bound checks, grant and authorisation expiry, escrow timeouts, stream accrual, funding intervals and governance activation, solely from the sealed batch timestamp, and SHALL NEVER read the operating-system clock or any external service during state transition evaluation."
ac_5 = "IF a sealed batch timestamp is not strictly greater than the timestamp of the preceding batch, or exceeds the preceding batch timestamp by more than the configured maximum forward drift bound THEN THE protocol SHALL reject the batch as non-deterministic and SHALL NOT treat it as checkpoint-eligible."
ac_6 = "WHEN a batch is sealed THE protocol SHALL sign the canonical serialisation of the complete BatchHeader with the key bound to sequencer_id, and every replica and guarantor SHALL reject a batch whose sequencer signature is absent, malformed, over a different byte string, or produced by a sequencer_id that governance has not authorised for that batch_number."
ac_7 = "WHEN a batch has been sealed and signed THE protocol SHALL distribute the complete batch body, comprising activities, receipts, events, oracle inputs, state-diff material and recovery metadata, to LayerX replicas, and the batch SHALL NOT become checkpoint-eligible until acknowledgements from the configured replica threshold are recorded."
ac_8 = "IF the sequencer signs two different sealed batches carrying the same batch_number, or two different activities at the same global sequence number THEN THE protocol SHALL treat this as sequencer equivocation, SHALL reject the conflicting batch observed later, SHALL halt checkpoint eligibility for that height, and SHALL publish both signed headers as slashable evidence."
ac_9 = "WHEN the sequencer restarts after a crash THE protocol SHALL recover from the append-only activity log at the last durable write boundary, SHALL discard any partially written trailing record, SHALL rebuild every SQLite index projection from that log, and SHALL resume at the next unused global sequence number without re-executing, duplicating or skipping any already-sealed activity."
ac_10 = "IF the active sequencer becomes unavailable THEN THE protocol SHALL stop accepting new activities rather than order them out of band, SHALL keep all sealed batches and finalised checkpoints readable and independently replayable, and SHALL require an explicit governance sequencer-handover activity naming the new sequencer_id and the first batch_number it may seal before any other party seals a batch."

[req.22]
title = "Paxeer Guarantors and Checkpoint Finality"
story = "As an autonomous agent operator, I want a bonded quorum of independent Paxeer guarantors to fully re-download, re-verify, re-execute and re-hash every batch before attesting, so that checkpoint finality carries a real economic guarantee that is described honestly and can later be strengthened with validity proofs."
ac_1 = "WHEN a batch becomes checkpoint-eligible THE protocol SHALL require every guarantor to download the complete batch body, including all activities, receipts, events, oracle inputs, state-diff material and recovery metadata, before performing any other attestation step."
ac_2 = "WHEN a guarantor evaluates a batch THE protocol SHALL require it to verify every actor signature, every session key, capability grant and delegated authority proof, every oracle signature, and the sequencer signature, and the guarantor SHALL withhold attestation if any single signature or authority check fails."
ac_3 = "WHEN a guarantor evaluates a batch THE protocol SHALL require it to independently replay every state transition from previous_state_root using the versioned transition function, the sealed batch timestamp and the parameter_version in force, and to recompute resulting_state_root, activity_merkle_root, receipt_merkle_root, event_merkle_root, oracle_root and data_availability_root without trusting any sequencer-supplied result."
ac_4 = "IF any recomputed root, result_code, fee_charged, effect list or resulting balance differs from the sequencer-published batch by even one byte THEN THE guarantor SHALL withhold its signature and SHALL publish a dissent record naming the batch_number and the first divergent global_sequence."
ac_5 = "WHEN a guarantor signs a checkpoint THE protocol SHALL require that it has already durably stored the availability data it is attesting to, so a guarantor signature is simultaneously a correctness attestation and a possession attestation and neither can be given without the other."
ac_6 = "WHEN attestations over a byte-identical checkpoint certificate from at least the configured guarantor threshold are registered on Paxeer THE protocol SHALL treat that checkpoint as finalised, and receipts covered by it SHALL become augmentable with activity_inclusion_proof, state_inclusion_proof, checkpoint_id, guarantor_certificate and paxeer_settlement_reference."
ac_7 = "IF fewer than the configured threshold of valid attestations are registered before the configured checkpoint deadline THEN THE protocol SHALL leave the checkpoint unfinalised, SHALL settle no withdrawal, deposit credit or dispute against it, and SHALL retain the previous finalised checkpoint as the authoritative settlement anchor."
ac_8 = "WHERE a guarantor bond on Paxeer is below the configured minimum, or the guarantor is under an unresolved slashing action, or has been removed by governance THE protocol SHALL exclude that guarantor signature from the threshold count even if the signature itself is cryptographically valid."
ac_9 = "IF a guarantor signs two conflicting attestations for the same batch height or checkpoint height THEN THE protocol SHALL accept either signed pair submitted by any party as sufficient equivocation evidence on Paxeer, SHALL slash the offending guarantor bond and SHALL remove that guarantor from the active attesting set."
ac_10 = "WHERE the protocol states its security guarantee THE protocol SHALL declare that threshold attestation is a bonded economic guarantee and is NOT a validity proof, and the checkpoint certificate format SHALL reserve space for an optional validity proof so a later protocol version can add one without changing the activity envelope, the receipt format or the batch header semantics."

[req.23]
title = "Data Availability"
story = "As an autonomous agent operator, I want a checkpoint to be finalisable only when guarantors attest possession of the complete underlying data, and I want to retrieve that data and replay it myself to the same roots, so that a state root can never be finalised over history that nobody can produce."
ac_1 = "WHEN a checkpoint is proposed THE protocol SHALL treat a state root alone as insufficient and SHALL require the checkpoint certificate to commit, via data_availability_root, to the complete activity batch, the receipts, the oracle inputs, the state-diff material and the recovery metadata."
ac_2 = "WHEN a guarantor signs a checkpoint THE protocol SHALL require an explicit possession attestation covering all five availability classes named in the certificate, and SHALL reject as invalid any attestation that covers fewer classes or a different data_availability_root."
ac_3 = "WHEN any party requests finalised history by checkpoint_id, batch_number, global_sequence range or activity_id THE protocol SHALL serve the canonical binary bytes over the published retrieval interface, such that re-hashing the served bytes reproduces the committed activity_merkle_root, receipt_merkle_root, event_merkle_root, oracle_root and data_availability_root exactly."
ac_4 = "WHEN an agent replays retrieved history from genesis or from any finalised checkpoint THE protocol SHALL produce byte-identical receipts and state roots to those in the checkpoint certificate, across differing machines, operating systems and CPU architectures, with no index database required as an input."
ac_5 = "WHEN an availability challenge naming a batch_number and a chunk index is issued THE protocol SHALL require the challenged guarantor to return that chunk together with an inclusion proof against the committed data_availability_root within the configured response window."
ac_6 = "IF a bonded guarantor fails to answer a valid availability challenge within the response window THEN THE protocol SHALL record the failure on Paxeer, SHALL make it slashable under the configured availability policy, and SHALL exclude that guarantor from subsequent availability and finality thresholds until it is restored by governance."
ac_7 = "IF the data behind an unfinalised checkpoint becomes unavailable THEN THE protocol SHALL refuse to finalise that checkpoint, SHALL permit no withdrawal, deposit credit or dispute settlement against it, and SHALL keep the last finalised checkpoint as the settlement anchor."
ac_8 = "IF the data behind an already finalised checkpoint becomes unavailable THEN THE protocol SHALL keep that checkpoint valid for emergency exit, SHALL enter emergency data mode, SHALL halt further checkpoint finalisation, and SHALL resume only when availability is restored or governance reconstitutes the guarantor set."
ac_9 = "WHEN availability data is served THE protocol SHALL include the recovery metadata needed to rebuild every SQLite index projection and materialised view from the append-only activity log alone, so that all indexes are treated as rebuildable projections and never as protocol authority."
ac_10 = "IF served bytes do not hash to the committed roots, or an inclusion proof does not verify against data_availability_root THEN THE protocol SHALL treat the response as an availability failure rather than a satisfied request, and SHALL publish the mismatching signed commitment together with the served bytes as evidence."

[req.24]
title = "Bridge Module, Settlement, Withdrawals and Emergency Exits"
story = "As an autonomous agent operator, I want Paxeer contracts to hold custody while understanding almost no LayerX business logic, verifying only finalised certificates, proofs, nullifiers, signatures and challenge windows, so that deposits cannot be credited without proof, withdrawals cannot pay twice, and I can always exit against the last finalised checkpoint even if the sequencer never returns."
ac_1 = "WHEN a Paxeer custody contract processes any LayerX claim THE protocol SHALL require it to verify only a finalised checkpoint certificate, membership or balance proofs against that certificate state root, withdrawal nullifiers, guarantor signatures against the bonded active set, the challenge window state and emergency-exit eligibility, and the contract SHALL NOT interpret perps orders, service agreements, escrow rules or ordinary transfers."
ac_2 = "WHEN assets are deposited into Paxeer custody THE protocol SHALL credit the depositing agent on LayerX only through a bridge deposit activity carrying the finalised Paxeer deposit proof, executed as an authenticated 402LXP transfer from the Paxeer reserve mirror account to the agent main account, and SHALL reject any credit path that does not present that proof."
ac_3 = "IF a deposit proof is replayed, references a different network_id or protocol_version, references a Paxeer transaction not yet finalised, or carries a deposit identifier already consumed THEN THE protocol SHALL reject the bridge deposit activity and SHALL credit no balance a second time."
ac_4 = "WHEN an agent initiates a withdrawal THE protocol SHALL first execute an authenticated 402LXP transfer from the agent account to the Paxeer withdrawals account, so the LayerX debit is committed and checkpointed before any Paxeer payout becomes claimable."
ac_5 = "WHEN a withdrawal is claimed on Paxeer THE protocol SHALL require a membership or balance proof of the withdrawal record against the state root of a finalised checkpoint together with guarantor signatures meeting the configured threshold, and SHALL record a withdrawal nullifier derived deterministically from the withdrawal identity."
ac_6 = "IF a withdrawal claim presents a nullifier that has already been recorded THEN THE protocol SHALL reject the claim and pay nothing, so that no withdrawal can be paid twice through resubmission, an alternative inclusion proof, a later checkpoint, or a reorganisation of the underlying settlement chain."
ac_7 = "WHILE the configured challenge window for a checkpoint remains open THE protocol SHALL hold payouts proved against that checkpoint, and IF a fraud, availability or equivocation challenge against that checkpoint succeeds THEN THE protocol SHALL cancel the pending payouts bound to it and SHALL slash the guarantors that attested to it."
ac_8 = "IF no new checkpoint is finalised within the configured liveness bound, or the network enters emergency mode THEN THE protocol SHALL declare emergency-exit eligibility and SHALL allow any agent to exit directly against the last finalised checkpoint using only that certificate, its state root, a balance proof and the recorded guarantor signatures."
ac_9 = "WHEN an emergency exit is executed THE protocol SHALL require no cooperation from the sequencer, no newly sealed LayerX batch and no ongoing guarantor liveness, so the exit remains executable against the last finalised checkpoint even if the sequencer is permanently gone."
ac_10 = "WHEN any withdrawal or emergency exit settles THE protocol SHALL enforce that Paxeer custody for each asset remains greater than or equal to the sum of LayerX balances for that asset plus outstanding claims, and SHALL reject any payout that would break full reserve reconciliation or make any account negative."

[req.25]
title = "HTTP 402 Payment Gateway"
story = "As an autonomous agent operator, I want a standard HTTP 402 payment handshake that compiles into ordinary 402LXP transfers and produces a receipt my counterparty can verify offline, so that paid machine-to-machine services settle without either side trusting the other or trusting the gateway itself."
ac_1 = "WHEN an agent requests a paid resource and presents no valid proof of payment THE protocol SHALL define the service response as HTTP status 402 carrying an LXP payment requirement whose fields are exactly network_id, recipient, asset, amount, invoice_id, purpose_hash, expiry, acceptable_conditions and service_signature."
ac_2 = "IF a payment requirement omits any of those nine fields, encodes amount as anything other than a non-negative integer in the asset base unit, names a network_id other than the one the agent is transacting on, or carries a service_signature that does not verify against the declared recipient service key THEN THE protocol SHALL define the requirement as invalid and SHALL NOT treat any payment made against it as satisfying the invoice."
ac_3 = "WHEN the SEND settlement model is used THE protocol SHALL require the agent to submit a 402LXP SEND whose to equals the requirement recipient, whose asset and amount equal the requirement asset and amount, whose context_hash equals the requirement purpose_hash, whose expires_at is not later than the requirement expiry, and whose conditions are a subset of acceptable_conditions, and SHALL execute the authenticated transfer and return one signed 402LXP receipt that the agent presents to the service to obtain the resource."
ac_4 = "WHEN the RECEIVE settlement model is used THE protocol SHALL require the service to submit a 402LXP RECEIVE accompanied by a signed payer grant that names the authorized recipient, the asset, the maximum amount, the total or recurring allowance, the expiration, the permitted purpose, the service or invoice identifier and the revocation sequence, and SHALL debit the payer only within those bounds and only for that invoice_id."
ac_5 = "IF a RECEIVE is submitted by an account other than the grant authorized recipient, for an amount above the grant maximum or remaining allowance, after the grant expiration, for a purpose other than the permitted purpose, or against a grant whose revocation sequence has been consumed THEN THE protocol SHALL reject the operation with a deterministic result code, SHALL leave every balance unchanged, and SHALL never allow a recipient to debit an account for which no valid payer grant exists."
ac_6 = "WHEN the same invoice_id and idempotency_key pair is settled more than once, whether by repeated SEND, repeated RECEIVE, or one of each THE protocol SHALL produce at most one economic result and SHALL return the original receipt for every subsequent attempt, so that a retried or replayed HTTP 402 exchange can never move value twice."
ac_7 = "IF settlement is attempted after the requirement expiry, or after the batch timestamp exceeds the SEND expires_at THEN THE protocol SHALL reject the transfer with an expiry result code and SHALL NOT credit the recipient."
ac_8 = "WHERE a service verifies payment offline THE protocol SHALL make a receipt independently verifiable from the receipt bytes alone using only the canonical encoding rules, the sequencer public key and, once checkpointed, the guarantor certificate and inclusion proofs, without any call back to LayerX, and the service SHALL be able to confirm that the receipt asset, amount, recipient, network_id and context_hash match the requirement it issued."
ac_9 = "WHERE the JSON over HTTP gateway is deployed THE protocol SHALL treat it strictly as a convenience surface: consensus behaviour SHALL be defined solely by the canonical binary encoding and the deterministic state machine, and disabling, changing or removing the gateway SHALL NOT alter any accepted outcome, receipt field, result code or state root."
ac_10 = "IF the HTTP 402 gateway is unreachable, returns malformed JSON, or reports an outcome that contradicts the canonical record THEN THE protocol SHALL treat the canonical binary transport and the signed receipt as authoritative, and an agent SHALL be able to complete the identical payment by submitting the same 402LXP SEND directly over the canonical transport."

[req.26]
title = "Fees and Resource Metering"
story = "As an autonomous agent operator, I want fees computed by a deterministic integer function against a ceiling I declare in advance and charged only as an ordinary authenticated transfer, so that my costs are predictable, replay reproduces them exactly, and no module can quietly deduct value outside the single financial doorway."
ac_1 = "WHEN an activity is executed THE protocol SHALL compute its fee from a versioned integer-only function of activity type, canonical encoded byte length, metered execution units and metered storage units, using only checked fixed-width arithmetic and one fixed rounding rule that rounds any fractional base unit upward, and SHALL produce a bit-identical fee on every machine, compiler and architecture."
ac_2 = "WHEN an activity envelope is submitted THE protocol SHALL require a fee_limit field expressed as a non-negative integer in the fee asset base unit, and SHALL reject as malformed any envelope lacking fee_limit or encoding it as a floating point or ambiguous numeric value."
ac_3 = "IF the computed fee exceeds the declared fee_limit THEN THE protocol SHALL reject the activity with the deterministic result code for fee limit exceeded, SHALL apply no module state effect, and SHALL charge no more than the fee_limit."
ac_4 = "WHEN a fee is charged THE protocol SHALL charge it as a 402LXP transfer from the actor main account to the system fee treasury account, SHALL record the amount in the receipt fee_charged field, and SHALL NOT reduce any balance by any mechanism other than that transfer."
ac_5 = "WHEN an activity is admitted THE protocol SHALL require that the actor spendable balance in the fee asset is at least fee_limit at admission time, and SHALL charge the computed fee before applying any module effect so that the fee transfer can never fail because of the activity own spending."
ac_6 = "WHERE an activity fails THE protocol SHALL apply exactly one rejection policy: an activity that fails admission, meaning malformed encoding, wrong protocol_version or network_id, invalid or unauthorized signature, non-next account_sequence, elapsed timestamp_bound, duplicate idempotency_key, or spendable balance below fee_limit, SHALL NOT be assigned a global sequence, SHALL NOT consume the account sequence and SHALL NOT be charged any fee; an activity that is admitted and ordered but then fails execution SHALL consume its account sequence exactly once, SHALL be charged the computed fee up to fee_limit, and SHALL produce a durable failure receipt carrying its result code and zero module effects."
ac_7 = "WHILE an activity executes THE protocol SHALL meter execution units and net state storage bytes, SHALL abort the activity with the deterministic resource exhaustion result code when either metered quantity exceeds its governance parameter ceiling, and SHALL price storage growth at the storage rate parameter in force for that batch."
ac_8 = "IF any step of fee computation, metering accumulation or fee treasury credit would overflow or underflow its fixed-width integer type THEN THE protocol SHALL reject the activity with the arithmetic overflow result code and SHALL NOT wrap, saturate or truncate."
ac_9 = "WHEN a governance activity changes a fee or metering parameter THE protocol SHALL bind the new value to an explicitly named activation epoch, and replay of any batch SHALL use the parameter values in force at that batch epoch so that historical fees remain reproducible."
ac_10 = "WHEN a batch is replayed from the append-only activity log THE protocol SHALL reproduce every fee_charged value, every fee treasury balance and every resulting state root exactly, and SHALL preserve per-asset conservation such that the sum of fee debits equals the sum of fee treasury credits."

[req.27]
title = "Genesis Manifest, Migration and Shadow Replay"
story = "As an autonomous agent operator, I want the new protocol to begin from an explicit reconciled genesis manifest and prove itself against the legacy system before cutover, so that no balance, hold, position or obligation is silently inherited, invented or lost in the transition."
ac_1 = "WHEN a LayerX network is instantiated THE protocol SHALL require an explicit signed genesis manifest declaring protocol_version, network_id, genesis timestamp, the full parameter set, the initial guarantor set with bonds, the complete imported account and module state, and the genesis state root, and SHALL refuse to start if any existing database, index or log is presented in place of that manifest."
ac_2 = "WHEN a genesis import is prepared THE protocol SHALL require the manifest to account separately and explicitly for USDX balances, vault reserves, open holds, queued withdrawals, liquidity pools, insurance pools, open perps positions, pending orders, funding state, DID to EVM bindings, and outstanding receipts with their anchored roots, each as a distinct enumerated section with its own item count and per-asset totals."
ac_3 = "IF any imported value fails to reconcile against Paxeer custody records, or if for any asset the sum of imported account balances, subaccount balances, holds, margin and pool balances is not exactly equal to the Paxeer attested custody amount for that asset THEN THE protocol SHALL reject the entire manifest, SHALL import nothing, and SHALL NOT permit a partial or best-effort import."
ac_4 = "WHEN the manifest is accepted THE protocol SHALL materialise every imported locked value as a real account or subaccount rather than a hidden balance column, SHALL carry outstanding receipts and previously anchored roots forward as immutable historical commitments that are verifiable but not re-executable, and SHALL register the genesis state root on Paxeer as the first checkpoint before any activity is accepted."
ac_5 = "WHILE shadow replay is in progress THE legacy LayerX SHALL remain the sole authority and SHALL be operated read-only with respect to new protocol effects, and the C implementation SHALL consume the identical accepted activity stream without being able to alter legacy state or custody."
ac_6 = "IF shadow replay produces any divergence from the legacy system in accepted or rejected classification, ordering, resulting balance, fee charged, result code or any receipt field THEN THE protocol SHALL block promotion to authority, and SHALL record the divergence together with the activity identifier, the expected value and the produced value."
ac_7 = "WHERE the legacy implementation is used as a behavioural reference THE protocol SHALL NOT adopt PostgreSQL table structures as the protocol definition and SHALL NOT adopt HTTP endpoints as the canonical wire protocol: state layout and wire format SHALL be defined only by the canonical binary encoding and the versioned transition functions."
ac_8 = "WHERE authority and external data are concerned THE protocol SHALL NOT carry over in-memory authentication challenges as authority state, since all authority SHALL derive from ordered signed activities recorded in the append-only log, and SHALL NOT carry over direct Crossverse access inside execution, since external observations SHALL enter only as signed oracle activities whose exact payload becomes part of replayable history."
ac_9 = "WHERE settlement and events are concerned THE protocol SHALL NOT carry over development or test settlement fallbacks, and SHALL fail closed when a settlement path is unavailable rather than simulating success, and SHALL NOT carry over process-local server-sent-event streams as the authoritative event mechanism, since the authoritative events SHALL be those committed under the batch event merkle root."
ac_10 = "WHERE timing is concerned THE protocol SHALL NOT carry over implicit background timers, cron intervals or wall-clock reads as consensus behaviour: every time-dependent transition, including expiry, funding, streaming accrual and hold timeout, SHALL be driven only by the deterministic timestamp supplied in the batch header, so that replay at any later date yields the identical outcome."

[req.28]
title = "Qualification and Conformance"
story = "As an autonomous agent operator, I want an explicit and exhaustive qualification gate that the implementation must pass before it is called ready, so that determinism, safety, custody reconciliation and interoperability are demonstrated by evidence rather than asserted."
ac_1 = "WHEN the same activity history is replayed on different machines, operating systems, compilers, optimisation levels and CPU architectures including at least one 64-bit and one non-x86 target THE protocol SHALL produce byte-identical activity encodings, receipts, batch headers and state roots, and the qualification SHALL fail on any single differing byte."
ac_2 = "WHEN a corpus of at least ten million activities spanning every activity type is replayed THE protocol SHALL produce a deterministic terminal state root that matches the independently recorded root, and SHALL produce identical intermediate roots at every batch boundary."
ac_3 = "WHEN fault injection aborts the process at every distinct durable write boundary in the append-only log, index and checkpoint store THE protocol SHALL, on restart, recover to a consistent state that either fully contains or fully excludes each activity, SHALL never expose a partially applied transfer set, and SHALL resume the global sequence without gap, duplication or reordering."
ac_4 = "WHEN network partition, replica isolation, message reordering, message loss and prolonged sequencer unavailability are simulated THE protocol SHALL never finalise conflicting state for the same sequence range, SHALL halt rather than fork when the active sequencer is lost, and SHALL resume from the last checkpointed root once connectivity is restored."
ac_5 = "WHEN malformed, truncated, over-long, deeply nested, non-canonically encoded and randomly mutated activity bytes are fuzzed against the decoder and the state machine THE protocol SHALL reject every non-canonical input with a deterministic result code, SHALL NOT crash, hang, read out of bounds or allocate unbounded memory, and SHALL leave state unchanged."
ac_6 = "WHEN signature fields are fuzzed, including malleated, truncated, all-zero, wrong-curve, wrong-domain-separator and replayed-from-another-network signatures THE protocol SHALL reject every one of them, SHALL accept no activity whose signature does not verify over the exact canonical bytes under the correct domain separation, and SHALL treat a signature valid on another network_id as invalid."
ac_7 = "WHEN the arithmetic layer is qualified THE protocol SHALL demonstrate by exhaustive boundary testing and machine-checked proof over the 128-bit and 256-bit routines that every addition, subtraction, multiplication and division either returns an exact checked result or a deterministic overflow error, and that every rounding site rounds in the single specified direction with no floating point anywhere in consensus-critical code."
ac_8 = "WHEN guarantors are made to disagree, including a guarantor that replays to a different root, one that refuses to sign, and one that signs two conflicting checkpoints for the same batch number THE protocol SHALL withhold finality below the signing threshold, SHALL produce a portable equivocation proof for the double signer, and SHALL make that proof sufficient for slashing on Paxeer without any trusted intermediary."
ac_9 = "WHEN data unavailability is simulated by withholding the activity batch, receipts, oracle inputs, state-diff material or recovery metadata from guarantors THE protocol SHALL leave the affected checkpoint unfinalizable, SHALL NOT allow an availability attestation to be signed for data a guarantor does not hold, and SHALL allow agents to detect the unavailability from public information."
ac_10 = "WHEN emergency exit is exercised end to end on Paxeer against a live custody deployment THE protocol SHALL allow an agent to withdraw its proven balance using only a finalized checkpoint certificate, a membership or balance proof against its state root and an unspent withdrawal nullifier, with the LayerX sequencer offline and uncooperative for the entire test."
ac_11 = "WHEN full reserve reconciliation is run THE protocol SHALL show for every asset that the sum of all agent accounts, subaccounts, escrow, budget, margin, liquidity, insurance, fee treasury and withdrawal accounts equals the Paxeer custody balance exactly, with zero tolerance, and SHALL show that every historical batch preserved the invariant that debits equal credits."
ac_12 = "WHEN shadow comparison against the existing LayerX is run over a continuous production activity stream THE protocol SHALL reproduce the legacy accepted outcomes for every activity in the comparison window, and any divergence SHALL block qualification until it is explained and either fixed or recorded as an intentional specified difference."
ac_13 = "WHEN a canary is run with real agents and real value under a bounded exposure limit THE protocol SHALL operate for the declared canary period with no reserve discrepancy, no unrecoverable crash, no missed checkpoint deadline and no receipt that fails independent verification, before general availability is declared."
ac_14 = "WHEN the C API conformance suite is executed by an independent party THE protocol SHALL satisfy every documented contract of the public headers, including return codes, ownership and lifetime rules, thread-safety declarations, and the rule that the single balance mutation primitive is the only path that writes a balance, with any direct balance write detected and failed."
ac_15 = "WHEN the wire-protocol conformance suite is executed by an independently written implementation THE protocol SHALL accept every valid canonical vector, reject every listed non-canonical and adversarial vector, and produce the exact expected encodings, identifiers, merkle roots and receipt bytes for every published test vector."
ac_16 = "WHEN the release build is qualified THE protocol SHALL build and pass the entire test, fuzz and replay corpus clean under address, undefined-behaviour, thread and memory sanitizers and under a leak checker, with zero reported errors, zero leaked allocations and zero data races, and SHALL fail qualification if any sanitizer is disabled or any finding is suppressed without a recorded justification."

[req.29]
title = "Paxeer Contract Systems, Deployment and Migration Safety"
story = "As a custodian and protocol operator, I want the Paxeer settlement contracts to have a complete reusable safety substrate, deterministic deployment manifest and fail-closed migration system, so that LayerX can custody institutional-scale value without relying on thin one-off contracts or an undocumented upgrade ceremony."
ac_1 = "THE contract system SHALL provide checked arithmetic, canonical constants and fixed-width protocol types for every value crossing the LayerX to Paxeer boundary, SHALL reject narrowing conversions that lose information, and SHALL define no duplicate constant with a divergent value."
ac_2 = "THE contract system SHALL provide bounded byte readers, canonical encoding, domain-separated hashing, cryptographic primitives and index-aware Merkle proof verification, and SHALL reject malformed lengths, out-of-range reads, invalid proof depths and non-canonical encodings without returning a plausible value."
ac_3 = "WHEN a contract performs CALL, STATICCALL or value transfer THE contract system SHALL bound copied return data, preserve an exact success or failure classification, reject calls to an account without deployed code where code is required, and prevent unbounded revert data from exhausting the caller."
ac_4 = "WHEN an entry point requires a direct codeless origin THE contract system SHALL use an EIP-7702-aware caller rule rather than extcodesize alone, SHALL distinguish msg.sender from tx.origin explicitly, and SHALL test constructor, contract, delegated-account and direct-origin cases."
ac_5 = "THE contract system SHALL make delegate-call assumptions explicit: implementation-only functions SHALL reject delegated execution, proxy-only functions SHALL reject direct execution, and every non-upgradeable LayerX settlement contract SHALL expose an unambiguous rejection of UUPS upgrade entry points rather than accidentally appearing upgradeable."
ac_6 = "THE contract system SHALL centralise namespaced persistent storage slots and transient execution context, SHALL reject a zero or reserved slot identifier, SHALL clear transient authority at the end of the call, and SHALL provide a persistent fallback when the target Paxeer EVM revision does not support transient storage."
ac_7 = "THE deployment configuration SHALL bind chain_id, protocol_version, release semantic version, governance timelock, emergency council, genesis state root, challenge and liveness parameters, asset definitions and enabled feature bits into one canonical static-config hash, and every deployed contract SHALL be validated against that hash."
ac_8 = "WHEN a LayerX settlement suite is deployed THE system SHALL derive deterministic CREATE2 addresses from a versioned blueprint hash, SHALL publish the exhaustive predeploy and preinstall manifest, SHALL validate runtime code hashes and constructor-bound immutable configuration at every address, and SHALL reject an occupied address whose code hash differs."
ac_9 = "THE contracts manager SHALL stage a migration as an immutable commitment to source release, target release, static-config hash, ordered operation root, earliest execution time and expiry, SHALL validate the entire operation set before the first mutation, SHALL execute operations in their committed order, and SHALL make a partial or replayed migration impossible."
ac_10 = "WHEN a migration is proposed or executed THE validator SHALL enforce strictly increasing semantic versions, compatible protocol and storage-layout versions, exact target and selector allowlists, code-hash expectations before and after each operation, bounded call value and calldata, timelock maturity and expiry, and SHALL reject an emergency path that can install arbitrary code or bypass the manager."
ac_11 = "THE contract system SHALL define a canonical cross-domain message envelope and message type enumeration binding source chain, destination chain, source sender, destination target, nonce, value, gas limit and payload hash, and SHALL make every message or signature permanently invalid on a different chain, manager or protocol version."
ac_12 = "WHEN token amounts cross decimal domains THE contract system SHALL convert only through checked powers of ten, SHALL expose the exact remainder for down-scaling, SHALL never round a custody credit upward, and SHALL reject unsupported decimals or a non-zero remainder where exact conversion is required."
ac_13 = "THE compatibility layer SHALL fail closed on foreign chain assumptions: Arbitrum address aliasing and precompiles, OP Stack predeploy addresses, gas-token hooks and any other absent facility SHALL be represented as unsupported feature checks rather than silently called or copied into Paxeer logic."
ac_14 = "THE manager container SHALL enumerate every critical LayerX contract, its role, expected interface identifier, runtime code hash, configuration hash and release version, SHALL reject duplicate roles or addresses, and SHALL provide one machine-verifiable system manifest for deployment, monitoring and incident response."
ac_15 = "WHEN contract qualification runs THE suite SHALL include unit, fuzz, invariant and negative-path tests for every primitive, deployment collision, wrong code hash, storage-layout mismatch, semantic-version downgrade, migration replay, partial execution, malicious return data, decimal dust, cross-chain replay, direct implementation call and delegated non-upgradeable call, and SHALL fail on any untested external state-changing function."
ac_16 = "THE production contract set SHALL use custom errors with stable selectors, explicit event commitments for every governance or custody transition, CEI and reentrancy protection on every external-value path, checksummed deterministic build settings, and no selfdestruct, unrestricted delegatecall, tx.origin authorization, arbitrary target execution or operator-only balance mutation."

# --------------------------------------------------------------------------
# TASKS
# --------------------------------------------------------------------------

[task.1]
section = "Wave 0 — Foundation"
title = "Scaffold the repository, the C17 build system and the protocol constant layer"
status = "pending"

[task.1.1]
title = "Create the source tree and the strict C17 build"
status = "done"
wave = 0
do_1 = "Create the directory tree from the design source tree: include/layerx, src/protocol, src/codec, src/crypto, src/state, src/storage, src/network, src/sequencer, src/replica, src/guarantor, src/paxeer, src/modules, cmd, contracts, migrations, tests, fuzz and tools."
do_2 = "Write a root Makefile compiling every translation unit with -std=c17 -pedantic -Werror -Wall -Wextra -Wconversion -Wshadow -Wvla -fno-strict-aliasing -ffp-contract=off, and linking no C++, Go, Rust or JavaScript object into the runtime."
do_3 = "Add a make build target producing build/liblayerx.a with per-area object directories, plus make clean removing build entirely."
do_4 = "Add include/layerx/lxp_build.h and src/protocol/lxp_build_info.c exposing lxp_build_info with compiler id, target triple, optimisation level and revision, none of which may ever be read during transition evaluation."
do_5 = "Prove reproducibility by building twice into different output directories and comparing the archive byte for byte."
verify_cmd = "make build"
symbols = ["lxp_build_info","lxp_build_target_triple","lxp_build_compiler_id"]
touches = ["Makefile","include/layerx/lxp_build.h","src/protocol/lxp_build_info.c"]
reqs = ["5.1","28.1","28.16"]

[task.1.2]
title = "Define the shared result and error code enumeration"
status = "done"
wave = 0
requires = ["1.1"]
do_1 = "Add include/layerx/lxp_result.h defining lxp_result as int32_t with LXP_OK equal to zero and every failure code negative."
do_2 = "Partition the negative space by domain exactly as the design fixes it: codec -1 to -99, envelope -100 to -199, identity and authority -200 to -299, sequencing -300 to -399, ledger -400 to -499, arithmetic -500 to -599, fees and metering -600 to -699, module semantics -700 to -799, batch and checkpoint -800 to -899, storage and recovery -900 to -999, fatal below -1000."
do_3 = "Implement lxp_result_name and lxp_result_domain in src/protocol/lxp_result.c as total non-allocating functions, plus lxp_result_is_fatal for the codes that halt the node instead of propagating."
do_4 = "Test that every declared code is unique, sits inside its declared domain range and has a name, so renumbering breaks the build rather than silently changing a receipt field."
do_5 = "Document in the header that a result code is part of the receipt and therefore part of consensus, so renumbering is a protocol version change and never a refactor."
verify_cmd = "make test-result"
symbols = ["lxp_result","lxp_result_name","lxp_result_domain","lxp_result_is_fatal"]
touches = ["include/layerx/lxp_result.h","src/protocol/lxp_result.c","tests/protocol/lxp_test_result.c"]
reqs = ["2.9","5.3","26.6","13.16"]

[task.1.3]
title = "Fix the protocol version, network id, length limits and domain tags"
status = "done"
wave = 0
requires = ["1.1","1.2"]
do_1 = "Add include/layerx/lxp_protocol.h declaring the protocol version as a uint16 and the network id as a uint32 supplied by node configuration and never inferred."
do_2 = "Declare every variable-length limit as a named constant: maximum activity bytes, payload bytes, DID length, authority chain depth, transfer set leg count, effect count and batch activity count."
do_3 = "Declare the domain tag table with one distinct tag per hashing purpose, covering activity id, payload hash, signature preimage, authority hash, context hash, merkle leaf, merkle internal node, batch header, receipt and checkpoint certificate."
do_4 = "Implement lxp_protocol_version_supported and lxp_network_id_matches so an envelope valid on one network is permanently invalid on every other network."
do_5 = "Test that no two domain tags are equal or a prefix of one another, and that every declared limit is non-zero and fits its wire type."
verify_cmd = "make test-protocol"
symbols = ["lxp_protocol_version_supported","lxp_network_id_matches","lxp_domain_tag","lxp_domain_tag_id"]
touches = ["include/layerx/lxp_protocol.h","src/protocol/lxp_protocol.c","tests/protocol/lxp_test_protocol.c"]
reqs = ["2.2","6.3","6.4","6.6"]

[task.1.4]
title = "Implement the deterministic arena allocator"
status = "done"
wave = 0
requires = ["1.1","1.2"]
do_1 = "Add include/layerx/lxp_arena.h and src/protocol/lxp_arena.c providing bump-pointer allocation from a caller-supplied fixed buffer with explicit alignment and no malloc on any execution path."
do_2 = "Implement lxp_arena_init, lxp_arena_alloc, lxp_arena_mark and lxp_arena_reset, returning the arena-exhausted result code rather than growing when a request exceeds the buffer."
do_3 = "Guarantee no observable address dependence: never hash, order or branch on a returned pointer, and zero every reset region so reused memory is never read as uninitialised state."
do_4 = "Test that two arenas over different base addresses produce identical allocation sequences and identical byte contents."
do_5 = "Run the arena suite under AddressSanitizer with redzone poisoning so a single-byte overrun fails the run."
verify_cmd = "make test-arena"
symbols = ["lxp_arena","lxp_arena_init","lxp_arena_alloc","lxp_arena_mark","lxp_arena_reset"]
touches = ["include/layerx/lxp_arena.h","src/protocol/lxp_arena.c","tests/protocol/lxp_test_arena.c"]
reqs = ["5.8","28.5","28.16"]

[task.1.5]
title = "Build the zero-dependency C test harness and the CI entry point"
status = "done"
wave = 0
requires = ["1.2"]
do_1 = "Add tests/lxp_test_harness.h and tests/lxp_test_harness.c providing lxp_test_register, lxp_test_run_all and assertion helpers for integers, byte buffers and result codes, with no external test framework."
do_2 = "Print expected and produced bytes in hex with file and line on failure, and return a non-zero process exit status so CI fails on any assertion."
do_3 = "Add a make test target that builds and runs every registered suite, and a make list-tests target that prints the registry."
do_4 = "Land one no-op suite so make test passes on an otherwise empty tree and CI has a green baseline to regress from."
do_5 = "Add tools/ci/run-tests.sh running make test for each build variant and aggregating exit codes without swallowing a failure."
verify_cmd = "make test"
symbols = ["lxp_test_register","lxp_test_run_all","lxp_test_assert_bytes_eq","lxp_test_assert_result"]
touches = ["tests/lxp_test_harness.h","tests/lxp_test_harness.c","tools/ci/run-tests.sh","Makefile"]
reqs = ["28.16","28.1","5.1"]

[task.1.6]
title = "Add the sanitizer build variants and the determinism CI gates"
status = "done"
wave = 0
requires = ["1.3","1.5"]
do_1 = "Add asan, ubsan and tsan variants through tools/build/sanitizers.mk with the sanitize flags, frame pointers retained and halt-on-error set, exposed as make build-asan, make build-ubsan and make build-tsan."
do_2 = "Add make test-sanitizers running the full suite under each variant and failing on any sanitizer report, any leaked allocation and any data race."
do_3 = "Add tools/ci/no-float-scan.sh rejecting float, double, long double and the math header under src/protocol, src/codec, src/state, src/storage and src/modules, and scanning consensus objects for floating-point instructions."
do_4 = "Add tools/ci/symbol-allowlist.sh rejecting time, clock_gettime, gettimeofday, rand, random, getenv, getpid, gethostname and stat in execution translation units."
do_5 = "Wire both scanners and make test-sanitizers into make ci so a violation fails the build instead of producing a warning to triage later."
verify_cmd = "make ci"
symbols = ["lxp_sanitizer_smoke","lxp_ci_gate_report"]
touches = ["tools/build/sanitizers.mk","tools/ci/no-float-scan.sh","tools/ci/symbol-allowlist.sh","tests/protocol/lxp_test_sanitizer_smoke.c","Makefile"]
reqs = ["5.2","5.8","28.7","28.16"]

[task.2]
section = "Waves 1-2 — Deterministic Primitives, State and Storage"
title = "Implement the canonical binary codec"
status = "pending"

[task.2.1]
title = "Implement the canonical primitive encoder and decoder"
status = "done"
wave = 1
requires = ["1.1","1.2","1.4"]
do_1 = "Add include/layerx/lxp_codec.h and src/codec/lxp_codec.c with a writer over a caller arena and a reader over a borrowed byte span, both total and non-allocating."
do_2 = "Encode every integer fixed-width big-endian with no varint and therefore no length-of-length ambiguity: u8, u16, u32, u64, u128 as 16 bytes and i32 as 4 bytes in twos-complement form."
do_3 = "Reject any short read, any negative remaining length and any read past the span end with the truncated result code, never reading out of bounds."
do_4 = "Guarantee re-encoding a decoded primitive reproduces the original bytes exactly, asserted over the boundary set zero, one, max minus one and max for every width."
do_5 = "Forbid presence bitmaps and optional fields: absence is an explicit zero or an explicit tagged none, so there is no presence encoding to disagree about."
verify_cmd = "make test-codec"
symbols = ["lxp_codec_writer","lxp_codec_reader","lxp_codec_write_u64","lxp_codec_read_u64","lxp_codec_write_u128","lxp_codec_read_u128"]
touches = ["include/layerx/lxp_codec.h","src/codec/lxp_codec.c","tests/codec/lxp_test_codec_primitives.c"]
reqs = ["6.1","6.2","2.10"]

[task.2.2]
title = "Encode byte strings, tagged unions and ordered sequences under declared limits"
status = "done"
wave = 1
requires = ["1.3","2.1"]
do_1 = "Encode byte strings and text as a u32 big-endian length followed by raw bytes, with text required to be UTF-8 and NFC-normalised at admission."
do_2 = "Encode every collection as a sequence with a declared sort key and reject an unsorted or duplicate-keyed sequence with the unsorted result code rather than normalising it, because maps and sets do not exist on the wire."
do_3 = "Encode tagged unions as a one-byte tag plus tag body and reject an unknown tag deterministically instead of skipping the body."
do_4 = "Enforce every length limit from the protocol header at decode time before allocating, so an over-long element is rejected rather than accommodated."
do_5 = "Test that iteration order is byte-lexicographic and independent of insertion order, hash seed, pointer value and allocation order."
verify_cmd = "make test-codec-limits"
symbols = ["lxp_codec_write_bytes","lxp_codec_read_bytes","lxp_codec_write_seq","lxp_codec_seq_check_sorted","lxp_codec_write_tag"]
touches = ["src/codec/lxp_codec.c","include/layerx/lxp_codec.h","tests/codec/lxp_test_codec_composite.c"]
reqs = ["6.2","6.3","5.4"]

[task.2.3]
title = "Enforce version tagging, unknown fields and trailing byte rejection"
status = "done"
wave = 1
requires = ["2.1","2.2"]
do_1 = "Prefix every consensus-critical structure with its protocol version and structure tag, and reject an unknown version or tag with the unsupported-version result code."
do_2 = "Reject an unknown field identifier in a consensus-critical structure rather than skipping, ignoring or best-effort interpreting it."
do_3 = "Implement lxp_codec_finish returning the trailing-bytes result code whenever the decoder consumed fewer than all input bytes."
do_4 = "Reject non-minimal integer encodings, indefinite-length items, duplicate keys, unused padding and any second byte string that decodes to an already-representable logical value."
do_5 = "Assert that a decode rejection happens before authority evaluation, so it consumes no account sequence and charges no fee."
verify_cmd = "make test-codec-version"
symbols = ["lxp_codec_write_struct_header","lxp_codec_read_struct_header","lxp_codec_finish","lxp_codec_reject_unknown_field"]
touches = ["src/codec/lxp_codec.c","include/layerx/lxp_codec.h","tests/codec/lxp_test_codec_strict.c"]
reqs = ["6.2","6.6","6.9","2.10"]

[task.2.4]
title = "Publish the round-trip and rejection conformance corpora"
status = "done"
wave = 1
requires = ["2.3"]
do_1 = "Add tests/vectors/codec holding a valid corpus of canonical byte strings with their expected decoded values and expected digests."
do_2 = "Add an adversarial corpus covering non-minimal integers, unsorted sequences, duplicate keys, over-long lengths, truncation, trailing bytes and unknown tags, each carrying its expected result code."
do_3 = "Implement lxp_codec_vector_run walking both corpora and asserting encode, decode, re-encode equality and the exact expected result code for every case."
do_4 = "Declare these corpora the published wire conformance vectors that an independently written implementation must reproduce byte for byte."
do_5 = "Fail the suite when any vector lacks an expected result code, so a vector cannot be added without declaring its outcome."
verify_cmd = "make test-codec-vectors"
symbols = ["lxp_codec_vector_run","lxp_codec_vector_load","lxp_codec_vector_case"]
touches = ["tests/codec/lxp_test_codec_vectors.c","tests/vectors/codec/valid.lxv","tests/vectors/codec/adversarial.lxv"]
reqs = ["6.1","6.10","28.5","28.15"]

[task.2.5]
title = "Ship the codec fuzz targets"
status = "done"
wave = 1
requires = ["2.3"]
do_1 = "Add fuzz/lxp_fuzz_codec.c with a decode totality target asserting the decoder never crashes, hangs, reads out of bounds or allocates unbounded memory on arbitrary bytes."
do_2 = "Add a round-trip target asserting that encode of decode reproduces the input exactly for every input the decoder accepts."
do_3 = "Seed the corpus from the valid and adversarial vectors and keep every discovered crasher as a permanent regression input."
do_4 = "Add make fuzz-codec-smoke running a bounded iteration count under AddressSanitizer and UndefinedBehaviorSanitizer for CI."
do_5 = "Fail the target when a decoded value re-encodes to different bytes, because that is a second valid form of one logical value."
verify_cmd = "make fuzz-codec-smoke"
symbols = ["lxp_fuzz_codec_decode","lxp_fuzz_codec_roundtrip"]
touches = ["fuzz/lxp_fuzz_codec.c","fuzz/corpus/codec/seed.bin","Makefile"]
reqs = ["6.1","6.2","28.5"]

[task.3]
title = "Implement signatures, domain-separated hashing and Merkle commitments"
status = "pending"

[task.3.1]
title = "Implement domain-separated hashing"
status = "done"
wave = 1
requires = ["1.1","1.3"]
do_1 = "Add src/crypto/lxp_hash.c implementing SHA-256 in portable C17 with no assembly dependency and a streaming init, update and final interface."
do_2 = "Implement lxp_hash_domain prefixing every input with the distinct tag for its purpose, so identical bytes hashed under two purposes yield different digests."
do_3 = "Provide the purpose helpers for activity id, payload hash, signature preimage, authority hash, context hash and account id derivation, each bound to exactly one tag."
do_4 = "Test against the published SHA-256 vectors plus a cross-domain separation test asserting no two purposes collide on the same input."
do_5 = "Assert digests are byte-identical across optimisation levels and on a big-endian target build."
verify_cmd = "make test-crypto-hash"
symbols = ["lxp_hash_init","lxp_hash_update","lxp_hash_final","lxp_hash_domain","lxp_hash_sha256"]
touches = ["src/crypto/lxp_hash.c","include/layerx/lxp_hash.h","tests/crypto/lxp_test_hash.c"]
reqs = ["6.4","6.9","10.3"]

[task.3.2]
title = "Implement Ed25519 verification for agent identities"
status = "done"
wave = 1
requires = ["1.4","3.1"]
do_1 = "Add src/crypto/lxp_ed25519.c verifying in constant time over the domain-separated canonical byte string of the signed structure and never over a re-serialized, JSON or textual rendering."
do_2 = "Reject non-canonical encodings: non-canonical scalar forms, small-order and non-canonical public keys, and every malleable variant."
do_3 = "Implement lxp_ed25519_verify_batch for the verification worker pool, returning one boolean per input and never partial credit for a batch containing a failure."
do_4 = "Test against the published Ed25519 vectors plus the malleability edge cases, and assert a signature valid under one network id fails under another."
do_5 = "Add fuzz/lxp_fuzz_signature.c mutating signature bytes, keys and preimages and asserting every mutation is rejected without a crash."
verify_cmd = "make test-crypto-ed25519"
symbols = ["lxp_ed25519_verify","lxp_ed25519_verify_batch","lxp_ed25519_pubkey_is_canonical"]
touches = ["src/crypto/lxp_ed25519.c","include/layerx/lxp_crypto.h","tests/crypto/lxp_test_ed25519.c","fuzz/lxp_fuzz_signature.c"]
reqs = ["2.4","6.8","28.6"]

[task.3.3]
title = "Implement secp256k1 verification for Paxeer-facing certificates"
status = "done"
wave = 1
requires = ["3.1"]
do_1 = "Add src/crypto/lxp_secp256k1.c verifying ECDSA over the domain-separated canonical encoding of the certificate structure."
do_2 = "Reject high-S malleable forms, non-minimal encodings, wrong-curve points and any recovery identifier outside its declared range."
do_3 = "Provide address recovery solely for the optional EVM payout binding statement, and grant a recovered address no authority to move, debit or authorise any LayerX balance."
do_4 = "Test against the published secp256k1 vectors plus a low-S normalisation set and a wrong-domain-separator rejection set."
do_5 = "Keep secp256k1 out of the agent activity path entirely, so an Ed25519 agent signature can never be satisfied by a secp256k1 key."
verify_cmd = "make test-crypto-secp256k1"
symbols = ["lxp_secp256k1_verify","lxp_secp256k1_sig_is_low_s","lxp_secp256k1_recover_address"]
touches = ["src/crypto/lxp_secp256k1.c","include/layerx/lxp_crypto.h","tests/crypto/lxp_test_secp256k1.c"]
reqs = ["3.9","6.8","28.6"]

[task.3.4]
title = "Implement the Merkle tree for activity, receipt, event and state roots"
status = "done"
wave = 1
requires = ["2.2","3.1"]
do_1 = "Add src/crypto/lxp_merkle.c hashing leaves under one domain tag and internal nodes under a different one, so an internal node can never be reinterpreted as a leaf."
do_2 = "Specify and implement a single deterministic rule for leaf counts that are not a power of two, and reject any tree built under a different rule."
do_3 = "Implement lxp_merkle_root over a sorted leaf sequence, refusing to build from an unsorted or duplicate-keyed input."
do_4 = "Provide the builders the batch header needs for activity, receipt, event and oracle leaves so all four share exactly one implementation."
do_5 = "Test that the empty tree, the single-leaf tree and an odd-leaf-count tree each have exactly one specified root, byte-identical across architectures."
verify_cmd = "make test-merkle"
