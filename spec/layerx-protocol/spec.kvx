[task.5.2]
title = "Enforce the fsync and write-boundary discipline"
status = "done"
wave = 2
requires = ["5.1"]
do_1 = "Implement the per-activity write order: append the encoded activity and sync, execute on the writer, then append the receipt, effect list and state diff and sync again."
do_2 = "Define durable head as the highest global sequence holding both an activity record and its receipt, since an activity without a receipt never had durable effects."
do_3 = "Append the sealed batch header with its own sync before publishing anything derived from it."
do_4 = "Implement lxp_log_sync and lxp_log_durable_head so no acknowledged receipt can be lost or altered by a crash occurring after acknowledgement."
do_5 = "Add a fault-injection harness that aborts the process at each distinct durable write boundary and asserts the boundary invariant at that point."
