do_2 = "Implement lx_asset_receive_execute compiling asset.receive into a single leg from the grant payer account to the recipient main account, reusing the payer grant verification of the ledger rather than duplicating it."
do_3 = "Implement lx_asset_validate as a read-only admissibility check that mutates no state, so validation and execution stay separable and validation can never move value."
do_4 = "Reject with DIRECT_BALANCE_WRITE_FORBIDDEN any accepted activity or module effect that attempts to assign a balance value directly, and prove in test that the asset module holds the registry but no privilege over the ledger."
