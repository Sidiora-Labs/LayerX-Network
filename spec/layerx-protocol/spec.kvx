do_2 = "Implement lxp_exec_clock as the only time source visible to transition functions, reading the sealed batch timestamp and nothing else."
do_3 = "Route every time-dependent decision - timestamp_bound checks, authority and grant expiry, escrow timeout, stream accrual, funding interval and governance activation - through lxp_exec_clock."
