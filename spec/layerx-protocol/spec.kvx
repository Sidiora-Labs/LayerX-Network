do_2 = "Implement lx_escrow_partial_capture_execute to transfer exactly the named smaller amount to the beneficiary, reduce the remaining hold amount by exactly that amount, and keep the hold active for the remainder."
do_3 = "Implement lx_escrow_remaining as the authoritative remaining figure derived from the escrow subaccount balance, so allowance bookkeeping can never diverge from real funds."
do_4 = "Reject a capture exceeding the remaining amount with CAPTURE_EXCEEDS_HOLD, an unknown hold identifier, and a capturing authority that is neither the recorded beneficiary nor an authority delegated by the owner with UNAUTHORIZED_CAPTURE, moving no funds in any of those cases."
