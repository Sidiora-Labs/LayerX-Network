requires = ["17.1"]
do_1 = "Implement lxp_seq_allocator over the durable sequence watermark so every admitted activity occupies exactly one global sequence and no number is skipped, duplicated or reused across the whole chain history."
do_2 = "Implement lxp_admission_queue as a single-producer queue whose order is admission order, never verification completion order, so worker threads cannot influence sequencing."
do_3 = "Implement lxp_batch_range_check rejecting a batch whose first_sequence is not the previous last_sequence plus one, whose last_sequence is below first_sequence, or whose previous_state_root does not equal the prior resulting_state_root."
