do_2 = "Implement lxp_merkle_proof_verify recomputing the root from the leaf and path and comparing it in constant time against the expected root."
do_3 = "Reject a proof that reinterprets an internal node as a leaf, that exceeds the declared depth, or whose index disagrees with the path length."
do_4 = "Test that every leaf of trees sized one through one thousand yields a verifying proof, and that every single-bit mutation of a proof fails."
