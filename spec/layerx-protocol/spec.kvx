[task.9]
section = "Wave 5 — 402LXP Financial Kernel"
title = "Build the 402LXP ledger core as the single balance-mutation primitive"
status = "pending"

[task.9.1]
title = "Derive the account and subaccount namespace deterministically"
status = "done"
wave = 5
requires = ["8.1"]
do_1 = "Define the canonical account string grammar in include/layerx/lxp_ledger.h as ASCII, lowercase, colon-delimited with no empty segments, admitting exactly agent:did:main, agent:did:budget:id, agent:did:escrow:id, agent:did:stream:id, agent:did:margin:position, system:liquidity:market, system:funding:market:long, system:funding:market:short, system:insurance, system:fees, system:paxeer-reserve and system:paxeer-withdrawals."
do_2 = "Implement lx_account_id_from_string as the domain-separated commitment over the tag LX:ACCOUNT:v1 followed by a big-endian u32 length and the canonical string bytes, so the identifier is byte-identical on every node, architecture and implementation and stable for the account lifetime."
do_3 = "Implement lx_account_name_parse and lx_account_kind_of to classify a name into enum lx_account_kind, and reject any transfer leg naming an account outside the namespace with ERR_UNKNOWN_ACCOUNT_NAMESPACE."
do_4 = "Implement lx_account_open so that a credit to a namespace-valid account that does not yet exist creates it deterministically at that global sequence with a zero opening balance before the credit is applied, and records the creation in the append-only activity log so replay recreates it identically."
do_5 = "Reject any presented account identifier that does not equal the derivation of its declared namespace string with ERR_ACCOUNT_ID_MISMATCH, and reject closure of an account whose balance is non-zero with ERR_ACCOUNT_NOT_EMPTY."
do_6 = "Add fixed conformance vectors covering every namespace form, a derivation mismatch, an unknown namespace and a lazily created credit destination, asserting exact identifier bytes and exact result codes."
verify_cmd = "make test-ledger-accounts"
symbols = ["lx_account_id_from_string","lx_account_name_parse","lx_account_kind_of","lx_account_open","lx_account_lookup"]
touches = ["include/layerx/lxp_ledger.h","src/ledger/lx_account_id.c","src/ledger/lx_account_registry.c","tests/ledger/test_account_id.c"]
reqs = ["10.2","10.3","10.4","10.5","10.6","10.10"]

[task.9.2]
title = "Implement lxp_apply_transfer as the one balance-mutation primitive"
status = "done"
wave = 5
requires = ["9.1"]
do_1 = "Implement lxp_apply_transfer in src/ledger/lxp_apply.c as the one-leg case of the set form, and make that translation unit the only place in the tree that ever assigns struct lx_account.balance."
do_2 = "Implement lxp_precondition_check in the fixed order leg-count bound, non-zero amount, asset registered and unpaused, source and destination asset equality, neither endpoint frozen, authority covers every debited account, actor sequence exact, idempotency key unseen, batch timestamp within expiry, net debit within balance, credit addition overflow-free, per-asset conservation, so the failure code is deterministic and not merely the failure."
do_3 = "Route every amount computation through the checked helpers lx_u128_sub and lx_u128_add so an underflow returns LX_ERR_UNDERFLOW and an overflow returns LX_ERR_OVERFLOW instead of wrapping, saturating or truncating."
do_4 = "Capture from_balance_before, from_balance_after, to_balance_before and to_balance_after from the state actually mutated, and reject any payload carrying a client-asserted resulting balance or balance delta with ERR_CLIENT_SUPPLIED_BALANCE."
do_5 = "Add unit tests for zero amount, asset mismatch, unknown asset, frozen endpoint, insufficient balance, maximum-representable credit and an exact-boundary transfer, asserting the exact result code and unchanged balances for every rejection."
verify_cmd = "make test-ledger-transfer"
symbols = ["lxp_apply_transfer","lxp_precondition_check","lxp_balance_apply_leg","lxp_state_balance_get"]
touches = ["src/ledger/lxp_apply.c","include/layerx/lxp_transfer.h","include/layerx/lxp_ledger.h","tests/ledger/test_apply_transfer.c"]
reqs = ["7.1","7.9","8.6","8.7","8.8","13.4"]

[task.9.3]
title = "Implement atomic transfer sets with full rollback and per-asset conservation"
status = "done"
wave = 5
requires = ["9.2"]
do_1 = "Implement lxp_apply_transfer_set to open exactly one state journal, apply the legs in their declared order, and either commit every leg or roll the whole set back before any reader, index, event stream or receipt can observe an intermediate state."
do_2 = "Bind each set to exactly one authorisation context and one execution sequence for the authorising account, and emit exactly one receipt for the whole set rather than one receipt per leg."
do_3 = "Implement lxp_conservation_check accumulating debits and credits per asset in 256-bit accumulators, returning LX_ERR_CONSERVATION when the net supply change for any asset is non-zero, and rejecting any non-bridge set that would increase or decrease total supply."
do_4 = "Evaluate the non-negativity precondition on net per-account movement across the whole set so a set may legitimately credit an account before debiting it, and fail the entire set rather than reordering, netting or deferring legs."
do_5 = "Report the zero-based index and result code of the first failing leg in the failure result, emit no success receipt for any leg, and omit computed-zero legs before authorisation so a set never contains a zero-amount leg."
do_6 = "Implement lxp_transfer_set_root as a merkle commitment over the canonically encoded legs in execution order under distinct leaf and node domain tags, and test the four-leg liquidation template, a failing final leg, a supply-mutating set and a crash injected between legs."
verify_cmd = "make test-ledger-set"
symbols = ["lxp_apply_transfer_set","lxp_journal_open","lxp_journal_commit","lxp_journal_rollback","lxp_conservation_check","lxp_transfer_set_root"]
touches = ["src/ledger/lxp_apply.c","src/ledger/lxp_journal.c","include/layerx/lxp_transfer.h","tests/ledger/test_transfer_set.c"]
reqs = ["4.7","11.1","11.2","11.4","11.5","11.9","13.6"]

[task.9.4]
title = "Implement the SEND operation over the shared internal transfer function"
status = "done"
wave = 5
requires = ["9.3"]
do_1 = "Decode struct lxp_send with exactly the fields from, to, asset, amount, sequence, idempotency_key, expires_at, context_hash, conditions and authorization, rejecting an omitted field, an unknown field or a non-canonical encoding with ERR_MALFORMED_SEND."
do_2 = "Resolve the authorization to exactly one of the six admitted kinds, namely owner direct signature, session key, delegated capability, budget allowance, escrow authority or protocol-module capability, rejecting anything else with ERR_UNKNOWN_AUTHORITY_KIND and rejecting an authority that does not control the source account with ERR_UNAUTHORIZED_DEBIT."
do_3 = "Require sequence to equal exactly the next expected sequence of the account the authorization controls, consume it exactly once on success, and reject a lower or higher value with ERR_SEQUENCE_MISMATCH."
do_4 = "Evaluate expires_at and every declared condition against the batch-supplied timestamp only, returning ERR_EXPIRED or ERR_CONDITION_UNMET, and reject a submitted context_hash that differs from the one covered by the signed authorisation bytes with ERR_CONTEXT_MISMATCH."
do_5 = "Compile the accepted SEND into a one-leg transfer set with reason LXP_REASON_PAYMENT and hand it to lxp_apply_transfer_set, so SEND owns no balance-mutation code of its own."
do_6 = "Add a fuzz target over the SEND payload plus tests proving a byte-identical resubmission is rejected as a replay and a repeated idempotency key returns the first receipt with zero new economic effect."
verify_cmd = "make test-ledger-send"
symbols = ["lxp_send_decode","lxp_send_validate","lxp_send_execute","lxp_send_build_transfer_set"]
touches = ["src/ledger/lxp_send.c","include/layerx/lxp_ledger.h","tests/ledger/test_send.c","fuzz/fuzz_lxp_send.c"]
reqs = ["7.1","8.1","8.2","8.3","8.4","8.5","8.9","13.2"]

[task.9.5]
title = "Implement RECEIVE with signed payer grant storage and enforcement"
status = "done"
wave = 5
requires = ["9.4"]
do_1 = "Decode struct lxp_receive with exactly the fields from, to, asset, amount, grant_id, receiver_sequence, idempotency_key, context_hash, receiver_authorization and payer_grant, rejecting an omission or non-canonical encoding with ERR_MALFORMED_RECEIVE."
do_2 = "Implement lxp_verify_payer_grant to check the grantor signature over the canonical grant bytes and require the authorized recipient, asset, per-draw maximum, total or recurring allowance with its window length, expiration, permitted purpose, optional service or invoice identifier and revocation sequence, rejecting an incomplete grant with ERR_MALFORMED_GRANT and a missing grant with ERR_NO_PAYER_GRANT."
do_3 = "Persist grant draw state in the state tree through lxp_grant_store_put and lxp_grant_draw_record so drawn_total and drawn_this_period are protocol-maintained and monotone, rejecting a draw past a total allowance or past the current window allowance with ERR_GRANT_EXHAUSTED even when several RECEIVE activities are ordered in the same batch."
do_4 = "Reset the recurring allowance at the deterministic start of each window computed from the batch timestamp, carry no unused allowance forward, and reject a grant past its expiration with ERR_GRANT_EXPIRED and a grant superseded by lxp_grant_revoke with ERR_GRANT_REVOKED from the revocation global sequence onward."
do_5 = "Reject a recipient that is not the named authorized recipient, an asset or account pair that does not match the grant, a purpose that the context_hash does not commit to, and an already settled invoice identifier, with ERR_GRANT_SCOPE_VIOLATION, ERR_PURPOSE_MISMATCH or ERR_INVOICE_ALREADY_SETTLED, moving no value."
do_6 = "Compile the accepted RECEIVE into the identical internal transfer set that SEND builds, so the emitted receipt differs from a SEND receipt only in the operation field and the authorisation evidence, and test that a recipient can never debit an account for which no grant exists."
verify_cmd = "make test-ledger-receive"
symbols = ["lxp_receive_execute","lxp_verify_payer_grant","lxp_grant_store_put","lxp_grant_draw_record","lxp_grant_revoke"]
touches = ["src/ledger/lxp_receive.c","src/ledger/lxp_grant_store.c","include/layerx/lxp_ledger.h","tests/ledger/test_receive.c"]
reqs = ["7.1","9.1","9.2","9.3","9.4","9.5","9.7","9.9","9.10","13.3"]

[task.9.6]
title = "Emit the 402LXPReceipt and lock the ledger as the only balance writer"
status = "done"
wave = 5
requires = ["9.5"]
do_1 = "Implement lxp_receipt_build populating protocol_version, transaction_id, operation, global_sequence, asset, amount, from, from_balance_before, from_balance_after, from_sequence, to, to_balance_before, to_balance_after, transfer_set_root, authorization_hash, context_hash, previous_state_root, resulting_state_root, batch_id and timestamp entirely from the state the ledger just mutated."
do_2 = "Guarantee for a single-leg operation that from_balance_after equals from_balance_before minus amount and to_balance_after equals to_balance_before plus amount, and for a multi-leg set that transfer_set_root commits to every leg in execution order."
do_3 = "Sign the canonical binary encoding of the receipt under the sequencer identity named in the batch header with lxp_receipt_sign, implement lxp_receipt_verify against the published sequencer key with no further node interaction, and append the receipt durably before it is returned so replay reproduces it exactly."
do_4 = "Return byte-identical receipt content for two submissions sharing an idempotency key, keep exactly one durable receipt per successful transfer or transfer set, and emit no signed receipt at all for a failed operation, only a failure result carrying the result code and unchanged balances."
do_5 = "Add tools/lxp_check_sole_writer.sh asserting that struct lx_account.balance is assigned in exactly one translation unit, src/ledger/lxp_apply.c, that no object under src/modules links the internal apply symbols, and that no balance-write entry point is exposed on the module context."
do_6 = "Wire lxp_balance_writer_guard and the sole-writer script into the test-ledger-receipt target so any bypass fails verification with ERR_BALANCE_BYPASS rather than being merely discouraged."
verify_cmd = "make test-ledger-receipt"
symbols = ["lxp_receipt_verify","lxp_balance_writer_guard"]
touches = ["src/ledger/lxp_receipt.c","include/layerx/lxp_receipt.h","tools/lxp_check_sole_writer.sh","tests/ledger/test_receipt.c"]
reqs = ["7.2","12.1","12.2","12.3","12.4","12.10","13.7","13.10"]

[task.10]
section = "Waves 6-9 — Native Protocol Modules"
title = "Build the asset module over the ledger kernel"
status = "pending"

[task.10.1]
title = "Implement the asset registry with integer decimals"
status = "done"
wave = 6
requires = ["9.1"]
do_1 = "Register the asset module as module id 1 through the kernel module interface, declaring exactly the activity types asset.register, asset.pause, asset.unpause, asset.account_open, asset.send, asset.receive, asset.grant_issue, asset.grant_revoke, asset.mint and asset.burn, at ordinals 1 through 8, 10 and 11; ordinal 9 is reserved."
do_2 = "Implement lx_asset_register recording asset_id, symbol, decimals, custody kind and the Paxeer custody reference, rejecting a duplicate asset id with ASSET_ALREADY_REGISTERED while still consuming the sequence and charging the metered fee."
do_3 = "Treat decimals strictly as display metadata: every amount is an unsigned fixed-width integer count of the smallest indivisible unit, and any amount encoded as a decimal fraction, an exponent form or a floating point value is rejected with INVALID_AMOUNT."
do_4 = "Implement lx_asset_pause and lx_asset_unpause so a paused asset fails the ledger precondition for every leg naming it, and expose lx_asset_lookup for the ledger to resolve asset existence and paused state."
