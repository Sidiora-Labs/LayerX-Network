do_1 = "Implement lx_budget_periods_elapsed as integer division of the batch timestamp minus period start by the period length, with no timer, no cron and no wall-clock read anywhere in the path."
do_2 = "Implement lx_budget_rollover to advance the period start by whole period lengths and reset the remaining allowance to the configured per-period limit at the first activity in a batch that observes the boundary."
do_3 = "Implement the carry-forward policy by adding unspent allowance into the new period up to the configured carry cap and discarding the excess, and the discard policy by dropping all unspent allowance."
do_4 = "Drive lazy rollover from both lx_budget_epoch_begin and the spend path so a budget untouched for many periods rolls forward identically however it is next observed."
