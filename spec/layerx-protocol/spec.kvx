[task.21.6]
title = "Apply one fee rejection policy and prove fee replay"
status = "done"
wave = 12
requires = ["21.5"]
do_1 = "Implement lxp_fee_admission_check so an activity failing admission is assigned no global sequence, consumes no account sequence and is charged nothing."
do_2 = "Implement lxp_fee_rejection_policy so an admitted activity that fails execution consumes its account sequence exactly once, is charged the computed fee up to fee_limit, and yields a durable failure receipt with zero module effects."
do_3 = "Charge the fee before applying any module effect so the fee transfer can never fail because of the activity own spending."
do_4 = "Implement lxp_fee_replay_check asserting that replay from the log reproduces every fee_charged value, the fee treasury balance and every resulting state root exactly."
do_5 = "Test the boundary where the computed fee equals fee_limit exactly, and the case where it exceeds it by one base unit."
