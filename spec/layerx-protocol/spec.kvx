do_2 = "Implement lx_bridge_verify_deposit to fail closed unless the activity carries a finalised Paxeer custody proof bound to a registered checkpoint state root and matching the executing network_id and protocol_version, rejecting otherwise with DEPOSIT_PROOF_NOT_FINAL."
do_3 = "Implement lx_deposit_nullifier_consume so a custody reference or deposit identifier already credited is rejected with DEPOSIT_ALREADY_CREDITED and a replayed proof produces at most one economic result."
do_4 = "Assert at runtime that a deposit credit lacking a finalised custody proof aborts the transition under invariant 12 rather than crediting anything."
