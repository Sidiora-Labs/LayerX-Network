reqs = ["3.2","3.3","6.1","9.3"]

[task.7.3]
title = "Implement the authority resolver inside the state machine"
status = "done"
wave = 3
requires = ["3.2","7.2"]
do_1 = "Implement lxp_authority_resolve accepting exactly the six kinds owner direct signature, session key, delegated capability, budget allowance, escrow authority and protocol-module capability, and rejecting any other kind."
do_2 = "Produce lxp_authority_resolved carrying actor, the principal whose funds may move, kind, verified key, scope pointer and authority hash."
do_3 = "Compute the authority hash as a domain-separated commitment over kind, grant id and verified key, and record it in every receipt so every debit is attributable to one named authority artifact."
do_4 = "Reject an authority that does not explicitly name the activity type being executed, or that names a broader scope than the module declares for that type."
do_5 = "Evaluate every authorisation decision inside the deterministic transition, consulting no HTTP session state, no gateway authentication, no in-memory challenge and no transport credential."
do_6 = "Test that the identical activity yields the identical authorisation result code on every node even when the submitting gateway accepted the request."
verify_cmd = "make test-authority-resolve"
symbols = ["lxp_authority_resolve","lxp_authority_resolved","lxp_authority_hash","lxp_authority_check_scope"]
touches = ["src/state/lxp_authority.c","include/layerx/lxp_authority.h","tests/state/lxp_test_authority_resolve.c"]
reqs = ["3.7","3.10","8.2","13.2"]

[task.7.4]
title = "Enforce delegated spending and trading limits"
status = "done"
wave = 3
requires = ["4.3","7.3"]
do_1 = "Implement lxp_authority_charge_allowance accumulating consumption against the grant inside state at execution time, never in a cache and never at admission only."
do_2 = "Reject the first activity that would carry cumulative consumption past the per-activity, total or per-period limit, so concurrent or reordered submissions cannot exceed a limit in aggregate."
do_3 = "Implement lxp_authority_period_roll advancing the period start by whole period lengths at the first activity that observes the boundary and resetting the remaining allowance deterministically."
do_4 = "Never carry unused recurring allowance forward, so an unused window is permanently unusable rather than accumulating into the next one."
do_5 = "Use only checked fixed-width arithmetic for allowance accumulation, rejecting with the overflow code rather than wrapping."
do_6 = "Test that a total allowance is exhausted at exactly the declared unit and never one unit past it, including several draws ordered inside a single batch."
verify_cmd = "make test-allowance"
symbols = ["lxp_authority_charge_allowance","lxp_authority_period_roll","lxp_authority_spend_check"]
touches = ["src/state/lxp_authority.c","include/layerx/lxp_authority.h","tests/state/lxp_test_allowance.c"]
reqs = ["3.4","9.5","9.6","13.2"]

[task.7.5]
title = "Implement revocation, expiry and monotone amendment"
status = "done"
wave = 3
requires = ["7.3"]
do_1 = "Implement lxp_authority_revoke marking a grant unusable from the global sequence of the revocation onward, applying to activities already submitted but not yet executed."
do_2 = "Implement bulk revocation by bumping the identity revocation sequence, invalidating every grant referencing the superseded value in one activity without enumerating them."
do_3 = "Reject a revocation or capability update whose revocation sequence is not strictly greater than the recorded one, so a replayed authorisation can never reinstate a revoked delegate."
do_4 = "Implement lxp_authority_amend as narrowing only, permitting lower caps, earlier expiry and fewer modules, and requiring a fresh grant to widen anything."
do_5 = "Reject an expired authority using only the batch-supplied timestamp, and never retroactively invalidate an activity already executed before the revocation sequence."
verify_cmd = "make test-revocation"
symbols = ["lxp_authority_revoke","lxp_authority_amend","lxp_authority_is_live","lxp_identity_bump_revocation_sequence"]
touches = ["src/state/lxp_authority.c","include/layerx/lxp_authority.h","tests/state/lxp_test_revocation.c"]
reqs = ["3.5","3.6","9.8","16.9"]

[task.7.6]
title = "Implement key rotation, recovery and the optional EVM payout binding"
status = "done"
wave = 3
requires = ["3.3","7.1"]
do_1 = "Implement two-phase rotation: lxp_identity_rotate_announce records the pending key and effective timestamp, and lxp_identity_rotate_commit promotes it only after the configured challenge delay measured in batch timestamps."
do_2 = "Verify both the old and the new key inside the rotation window so an in-flight activity signed by the superseded key is not orphaned, and treat a lapsed rotation as a no-op rather than a lockout."
do_3 = "Reject a competing rotation submitted during an open challenge delay and invalidate the superseded key for every activity executed at or after the effective sequence."
do_4 = "Implement k-of-n recovery where lxp_identity_recover_begin opens a challenge window in which the existing primary key can veto, and lxp_identity_recover_commit applies only after that window elapses."
do_5 = "Implement lxp_identity_bind_evm_payout requiring a secp256k1 signature over a domain-separated binding statement naming the DID and network id, and granting the bound address no authority to move, debit or authorise any balance."
do_6 = "Test that retirement is refused unless every balance in every asset is zero, so no value is stranded outside the reachable account namespace."
verify_cmd = "make test-rotation"
symbols = ["lxp_identity_rotate_announce","lxp_identity_rotate_commit","lxp_identity_recover_begin","lxp_identity_recover_commit","lxp_identity_bind_evm_payout"]
touches = ["src/state/lxp_identity.c","include/layerx/lxp_identity.h","tests/state/lxp_test_rotation.c"]
reqs = ["3.8","3.9","5.7","10.6"]

[task.8]
title = "Implement the activity kernel and module dispatch"
status = "pending"

[task.8.1]
title = "Implement the kernel state handle and the module registration table"
status = "done"
wave = 4
requires = ["5.6","6.4","7.3"]
do_1 = "Add src/protocol/lxp_kernel.c defining the kernel handle over the state tree, the journal, the parameter set and the registered module table."
do_2 = "Define lxp_module_iface with module id, ABI version, name and the genesis, decode, validate, execute, epoch begin, epoch end, state root and release entry points."
do_3 = "Restrict the kernel to identities, accounts, assets, authority, nonces and sequences, fees, state transitions, events, receipts, checkpoints and modules, defining no payment product, market rule, service workflow or oracle semantic."
do_4 = "Implement lxp_kernel_register_module recording the module identifier, its version and the exhaustive list of activity types it declares, whether at genesis or by a governance activity."
do_5 = "Reject with the unknown activity code any activity whose type is not declared by a currently registered and epoch-enabled module."
do_6 = "Reserve module ids one through eight for asset, escrow, budget, stream, service, perps, governance and bridge, none of them privileged above the kernel rules."
