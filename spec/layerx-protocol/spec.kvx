[task.24.3]
title = "Reconcile the manifest against Paxeer custody or reject it"
status = "done"
wave = 14
requires = ["24.2"]
do_1 = "Implement lxp_custody_attestation_verify to read the Paxeer attested custody amount per asset from a finalised custody state, never from an operator assertion."
do_2 = "Implement lxp_genesis_reconcile to require, for every asset, exact equality between the attested custody amount and the sum of imported account, subaccount, hold, margin and pool balances."
