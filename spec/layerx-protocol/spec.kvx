do_2 = "Implement lxp_paxeer_slash_submit to accept a portable equivocation proof from any party and slash without any judgement about correctness, because the contradiction is self-evident."
do_3 = "Implement lxp_paxeer_jail_guarantor to remove a slashed or under-bonded guarantor from the active attesting set immediately."
do_4 = "Exclude signatures from jailed, removed or under-bonded guarantors from every threshold count even when cryptographically valid."
