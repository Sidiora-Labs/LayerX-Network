[task.5]
title = "Implement the append-only activity log, SQLite projections and crash recovery"
status = "pending"

[task.5.1]
title = "Implement the append-only log record framing and segment files"
status = "done"
wave = 2
requires = ["1.2","2.2","4.1"]
do_1 = "Add src/storage/lxp_log.c defining lxp_log_record_header with the log magic, record kind, a reserved field that must be zero, global sequence, body length, body CRC32C and the previous record offset."
do_2 = "Support exactly the record kinds activity, receipt, batch header, checkpoint, state diff, oracle and genesis, rejecting an unknown kind rather than skipping it."
do_3 = "Pre-allocate fixed-size segment files named by zero-padded sequence so an append never extends a file and never hits an out-of-space failure mid-record."
do_4 = "Implement lxp_log_append writing canonical body bytes only, never rewriting a record, so compaction can only create snapshots alongside history."
