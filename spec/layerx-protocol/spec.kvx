[task.4.2]
title = "Implement the 256-bit widening multiply and floor division"
status = "done"
wave = 1
requires = ["4.1"]
do_1 = "Define lxp_u256 as four uint64 words and implement lxp_u128_mul widening to 256 bits, so the multiply-then-divide shape of every ratio computation never loses precision to an intermediate overflow."
do_2 = "Implement lxp_u256_div_floor returning quotient and remainder with the divide-by-zero result code, and lxp_u256_add for the conservation accumulators."
do_3 = "Specify that integer division floors and that every residue is explicitly returned to the caller rather than dropped, so dust is never implicit."
do_4 = "Return the overflow result code when a 256-bit quotient does not fit the requested 128-bit output, rather than truncating it."
do_5 = "Test the full carry chain across all four words and the divisor boundaries one, two to the sixty-fourth power and max."
