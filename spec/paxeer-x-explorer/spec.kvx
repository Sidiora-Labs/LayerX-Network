# spec.kvx - Paxeer X Network explorer. SINGLE SOURCE OF TRUTH for this feature.
#
# requirements.md / design.md / tasks.md next to this file are GENERATED from it
# by spec/specgen. Never hand-edit those; edit this file and regenerate.
#
# Drive the work with:  cg spec next -> cg spec start <id> -> cg spec done <id>
#
# Two bodies of work share one feature because they share one bar: the fork of
# the explorer has to finish, and the repository's own continuous integration
# has to be green while it does. Wave 1 closes every red job and builds the
# gates the later work is measured by. Wave 2 finishes the fork. Wave 3 runs the
# aggregate explorer suites once on the merged revision and records what ran.

[meta]
feature   = "paxeer-x-explorer"
title     = "Paxeer X Network Explorer - Fork Completion and CI Closure"
kind      = "product-feature-specification"
version   = "0.1.0"
status    = "active"
language  = "Elixir (Blockscout backend umbrella), TypeScript and React (Next.js frontend), Rust (smart-contract-verifier and sig-provider services), Solidity, POSIX shell gates, GitHub Actions workflows, SQL migrations"
repo_root = "explorer/ (the vendored Blockscout fork: backend, frontend, services, deploy); tools/explorer/ (the explorer gates); .github/workflows/ (continuous integration); contracts/ and human/apps/web/ (the two surfaces outside the fork this feature repairs); spec/paxeer-x-explorer/ (this feature and its qualification log)"
upstream  = "Blockscout backend v10.2.6 umbrella, Blockscout frontend v2.7.2 and the blockscout-rs smart-contract-verifier and sig-provider, vendored under explorer/ with their GPL licence, module layout and coding conventions intact (explorer/UPSTREAM.md records the vendored revisions); spec/layerx-beta remains binding for the human control plane and the beta contract, and nothing here relaxes one of its requirements"
intro     = "The explorer of Paxeer X Network is a GPL fork of Blockscout carried in explorer/: an Elixir umbrella backend, a Next.js frontend and two Rust services, indexing the Paxeer X chain and, through the kernel precompiles, the LayerX kernel entities the chain anchors. The fork already carries the chain adapter, the status ladder, the lx_* tables and their import runners, the unified account, anchor, receipt, capability and transaction-status API paths, and the frontend presets, list pages and unified account page. This feature finishes it and pays the debt around it. It closes every continuous-integration job that is red on the main branch - CodeQL's Go analysis, the publication audit, the C17 build, the platform contract and ledger checks, the agent workspace build and its sanitizer variants, the human workspace lint gate and its web image, and the documentation site build - by fixing the cause each job names, never by skipping, relaxing or allow-listing it. It adds the gates the explorer has been missing: a lint job over the backend, the frontend and the services; a test-ratio gate that requires a changed source file under explorer/ to be accompanied by a test file that references it; and the two bounded fleet gates the workflow contract already names. It then completes the fork itself: the product design tokens applied to the frontend theme, search that resolves pax addresses, decentralised identifiers and kernel account ids through the backend search path instead of guessing a route, a receipt detail page for the receipt endpoint that has one, OpenAPI schemas for all six Paxeer X paths, decoding for every kernel precompile event rather than most of them, an upstream test-isolation defect repaired without weakening an assertion, the wrapped-coin contract named for the coin, a database copy tool that is idempotent and resumable against a pinned block ceiling, deployment definitions that name the published fork images with a compose smoke test behind them, a backend that binds its port after migration, and one explorer surface instead of two. Throughout, the product is Paxeer X Network and LayerX names only the kernel domain: chain-side modules and configuration read paxeer_x or PaxeerX, and kernel-side entities keep their lx_ prefix."

# Decisions locked before implementation begins. They bind every task in this
# feature; where they touch the human control plane or the beta contract they
# defer to spec/layerx-beta, which stays normative.
[decision]
code_quality        = "A+ on every changed path: real code paths, real types, real fixtures. No stub, mock or fake test double on a production path, no placeholder implementation, no TODO, FIXME or 'for now' comment, no dead branch left behind to be cleaned up later. A test exercises the module it names through its public interface with data shaped like production data; a test that would need a fake to pass is a signal that the implementation is wrong, not that the test needs a double."
no_weakening        = "Inherited from workflow.kvx and restated because this feature's whole first wave is failing checks: no assertion is relaxed, no bound loosened, no type widened, no silent fallback added, no test skipped, deleted or marked pending, no lint rule disabled on a file this fork owns, and no continue-on-error added to a workflow to make a job report success. Where the code and a check disagree, both stay exactly as written and the conflict is recorded in spec/paxeer-x-explorer/qualification.kvx."
test_ratio          = "Every task's touches list names its test files explicitly, and a task that changes a source file under explorer/ changes or adds at least one test file that references it - an Elixir *_test.exs, a TypeScript *.test.ts, *.test.tsx, *.spec.ts, *.spec.tsx or *.pw.tsx, or a Rust #[cfg(test)] module or tests/ file. tools/explorer/test-ratio.sh enforces the ratio over a git range in continuous integration. Shell scripts, YAML workflows, environment presets, JSON deployment definitions, SVG marks and Markdown are not source files for the ratio and need no test file; the script that enforces the ratio has its own test."
testing_allowance   = "Testing time is bounded on purpose. Every task's verify_cmd is one command wrapped in `timeout 20m`, run from the repository root. A task gets one build of its declared targets and one verify_cmd run, then at most two task-scoped repair cycles, each followed by exactly one rerun. Aggregate suites, the full explorer test matrix and the lint matrix run once, in the wave gate task of wave 3, never per task and never per rebase. A task whose verify_cmd exceeds its timeout stops and reports implemented-not-qualified with the exact command, exit code and log path; that is an acceptable outcome and is never dressed up as a pass."
naming              = "The product is Paxeer X Network. LayerX is the name of the kernel domain only. Chain-side modules, configuration keys, chain-type values and asset paths read paxeer_x, PaxeerX or paxeer-x; kernel-side database entities, columns and schema modules keep the lx_ prefix that the migrations already use. The coin is Paxeer, its symbol is PAX and it has 18 decimals. No file, comment, commit message or log line introduced by this feature carries a date, a hostname, an IP address, a port of an internal host, an internal URL or the name of an agent or a working branch."
generated_files     = "CLAUDE.md, AGENTS.md, .github/copilot-instructions.md, .codify/agent-context.md and the requirements.md, design.md and tasks.md mirrors under spec/*/ are generated and off limits: edit spec/workflow.kvx or this file and regenerate. explorer/frontend/nextjs/nextjs-routes.d.ts is generated by the nextjs-routes plugin and is regenerated by its generator, never hand-edited."
production_safety   = "No task touches the production deployment project, its services, its variables or its domains, and no task reads, writes or commits a .env file or any secret. Deployment work in this feature changes only the definitions committed under explorer/deploy. Credentials and endpoints enter a task through an environment variable name documented in explorer/deploy/env, never through a literal value."
upstream_conventions = "explorer/ is a fork, not a rewrite. Upstream Blockscout file layout, module naming, formatter settings and idioms are preserved so the fork can take upstream changes: an Elixir module lives where its name says it lives, a frontend component follows the toolkit and Chakra recipe conventions already in the tree, a Rust service keeps its workspace shape. Files this fork owns - anything named paxeer_x, PaxeerX, paxeer-x or lx_* - carry the fork's naming; upstream files are changed only where the task requires it and as narrowly as the change allows."
publication         = "A qualified task is published immediately: one commit per task from the repository root describing the change honestly and naming the gates that actually ran, pushed before the next task starts, with a co-author trailer naming the model that ran the task. Several tasks are never batched into one commit and a finished task is never left unpushed."
lint_policy         = "A lint finding in a file this fork owns is fixed in the code. A finding inherited from upstream that would require a mass edit of vendored files is silenced only by a scoped configuration entry - a credo file or check exclusion, an eslint override with an explicit file glob - that names the upstream path it covers and carries a one-line reason in the configuration itself. A rule is never disabled globally, never disabled on a fork-owned file, and a job is never marked continue-on-error."

[design]
overview = "Three waves with one shape each. Wave 1 is repair plus scaffolding: seven tasks that each own one red continuous-integration job or job pair and fix what it names, and six tasks that build the explorer's own gates - the containerised mix runner every later Elixir task qualifies through, one lint script per language, the test-ratio script, the two CI jobs and the two bounded fleet gates. Wave 2 is the fork's remaining surface, twelve tasks whose touched paths are disjoint so they run in parallel: the frontend theme owns the toolkit theme, the presets and the marks; search owns the search bar and its routing helper; the receipt detail page owns its route, its view and its types; the API schema task owns the Paxeer X controllers and the schema modules; the event-decoding pair owns first the new tables and their runners and then the transform; the isolation task owns the factory and the fetcher it defeats; and the copy tool, the deployment definitions, the boot fix, the wrapped-coin contract and the retirement of the duplicate explorer surface each own their own tree. Wave 3 runs the aggregate explorer suites once on the merged revision and writes the gate records."

[tasks]
heading = "Implementation Plan: Paxeer X Network Explorer"

# --------------------------------------------------------------------------
# REQUIREMENTS
# --------------------------------------------------------------------------

[req.1]
title = "Continuous Integration Green on Main"
story = "As anyone reading this repository, I want every workflow on the main branch to pass for the reason it exists, so that a red check means something broke and a green check means something works."
ac_1 = "THE CodeQL workflow SHALL analyse Go with a build mode Go supports, SHALL keep every other analysed language on the build mode it already declares, and SHALL declare each language exactly once, proven by a check over .github/workflows/codeql.yml that runs without the CodeQL service."
ac_2 = "THE publication audit SHALL pass with the two upstream fixtures that carry credential-shaped strings replaced by obviously synthetic values that keep their tests meaningful, and the audit's own allowlist SHALL NOT be widened unless the audit tool documents an allowlist for exactly that case; the secret-scan allowlist SHALL NOT be touched."
ac_3 = "THE C17 build-and-test job SHALL pass under both declared compilers with the defect the job log names fixed in the core or in its test, and SHALL NOT be made to pass by suppressing a diagnostic, excluding a test or narrowing the target set."
ac_4 = "THE platform contract and ledger step SHALL pass with the disagreement it reports repaired at its source - the contract, the ledger record or the check's input - and the two checks SHALL keep every rule they enforce."
ac_5 = "THE agent workspace build, lint and boundary step SHALL pass and the two named daemon tests - the terminal transition case in the native protocol-evidence suite and the confirmed-creation budget case - SHALL pass for the behaviour they assert, with no assertion relaxed and no case ignored; the sanitizer variants SHALL run the same tests clean."
ac_6 = "THE human workspace lint step SHALL pass with the four reported eslint errors fixed in their source files, the workspace dependency installation the job depends on SHALL be present in the workflow, and the human web image SHALL build from the repository's tracked sources so the browser-performance job can bring its cluster up."
ac_7 = "THE documentation site job SHALL install its pinned tooling with a valid installer invocation and SHALL build the site under strict mode."
ac_8 = "THE explorer build and image workflows SHALL stay green through every change this feature makes, and no job in any workflow SHALL be marked continue-on-error, skipped by a condition added for this purpose, or deleted to reach a green run."
ac_9 = "EVERY repair in this requirement SHALL start from the failing job's own log, and the task SHALL record the exact failing command and exit code it observed; a repair that cannot be traced to the log is out of scope and SHALL be recorded in the qualification log instead."

[req.2]
title = "Explorer Lint Gates"
story = "As a maintainer taking upstream changes into the fork, I want formatting and static analysis enforced on every explorer pull request, so that the fork's own code stays clean and an upstream merge does not quietly regress it."
ac_1 = "THE backend SHALL pass `mix format --check-formatted` and `mix credo --strict` from explorer/backend, run through the containerised builder, with every finding in a fork-owned module fixed in that module."
ac_2 = "THE frontend SHALL pass `yarn lint:eslint` and `yarn lint:tsc` from explorer/frontend with every finding in a fork-owned file fixed in that file."
ac_3 = "EACH Rust service SHALL pass `cargo fmt --check` and `cargo clippy --all-targets -- -D warnings` from its own directory."
ac_4 = "THE explorer build workflow SHALL carry an explorer-lint job that runs those three checks on every pull request that touches explorer/, with no continue-on-error and no conditional skip, and each check SHALL be invocable locally through one script per language so a developer runs exactly what the job runs."
ac_5 = "WHERE a finding is inherited from vendored upstream code and fixing it would require a mass edit THE silencing SHALL be a scoped configuration entry naming the upstream path it covers together with a one-line reason recorded in the configuration; no rule SHALL be disabled globally or on a fork-owned file."

[req.3]
title = "Test Ratio Gate"
story = "As the owner of this fork, I want a changed source file to arrive with a test that references it, so that the fork's coverage grows with the fork instead of behind it."
ac_1 = "THE repository SHALL carry tools/explorer/test-ratio.sh which, for a git range given as its argument, counts the non-test source files changed under explorer/ and the test files changed or added in the same range, and fails when the test files are fewer than the source files."
ac_2 = "THE script SHALL count as a source file an Elixir .ex, a TypeScript or TSX file that is not a test, and a Rust .rs that is not a test module, and SHALL count as a test file an Elixir *_test.exs, a TypeScript *.test.ts, *.test.tsx, *.spec.ts, *.spec.tsx or *.pw.tsx, and a Rust file under a tests/ directory or carrying a #[cfg(test)] module; shell, YAML, JSON, environment presets, SVG and Markdown SHALL be counted as neither."
ac_3 = "THE script SHALL require each counted test file to reference at least one of the changed source files by module name, component name or path, SHALL name in its failure output every source file left without a referencing test, and SHALL exit zero when the range changes no explorer source file."
ac_4 = "THE explorer build workflow SHALL run the script on pull requests over the range from the merge base to the head commit, and explorer/README.md SHALL document the rule, the file classifications and how to run the script locally."
ac_5 = "THE script SHALL have its own test that builds a throwaway git history covering a satisfied ratio, an unsatisfied ratio, a test that references nothing changed and a range with no explorer source change, and asserts the script's exit code for each."

[req.4]
title = "Bounded Fleet Gates"
story = "As the integrator landing a wave, I want one test gate and one lint gate that run the explorer suites the same way everywhere and stop at a known bound, so that landing a branch is a decision, not an open-ended session."
ac_1 = "THE repository SHALL carry tools/explorer/gate-test.sh and tools/explorer/gate-lint.sh, the two paths the workflow contract already names as the test and lint gates, each executable from the repository root and each returning a non-zero exit code on any failure of the work it gates."
ac_2 = "THE test gate SHALL run the backend Paxeer X suites and the frontend vitest suite through the containerised builder with a fresh database sidecar per invocation, and the lint gate SHALL run the same three language checks the explorer-lint job runs."
ac_3 = "EACH gate SHALL be bounded by a budget in seconds taken from the environment with a documented default, SHALL stop at that budget, and SHALL report the command, the exit code and the log path of whatever it stopped on rather than continuing."
ac_4 = "EACH gate SHALL support a check mode that validates its own syntax, its required tooling and its container recipe without running a suite, so that the gate itself can be qualified inside a task budget."
ac_5 = "THE containerised builder invocation SHALL live in one script, explorer/deploy/tools/mix-in-builder.sh, used identically by the gates, by the lint scripts and by every task that runs a mix command, so there is one recipe to fix when the toolchain moves."

[req.5]
title = "Frontend Theme"
story = "As a person arriving at the explorer from the rest of the product, I want it to look like the same product, so that nothing suggests I have left it."
ac_1 = "THE explorer frontend theme foundations - colours, typography, borders, shadows and semantic tokens - SHALL carry the product design tokens: the product typeface, the black pill primary button, the accent blue with its strong and soft variants, the page background, the white surface and the sunken surface, the two border tones, the three text tones, the success, destructive and warning pairs, the declared radii and the card and overlay shadows."
ac_2 = "THE global styles and the toolkit recipes that render buttons, inputs, tables, tabs, badges, links and dialogs SHALL consume those tokens through the theme rather than through literal values, and both the light and the dark appearance SHALL resolve every token they use."
ac_3 = "THE Paxeer X environment presets SHALL set the colour theme override and the font family variables to the same values the theme declares, so a deployment rendered from a preset matches the theme."
ac_4 = "THE marks under the Paxeer X static asset directory SHALL be the product marks in their light and dark variants and SHALL be referenced by the presets."
ac_5 = "THE change SHALL add no dependency and SHALL introduce no second styling system; the theme stays the Chakra theme the fork already uses."
ac_6 = "A test SHALL assert the token values the theme exports for the primary button, the accent, the surfaces, the text tones, the radii and the shadows, so a later edit that drifts from the product tokens fails."

[req.6]
title = "Search That Resolves Kernel Identities"
story = "As someone pasting a pax address, a decentralised identifier or a kernel account id into the search bar, I want to land on the account it belongs to, so that an identity I hold resolves like any other."
ac_1 = "WHEN the search bar receives a pax bech32 address, a decentralised identifier, a kernel account id or a bare 32-byte kernel key THE frontend SHALL query the backend search path, which resolves those spellings through the recorded account bindings, instead of routing straight to the unified account page."
ac_2 = "WHEN the search path resolves the term to an address THE frontend SHALL navigate to that address's unified account view; WHEN it resolves to nothing THE frontend SHALL render the ordinary empty search result, never a page that can only fail."
ac_3 = "THE identifier parser SHALL keep recognising each supported spelling and SHALL keep rejecting anything it does not recognise, and its existing cases SHALL remain unchanged."
ac_4 = "BOTH the desktop and the mobile search entry points SHALL follow the same resolution path so the two cannot diverge."
ac_5 = "A test SHALL cover each supported spelling resolving to an address, an unresolvable identity rendering the empty result, and an ordinary address or transaction hash keeping its existing route."

[req.7]
title = "Receipt Detail"
story = "As someone reading a kernel receipt in the list, I want to open it, so that I can see its verification status, its payload hash, the transaction that carried it and when it happened."
ac_1 = "THE frontend SHALL carry a receipt detail route under the Paxeer X receipts path that reads the single-receipt API endpoint by receipt id."
ac_2 = "THE detail view SHALL render every field the endpoint returns - the receipt id, the kernel account, the settlement rung, the block number, the verification status, the payload hash, the transaction hash and the timestamp - with the transaction hash linking to the transaction page and the block number to the block page."
ac_3 = "THE types describing the single-receipt payload SHALL be declared in the frontend API types and SHALL match the backend view field for field, including which fields are nullable."
ac_4 = "THE receipts list SHALL link each row to its detail route, and a request for an unknown receipt id SHALL render the not-found state the endpoint's 404 already produces."
ac_5 = "A test SHALL render the detail view from a fixture matching the backend payload and assert every rendered field and both links."

[req.8]
title = "Declared Schemas for the Paxeer X API"
story = "As a client author, I want the Paxeer X endpoints described in the published API specification like every other endpoint, so that I can generate a client and have my responses validated."
ac_1 = "EACH of the six Paxeer X API paths - the unified account read, the capability probe, the transaction status read, the anchors list, the receipts list and the single receipt - SHALL declare an OpenAPI operation with its parameters, its success response schema and its error responses, in the same style the fork's other controllers already use."
ac_2 = "THE response schemas SHALL be defined as schema modules beside the existing API schema modules and SHALL describe exactly what the views render, including nullable fields, enumerated status values and pagination parameters."
ac_3 = "THE declared operations SHALL appear in the generated specification for the API router, so the specification lists the six paths without any further registration step."
ac_4 = "THE existing controller tests SHALL validate their responses against the declared schemas through the test helper that already performs schema assertions, and a response that drifts from its schema SHALL fail the test."
ac_5 = "NO schema SHALL be widened to accept a shape the view does not produce; where a view's shape is wrong, the view is corrected and its test updated to the corrected shape."

[req.9]
title = "Every Kernel Precompile Event Decoded"
story = "As someone following the kernel through the explorer, I want every event the kernel precompiles emit to reach a row I can query, so that guarantor bonds, challenges, availability attestations and deposit roots are as visible as checkpoints and custody movements."
ac_1 = "THE schema SHALL carry a table for the guarantor, challenge, availability and sequencer-authorisation events of the anchor precompile, with the columns those events actually carry - the guarantor id, the signer and operator addresses, the bond and slash amounts, the batch number, the challenge id and kind, the evidence hash, the challenger, the class and availability masks, the sequencer id and public key and the batch range, the unbond amount and completion time - and with the same key, block and provenance columns the other lx_ tables use."
ac_2 = "THE deposit-root registration of the custody precompile SHALL be persisted with its checkpoint id, deposit root, commitment and version, without inventing a custody movement kind for it and without widening the custody kind enumeration to a value that does not describe a movement."
ac_3 = "EACH new table SHALL have an Ecto schema with a changeset that validates its required columns, an import runner registered in the chain-type-specific import stage in the same shape as the existing runners, and conflict handling that makes a replayed block idempotent."
ac_4 = "THE log transform SHALL decode all twenty-eight kernel precompile events from the committed ABI definitions, SHALL return each in the list of the table that holds it, SHALL keep every event it already decodes on the row shape it already produces, and SHALL keep its lossless parameter map for every event."
ac_5 = "THE transform's topic constants SHALL continue to be proven against the keccak hash of the ABI signatures, and the test SHALL decode each newly handled event from a real log fixture and assert every decoded column."
ac_6 = "NO event SHALL be dropped silently: an event the transform cannot place SHALL be counted and logged by name, and the test SHALL assert that the count is zero for the committed ABI set."

[req.10]
title = "Upstream Test Isolation"
story = "As anyone running the backend suite, I want it to pass on a fresh database and to pass again on the same database, so that a failure means a defect rather than an order of execution."
ac_1 = "THE block factory SHALL produce blocks that are not the configured first traceable block, so that a test inserting a block does not hand the genesis block to the fetcher under test and have its expectation consumed by the genesis filter."
ac_2 = "THE genesis filter in the internal-transaction fetcher SHALL keep its behaviour exactly - it still drops the first traceable block when the node reports no transactions for it - and SHALL NOT be relaxed, conditioned on the test environment or bypassed by a flag."
ac_3 = "THE heavy primary-key migration SHALL record its completion in the migration status table as its own contract requires, so that a second run against the same database does not attempt a conflict resolution the constraint no longer supports."
ac_4 = "THE internal-transaction fetcher suite SHALL pass on a fresh database and SHALL pass again when run a second time against that same database, proven by running it twice in one qualification."
ac_5 = "NO test SHALL be skipped, tagged out, reordered by a sleep or made to pass by lowering an assertion; where the upstream test and the upstream code genuinely disagree the conflict SHALL be recorded in the qualification log with both left intact."

[req.11]
title = "Wrapped Coin Named for the Coin"
story = "As someone reading the wrapped-coin contract's name in a wallet, I want it to name the coin, so that the token and the network agree."
ac_1 = "THE wrapped-coin contract SHALL carry the display name of the wrapped Paxeer coin and SHALL keep its symbol and its eighteen decimals unchanged."
ac_2 = "NO storage slot, function selector, event signature or constructor argument of the contract SHALL change."
ac_3 = "A contract test SHALL assert the display name, the symbol, the decimals, a deposit crediting the sender, a withdrawal debiting the sender and paying out, and a transfer, so the rename is proven not to have moved anything else."
ac_4 = "THE unrelated wrapped-coin fixtures carried under the JSON-RPC test trees SHALL be left alone and SHALL be recorded in the qualification log as out of scope rather than renamed opportunistically."

[req.12]
title = "Idempotent, Resumable Database Copy"
story = "As an operator seeding a fresh explorer database from an older one, I want a copy that ends in a state I can verify and resume, so that a growing source does not make the result unverifiable."
ac_1 = "THE copy tool SHALL pin a block ceiling before it copies anything - the source's highest fully written block at that moment - SHALL copy no row above that ceiling, and SHALL compare source and target counts at that same ceiling so that growth of the source during the copy cannot be read as a mismatch."
ac_2 = "THE copy of each table SHALL be idempotent and resumable: a rerun SHALL copy only what is missing under the ceiling, SHALL leave already copied rows unchanged, and SHALL record per table the highest key it has copied so an interrupted run continues from there."
ac_3 = "THE internal-transaction copy SHALL derive the target's trace address from the source representation rather than copying a null into a column that forbids it, and the source-only columns of the internal-transaction and transaction tables SHALL be reported by name as not copied rather than silently dropped."
ac_4 = "THE tool SHALL exit non-zero when any table's verification at the pinned ceiling does not match, and its summary SHALL name every mismatching table with both counts."
ac_5 = "A test SHALL run the tool against two local database containers seeded with fixture rows that exercise a full copy, a resumed copy after an interruption, a rerun that copies nothing, a source that grows after the ceiling is pinned, and an internal-transaction row whose trace address must be derived, asserting the tool's exit code and the resulting row counts in each case."

[req.13]
title = "Deployment Definitions and a Compose Smoke Test"
story = "As an operator bringing the explorer up, I want the committed definitions to name the images this repository publishes and to be provable locally, so that the deployment I read is the deployment that runs."
ac_1 = "THE deployment definitions and the local compose stack SHALL name the published fork images for the backend, the frontend, the smart-contract verifier and the signature provider, by the registry path the image workflow publishes to, with the tag taken from a documented variable."
ac_2 = "THE environment examples SHALL declare the Paxeer X chain type, the Paxeer X JSON-RPC variant and the capability probe setting per environment, with the capability probe off unless a deployment explicitly enables it, and SHALL carry no literal endpoint, credential or host."
ac_3 = "THE compose stack SHALL bring the backend and its database up against a recorded JSON-RPC fixture server carried in the repository, requiring no external node."
ac_4 = "A smoke test SHALL start that stack, wait for the backend to answer its liveness path, assert that the capability endpoint answers with the documented body, and tear the stack down, returning non-zero on any step."
ac_5 = "NO deployment definition SHALL point at a production project, and no secret SHALL be committed; every credential enters through a named variable documented in the environment examples."

[req.14]
title = "Backend Boot Binds Its Port"
story = "As an operator deploying the backend, I want it to serve requests after it migrates, so that a deployment either works or fails visibly rather than hanging."
ac_1 = "THE backend SHALL bind its HTTP listener and answer its liveness path after migration completes, under the documented environment of a deployment whose node applies the configured JSON-RPC throttles."
ac_2 = "THE cause SHALL be found by reproducing the hang locally from the committed image and the documented environment variables, and SHALL be fixed where it is - a start-up path that blocks on a remote call, a supervision child that never reports started, or an initialisation that waits on a throttled node - never by raising a timeout or by moving the failure behind a retry."
ac_3 = "THE capability probe SHALL do its first remote call outside its initialisation callback, SHALL keep its documented refresh interval, SHALL stay disabled by default, and SHALL leave the rest of the application starting when the node is unreachable or throttled."
ac_4 = "A regression test SHALL start the affected process against a node that never answers and assert that it reaches its started state within a bounded time and that its state reports the probe as unavailable rather than raising."

[req.15]
title = "One Explorer Surface"
story = "As someone following a chain link from the control plane, I want to land in the explorer, so that there is one place where chain and kernel data are rendered and one place to keep correct."
ac_1 = "THE control plane pages that render batch and checkpoint listings and details themselves SHALL be replaced by links into the explorer's anchor surfaces, addressed through a documented base-URL variable with no literal host."
ac_2 = "THE journeys the beta contract requires of the control plane SHALL be kept: the account journey, the receipt lookup, and the independent receipt verification with its overload, refusal and retry states exactly as spec/layerx-beta requires them."
ac_3 = "THE route performance budgets, the copy catalogue entries and the navigation of the control plane SHALL be updated to the routes that remain, with no entry left pointing at a route that no longer exists."
ac_4 = "THE tests that covered the retired pages SHALL be changed to assert the link surface that replaces them, and no test SHALL be deleted to make the change pass; the verification and account tests SHALL keep asserting what they assert now."
ac_5 = "IF the beta contract, its consistency check or a documentation journey names a retired route THEN the contradiction SHALL be recorded in the qualification log and the contract SHALL be left intact for its owner rather than edited from inside this feature."

[req.16]
title = "Wave Qualification and Recorded Evidence"
story = "As the person deciding whether this feature is done, I want the aggregate suites run once on the merged revision with what ran written down, so that the feature's state is a record rather than a recollection."
ac_1 = "THE aggregate explorer suites - the backend Paxeer X suites, the frontend type check and vitest suite, and the three lint checks - SHALL be run once, on the merged revision of the feature's waves, through the fleet gates, and never per task."
ac_2 = "THE run SHALL be recorded in spec/paxeer-x-explorer/qualification.kvx as gate records carrying the task, the requirements the gate qualifies, the revision, the exact command, the exit code and the log path, written only by having executed the command they name."
ac_3 = "ANY failure the run exposes that belongs to no task in this feature SHALL be recorded once as an observation with its revision, command, exit code, log path, one sentence of what was observed and one sentence of what is assumed, and SHALL NOT be chased."
ac_4 = "NO gate record SHALL be written for a command that did not run, and no gate that passed at the recorded revision SHALL be rerun to confirm it."

# --------------------------------------------------------------------------
# TASKS
#   wave 1  red continuous-integration jobs, and the explorer's own gates
#   wave 2  the remaining fork surface, disjoint touches, parallel
#   wave 3  one aggregate run on the merged revision, recorded
# --------------------------------------------------------------------------

[task.1]
section = "Wave 1 - Green Checks and the Gates That Keep Them Green"
title = "Close every red job and build the explorer's gates"
status = "pending"

[task.1.1]
title = "Give every mix command one containerised recipe"
status = "done"
wave = 1
requires = []
do_1 = "Write explorer/deploy/tools/mix-in-builder.sh, an executable POSIX shell script run from the repository root as `explorer/deploy/tools/mix-in-builder.sh <mix args>`, that runs the given mix invocation inside the pinned Elixir builder image against explorer/backend."
do_2 = "Mount apps, config, rel, mix.exs, mix.lock and .formatter.exs from explorer/backend into the container work directory, keep the build artefacts in a named volume so a rerun does not recompile dependencies, and set MIX_ENV=test, MIX_BUILD_PATH to the volume, CHAIN_TYPE=paxeer_x and ETHEREUM_JSONRPC_VARIANT=paxeer_x unless the caller already set them."
do_3 = "Start a disposable PostgreSQL 16 sidecar per invocation, join the mix container to its network namespace so the database answers on localhost, pass PGUSER and PGPASSWORD matching explorer/backend/apps/explorer/config/test.exs, install the headless browser driver the block_scout_web test helper starts before running a test under that application, and remove the sidecar and its volume on exit including on interrupt."
do_4 = "Support `--reuse-db` to keep and reuse the previous invocation's sidecar and database so a suite can be run twice against one database, `--image <ref>` to override the builder image reference, and `--check` to verify only that the runtime, the image and the mounts resolve; print the resolved command before running it and exit with the mix exit code."
do_5 = "Build the builder image from explorer/deploy/tools/Dockerfile.elixir-builder pinning the same Elixir and Erlang versions the explorer build workflow uses, and have the script build it on demand when the reference is absent."
do_6 = "Document the script and its flags in explorer/README.md under a heading for running backend commands, naming no host and no internal address."
