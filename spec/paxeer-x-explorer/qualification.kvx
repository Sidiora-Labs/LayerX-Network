# qualification.kvx - Paxeer X Network explorer executed-evidence ledger.
#
# Two record shapes live here. Both are append-only. No record is edited or
# removed once written; a rerun appends a new record beside the old one.
#
# [observation.<task>.<n>]  - the shape every feature uses (workflow.kvx
#   [qualification_log]): an assumption, an unrelated or pre-existing failure,
#   a cross-task contradiction, a missing external interface, or a repair that
#   would require weakening a check. Written once, never re-investigated and
#   never re-run. Keys: task, file, symbol, observed, assumption, severity
#   (blocker | suspect | assumption | note). At most six lines per entry.
#
# [gate.<task>.<n>]  - an EXECUTED gate. Written only after running the named
#   command, from that run's own output; never written for a command that did
#   not run and never written to record an expectation. Keys:
#     task        = "3.1"                       task that ran the gate
#     reqs        = ["16.1","16.2"]             acceptance criteria it qualifies
#     revision    = "<40-hex commit>"           commit the command ran against
#     command     = "tools/explorer/gate-test.sh"
#     environment = "<os/arch/toolchain identity>"
#     started_at  = "<UTC timestamp>"
#     outcome     = "pass"                      pass | fail | blocked
#     evidence    = "<log path the gate printed>"
#     note        = "free text; for blocked, the owner action required"
#
# Task-level verify_cmd runs are NOT recorded here: a task records its result
# through cg spec done. This ledger carries the wave gate of wave 3 and the
# observations any task makes along the way.
#
# No record carries a hostname, an IP address, an internal URL, a credential or
# the name of an agent or a working branch.

[observation.2.8.1]
task     = "2.8"
file     = "rpc/solidity/ERC20.sol, rpc/tests/solidity/ERC20.sol"
symbol   = "WPAX"
observed = "Both wrapped-coin fixtures under the JSON-RPC test trees still declare the old display name Wrapped Pax, unchanged by this task."
assumption = "They are inert JSON-RPC test fixtures outside this task's touches list, so renaming them opportunistically is out of scope and left to whoever owns those trees."
severity = "note"

[observation.2.8.2]
task     = "2.8"
file     = "contracts/test/CW1155ERC1155PointerTest.t.sol, contracts/test/CW721ERC721PointerTest.t.sol"
symbol   = "MockAddr"
observed = "Pre-existing: both MockAddr doubles implement IAddr without its bindLayerX and unbindLayerX members, so solc 0.8.27 raises Error 3656 and the whole contracts Foundry project fails to compile, which stops task 2.8's verify_cmd at exit 1 before a single test runs."
assumption = "The two pointer tests are outside this task's touches list, so the mocks are left exactly as they are and the interface drift belongs to whoever owns the precompile interface."
severity = "blocker"

[observation.2.8.3]
task     = "2.8"
file     = "foundry.paxeer.toml, contracts/package.json"
symbol   = "openzeppelin_remapping"
observed = "Pre-existing: the Paxeer Foundry profile declares libs contracts/lib only, while nine sources under contracts/ import @openzeppelin/contracts, which npm installs under contracts/node_modules, so a clean checkout cannot resolve the import and no forge command in that project compiles."
assumption = "Wiring the dependency needs a remapping entry in foundry.paxeer.toml or the package vendored under contracts/lib, both outside this task's touches list, so the resolution belongs to whoever owns the Foundry profile."
severity = "blocker"
