# workflow.kvx — the PORTABLE, IDE-neutral agent operating contract.
#
# This is the single source of truth for HOW an agent works the LayerX spec,
# across every IDE (Cursor, Windsurf, Claude Code, Kiro, Codex, Copilot, ...).
# The per-IDE rule files (.cursor/rules, .windsurf, CLAUDE.md, AGENTS.md, ...)
# are GENERATED from this file by spec/specgen — never hand-edit them.
#
# Format: sectioned KV using the portable .kvx convention. String values are
# ALWAYS double-quoted.
#   [section] / [section.sub]   key = "string"   num = 80   list = ["a","b"]
# Comments start with # outside quotes. One key = value per line.

[meta]
name            = "LayerX Spec Workflow"
kind            = "portable-agent-operating-contract"
version         = "1.2.0"
status          = "active"
source_of_truth = "spec/ (kvx). Per-IDE rule files are GENERATED pointers — never hand-edit; run cg spec render && cg commit -m \"Specgen re-render\" to regenerate."
active_feature  = "layerx-platform"

[principle]
task_driven      = "Work is driven by the active feature's spec.kvx task list — not ad-hoc. Pick the next eligible task by dependency wave, do it, mark it, move on."
one_in_progress  = "At most 12 tasks are in_progress at a time. Sub-agents may work tasks in parallel within any non-conflicting wave. Set a task to in_progress before starting, to done only when its implementation genuinely meets the bar."
phase_separation = "Each task runs in two ordered stages owned by the same agent. First finish the entire task implementation without building or testing. Only after the task implementation is complete, enter task qualification: format, build, test, replay, fault-inject where required, fix task-scoped failures, and rerun until the task gates pass. Never interleave partial implementation with qualification."
no_repair        = "Do not build, test, or repair while a task is only partially implemented. After the entire task implementation is written, repair failures caused by that task during task qualification. Record unrelated or pre-existing failures without expanding scope."
no_weakening     = "Never relax an assertion, loosen a bound, widen a type, add a silent fallback, skip or delete a test, or disable a check to make anything pass. If the code and the check disagree, leave BOTH intact exactly as written and record the conflict."
record_dont_fix  = "Fix task-scoped implementation, compile, test, and runtime failures during task qualification. Record unrelated failures, cross-task contradictions, missing external authority, and any change that would require weakening a check in the feature qualification log."
no_false_success = "A task remains in_progress through implementation and task qualification. Mark it done only after its verify_cmd and required graph, render, build, test, replay, and fault-injection gates genuinely pass. Surface honest partials and external blockers."
read_full        = "When a tool output is flagged truncated/paginated with a way to get the rest, retrieve the full content before reasoning. An information gap is a stop condition."
deliver_complete = "Deliver complete, runnable artifacts, not diffs. Follow existing repo style; add no comments/docs unless asked."

[limits]
max_in_progress = 12

[phase.implementation]
owner        = "agents"
goal         = "Write the entire current task as a complete real implementation against real types and its acceptance criteria before running qualification commands."
entry        = "Feature spec.kvx has eligible pending tasks."
exit         = "The entire task implementation and its specified tests are written, internally reviewed against every acceptance criterion, and ready for task qualification while status remains in_progress."
allowed      = ["read the codebase", "write the entire task implementation", "write tests specified by the task", "update the task to in_progress", "append unrelated contradictions to the qualification log"]
forbidden    = ["building or testing before the entire task implementation is written", "repairing failures before implementation is complete", "weakening or disabling any check", "marking the task done", "claiming anything passes before task qualification"]
inherited    = "A partially implemented sibling may leave the tree red. Finish the current task to its declared interfaces first; task qualification begins only after the entire task implementation is complete."

[phase.task_qualification]
owner        = "agents"
goal         = "Qualify the fully implemented task, fix task-scoped failures without weakening the system, and produce real evidence for every required gate."
entry        = "The entire task implementation and its specified tests are written while the task remains in_progress."
allowed      = ["format task-touched files", "build", "run focused and aggregate tests", "run replay and fault injection required by the task", "fix task-scoped compile, test, runtime, and integration failures", "rerun gates", "run cg spec done", "commit and push"]
forbidden    = ["starting another task before this task qualifies", "weakening assertions or bounds", "skipping or deleting tests", "fixing unrelated inherited failures", "claiming green without exact command evidence", "using cg spec done --force"]
exit         = "The task verify_cmd and every required graph, render, build, test, replay, and fault-injection gate pass; cg spec done succeeds without force; the accepted task commit is pushed."

[phase.release_qualification]
owner        = "human engineers"
goal         = "Perform final cross-task integration, production, economic, security, and release acceptance beyond an individual task's declared gates."
entry        = "All tasks in the release scope have independently passed task qualification."
agent_role   = "Agents may assist only under explicit release authority and must preserve production and destructive-action gates."

[qualification_log]
path       = "spec/<feature>/qualification.kvx"
append_when= "You hit an unrelated or pre-existing failure, a contradiction between requirements or tasks, a missing external interface, an assumption, or a repair that would require expanding scope or weakening a check."
entry_keys = ["task", "file", "symbol", "observed", "assumption", "severity"]
severity   = ["blocker", "suspect", "assumption", "note"]
never      = "Do not log a task-scoped failure as an excuse to skip repair. Fix task-scoped failures during task qualification; the log is for unrelated, cross-task, external, or unsafe-to-resolve findings."

[loop]
step_1 = "Read spec/<active_feature>/spec.kvx — the [meta] status, [req.*] (acceptance criteria), and the [task.*] list with status + wave + requires."
step_2 = "Select the next eligible task: lowest wave whose every 'requires' task is done and whose status is pending. Set its status to in_progress in spec.kvx."
step_3 = "Before any destructive/irreversible/prod/secret/network-write action, run cortex_guard and self-check against HARD rules; stop for explicit user YES if it risks a HARD rule."
step_4 = "Implementation stage: write the entire task against every referenced acceptance criterion using real code paths and types. Write specified tests, but do not format, build, run tests, or repair failures until the entire task implementation is complete. Keep status in_progress."
step_5 = "Task qualification stage: after the entire implementation is written, format touched files; run focused then aggregate build, test, replay, sanitizer, fault-injection, graph, render, and task verify_cmd gates as required; fix task-scoped failures and rerun until green without weakening anything."
step_6 = "If qualification exposes an unrelated or pre-existing failure, cross-task contradiction, missing external interface, or repair requiring wider authority, append it to spec/<feature>/qualification.kvx with evidence. Do not use the log to avoid fixing task-scoped failures."
step_7 = "Run cg spec done <id> without --force only after the task's required gates pass. Record exact commands and outcomes; never claim a gate that did not run."
step_8 = "Immediately publish the qualified task: from the repository root, git add -A, commit with a natural-sounding message describing the implementation and verified gates, and push. Never batch several tasks into one commit and never leave a completed task unpushed."

[status_values]
task    = ["pending", "in_progress", "done"]
feature = ["draft", "in_progress", "paused", "blocked", "complete"]

# HARD rules mirrored in-repo so an agent without cortex still sees them.
# These mirror the cortex HARD ruleset; cortex_recall is still authoritative.
[hard_rules]
task_durability = "Once a task is dispatched, keep at least one agent alive through complete implementation and task qualification; on agent failure, resume from durable state. Done means implementation and every task gate genuinely pass."
phase_boundary  = "Finish the entire task implementation before qualification. After implementation is complete, the same agent may format, build, test, fix task-scoped failures, and rerun gates. Never interleave partial implementation with qualification or expand into unrelated repair."
no_weakening    = "Never weaken the system to produce a passing signal. No relaxed assertions, loosened bounds, widened types, silent fallbacks, skipped or deleted tests, disabled checks, or lowered thresholds. Leave the conflict standing and log it."
no_fakes        = "Never write stub/mock/fake test doubles or placeholder implementations. Test REAL code paths with REAL types."
no_false_claims = "Never claim code compiles, tests pass, or behavior is verified before the exact gate runs successfully. Preserve exact failed commands and distinguish task qualification from final release qualification."
read_full       = "When tool output is truncated and the rest is retrievable, fetch the full content before reasoning or answering."
publish_steps   = "After every task passes task qualification and cg spec done without force, commit and push from the repository root with a natural-sounding message. A finished task that is not pushed is not finished."
ui_component_library = "Client UI uses the exact styling and component API of the owner-supplied @layerx/ui package. Its borders, dividers, shadows, gradients, palette, radii and interaction states are authoritative; application code consumes the package instead of restyling its primitives."

# Generation config: which IDE adapter files specgen emits, and where the
# human-readable markdown mirror is rendered. Paths are repo-relative.
[render]
markdown_mirror  = true   # render requirements.md / design.md / tasks.md from spec.kvx (into spec/<feature>/ only)
mirror_to_kiro   = false  # NEVER write into .kiro/specs/<feature>/ — those are hand-authored sources, not generated output
banner           = "GENERATED by spec/specgen from spec/ kvx — DO NOT EDIT. Edit the .kvx source and regenerate."
adapter_sections = ["principle", "phase.implementation", "phase.task_qualification", "phase.release_qualification", "qualification_log", "loop", "limits", "hard_rules"]
adapter_lead     = "For each task, finish the entire implementation first without building or testing. Then qualify that completed task: format, build, test, fix task-scoped failures, rerun gates, and call cg spec done only when green."

[adapters]
# label = "output path"   (specgen wraps the shared brief in each IDE's native shape)
cursor            = ".cursor/rules/spec-workflow.mdc"
windsurf_rules    = ".devin/rules/spec-workflow.md"
windsurf_workflow = ".devin/workflows/spec.md"
claude            = "CLAUDE.md"
codex             = "AGENTS.md"
copilot           = ".github/copilot-instructions.md"
kiro              = ".kiro/steering/spec-workflow.md"

[mode]
name = "prod"
