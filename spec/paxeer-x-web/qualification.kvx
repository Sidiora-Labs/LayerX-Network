symbol = "TOOL_CATALOGUE"
observed = "The web tools are described, validated and listed through catalogue::WEB_TOOLS and web_surface, but server.rs, which routes tools/list and tools/call for a bound server, is outside this task's touches."
assumption = "A later task adds the web tools to the bound server's routing with a configured sidecar endpoint and payer."
severity = "assumption"
