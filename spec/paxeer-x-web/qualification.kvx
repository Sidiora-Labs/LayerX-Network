# qualification.kvx - Paxeer X web search and xweb executed-evidence ledger.
#
# Two record shapes live here. Both are append-only. No record is edited or
# removed once written; a rerun appends a new record beside the old one.
#
# [observation.<task>.<n>]  - the shape every feature uses (workflow.kvx
#   [qualification_log]): an assumption, an unrelated or pre-existing failure,
#   a cross-task contradiction, a missing external interface, or a repair that
#   would require weakening a check. Written once, never re-investigated and
#   never re-run. Keys: task, file, symbol, observed, assumption, severity
#   (blocker | suspect | assumption | note). At most six lines per entry.
#
# [gate.<task>.<n>]  - an EXECUTED gate. Written only after running the named
#   command, from that run's own output; never written for a command that did
#   not run and never written to record an expectation. Keys:
#     task        = "3.1"                       task that ran the gate
#     reqs        = ["16.3","16.4"]             acceptance criteria it qualifies
#     revision    = "<40-hex commit>"           commit the command ran against
#     command     = "go test -count=1 ./modules/xweb/..."
#     environment = "<os/arch/toolchain identity>"
#     started_at  = "<UTC timestamp>"
#     outcome     = "pass"                      pass | fail | blocked
#     evidence    = "<log path the gate printed>"
#     note        = "free text; for blocked, the owner action required"
#
# Task-level verify_cmd runs are NOT recorded here: a task records its result
# through cg spec done. This ledger carries the legs of the wave 3 gate and
# the observations any task makes along the way.
#
# No record carries a hostname, an IP address, an internal URL, a credential or
# the name of an agent or a working branch.

[observation.1.11.1]
task = "1.11"
file = ".github/workflows/xweb-test.yml"
symbol = "task.1.11.do_1"
observed = "The do_1 path filters omit trees whose changes the legs exercise - Makefile, tests/modules, tests/sequencer, tests/network, tests/test_programs_web_read.c, tests/test_web_program_path.c, tests/fixtures/web, src/modules/programs/call.c, include/layerx/programs.h, programs/sdk/rust, agent/sdk/typescript/test, agent/sdk/python/tests and modules/layerxbridge - so a change confined to them does not start the workflow."
assumption = "The workflow carries exactly the do_1 list and tools/ci/xweb-workflow-check.sh asserts that list; widening it is a spec change for the feature owner, not this task."
severity = "suspect"

[observation.1.7.1]
task = "1.7"
file = "src/sequencer/lx_web_root.c"
symbol = "lx_web_root"
observed = "The web root is computed from committed observations, but include/layerx/lx_batch.h is outside the task touches, so no batch header field carries it and the new activity ids are not yet routed by kernel dispatch."
assumption = "Binding the web root into the batch header and routing LX_WEB_OBSERVATION_ACTIVITY and LX_WEB_ATTESTOR_SET_ACTIVITY is a later integration change owned by the feature."
severity = "suspect"

[observation.1.6.1]
task = "1.6"
file = "contracts/test/CW1155ERC1155PointerTest.t.sol"
symbol = "MockAddr"
observed = "forge compiles the whole contracts tree despite --match-path, and MockAddr in CW1155ERC1155PointerTest.t.sol and CW721ERC721PointerTest.t.sol does not implement the LayerX binding methods of IAddr, so compilation fails (Error 3656) before XWebConsumer.t.sol runs; the Go legs and xweb-forge-libs.sh passed."
assumption = "The stale mocks predate this task and sit outside its touches; updating them belongs to the addr precompile owner, after which the verify_cmd reruns unchanged."
severity = "blocker"
closed = "Task 1.12 brought both MockAddr doubles up to IAddr; the verify_cmd passed unchanged at revision 4f95b1f5355f608647c6149bc56d06d53e596950."

[observation.1.6.2]
task = "1.6"
file = "precompiles/utils/expected_keepers.go"
symbol = "XWebKeepers"
observed = "XWebK is declared on a separate XWebKeepers interface with an EmptyKeepers method, not on utils.Keepers, because node.PrecompileKeepers is outside this task and would stop compiling."
assumption = "The precompile type-asserts XWebKeepers and refuses every call with a reason until the application's keepers implement XWebK."
severity = "assumption"

[observation.1.6.3]
task = "1.6"
file = "precompiles/setup.go"
symbol = "GetCustomPrecompiles"
observed = "Registering beside feetoken puts 0x0000000000000000000000000000000000001019 into the latest custom precompiles and the vm maps of any binary built from this tree, not only after the v6.8 upgrade."
assumption = "It refuses every call until the keeper is wired; gating it on the upgrade is outside this task."
severity = "suspect"

[observation.1.6.4]
task = "1.6"
file = "contracts/test/XWebConsumer.t.sol"
symbol = "test_InterfaceMatchesThePrecompileABI"
observed = "Foundry's default fs_permissions do not let the suite read precompiles/xweb/abi.json and the precompile does not exist under Foundry, so selectors are checked against literal signatures and request is answered with vm.mockCall."
assumption = "precompiles/xweb/xweb_test.go pins every abi.json method and event signature to those literals and XWeb.sol to IXWeb.sol byte for byte."

[observation.1.4.1]
task = "1.4"
file = "interop/crates/x-websearch/src/payment.rs"
symbol = "metered_payload"
observed = "spec/402lxp/protocol.md has the metered buyer send a receive payload whose ordinal-6 draw the receiver signs, which a buyer cannot author; the task has the receiver key sign the draw."
assumption = "The metered PAYMENT-SIGNATURE payload carries the payer-signed canonical grant and the draw's idempotencyKey, and the sidecar signs and submits the draw."
severity = "suspect"

[observation.1.4.2]
task = "1.4"
file = "interop/crates/layerx-x402/src/seller.rs"
symbol = "Seller::settled"
observed = "The protocol asks a grant settlement to repeat purposeHash in extensions.layerx of PAYMENT-RESPONSE; the Seller does not, and seller.rs is outside this task's touches."
assumption = "The purpose is carried in the metered offer's extra.layerx.purposeHash only."
severity = "note"

[observation.1.4.3]
task = "1.4"
file = "interop/crates/x-websearch/src/payment.rs"
symbol = "PaymentGate::new"
observed = "The configuration has no field naming the payer, the draw fee limit or the adapter conformance suite, and src/main.rs is outside this task's touches."
assumption = "The payer names itself in the LAYERX-PAYER-DID header, every asset including PAX settles to its per-asset account, the draw fee limit is a fixed constant, and the binary wires PaymentGate with its pinned suite in a later task."
severity = "assumption"

[observation.1.4.4]
task = "1.4"
file = "interop/crates/x-websearch/src/payment.rs"
symbol = "PaymentGate::settle"
observed = "The server's status table has no 202, so a pending payment answers 503 payment_pending with Retry-After 1."
assumption = "Clients retry the same PAYMENT-SIGNATURE on 503 payment_pending."
severity = "note"

[observation.1.3.1]
task = "1.3"
file = "interop/crates/x-websearch/src/crawl.rs"
symbol = "Crawler::page_links"
observed = "Fetcher::fetch returns only the canonical text, so the crawler reads an HTML page's links with a second GET of the admitted final URL under the same destination check, limits and politeness delay; src/main.rs does not yet start the crawler or register /search, and /search is registered through the content module's PaymentHook because PaymentGate is not on the feature branch."
assumption = "Exposing the fetched body from fetch.rs, wiring the crawl loop and routes into main.rs and binding /search to PaymentGate are integration changes owned by the feature, outside this task's touches."
severity = "note"
closed = "Task 1.13 returns the raw body from Fetcher::fetch, reads links from it, starts the crawler and installs /search and /fetch behind PaymentGate in src/main.rs."

[observation.1.13.1]
task = "1.13"
file = "interop/crates/x-websearch/src/main.rs"
symbol = "CRAWL_INTERVAL"
observed = "The configuration has no crawl interval and no signal handling is reachable without a new crate (unsafe_code is denied and Cargo.toml is outside the touches), so cycles start every 900 seconds from a constant and SIGTERM ends the process by its default action."
assumption = "The index commits per cycle and the content and payment stores write by rename, so termination leaves the data directory reopenable, which tests/binary.rs asserts; a configured interval and a graceful stop are feature-owned changes."
severity = "note"
