observed = "ContentKind knows only fetch and search and ContentStore::put refuses any other kind byte, so an api answer's kind 3 canonical bytes are computed and signed in api.rs but not stored, and GET /content/<digest> cannot serve an api answer."
assumption = "Api answers stay out of the content store until canonical.rs, outside this task's touches, learns kind 3."
severity = "note"

