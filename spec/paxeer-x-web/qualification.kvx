file = "src/protocol/lxp_module_ctx.c"
symbol = "lxp_ctx_account_stage_module_value"
observed = "Module value staging requires an open journal, but lxp_kernel_prepare_activity runs a program call on a snapshot without opening one, so the web fee account cannot be created by the first paying call and tests/test_web_program_path.c provisions it at genesis."
