[observation.2.21.2]
task = "2.21"
file = "src/modules/programs/event.c"
symbol = "lxp_programs_emit_guest_event"
observed = "The kernel commits a guest event only as an envelope carrying the topic and data digests and the data length, and neither the node nor the core service keeps the raw topic or data, so no upstream read can answer lx_getProgramEvents with data and none was added to the core service; the gateway proxies GET /v1/programs/events/<topic>/<from_sequence>/<limit>, validates the page and answers -32001 while the core returns not_found, and the local events.rs run is not extended because it could only fail."
assumption = "A kernel and node change persisting committed guest event topic and data by global sequence, served by the core service at that path, is owned by a follow-up task outside these touches."
severity = "blocker"

