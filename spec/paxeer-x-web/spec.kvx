# spec.kvx - the Paxeer X Network web search sidecar, the xweb precompile and
# the kernel web_read host import. SINGLE SOURCE OF TRUTH for this feature.
#
# requirements.md / design.md / tasks.md next to this file are GENERATED from it
# by spec/specgen. Never hand-edit those; edit this file and regenerate.
#
# Drive the work with:  cg spec next -> cg spec start <id> -> cg spec done <id>
#
# Every node hosts a sidecar binary, x-websearch, that crawls and indexes the
# web on its own and serves search and fetch to agents that pay per request
# over 402LXP. A precompile, xweb, brings attested external data to EVM
# contracts, and kernel programs read the same attested data through a host
# import. The chain half of this feature is a consensus change: it is written
# and qualified here and reaches a running chain only through the v6.8 upgrade
# plan and a governance proposal. Wave 1 builds the foundations in parallel,
# wave 2 integrates them, wave 3 runs the gate once.

[meta]
feature   = "paxeer-x-web"
title     = "Paxeer X Network web search sidecar and xweb precompile"
kind      = "product-feature-specification"
version   = "0.1.0"
status    = "draft"
language  = "Rust (the x-websearch sidecar crate under interop/crates/x-websearch, the web_read host import in the programs runtime and the MCP tool in agent/crates/layerx-mcp), Go (the modules/xweb module, the precompiles/xweb package and the v6.8 upgrade handler), Solidity (the IXWeb interface and the reference consumer with its Foundry tests), C (the kernel web observation activity, its intake, its root and the programs call bridge), TypeScript and Python (the agent SDK clients), Bash (packaging, workflow and dry-run check scripts), JSON (configuration examples, abi.json and recorded fixtures), YAML (one CI workflow and one compose entry), Markdown (one documentation page)"
repo_root = "interop/crates/x-websearch (the sidecar crate: HTTP server, configuration, crawler, index, fetch and extraction, content digest, 402LXP seller, attestor signer, submitter and kernel observer); interop/deploy/x-websearch (Dockerfile, systemd unit, configuration example and packaging checks); modules/xweb (request store, fulfilment, attestor set, fees, governance messages); precompiles/xweb (XWeb.sol, abi.json, xweb.go, setup.go, versions); contracts/src/precompiles/IXWeb.sol and contracts/src/xweb (the reference consumer) with contracts/test; include/layerx/lx_web.h, src/modules/web, src/network/lx_web_adapter.c, src/sequencer/lx_web_root.c and src/modules/programs/call.c (the kernel side); programs/crates/layerx-programs-runtime and programs/sdk/rust (the web_read host import); agent/sdk/typescript, agent/sdk/python and agent/crates/layerx-mcp (the agent clients); node/tags, node/upgrades.go and node/app.go (the v6.8 plan); docs/site/docs/protocol/xweb.md; .github/workflows/xweb-test.yml; spec/paxeer-x-web/ (this feature and its qualification log)"
upstream  = "interop/crates/layerx-x402 already implements the 402LXP Seller, PaymentRequired and the exact and metered schemes, and spec/402lxp/protocol.md is the wire contract: PAYMENT-REQUIRED carries the offer, PAYMENT-SIGNATURE carries the buyer's payment, PAYMENT-RESPONSE is returned only after the selected commitment is verified, and settlement goes through the gateway's JSON-RPC at POST /rpc with lx_sendActivity, lx_getActivityStatus and lx_getReceipt. interop/crates/layerx-gas-station and layerx-interop-service are the sibling shape for a std-library HTTP server and outbound HTTP over std::net::TcpStream with native-tls. modules/layerxbridge/keeper/bridge.go verifySignatures and modules/layerxbridge/types.RecoverSigner are the attestor-signature shape this feature reuses. precompiles/feetoken holds 0x0000000000000000000000000000000000001018, the highest precompile address in use; precompiles/feetoken and precompiles/layerxanchor are the package shape and scripts/bump_version generates setup.go from a versions file. The kernel oracle path - include/layerx/lx_oracle.h, src/network/lx_oracle_adapter.c, src/sequencer/lx_oracle_root.c, src/modules/perps/lx_oracle_intake.c and the oracle_read host import in programs/crates/layerx-programs-runtime/src/host/oracle.rs with its call bridge in src/modules/programs/call.c - is the shape the web observation and web_read follow. node/tags already lists v6.7."
intro     = "Every node of Paxeer X Network hosts a sidecar, x-websearch, that crawls a per-operator seed list into its own tantivy index and serves web search and page fetch. No third-party search vendor and no API key sit anywhere in the path. Agents pay the sidecar per request over 402LXP in SID, PAX, USDC or USDL. A fetch produces extracted text and a canonical content digest, so any two sidecars that saw the same page agree on the same 32 bytes. Contracts reach the same data through the xweb precompile: a contract calls request with a fee and a callback gas limit, attestor sidecars fetch independently and sign the digest, a submitter posts fulfil once a majority has signed, and the module stores up to 4096 bytes of content with the digest and calls the contract back with bounded gas. The full content stays retrievable from any sidecar by its digest. Kernel programs get the same thing through a web_read host import fed by a web observation activity, and they pay with the transfer_402 host import they already have. Program execution never dials out."

# Decisions locked before implementation begins. They bind every task in this
# feature and are not reopened by a task.
[decision]
code_quality        = "A+ on every changed path: real code paths, real types, real fixtures. No stub, mock or fake test double on a production path, no placeholder implementation, no TODO, FIXME or 'for now' comment, no dead branch left for later. A test exercises the crate, module, precompile, contract, kernel unit or client it names through its real entry point with data shaped like production data. Where a test needs a web server it starts a real std-library HTTP server on the loopback interface serving committed files; where it needs a gateway or a chain it replays a recorded exchange in the format interop/crates/layerx-bridge-relayer/tests/fixtures already uses. Every language stays lint clean under the repository's own configuration: clippy with the interop workspace lints, golangci-lint with .golangci.yml, forge fmt, the kernel's C warnings, tsc strict and the Python type stubs."
chain_frozen        = "No task changes a running chain. The chain half of this feature - modules/xweb, precompiles/xweb, its registration in precompiles/setup.go and node/app.go, and the kernel web observation activity - is a consensus change that reaches a running chain only through the x/upgrade plan named v6.8 and a governance proposal that carries it. It is written and qualified now and deployed by no task: no task deploys, submits a governance proposal or broadcasts a transaction, and no task writes a genesis, sets a live parameter or registers a live attestor. The only chain any task talks to is the throwaway anvil process the dry-run script of task 2.6 starts on the loopback interface and stops."
governance_gate     = "Every change to consensus - the xweb store key, the module, its parameters, the precompile at 0x0000000000000000000000000000000000001019, the kernel web activity and the web_read import - reaches a running chain only through the v6.8 upgrade handler registered in node/upgrades.go under the name v6.8 appended to node/tags, and through a governance proposal that carries it. No migration runs outside that handler, and a node replaying blocks below the upgrade height produces exactly the state it produces without this feature."
search_backend      = "Each node runs its own crawler and its own tantivy index. No third-party search vendor, search API or API key appears anywhere in the code, the configuration or the documentation. The sidecar configuration carries a per-operator seed list and a crawl budget: pages per cycle, pages per host, maximum depth and a per-host politeness delay. robots.txt is honoured for the user-agent token x-websearch on every crawl and every fetch, and a disallowed URL is refused. A fetch accepts http and https only, refuses loopback, private, link-local and multicast destinations after name resolution unless the configuration's allow_loopback flag is set for a local test, and enforces a 3 second connect limit, a 10 second total limit, a 2 MiB body limit and at most 3 redirects. It produces extracted text and a canonical content digest."
canonical_content   = "Extraction is deterministic. text/html drops script, style, noscript and template elements, turns block elements into line breaks and decodes entities; text/plain and application/json pass through; every other media type is refused. The text is then canonicalised: decoded to UTF-8 from the declared charset with invalid input refused, CRLF and CR turned into LF, control characters other than LF and TAB removed, runs of spaces and tabs collapsed to one space, trailing spaces removed from each line, three or more consecutive LF collapsed to two, leading and trailing whitespace trimmed, and the result put in Unicode NFC. For a search the text is the compact JSON array of at most ten objects with keys url, title and snippet in that order, sorted by score descending then url ascending, with no score in the bytes. The canonical bytes are the ASCII domain PAXEERX_WEB_CONTENT_V1, the kind as one byte (1 fetch, 2 search), the request payload as a big-endian uint32 length and its bytes, the media type without parameters in lower case as a uint32 length and its bytes, and the text as a big-endian uint64 length and its bytes. The content digest is keccak256 of the canonical bytes. No clock, header, host name or node identity enters them, so two sidecars that saw the same page produce the same digest."
payment             = "The sidecar is a 402LXP seller built on interop/crates/layerx-x402: Seller, PaymentRequired and the metered scheme with one payer grant and one draw per request, with exact offered as the fallback alternative. PAYMENT-REQUIRED carries the offers, PAYMENT-SIGNATURE carries the buyer's payment and PAYMENT-RESPONSE is returned only after the selected commitment is verified, with the settlement reference lxp:<receipt_digest>. Settlement is verified through the gateway exactly as spec/402lxp/protocol.md defines: the draw is submitted with lx_sendActivity, a pending result is recovered with lx_getActivityStatus or lx_getReceipt, the receipt's sequencer signature is verified against trust inputs from the configuration and never from the response, and a pending or unknown result never releases the resource. The accepted assets are exactly SID, PAX, USDC and USDL, each identified by its registered kernel asset id taken from the sidecar configuration; the configuration loader refuses a missing asset, an extra asset, a zero id and every placeholder id. The price per request is an operator-set amount per asset in that asset's base units whose documented initial value is one tenth of a US cent at the time the operator configures it; the specification fixes that rule, not the number."
contract_path       = "Contracts call the xweb precompile at 0x0000000000000000000000000000000000001019, the next free address after 0x0000000000000000000000000000000000001018. The package precompiles/xweb follows the layerx-style shape: XWeb.sol, abi.json, xweb.go, setup.go generated by scripts/bump_version and a versions file, with the interface at contracts/src/precompiles/IXWeb.sol. request(uint8 kind, bytes payload, uint64 callbackGas) is payable with exactly the current fee in PAX and returns the request id; the module modules/xweb stores the request under a monotonically increasing nonce and emits an event. fulfil(uint64 requestId, bytes response, bytes32 contentDigest, uint32 fullLength, bytes[] signatures) verifies the signatures against the governance-registered secp256k1 attestor set - strictly ascending recovered signers, every signer registered, at least the threshold - in the shape of modules/layerxbridge/keeper/bridge.go verifySignatures using modules/layerxbridge/types.RecoverSigner, stores at most 4096 bytes of response content with the 32-byte digest and the full length, splits the fee equally among the signing attestors' payout accounts with the integer remainder to the lowest signer, and then calls onXWebResponse(uint64,bytes32,uint32,bytes) on the requester with gas bounded by the request's callbackGas and the module's maximum; a callback that reverts or runs out of gas is recorded and does not undo the fulfilment. A request not fulfilled within the module's timeout in blocks is refundable to its requester once. Governance messages register and remove attestors, set the threshold, the caps, the fee and the timeout, and pause and unpause. The full content is retrievable from any sidecar at GET /content/<digest>: a sidecar that does not hold the digest asks its configured peer sidecars, recomputes the digest of the bytes it receives, stores them and serves them, and answers 404 only when no peer holds bytes with that digest."
attestation_preimage = "The fulfil digest is keccak256 of a 188-byte preimage with no EIP-191 prefix and no EIP-712 domain: the 14 ASCII bytes PAXEERX_WEB_V1, the origin as one byte (1 for the EVM precompile, 2 for a kernel program), the network id as uint256 (the EVM chain id for origin 1, the kernel network id for origin 2), the requester as 32 bytes (the EVM address left-padded with zeros for origin 1, the 32-byte program id for origin 2), the request id as uint64, the kind as one byte, keccak256 of the request payload, the content digest, keccak256 of the stored response bytes and the full text length as uint32, every integer big-endian. Each signature is 65 bytes r then s then v with v in 27 or 28 and s at or below half the secp256k1 order. The preimage is specified once, in modules/xweb/ATTESTATION.md, and pinned as shared vectors asserted in Go, Rust and C."
attestors           = "Every node sidecar may hold a web-attestor secp256k1 key, separate from any consensus, validator or bridge key, loaded from a file named by an environment variable and never from the configuration. Governance registers each attestor's 20-byte signer address with its payout account. The initial set is every registered sidecar and the threshold is a majority of the registered set: the keeper refuses a threshold at or below half the set or above it, and raises the threshold to the majority when an attestor is added. Attestor sidecars watch the request event, fetch independently, sign the digest and exchange signatures; a submitter that is part of the sidecar, not a new binary, posts fulfil once the threshold is reached, orders the signatures by ascending signer and treats an already-fulfilled request as completed rather than as an error to retry."
api_calls           = "Contracts reach the world beyond the network through the same precompile: a request kind api carries the call the contract wants made, its public headers, an optional body, a selector of the JSON fields to attest and an attestation level. A secret never lives in chain state, in the request event or in any sidecar file in the clear: a credential travels as one envelope per attestor, encrypted with an ephemeral key to that attestor's registered secp256k1 key and decrypted in memory for the one call. The attested answer is the canonical form of the selected fields, so attestors agree on APIs whose full responses differ per call. An API that tolerates one call only is served under the single level by one named attestor, and the result says so. Credential holders rotate what they send, an attestor replaced through governance stops receiving envelopes from that height, and the attested answer is public on the chain like every other result."
programs            = "Kernel programs read web data through a new host import web_read(i32,i32,i32,i32)->i32 appended to the ABI as a new layerx_v4 group, beside oracle_read in programs/crates/layerx-programs-runtime/src/host/ with its call bridge in src/modules/programs/call.c. It is fed by a web observation activity that attestor sidecars post through the sequencer on the same shape as the oracle adapter path - include/layerx/lx_web.h beside lx_oracle.h, src/network/lx_web_adapter.c beside lx_oracle_adapter.c, src/sequencer/lx_web_root.c beside lx_oracle_root.c - carrying the origin-2 preimage fields and the attestor signatures, verified in the kernel with lxp_secp256k1_recover_address against the kernel web attestor set. A program requests a fetch by emitting a web request record through event_emit and paying the web fee account with the existing transfer_402 host import in the same call. Execution never dials out: web_read reads only committed observations, and a request with no committed observation reads as absent. The frozen v1 to v3 manifests and programs/abi-frozen.sha256 do not change."
agents              = "agent/sdk/typescript and agent/sdk/python gain clients that perform the full 402LXP exchange against any node sidecar for search, fetch and content by digest, verify the PAYMENT-RESPONSE settlement before returning content, and recompute the content digest of a fetch locally. agent/crates/layerx-mcp gains a web tool with search, fetch and content operations that goes through the same exchange and the MCP crate's existing approval boundary for any spend."
sidecar_runtime     = "The sidecar is the Rust crate interop/crates/x-websearch with the binary x-websearch, a member of the interop workspace under its lints. Its HTTP server is std-library only like its siblings: no axum, no tokio, no hyper. Outbound HTTP uses std::net::TcpStream with native-tls exactly as interop/crates/layerx-gas-station/src/rpc.rs does. The index is tantivy. A JSON configuration file names everything that is not a secret; secrets arrive only through the environment variables X_WEBSEARCH_ATTESTOR_KEY_FILE, X_WEBSEARCH_SUBMITTER_KEY_FILE and X_WEBSEARCH_RECEIVER_KEY_FILE, each naming a key file. It ships as a Dockerfile under interop/deploy/x-websearch, a systemd unit, an entry in docker/docker-compose.yml, and the node image built by the root Dockerfile gains the binary."
ci                  = "One workflow, .github/workflows/xweb-test.yml, with a concurrency group per ref and cancel-in-progress, path filters on the trees this feature touches and nothing else, and legs whose names say what they run: cargo test for the x-websearch crate, go test for modules/xweb and precompiles/xweb, forge test for the IXWeb consumer tests, the kernel make targets for the web activity and web_read, and the SDK and MCP tests. No continue-on-error. A wave 3 task runs the legs once on the merged revision."
test_ratio          = "One to one. Every task's touches list names its test files explicitly and every production file a task changes is paired with a test file that changes or is added in the same task and exercises it: a Rust file under the crate's tests/ or a #[cfg(test)] module, a Go *_test.go in the same package, a Foundry *.t.sol under contracts/test, a C test under tests/ with its make target, a TypeScript test under agent/sdk/typescript/test, a Python test under agent/sdk/python/tests, or a *-check.sh for a shell script, Dockerfile or unit. Markdown, JSON configuration, recorded fixtures and workflow YAML are not production files for the ratio."
testing_allowance   = "Testing time is bounded on purpose. Every task's verify_cmd is one command wrapped in timeout 20m, run from the repository root. A task gets one build of its declared targets and one verify_cmd run, then at most two task-scoped repair cycles, each followed by exactly one rerun. The whole workflow command set runs once, in the wave 3 gate task, never per task and never per rebase. A task whose verify_cmd exceeds its timeout stops at thirty minutes and reports implemented-not-qualified with the exact command, exit code and log path; that is an acceptable outcome and is never dressed up as a pass."
naming              = "The product is Paxeer X Network. LayerX names the kernel domain only and stays on the kernel entities and crates that already carry it; the new user-facing names are x-websearch, xweb and web_read. The Paxeer coin is PAX and Sidiora is SID. No file, comment, commit message or log line introduced by this feature carries a date, a hostname, an IP address other than the loopback address a local test binds, a port of an internal host, an internal URL, a credential, a node count, or the name of an agent, a model or a working branch. The only documentation links are https://paxeer.app and paths under github.com/Sidiora-Labs/Paxeer-X-Network."
production_safety   = "No task touches a mainnet, a production deployment, its services, its variables or its domains; no task reads, writes or commits a .env file or any secret; no task broadcasts a transaction to a public network or crawls a public site. Every endpoint and key enters a tool through a configuration path or a named environment variable, never through a committed literal. Every committed configuration carries placeholder asset ids, prices and trust inputs that the loader refuses."
no_weakening        = "No assertion is relaxed, no bound loosened, no type widened, no silent fallback added, no test skipped, deleted or marked pending, no lint rule disabled on a file this feature owns. A missing or unverified payment, a pending settlement, a placeholder configuration value, a robots.txt disallow, a limit exceeded, a signature out of order, a high s value, an unknown signer, a count short of the threshold, a consumed request or a paused module refuses the operation; none of them degrades into a partial success. Where the code and a check disagree, both stay exactly as written and the conflict is recorded in spec/paxeer-x-web/qualification.kvx."
generated_files     = "The per-editor rule files generated from spec/workflow.kvx and the requirements.md, design.md and tasks.md mirrors under spec/*/ are generated and off limits: edit spec/workflow.kvx or this file and regenerate with cg spec render. precompiles/xweb/setup.go is generated by scripts/bump_version and is regenerated, never hand-edited. contracts/lib is populated by cloning the pinned libraries and is never committed."
publication         = "A qualified task is published immediately: one commit per task from the repository root describing the change honestly and naming the gates that actually ran, pushed before the next task starts. Several tasks are never batched into one commit and a finished task is never left unpushed."

[design]
overview = "Three waves. Wave 1 builds eleven foundations. The sidecar crate is laid down first - its configuration and its std-library HTTP server - and three tasks then fill it in parallel: fetch, extraction and the content digest; the crawler and the tantivy index; the 402LXP seller. Beside them, with no shared file, the xweb module is written with its request store, fulfilment, attestor set and governance messages, and the precompile and its Solidity interface are written against it; the kernel gains the web observation activity and then the web_read host import; the TypeScript and Python clients and the MCP tool are written against the sidecar's recorded 402 exchange; and the one workflow is added. Wave 2 integrates: the attestor signer and submitter close the contract loop, the program request path closes the kernel loop, the sidecar is packaged into its own image, a unit, a compose entry and the node image, the v6.8 upgrade plan wires the module and the precompile into the application, the documentation page is written, and a local dry run with anvil and local sidecars is recorded. Wave 3 runs the workflow's command set once on the merged revision and writes down what ran."

[design.sidecar]
title = "The x-websearch sidecar"
p1 = "x-websearch is one binary with one configuration file. The configuration names the listen address, the data directory for the index and the content store, the seed list and the crawl budget, the fetch limits and the allow_loopback flag, the four accepted assets with their kernel asset ids and per-request prices, the gateway endpoint and the sequencer trust inputs for settlement, the EVM endpoint and chain id the attestor watches, the kernel network id, and the peer sidecars it exchanges signatures and content with. Keys never appear in it: the attestor key, the submitter key and the 402 receiver key are files named by environment variables. The loader decodes with unknown fields refused and refuses every placeholder, naming the field."
p2 = "The HTTP server is a std::net::TcpListener with a bounded worker pool, request-line and header size limits, a read timeout and one response per connection. It serves GET /health free, and GET /search?q=, GET /fetch?url= and GET /content/<digest> as paid resources. An unpaid request receives 402 with PAYMENT-REQUIRED; a request carrying PAYMENT-SIGNATURE is settled through the seller and receives the resource with PAYMENT-RESPONSE, or a refusal naming the reason."
p3 = "A fetch resolves the host, refuses a forbidden destination, checks robots.txt, follows at most three redirects under the same checks, reads at most 2 MiB within the time limits, extracts and canonicalises the text, and writes the canonical bytes to the content store under their digest so GET /content/<digest> can return them later; a digest the store does not hold is retrieved from the peer sidecars and kept only when its recomputed digest matches. The crawler walks the seed list inside its budget with the same fetch path, obeys robots.txt and the politeness delay, and writes url, title and body into the tantivy index; search queries it and returns at most ten results in the canonical order."

[design.payment]
title = "Pay per request"
p1 = "Every paid route offers the same four assets. For each, the offer carries the metered scheme bound to a payer grant with one draw per request, and an exact alternative, both at the operator's price for that asset. The receiver identity signs the ordinal-6 draw, submits it to the gateway with lx_sendActivity at the offer's commitment, and releases the resource only when a receipt signed by the configured sequencer names the draw, the payer, the asset and the amount. A retry of the same request reuses the same signed activity and idempotency key; a pending result is recovered, never replaced; a receipt never releases a second request."
p2 = "The price rule is written once in the documentation and in the configuration example: an operator sets each asset's price per request so that it equals one tenth of a US cent at the time of configuration. The committed example carries placeholders the loader refuses, so no sidecar starts with a price nobody chose."

[design.contracts]
title = "The xweb precompile and module"
p1 = "A contract calls request on the precompile at 0x0000000000000000000000000000000000001019 with the kind, the payload and the callback gas, paying exactly the current fee. The module checks it is not paused, the kind is known, the payload is within the payload cap and the callback gas within the callback cap, takes the fee into the module account, stores the request under the next nonce with the requester, the kind, the payload hash, the callback gas, the fee and the height, and emits XWebRequested with every field an attestor needs."
p2 = "fulfil rebuilds the 188-byte origin-1 preimage from the stored request and the submitted response, digest and length, verifies the signatures with the bridge's verification shape, refuses a response longer than 4096 bytes, a length shorter than the response, a fulfilled or refunded request and a paused module, then stores the response, the digest and the length, marks the request fulfilled, pays the fee to the signers' payout accounts and calls the requester's onXWebResponse with the bounded gas. A reverting callback is recorded in the stored result and the fulfilment stands."
p3 = "Governance holds the attestor set, the threshold with its majority rule, the fee, the payload and callback caps, the timeout and the pause, through messages carrying the gov authority in the shape of modules/layerxbridge/types/msgs.go. The precompile exposes the views a contract or an auditor needs: the request, the result, the attestor set, the threshold and the fee."

[design.kernel]
title = "The kernel path"
p1 = "The kernel learns a web observation activity beside the oracle push activity. Its payload is the origin-2 preimage fields, the stored response bytes and the signatures. Intake rebuilds the preimage, recovers each signer with lxp_secp256k1_recover_address, requires strictly ascending registered signers at the kernel web attestor threshold, requires a pending program web request with the same program id, request id, kind and payload hash, and commits the observation. The sequencer folds committed observations into a web root in the batch header the way lx_oracle_root.c folds oracle observations, so replay reproduces them."
p2 = "A program asks for data by emitting a web request record through event_emit - a fixed topic defined in lx_web.h followed by the request id, the kind and the payload - and paying the web fee account with transfer_402 in the same call; the call bridge records the pending request only when both succeed. web_read takes a request id and an output buffer and returns the committed response, digest and length, or absent. It reads committed state only, so program execution never dials out."
p3 = "Attestor sidecars watch program web request records through the gateway, fetch independently, sign the origin-2 digest, exchange signatures and post the observation activity once the threshold is reached, in the same encoding the C adapter produces, asserted byte for byte against a shared vector."

[tasks]
heading = "Implementation Plan: the Paxeer X Network Web Search Sidecar and xweb Precompile"

# --------------------------------------------------------------------------
# REQUIREMENTS
# --------------------------------------------------------------------------

[req.1]
title = "The Sidecar Binary, Its Configuration and Its HTTP Server"
story = "As a node operator, I want one sidecar binary with one configuration file and no hidden defaults, so that I know exactly what my node serves and on what terms."
ac_1 = "THE crate interop/crates/x-websearch SHALL build the binary x-websearch as a member of the interop workspace under its lints, SHALL use a std-library HTTP server with no axum, tokio or hyper dependency, and SHALL use std::net::TcpStream with native-tls for outbound HTTP as interop/crates/layerx-gas-station/src/rpc.rs does."
ac_2 = "THE configuration loader SHALL decode a JSON file with unknown fields refused and SHALL refuse a missing or placeholder listen address, data directory, seed list, crawl budget, fetch limit, asset id, price, gateway endpoint, sequencer trust input, EVM endpoint or chain id, naming the field in every refusal."
ac_3 = "THE sidecar SHALL read the attestor key, the submitter key and the 402 receiver key only from files named by X_WEBSEARCH_ATTESTOR_KEY_FILE, X_WEBSEARCH_SUBMITTER_KEY_FILE and X_WEBSEARCH_RECEIVER_KEY_FILE, SHALL refuse a key found in the configuration file, and SHALL never log key material."
ac_4 = "THE HTTP server SHALL serve GET /health free and GET /search, GET /fetch and GET /content/<digest> as paid resources, SHALL bound the worker pool, the request line, the header size and the read time, and SHALL answer a malformed request with 400, an unknown path with 404 and an unsupported method with 405."
ac_5 = "TESTS SHALL start the real server on the loopback interface and cover the configuration's acceptance and each refusal, the key-file rules, the health route, each bound and each error status."

[req.2]
title = "Fetch, Extraction and the Canonical Content Digest"
story = "As a contract or an agent relying on fetched data, I want two independent sidecars that saw the same page to produce the same 32 bytes, so that agreement on a digest means agreement on the content."
ac_1 = "A FETCH SHALL accept only http and https, SHALL refuse loopback, private, link-local and multicast destinations after name resolution unless allow_loopback is set, SHALL enforce a 3 second connect limit, a 10 second total limit, a 2 MiB body limit and at most three redirects each re-checked, and SHALL refuse a URL robots.txt disallows for the user-agent token x-websearch."
ac_2 = "EXTRACTION SHALL drop script, style, noscript and template elements from text/html, turn block elements into line breaks and decode entities, SHALL pass text/plain and application/json through, and SHALL refuse every other media type."
ac_3 = "CANONICALISATION SHALL decode to UTF-8 from the declared charset refusing invalid input, turn CRLF and CR into LF, remove control characters other than LF and TAB, collapse runs of spaces and tabs to one space, remove trailing spaces from each line, collapse three or more LF to two, trim leading and trailing whitespace and apply Unicode NFC."
ac_4 = "THE canonical bytes SHALL be the ASCII domain PAXEERX_WEB_CONTENT_V1, the kind byte, the payload with a big-endian uint32 length, the lower-case media type without parameters with a uint32 length, and the text with a big-endian uint64 length, and THE content digest SHALL be keccak256 of those bytes with no clock, header, host name or node identity in them."
ac_5 = "THE sidecar SHALL write the canonical bytes to its content store under their digest, and GET /content/<digest> on any sidecar SHALL return exactly those bytes, retrieving a digest it does not hold from its configured peer sidecars and keeping it only when the recomputed digest matches, or 404 when no peer holds it."
ac_6 = "TESTS SHALL fetch committed pages from a real loopback server and assert the extracted text and the digest against committed vectors, and SHALL cover each destination, limit, redirect, robots.txt and media-type refusal."

[req.3]
title = "The Crawler and the Local Index"
story = "As a node operator, I want my node to build its own search index from seeds I choose, so that search needs no outside vendor and no API key."
ac_1 = "THE crawler SHALL walk the configured seed list within the crawl budget - pages per cycle, pages per host, maximum depth and per-host politeness delay - through the same fetch path and refusals as a fetch, and SHALL honour robots.txt for x-websearch."
ac_2 = "THE index SHALL be a tantivy index under the data directory with the fields url, title and body, and re-crawling a page SHALL replace its document rather than add a second."
ac_3 = "SEARCH SHALL return at most ten results of url, title and snippet sorted by score descending then url ascending, and its canonical bytes SHALL be the compact JSON array in that order with no score in the bytes."
ac_4 = "NO third-party search vendor, search API or API key SHALL appear in the crate, its configuration or its documentation."
ac_5 = "TESTS SHALL crawl a committed site from a real loopback server and cover the budget limits, the depth limit, the politeness delay, a robots.txt disallow, a re-crawl replacing its document, and a search's order and canonical bytes."

[req.4]
title = "Pay Per Request Over 402LXP"
story = "As an agent, I want to pay a sidecar per request in the asset I hold and get the resource only when the payment has really settled, so that paying is simple and nobody is paid for nothing."
ac_1 = "THE sidecar SHALL be a 402LXP seller built on interop/crates/layerx-x402, offering on every paid route the metered scheme with one grant and one draw per request and the exact scheme as the fallback alternative, in PAYMENT-REQUIRED, and SHALL read the buyer's payment from PAYMENT-SIGNATURE."
ac_2 = "THE accepted assets SHALL be exactly SID, PAX, USDC and USDL, each identified by its registered kernel asset id from the configuration, and the loader SHALL refuse a missing asset, an extra asset, a zero id and a placeholder id."
ac_3 = "THE price per request SHALL be an operator-set amount per asset in that asset's base units, and the configuration example and the documentation SHALL state that its initial value equals one tenth of a US cent at the time of configuration."
ac_4 = "SETTLEMENT SHALL be verified through the gateway as spec/402lxp/protocol.md defines - the draw submitted with lx_sendActivity, a pending result recovered with lx_getActivityStatus or lx_getReceipt, the receipt's sequencer signature verified against configured trust inputs - and the sidecar SHALL return PAYMENT-RESPONSE with lxp:<receipt_digest> only after that verification."
ac_5 = "A PENDING or unknown settlement, a receipt for another request, a changed request under the same key and an unverified signature SHALL release nothing, and a retry of the same request SHALL reuse the same signed activity and idempotency key."
ac_6 = "TESTS SHALL drive the real seller against a recorded gateway exchange in the existing fixture format and cover a metered success, an exact success, each asset, the pending recovery, each refusal above, and SHALL write the recorded client-side exchange the SDK and MCP tests replay."

[req.5]
title = "The xweb Module"
story = "As a contract author, I want a module that records my request, accepts only a majority-attested answer and pays the attestors who gave it, so that external data on chain is as trustworthy as its attestor set."
ac_1 = "THE module modules/xweb SHALL store each request under a monotonically increasing nonce with the requester, the kind, the payload hash, the callback gas, the fee and the height, and SHALL emit an XWebRequested event carrying every field an attestor needs."
ac_2 = "FULFIL SHALL rebuild the 188-byte preimage modules/xweb/ATTESTATION.md specifies, SHALL verify 65-byte signatures with v in 27 or 28, s at or below half the order, strictly ascending recovered signers, every signer registered and at least the threshold, in the shape of modules/layerxbridge/keeper/bridge.go verifySignatures using modules/layerxbridge/types.RecoverSigner read-only."
ac_3 = "FULFIL SHALL store at most 4096 bytes of response content with the 32-byte digest and the full length, SHALL refuse a longer response, a length shorter than the response, a fulfilled or refunded request and a paused module, and SHALL split the fee equally among the signers' payout accounts with the integer remainder to the lowest signer."
ac_4 = "A REQUEST not fulfilled within the timeout in blocks SHALL be refundable to its requester exactly once, and a refunded request SHALL never be fulfilled."
ac_5 = "GOVERNANCE messages carrying the gov authority SHALL register and remove attestors with their payout accounts, set the threshold, the fee, the payload and callback caps and the timeout, and pause and unpause; the keeper SHALL refuse a threshold at or below half the set or above it and SHALL raise the threshold to the majority when an attestor is added."
ac_6 = "GO tests SHALL cover the request store and event, a fulfilment at threshold with the fee split, each signature refusal, each size refusal, the timeout refund and its refusals, each governance message and its refusals, and the preimage against the shared vector."

[req.6]
title = "The xweb Precompile and Its Solidity Interface"
story = "As a Solidity developer, I want one address and one interface for web data with a callback I can trust, so that using it is a call and a function."
ac_1 = "THE precompile SHALL live at 0x0000000000000000000000000000000000001019 in the package precompiles/xweb with XWeb.sol, abi.json, xweb.go, setup.go generated by scripts/bump_version and a versions file, SHALL be registered in precompiles/setup.go, and its interface SHALL be contracts/src/precompiles/IXWeb.sol."
ac_2 = "request(uint8,bytes,uint64) SHALL be payable with exactly the current fee in PAX and return the request id, fulfil(uint64,bytes,bytes32,uint32,bytes[]) SHALL call the module's fulfilment, and refund(uint64) SHALL call the module's refund; view methods SHALL return the request, the result, the attestor set, the threshold and the fee."
ac_3 = "AFTER a fulfilment the precompile SHALL call onXWebResponse(uint64,bytes32,uint32,bytes) on the requester with gas bounded by the request's callback gas and the module's maximum, and a callback that reverts or runs out of gas SHALL be recorded without undoing the fulfilment."
ac_4 = "A REFERENCE consumer under contracts/src/xweb SHALL accept the callback only from the precompile address and only for a request id it issued, and Foundry tests SHALL cover its acceptance and refusals and the interface's selectors against abi.json."
ac_5 = "GO tests SHALL drive the precompile through the EVM with the real keeper, covering request, fulfil with the callback succeeding, reverting and running out of gas, refund, each view, a wrong fee and a read-only call to a state-changing method."

[req.7]
title = "The Kernel Web Observation Activity"
story = "As a kernel program author, I want attested web data committed through the sequencer like oracle prices are, so that a program reads it deterministically and replay reproduces it."
ac_1 = "include/layerx/lx_web.h SHALL define the web observation activity id, the observation layout carrying the origin-2 preimage fields, the stored response of at most 4096 bytes and the signatures, and the web request record topic, beside lx_oracle.h and without changing it."
ac_2 = "INTAKE SHALL rebuild the preimage, recover each signer with lxp_secp256k1_recover_address, require strictly ascending registered signers at the kernel web attestor threshold, require low s and a pending program web request with the same program id, request id, kind and payload hash, and commit the observation exactly once."
ac_3 = "THE kernel web attestor set SHALL be registered through a kernel activity accepted only from the kernel's existing parameter authority, and SHALL refuse a threshold at or below half the set."
ac_4 = "THE sequencer SHALL fold committed observations into a web root in the shape src/sequencer/lx_oracle_root.c uses, and src/network/lx_web_adapter.c SHALL encode the activity in the shape of src/network/lx_oracle_adapter.c with a committed encoding vector."
ac_5 = "C tests with make targets SHALL cover an accepted observation, each signature, threshold and request refusal, a replay producing the same root, and the adapter's encoding against the vector."

[req.8]
title = "The web_read Host Import"
story = "As a kernel program, I want to read an attested web response by request id without ever dialling out, so that my execution stays deterministic."
ac_1 = "THE runtime SHALL allocate guest ABI 4 end to end in the shape of the v3 allocation, adding web_read(i32,i32,i32,i32)->i32 in a new layerx_v4 ABI group after layerx_v3, SHALL leave the v1 to v3 manifests, their frozen vectors and their checksum lines in programs/abi-frozen.sha256 byte-identical, SHALL append the v4 vector and its checksum line, and SHALL validate the import like oracle_read."
ac_2 = "web_read SHALL return the committed response, digest and full length for a request id owned by the calling program, SHALL return the absent code for a request with no committed observation, and SHALL refuse an output buffer too small or out of bounds."
ac_3 = "THE call bridge in src/modules/programs/call.c SHALL expose the committed observation to the runtime in the shape of the oracle view, and SHALL never perform network input or output."
ac_4 = "programs/sdk/rust SHALL expose a safe wrapper for web_read beside its oracle wrapper."
ac_5 = "TESTS in Rust and C SHALL cover a present read, an absent read, a read of another program's request, each buffer refusal and the unchanged frozen v1 to v3 manifests."

[req.9]
title = "Agent Clients and the MCP Tool"
story = "As an agent developer, I want a client that pays and fetches in one call and refuses content whose settlement or digest does not check out, so that I do not hand-roll the 402 exchange."
ac_1 = "agent/sdk/typescript and agent/sdk/python SHALL each expose search, fetch and content-by-digest against any sidecar endpoint, performing the 402LXP exchange with the SDK's existing grant, draw and settlement helpers."
ac_2 = "EACH client SHALL verify PAYMENT-RESPONSE before returning content, SHALL refuse a settlement whose payer or purpose does not match the challenge, and SHALL recompute the content digest of a fetch or content response and refuse a mismatch."
ac_3 = "agent/crates/layerx-mcp SHALL expose a web tool with search, fetch and content operations that pays through the same exchange and passes every spend through the crate's existing approval boundary."
ac_4 = "TESTS SHALL replay the sidecar's recorded exchange from a real loopback server and cover a paid success in each asset, a refused settlement, a digest mismatch and, for the MCP tool, an unapproved spend."

[req.10]
title = "Attestor Signing and the Submitter"
story = "As an attestor operator, I want my sidecar to answer requests on its own and get the answer posted once a majority agrees, so that I run one binary and not a relay."
ac_1 = "AN ATTESTOR sidecar SHALL watch XWebRequested events from the configured EVM endpoint to the configured confirmation depth, fetch the payload independently, build the origin-1 preimage and sign its digest with the web-attestor key."
ac_2 = "ATTESTORS SHALL exchange signatures with the configured peer sidecars over an authenticated route, and a signature over a different digest SHALL be discarded and recorded."
ac_3 = "THE submitter SHALL post fulfil once the threshold is reached with signatures in ascending signer order, SHALL sign the EVM transaction with the submitter key, SHALL journal the signed bytes before broadcast so a restart rebroadcasts rather than re-signs, and SHALL treat an already-fulfilled request as completed."
ac_4 = "THE attestor key SHALL be distinct from any consensus, validator, bridge, submitter or receiver key, and the sidecar SHALL refuse to start when two key files hold the same key."
ac_5 = "TESTS SHALL cover the watch against a recorded exchange, the preimage against the shared vector, the signature exchange and its refusal, the ascending order, the journal before broadcast, a restart rebroadcast and an already-fulfilled request."

[req.11]
title = "The Program Request Path End to End"
story = "As a kernel program author, I want to emit a request, pay for it and read the answer later, so that web data is one call away from my program."
ac_1 = "A PROGRAM SHALL request a fetch by emitting the web request record and paying the web fee account with transfer_402 in the same call, and the call bridge SHALL record the pending request only when both succeed."
ac_2 = "ATTESTOR sidecars SHALL watch program web request records through the gateway, fetch independently, sign the origin-2 digest and post the web observation activity through lx_sendActivity once the threshold is reached, in bytes equal to the C adapter's encoding vector."
ac_3 = "THE fee SHALL be split equally among the signing attestors' kernel accounts at intake with the remainder to the lowest signer."
ac_4 = "AN END-TO-END C test SHALL run a reference program that requests, pays, receives an observation and reads it with web_read, and a Rust test SHALL assert the sidecar's activity bytes equal the vector."

[req.12]
title = "Packaging and the Node Image"
story = "As an operator, I want the sidecar to come with my node the way everything else does, so that running it is configuration, not assembly."
ac_1 = "interop/deploy/x-websearch SHALL carry a Dockerfile building x-websearch from the interop workspace on pinned base images, a systemd unit running it with a dedicated user and a hardened sandbox, and a configuration example whose placeholders the loader refuses and whose allow_loopback is false."
ac_2 = "docker/docker-compose.yml SHALL gain an x-websearch service beside the node services, and the root Dockerfile SHALL build the binary and copy it into the node image."
ac_3 = "A CHECK script SHALL assert the Dockerfile's pinned bases, the unit's user and sandbox directives, the compose entry, the node image's copy of the binary, and that the loader refuses the configuration example."

[req.13]
title = "The v6.8 Upgrade Plan"
story = "As a validator, I want the chain half of this feature behind one named upgrade, so that nothing changes on my node until governance says so."
ac_1 = "THE name v6.8 SHALL be appended to node/tags and its handler registered in node/upgrades.go, adding the xweb store key through the upgrade's store loader and initialising the module's parameters to their documented defaults with an empty attestor set and the module paused."
ac_2 = "node/app.go SHALL wire the xweb keeper, module and store key, and the precompile's keeper accessor, and precompiles/xweb/versions and setup.go SHALL name v6.8 as regenerated by scripts/bump_version."
ac_3 = "NO state change of this feature SHALL take effect before the upgrade height, and a node replaying blocks below it SHALL produce exactly the state it produces without this feature."
ac_4 = "TESTS SHALL assert the handler is registered under the name in node/tags, the store is added, the defaults are set, the module is paused and the precompile answers only after the upgrade."

[req.14]
title = "The Documentation Page"
story = "As a developer arriving cold, I want one page that says what the web service is, how to pay for it and how to call it from a contract or a program, so that I can use it without reading the code."
ac_1 = "docs/site/docs/protocol/xweb.md SHALL follow the shape of docs/site/docs/protocol/sidiora.md and describe the sidecar, the four assets and the price rule, the three routes and GET /content/<digest>, the contract path with the precompile address and the callback, the attestor majority, the kernel path with web_read, and that the chain change arrives through the v6.8 upgrade and a governance proposal."
ac_2 = "THE page SHALL be linked from docs/site/mkdocs.yml, SHALL carry no date, hostname, IP address, node count, internal URL or credential, SHALL name the product Paxeer X Network, and SHALL use no link but https://paxeer.app, paths under github.com/Sidiora-Labs/Paxeer-X-Network and relative links inside the site."
ac_3 = "THE site SHALL build with mkdocs build --strict."

[req.15]
title = "A Local Dry Run"
story = "As the person who will turn this on, I want the sidecar loop proven end to end against local nodes first, so that the first real run is not the first run."
ac_1 = "A DRY RUN script SHALL start anvil, a real loopback web server serving committed pages, and three local x-websearch processes with run-local attestor keys and allow_loopback set, and SHALL deploy the reference consumer to anvil."
ac_2 = "THE three sidecars SHALL fetch the same page independently and produce the same digest and valid ascending signatures over the origin-1 preimage, the submitter SHALL assemble fulfil calldata that decodes against precompiles/xweb/abi.json, and the consumer's callback SHALL be delivered on anvil from the impersonated precompile address with the attested response and the bounded gas."
ac_3 = "THE run SHALL touch no public network, SHALL stop with a message naming a missing tool rather than skipping a step, and SHALL record its exchange as a replayable fixture carrying no key material, no endpoint but the loopback ones it started and no date or hostname."

[req.16]
title = "One Workflow and One Recorded Run"
story = "As a reviewer, I want one workflow whose filters and job names are true and one recorded run on the merged revision, so that a green check means this feature was tested."
ac_1 = "ONE workflow .github/workflows/xweb-test.yml SHALL run on pull requests and pushes touching the trees this feature changes, with a concurrency group per ref and cancel-in-progress, and SHALL carry legs named for what they run: the x-websearch crate, modules/xweb with precompiles/xweb, the Foundry consumer tests, the kernel web make targets with the runtime web_read test, and the SDK and MCP tests."
ac_2 = "NO job SHALL carry continue-on-error, every action SHALL be pinned the way the repository's existing workflows pin theirs, and a check script SHALL assert that every path filter names a path that exists and that every leg's command runs from the repository root."
ac_3 = "THE legs SHALL be run once on the merged revision of waves 1 and 2 and recorded in spec/paxeer-x-web/qualification.kvx as gate records carrying the task, the requirements, the revision, the command, the exit code and the log path, written only by having executed the command."
ac_4 = "ANY failure the run exposes that belongs to no task in this feature SHALL be recorded once as an observation and not chased, no gate SHALL be rerun to confirm a pass, and nothing SHALL be deployed."

# --------------------------------------------------------------------------
# TASKS
#   wave 1  foundations on disjoint trees; the sidecar crate is laid down
#           first and three tasks fill it in parallel
#   wave 2  integration: attestors and submitter, the program path,
#           packaging, the v6.8 plan, the page and the dry run
#   wave 3  one run of the workflow's command set on the merged revision
[req.17]
title = "A Contract Calls an API Beyond the Network"
story = "As a contract developer, I want my contract to call an HTTP API, with a credential when the API needs one, and receive an attested answer, so that on-chain logic can act on data that exists outside the network without my running an oracle."
ac_1 = "THE xweb module SHALL accept a request kind api whose payload names the method (GET or POST), an https URL, public request headers, a request body, a list of JSON pointers selecting the attested fields, an attestation level (majority, or single with a named attestor) and zero or more credential envelopes, SHALL bound each part and the whole within the payload cap, and SHALL refuse a payload naming an attestor outside the registered set or carrying more envelopes than registered attestors."
ac_2 = "A CREDENTIAL ENVELOPE SHALL be encrypted to one attestor's registered secp256k1 key with an ephemeral sender key (ECIES over secp256k1 with HKDF-SHA256 and AES-256-GCM), SHALL carry that attestor's address in the clear so each sidecar picks its own, and SHALL be decrypted by the sidecar in memory only: the plaintext SHALL never be written to a log, a fixture, the index, the content store or any file."
ac_3 = "THE SIDECAR SHALL perform an api request with the public headers plus the decrypted credential headers under the fetch limits and destination refusals of requirement 2, SHALL apply the JSON pointers to a JSON response and canonicalise the selected values in RFC 8785 form, SHALL treat an empty pointer list as the raw bounded body, and SHALL refuse a response that is not JSON when pointers are given or a pointer that resolves to nothing, naming the pointer."
ac_4 = "UNDER the majority level the module SHALL require the threshold of signatures over the canonical answer exactly as for a fetch; UNDER the single level it SHALL accept one signature from the named attestor only, and SHALL record the level in the stored result and in XWebFulfilled so a consumer can tell the two apart."
ac_5 = "THE Solidity library XWebApi SHALL let a contract build an api payload with get, post, select, withCredential and single and submit it through the precompile in one statement, and the TypeScript and Python clients SHALL build envelopes from the attestor set the precompile exposes, so a developer needs no encoding knowledge."
ac_6 = "TESTS SHALL cover the payload codec and every refusal in Go, the envelope round trip against one vector file shared by Go, Rust, TypeScript and Python, the sidecar's api call against a loopback server that refuses a call without the credential header, the absence of the credential from every file the sidecar writes and from its log output, the pointer selection and canonicalisation vectors, both attestation levels through the precompile, and the library through a Foundry consumer."

# --------------------------------------------------------------------------

[task.1]
section = "Wave 1 - Foundations"
title = "Build the sidecar, the module and precompile, the kernel path, the clients and the workflow"
status = "pending"

[task.1.1]
title = "Lay down the x-websearch crate, its configuration and its HTTP server"
status = "done"
revision = "c3df0c451b32c6709af9cb33b0d55449beaad13e"
command = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test config --test keys --test server'"
exit_code = 0
log_path = ".logs/verify.log"
wave = 1
requires = []
do_1 = "Create interop/crates/x-websearch as a member of interop/Cargo.toml under the workspace lints, with the binary x-websearch, declaring every dependency the feature's crate tasks use - serde, serde_json, sha3, k256, native-tls, tantivy, unicode-normalization and layerx-x402 - so interop/Cargo.lock changes once, here; add no axum, tokio or hyper."
do_2 = "Write src/config.rs decoding the JSON configuration with unknown fields refused: listen address, data directory, seed list, crawl budget, fetch limits with allow_loopback, the four assets with kernel asset ids and prices, gateway endpoint and sequencer trust inputs, EVM endpoint, chain id and confirmation depth, kernel network id and peer sidecars; refuse every missing or placeholder value naming the field, and refuse any key material in the file."
do_3 = "Write src/keys.rs loading the attestor, submitter and receiver keys only from the files X_WEBSEARCH_ATTESTOR_KEY_FILE, X_WEBSEARCH_SUBMITTER_KEY_FILE and X_WEBSEARCH_RECEIVER_KEY_FILE name, refusing two files holding the same key, and never formatting key material."
do_4 = "Write src/server.rs as a std::net::TcpListener server with a bounded worker pool, request-line, header and read-time limits and one response per connection, routing GET /health, GET /search, GET /fetch and GET /content/<digest> through a route table later tasks fill, answering 400, 404 and 405 as specified; write src/lib.rs and src/main.rs wiring configuration, keys and server."
do_5 = "Write tests/config.rs covering acceptance and each refusal from committed configuration files under tests/fixtures/config, tests/keys.rs covering the key-file rules, and tests/server.rs starting the real server on the loopback interface and covering the health route, each bound and each error status."
verify_cmd = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test config --test keys --test server'"
symbols = ["Config","load","KeyFiles","Server","Route","x-websearch"]
touches = ["interop/Cargo.toml","interop/Cargo.lock","interop/crates/x-websearch/Cargo.toml","interop/crates/x-websearch/src/lib.rs","interop/crates/x-websearch/src/main.rs","interop/crates/x-websearch/src/config.rs","interop/crates/x-websearch/src/keys.rs","interop/crates/x-websearch/src/server.rs","interop/crates/x-websearch/tests/config.rs","interop/crates/x-websearch/tests/keys.rs","interop/crates/x-websearch/tests/server.rs","interop/crates/x-websearch/tests/fixtures/config"]
tests = ["interop/crates/x-websearch/tests/config.rs","interop/crates/x-websearch/tests/keys.rs","interop/crates/x-websearch/tests/server.rs"]
reqs = ["1.1","1.2","1.3","1.4","1.5"]

[task.1.2]
title = "Fetch pages, extract and canonicalise their text and compute the content digest"
status = "done"
revision = "86639b30a707bfa4ad6ebf3b7d83441f0eeffa61"
command = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test fetch --test content --test canonical'"
exit_code = 0
log_path = ".logs/verify.log"
wave = 1
requires = ["1.1"]
do_1 = "Write src/fetch.rs over std::net::TcpStream with native-tls: http and https only, destination checks after name resolution refusing loopback, private, link-local and multicast unless allow_loopback is set, a 3 second connect limit, a 10 second total limit, a 2 MiB body limit and at most three redirects each re-checked."
do_2 = "Write src/robots.rs parsing robots.txt for the user-agent token x-websearch with a per-host cache, and refuse a disallowed URL in fetch."
do_3 = "Write src/extract.rs dropping script, style, noscript and template elements from text/html, turning block elements into line breaks and decoding entities, passing text/plain and application/json through and refusing every other media type; write src/canonical.rs applying the canonicalisation steps in the decision's order and building the PAXEERX_WEB_CONTENT_V1 canonical bytes and their keccak256 digest."
do_4 = "Write src/content.rs storing canonical bytes under their digest in the data directory and serving GET /content/<digest> with exactly those bytes, retrieving a digest it does not hold from the configured peer sidecars and keeping it only when the recomputed digest matches, or 404 when no peer holds it; register the /fetch and /content routes' handlers behind the payment hook task 1.4 fills; add the module lines to src/lib.rs."
do_5 = "Write tests/fetch.rs against a real loopback server serving committed pages under tests/fixtures/site, asserting extracted text and digests against committed vectors in tests/fixtures/content-vectors.json, and covering each destination, limit, redirect, robots.txt and media-type refusal; write tests/content.rs starting two real sidecar servers on the loopback interface and covering a local hit, a peer retrieval, a peer answer whose digest does not match and a digest no peer holds; write tests/canonical.rs covering each canonicalisation step on its own."
verify_cmd = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test fetch --test content --test canonical'"
symbols = ["fetch","Robots","extract","canonical_bytes","content_digest","ContentStore"]
touches = ["interop/crates/x-websearch/src/lib.rs","interop/crates/x-websearch/src/fetch.rs","interop/crates/x-websearch/src/robots.rs","interop/crates/x-websearch/src/extract.rs","interop/crates/x-websearch/src/canonical.rs","interop/crates/x-websearch/src/content.rs","interop/crates/x-websearch/tests/fetch.rs","interop/crates/x-websearch/tests/content.rs","interop/crates/x-websearch/tests/canonical.rs","interop/crates/x-websearch/tests/fixtures/site","interop/crates/x-websearch/tests/fixtures/content-vectors.json"]
tests = ["interop/crates/x-websearch/tests/fetch.rs","interop/crates/x-websearch/tests/content.rs","interop/crates/x-websearch/tests/canonical.rs"]
reqs = ["2.1","2.2","2.3","2.4","2.5","2.6"]

[task.1.3]
title = "Crawl the seed list into a local tantivy index and serve search"
status = "done"
revision = "8b67bb9d153d28c2682fd8c1746eb0b5f14f4340"
command = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test crawl --test search'"
exit_code = 0
log_path = ".logs/verify.log"
wave = 1
requires = ["1.1","1.2"]
do_1 = "Write src/crawl.rs walking the configured seed list through the fetch path and its refusals within the crawl budget - pages per cycle, pages per host, maximum depth, per-host politeness delay - and honouring robots.txt for x-websearch."
do_2 = "Write src/index.rs opening a tantivy index under the data directory with url, title and body fields, replacing a re-crawled page's document by url rather than adding a second."
do_3 = "Write src/search.rs returning at most ten results of url, title and snippet sorted by score descending then url ascending, and building the search canonical bytes as the compact JSON array with no score; register the /search route handler behind the payment hook; add the module lines to src/lib.rs."
do_4 = "Write tests/crawl.rs crawling a committed site from a real loopback server and covering the budget, depth and politeness limits, a robots.txt disallow and a re-crawl replacing its document; write tests/search.rs covering result order, the ten-result cap and the canonical bytes against a committed vector."
