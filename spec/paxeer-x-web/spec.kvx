[task.1.4]
title = "Make the sidecar a 402LXP seller in SID, PAX, USDC and USDL"
status = "done"
revision = "75a4cabab81e672b30ab77d31461a18626ec2465"
command = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p layerx-x402 && cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test payment'"
exit_code = 0
log_path = ".logs/verify.log"
wave = 1
requires = ["1.1"]
do_1 = "Write src/assets.rs holding exactly SID, PAX, USDC and USDL with their kernel asset ids and per-request prices from the configuration, refusing a missing asset, an extra asset, a zero id and a placeholder id or price."
do_2 = "Write src/payment.rs building PaymentRequired through layerx-x402 with, for each asset, a metered offer bound to one grant and one draw per request and an exact alternative, returned base64 in PAYMENT-REQUIRED; read PAYMENT-SIGNATURE, settle through Seller with the receiver key signing the ordinal-6 draw, submit through the gateway with lx_sendActivity, recover a pending result with lx_getActivityStatus or lx_getReceipt, and verify the receipt's sequencer signature against the configured trust inputs. The 402LXP adapter's LayerX profile names only the native main account today, so extend interop/crates/layerx-x402 in the same task: extra.layerx.account may also name the per-asset account agent:<did>:asset:<asset id> whose asset id equals the offer's asset, payTo stays bound to the account id derived from whichever reference the offer carries, every other form stays refused, and the adapter's own tests cover the accepted and the refused forms. Declare the crates the seller path needs in the sidecar manifest; the sidecar builds the receive activity and its signature through the existing Rust codecs, never a private re-encoding."
do_3 = "Persist the association of payer, request, offer, activity bytes, idempotency key and receipt in the data directory so a retry reuses the same signed activity and a receipt never releases a second request; release the resource with PAYMENT-RESPONSE carrying lxp:<receipt_digest> only after verification, and release nothing on a pending, unknown, mismatched or unverified result; fill the payment hook the routes call."
do_4 = "Write tests/payment.rs driving the real seller over the real server against a recorded gateway exchange under tests/fixtures/gateway in the relayer's fixture format, covering a metered and an exact success, each asset, the pending recovery and each refusal; write the client-side exchange it records to tests/fixtures/client-exchange.json for the SDK and MCP tests to replay."
verify_cmd = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p layerx-x402 && cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test payment'"
