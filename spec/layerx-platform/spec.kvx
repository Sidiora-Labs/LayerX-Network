[task.35]
section = "Wave 21 - Verifiable Off-Platform Compute"
title = "Settle rented compute the platform did not execute, without trusting the provider"
status = "pending"
note = "Parallel lanes: 35.1 lands the commitment scheme first. Then 35.2 and 35.4 are two independent agents on verification and the marketplace, with 35.7 running independently beside them. 35.3 follows 35.2, 35.5 and 35.6 follow 35.4, and 35.8 closes."

[task.35.1]
title = "Commit to execution state per step"
status = "pending"
wave = 21
requires = ["32.3"]
