# spec.kvx - LayerX Platform. SINGLE SOURCE OF TRUTH for this feature.
#
# requirements.md / design.md / tasks.md next to this file are GENERATED from it
# by spec/specgen. Never hand-edit those; edit this file and regenerate.
#
# Drive the work with:  cg spec next -> cg spec start <id> -> cg spec done <id>
# Provenance: docs/00-source-brief.md plus the owner's platform priority stack
# (developer platform, permissionless programs, interoperability gateway,
# multichain surface).
# Upstream normative sources: spec/layerx-protocol/spec.kvx (the protocol wins)
# and spec/layerx-agent-interface/spec.kvx (normative for the boundary and the
# agent layer this plane consumes).
#
# This spec SUPERSEDES spec/layerx-human-interface as the active feature. It
# carries that feature's requirements (req.1-23) and tasks (task.1-14) verbatim
# with their live statuses, and extends them with the platform pillars:
# the developer platform (req.24-27), LayerX Programs (req.28-31), the
# universal interoperability gateway (req.32-33) and the multichain surface
# (req.34). Task ids, wave numbers and statuses carried from the human-interface
# spec are continuous here; in-flight work continues without renumbering.

[meta]
feature      = "layerx-platform"
title        = "LayerX Platform - The Complete Surface"
kind         = "platform-specification"
version      = "1.0.0"
status       = "draft"
language     = "C17 core extension; Rust services and tooling; TypeScript, Python, Go, JVM, Swift and C# SDKs; TypeScript web application"
repo_root    = "human/ (control plane); platform/ (developer platform); programs/ (programs runtime); interop/ (interoperability gateway)"
upstream     = "spec/layerx-protocol (normative for protocol behaviour); spec/layerx-agent-interface (normative for the node boundary and the agent layer); supersedes spec/layerx-human-interface as the active feature, carrying its requirements and tasks verbatim"
intro        = "The LayerX Platform is the complete product surface of LayerX: the human control plane, the developer platform, permissionless programmability, the universal interoperability gateway and the multichain surface, specified as one feature so one task graph governs all of it. The human control plane is carried whole from the human-interface specification: a KMS-backed custody service signing only through the disclosure-bound path, the typed-intent compiler as the plane's single payload authority, the additive approval module, the Paxeer custody-boundary client, the rebuildable public explorer and one web application with two native shells, exposing exactly five ideas and rendering Done only against a verified LayerX receipt or Paxeer finality proof. On top of it this spec adds four pillars. First, the developer platform: production SDKs in seven languages generated from one schema, buyer, seller, merchant and agent middleware, framework integrations, a CLI, a local emulator running the real transition function, a hosted testnet with faucet, a hosted gateway with API keys, webhooks and dashboards, runnable reference applications and documentation, all gated on the benchmark that an agent or API adds LayerX payments in fewer than ten lines and completes a test payment in five minutes. Second, LayerX Programs: a deterministic WASM runtime hosted by a new programs module on the existing kernel, giving developers permissionless deployment of economic applications with capability-based kernel APIs, namespaced storage, explicit metering, versioned ABI, program-to-program composition, registries with source verification, and every monetary effect forced through 402LXP with no program ever holding direct balance-writing authority. Third, the universal interoperability gateway: first-class x402 v2 buyer, seller and facilitator roles, AP2 checkout and payment mandates, UCP merchant profiles and order flows, A2A and MCP payment transports, Visa Trusted Agent credentials, Ethereum and Solana migration tooling and card, bank and real-time-payment adapters, every one translating at the edge while 402LXP remains the internal law. Fourth, the multichain surface: batch mirror archives on external chains as pure archives, independent verification from any mirror, a ramp toolkit that lets third parties operate market-maker on and off ramps as ordinary LayerX principals, and domain-tagged claim vocabulary reserved so future settlement domains are additive - while the custody guarantee remains Paxeer alone and the one-ledger invariant stays sacred. These requirements are normative; the design and the task plan beside them are compiled from this file."

# Decisions locked before implementation begins. These supersede any ambiguity
# in docs/00-source-brief.md. Where they touch protocol or agent-layer behaviour
# they defer to the upstream specs, which are normative for those layers.
[decision]
custody             = "Custodial by default. Human authentication is passkey-first. Human and managed-agent DID primary keys are generated and held inside layerx-human-service's KMS-backed keystore and never leave it, never reach the browser, and are never derivable from the login credential. Key export and self-custody are out of scope for v1."
signing             = "The custody service signs exclusively through the disclosure-bound signing path the agent layer defines: the exact canonical byte string plus a structured disclosure that must re-encode byte-identically, or the signer refuses. It acts as the remote signer role of layerx-crypto; layerx-agentd remains a non-custodian of primary keys."
intents_only        = "layerx-intents is the only component in human/ that constructs protocol payload bytes. The browser and the web application never assemble payloads, never see canonical bytes except as opaque evidence, and speak only human-api. A CI gate fails the build if any other human/ component depends on layerx-wire encoding entry points."
seams_first         = "The approval.* operation module is an additive agent-layer contract change within contract major 1, specified and built in the first wave of this feature so the agent-interface spec's scope and qualification gate stay clean. The typed-intent compiler lives in the human workspace and reaches the core through the agent layer's existing prepare, sign and submit pipeline - no second write path is added to the agent contract."
wallet_boundary     = "The Paxeer EVM wallet signs at the custody boundary only: the domain-separated binding statement, the deposit transaction, the withdrawal claim, the emergency exit claim. It opens only at those explicit signing moments - exactly once per required signature - is never a login method, and per protocol design its binding grants the EVM key no authority over LayerX balances."
vocabulary          = "Deposit and withdrawal name movements across the Paxeer custody boundary exclusively. Movements inside LayerX are fund, allocate, return or transfer, surfaced in the UI as one verb: Move money. The route resolver picks the protocol mechanism; the user never selects a transfer type."
done_is_receipt     = "No surface of this plane renders a success state for a money movement or a protocol mutation unless a locally verified LayerX receipt or a verified Paxeer finality proof backs it. Unknown outcomes render as still-checking, never as success or failure, and are resolved only by receipt lookup."
reclaim             = "A human takes money back from a managed agent only by defunding a protocol budget, by an agent-authorised transfer, or by drawing a receive under an explicit payer grant. There is no key-based sweep of an agent account, even though the custody service holds the agent's keys."
two_shells          = "One Next.js application serves a public /explorer plane and an authenticated /app plane, with two native shells: a mobile shell and a desktop shell that share state, data hooks and journey logic but render device-specific layouts and components. Shell selection is SSR-safe from viewport and pointer capability, never user-agent sniffing alone; tablets receive the desktop layout with touch-sized targets."
ui_rules            = "Client UI uses the exact styling and component API of the owner-supplied @layerx/ui package. Its borders, dividers, shadows, gradients, palette, radii, typography and interaction states are authoritative in both shells; application code composes the package instead of restyling its primitives, and CI enforces the package integration."
error_standard      = "Every screen ships its full state matrix - loading, empty, error, offline, degraded and, where money moves, still-checking - and every error state is a designed, user-friendly screen with actionable buttons such as Retry, Reload and Report. A blank screen, a raw stack trace or a dead-end error is a build defect, not a polish item."
emergency_exit_v1   = "The emergency exit ships in v1 as a minimal guided flow under Settings - it is a protocol safety property presented calmly, and it must remain usable when LayerX itself is degraded."
explorer_public     = "The public explorer is server-rendered, requires no authentication, shows protocol-public data only, and is served from layerx-explorer-index - a rebuildable projection fed exclusively through the node boundary, inheriting the agent layer's prohibition on reading node internals."
v1_scope            = "Version 1 ships onboarding, wallet binding, the managed-agent lifecycle, deposits, internal movements, withdrawals with claims, the emergency exit, the approval inbox, notifications, the public explorer, the activity view with exports, audit export and support chat. Escrow, streams, services and perps workspaces, team roles beyond the owner, an address book, localization beyond copy-catalog readiness and self-custody key export are post-v1 and out of scope."
human_api           = "human-api is a versioned HTTPS+JSON contract defined in human/schema/human-api. Within one major version changes are additive only. The TypeScript client used by the web application is generated from the schema; hand-editing generated output is a build failure."
dev_benchmark       = "The developer platform is gated on one measurable promise: an agent or API adds LayerX payments in fewer than ten lines of integration code and completes a verified test payment within five minutes from a clean environment, following only the published quickstart. Both figures are CI-enforced gates over the real published artifacts, not marketing copy."
sdk_single_schema   = "Every SDK - Rust, TypeScript, Python, Go, Java/Kotlin, Swift, C# - is produced from the same agent-api and human-api schemas in the same build, with a cross-language parity suite and golden vectors. Idiom differs per language; wire behaviour, error taxonomy and receipt verification are identical. Hand-editing generated output is a build failure in every language."
programs_module     = "LayerX Programs is a new protocol module named programs, registered through the existing module system as a versioned transition-function change. The kernel is unchanged: programs are guest code hosted inside the programs module's namespace, not new modules, and deploying one is an ordinary activity requiring no governance action. The module boundary law of the protocol spec applies to the programs module exactly as to every other module."
programs_runtime    = "The programs runtime is deterministic WASM: no clocks, no networking, no floating point, no threads, no randomness, no ambient authority. CPU, memory and storage are explicitly metered and charged as fees. The runtime version is recorded per batch and replay executes under the recorded version. A program failure or resource exhaustion is a typed activity failure with full rollback, never a node fault."
programs_money_law  = "No program ever receives balance-writing authority. Every monetary effect a program produces is expressed as authenticated 402LXP transfers applied by the kernel transfer primitive, authorised only within the authority of the activity that invoked the program. INVARIANT 1 of the protocol extends to guest code unchanged: a balance change outside a 402LXP transfer aborts the transition."
interop_edge        = "External protocols - x402 v2, AP2, UCP, A2A, MCP, Visa Trusted Agent, card, bank and RTP rails - are spoken by adapters at the gateway edge. Adapters translate; they never gain protocol authority, never construct payload bytes outside layerx-intents' equivalents in their own plane, and never render an outcome the backing LayerX receipt or external settlement evidence does not support. 402LXP remains the only internal financial law."
external_settlement = "Money entering LayerX through an external rail is credited only against verified settlement evidence from that rail's provider, with honest pending states while evidence is outstanding, and chargeback or reversal exposure modelled as typed states, never hidden. Card data never touches LayerX components; it is tokenised at the provider edge."
multichain_surface  = "The multichain surface is presence, not custody. Batch mirror archives are published to external chains as pure archives - commitments plus retrievable data, no vaults, no portals, no custody semantics - and anyone can verify LayerX state from a mirror alone. The protocol's custody and withdrawal guarantee remains Paxeer exclusively. Third-party on and off ramps are market makers operating ordinary LayerX accounts over existing rails; the protocol grants them no special authority and default surfaces never present them as LayerX custody. Claim and receipt vocabulary is domain-tagged in schemas now so a future settlement domain is an additive change, and the one-ledger invariant - one identity, one balance system, one canonical order - is never traded away."
supersession        = "This spec supersedes spec/layerx-human-interface as the active feature. Requirements 1-23, tasks 1-14, their ids, wave numbers, statuses and every decision above this entry are carried verbatim and remain binding; in-flight work continues under the same task ids without interruption."

[design]
include = "design.body.md"

[tasks]
heading          = "Implementation Plan: LayerX Human Interface"
overview_include = "tasks.overview.md"
notes_include    = "tasks.notes.md"

# --------------------------------------------------------------------------
# REQUIREMENTS
# --------------------------------------------------------------------------

[req.1]
title = "Non-Authority and Receipt-Backed Truth"
story = "As a person trusting this app with money, I want the human plane to be structurally incapable of telling me something the protocol did not do, so that what the screen says happened is what actually happened, every time."
ac_1 = "WHEN any component of the human plane effects a change of protocol state THE plane SHALL do so exclusively by compiling a typed intent into canonical module payload bytes through layerx-intents, preparing the activity through the agent layer's prepare operation, obtaining a disclosure-bound signature from the custody service over the exact prepared canonical bytes, and submitting them through the agent layer, and SHALL possess no other path by which protocol state can change."
ac_2 = "THE plane SHALL render a success or Done state for a money movement or protocol mutation only when a LayerX receipt verified through the agent layer's proof machinery, or a Paxeer finality proof verified by layerx-paxeer-client, backs that exact outcome, and the component that renders success SHALL be structurally unable to render it from any other input."
ac_3 = "WHEN the plane displays a balance, a movement outcome, an agent state, a budget figure or any other protocol fact THE plane SHALL display only values decoded from core-produced bytes with their verification status attached by the agent layer, SHALL never raise a verification level itself, and SHALL visibly mark any value it cannot verify to the required level."
ac_4 = "IF a submission's fate cannot be determined THEN THE plane SHALL present it as still checking, SHALL NOT present it as success or failure, SHALL resolve it only by receipt lookup under its idempotency key, and WHILE it remains unresolved THE plane SHALL disable every control that could duplicate the economic effect."
ac_5 = "IF the core refuses an activity THEN THE plane SHALL surface the refusal honestly, SHALL state in plain language whether any money left the account, and SHALL NOT retry into a different outcome, soften the result, or present a failed movement as pending because a retry is scheduled."
ac_6 = "THE plane SHALL maintain no ledger of balances or owed amounts that is not reconstructible from verified receipts alone, and WHEN the human-service store is deleted and the service restarted against the same core THE plane SHALL reconstruct every protocol-derived answer it serves, losing only declared local artefacts such as profile data, notification preferences, journey annotations and audit history."
ac_7 = "WHERE the plane shows a derived or prospective figure such as an estimated fee, an estimated arrival time or a spend projection THE plane SHALL label it an estimate, SHALL exclude it from any receipt-shaped presentation, and SHALL replace it with the receipt-backed actual once one exists."
ac_8 = "WHEN a read cannot be served fresh THE plane SHALL serve the last verified value marked with its age and the checkpoint or head it is relative to, and SHALL NOT silently present stale data as current."
ac_9 = "THE plane SHALL provide, for every claimed outcome, access to the underlying receipt or proof material sufficient for independent verification through the public explorer or exported evidence, and the qualification suite SHALL demonstrate that a tampered human-service altering a reported value is caught by independent verification of that evidence."
ac_10 = "THE plane SHALL treat the agent layer's contract as its only path to the core, SHALL NOT open the node database, read node log files, or link the node's internal structures, and CI SHALL fail the build when a dependency in human/ violates the boundary rules the agent layer defines."

[req.2]
title = "The Simplicity Contract"
story = "As a person with no crypto background, I want the app to expose only ideas I already understand, so that I can hold money, run agents and stay in control without learning a protocol."
ac_1 = "THE app SHALL expose exactly five top-level ideas - log in, add money, move money, manage agents, see what happened - and SHALL introduce no protocol concept as a navigation destination, decision point or required input anywhere on the default surfaces."
ac_2 = "WHEN a signed-in user initiates a common action - moving money, adding money, starting a withdrawal, creating an agent, acting on an approval - THE app SHALL complete the initiation in at most three decisions, where a decision is a screen requiring user choice or input, excluding authentication challenges."
ac_3 = "THE app SHALL keep a banned-vocabulary list in the copy catalog containing at least DID, session key, capability, nullifier, checkpoint, payload, canonical, idempotency, attestation and proof, SHALL enforce it with a copy lint that fails the build when a banned term appears on the authenticated plane's default surfaces - Technical details surfaces and the public explorer plane are exempt - and SHALL express every state in plain language instead."
ac_4 = "THE app SHALL never require a user to transcribe, retype or manually carry any identifier between screens; every identifier SHALL be copyable in one action, every reference SHALL be a link, and every flow that needs an identifier SHALL supply it itself."
ac_5 = "WHEN money moves between any two endpoints THE app SHALL resolve the protocol mechanism automatically through the route resolver, SHALL describe what will happen in plain language before commitment, and SHALL NOT ask the user to choose a transfer type, bridge, route or mechanism."
ac_6 = "WHERE an advanced control exists - verification detail, evidence export, audit, emergency exit - THE app SHALL reach it through progressive disclosure, and the advanced surface SHALL never interpose itself on the simple path."
ac_7 = "WHEN a custody-boundary journey needs the Paxeer wallet THE app SHALL open the wallet only at explicit signing moments, exactly once per signature the custody boundary requires - on a first journey with binding folded in, once for the binding statement and once for the custody signature - each with a plain-language statement of what the signature does, and SHALL never ask for a wallet signature at any other time."
ac_8 = "THE app SHALL present every protocol state through the normative status translation table in the design document, and a status string not in that table appearing on a default surface SHALL be a build failure."
ac_9 = "THE onboarding, deposit, move-money and create-agent journeys SHALL each be completable on a mobile device without documentation, and the qualification usability gate SHALL verify this with real participants against a declared success threshold."
ac_10 = "WHEN the user must wait THE app SHALL say what is happening and roughly how long it takes, SHALL state when it is safe to close the app, and SHALL never present a spinner without words on any journey surface."

[req.3]
title = "Human Identity and Onboarding"
story = "As a new user, I want creating an account to feel like any modern app - an email and a passkey - while the system stands up my protocol identity correctly underneath, so that I am protocol-safe without ever seeing the protocol."
ac_1 = "WHEN a person creates an account THE service SHALL establish a passkey-backed application identity as the primary credential, SHALL support a fallback credential without weakening the passkey path, and SHALL keep the application identity distinct from the LayerX DID and from any wallet."
ac_2 = "WHEN the application identity exists THE service SHALL generate the human's LayerX signing keys inside the custody keystore, SHALL register the human DID through a typed intent submitted via the agent layer, and SHALL treat the account as active only after the DID registration receipt verifies."
ac_3 = "WHEN the DID is registered THE service SHALL pre-register a recovery authority in the same onboarding journey through the protocol's recovery pre-registration mechanism - whose challenge delay applies when recovery is later exercised - and SHALL NOT allow the journey to complete silently without recovery in place."
ac_4 = "WHILE onboarding is in progress THE app SHALL show honest per-stage progress, SHALL present the account as ready only when ac_2 holds, and IF a stage fails THEN THE app SHALL preserve the journey, explain the failure plainly, and offer resumption without restarting completed stages."
ac_5 = "THE service SHALL make onboarding idempotent: repeating a stage after a crash, a timeout or a duplicate request SHALL converge on one application identity, one DID, one recovery registration and one set of receipts, with no orphaned protocol state."
ac_6 = "THE service SHALL store profile information such as display name and avatar as declared-local data, separated from protocol identity, editable and deletable without touching protocol state."
ac_7 = "THE service SHALL record, for the DID registration, the key activation, the recovery registration and any wallet binding, the verified receipt establishing when each became active, and SHALL surface that evidence under Technical details and in the audit export."
ac_8 = "WHEN a user signs in on a new device THE service SHALL require the passkey ceremony, SHALL record the device in the session inventory, and SHALL emit a security notification carrying an action that opens the device list."
ac_9 = "THE browser SHALL at no point receive, derive or cache LayerX private key material, and the qualification suite SHALL verify that the web application bundle and its runtime state contain no signing capability."
ac_10 = "IF the agent layer or the core is unavailable during onboarding THEN THE service SHALL complete the application-identity stage, SHALL queue the protocol stages with honest pending presentation, and SHALL NOT fabricate an active account."

[req.4]
title = "The Key Custody Service"
story = "As the owner of accounts and agents whose keys I never see, I want the custody service to guard signing power at least as carefully as a hardware wallet would, so that custody convenience never becomes custody exposure."
ac_1 = "THE service SHALL hold every human and managed-agent private key inside a KMS-backed keystore, SHALL keep key material out of process logs, error messages, metrics, traces, backups in plaintext and the browser, and SHALL zeroize in-memory key material on release."
ac_2 = "WHEN anything requests a signature THE service SHALL sign only through the disclosure-bound path: the exact canonical byte string together with a structured disclosure that re-encodes byte-identically to those bytes, and SHALL refuse to sign when the disclosure does not match, exactly as the agent layer's signer contract requires."
ac_3 = "WHERE an operation is designated step-up - acting on an approval, changing security settings, revealing a secret, initiating a withdrawal or exit, rebinding the payout wallet, archiving an agent - THE service SHALL require a fresh passkey ceremony bound to the specific operation, and SHALL reject a signature request for a step-up operation without one."
ac_4 = "WHEN a managed agent needs operating authority THE service SHALL provision a protocol session key to layerx-agentd with an explicit expiry, an explicit permitted activity set and a revocation path, SHALL never transfer a primary key, and SHALL propagate revocation promptly when the agent is paused or archived."
ac_5 = "THE service SHALL enforce per-principal isolation in the keystore so no request path can reach another human's keys or another human's agents' keys, and the isolation suite SHALL prove it adversarially."
ac_6 = "THE service SHALL append every signing decision - grant or refusal - to the audit log with the disclosure digest, the operation, the principal and the step-up evidence, and SHALL never write payload secrets or key material to the audit log."
ac_7 = "IF the KMS or keystore is unavailable THEN THE service SHALL refuse to sign with an honest error, SHALL NOT fall back to any lower-assurance key or cached material, and SHALL surface the degradation on its status surface."
ac_8 = "THE service SHALL support key rotation for human and agent DIDs through the protocol's rotation mechanism, SHALL present the challenge delay in plain time units, and SHALL keep the superseded key usable only for the window the protocol defines."
ac_9 = "THE service SHALL bound signing throughput per principal with typed refusals, so a compromised session cannot drain an account faster than limits allow, and the limits SHALL be declared configuration, not code constants."
ac_10 = "THE v1 service SHALL expose no key export path, and any future export SHALL be specified as its own feature; the qualification suite SHALL verify no API surface returns key material."

[req.5]
title = "Paxeer Wallet Binding"
story = "As a user with money on Paxeer, I want to link my EVM wallet once, safely, so that deposits and payouts flow to an address I control while my LayerX funds stay beyond the wallet's reach."
ac_1 = "WHEN a user links a Paxeer wallet THE plane SHALL obtain the EVM key's signature over the protocol's domain-separated binding statement naming the DID and network_id, SHALL submit the binding as a typed intent through the agent layer, and SHALL treat the binding as established only when its receipt verifies."
ac_2 = "THE plane SHALL treat the bound address as a payout and provenance association only, SHALL never accept an EVM signature as authorisation for any LayerX activity, and SHALL state on the binding surface, in one plain sentence, that the wallet cannot move LayerX funds."
ac_3 = "THE binding journey SHALL be deferred until first needed - the first deposit or withdrawal - SHALL open the wallet exactly once, and SHALL show the full address with a checksum-styled rendering, copy affordance and QR at every confirmation surface, never a truncation alone."
ac_4 = "WHEN a user replaces a bound wallet THE plane SHALL require step-up authentication, SHALL submit the rebinding through the same receipt-verified path, SHALL keep the old binding effective until the new receipt verifies, and SHALL emit a security notification with an action button."
ac_5 = "IF the wallet is unavailable, disconnects mid-journey or rejects the signature THEN THE plane SHALL show a designed state naming what happened and offering retry or cancel, and SHALL leave no partially-bound state behind."
ac_6 = "THE plane SHALL verify that the address that signed the binding statement is the address recorded in the receipt before presenting the binding as active, and a mismatch SHALL surface as a verification failure, never be silently accepted."
ac_7 = "WHERE no wallet is bound THE app SHALL present deposits and withdrawals as available-but-needs-linking, with the linking step folded into the journey rather than a separate errand."
ac_8 = "THE plane SHALL support at most one active bound payout wallet per human account in v1, SHALL display which address is bound wherever payouts are discussed, and SHALL record every past binding with its receipts in the audit trail."

[req.6]
title = "Approval Operations in the Agent Contract"
story = "As a human governing agents, I want approvals to be first-class operations of the agent layer contract, so that my app can list, inspect and decide holds with the same receipt-grade rigor as every other operation."
ac_1 = "THE agent-api contract SHALL gain an approval module - list, get, approve, reject - as an additive change within contract major 1, defined in the schema with golden vectors, and SHALL leave every existing declaration unchanged."
ac_2 = "WHEN a policy hold requires human approval THE daemon SHALL expose it through the approval module carrying the held activity's disclosure and the digest of its exact canonical bytes, and the disclosure SHALL re-encode byte-identically to the digest's preimage or the hold SHALL be reported as defective rather than approvable."
ac_3 = "WHEN an approval is granted THE daemon SHALL apply it to exactly the held digest - releasing exactly that prepared activity into the submission path - and SHALL treat any change to the underlying activity as voiding the hold, requiring a fresh preparation and a fresh hold."
ac_4 = "WHEN an approval is rejected THE daemon SHALL cancel the hold, release its reservations deterministically, and report the refusal to the requesting agent with a typed result, and rejection SHALL be final for that digest."
ac_5 = "THE daemon SHALL expire unactioned holds at their deterministic expiry exactly as the policy engine defines, SHALL release reservations on expiry, SHALL bound a hold's expiry by the held prepared activity's submission validity window so a granted approval is always releasable, and an expired hold SHALL NOT be approvable, with an approval attempt after expiry returning a typed expired result."
ac_6 = "THE approve and reject operations SHALL be idempotent under their idempotency keys: repeating a decision SHALL return the original outcome, and concurrent conflicting decisions SHALL resolve to exactly one winner with the loser receiving a typed conflict result."
ac_7 = "THE daemon SHALL emit approval lifecycle events - created, approved, rejected, expired - on the existing event stream so clients track holds without polling, and SHALL record each transition in the audit trail with its digest."
ac_8 = "THE generated TypeScript and Python SDKs and the Rust SDK SHALL gain the approval module from the same schema in the same build, the cross-SDK parity suite SHALL cover it, and the compatibility matrix SHALL record the minor version introducing it."
ac_9 = "THE approval surface SHALL be labelled a daemon-enforced restriction in every report, and nothing in it SHALL be described as protocol authority."

[req.7]
title = "Typed Intents and the Intent Compiler"
story = "As the operator of a plane whose users cannot inspect bytes, I want every payload built by one audited compiler from typed intents, so that what was described is provably what was signed."
ac_1 = "THE crate layerx-intents SHALL define a versioned typed-intent vocabulary covering, at v1: DID registration, key rotation, recovery registration, EVM payout binding, 402LXP send, 402LXP receive under a payer grant, payer grant registration, budget create, budget fund, budget defund, bridge deposit credit and bridge withdraw request, each intent carrying only domain-typed fields from layerx-types."
ac_2 = "WHEN an intent is compiled THE crate SHALL produce the canonical module payload bytes exclusively through layerx-types and layerx-wire, SHALL introduce no serialisation of its own, and SHALL reject at compile time any intent whose fields cannot produce a canonical payload."
ac_3 = "THE crate SHALL ship golden vectors for every intent kind proving intent-to-bytes stability across releases, and a vector change without a version bump SHALL fail the build."
ac_4 = "THE build SHALL run a differential gate proving that for every intent kind, compile then decode then disclosure re-encoding yields byte-identical payloads through layerx-wire, so the disclosure a human approves is provably the bytes signed."
ac_5 = "THE crate SHALL reject unknown intent versions and unknown intent kinds deterministically with typed errors, and SHALL preserve unknown-version inputs for diagnosis without executing them."
ac_6 = "THE crate SHALL accept amounts only as protocol integer types, SHALL perform no floating-point arithmetic, and SHALL enforce every protocol length and range bound at intent construction with typed errors."
ac_7 = "WHEN the service acts on an intent THE plane SHALL submit the compiled payload through the agent layer's existing prepare operation, SHALL verify field-for-field that the returned disclosure matches the originating intent before any signature is requested, and a mismatch SHALL abort the journey as a defect rather than being reconciled silently."
ac_8 = "THE crate SHALL ship fuzz targets for intent parsing and compilation, treating a panic, hang or unbounded allocation as a build-breaking defect."
ac_9 = "THE build SHALL fail if any component of human/ other than layerx-intents invokes payload-encoding entry points of layerx-wire, making the compiler the single payload authority for this plane."

[req.8]
title = "The Human API Contract"
story = "As the web application, I want one versioned contract that speaks in journeys and receipts rather than protocol structures, so that the browser can be simple, generated and honest."
ac_1 = "THE contract human-api SHALL be defined as a versioned schema under human/schema/human-api with explicit major and minor versions, SHALL admit only additive change within a major version, and SHALL publish golden request and response vectors for every operation."
ac_2 = "THE contract SHALL cover identity and sessions, wallet binding, journeys - deposit, withdraw, exit, move - agent lifecycle, approvals, activity and receipts, notifications, settings and support, and each operation SHALL be expressed in journey vocabulary, never raw protocol structures."
ac_3 = "THE TypeScript client used by the web application SHALL be generated from the schema with a drift gate that fails the build when generated output is stale or hand-edited, and the browser SHALL call the service only through that client."
ac_4 = "WHEN a mutation could move money or change protocol state THE contract SHALL require an idempotency key, and repeating the request SHALL return the original journey rather than creating a second effect."
ac_5 = "THE contract SHALL define a typed error model with stable machine codes, a copy-catalog key for the human message, the trace identifier, and a retriability classification, and no operation SHALL return an unstructured error."
ac_6 = "THE contract SHALL provide resumable streaming of journey progress, approval lifecycle and notification events with stable cursors, so both shells render live state without polling and recover from disconnection without gaps or duplicates."
ac_7 = "WHEN a response carries a protocol fact THE contract SHALL carry its verification status and, on request, the evidence reference sufficient to fetch receipt or proof material for export and independent verification."
ac_8 = "THE service SHALL enforce authenticated-principal scoping on every operation, SHALL bind sessions to the passkey identity with anti-forgery protections appropriate to a browser client, and SHALL rate-limit with typed refusals carrying retry timing."
ac_9 = "THE contract SHALL version its compatibility in a published matrix - schema version, service version, web app version - and the qualification suite SHALL run the generated client against the live schema to prove parity."

[req.9]
title = "Money Movement and the Route Resolver"
story = "As a user, I want to say who gets how much and have the system do the rest, so that moving money is one idea regardless of what the protocol does underneath."
ac_1 = "THE service SHALL reserve deposit and withdrawal for custody-boundary journeys and SHALL name internal movements fund, allocate, return or transfer in every API surface, log and copy string, surfacing them in the UI as Move money."
ac_2 = "WHEN a user requests a movement THE route resolver SHALL derive the protocol mechanism from source, destination and relationship - human to agent budget funding, human to agent send, agent to human return via budget defunding, an agent-authorised send or a receive under a payer grant, wallet to human deposit, human to wallet withdrawal - and SHALL compose multi-leg journeys automatically."
ac_3 = "WHEN a movement is reviewed THE app SHALL state in plain language what will happen, the amount, the fee estimate with its ceiling, the arrival expectation and any irreversibility, before the user commits."
ac_4 = "WHEN a movement executes THE service SHALL run each leg through intent compilation, disclosure-bound signing and agent-layer submission, SHALL verify the leg's receipt before starting the next leg, and SHALL present per-leg progress for multi-leg journeys."
ac_5 = "IF a leg lands in an unknown state THEN THE journey SHALL pause in still-checking, resolve only by receipt lookup, resume or conclude honestly, and never re-submit a leg whose fate is undetermined."
ac_6 = "THE service SHALL persist journeys durably so that a service restart resumes every in-flight journey without duplicating any leg, and the fault-injection suite SHALL prove exactly-once economic effect per leg across crashes at every stage."
ac_7 = "IF a movement is refused by policy, budget, capability or the protocol THEN THE app SHALL name which limit refused it in plain language and link the surface where the user can change that limit, when it is theirs to change."
ac_8 = "WHEN a movement completes THE app SHALL show the receipt-backed actual amounts and fees, and the journey record SHALL reference every leg receipt in order."
ac_9 = "THE resolver SHALL be a deterministic function of its declared inputs, property-tested so equivalent requests choose identical routes, and a route the resolver cannot serve SHALL produce a typed unavailable refusal, never a partial attempt."

[req.10]
title = "Deposits"
story = "As a user adding money, I want to sign once in my wallet and watch honest progress until the money is verifiably in LayerX, so that I never wonder where my funds are."
ac_1 = "WHEN a deposit starts THE app SHALL show the bound wallet and amount, open the wallet exactly once for the custody transaction signature, and from that point run the journey server-side with no further user action required."
ac_2 = "THE service SHALL track the custody transaction to Paxeer finality, obtain the finalised custody proof, submit bridge deposit credit through the agent layer as a typed intent, and treat the deposit as complete only when the LayerX credit receipt verifies."
ac_3 = "THE app SHALL present the deposit as a staged timeline - waiting for wallet, confirming on Paxeer, crediting, done - where each stage's completion is driven by its own evidence class and the final stage turns complete only on the verified credit receipt."
ac_4 = "WHILE a deposit is in flight THE app SHALL state that it is safe to close, SHALL continue the journey server-side, and SHALL notify the user on completion or failure with a deep link to the journey."
ac_5 = "IF the wallet rejects, the custody transaction fails, a reorg displaces it, finality stalls beyond the expected window, or the credit is refused THEN THE app SHALL show a designed per-stage failure state naming what happened, whether funds moved, and the next action - and a stalled stage SHALL read as delayed with a revised expectation, never as silent."
ac_6 = "THE service SHALL make deposits idempotent end to end: one custody transaction SHALL never produce more than one credit submission, and resubmission after a crash SHALL converge on one verified credit receipt."
ac_7 = "THE app SHALL NOT add the deposited amount to any balance presentation before the credit receipt verifies, and the pending amount SHALL be visible as in-flight, never merged."
ac_8 = "WHEN a deposit completes THE activity feed SHALL show one joined entry spanning wallet to credit with each stage's evidence reachable under Technical details."

[req.11]
title = "Withdrawals, Claims and Emergency Exit"
story = "As a user taking money out, I want the timeline and the waiting explained honestly, so that a checkpoint wait feels like a scheduled train, not a lost transfer."
ac_1 = "WHEN a withdrawal starts THE service SHALL first execute the protocol withdrawal debit through the agent layer and verify its receipt, and the app SHALL state before commitment that a committed withdrawal cannot be cancelled, only completed."
ac_2 = "THE app SHALL present the withdrawal as a staged timeline - processing, waiting for settlement, ready to claim, paid out - with an honest time expectation for the settlement stage derived from declared configuration, never a hardcoded guess."
ac_3 = "WHEN the checkpoint containing the debit is finalised THE service SHALL construct the claim, and the app SHALL present ready to claim with the wallet opening exactly once for the claim signature, with reminders if the claim remains unexercised."
ac_4 = "THE plane SHALL present the withdrawal as paid out only when the Paxeer payout transaction is verified final, and the joined journey record SHALL reference the debit receipt, the checkpoint proof and the payout evidence."
ac_5 = "IF a challenge window holds the payout THEN THE app SHALL say so plainly - why it is held, what is being checked and when to expect resolution - and IF the checkpoint is successfully challenged THEN THE app SHALL surface the protocol's cancellation of the payout with the funds' actual disposition, honestly."
ac_6 = "THE emergency exit SHALL be a guided flow under Settings framed as getting my money out, SHALL construct the exit against the last finalised checkpoint through layerx-paxeer-client, SHALL require typed confirmation of its irreversibility, SHALL remain operable when LayerX ordinary operation is degraded, and WHERE the protocol has not declared emergency-exit eligibility THE app SHALL state plainly that the exit is unavailable because the network is operating normally and SHALL offer the ordinary withdrawal instead."
ac_7 = "WHILE an exit is in flight THE app SHALL show staged progress with the same honesty rules as withdrawals, and completion SHALL be presented only on verified Paxeer finality of the exit."
ac_8 = "THE service SHALL make withdrawals, claims and exits idempotent and crash-resumable, with the fault-injection suite proving no double claim, no lost claimable state and no journey stranded without an owner."

[req.12]
title = "Managed Agent Lifecycle"
story = "As a person employing agents, I want creating, funding, limiting, pausing and retiring an agent to be everyday actions with receipts behind them, so that delegation never means losing control."
ac_1 = "WHEN a user creates an agent THE app SHALL ask at most name, purpose and monthly spend limit, and THE service SHALL orchestrate the rest - agent DID registration, custody key generation, recovery authority naming the human, session-key provisioning to layerx-agentd, capability narrowing and protocol budget creation with initial funding - each step receipt-verified."
ac_2 = "THE app SHALL present the agent as Active only when every orchestration step's receipt has verified, and WHILE creation is partial THE app SHALL show which steps completed honestly and offer resumption, never a phantom agent."
ac_3 = "WHEN a user pauses an agent THE service SHALL revoke or suspend the agent's operating authority - session keys and daemon-side permissions - promptly, THE app SHALL present pause as reversible with a plain consequence sentence, and resume SHALL restore authority through the same receipt-verified paths."
ac_4 = "WHEN a user changes an agent's spend limit THE service SHALL change the protocol budget through typed intents where the limit is protocol-backed, SHALL label any daemon-enforced remainder as app-enforced, and SHALL never describe a daemon restriction as a protocol guarantee."
ac_5 = "WHEN a user takes money back from an agent THE service SHALL use budget defunding, an agent-authorised transfer or a receive under an explicit payer grant only, exactly as the reclaim decision requires, and the app SHALL show the receipt-backed result."
ac_6 = "WHEN a user archives an agent THE app SHALL require the funds disposition first - returning remaining balances through legitimate reclaim paths - SHALL treat archive as destructive with a red confirm and typed name confirmation, and THE service SHALL revoke authority, retire session keys and retain the agent's history and receipts read-only."
ac_7 = "WHEN an agent's keys need rotation or recovery THE service SHALL run the protocol rotation or recovery flow under the human's recovery authority, present the challenge delay in plain time, and keep the agent's identity and history continuous across the rotation."
ac_8 = "THE app SHALL show per-agent spend against limit for the current period computed from verified receipts, with the reconciliation surfaced honestly if local accounting and protocol state diverge, adopting the protocol figure."
ac_9 = "THE service SHALL bound the blast radius of a compromised agent to its narrowed capability and budget, and the qualification suite SHALL demonstrate that a hostile agent cannot exceed either through any human-plane surface."

[req.13]
title = "The Approval Inbox"
story = "As the human in the loop, I want every request for my approval to show exactly what will happen if I say yes, so that my yes means precisely one thing."
ac_1 = "THE app SHALL present every pending hold from the approval module as an inbox item showing the agent, the counterparty, the exact amount, the reason it was held, a live expiry countdown, and the budget remaining after, computed from agent-layer verified budget reads and displayed with its verification status."
ac_2 = "WHEN an approval is opened THE app SHALL render the held activity's own facts - amount, counterparty, asset, fees and expiry - only from the disclosure that re-encodes to the held digest, never from a paraphrase or a separate data source, and SHALL source contextual figures such as budget remaining exclusively from verified reads labelled with their verification status."
ac_3 = "WHEN the user approves THE app SHALL require step-up authentication bound to the held digest, THE service SHALL grant the approval for exactly that digest through the approval module, and the app SHALL then track the released activity to its receipt like any movement."
ac_4 = "WHEN the user rejects THE service SHALL reject the hold immediately, and the app SHALL confirm that nothing moved."
ac_5 = "WHEN a hold expires unactioned THE app SHALL show it as expired with the statement that no money moved, and an expired item SHALL offer no approve control."
ac_6 = "WHEN two devices act on the same hold THE plane SHALL converge on exactly one outcome with the second decision receiving an honest already-decided presentation."
ac_7 = "WHEN a hold is created THE service SHALL notify the user with the agent and amount and a deep link to the inbox item, and the sidebar, tab and header surfaces SHALL carry a live count of holds awaiting the user."
ac_8 = "THE service SHALL record every approval decision in the audit trail with its digest, its step-up evidence and its outcome, exportable with the referenced receipts."

[req.14]
title = "Activity and Receipts"
story = "As a user, I want one place that tells me what happened in my words with the evidence one tap away, so that I never reconcile my own money across surfaces."
ac_1 = "THE app SHALL present one activity feed spanning deposits, withdrawals, internal movements, agent actions, approvals and security events, with custody-boundary journeys rendered as single joined entries spanning their stages."
ac_2 = "THE feed SHALL translate every state through the normative status translation table, SHALL render Done only under the receipt rule, and SHALL render a refusal with an explicit statement of whether money left the account."
ac_3 = "WHEN an entry is opened THE app SHALL show what happened in one plain sentence, the staged timeline where applicable, the receipt-backed amounts and fees, and a collapsed Technical details section containing identifiers, verification status, checkpoint linkage and the evidence references."
ac_4 = "THE feed SHALL group by month with per-group subtotals, SHALL filter by type, agent and date through deferred-apply controls, and SHALL echo an applied filter in the content so the active view is always self-describing."
ac_5 = "WHEN the user exports activity THE service SHALL produce a statement export and an evidence bundle containing the referenced receipts and proofs in their canonical bytes, verifiable independently of this plane."
ac_6 = "THE feed SHALL paginate with stable cursors, SHALL survive service restart without gaps, duplicates or reordering, and SHALL reflect a new verified receipt within the declared freshness bound."
ac_7 = "THE feed SHALL render amounts with sign, semantic color and direction word together, in tabular numerals, under the one amount format and one date format the design fixes."
ac_8 = "WHERE an entry's underlying receipt gains higher verification - batch inclusion, checkpoint finality - THE entry SHALL upgrade its shown verification status without changing its user-facing state except from Done to Done, finalised."

[req.15]
title = "The Public Explorer"
story = "As anyone - user or not - I want to look up a receipt, an account or a checkpoint and verify it from public data, so that trust in this plane never has to be taken on faith."
ac_1 = "THE explorer plane SHALL be public, server-rendered and deep-linkable, requiring no authentication, and SHALL show protocol-public data only, never profile data, notification content or any declared-local artefact."
ac_2 = "THE explorer SHALL serve checkpoint and batch browsing, receipt lookup by identifier, account activity views and an evidence verifier that accepts pasted receipt or proof bytes and reports the achieved verification level."
ac_3 = "THE explorer index SHALL be built by layerx-explorer-index exclusively through the node boundary and data-availability retrieval, SHALL be rebuildable from those sources alone, and SHALL never read node internals, inheriting the agent layer's boundary prohibitions."
ac_4 = "WHEN the explorer displays a protocol fact THE page SHALL show the verification level achieved for it, and the verifier SHALL perform its verification with the same proof machinery the plane uses, never a lookup of the index's own opinion."
ac_5 = "THE explorer SHALL state its own freshness - the head and latest finalised checkpoint it has indexed - on every page, and an index that is behind SHALL say so rather than presenting partial data as complete."
ac_6 = "THE app's Technical details surfaces SHALL link to the explorer for every receipt and checkpoint they reference, and those links SHALL resolve for a signed-out viewer."
ac_7 = "THE explorer SHALL meet the same design-system, accessibility and performance requirements as the app plane, rendered table-first for scanning."

[req.16]
title = "One Application, Two Native Shells"
story = "As a user on any device, I want the app to feel designed for the device in my hands - not a stretched phone app on my monitor, not a shrunken website on my phone - so that both feel native."
ac_1 = "THE application SHALL ship a mobile shell and a desktop shell that share state management, data access, journey logic and the copy catalog, while rendering device-specific layouts and device-specific components, and no journey logic SHALL be duplicated per shell."
ac_2 = "THE mobile shell SHALL provide bottom tab navigation, stacked screens, bottom sheets, full-screen one-decision-per-screen wizards and pinned thumb-reach primary actions; THE desktop shell SHALL provide persistent sidebar navigation, master-detail panes, centered modals, anchored popovers, split-pane wizards and a global command bar with keyboard shortcuts."
ac_3 = "THE application SHALL implement the pattern-pair mapping the design fixes - navigation, primary action, confirmation, detail, filters, money lists, wizards, search, code entry, notifications - such that every pattern has an explicit component in each shell, and a screen using a raw pattern outside the kit SHALL fail the UI gate."
ac_4 = "WHEN the server renders the first response THE application SHALL choose the shell SSR-safely from viewport and pointer capability hints, SHALL confirm on the client, and SHALL correct a mismatch without layout thrash or a flash of the wrong shell; user-agent strings SHALL never be the sole selector."
ac_5 = "THE application SHALL give tablets the desktop layout with touch-sized targets, and every interactive element in both shells SHALL meet the touch-target and pointer-affordance rules of its shell."
ac_6 = "THE two shells SHALL have feature parity over every v1 journey, and the qualification suite SHALL run every journey end to end in both shells."
ac_7 = "WHEN a deep link or notification link opens THE application SHALL resolve it to the equivalent screen in whichever shell is active, and links SHALL be shareable across shells without loss."
ac_8 = "THE desktop shell SHALL be fully keyboard-operable with visible focus order, Escape and overlay dismissal for layered surfaces, and focus trapping in modals; THE mobile shell SHALL honour safe areas, on-screen keyboard avoidance and swipe-dismissal conventions."

[req.17]
title = "The Design System"
story = "As a user, I want every screen to feel like one calm product, so that nothing visual competes with understanding my money."
ac_1 = "THE UI SHALL use the exact visual styling of the owner-supplied @layerx/ui package, including its border strokes, dividers, shadows, gradients, layered surfaces, radii and control treatments, in both the mobile and desktop shells."
ac_2 = "THE application SHALL consume @layerx/ui as its component primitive source, SHALL preserve the package's public component API and token stylesheet, and SHALL not replace package primitives with locally restyled raw equivalents."
ac_3 = "THE @layerx/ui token stylesheet SHALL be the authoritative source for the application palette, typography, radii, elevation and motion, and application-level styling SHALL compose those exported tokens without silently redefining the library's visual contract."
ac_4 = "THE UI SHALL use the package's semantic success, destructive, warning, primary and accent treatments, SHALL never use color as the sole carrier of meaning, and SHALL render money with sign, color and direction word together."
ac_5 = "THE UI SHALL use one fixed type scale, tabular numerals for all figures, one date format and one amount format everywhere, defined once in the design tokens and copy catalog."
ac_6 = "THE UI SHALL express every control state - hover, focus, active, disabled, loading - through the corresponding @layerx/ui component variant, with disabled states carrying their reason nearby."
ac_7 = "THE UI SHALL use the package-defined motion durations and easing, SHALL honour prefers-reduced-motion by disabling non-essential animation, and SHALL use the package's skeleton treatment for loading."
ac_8 = "THE component kit SHALL be the only source of UI primitives in both shells, and a screen composing raw elements where a kit component exists SHALL fail the UI gate."
ac_9 = "THE confirmation grammar SHALL distinguish reversible actions - neutral primary with consequence sentence - from destructive actions - red primary - from irreversible actions - red primary plus typed confirmation - and the kit SHALL make the wrong grammar unrepresentable."

[req.18]
title = "Nothing Fails Silently"
story = "As a user when something goes wrong, I want to be told what happened, what it means for my money and what I can do, so that failure never looks like a broken app or a lost balance."
ac_1 = "THE application SHALL ship, for every screen, the full state matrix - loading, empty, error, offline, degraded and, where money is in flight, still-checking - and the qualification suite SHALL enumerate every screen's states and fail on a missing one."
ac_2 = "THE application SHALL render every error state as a designed screen or section following the error anatomy: what happened in plain words, what it means for the user's money, action buttons - Retry where retriable, Reload where structural, Report always available - and a collapsed technical section with the machine code and trace identifier."
ac_3 = "THE application SHALL wrap every route in error boundaries rendering the same anatomy, and a user SHALL never see a blank screen, a raw stack trace or an unstyled failure."
ac_4 = "WHEN connectivity is lost THE app SHALL show an offline banner, per-screen offline states with retry, and honest queued presentation for actions awaiting connectivity, and SHALL never let an offline queue duplicate a money movement."
ac_5 = "WHEN data is stale THE app SHALL present the degraded state with the value's age and reference point, exactly as req 1 ac_8 requires, in amber staleness presentation."
ac_6 = "WHEN a form field is invalid THE app SHALL show the inline error at the field with how to fix it, keep the primary action disabled with the reason discoverable, and never fail a submission for a reason it could have shown inline."
ac_7 = "THE application SHALL give every hand-off to an external surface - the Paxeer wallet, an OS share or file surface - designed in-progress, failure and cancel states, and SHALL treat a blank interstitial during a hand-off as a defect."
ac_8 = "WHEN the user activates Report THE app SHALL submit the trace identifier, machine code and non-sensitive context with user consent, SHALL confirm the report, and support surfaces SHALL be able to retrieve the same trace the user saw."
ac_9 = "THE still-checking state SHALL lock every control that could duplicate the in-flight effect, state that the money is safe and that the user should not retry, and resolve automatically when the receipt lookup concludes."

[req.19]
title = "Notifications and Alerts"
story = "As a user who is not watching the app, I want to be told when something needs me or something landed, so that agents can work while I live my life."
ac_1 = "THE service SHALL notify on: an approval awaiting the user, money arriving, a journey completing or failing, a claim becoming ready, security events - new device, recovery initiated, key rotation, wallet rebinding - and service degradation, each with a deep link to the exact surface."
ac_2 = "THE service SHALL support push, email and in-app channels with per-event-class preferences nested under per-channel toggles and a notification detail level controlling how much financial detail payloads carry, and preference changes SHALL take effect immediately."
ac_3 = "THE service SHALL attach action buttons to security notifications - review devices, pause agent, open approval - that deep-link into the authenticated surface, and SHALL NOT allow security-critical classes including recovery initiation and wallet rebinding to be fully suppressed."
ac_4 = "THE in-app notification surface SHALL group by recency, distinguish read from unread, deduplicate repeated events, and on desktop appear as a bell popover with a full archive page."
ac_5 = "THE service SHALL keep notification payloads free of secrets, SHALL bound their financial detail by the user's notification detail level, and SHALL degrade lock-screen presentations gracefully to non-sensitive summaries."
ac_6 = "WHEN a notification's subject is already resolved THE tapped deep link SHALL land on the resolved state honestly - an expired approval reads expired, a completed journey reads done - never on a stale actionable presentation."
ac_7 = "THE approval count surfaced on tabs, sidebars and badges SHALL be consistent with the inbox within the declared freshness bound, and SHALL clear when no holds await the user."

[req.20]
title = "Accessibility, Performance and Internationalization"
story = "As any user on any device, connection or ability, I want the app to be fast, legible and operable, so that professional quality is a property, not a marketing claim."
ac_1 = "THE application SHALL meet WCAG 2.2 AA: text contrast at least 4.5 to 1, full keyboard operability, visible focus, focus trapping in layered surfaces, touch targets at least 44 pixels on mobile, and status changes announced through live regions."
ac_2 = "THE application SHALL label every amount, status and control for assistive technology such that a screen-reader user can complete every v1 journey, and the qualification suite SHALL include assistive-technology runs of the core journeys."
ac_3 = "THE application SHALL meet performance budgets at the 75th percentile - largest contentful paint at most 2.5 seconds, interaction to next paint at most 200 milliseconds, cumulative layout shift at most 0.1 - enforced in CI on representative pages and monitored in production with real-user metrics against the same budgets."
ac_4 = "THE application SHALL code-split by route with declared per-route script budgets, SHALL render the explorer plane server-side cacheable, and SHALL load data with skeletons that reserve layout so content arrival shifts nothing."
ac_5 = "THE application SHALL keep every user-facing string in the versioned copy catalog with ICU plural and selection support and no runtime string concatenation of sentence fragments, and the copy lint SHALL enforce catalog completeness, the banned-vocabulary list and the format rules."
ac_6 = "THE layouts SHALL tolerate 1.5 times text expansion without truncation or overlap, amounts SHALL render locale-aware with an explicit currency code, and dates SHALL use the single unambiguous format everywhere."
ac_7 = "THE application SHALL remain usable on slow connections: journey surfaces SHALL function at 3G-class latency with honest progress, and no journey SHALL require a large asset to proceed."

[req.21]
title = "Security UX, Sessions and Privacy"
story = "As the person the attacker would target, I want the app's everyday behaviours to be the safe ones, so that security is the path of least resistance."
ac_1 = "THE app SHALL require step-up authentication - a fresh passkey ceremony - for approvals, withdrawals and exits, security setting changes, secret reveals, wallet rebinding and agent archive, bound to the specific operation as req 4 ac_3 requires."
ac_2 = "THE app SHALL render every secret-class value - backup codes, recovery evidence, session tokens - masked by default, SHALL reveal it only after step-up and re-mask it on a timer, and SHALL keep it out of the clipboard except by an explicit user action on an explicitly copyable value."
ac_3 = "THE app SHALL provide a device and session inventory with per-session revoke, show each session's last activity, and revocation SHALL take effect promptly across shells."
ac_4 = "THE service SHALL emit the new-device notification of req 3 ac_8 and support sign-out-everywhere, which SHALL also invalidate refresh paths, not only active sessions."
ac_5 = "THE app SHALL provide a privacy mode masking balances and every derived figure - subtotals, spend bars, notification amounts - with one toggle, persisted per user, applying across both shells."
ac_6 = "THE plane SHALL emit telemetry containing no personal data, no balances, no addresses and no identifiers beyond pseudonymous ones, enforced by a redaction layer with a CI gate over emitted schemas."
ac_7 = "THE app plane SHALL enforce a strict content security policy, load no third-party scripts on authenticated surfaces, and pin its asset origins."
ac_8 = "THE 2FA surface SHALL offer authenticator-app methods with one-time backup codes issued at setup, SHALL present disable warnings with consequence copy, and SHALL follow the security-mutation step-up rules."
ac_9 = "THE app SHALL make session expiry honest: an expiring session warns before it expires where the platform allows, an expired session lands on re-authentication with the intended destination preserved, and no money control SHALL be operable on an expired session."

[req.22]
title = "Isolation, Audit and Observability"
story = "As an operator of a multi-tenant human plane, I want every principal's data isolated, every consequential action evidenced and every failure traceable, so that operating at 1M+ users is engineering, not archaeology."
ac_1 = "THE service SHALL scope every stored row, cache entry, journey, notification and audit record to its authenticated principal, SHALL map each human principal to its agent-layer tenancy so agent-layer isolation guarantees compose, and the adversarial isolation suite SHALL prove no cross-principal read or write path exists."
ac_2 = "THE service SHALL keep an append-only hash-chained audit log of authentication events, signing decisions, approvals, journey transitions, security changes and notification dispatches, with each entry referencing its evidence, and SHALL detect and refuse silent truncation or reordering."
ac_3 = "THE user SHALL be able to export their own audit trail with the referenced receipts and proofs as an evidence bundle verifiable independently of this plane."
ac_4 = "THE plane SHALL propagate a trace identifier from the browser through human-api to the agent layer and back, SHALL show it on every error surface, and SHALL make it the key support uses to retrieve the failure context the user saw."
ac_5 = "THE service SHALL instrument journey funnels - onboarding, deposit, move, create-agent, approval, withdrawal - with stage-level outcomes so drop-off and failure are measurable per stage without any personal data."
ac_6 = "THE service SHALL redact secrets, key material, personal data and financial values from logs, metrics and traces by construction with a gate over log and metric schemas, and a redaction failure SHALL be a build defect."
ac_7 = "THE service SHALL expose health and readiness surfaces distinguishing its own degradation from agent-layer and from Paxeer-side degradation, and the app SHALL translate each into the honest user-facing degraded states."
ac_8 = "THE service SHALL declare and enforce retention per store - journeys, notifications, audit, telemetry - with expiry that never deletes evidence still referenced by an exportable audit entry."

[req.23]
title = "Qualification and Release Gates"
story = "As the person accountable for shipping this to a million people, I want every promise in this specification demonstrated against real systems before release, so that the gate is evidence, not optimism."
ac_1 = "THE qualification suite SHALL run every v1 journey end to end - onboarding, wallet binding, deposit, move money, create agent, approval grant and reject, withdrawal with claim, emergency exit - against a real node, a real layerx-agentd and a Paxeer test network, with no in-process substitute standing in for any of the three."
ac_2 = "THE suite SHALL run a hostile-plane test in which a tampered human-service reports altered balances, altered outcomes and fabricated successes, and SHALL demonstrate that exported evidence and explorer verification catch every alteration, and that the untampered UI cannot render Done without a verifying receipt."
ac_3 = "THE suite SHALL run the fault-injection matrix over every money journey - crash, disconnect and duplicate delivery at each stage - proving exactly-once economic effect, honest still-checking presentation and correct resumption in every case."
ac_4 = "THE suite SHALL enumerate every screen in both shells and fail on a missing state-matrix entry, SHALL run visual regression across both shells at the canonical @layerx/ui reference viewports, and SHALL run the copy lint, component-library integrity gate and component-kit gate as build gates."
ac_5 = "THE suite SHALL run automated accessibility checks plus assistive-technology journey runs, and SHALL fail the build on a WCAG 2.2 AA violation on any v1 surface."
ac_6 = "THE suite SHALL enforce the performance budgets of req 20 ac_3 in CI and SHALL run a soak that holds long-lived journeys - a deposit awaiting finality, a withdrawal awaiting checkpoint, an unactioned approval - across service restarts, proving no journey is lost, duplicated or stranded."
ac_7 = "THE usability gate SHALL have real participants complete onboarding, deposit, move-money and create-agent on mobile without documentation, against a declared task-success threshold recorded in the report."
ac_8 = "THE isolation, custody, no-key-export and telemetry-redaction suites SHALL run as build gates, and any escape SHALL be a build-breaking defect rather than a tracked issue."
ac_9 = "THE release SHALL be gated on a qualification report stating which guarantees are protocol-enforced, which are agent-layer-enforced and which are human-plane-enforced, which suites ran with what results, and every unmet gate, and a release with an unmet gate SHALL be refusable by tooling, not reviewer discipline."

[req.24]
title = "Production SDKs in Every Language"
story = "As a developer in any mainstream stack, I want a production LayerX SDK that feels native to my language and behaves identically to every other language's SDK on the wire, so that adopting LayerX never requires changing how my team writes software."
ac_1 = "THE platform SHALL ship production Rust, TypeScript and Python SDKs and new Go, Java/Kotlin, Swift and C# SDKs, each generated or authored from the same agent-api and human-api schemas in the same build, and a schema change SHALL propagate to every SDK in one regeneration with a drift gate failing the build when any generated output is stale or hand-edited."
ac_2 = "THE SDKs SHALL be wire-identical: the cross-language parity suite SHALL prove that every operation, event, error outcome and golden vector round-trips identically through all seven SDKs, and a divergence SHALL be a build failure, not a compatibility note."
ac_3 = "EACH SDK SHALL be idiomatic to its language - naming conventions, async model, error model, packaging and dependency hygiene - while carrying the identical typed error taxonomy with stable machine codes and retriability classes."
ac_4 = "EACH SDK SHALL include the receipt and proof verification path so any consumer can verify a 402LXP receipt, a batch inclusion and a checkpoint proof locally without trusting the gateway or any hosted surface, and the verification API SHALL be part of the parity suite."
ac_5 = "EACH SDK SHALL enforce the protocol's integer-only money rule: amounts are protocol integer types or checked decimal-string wrappers, floating-point amounts are unrepresentable in the public API, and idempotency keys are required on every operation that could move money."
ac_6 = "THE SDKs SHALL be published to their native registries - crates.io, npm, PyPI, Go modules, Maven Central, Swift Package Manager and NuGet - through a reproducible signed release pipeline, and the published artifact SHALL be byte-verifiable against the tagged source."
ac_7 = "THE compatibility matrix SHALL record, for every SDK release, the schema versions, service versions and protocol versions it supports, and the qualification suite SHALL run every published SDK against the live schemas to prove parity before release."
ac_8 = "EACH SDK SHALL keep secrets safe by construction: key material and session tokens are never logged, never serialised into errors, and zeroized where the language permits, verified by the SDK conformance suite."
ac_9 = "THE SDKs SHALL surface streaming - journey progress, approval lifecycle, events - with resumable cursors in every language, with reconnection and no-gap-no-duplicate semantics proven in the parity suite."

[req.25]
title = "Middleware and Framework Integrations"
story = "As a builder shipping a buyer, seller, merchant or agent, I want drop-in middleware for my framework that handles the payment protocol correctly, so that accepting or making LayerX payments is a dependency and a handful of lines, not a subsystem I design."
ac_1 = "THE platform SHALL ship buyer, seller, merchant and agent middleware packages over the SDKs, covering payment-required flows, quote and commit, receipt verification, idempotency, retry discipline and webhook signature verification, so that no integrator hand-implements protocol mechanics."
ac_2 = "THE platform SHALL ship first-class framework integrations for Express, Next.js, FastAPI and Spring, plus mobile bindings for iOS and Android and integrations for the major agent frameworks, each installable as one dependency and configured through declared keys, not code changes."
ac_3 = "WHEN a seller integration declines a request pending payment THE middleware SHALL speak the platform's payment-required flow with a machine-readable offer, SHALL verify the settling receipt before releasing the resource, and SHALL never release on any weaker evidence."
ac_4 = "THE middleware SHALL inherit the non-authority rule: it renders and relays verified outcomes, never invents them, and a middleware package that can present success without backing evidence SHALL fail its conformance suite."
ac_5 = "EACH middleware and integration SHALL ship with a runnable example application and a conformance suite executed in CI against a real service, and the ten-line benchmark SHALL be measured against these published packages, not against internal shortcuts."
ac_6 = "THE middleware SHALL expose webhook consumption with signature verification, replay protection and at-least-once delivery handling as the default path, and an unverified webhook SHALL be rejected, not logged and processed."
ac_7 = "THE integrations SHALL keep secrets out of client bundles: browser and mobile artifacts are scanned in CI to prove no API secret or key material ships to an end-user device."

[req.26]
title = "Developer Tooling and Hosted Surfaces"
story = "As a developer evaluating LayerX, I want a CLI, a local emulator, a hosted testnet with a faucet and a hosted gateway with keys, webhooks and dashboards, so that I can go from curiosity to a working integration without provisioning infrastructure or asking a human."
ac_1 = "THE platform SHALL ship a CLI covering project scaffolding, key and account management, test payments, receipt lookup and verification, program deployment, environment switching between emulator, testnet and production, and MCP and A2A installation, each command with machine-readable output."
ac_2 = "THE platform SHALL ship a local emulator that runs the real transition function and real receipt machinery in a local environment with instant blocks and prefunded accounts, and THE emulator SHALL NOT substitute a reimplementation for the core: behaviour divergence between emulator and testnet on the conformance suite is a build failure."
ac_3 = "THE platform SHALL operate a hosted testnet with a faucet that is rate-limited and abuse-resistant, resettable on a declared schedule, and running the same protocol version as the pending production release."
ac_4 = "THE platform SHALL operate a hosted gateway and RPC surface with self-service API keys, per-key quotas and typed rate-limit refusals carrying retry timing, and no gateway path SHALL weaken the protocol's authorisation rules or verification requirements."
ac_5 = "THE platform SHALL deliver webhooks for journey, payment, approval and program events with signed payloads, ordered delivery per subject, at-least-once semantics with replay protection, and a redelivery surface for missed events."
ac_6 = "THE platform SHALL provide developer dashboards covering API keys, usage, request logs, webhook delivery logs, test payments and receipts, with every displayed protocol fact carrying its verification status exactly as the human plane requires."
ac_7 = "THE hosted surfaces SHALL publish a status page distinguishing gateway, testnet, core and Paxeer-side degradation, and SHALL apply the same principal isolation, redaction and audit rules the human service enforces."
ac_8 = "WHEN one-command MCP or A2A installation is invoked THE tooling SHALL install a working payment-capable server configuration in a single command, verified end to end in CI against a real agent runtime."

[req.27]
title = "Documentation, Reference Applications and the Five-Minute First Payment"
story = "As a developer landing on the docs, I want to complete a real test payment in five minutes and find a runnable reference for my use case, so that the platform's ease of adoption is an experienced fact, not a claim."
ac_1 = "THE platform SHALL publish documentation covering concepts, quickstarts per language and framework, API references generated from the schemas, middleware guides, program authoring guides and interop adapter guides, with every code sample compiled and executed in CI so a stale sample fails the build."
ac_2 = "THE platform SHALL ship runnable reference applications - at minimum a buyer agent, a paid API seller, a merchant checkout and a marketplace built on LayerX Programs - each cloneable and runnable against the emulator or the testnet with one command."
ac_3 = "THE five-minute benchmark SHALL be a CI gate: a scripted clean-environment run following only the published quickstart completes account setup, faucet funding and a verified test payment inside five minutes, and the run SHALL fail the release when the budget is exceeded."
ac_4 = "THE ten-line benchmark SHALL be a CI gate: the seller and buyer quickstart integrations each add LayerX payments in at most ten lines of integration code counted by the gate, measured against the published middleware packages."
ac_5 = "THE documentation SHALL state honestly, for every capability, whether it is protocol-enforced, agent-layer-enforced, service-enforced or hosted-surface-enforced, following the same enforcement-labelling rule as the qualification report."
ac_6 = "THE quickstarts SHALL require no protocol vocabulary knowledge to complete, and the first-payment path SHALL never require the developer to construct payload bytes, manage keys manually or interpret raw protocol structures."

[req.28]
title = "The Programs Runtime"
story = "As a developer bringing a new economic application to LayerX, I want a deterministic runtime that executes my program identically on every node with explicit costs, so that my application inherits LayerX's law instead of weakening it."
ac_1 = "THE protocol SHALL gain a programs module registered through the existing module system as a versioned transition-function change, hosting guest programs inside the module's own namespace, and THE kernel SHALL remain unchanged: no new balance-mutation primitive, no new authority model, no kernel type gaining program-specific fields."
ac_2 = "THE runtime SHALL execute programs as deterministic WASM: no clock access, no networking, no filesystem, no floating point, no threads, no randomness and no ambient authority, and the conformance suite SHALL prove byte-identical execution across operating systems, architectures and optimisation levels."
ac_3 = "THE runtime SHALL meter CPU, memory and storage explicitly, charging metered fees through the existing fee mechanism, and an execution exceeding its metered budget SHALL fail with a typed resource result and full rollback, never stall or crash a node."
ac_4 = "THE runtime SHALL expose a versioned program ABI, SHALL record the runtime and ABI version under which every program activity executed in its receipt, and SHALL replay historical activities under their recorded versions so upgrades never rewrite history."
ac_5 = "IF a program traps, exhausts a resource, returns a malformed result or violates any invariant THEN THE protocol SHALL discard every state write of that activity, consume the sequence and charge the metered fee exactly as module failure semantics require, and emit a receipt bearing the typed failure."
ac_6 = "THE runtime SHALL isolate guest memory and guest state such that no program can read or write kernel state, another program's namespace or another principal's data except through declared capability APIs, proven adversarially by the isolation suite."
ac_7 = "THE runtime SHALL bound compilation and instantiation deterministically - validated module size, function count, stack depth and call depth are declared limits with typed refusals - and a hostile module SHALL be rejected at deploy time, not discovered at execution time."
ac_8 = "THE runtime SHALL ship fuzz targets over module validation, instantiation and execution, treating a panic, hang, non-determinism or unbounded allocation as a build-breaking defect."

[req.29]
title = "Permissionless Deployment, Storage and the Program Registry"
story = "As a developer, I want to deploy and evolve my program through ordinary activities with verifiable provenance, so that shipping on LayerX never requires permission and users can always audit what code holds their commitments."
ac_1 = "WHEN a developer deploys a program THE protocol SHALL accept the deployment as an ordinary programs-module activity requiring no governance action, subject only to declared size, fee and validation rules, and the program SHALL be callable once its deployment receipt verifies."
ac_2 = "EACH program SHALL receive namespaced persistent storage isolated to that program, accounted and charged under the declared storage metering rules, and no program SHALL read or write outside its namespace except through declared capability APIs."
ac_3 = "THE registry SHALL record for every program its identifier, code hash, ABI version, upgrade policy and version history as protocol state, and receipt-verified registry reads SHALL be available through the agent layer and the explorer."
ac_4 = "THE upgrade rules SHALL make immutability the default: a program declares at deployment whether it is immutable or upgradeable by a named authority, an upgrade is an ordinary activity recording old and new code hashes, and declared migration hooks SHALL run under the same determinism and metering laws as any execution."
ac_5 = "THE platform SHALL provide source and build verification: a reproducible-build pipeline maps published source to on-chain code hash, the registry surfaces verified-source status, and the explorer SHALL display a program's verification status wherever the program is shown."
ac_6 = "THE registry SHALL support deprecation honestly: a deprecated or tombstoned program remains readable and its history replayable forever, existing state remains reachable under declared wind-down rules, and no deprecation SHALL strand value with no legitimate exit path."
ac_7 = "WHEN a deployment, upgrade or call references an unknown program, an incompatible ABI version or a failed validation THE protocol SHALL refuse with a typed result, and unknown-version artifacts SHALL be preserved for diagnosis without execution."

[req.30]
title = "Composition, Capabilities and the Monetary Law"
story = "As a user whose money can touch third-party programs, I want every program bounded by explicit capabilities and every monetary effect forced through the protocol's single financial doorway, so that permissionless code can never weaken LayerX's financial law."
ac_1 = "THE runtime SHALL expose kernel functionality to programs exclusively through capability-based APIs - storage, events, calls, 402LXP transfer requests, receipt-verified reads - and a program SHALL hold no ambient authority: every capability is granted explicitly by the invoking activity's authorisation context."
ac_2 = "WHEN a program produces a monetary effect THE protocol SHALL express it as one or more authenticated 402LXP transfers applied by the kernel transfer primitive within the authority of the invoking activity, and THE protocol SHALL make a direct balance write by a program impossible: INVARIANT 1 applies to guest code unchanged."
ac_3 = "THE runtime SHALL never allow a program to exceed the authority of the activity that invoked it: capability narrowing composes downward only, a program-to-program call carries at most the caller's granted capabilities, and an attempted escalation SHALL fail with a typed result."
ac_4 = "THE runtime SHALL support program-to-program composition with declared call-depth limits and deterministic reentrancy rules that make reentrancy-based double-spending structurally impossible, proven by adversarial suites, and a call graph exceeding declared limits SHALL fail typed."
ac_5 = "WHEN a program activity spans multiple calls and transfers THE protocol SHALL execute it as one atomic transfer set with a single authorisation context and a single receipt, rolling back every leg and every program write if any leg fails, exactly as the module atomicity law requires."
ac_6 = "EACH program SHALL emit events only through the kernel event stream under its namespace, and every program activity SHALL yield the standard receipt shape so wallets, SDKs, the human plane and the explorer render program outcomes with the same receipt-backed rigor as protocol-native operations."
ac_7 = "THE qualification suite SHALL include a hostile-program gauntlet - programs attempting balance manipulation, capability escalation, reentrancy exploitation, storage escape, metering evasion and determinism violation - and every attack SHALL be defeated by construction, with an escape being a build-breaking defect."
ac_8 = "THE human plane SHALL present program interactions under the same simplicity and honesty contract: plain-language rendering from disclosures, Done only on verified receipts, and approval holds over program spending flowing through the existing approval module unchanged."

[req.31]
title = "Multi-Language Program Authoring"
story = "As a developer coming from Solana, EVM or Cosmos, I want to write LayerX programs in a language I already know and port existing contracts with a clear mapping, so that migrating my protocol is a project, not a rewrite of my team."
ac_1 = "THE platform SHALL make WASM the single compiled target for programs and SHALL ship a first-class Rust program SDK covering the full ABI - capabilities, storage, calls, transfers, events, errors - with the type-safety rules of the intent vocabulary: protocol integer amounts, no floating point, bounds enforced at construction."
ac_2 = "THE platform SHALL support at least two additional authoring languages compiling to the same ABI, each with its own SDK, determinism lint and conformance suite proving byte-identical behaviour with the Rust SDK on the shared vector set."
ac_3 = "THE platform SHALL ship porting kits with semantic mappings and compatibility layers: EVM and Solidity storage, event and call semantics to programs equivalents; Solana account-model and Anchor patterns to namespaced storage and capabilities; CosmWasm contract patterns to the programs ABI."
ac_4 = "EACH porting kit SHALL include at least one real ported reference contract - deployed, source-verified and exercised end to end in the qualification suite - proving the migration path on working code rather than documentation alone."
ac_5 = "THE program toolchains SHALL enforce determinism at build time: a program importing clocks, randomness, floating point or any undeclared host interface SHALL fail its build with a named violation, before deployment ever sees it."
ac_6 = "THE documentation SHALL include migration guides per source ecosystem written in that ecosystem's vocabulary, and the five-minute benchmark SHALL have a programs variant: deploy the quickstart program and execute its first paid call inside the declared budget."

[req.32]
title = "The Interoperability Gateway and External Protocol Adapters"
story = "As an ecosystem that already speaks x402, AP2, UCP, MCP, A2A or Visa's agent rails, I want LayerX to speak my protocol natively at its edge, so that adopting LayerX requires no day-one abandonment of existing software."
ac_1 = "THE platform SHALL ship an interoperability gateway hosting protocol adapters that translate at the edge only: adapters hold no protocol authority, construct no payload bytes outside the plane's single payload authorities, and every state-changing translation terminates in a receipt-verified LayerX operation."
ac_2 = "THE gateway SHALL implement x402 v2 buyer, seller and facilitator roles across the HTTP, MCP and A2A transports, conformant to the published x402 v2 specification and verified against its vectors and reference implementations in CI."
ac_3 = "THE gateway SHALL implement AP2 checkout and payment mandates: verifying mandate signatures and constraints before acting, mapping authorised mandates to typed intents, and refusing any mandate whose constraints the resulting LayerX activity cannot honour."
ac_4 = "THE gateway SHALL implement UCP merchant profiles, capability negotiation, checkout and order flows so a UCP-speaking commerce surface can transact against LayerX sellers without bespoke integration."
ac_5 = "THE gateway SHALL support Visa Trusted Agent credentials for merchant recognition of trusted commerce agents, verifying agent credentials per the published specification and binding them to LayerX agent identities without granting them any protocol authority."
ac_6 = "WHEN an external protocol's flow claims an outcome THE adapter SHALL present it only as far as backing evidence supports - a verified LayerX receipt, a verified mandate, verified external settlement - and the honesty rules of the human plane SHALL apply to every adapter-rendered state."
ac_7 = "THE gateway SHALL provide portable verification: LayerX receipts and proofs exportable in forms external parties verify without LayerX infrastructure, and external mandates and receipts verifiable by LayerX components through the adapters, both covered by golden vectors."
ac_8 = "EACH adapter SHALL declare a conformance suite pinned to a versioned upstream specification, run in CI, and an upstream specification version bump SHALL be an explicit adapter change with its own compatibility matrix entry, never a silent behavioural drift."
ac_9 = "THE gateway SHALL enforce the same principal isolation, idempotency, typed error, redaction, audit and rate-limit rules as the human service, and SHALL propagate trace identifiers across every translation boundary."

[req.33]
title = "Migration and Off-Platform Settlement"
story = "As a team with users, assets and history on Ethereum or Solana - or money on card and bank rails - I want tooling that moves me onto LayerX with verifiable evidence at every step, so that migration is safe, incremental and honest about what settled where."
ac_1 = "THE platform SHALL ship migration tooling for Ethereum and Solana covering account mapping - external addresses associated to LayerX identities through the protocol's binding mechanisms - asset migration through the custody boundary, and transaction-history import as clearly-labelled external provenance, never as LayerX receipts."
ac_2 = "WHEN external assets migrate in THE platform SHALL credit them only through the protocol's custody boundary rules against verified finality evidence from the source chain, and no migration path SHALL mint LayerX balances from unverified external claims."
ac_3 = "THE platform SHALL ship adapter interfaces for card, bank and real-time-payment providers, crediting LayerX value only against verified provider settlement evidence, presenting pending settlement honestly, and modelling reversal and chargeback exposure as typed states with declared holds, never hidden."
ac_4 = "THE fiat adapters SHALL keep card data out of every LayerX component: collection and tokenisation occur at the certified provider edge, LayerX stores tokens and settlement evidence only, and the redaction gates SHALL prove no primary account number can transit any LayerX log, store or trace."
ac_5 = "WHEN an off-platform settlement fails, reverses or charges back THE platform SHALL surface the actual disposition through the standard journey states with whether money moved, and SHALL reconcile the LayerX-side effect through legitimate protocol operations only."
ac_6 = "THE migration and fiat surfaces SHALL be qualification-gated end to end against real testnets and provider sandboxes, with fault injection at every settlement stage proving exactly-once economic effect and honest unknown states."

[req.34]
title = "The Multichain Surface"
story = "As anyone deciding whether to trust or adopt LayerX, I want LayerX state independently verifiable from chains I already trust and easy on-ramps from wherever my money is, without LayerX diluting its custody guarantee across chains, so that reach never costs safety."
ac_1 = "THE platform SHALL publish batch mirror archives to at least Ethereum and Solana: batch commitments anchored on-chain with batch data retrievable per mirror, published as pure archives with no vault, portal or custody semantics of any kind on the mirror chains."
ac_2 = "THE mirrors SHALL be sufficient for independent verification: the explorer's verifier and the SDK verification paths SHALL verify LayerX receipts and state against mirror data alone, and the qualification suite SHALL prove a receipt verifies from a mirror with LayerX infrastructure unavailable."
ac_3 = "EACH mirror SHALL state its own freshness - the latest batch and checkpoint mirrored - wherever mirror-derived data is displayed, and a lagging mirror SHALL say so rather than presenting partial data as current, exactly as the explorer freshness rule requires."
ac_4 = "THE protocol's custody and withdrawal guarantee SHALL remain Paxeer exclusively: no mirror SHALL be presented as a settlement venue, no LayerX surface SHALL describe mirror chains as places funds live, and the one-ledger invariant - one identity, one balance system, one canonical order - SHALL be preserved unchanged by every part of this requirement."
ac_5 = "THE platform SHALL ship a ramp toolkit enabling third parties to operate market-maker on and off ramps as ordinary LayerX principals over existing rails - agent accounts, 402LXP transfers, payer grants - receiving no special protocol authority, no reserved vocabulary and no custody claims, with reference documentation and a runnable reference ramp."
ac_6 = "WHERE a third-party ramp is surfaced anywhere in the platform THE surface SHALL label it external custody in plain language, SHALL NOT present it on the human plane's default surfaces, and SHALL never render a ramp outcome as Done except against the verified LayerX receipt of the LayerX-side leg."
ac_7 = "THE schemas SHALL reserve domain-tagged claim and receipt vocabulary - every custody-boundary claim naming its settlement domain, with Paxeer as the sole valid domain in this version - so that adding a settlement domain later is an additive schema change, and the conformance suite SHALL reject an untagged custody claim."


[req.35]
title = "Program Execution as a Protocol Activity"
story = "As a developer whose program is deployed and source-verified, I want the network to actually execute it against protocol state with an input I supply and an output I can read, so that a deployed program is a running application rather than a registry entry."
ac_1 = "THE programs module SHALL declare a call activity that executes deployed guest code against protocol state through the deterministic runtime, and a deployment that verifies SHALL be invocable by that activity without any further governance, allow-listing or operator action."
ac_2 = "THE call activity SHALL carry a bounded calldata payload into the invoked export through the same reservation protocol program-to-program composition already uses, and an activity SHALL be able to address a program by identifier and entry point without encoding integers by hand."
ac_3 = "THE runtime SHALL return bounded response bytes from an invoked program to its caller - both to a program-to-program caller and to the activity boundary - and a call whose response exceeds its declared capacity SHALL fail typed rather than truncate."
ac_4 = "WHEN a program refuses or faults THE runtime SHALL carry a typed failure payload naming the refusing program, the refusal class and the program-supplied reason bytes, and that payload SHALL appear in the activity receipt so a caller can diagnose a failure without a node log."
ac_5 = "THE invoking activity SHALL declare the execution budget it is willing to pay for, THE runtime SHALL refuse an execution that would exceed the declared budget with a typed resource result, and THE protocol SHALL charge only the metered usage actually consumed within that ceiling."
ac_6 = "THE call path SHALL apply module failure semantics exactly as the deploy path does: a failed call consumes its sequence, charges its metered fee, discards every storage write and every staged effect of the whole call graph, and emits a receipt bearing the typed failure."
ac_7 = "THE agent layer, the CLI and the local emulator SHALL each expose the call activity with machine-readable output, and the emulator SHALL execute it through the real transition function so a local call and a network call diverge only in their state."
ac_8 = "THE runtime SHALL ship the adversarial isolation and composition suites its capability and composition rules claim: no guest reaching kernel state, another program's namespace or another principal's data, and no call graph escaping its declared depth, fan-out, edge, visit or reentrancy rules."

[req.36]
title = "The Program State Model"
story = "As a developer building an application with more than one participant, I want state my program owns collectively as well as state scoped to each caller, so that an order book, a pool, a supply total or a shared registry has an honest representation instead of no representation."
ac_1 = "EACH program SHALL own two storage namespaces - one scoped to the invoking principal and one shared across every caller of that program - and THE runtime SHALL fix both before guest code runs so a program can address neither another program's namespace nor another principal's principal-scoped cells."
ac_2 = "THE shared namespace SHALL be reachable only through explicit capabilities distinct from the principal-scoped grants, so an activity can invoke a program with read-only access to shared state, and a program holding no shared-write grant SHALL fail typed rather than silently write elsewhere."
ac_3 = "THE storage ABI SHALL support ordered iteration over a bounded key prefix within a namespace the program already holds a grant for, returning a resumable cursor, metered per byte returned, with a declared per-call ceiling so iteration can never be used to escape the resource budget."
ac_4 = "THE storage ABI SHALL support dropping an entire namespace as one committed operation with its cost metered against the declared budget, so ephemeral state has a bounded, provable end rather than an unbounded sequence of deletions."
ac_5 = "THE meter SHALL account storage occupancy over time as its own resource class - namespace bytes held across batches - priced by the fee schedule and charged to the account declared responsible for that namespace, so state that persists is paid for as long as it persists."
ac_6 = "THE isolation suite SHALL prove the shared namespace does not weaken isolation: no program SHALL read or write another program's shared namespace, no principal-scoped grant SHALL confer shared access, and no capability narrowing SHALL widen namespace reach across a program-to-program call."
ac_7 = "THE Rust SDK and every porting kit SHALL express shared state in the source ecosystem's own vocabulary - a Solidity storage slot that is not caller-indexed, a Solana program-owned account, a CosmWasm item or map - and the EVM porting kit SHALL retire its declaration that shared state has no representation."

[req.37]
title = "Program-Owned Accounts and Program Spending Authority"
story = "As a developer building escrow, a vault, a pool or a subscription, I want my program to hold and disburse value under its own authority, so that applications where the program is the counterparty are possible without any program ever gaining a balance-writing primitive."
ac_1 = "THE protocol SHALL derive program-owned accounts deterministically from the program identifier and a program-supplied seed, THE derivation SHALL be reproducible by any party from public inputs, and no principal SHALL be able to derive or claim the authority of a program-owned account."
ac_2 = "A program SHALL be able to authorise a 402LXP transfer out of an account it derives under its own authority rather than the invoking principal's, and THE kernel transfer primitive SHALL remain the only balance mutation: INVARIANT 1 applies unchanged and no new balance-writing primitive is added anywhere."
ac_3 = "THE transfer law SHALL bind every program-authorised leg to the deriving program and the exact derivation seed, SHALL refuse any leg whose account the calling program cannot derive, and SHALL refuse a program-authorised leg staged by any frame of the call graph other than the deriving program itself."
ac_4 = "THE capability model SHALL keep program spending narrowable downward only: a program-to-program call SHALL be able to convey a bounded spending grant over the caller's own derived accounts, and an attempted widening SHALL fail typed exactly as principal-scoped narrowing already does."
ac_5 = "THE registry's program value accounts SHALL be bound to real derived accounts with real balances rather than declared bookkeeping, and THE deprecation and wind-down rules SHALL prove no exit path strands value held in a derived account."
ac_6 = "THE hostile-program gauntlet SHALL extend to program custody: programs attempting to derive another program's account, to spend from an account they cannot derive, to stage a derived-account leg from a callee frame, or to escape the atomic transfer set, with every attack defeated by construction."
ac_7 = "THE Rust SDK and the porting kits SHALL ship working escrow and vault reference programs exercised end to end, and the EVM porting kit SHALL retire its refusal of contract-funded value flows where a derived account now carries them honestly."

[req.38]
title = "Execution Context and Deterministic Compute Primitives"
story = "As a developer porting real contracts, I want my program to know who called it and to reach the cryptographic and wide-integer primitives every chain provides, so that access control, proof verification and financial arithmetic are ordinary code rather than impossible code."
ac_1 = "THE ABI SHALL expose a versioned execution context to guest code - the executing program, the immediate calling program, the invoking principal, the activity sequence, the batch height, the runtime and ABI versions, the remaining fuel and the effective fee schedule - through a single frozen field-addressed host function, and no context field SHALL derive from wall-clock time, host entropy or any node-local value."
ac_2 = "THE context SHALL be honest at every frame of a call graph: a callee SHALL observe its own program identifier and its immediate caller's, never a spoofed value, and the composition suite SHALL prove the caller field cannot be forged across any edge."
ac_3 = "THE ABI SHALL expose receipt-verified balance reads under an explicit capability, so a program can read a balance it has been granted sight of without gaining any authority to change it."
ac_4 = "THE ABI SHALL expose deterministic hash primitives covering at least sha256, keccak256 and blake3, metered per input byte, producing byte-identical digests across every operating system, architecture and optimisation level."
ac_5 = "THE ABI SHALL expose deterministic signature primitives covering at least ed25519 verification and secp256k1 verification and public-key recovery, metered per operation, with every failure a typed refusal rather than a trap."
ac_6 = "THE ABI SHALL expose wide-integer primitives covering at least 256-bit multiplication, division, remainder and modular exponentiation, metered by operand width, with no floating point reachable in any implementation path."
ac_7 = "THE additions of this requirement SHALL constitute a single ABI version bump: the frozen manifest, the host-function table and the golden vectors SHALL move together, version one modules SHALL keep executing under their recorded version, and an ABI change without a version bump SHALL fail the build."
ac_8 = "THE Rust SDK and every porting kit SHALL bind the context and the primitives in the source ecosystem's vocabulary, and the EVM kit SHALL map msg.sender, address(this), block.number, keccak256 and ecrecover onto them directly."

[req.39]
title = "Program Economics, Performance and Parallel Execution"
story = "As an operator and as a developer paying for execution, I want programs to run fast enough to be worth deploying and priced by what they actually cost the network, so that the programs plane is economically honest under load rather than only correct at rest."
ac_1 = "THE runtime SHALL cache validated and compiled modules keyed by code hash so a repeated call does not re-link from bytes, and THE cache SHALL be provably semantics-neutral: a cached execution and a cold execution SHALL produce identical outputs, identical metered usage and identical evidence."
ac_2 = "THE runtime SHALL construct its host linker once per engine rather than once per instantiation, and the composition path SHALL not re-register the host surface for each nested frame."
ac_3 = "THE metering SHALL be engine-independent: instruction cost SHALL be determined by the module and the declared cost table rather than by an engine's internal fuel accounting, so a faster execution tier can never diverge in gas from the reference tier, proven by differential execution across both tiers on the conformance vector set."
ac_4 = "THE fee schedule SHALL be governed protocol state carrying its own version rather than a compiled constant, THE receipt SHALL record the schedule version each execution was priced under, and replay SHALL price historical activities under their recorded schedule."
ac_5 = "THE protocol SHALL admit a declared access list on a program activity naming the namespaces it will read and write, SHALL refuse at execution any access outside the declared list with a typed result, and SHALL treat an absent list as declaring the whole reachable set."
ac_6 = "THE sequencer SHALL schedule program activities whose declared access lists do not conflict for parallel execution, and THE result SHALL be indistinguishable from serial execution in canonical order: identical state root, identical receipts, identical event order."
ac_7 = "THE platform SHALL publish execution benchmarks as release artifacts - cold and warm call latency, fuel throughput, parallel speedup against the declared conflict distribution - and a regression past the declared threshold SHALL fail the release gate."

[req.40]
title = "Program Interfaces and Agent-Native Authoring"
story = "As an agent that wants to use or publish a program without a human toolchain, I want a machine-readable interface description and a way to deploy logic without compiling anything, so that programmability is reachable by software rather than only by developers with a build environment."
ac_1 = "EACH program SHALL be able to publish an interface description as protocol state - entry points, calldata and response schemas, required capabilities, emitted event topics and declared error space - bound to its code hash, and THE registry SHALL surface it through receipt-verified reads."
ac_2 = "THE platform SHALL generate client bindings from an interface description in every SDK language, so calling a program is a typed call rather than hand-encoded bytes, and a description that does not match the deployed code hash SHALL be refused rather than rendered."
ac_3 = "THE calldata convention SHALL be canonical and frozen: a declared entry-point discriminator followed by a schema-described payload, byte-identical across every SDK, covered by golden vectors."
ac_4 = "THE platform SHALL ship at least one interpreter program - a deterministic scripting runtime compiled to the programs ABI - so an agent can deploy logic as a script under an existing interpreter's code hash without operating a compiler toolchain, with the interpreter subject to every determinism, metering and isolation law unchanged."
ac_5 = "THE interpreter path SHALL be honest about its costs: script execution SHALL be metered through the same resource classes, and the documentation SHALL state its overhead against a compiled program rather than presenting the two as equivalent."
ac_6 = "THE agent layer SHALL expose program discovery, interface reads and program calls as first-class operations, so an agent can find a program, learn its interface and call it within the declared adoption benchmark."

[req.41]
title = "Ephemeral Metered Sandboxes"
story = "As an agent that needs a bounded, private, disposable execution environment, I want to open a sandbox against a program, pay only for the compute and state I actually used through 402LXP, and have the environment provably destroyed when my lease ends, so that renting execution is an ordinary protocol operation."
ac_1 = "THE programs module SHALL declare a sandbox lease as protocol state: a tenant principal, a host program, an ephemeral namespace, a declared resource ceiling, an escrowed prepayment held in a program-owned account, and an expiry expressed in batch sequence rather than wall-clock time."
ac_2 = "WHEN a tenant opens a lease THE protocol SHALL escrow the prepayment through an ordinary 402LXP transfer into the host program's derived account, and no sandbox SHALL begin execution against an unfunded lease."
ac_3 = "THE sandbox SHALL execute as ordinary metered program execution against its ephemeral namespace, and every resource class the meter already enforces - cpu fuel, memory, storage read, storage write, output values and namespace occupancy - SHALL be charged to the lease rather than to the invoking activity alone."
ac_4 = "THE protocol SHALL settle a lease incrementally against metered usage through the existing streaming mechanism, so a tenant pays for consumption as it occurs and an abandoned lease cannot accumulate unbilled usage."
ac_5 = "WHEN a lease closes or expires THE protocol SHALL drop the ephemeral namespace, settle the final metered usage, and return the unconsumed escrow to the tenant, and THE teardown SHALL be enforced by the transition function through an expiry sweep rather than requested by guest code, so an abandoned or hostile sandbox is still destroyed on schedule."
ac_6 = "WHERE a sandbox must survive across activities THE runtime SHALL persist and restore its execution state - linear memory, globals and declared continuation point - into the ephemeral namespace under the metering and determinism laws, and a restored sandbox SHALL produce byte-identical continuation to an uninterrupted one on the conformance vector set."
ac_7 = "THE lease SHALL be bounded in every dimension it can consume - resource ceiling, namespace bytes, lifetime in batches and total escrow - and exceeding any bound SHALL close the lease with a typed result rather than extend it."
ac_8 = "THE documentation SHALL state plainly what an in-consensus sandbox is and is not: a trustless bounded ephemeral state machine executed by every validator, priced accordingly, and not a venue for general off-platform computation."

[req.42]
title = "Verifiable Off-Platform Compute and the Dispute Arbiter"
story = "As an agent that needs real computation rather than replicated computation, I want to rent a sandbox from an operator at native speed and pay for exactly what I used, with the protocol able to adjudicate a dishonest operator, so that rented compute inherits LayerX's settlement law without asking consensus to run the work."
ac_1 = "THE platform SHALL ship a compute marketplace program in which operators register capacity under a slashable bond, tenants open leases against advertised terms, and every lease's escrow, metered usage commitments and settlement move through ordinary 402LXP transfers with no new authority anywhere."
ac_2 = "AN operator SHALL commit, per billing interval, to the exact inputs, the resulting output digest, the metered usage claimed and the execution state root reached, and a settlement SHALL be payable only against a commitment that has passed its challenge window unrefuted."
ac_3 = "THE deterministic programs runtime SHALL serve as the dispute arbiter: a challenger SHALL be able to force bisection of a disputed interval down to a single execution step, and THE protocol SHALL adjudicate that step on-chain by executing it under the recorded runtime and ABI version."
ac_4 = "THE runtime SHALL expose a canonical per-step execution state commitment - program counter, value stack, locals, linear memory, globals and metered usage - so a single step can be executed and verified from a proof without replaying the whole interval."
ac_5 = "WHEN a challenge succeeds THE protocol SHALL slash the operator's bond and refund the tenant through ordinary transfers, and WHEN a challenge fails THE protocol SHALL charge the challenger's stake, so both sides of a dispute are economically bounded."
ac_6 = "ANY input the sandbox reads from outside the protocol SHALL enter as signed attested data committed in the lease, and no off-platform execution SHALL be settleable whose inputs were not committed before execution, so determinism holds across the adjudication boundary."
ac_7 = "THE marketplace SHALL present operator trust honestly: the verification model in force for each lease - bonded, attested or fraud-provable - SHALL be stated wherever a lease is shown, and no surface SHALL present an unverified operator claim as settled."
ac_8 = "THE off-platform compute plane SHALL hold no custody: escrow lives in program-owned accounts under the transfer law, the one-ledger invariant is unchanged, and the custody guarantee remains Paxeer exclusively."

[req.43]
title = "Programs Plane Qualification"
story = "As the party accountable for what this network runs, I want the whole programs plane gated by adversarial evidence before release, so that permissionless execution ships proven rather than hoped."
ac_1 = "THE hostile-program gauntlet SHALL extend to every capability added after version one - shared state, program custody, context spoofing, precompile abuse, access-list evasion, sandbox escape and arbiter fraud - with every attack defeated by construction and an escape a build-breaking defect."
ac_2 = "THE determinism differential SHALL run across both execution tiers, both metering paths, every added host function and the restored-sandbox continuation set, asserting identical state roots, receipts, events and metered usage per vector."
ac_3 = "THE fuzz corpora SHALL cover calldata, response bytes, iteration cursors, context field addressing, precompile inputs, access lists, snapshot restoration and step proofs, with a panic, hang, non-determinism or unbounded allocation treated as a build-breaking defect."
ac_4 = "THE monetary law SHALL be re-proven over program-heavy histories including derived-account custody, sandbox escrow and marketplace settlement, with balance conservation holding across every one."
ac_5 = "THE performance gates SHALL be release gates: cold and warm latency, fuel throughput, parallel speedup and arbiter step cost SHALL each meet their declared threshold or refuse the release."
ac_6 = "THE programs plane SHALL report its qualification in the platform release report under the same rules as every other pillar, with every unmet gate recorded and the release refused while any remains."
# --------------------------------------------------------------------------
# TASKS
# --------------------------------------------------------------------------

[task.1]
section = "Wave 1 - Foundations and the Approval Seam"
title = "Establish the human workspace and its engineering gates"
status = "pending"

[task.1.1]
title = "Create the human workspace and its build entry points"
status = "done"
wave = 1
do_1 = "Create human/ with the Cargo workspace members layerx-human-service, layerx-intents, layerx-paxeer-client and layerx-explorer-index, the Next.js TypeScript application at human/apps/web, and the contract directory human/schema/human-api."
do_2 = "Wire the Rust crates to the agent workspace crates layerx-types, layerx-wire, layerx-crypto, layerx-proof, layerx-client and layerx-sdk as path dependencies, consuming them without forking or re-implementing any of them."
do_3 = "Add the human-build, human-test, human-lint, human-check and human-e2e make targets to the repository Makefile, delegating to cargo and the web package manager inside human/, with none of them entering the C build or the agent build."
do_4 = "Prove the existing builds are untouched: make build and make agent-build succeed with the human workspace present, and no C or agent target gains a human dependency."
do_5 = "Add a workspace README whose first two paragraphs state the receipt-backed-truth rule and the five-ideas simplicity contract."
verify_cmd = "make human-build"
