reqs = ["42.4"]

[task.35.2]
title = "Verify a single execution step on-platform"
status = "pending"
wave = 21
requires = ["35.1"]
do_1 = "Implement a verifier taking a pre-state commitment, one instruction and a post-state commitment, and deciding whether the transition is correct, in bounded work independent of the length of the disputed execution."
do_2 = "Cover the whole permitted instruction set including every host call, with an unreachable instruction a refusal rather than a gap."
do_3 = "Make the verifier itself deterministic, integer-only and bounded so it can run inside the ordinary execution budget."
do_4 = "Prove the verifier agrees with the runtime on every step of the conformance corpus, so a correct execution is never judged incorrect."
do_5 = "Freeze the verifier behind golden vectors covering every instruction, every host call and every trap."
verify_cmd = "make programs-test"
