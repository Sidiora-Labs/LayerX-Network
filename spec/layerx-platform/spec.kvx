[task.28]
section = "Wave 14 - Program Execution as a Protocol Activity"
title = "Make deployed programs callable on the network"
status = "pending"
note = "Parallel lanes: 28.1 lands first and alone because it reshapes the ABI and host surface every later lane edits. Once it lands, 28.2 through 28.6 are five independent agents on disjoint files. 28.7 joins them and 28.8 follows it."

[task.28.1]
title = "Modularize the ABI and host surface into per-capability units"
status = "implemented"
wave = 14
requires = ["19.3"]
do_1 = "Split src/abi.rs into an abi module: mod.rs holding the Abi transaction, effects and commit; capability.rs holding Capability, CapabilitySet and narrowing; storage_ops.rs holding the storage operations; leaving room for context, crypto, response and balance units later waves add without collision."
do_2 = "Split src/host.rs into a host module: mod.rs holding linker construction and RuntimeState; memory.rs holding the guest read and write helpers; storage.rs, events.rs, calls.rs and transfer.rs holding one host-function family each."
do_3 = "Keep the change strictly behaviour-preserving: the frozen ABI manifest, the host-function table, every status code and every refusal taxonomy stay byte-identical, and the existing test suites pass unchanged with no edits to their assertions."
do_4 = "Add a module-boundary lint proving no host-function family reaches another family's state except through RuntimeState, so later waves can add a host function without reading the whole file."
do_5 = "Record the module map in the runtime crate documentation so a parallel agent can find its lane without reading every file."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_runtime::abi","layerx_programs_runtime::host"]
touches = ["programs/crates/layerx-programs-runtime/src/abi","programs/crates/layerx-programs-runtime/src/host"]
reqs = ["28.6","30.1"]

[task.28.2]
title = "Carry calldata into the invoked entry point"
status = "implemented"
wave = 14
requires = ["28.1"]
do_1 = "Add bounded calldata to AuthorizedExecutionRequest so an activity supplies input bytes rather than only integer arguments, routed through the same reserve-and-write protocol the composition path already uses to enter a callee."
do_2 = "Unify the entry protocol: the activity boundary and a program-to-program edge enter a program the same way, so a program has one entry contract rather than two."
do_3 = "Meter the calldata copy on the same per-byte basis composition already charges, and refuse input past the declared ABI bound with a typed result before any guest code runs."
do_4 = "Extend the Rust SDK entry plumbing so a program declares its entry point once and receives calldata identically at both boundaries."
do_5 = "Test an activity-level call with calldata against a real module, including the empty, maximum and one-past-maximum cases."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_runtime::AuthorizedExecutionRequest","layerx_programs_runtime::entrypoint"]
touches = ["programs/crates/layerx-programs-runtime/src/entrypoint.rs","programs/crates/layerx-programs-runtime/src/execute.rs","programs/sdk/rust/src/entry.rs"]
reqs = ["35.2"]

[task.28.3]
title = "Return response bytes across the call boundary"
status = "implemented"
wave = 14
requires = ["28.1"]
do_1 = "Add a response region to the call protocol: a callee writes bounded response bytes, the runtime copies them into a caller-declared buffer, and the caller reads them through a response host function rather than through storage."
do_2 = "Carry the response to the activity boundary too, so an authorized execution returns bytes as well as integer outputs and metered usage."
do_3 = "Meter the response copy per byte and account it against the output resource class, refusing a response past the caller's declared capacity with a typed result rather than truncating."
do_4 = "Bind the response to the exact call edge so a stale or foreign response can never be read, and prove it across a fan-out of sibling calls."
do_5 = "Extend the Rust SDK call surface with a typed response and test the empty, maximum and over-capacity cases."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_runtime::abi::response","layerx_programs_runtime::CallResponse"]
touches = ["programs/crates/layerx-programs-runtime/src/abi/response.rs","programs/crates/layerx-programs-runtime/src/host/calls.rs","programs/sdk/rust/src/call.rs"]
reqs = ["35.3"]

[task.28.4]
title = "Carry typed failure payloads and program refusal reasons"
status = "implemented"
wave = 14
requires = ["28.1"]
do_1 = "Extend the refusal taxonomy so a guest refusal carries the refusing program, the refusal class and bounded program-supplied reason bytes, replacing the bare negative result code as the only failure signal."
do_2 = "Propagate a nested refusal to the activity boundary unchanged, naming the frame that refused rather than the frame that observed it, so a deep call graph reports its actual cause."
do_3 = "Meter the reason bytes and bound them, so a failure path cannot be used to move unmetered data or to grow a receipt without limit."
do_4 = "Carry the failure payload into the activity receipt under the standard receipt shape so every consumer renders a program failure with the same rigor as a success."
do_5 = "Extend the Rust SDK error vocabulary to construct and decode a reason, and test refusal propagation from depth one and from the declared maximum depth."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_runtime::ProgramFailure","layerx_programs_runtime::RefusalReason"]
touches = ["programs/crates/layerx-programs-runtime/src/fault.rs","programs/sdk/rust/src/error.rs"]
reqs = ["35.4","35.6"]

[task.28.5]
title = "Admit a caller-declared execution budget"
status = "implemented"
wave = 14
requires = ["28.1"]
do_1 = "Replace the compiled-constant execution budget with a budget declared by the invoking activity, bounded above by the protocol maximum and below by the declared minimum viable execution."
do_2 = "Charge only the metered usage actually consumed inside the declared ceiling, so a caller that over-declares is not billed for headroom it did not use."
