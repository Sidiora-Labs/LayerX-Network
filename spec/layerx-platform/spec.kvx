[task.32]
section = "Wave 18 - Economics, Performance and Parallel Execution"
title = "Make program execution fast enough and priced honestly enough to be a real plane"
status = "pending"
note = "Parallel lanes: 32.1, 32.2, 32.3 and 32.4 are four independent agents on disjoint files from the start of the wave. 32.5 depends only on the state model and runs beside them. 32.6 joins 32.5, and 32.7 measures everything last."

[task.32.1]
title = "Cache validated and compiled modules by code hash"
status = "pending"
wave = 18
requires = ["28.7"]
do_1 = "Add a bounded cache keyed by code hash and runtime version holding validated, compiled module artifacts, so a program validated once is not revalidated per invocation."
do_2 = "Keep the cache an accelerator with no consensus authority: a cache miss, an eviction and a cold node must produce byte-identical results and identical metered cost to a cache hit."
do_3 = "Bound cache memory explicitly and evict deterministically, with eviction order derived from protocol state rather than wall-clock recency, so two nodes never diverge through eviction."
do_4 = "Invalidate on runtime version change, on ABI version change and on upgrade, and never serve an artifact compiled under a version other than the one the receipt records."
do_5 = "Prove equivalence with a differential harness executing a large activity mix twice, once with the cache disabled and once enabled, asserting identical receipts, identical state roots and identical fuel."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_runtime::ModuleCache","layerx_programs_runtime::CompiledModule"]
touches = ["programs/crates/layerx-programs-runtime/src/cache.rs"]
reqs = ["39.1"]

[task.32.2]
title = "Build the host linker once per engine"
status = "pending"
wave = 18
requires = ["28.1"]
do_1 = "Hoist linker construction out of the per-instantiation path so the host function table is built once per engine rather than once per instantiation and once per nested call."
do_2 = "Keep the linker immutable after construction, with per-execution state carried in the store rather than in the linker, so no execution can observe or mutate another's host state."
do_3 = "Prove the hoist changes no observable behaviour: identical receipts, identical fuel and identical refusals across the whole conformance suite."
do_4 = "Measure the improvement on the deep-composition benchmark, where the per-nested-call rebuild costs the most."
do_5 = "Add the invariant test that a nested call reuses the engine's linker rather than constructing one."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_runtime::host::linker","layerx_programs_runtime::validate"]
touches = ["programs/crates/layerx-programs-runtime/src/host.rs","programs/crates/layerx-programs-runtime/src/validate.rs"]
reqs = ["39.2"]

[task.32.3]
title = "Make metering an engine-independent property of the module"
status = "pending"
wave = 18
requires = ["28.1"]
do_1 = "Move fuel accounting from an engine configuration flag onto an explicit, deterministic instrumentation of the module: charge points injected at function entry and at every loop back edge, with the schedule recorded in protocol state."
do_2 = "Make the charge a property of the validated artifact so metered cost is identical under any execution strategy, and record the metering schedule version in every receipt."
do_3 = "Keep byte-for-byte cost parity with the current schedule on the whole conformance corpus, so the change is a refactor of mechanism and not a repricing."
do_4 = "Prove the injected instrumentation cannot itself be a divergence source: the same module yields the same charge points on every platform, frozen behind golden vectors."
do_5 = "Document that this is what makes a faster execution strategy possible later without changing what anything costs."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_runtime::MeterInjection","layerx_programs_runtime::FuelSchedule"]
touches = ["programs/crates/layerx-programs-runtime/src/meter/inject.rs"]
reqs = ["39.3"]

[task.32.4]
title = "Move the fee schedule into governed protocol state"
status = "pending"
wave = 18
requires = ["28.7"]
do_1 = "Replace the hardcoded declared fee schedule with a versioned schedule read from protocol state, with every coefficient named and every unit stated."
do_2 = "Record the schedule version in every execution receipt so a historical activity reprices under the schedule that was live when it ran, and replay selects by receipt rather than by node."
do_3 = "Change the schedule only through a governed activity that is itself receipt-backed, with the change visible in state before it takes effect."
do_4 = "Add a demand-responsive component adjusting a base price per unit of the scarce resource by a deterministic rule over recent batch occupancy, computed from protocol state alone with no node-local input."
do_5 = "Prove monotonic bounds on the adjustment so the price cannot move more than a declared fraction per batch, and prove replay of a multi-schedule history reprices every activity correctly."
