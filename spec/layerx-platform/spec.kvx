[task.34]
section = "Wave 20 - Ephemeral Metered Sandboxes"
title = "Rent a sandbox through a program, pay only for the compute used, and have it destroyed"
status = "pending"
note = "Parallel lanes: 34.1 defines the lease record every other lane addresses. Then 34.2, 34.3 and 34.6 are three independent agents on escrow, execution and snapshotting, with 34.4 and 34.5 following the first two, and 34.7 and 34.8 closing the wave."

[task.34.1]
title = "Model the sandbox lease as protocol state"
