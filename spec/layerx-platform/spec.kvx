touches = ["programs/crates/layerx-programs-arbiter/src/step.rs"]
reqs = ["42.3","42.4"]

[task.35.3]
title = "Arbitrate disputes by bisection"
status = "pending"
wave = 21
requires = ["35.2"]
do_1 = "Implement a bisection game in which a challenger and a defender narrow a disputed execution to a single step in a logarithmic number of receipt-backed rounds."
do_2 = "Bound each round by a declared response deadline in batch heights, with a party that fails to respond losing by default and the outcome settled automatically."
do_3 = "Resolve the final step through the single-step verifier and settle stakes atomically with the verdict."
do_4 = "Make the game safe for the honest party: an honest defender with a correct execution always wins, and an honest challenger facing a wrong execution always wins, with the argument recorded."
do_5 = "Test the game against a lying defender, a lying challenger, an absent party, a dispute over a host call and a dispute over a trap."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_arbiter::Bisection","layerx_programs_arbiter::Dispute"]
touches = ["programs/crates/layerx-programs-arbiter/src/bisect.rs"]
reqs = ["42.3"]

[task.35.4]
title = "Build the compute marketplace program"
status = "pending"
wave = 21
requires = ["30.4","33.1"]
do_1 = "Write a marketplace program in which a provider registers capacity and a price, a renter opens a funded lease, and both parties' obligations are protocol state rather than an agreement off-platform."
do_2 = "Escrow renter funds and provider stake in program-owned accounts, released only through the declared settlement paths."
do_3 = "Publish the offer, the lease and the settlement as readable protocol state so a third party can audit the market without the operator."
do_4 = "Keep the marketplace an ordinary program with no privileged authority, subject to the same monetary law and the same composition bounds as any other."
do_5 = "Test the full lifecycle including a provider that never delivers, a renter that never funds and a lease that expires mid-work."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_market::Offer","layerx_programs_market::ComputeLease"]
touches = ["programs/crates/layerx-programs-market/src/lib.rs"]
reqs = ["42.1","42.8"]

[task.35.5]
title = "Settle usage against commitments inside a challenge window"
status = "pending"
wave = 21
requires = ["35.4"]
do_1 = "Have the provider commit to a usage claim and an output commitment, and settle it optimistically after a declared challenge window measured in batch heights."
do_2 = "Let any party open a dispute inside the window by posting a stake and a contradicting commitment, freezing settlement until the dispute resolves."
do_3 = "Make an unchallenged claim final and its settlement irreversible, so finality is a declared property rather than an indefinite maybe."
do_4 = "Prove settlement conserves value across every path: honest settlement, successful challenge, failed challenge and expiry."
do_5 = "Test a challenge posted on the last permitted height and one posted one height late."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_market::UsageClaim","layerx_programs_market::ChallengeWindow"]
touches = ["programs/crates/layerx-programs-market/src/settle.rs"]
reqs = ["42.2"]

[task.35.6]
title = "Stake and slash providers through the ordinary monetary law"
status = "pending"
wave = 21
requires = ["35.3","35.5"]
do_1 = "Require a provider stake proportional to the value at risk, held in a program-owned account and locked for the challenge window."
do_2 = "Slash a provider proven wrong by the arbiter and compensate the challenger, as an ordinary atomic transfer set the kernel applies."
do_3 = "Slash a challenger proven wrong and compensate the provider by the same mechanism, so a frivolous challenge has a real cost."
do_4 = "Never create or destroy value in a slash: every slashed unit lands somewhere, proven by the conservation suite over dispute-heavy histories."
do_5 = "Test stake locking, partial slashing, unlock at window close and slashing against a provider with several concurrent leases."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_market::Stake","layerx_programs_market::slash"]
touches = ["programs/crates/layerx-programs-market/src/stake.rs"]
reqs = ["42.5","42.8"]

[task.35.7]
title = "Accept attested inputs from non-deterministic work"
status = "pending"
wave = 21
requires = ["31.4"]
do_1 = "Define an attested-input record carrying a signed statement from a named attester about work performed off-platform, verified on-platform through the signature primitives."
do_2 = "Let a program declare which attesters it accepts and refuse an attestation from any other, so trust is explicit protocol state rather than an implicit default."
do_3 = "Distinguish attested inputs from verified execution everywhere they appear, so no interface can present a trusted claim as a proven one."
do_4 = "Verify the attestation itself deterministically, so accepting an attested input never makes the transition non-deterministic."
do_5 = "Test acceptance, refusal of an unnamed attester, refusal of a malformed attestation and a replayed attestation."
verify_cmd = "make programs-test"
symbols = ["layerx_programs_market::Attestation","layerx_programs_market::AttesterSet"]
touches = ["programs/crates/layerx-programs-market/src/attest.rs"]
reqs = ["42.6"]

[task.35.8]
title = "State the verification model plainly wherever compute is sold"
status = "pending"
wave = 21
requires = ["35.6","35.7"]
do_1 = "Label every compute lease with its verification model: replicated execution, fraud-proof arbitration or attestation, in the same words everywhere it appears."
do_2 = "State what each model costs and what each model assumes, including the assumption a fraud proof makes about at least one honest watcher."
do_3 = "Refuse to present an attested result as a verified one anywhere in the agent plane, the CLI or the documentation."
do_4 = "Document the arbiter for an implementer: what it proves, what it does not, and where a zero-knowledge or attested-enclave model would slot in later."
do_5 = "Add the compute-market capabilities to the enforced-by tables in the same shape as every other documented capability."
verify_cmd = "make platform-test-docs"
symbols = ["compute_market_guide"]
touches = ["platform/docs/content/guide/compute-market.md","platform/docs/content/concepts/verification.md"]
reqs = ["42.7"]

[task.36]
section = "Wave 22 - Programs Plane Qualification"
title = "Gate the whole programs plane on adversarial evidence before release"
status = "pending"
note = "Parallel lanes: 36.1, 36.2, 36.3, 36.4 and 36.5 are five independent agents, each owning one evidence class and one gate. 36.6 is the only join and it writes nothing it has not measured."

[task.36.1]
title = "Extend the hostile-program gauntlet to every capability added after version one"
status = "pending"
wave = 22
requires = ["29.6","30.6","34.7"]
do_1 = "Consolidate the shared-state, custody, sandbox and composition gauntlets into one inventory covering every capability waves fourteen through twenty-one added, with each attack named, its target capability named and its defence named."
do_2 = "Add the attacks the new capabilities create that no earlier gauntlet covered: context spoofing across a call edge, precompile abuse as a metering-evasion route, access-set evasion, iteration used to escape the resource budget, occupancy charged to the wrong account, and arbiter fraud through a forged step commitment."
do_3 = "Run the whole inventory under the parallel scheduler as well as serially, so no defence depends on serial execution order."
do_4 = "Treat an escape as a build-breaking defect and prove every attack defeated by construction rather than by a check a future refactor could delete."
do_5 = "Publish the inventory and its outcomes as a release artifact in the same shape the existing gauntlet report uses."
verify_cmd = "make programs-qualify"
symbols = ["programs_gauntlet_inventory"]
touches = ["programs/tests/gauntlet","Makefile"]
reqs = ["43.1","30.7"]

[task.36.2]
title = "Run the determinism differential across every added surface"
status = "pending"
wave = 22
requires = ["32.6","34.6","35.1"]
do_1 = "Extend the differential to every host function added in waves fourteen through seventeen, asserting byte-identical results across operating systems, architectures and optimisation levels."
do_2 = "Run the differential across both metering paths - engine fuel and injected instrumentation - asserting identical charges per vector, so the mechanism change is provably not a repricing."
do_3 = "Run the differential across serial and parallel scheduling, asserting identical state roots, identical receipts, identical event order and identical fuel per activity."
do_4 = "Run the differential across the restored-sandbox continuation set, asserting a restored lease continues byte-identically to an uninterrupted one."
do_5 = "Fail the release on any divergence, with the diverging vector, the diverging tier and the diverging field named in the failure rather than a bare mismatch."
verify_cmd = "make programs-qualify"
symbols = ["programs_determinism_differential"]
touches = ["programs/tests/differential","Makefile"]
reqs = ["43.2","28.2"]

[task.36.3]
title = "Extend the fuzz corpora to every new input surface"
status = "pending"
wave = 22
requires = ["33.2","34.6","35.2"]
do_1 = "Add fuzz targets over calldata decoding, response encoding, iteration cursors, context field addressing, hash and signature and wide-integer inputs, access-set declarations, snapshot restoration and step proofs."
do_2 = "Seed each corpus from the golden vectors of the surface it covers so fuzzing starts from valid structure rather than from noise."
do_3 = "Treat a panic, a hang, a non-deterministic result or an unbounded allocation as a build-breaking defect on every target."
do_4 = "Wire the targets into make programs-fuzz alongside the existing programs-fuzz-smoke target, run them for the declared duration as a release gate, and keep every reproducer that has ever fired as a permanent regression case."
do_5 = "Report coverage per surface rather than one aggregate number, so an untouched surface is visible."
verify_cmd = "make programs-fuzz"
symbols = ["programs_fuzz_targets"]
touches = ["programs/fuzz","Makefile"]
reqs = ["43.3","28.8"]

[task.36.4]
title = "Re-prove the monetary law over program-heavy histories"
status = "pending"
wave = 22
requires = ["30.6","34.5","35.6"]
do_1 = "Generate long histories mixing derived-account custody, sandbox escrow, incremental usage settlement, marketplace stakes and slashing, and replay each one from genesis."
do_2 = "Assert balance conservation over every history: total supply unchanged, every slashed unit landing somewhere, every escrow funded equal to spent plus refunded."
do_3 = "Assert that no history contains a balance change outside a kernel-applied 402LXP transfer, checked against the state transition record rather than against the code."
do_4 = "Include adversarial histories: a failed dispute, an expired lease mid-execution, a deprecated program holding value and a settlement racing an expiry sweep."
do_5 = "Fail the release on any conservation failure and record the failing history as a permanent regression case."
verify_cmd = "make programs-qualify"
symbols = ["programs_conservation_suite"]
touches = ["programs/tests/conservation","Makefile"]
reqs = ["43.4","30.2"]

[task.36.5]
title = "Make the performance measurements release gates"
status = "pending"
wave = 22
requires = ["32.7","33.5"]
do_1 = "Set declared thresholds for cold and warm call latency, fuel throughput, parallel speedup at the declared conflict distribution, interpreter overhead and arbiter step cost."
do_2 = "Fail the release when any threshold is unmet, naming the measurement, the threshold and the observed value."
do_3 = "Record every measurement with its hardware, its workload mix and its methodology, so a number without its conditions is never published."
do_4 = "Track each measurement across releases so a slow regression accumulating over several releases is visible rather than absorbed."
do_5 = "Wire the gates into the programs qualification target beside the correctness gates."
