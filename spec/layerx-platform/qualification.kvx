symbol = "RemoteChainSigner"
observed = "The repository contains no owner-provisioned Ethereum secp256k1 or Solana Ed25519 transaction-signing service. The production clients therefore use only an opaque policy handle and public verification key over a bounded UDS or mutually authenticated TLS protocol, verify every returned signature locally, and never accept an inline chain private key. No signer key, endpoint identity, deployed chain address, runtime code hash, program-data address or test-network credential was invented."
assumption = "The custody owner must implement the documented signer request contract with non-exportable keys and policy-domain enforcement, provision independent RPC identities and publish reviewed deployment coordinates. Qualification must exercise refusal, timeout, malformed signature, crash-after-sign, broadcast-unknown and key-policy mismatch against those real services."
severity = "operator-authority"

