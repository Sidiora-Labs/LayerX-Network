[observation.33.3.1]
task = "33.3"
file = "programs/sdk/rust/src/bindgen.rs, programs/sdk/rust/build.rs, platform/cli/src/programs.rs"
symbol = "BindingGenerator, layerx program bindings, SDK binding regeneration"
observed = "Binding generation consumes the exact canonical interface bytes but cannot itself establish that a local file came from protocol state. The CLI therefore requires the independently receipt-verified interface digest and deployed code hash and refuses either mismatch before emitting files; generated clients retain both identities and refuse a call before submission when the observed published identity is stale. SDK build regeneration likewise requires those verified identities as explicit configuration rather than treating an unproven interface file as authoritative. The canonical interface currently describes EVM head-only calldata only as a convention with no word count or field schema, so generated bindings expose it as a checked whole-word byte value rather than inventing fields."
assumption = "Human qualification must obtain the canonical bytes, digest and deployed code hash through verify_interface_read, generate both languages and the guest dispatcher, then upgrade the program and prove the old client performs no submission. It must execute cross-language vectors for every integer, bounded byte string, fixed and variable array, option, every union tag, EVM whole-word payload and typed failure. No generation command, compiler, build, test or call was executed during implementation."
severity = "qualification-required"

