file = "cmd/layerxd/lxp_daemon_process.c, agent/crates/layerx-wire/src/hash.rs, programs/crates/layerx-programs-registry/src/protocol_evidence.rs, platform/hosted/registry/src/routes.rs"
symbol = "apply_canonical_activity, execution_batch_id, ProtocolDeploymentVerifier::verify_program_head, /__registry/deployments"
observed = "The canonical batch header has no independent batch-id field, and equating a receipt batch_id with the final header digest would be circular because the signed header commits the receipt Merkle root. The daemon instead derives batch_id before execution as ContextHash(previous_state_root || activity_id || global_sequence_be || batch_number_be); the Programs verifier now reproduces that exact non-circular identifier while separately checking receipt inclusion and the signed header digest. No authenticated node/core response currently produces the complete DeploymentProof and ProgramStateProof schemas outside source tests, so hosted deployment ingress is deliberately HTTP 503 and accepts neither caller-supplied record_hex nor proof_hex. Admission applies the configured millisecond freshness bound; durable historical replay rechecks the protocol, network, epoch, key range, revocation point and every cryptographic/state binding without relabelling an old receipt as current, and execution separately requires a fresh current lifecycle head. This is not an operational proof-production claim."
assumption = "Human qualification must first add and authenticate a node-owned proof producer that returns canonical activity bytes, receipt and activity inclusion paths, signed header, Programs-root membership, program record and lifecycle absence/presence proof from one sealed batch. Only then may hosted ingress be enabled and exercised against forged cross-network, cross-protocol, cross-epoch, revoked-key, batch-context, stale and lifecycle evidence. No build, endpoint execution, proof-production or deployment qualification result is asserted by this source repair."
severity = "production-blocker"

[observation.28.7.5]
task = "28.7"
file = "programs/crates/layerx-programs-registry/src/protocol_evidence.rs, agent/crates/layerx-agentd/src/main.rs, human/crates/layerx-explorer-index/src/main.rs, platform/hosted/registry/src/main.rs"
symbol = "ProtocolDeploymentVerifier::from_protected_history, verify_historical_deployment, verify_current_protocol_head"
observed = "Post-implementation review found that durable deployment replay and every Agent, Explorer and hosted registry reader were configured with only one sequencer epoch and key window. A legitimate epoch or key rotation therefore made earlier signed deployment admissions unverifiable at process restart. The repair replaces caller-supplied single anchors with one bounded canonical private-file history keyed by protocol, network, epoch, sequencer identity, inclusive batch range and revocation point. Signed-header identity must select exactly one non-overlapping configured anchor; historical replay may select an old anchor without treating its timestamp as current, while fresh deployment, lifecycle and protocol heads must select the explicitly configured latest anchor and remain inside the millisecond freshness bound. Missing, symlinked, public, oversized, unsorted, cross-network, overlapping or downgrade-selected histories fail closed. Hosted deployment ingress remains HTTP 503, and the C execution batch identifier remains the exact ContextHash mirror recorded above."
assumption = "The protected trust-history file is now a required operator input for agentd, Explorer and hosted registry startup. Human qualification must provision it atomically from the canonical sequencer authority source, rotate from an old epoch/key to a new one, restart every consumer with old journal entries present, prove old deployments replay but cannot authorize a current head, and prove omitted, ambiguous, revoked and cross-network anchors prevent readiness. No build, test, daemon restart or rotation result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.37.1.11]
task = "37.1"
file = "paxeer-network/engine/deps/store/cachekv.go, paxeer-network/engine/deps/tasks/scheduler.go, paxeer-network/engine/deps/xbank, paxeer-network/engine/deps/xevm, paxeer-network/engine/executor, paxeer-network/modules/epoch, paxeer-network/modules/evm, paxeer-network/modules/mint, paxeer-network/modules/oracle, paxeer-network/modules/tokenfactory, paxeer-network/node"
symbol = "production panic TODO FIXME not-implemented placeholder mock fake inventory"
observed = "A fully paginated static inventory reviewed 516 marker occurrences across modules, node and engine Go sources before excluding generated files, tests, testutil, simulations, benchmarks, replay tools and explicitly build-tagged mock_balances code from production conclusions. Three reachable input/configuration defects were repaired: cachekv GetWorkingHash now returns a typed unsupported error instead of panicking through its error-bearing interface; oracle parameter validation rejects lookback durations that cannot enter the keeper's int64 timestamp arithmetic; and mint validation parses every stored date and bounds total plus last issuance before uint64-to-int64 coin conversion, including last-mint consistency with cumulative issuance. Synthetic EVM receipt loading and persistence errors are no longer converted into a new successful shell receipt or silently discarded. CW20, CW721 and CW1155 translation now rejects malformed Pax addresses, missing required endpoints, invalid uint256 amounts or token IDs, inconsistent batch lengths, malformed or missing CW721 owner evidence, allowance query or JSON failure and ABI packing failure instead of recovering, logging and emitting plausible false logs; zero addresses remain only where the corresponding Ethereum mint, burn or approval-revocation event defines them. Unknown action types remain ignored. The SDK BaseApp and node legacy DeliverTx hook contract now returns errors and executes hooks on the message cache before its write; message and hook state therefore commit together only after every hook succeeds, while hook failure discards both branches instead of reporting failure after message state was already committed. The giga executor's Cosmos-interop fail-fast route continues through this legacy transactional boundary rather than synthesizing receipts in its direct path. Existing xbank module-account and deferred-cache panics, epoch hook re-panics, mint/oracle/tokenfactory genesis and migration panics, scheduler unknown-status panic, EVM refund/revision/configuration panics, embedded-artifact initialization panics, and node upgrade/invariance/configuration panics are deliberate consensus or startup invariants rather than fabricated success paths. Metrics-removal TODOs do not alter execution. Source regressions were added, but no build, test, format or runtime qualification was run."
assumption = "Human qualification must compile and run the cache-store, mint, oracle and node receipt suites, inject corrupt transient receipt bytes, exercise maximum valid and overflowing mint/oracle values, and verify ProcessProposal/FinalizeBlock deterministically reject synthetic-receipt persistence failure. Residual upstream boundaries remain explicit: the SDK iterator interface has no error return, so giga cache iteration still uses the typed ErrIteratorUnsupported panic caught by the node's deterministic v2 fallback; EVMC EOF creation is unsupported by the pinned executor and historical SELFDESTRUCT/delegate-call parity remains dependent on upstream EVMC/geth compatibility work rather than a local fabricated implementation. Benchmark, replay, simulation, testutil and mock_balances paths are not production execution evidence."
severity = "post-implementation-repair"

[observation.37.1.14]
task = "37.1"
file = "paxeer-network/engine/executor/executor.go, paxeer-network/engine/executor/internal/message.go, paxeer-network/engine/executor/internal/host_context.go, paxeer-network/engine/executor/internal/interpreter.go"
symbol = "TransactionToMessage, HostContext.Call, EVMInterpreter.Run"
observed = "The engine converted an already authenticated sender by presenting a partial types.Signer whose Sender method returned the supplied address while every cryptographic signer method panicked. The replacement constructs the exact geth execution message fields directly at the authenticated boundary and never advertises a signer or fabricates recovery. The EVMC adapter also silently converted negative or oversized signed gas and block values, allowed its custom SSTORE adjustment accumulator to wrap, reset that shared accumulator across nested calls so parent charges could be lost and child charges applied twice, converted a negative refund to uint64, and panicked on unsupported host call kinds and interpreter opcodes. Those boundaries now reject invalid values deterministically, scope bounded SSTORE accounting to a nested execution frame, bound the host context, return explicit execution failures for unsupported calls, and preserve zero as the EVM block-hash result for a negative requested height. Optional pre-fork base-fee fields no longer cause a nil dereference when projected into EVMC. No build, test, format or runtime qualification was run in this implementation phase."
assumption = "The sender passed into Executor remains an authenticated ante result; this repair intentionally does not recover it again or claim equivalence between a Cosmos envelope and an Ethereum signature. Human qualification must compile against the pinned pax-geth and EVMC versions, compare every legacy, access-list, dynamic-fee, blob and set-code message field with geth TransactionToMessage, inject nil transactions and hostile gas/refund/context values, and run geth-versus-evmone state, receipt and gas parity across every enabled fork. EOF creation remains unsupported by the pinned EVMC binding and must fail into the established deterministic fallback rather than execute as a fabricated call."
severity = "consensus-safety"

[observation.6.2.1]
task = "6.2"
file = "human/crates/layerx-paxeer-client/src/deposit.rs, human/crates/layerx-human-service/src/journeys/deposit.rs, platform/ramps/reference/src/main.rs, src/modules/bridge/lxp_bridge_deposit.c"
symbol = "DepositProofVerifier::obtain, DepositProof::credit_intent, DepositRuntime::obtain_proof, PaxeerCustodyClient, lxp_bridge_deposit_credit"
observed = "Post-implementation review replaced Human's obsolete guarantor-certificate and transaction-hash custody assumptions with the exact Paxeer authority-signed deposit-root registration, canonical deposit leaf, index-aware Merkle proof and canonical deposit nullifier consumed by C. Repository source still exposes no authenticated Paxeer producer endpoint for the signed registration and ordered inclusion path, and Core exposes lxp_bridge_deposit_credit only as a direct C function with no activity decoder or Agent intent ingress carrying the complete lx_deposit_proof. Human therefore classifies the absent producer as ProducerUnavailable and refuses the existing seven-field bridge intent as BridgeProofIngressUnavailable instead of treating either path as equivalent evidence; a journey supplied with verified evidence records the canonical nullifier before any credit attempt. The reference ramp custody contract likewise has transaction broadcast and status operations but no deposit-root proof operation."
assumption = "Human qualification must first supply and authorize a real Paxeer producer contract for checkpoint authority signature, state root, deposit root, custody reference, network, protocol, leaf index/count and ordered siblings, then define a canonical Core activity ingress that decodes the complete C proof and binds the Paxeer reserve asset custody reference and agent-main beneficiary. Until both contracts exist, production deposit proof acquisition and LayerX credit remain intentionally unavailable. No build, test, formatting, install, network call or passing end-to-end deposit result is asserted by this source repair."
severity = "integration-blocker"

[observation.6.2.2]
task = "6.2"
