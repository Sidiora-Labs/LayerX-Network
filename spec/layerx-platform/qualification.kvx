symbol = "MirrorSourceFreshness"
observed = "The exact task-25.1 contract and program index archives only by content commitment and expose no authenticated latest-batch or latest-checkpoint getter. A verifier can prove that one requested archive exists at a finalized chain coordinate, but cannot infer that it is the newest archive. Every source observation therefore reports latest batch/checkpoint as None and lag as Unknown; it is never labelled current from its own batch number."
assumption = "A later protocol revision may add an immutable contiguous batch-to-commitment head, or operators may supply an independent authenticated reference head. Qualification must preserve Unknown until that proof exists and must not derive freshness by choosing the numerically newest untrusted request or combining heads across mirrors."
severity = "protocol-boundary"

