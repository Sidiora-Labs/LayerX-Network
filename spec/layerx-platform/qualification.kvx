task = "22.4"
file = "platform/hosted/gateway/src/store.rs, interop/Cargo.lock"
symbol = "RedisStore::operation, gateway:idem principal field, interop workspace lock"
observed = "Durable operation resumption requires binding every idempotency record to its authenticated principal, so new reservations persist a principal field and resume refuses records without the exact principal digest. Redis records created by the earlier hosted gateway schema do not contain that field and intentionally fail closed rather than becoming cross-principal readable. Adding the executable workspace member also changes the Cargo dependency graph, but no build, dependency resolution, lock refresh or qualification command was permitted in this implementation phase."
assumption = "Deployment qualification will drain or explicitly migrate pre-field pending Redis records and regenerate/review interop/Cargo.lock using the pinned dependency graph before building. It must exercise restart, replay and cross-principal resume against Redis AOF persistence."
severity = "phase-boundary"

