[observation.30.2.4]
task = "30.2"
file = "programs/crates/layerx-programs-runtime/src/abi/capability.rs, programs/crates/layerx-programs-runtime/src/transfer.rs"
symbol = "ProgramSpend owner-frame staging"
observed = "The integrated transfer law follows requirement 37.3 and observation 30.4.1: only the deriving program's own frame may stage a program-source leg. An inherited grant over a caller-derived account can be narrowed and forwarded but cannot make a callee the staging owner."
assumption = "Qualification must refuse direct callee-frame staging and preserve exact inherited-key narrowing. A future returned-request mechanism or normative change to requirement 37.4 must be separately versioned rather than weakening the owner-frame check in this task."
severity = "ambiguity"

[observation.30.5.1]
task = "30.5"
file = "programs/crates/layerx-programs-registry/src/deprecate.rs"
symbol = "WindDownPolicy::exit_program, Deprecation::authorize_exit"
observed = "The inherited policy names exit_program as an untyped thirty-two-byte value, while requirement 37.3 and the integrated transfer law permit a derived-account debit only from the deriving program's own frame. Treating exit_program as an unrelated helper program would make the recorded route incapable of constructing ProgramAuthority without weakening owner-frame authorization. The implementation therefore requires exit_program to equal the deprecated program id and keeps that owner's exit-only path callable through tombstone state."
assumption = "The protocol owner must state whether exit_program was intended to mean the owner program id, an export identifier, or a separate helper program. Until a versioned policy schema defines otherwise, qualification must retain the strict owner-program interpretation and refuse helper-program delegation rather than manufacture cross-program authority."
severity = "ambiguity"

[observation.30.5.2]
task = "30.5"
file = "programs/crates/layerx-programs-registry/src/account_state.rs, src/modules/programs/accounts.c"
symbol = "VerifiedAccountSnapshot, lxp_programs_value_account_read"
observed = "Registry balances now resolve from exact MODULE_VALUE account leaf material through the account root, universal subtree root and receipt state root. The Rust verifier reproduces the C state-leaf and state-node domains, while the C view exposes the same canonical balance, asset, freeze flag, observed sequence and account root from the existing account registry. The receipt authority is an explicit boundary which must verify that the named receipt commits the supplied state root and sequence; raw client balance fields no longer exist in DeprecationRequest."
assumption = "Qualification must bind AccountStateReadAuthority to the production receipt verifier, compare C and Rust commitments over the written multi-account and multi-asset fixtures, alter every leaf and proof field adversarially, and confirm stale or mismatched state is refused before lifecycle mutation."
severity = "consensus-boundary"

