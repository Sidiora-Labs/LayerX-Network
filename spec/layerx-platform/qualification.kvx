[observation.37.1.9]
task = "37.1"
file = "Makefile, paxeer-network/Makefile"
symbol = "paxeer-tools-install, paxeer-manifest-lint, rocksdb-source-check, build-rocksdb"
observed = "Fresh tooling review found that the public Paxeer lint target downloaded golangci-lint during LINT, rewrote Go source formatting, and rewrote go.mod/go.sum through go mod tidy, while workspace-lint bypassed that linter. The dependency phase is now gated to install the exact golangci-lint v2.8.0 executable into the workspace build tree only after comparing the downloaded Go module Sum with a reviewed h1 record committed at tools/workspace/checksums/golangci-lint-v2.8.0.h1. Both lint entry points consume that executable offline, reject gofmt drift, run vet and tidy-diff without source mutation, and verify downloaded modules. The JavaScript syntax sweep invokes node --check once per discovered file, so every file is checked and an empty match set cannot invoke node with standard input. Exact Paxeer manifest discovery now classifies the upstream OpenZeppelin package manifest as vendor-only and requires the committed provenance record plus executable tree-digest verifier rather than silently pruning it. Human test aggregates no longer silently omit declared test binaries when their source files disappear, and the local Platform tooling target no longer reports success after optionally skipping live emulator/testnet conformance; that live gate remains the explicit platform-emulator-conformance target. Paxeer Foundry compilation is fixed to solc 0.8.27 and every aggregate Forge build and test uses offline mode. Imported Hardhat configurations no longer embed RPC-provider credentials, private keys or fixed remote endpoints; remote dapp networks require environment URL plus mnemonic, and the reference mainnet fork requires a positive pinned block. The RocksDB BUILD target no longer deletes a checkout, clones a mutable tag, cleans upstream output or performs privileged system installation. It accepts only a clean caller-provided Git checkout whose HEAD equals a full hexadecimal revision, then builds that exact source directory locally."
assumption = "Human qualification must obtain and independently review the golangci-lint v2.8.0 module Sum, then commit only that exact h1 value at tools/workspace/checksums/golangci-lint-v2.8.0.h1; paxeer-tools-install deliberately fails while this source pin is absent. Qualification must then run workspace-install before workspace-lint and retain the Go module cache used by offline golangci-lint, vet and tidy-diff. Exact solc 0.8.27 and 0.8.20 binaries must be provisioned during INSTALL before the offline Foundry aggregates. Hardhat does not expose a source-only compiler-install command: qualification must provision and checksum its native and WASM solc 0.8.20 and 0.8.28 cache entries; paxeer-hardhat-compilers-ready refuses BUILD before Hardhat can perform a hidden download. Remote Hardhat deployment requires an operator-supplied network configuration and signer rather than repository credentials. RocksDB source acquisition and any privileged installation remain explicit operator-owned INSTALL actions; qualification must record the reviewed upstream commit and acquisition checksum before setting ROCKSDB_SOURCE_DIR and ROCKSDB_REVISION. No build, lint, install or test command was executed for this observation."
severity = "qualification-boundary"

