symbol = "LX_ACCOUNT_MODULE_VALUE, lxp_ctx_account_stage_module_value"
observed = "Program balances use a generic non-system module-value account kind with existing account-kind numbers frozen. The canonical name embeds the externally derived identifier, ordinary account opening refuses this namespace, and the module context stages creation through prepare/preview/commit/rollback while activating the existing journalled account-tree root. No transfer authorization kind or balance mutation path is added."
assumption = "Qualification must fault-inject every boundary after account staging, verify no account or index survives rollback, restore the version-two snapshot into a fresh bound registry, and confirm exhaustive system-kind predicates keep module-value accounts on the ordinary authorization path."
