task = "16.1"
file = "platform/middleware/conformance/src/receipts.ts"
symbol = "buildSignedReceipt"
observed = "The conformance suite mints its own canonical receipts and signs them with a freshly generated Ed25519 key that it also installs as the AuthorizedReceiptBatch.sequencerPublicKey, so verifyReceipt accepts them. This exercises the real seller/buyer/webhook code paths and wire format but does not prove interop against a receipt produced by the real C sequencer/kernel."
