[observation.30.2.3]
task = "30.2"
file = "src/modules/programs/call.c, programs/crates/layerx-programs-runtime/src/abi/response.rs, programs/crates/layerx-programs-runtime/src/ffi_call.rs"
symbol = "transfer_program_402, Programs CALL ABI two"
observed = "Program-authorised transfer staging is exposed only through the explicitly candidate ABI and the epoch-activated Programs ABI-two CALL route; ABI one keeps its frozen manifest, decoder and principal-only ordinal-five transfer behavior. The lifecycle validator still admits only guest ABI one until task 31.6 performs the single coordinated ABI bump, so production deployment of an ABI-two guest is intentionally unavailable in this task."
assumption = "Task 31.6 must activate the recorded guest ABI-two deployment and manifest as one versioned transition before operators enable candidate program spending in production. Qualification for 30.2 may exercise the candidate engine and ABI-two CALL fixtures, but must not relabel the candidate surface as frozen or make ABI-one decode tag nine."
