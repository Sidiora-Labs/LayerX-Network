[observation.24.1.1]
task = "24.1"
file = "interop/crates/layerx-migrate/src/ethereum.rs, interop/crates/layerx-migrate/src/solana.rs"
symbol = "EthereumConfig, SolanaConfig"
observed = "The repository does not contain owner-authoritative deployed Ethereum custody ABI coordinates or Solana custody program, ProgramData, instruction-layout and authority coordinates. The production clients therefore require every contract/program identity, code hash, event/instruction field, account owner and authority as exact operator configuration and fail closed when any value is absent or mismatched; no deployment fact was invented."
assumption = "The custody owners must publish and provision reviewed, network-specific configuration for each deployment. Human qualification must reconcile every configured selector, topic, byte offset, account position, code hash and authority against the deployed source and chain state before enabling migration."
severity = "operator-authority"

[observation.24.1.2]
task = "24.1"
file = "interop/crates/layerx-migrate/src/journal.rs, interop/crates/layerx-migrate/OPERATIONS.md"
symbol = "layerx_getMigrationJournalHead, layerx_advanceMigrationJournalHead"
observed = "Authenticated local records and head seals cannot independently detect deletion of a valid suffix. The journal therefore refuses operation unless a strict-majority HTTPS service supplies a durable linearizable monotonic head and authenticated compare-and-swap under the documented RPC methods, but no implementation of that authority exists in this repository."
assumption = "The production datastore or custody owner must implement the documented non-rollbackable head contract and provision independent endpoints. Qualification must prove rollback, truncation, divergent replicas, stale compare-and-swap and authority outage all fail closed before the clients are deployable."
severity = "dependency-boundary"

[observation.24.1.3]
task = "24.1"
file = "interop/crates/layerx-migrate/src/solana.rs"
symbol = "verify_program_boundary, verify_token_custody"
observed = "Standard Solana JSON-RPC supplies transaction-time token balance owner and mint metadata but does not supply a general authenticated historical account proof. The verifier pins an immutable ProgramData account and ELF hash whose last upgrade slot is no later than the transaction, verifies exact signer/writable privileges and transaction-time token deltas, and rechecks configured account owners at finalized state; it does not claim that the live account-owner read is a historical proof."
assumption = "Qualification must use an archive/proof-capable source or independently prove that configured custody and token accounts retained their pinned owners across the accepted migration horizon. If that invariant cannot be established, the operator must narrow the accepted horizon or add an authenticated historical-account proof boundary rather than treating a live read as historical evidence."
severity = "source-proof-boundary"

