[observation.23.3.1]
task = "23.3"
file = "interop/crates/layerx-interop-service/src/server.rs, interop/crates/layerx-interop-service/src/config.rs, platform/hosted/gateway/src/store.rs"
symbol = "visa, VisaRegistry, RedisStore::consume_tap_nonce"
observed = "Post-implementation source review found that the hosted Visa TAP path trusted caller-supplied time and target envelope values, discarded nonce state between requests, synthesized every configured registry key as active, did not bind the submitted canonical LayerX activity to the credential or resulting receipt, and converted an exact retry of a pending operation into a replay refusal. The repair uses server time with bounded configured skew, requires a canonical per-principal target and explicit active or revoked registry status, atomically persists the registry-key/nonce credential-target-operation-activity binding in Redis, admits only the exact already-consumed pending retry, and requires the verified receipt activity identifier to equal the submitted canonical activity identifier. Source tests were added but were not executed in the implementation phase."
assumption = "Human qualification must run the TAP conformance, interop service, real TLS Redis restart/replay, and hosted execution suites; exercise cross-authority, cross-path, revoked, expired, altered-principal, altered-intent, altered-activity, altered-signer, altered-evidence and altered-operation nonce reuse; prove exact pending retries remain idempotent across service and Redis restarts; and inspect durable binding expiry and reconstruction before retaining task 23.3 as qualified."
severity = "qualification-repair"

[observation.37.1.8]
task = "37.1"
file = "platform/Makefile.inc, platform/sdk/conformance/run-go.sh, platform/sdk/conformance/run-jvm.sh, tools/workspace/platform-dependency-roots.txt"
symbol = "platform-dependencies-install, platform-sample-install, platform-sample-dependencies-ready, platform-install-local-artifacts"
observed = "The complete workspace dependency phase now discovers every Platform Cargo, npm, Python, Go, Maven, Gradle, Swift and dotnet manifest and rejects an unclassified root. Workspace-member manifests map explicitly to their locked root; independent Rust samples carry locks; npm packages map to the root lock, an exact parent package or the checksum-checked Human dashboard dependency bridge; and the Spring example is included in Maven preparation. Python samples use a repository-local virtual environment and install the two first-party distributions from current source with no index, dependency resolution or system-global mutation. Go, locked Rust, Maven, revision-locked Swift and dotnet resolution is owned by platform-sample-install. Swift resolution is forced to the two committed Package.resolved files and their hashes are checked before and after INSTALL. Consumers use offline, disabled-automatic-resolution or no-restore modes."
assumption = "Human qualification must run workspace-install before workspace-ci. Missing Python venv support, Maven, Swift or dotnet stops INSTALL explicitly; Swift is not skipped and a SwiftPM lacking force-resolved-versions fails rather than rewriting pins. The Android Gradle sample has neither a checksum-pinned wrapper nor dependency-verification metadata, and no trustworthy hashes can be derived without resolving its repositories. It is therefore classified environment-blocked and platform-test-android-artifact fails at platform-gradle-qualification until a human generates, reviews and commits the wrapper checksum, dependency locks and verification metadata in a network-authorized qualification environment. The iOS artifact gate additionally requires xcodegen and Xcode. Live middleware, testnet and production routes remain separately authorized environment qualification. No install, build, test or lint command was executed for this observation."
severity = "qualification-boundary"

[observation.15.2.1]
task = "15.2"
file = "agent/crates/layerx-client/src/client.rs, agent/crates/layerx-agentd/src/authority.rs"
symbol = "Client::reconnect, authority::resolve"
observed = "Repository-wide post-implementation review found two state-integrity defects in the Agent boundary consumed by production SDK paths. Reconnect discarded its transport before handshake and head validation but could return while retaining an earlier Connected state, and authority-cache age used saturating subtraction so an observation ahead of the canonical core sequence appeared freshly observed. The repair records a non-connected state before reconnection, maps every failure before return, installs Connected only with a live transport, and explicitly evicts and refuses cached or newly resolved future-sequence authority."
assumption = "Human qualification must run the Agent connection and authority suites, exercise real transport loss and canonical-head regression, and prove no mutation proceeds using a future or disconnected authority state. The added regression tests are source artifacts only; no build or passing test result is asserted by this implementation repair."
severity = "post-implementation-repair"

[observation.37.1.4]
task = "37.1"
file = "paxeer-network/modules/evm/keeper/ante.go, paxeer-network/modules/evm/keeper/abci.go, paxeer-network/modules/evm/migrations/migrate_all_pointers.go"
symbol = "Keeper.GetAnteSurplusSum, Keeper.EndBlock, MigrateERCNativePointers"
observed = "Post-implementation review found that corrupt transient surplus data was treated as a zero balance, critical EndBlock accounting and persistence failures were logged while block processing continued, and the pointer migration sliced unvalidated keys, trusted unchecked ABI output shapes and discarded EVM call errors. The repair returns the surplus decoding error, makes consensus-critical EndBlock failures deterministic, validates key and ABI result shapes before use, and propagates all one-off EVM and migration errors."
assumption = "Human qualification must run the EVM EndBlock and upgrade migration suites, inject malformed transient state and ABI results, and prove the block or migration aborts without partial accounting or pointer state. No build, migration replay or passing test result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.37.1.5]
task = "37.1"
file = "paxeer-network/sdk/x/bank/keeper/send.go, paxeer-network/engine/deps/xbank/keeper/send.go, paxeer-network/sdk/x/bank/keeper/msg_server.go, paxeer-network/modules/epoch/types/hooks.go, paxeer-network/modules/epoch/types/genesis.go, paxeer-network/modules/epoch/genesis.go, paxeer-network/modules/mint/keeper/keeper.go, paxeer-network/sdk/x/staking/genesis.go, paxeer-network/node/app.go, paxeer-network/rpc/simulate.go, paxeer-network/rpc/tx.go, paxeer-network/parallelization/staking/src/contract.rs"
symbol = "SendCoinsAndWei, msgServer.MultiSend, panicCatchingEpochHook, DefaultGenesis, InitGenesis, Keeper.GetOrUpdateLatestMinter, staking.InitGenesis, Backend.GetBlockContext, delegate"
observed = "Post-implementation review found negative or uninitialized fractional transfer amounts could panic or increase balances, mixed coin and fractional transfers could leave partial writes, direct send and multisend invocation trusted non-nil upstream messages while multisend also panic-parsed addresses, and zero-value fractional no-ops were ordered after recipient rejection. Epoch hooks swallowed consensus-critical panics while epoch processing continued, default epoch genesis used local wall-clock time, an absent mint schedule was dereferenced, staking genesis ignored index errors and terminated the process on validator-update failure, RPC tracing returned an empty block context as success and trusted concrete state and decoded transaction shapes, the staking contract indexed absent funds, and an unfinished wasm migration was registered as a hard fork at a fixed height. The repair rejects invalid amounts and messages before mutation, preserves the documented initialized zero-transfer no-op, commits mixed transfers atomically, propagates hook and initialization failures, derives default epoch time from consensus context, validates staking genesis inputs before writes, fails RPC conversion and context construction explicitly, validates staking funds, and removes the placeholder hard-fork registration and implementation. Module migration-registration errors for bank, staking, mint and tokenfactory are now fatal during application wiring instead of ignored."
assumption = "Human qualification must run the bank, epoch, mint, staking, tokenfactory, RPC and contract suites; inject failed coin writes after fractional staging, malformed genesis keys and addresses, panicking hooks, missing block time, unsupported tracer state, malformed EVM messages and invalid staking funds; and prove application startup rejects duplicate migration registration. No build, test, formatting, migration replay or passing result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.37.1.6]
task = "37.1"
file = "paxeer-network/consensus/autobahn/types/committee.go, paxeer-network/consensus/autobahn/types/msg.go, paxeer-network/consensus/autobahn/types/proposal.go, paxeer-network/consensus/internal/p2p/giga_router.go"
symbol = "Committee.Leader, SecretKey.ForCommittee, Sign, Signed.VerifySig, Proposal.checkedGlobalRange, Proposal.NextTimestamp"
observed = "Post-implementation review found Autobahn used one process-wide signature tag for every network and committee, selected leaders from only the view coordinates, and converted attacker-controlled proposal block counts to time.Duration without a checked bound. A valid vote, proposal, timeout or quorum certificate could therefore be replayed wherever the same validator key was accepted, while oversized lane ranges could wrap global block or timestamp arithmetic. The repair derives a canonical committee domain from the verifier-owned chain ID, genesis boundary, first block, ordered validator keys and weights; binds local validator keys to that domain at router construction; includes explicit operation domains in signature, leader and shard preimages; rejects unbound signing; and checks lane aggregation, committee offsets and timestamp steps before proposal production or acceptance."
assumption = "Human qualification must run Autobahn type, consensus, availability, persistence, data and router suites; replay serialized votes and quorum certificates across different chain IDs, first blocks and validator weights; restart over existing WAL state with the identical genesis; and inject maximum lane and timestamp offsets. No build, test, formatting, network or passing result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.21.4.1]
task = "21.4"
file = "programs/sdk/rust/src/abi.rs, programs/sdk/rust/src/host.rs, programs/sdk/rust/src/storage.rs, programs/sdk/rust/src/transfer.rs, programs/sdk/c/src/receipts.c, programs/sdk/c/src/storage.c"
symbol = "CANDIDATE_ABI_MANIFEST, pay_from_program_account, decode_read_length, lxp_program_receipt_read"
observed = "Post-implementation review found the Rust program SDK omitted the runtime's candidate program-account transfer import, all three guest bindings trusted a host-reported storage length beyond the caller-owned buffer, and the C receipt reader modified its output before authenticating the returned digest. The repair freezes the exact candidate ABI table, exposes a bounded typed program-account payment without guest authority construction, refuses impossible storage lengths, and publishes a C receipt only after full local decoding and digest verification."
assumption = "Human qualification must run the Rust and C SDK conformance suites against the real runtime, exercise zero and maximum seeds, wrong derived sources, narrowed spending ceilings, oversized host length reports and mismatched receipt digests, and compare frozen ABI manifests byte for byte. No compile, conformance or runtime result is asserted by this source repair."
severity = "post-implementation-repair"

