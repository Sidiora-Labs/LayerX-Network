[observation.13.5.3]
task = "13.5"
file = "human/apps/web/src/explorer/mirror-admission.ts, human/apps/web/src/explorer/mirror-server.ts, human/apps/web/src/app/api/explorer/verify/route.ts, human/apps/web/e2e/explorer-admission.test.ts"
symbol = "MirrorVerificationAdmission, verifyEvidenceFromMirrors, POST"
observed = "Post-implementation review found each public explorer verification request could start an independent mirror child process with a two-minute lifetime and no admission bound or request-cancellation propagation, allowing unbounded process accumulation. The repair admits at most four verifier processes, refuses excess work deterministically with HTTP 429 and Retry-After, constrains input, output and runtime, launches through an explicitly configured prlimit executable with fixed address-space, file-size, descriptor, process and core-dump limits, forwards request cancellation, uses an unconditional kill signal on timeout or abort, and releases the slot on every completion path."
assumption = "Human qualification must load the public endpoint above and below its limit, abort clients at every child-process phase, force timeout, output overflow, verifier crash and malformed output, and prove every process is reaped and capacity returns without queueing or leaked work. The admission regression is a source artifact only; no process-level or passing test result is asserted by this implementation repair."
severity = "post-implementation-repair"

