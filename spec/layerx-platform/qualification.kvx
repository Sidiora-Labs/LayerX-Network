[observation.29.5.9]
task = "29.5"
file = "src/state/lxp_snapshot.c, src/state/lxp_state_root.c"
symbol = "lxp_snapshot_write, lxp_snapshot_load"
observed = "Task 29.5 adds canonical account-registry rooting and version-two snapshot encode/load so occupancy debits cannot restore with pre-debit balances. The inherited generic snapshot format still omits kernel blob bytes even though the universal state root commits blob digests; occupancy itself stores its ledger, schedule, account-root commitment and final record in module KV and does not use the blob store."
assumption = "The generic snapshot owner must add a separately versioned bounded blob section before a blob-bearing kernel can claim full fresh-process restoration. Qualification for 29.5 must use the KV-backed Programs occupancy state and must fail rather than reuse an external live blob set when checking a snapshot root."
severity = "inherited"

[observation.29.5.10]
task = "29.5"
file = "src/state/lxp_journal.c, src/modules/programs/occupancy.c"
symbol = "lxp_state_journal_require_account_root"
observed = "Account-tree root activation is staged through the canonical state journal: rollback restores the prior root mode, while a committed journal retains it with the exact account registry included in the preview/result root. Programs runtime binding must therefore precede fresh-process version-two snapshot load and must present the same authoritative registry identity for the life of the state store."
assumption = "The production owner binds one canonical account registry through lxp_kernel_bind_module_runtime before loading a version-two snapshot and never swaps registry identity under a live state store. Qualification must inject activation failures before commit and a mismatched registry on restore."
severity = "deployment-boundary"

[observation.29.5.11]
task = "29.5"
file = "src/modules/programs/occupancy.c, programs/crates/layerx-programs-runtime/src/occupancy.rs"
symbol = "load_activation_positions, OccupancyLedger::import_activation_position"
observed = "On the first version-two batch, including an empty batch, the terminal transition inventories every bounded canonical progstor namespace and persists its exact byte size at the activation baseline. Pre-upgrade bytes have no authenticated payer mandate, lifetime ceiling or historical governed price, so the transition marks them MigrationRequired, records byte-batches at price zero and freezes access until the namespace owner supplies a signed bounded responsibility through a real CALL. This is an explicit upgrade exemption: those frozen intervals are not retroactively charged while the owner has not migrated or reclaimed the namespace."
assumption = "The protocol owner must ratify a bounded migration grace/reclaim law if persistent pre-upgrade bytes must eventually pay without an owner call; charging them through a manufactured grant would violate the ordinary-account authority boundary. Qualification must exercise empty-batch activation, owner migration and frozen-state rejection and must report the zero-price legacy interval rather than treating it as paid occupancy."
severity = "ambiguity"

