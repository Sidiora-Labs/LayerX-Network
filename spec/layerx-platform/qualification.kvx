symbol = "BlockAPI.GetBlockByNumber, BlockAPI.GetBlockByHash, BlockAPI.GetBlockReceipts, GetBlockNumberByNrOrHash"
observed = "Post-implementation review found block zero bypassed consensus and receipt storage to return a hard-coded synthetic hash with zero state, transaction and receipt roots, while related hash, count and receipt methods treated that invented object as canonical for Graph compatibility. The repair removes the synthetic object and every special lookup: block zero and earliest requests now follow the same bounded consensus, watermark, receipt and root validation paths as every other height, returning null or an error when no canonical block exists. Source regressions now require a live earliest block to carry non-zero backend-derived commitments and reject the retired synthetic hash when no consensus producer is configured."
assumption = "Human qualification must query explicit block zero, earliest and the retired synthetic hash on fresh and historical Paxeer chains, verify the exact response follows the chain's configured initial height, and prove Graph consumers handle canonical null or error results rather than depending on fabricated commitments. No build, RPC execution, Graph replay, test, format or passing result is asserted by this source repair."
severity = "consensus-safety"

[observation.11.1.1]
task = "11.1"
file = "agent/crates/layerx-agentd/src/budget/create.rs, agent/crates/layerx-agentd/src/sign_verify.rs, agent/crates/layerx-agentd/tests/budget_create.rs, human/crates/layerx-human-service/tests/agent_create.rs, human/crates/layerx-human-service/tests/agent_controls.rs"
symbol = "BudgetRequest::verified_submission, VerifiedSubmission, CoreBudgetReceipt, create_protocol_budget"
observed = "Protocol budget creation accepted pipeline-selected object_id and any successful verified receipt without binding that receipt to the submitted canonical activity or proving the created object effect. BudgetRequest now requires an opaque VerifiedSubmission matching the exact submitted bytes; its activity identifier comes from layerx_wire::hash::activity_id through signature verification, and the receipt must carry that exact identifier. VerifiedSubmission audit state is private and exposed read-only so a caller cannot mutate the verifier-derived identity. CoreBudgetReceipt no longer accepts an object ID from the pipeline. Because the canonical receipt schema exposes no created budget/grant object identifier or identity-bound state effect, a successful matching receipt returns ProtocolObjectEffectUnavailable and caches nothing. Existing Human test seams have no verifier-issued canonical LayerX submission and now pass no binding, so they fail closed rather than asserting a protocol budget."
assumption = "Core must define a canonical receipt effect or state proof binding the created object identifier, kind, owner or agent, tenant-relevant authority, asset, ceiling, expiry and creation activity before this function can return ProtocolBudget. Human orchestration must use the ordinary prepare, sign and verify_before_submit path and the resulting opaque submission. Qualification must prove activity substitution, receipt substitution, object substitution, rejected execution and no-cache behavior. No build or passing result is asserted."
severity = "missing-canonical-producer"

[observation.31.1.1]
task = "31.1"
file = "programs/crates/layerx-programs-runtime/src/abi/context.rs, programs/crates/layerx-programs-runtime/src/abi/response.rs, programs/sdk/rust/src/abi.rs"
symbol = "ExecutionContext, CANDIDATE_ABI_MANIFEST, CANDIDATE_HOST_FUNCTIONS"
observed = "The candidate runtime now owns the frozen context_read host function and its field identifiers and canonical encodings, while task 31.7 still owns the Rust SDK and porting-kit bindings. The checked-in SDK candidate manifest therefore does not yet include context_read and its source parity gate will remain in conflict until that declared dependent task updates every guest binding together. The runtime does not preserve a false manifest match by hiding the new host function."
assumption = "Task 31.7 must add the same context_read signature, field identifiers, encodings and typed result surface to the Rust SDK and every porting kit before qualification. Task 31.6 must incorporate the complete candidate table into the single frozen ABI-two version transition. No build, test, format or runtime result is asserted by this implementation task."
severity = "dependency-boundary"

[observation.31.6.1]
task = "31.6"
file = "programs/crates/layerx-programs-runtime/src/abi/manifest.rs, programs/crates/layerx-programs-runtime/src/execute.rs, programs/crates/layerx-programs-runtime/src/qualification.rs, programs/sdk/rust/src/abi.rs"
symbol = "ABI_V1_MANIFEST, ABI_V2_MANIFEST, CandidateActivityReceipt, RecordedExecution"
observed = "ABI two is frozen in the runtime with a distinct layerx_v2 import namespace while the original layerx_v1 module and generated vector remain byte-for-byte unchanged and replay-selectable. The production budgeted v2 path now requires protocol-authenticated execution context whose runtime, ABI and governed fee-schedule versions match the executor before a receipt can be produced; the canonical v2 receipt carries all three versions. Historical replay selects the recorded runtime, ABI and fee schedule and refuses unknown tuples. Compatibility names containing candidate remain aliases for existing runtime callers only; task 31.7 owns their coordinated replacement in the Rust SDK and porting kits, whose checked-in candidate manifest is intentionally not represented as already matching the frozen runtime surface."
assumption = "Human qualification must run the ABI drift gate, validate both generated vectors against an independently reviewed manifest, replay a mixed v1/v2 canonical history, reject altered runtime, ABI and fee-schedule fields, and prove v1 modules cannot import any v2 primitive while v2 modules can still import the immutable v1 base namespace. Task 31.7 must update SDK and porting-kit declarations from the frozen runtime table before cross-surface parity can be claimed. No build, test, format or runtime result is asserted by this implementation task."
severity = "dependency-boundary"

[observation.31.6.2]
task = "31.6"
file = "programs/crates/layerx-programs-runtime/src/abi/manifest.rs, programs/crates/layerx-programs-registry/src/resolver.rs, programs/crates/layerx-programs-runtime/src/ffi_call.rs, programs/sdk/rust/src/abi.rs, programs/tools/generate-abi-vectors.py"
symbol = "ABI_V2_MANIFEST, VerifiedProgramCatalog::admit, layerx_programs_call_activity, CANDIDATE_HOST_FUNCTIONS, audit_surface"
observed = "Follow-up review found the initial ABI-two freeze shadowed v2 as v1 in the registry resolver, left the FFI executor tagged as v1 while executing v2, and left the SDK raw import namespace and frozen table on the ten-function candidate surface. It also generated a v2 vector from the manifest string alone, without proving that the validator, function types, linker and SDK implemented the same surface. The repair uses explicit v1/v2 constants throughout resolution, binds the production executor and authenticated receipt versions to the admitted ABI, rejects v2-to-v1 deployment downgrade while retaining historical v1 decoding and replay, promotes the SDK raw namespace/table to the complete frozen surface, and makes the canonical gate compare the composite manifest, both host tables, all function types, validator derivation, linker module registrations and SDK table before accepting immutable vector bytes."
assumption = "Task 31.7 still owns typed SDK wrappers and porting-kit vocabulary for context, balance, crypto and wide-integer calls; only the raw frozen ABI declarations move here so no guest is compiled against an invalid namespace. Human qualification must compile both registry and runtime consumers, execute distinct v1 and v2 import-bearing replay artifacts, prove all receipt version substitutions fail, and independently inspect the corrected composite v2 vector. The final generator has no overwrite option: an existing differing vector always requires a new ABI version. No build, test, format or runtime result is asserted by this implementation task."
severity = "post-implementation-repair"

[observation.31.6.3]
task = "31.6"
file = "programs/abi-frozen.sha256, programs/tools/generate-abi-vectors.py, programs/crates/layerx-programs-runtime/src/abi/response.rs, programs/crates/layerx-programs-runtime/tests/abi_linker.rs, programs/crates/layerx-programs-runtime/tests/determinism.rs"
symbol = "frozen ABI checksum baseline, CANDIDATE_HOST_FUNCTIONS, every_frozen_import_instantiates_against_its_revision_linker"
observed = "A second follow-up review found that an absent frozen vector could still be regenerated from changed same-version source, that the compatibility response table exposed only part of the now-frozen v2 surface, that the v1 execution golden asserted the current ABI constant, and that linker coverage was inferred by regular expressions over source rather than exercised against the actual linker. The repair adds a separately reviewed non-generated checksum baseline for every frozen ABI, refuses missing or checksum-mismatched frozen artifacts without recreating them, makes the compatibility table an exact full-table alias, pins execution-v1 to ABI_V1_VERSION, and adds import-bearing modules generated from every canonical declaration which validate and instantiate against the real v1 and v2 linkers while proving wrong revisions, wrong signatures, duplicate imports and undeclared extras are rejected."
assumption = "Human qualification must execute programs-abi-drift, which first checks immutable vectors and source/table/SDK parity and then runs the real linker test. The source implementation does not claim that linker instantiation has run. A future ABI version may have its first vector generated only while no frozen checksum baseline exists; the next check refuses that unfrozen output until a human-reviewed checksum is added separately, after which deletion, recreation and same-version replacement are all refused."
severity = "post-implementation-repair"

[observation.31.6.4]
