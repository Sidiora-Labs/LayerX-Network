[observation.24.1.7]
task = "24.1"
file = "interop/crates/layerx-migrate/src/rpc.rs, interop/crates/layerx-migrate/OPERATIONS.md"
symbol = "RpcEndpointConfig::independent_backend, RpcCluster::new"
observed = "Post-implementation review found that migration verification rejected duplicate URL coordinates but had no operator-audited backend identity, so DNS aliases or alternate routes to one source could form a strict majority. The repair requires a bounded canonical independent_backend label on every closed endpoint configuration, independently enforces unique backend identities and host/port coordinates, rejects zero ports, and requires absolute CA/token paths with a regular owner-protected token file before any network request. Missing identities have no compatibility default."
assumption = "Operators must audit and provision one identity per genuinely independent Ethereum, Solana and rollback-anchor backend. Human qualification must prove aliases and duplicate operators are refused, credentials with unsafe modes are refused, and a real independent quorum reaches identical migration facts. No passing build or network result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.24.1.8]
task = "24.1"
file = "interop/crates/layerx-migrate/src/journal.rs, interop/crates/layerx-migrate/OPERATIONS.md"
symbol = "Journal::new, Journal::append, Journal::write_head_seal"
observed = "Post-implementation source review found the authenticated migration journal accepted relative or symlinked authentication-key paths without checking key permissions, created its namespace under ordinary directory defaults, and created record and head-seal temporaries under ordinary file defaults. The first repair checked only the leaf key and namespace entry, leaving a symlinked directory ancestor admissible, and replay checked file type but not ownership or group/world access. Local users or an unintended filesystem target could therefore obtain the HMAC key or durable migration evidence despite the record MAC and rollback anchor. The completed repair requires canonical absolute paths with no symlinked component, a direct regular private key, a same-owner private namespace, explicit 0700 directory and 0600 record/seal creation modes, and direct regular same-owner private record and seal files before every replay read."
assumption = "Operators must provision the key and any existing namespace, records and seals with the documented canonical paths, ownership and modes; the verifier intentionally refuses insecure legacy storage rather than silently changing it. Human qualification must exercise relative and non-normal paths, leaf and ancestor symlinks, foreign ownership, group/world modes on keys/directories/records/seals, concurrent append, crash recovery, rollback-anchor outage and restart with retained records. No build, test, formatter, filesystem fault injection or live authority call was run during this source repair."
severity = "post-implementation-repair"

