[observation.30.5.6]
task = "30.5"
file = "interop/Cargo.toml"
symbol = "workspace.dependencies.rustls"
observed = "Mechanical `cargo generate-lockfile --offline` for the agent, human and platform workspaces is blocked before dependency resolution because interop/Cargo.toml declares the `rustls` key twice at lines 30 and 45. The duplicate is inherited through layerx-mirror and is unrelated to task 30.5. A standalone offline workspace rooted at the exact layerx-agentd path dependency produced the ureq/serde and path-package closure, which was mechanically merged into the agent and human lockfiles; the platform lockfile already carried the same pinned ureq closure. Full workspace resolution remains unperformed because of the duplicate key."
assumption = "Human qualification or the interop owner must resolve the duplicate manifest key and regenerate the affected workspace lockfiles. Task 30.5 does not repair that unrelated manifest conflict and does not claim the manually synchronized path entries constitute a successful Cargo resolution."
severity = "inherited"

[observation.30.5.7]
task = "30.5"
file = "include/layerx/lxp_ledger.h, include/layerx/lxp_transfer.h, src/ledger/lxp_apply.c, src/ledger/lxp_journal.c, programs/crates/layerx-programs-runtime/src/ffi_transfer.rs"
symbol = "LXP_AUTH_PROGRAM_SPEND, layerx_programs_consume_program_spend_authorization"
observed = "The wind-down exit must let the ordinary 402LXP ledger synchronously consume an unforgeable, one-shot owner-program/frame authorization rather than accept a C-asserted OWNER value. The implementation names that transient consumption marker LXP_AUTH_PROGRAM_SPEND and binds it to the exact source, destination, asset, amount, seed-derived owner frame and transfer-set root. Requirement 30.1 and task 30.3 also say that Programs adds no new authority kind, even though an ordinary OWNER marker cannot encode or consume this program-frame witness. The marker creates no balance primitive and direct single-leg application refuses it, but it is a new closed enum value."
assumption = "Protocol qualification must resolve whether 'no new authority kind' prohibits even a transient ledger-consumed representation of the already specified ProgramAuthority. Until a versioned alternative is defined, qualification must retain one-shot exact witness consumption and must not replace it with fabricated OWNER authority or a parallel balance route."
severity = "spec-conflict"

[observation.30.5.8]
task = "30.5"
file = "src/modules/programs/state_record.c"
symbol = "lxp_programs_state_record_encode"
observed = "Human qualification reached the ABI-two program state-record encoder and GCC rejected the writer capacity expression because subtracting two byte pointers yields signed ptrdiff_t before conversion to size_t. The repair records the arena's already validated unsigned remaining capacity before allocating that exact alignment-one span and assigns the same value directly to the writer, removing the mixed-sign pointer-distance calculation without widening the buffer."
assumption = "Human qualification must resume the build and exercise exact-fit and exhausted arena inputs to confirm the encoder retains its original bound and reset behavior."
severity = "qualification-repair"

[observation.30.5.9]
task = "30.5"
file = "src/modules/programs/winddown.c"
symbol = "route_decode"
observed = "Human qualification next reached the persisted exit-route decoder and GCC rejected the exact record-length comparison because the enum fixed-byte count and uint16 seed length were promoted to signed int before comparison with size_t. The repair promotes the fixed-byte operand to size_t so the bounded sum and record length are compared in the same unsigned width."
assumption = "Human qualification must resume the build and retain route-decoder artifacts for exact, truncated and trailing-byte records at both zero and maximum seed length."
severity = "qualification-repair"

