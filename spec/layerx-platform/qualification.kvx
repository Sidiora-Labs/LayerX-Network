[observation.26.1.1]
task = "26.1"
file = "platform/ramps/toolkit/src/clients.rs, platform/ramps/config.example.json, platform/ramps/OPERATIONS.md"
symbol = "ProviderClient, ComplianceClient, LayerxClient::sign, PaxeerCustodyClient"
observed = "The active specification defines economic and custody invariants but the repository contains no owner-published provider settlement schema, compliance decision schema, remote LayerX activity-signer schema, or Paxeer custody signer/broadcaster schema. The toolkit therefore exposes strict versioned deploy-supplied mTLS contracts, requires exact order/customer/beneficiary/amount/currency, signing-purpose/key-handle/public-key and operator account/wallet/vault bindings, and fails closed on every absent or mismatched field instead of inventing a provider-specific success response."
assumption = "Each production owner must publish and provision the documented layerx-ramp-provider-v1, layerx-ramp-compliance-v1, LayerX signature endpoint and layerx-ramp-paxeer-v1 coordinates or an exactly reviewed compatible binding. Human qualification must reconcile the configured wire fields against those authoritative schemas and exercise refusal, timeout, acknowledgement loss, duplicate callback and reversal behavior against real sandboxes."
severity = "dependency-boundary"

[observation.26.1.2]
task = "26.1"
file = "platform/hosted/gateway/src/main.rs, platform/ramps/reference/src/main.rs, platform/ramps/OPERATIONS.md"
symbol = "ProductionRoute::State, WorkAction::SubmitLayerx"
observed = "The production hosted gateway intentionally refuses its principal state route, so the ramp cannot safely discover the LayerX account sequence from that boundary. The NetworkPolicy-restricted operator worker must supply the exact operator debit sequence for an on-ramp direct send or operator receiver sequence for an off-ramp payer-grant draw from an authoritative account-state control plane; the service never guesses, increments a local shadow sequence or accepts a sequence from the customer order."
assumption = "Qualification must bind the operator worker to the production account-state authority and prove the supplied sequence belongs to the exact order-bound direct send or authenticated payer-grant draw. If the hosted gateway later exposes a principal-isolated proof-backed state read, that read can replace the worker input without changing order or receipt binding."
severity = "dependency-boundary"

