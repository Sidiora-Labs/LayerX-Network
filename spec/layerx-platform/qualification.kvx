[observation.18.2.5]
task = "18.2"
file = "programs/crates/layerx-programs-runtime/src/abi/mod.rs, programs/sdk/rust/src/receipt.rs, platform/examples/marketplace/program/src/lib.rs"
symbol = "ReceiptView, Receipt, marketplace::buy"
observed = "The runtime's verified receipt view exposes digest, result, asset, amount and state root, but not payer, destination or application-purpose binding. The marketplace prevents cross-listing replay by atomically recording each consumed digest and validates success, asset and minimum amount, but it cannot prove from the current receipt capability that the named payment credited this marketplace rather than another recipient. Treating that missing fact as present would be a fabricated authorization boundary."
assumption = "The versioned Programs receipt capability must add the destination or an equivalent marketplace/listing-purpose binding before qualification accepts buy as an end-to-end payment flow. Until then the program remains genuine and fail-closed at the unavailable exact capability/deployment boundary recorded above; no fixture or invented destination fact is used."
severity = "dependency-boundary"

[observation.16.4.1]
task = "16.4"
file = "platform/integrations/ios/Sources/LayerXMobile/EventVerification.swift, platform/integrations/android/src/main/java/com/sidiora/layerx/android/FileEventDeliveryStore.java, platform/integrations/agents/src/webhooks.ts, platform/integrations/agents/src/mcp.ts"
symbol = "FileEventDeliveryStore, FileWebhookDeliveryStore, FileVerifiedEventQueue"
observed = "The default webhook delivery ledgers now persist verified delivery claims before processing and retain completed claims rather than evicting them. The MCP delivery handler also commits verified events to a separate durable, delivery-ID-deduplicated queue before completing the webhook claim. The iOS ledger is actor-serialized for the single application process; Android and Node use filesystem locks and atomic replacement. A full ledger or queue fails closed instead of forgetting a completed delivery, so production operators must monitor storage and define archival retention without deleting identifiers that can still be replayed."
assumption = "iOS hosts do not run multiple processes against the same application-support ledger. The Android sample targets API 34 and stores its ledger under Context.getFilesDir, where FileChannel locking, POSIX permissions and atomic rename are available. Human qualification will inject crashes around claim, handler and complete and confirm filesystem semantics on supported devices and deployment volumes."
severity = "platform-assumption"

[observation.16.4.2]
task = "16.4"
file = ".github/workflows/platform.yml, platform/Makefile.inc"
symbol = "mobile application artifact jobs and real integration journeys"
observed = "The iOS app artifact requires an Apple runner, Xcode and XcodeGen; the Android app artifact requires Java 21, Android SDK 34 and Gradle 8.7. Scheduled real-service journeys require the declared public service endpoints, public webhook/event verification keys, dedicated short-lived service credentials, and an HTTPS fixture endpoint that returns a fresh signed delivery as {body: base64, headers: object}. Each lane mutates that fresh body to prove rejection before processing the valid body twice for durable replay suppression. None of those app builds, scans or real service journeys was executed during implementation."
assumption = "Repository administrators will provision the named GitHub variables and secrets, expose the signed-delivery fixture under Bearer authorization, keep the macOS image's Xcode toolchain compatible with Swift 5.9, and qualify the real scheduled account as disposable. XcodeGen is installed from Homebrew because the repository does not contain a generated Xcode project or an owner-supplied generator binary."
severity = "qualification-input"

