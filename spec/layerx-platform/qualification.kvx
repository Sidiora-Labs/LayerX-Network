[observation.11.1.2]
task = "11.1"
file = "human/apps/web/src/auth/server-session.ts, human/apps/web/src/auth/session.ts, human/apps/web/src/proxy.ts, human/apps/web/src/app/app/layout.tsx, human/apps/web/e2e/session-boundary.test.ts, human/apps/web/e2e/shell.spec.ts"
