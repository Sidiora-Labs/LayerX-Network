file = "programs/crates/layerx-programs-runtime/src/lib.rs, programs/crates/layerx-programs-runtime/src/abi/manifest.rs, programs/tests/vectors/abi-v1.hex, programs/tests/vectors/abi-v2.hex, programs/tools/generate-abi-vectors.py"
symbol = "layerx_programs_runtime::ABI_VERSION, layerx_programs_runtime::ABI_MANIFEST, immutable ABI vectors"
observed = "After full graph indexing, the implementation gate found that ABI_VERSION and ABI_MANIFEST existed at the crate root only as re-exported symbols and that the immutable ABI vectors were outside the task's required programs/tests/vectors ownership path. The repair makes the current revision number and exact manifest bytes authoritative public constants defined at crate root, makes the internal v2 names derive from those definitions, removes the former execute and abi-module competing constants, relocates the unchanged checksum-pinned v1 and v2 vectors to the required shared test-vector directory as their only authoritative location, and updates both compile-time includes and the immutable generator gate to that location."
assumption = "Human qualification and the Codify implementation gate must re-index the committed source, resolve both crate-root constant definitions, and execute the drift and linker gates against programs/tests/vectors. The vector bytes and independent checksums remain unchanged. No build, test, format, graph qualification or passing result is asserted by this implementation repair."
severity = "graph-gate"

[observation.31.6.7]
