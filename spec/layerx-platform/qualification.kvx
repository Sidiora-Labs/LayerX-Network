[observation.30.5.11]
task = "30.5"
file = "programs/crates/layerx-programs-runtime/src/transfer.rs, programs/crates/layerx-programs-registry/src/deprecate.rs, programs/crates/layerx-programs-registry/src/authority.rs, programs/crates/layerx-programs-protocol-adapter/src/ffi.rs"
