[observation.19.1.1]
task = "19.1"
file = "programs/.gitignore, programs/vendor/cc/.cargo-checksum.json, programs/vendor/cc/src/target/generated.rs"
symbol = "vendored cc 1.4.4 target table"
observed = "Workspace BUILD log 012 stopped because the vendored cc 1.4.4 checksum manifest declares src/target/generated.rs but the broad Programs target-directory ignore rule had omitted that source file. The file was restored byte-for-byte from Cargo's cached cc 1.4.4 source after its SHA-256 matched the declared f93008829c57e9da3f5d6ac84643c04d8438a319fe9517533604dfe47e9cb8d7 checksum, and the ignore rule now preserves this exact vendored source path."
assumption = "Human qualification must rerun the offline Programs Cargo build so Cargo checks the complete vendor tree; this implementation step validates the restored file against the existing declaration but does not claim the build passes."
severity = "qualification-repair"

[observation.19.4.1]
task = "19.4"
file = "src/state/lxp_state_root.c"
symbol = "universal_leaves"
observed = "The Programs transition expands module-registration commitments to include activation epochs and exact activity types while kernels without a Programs registration retain the legacy commitment format."
assumption = "Human qualification will replay roots immediately before and after Programs activation to confirm the intended version boundary."
severity = "note"

[observation.5.8.1]
task = "5.8"
file = "human/crates/layerx-human-service/tests/custody.rs"
symbol = "copied_principal_record_cannot_cross_the_authenticated_kms_identity"
observed = "The inherited assertion expects a copied principal record to return KmsError::Refused. The provider-backed record now carries an explicit principal/key binding digest and rejects the copy earlier as KmsError::Integrity, which is the new typed key-reference-integrity refusal required by task 5.8. The assertion was left intact rather than weakened or silently rewritten during implementation."
assumption = "Human qualification will confirm the more specific integrity refusal and update the expected taxonomy only if the production provider contract is accepted."
severity = "check-conflict"

[observation.5.8.2]
task = "5.8"
file = "spec/layerx-platform/spec.kvx"
symbol = "task.5.8 touches"
observed = "The declared touch list names provider.rs, signer.rs and health.rs but omits custody/mod.rs, the two production key-creation call sites and development fixture constructors. The required public provider export, provider-backed record format, production startup refusal and remote key-creation path cannot be wired without those omitted files, so strict scope guard reports the necessary implementation paths outside the declaration."
assumption = "Human qualification will review the necessary integration paths and reconcile task.5.8's touch declaration rather than removing the production boundary wiring."
severity = "task-scope"

[observation.5.8.3]
task = "5.8"
file = "human/crates/layerx-human-service/src/custody/mod.rs"
symbol = "Keystore::open"
observed = "Task 5.8 requires replacing the mounted-root-secret production path but specifies no import or migration ceremony for existing v1 file-envelope primary keys. The implementation keeps legacy envelope records readable only through the explicitly development-only constructor and makes production startup accept only a ready remote provider; it does not unwrap and re-import old primary keys into application memory."
assumption = "Before production cutover, human qualification will define and exercise a protocol key-rotation ceremony from every legacy primary key to a remotely generated KMS/HSM key, then confirm no legacy envelope is needed by production startup."
severity = "migration-boundary"

[observation.31.7.3]
task = "31.7"
file = "programs/porting/solana/guest/src/lib.rs, programs/porting/cosmwasm/guest/src/lib.rs, programs/crates/layerx-programs-runtime/src/abi/context.rs"
symbol = "AnchorContext account list, MessageInfo.funds"
observed = "The frozen ABI-v2 context exposes the executing program, immediate caller, invoking principal and protocol sequence/version facts, but exposes neither an authenticated Solana instruction account list nor CosmWasm attached funds. Capabilities are enforced by the host but are not enumerable by the guest, and 402LXP effects do not identify an attached-funds message value. The guest kits therefore map the authenticated signer/program/slot and sender/contract/height subsets without inventing account metadata or funds from calldata."
assumption = "A future ABI revision or production call envelope must add canonical bounded account metadata and authenticated attached-funds facts before Anchor Accounts validation and MessageInfo.funds can be represented as complete native patterns. Human qualification must treat those fields as unavailable, not empty, and must not claim complete source-ecosystem parity from ABI v2."
severity = "missing-canonical-producer"

[observation.31.7.4]
task = "31.7"
file = "programs/Cargo.lock, tests/programs/test_call_activity.c"
symbol = "ABI-v2 reference workspace resolution and production qualification runner"
observed = "Post-implementation review found that generating the Programs workspace lock had re-resolved two unrelated registry packages and that the new production reference runner encoded and registered ABI one while its reference guests imported ABI two. The lock repair preserves the exact pre-task registry versions and checksums while adding only the three local guest package records and dependency edges. The runner repair leaves the historical ABI-one deploy, upgrade and call path unchanged, while the three porting references now encode ABI two in both deploy and call payloads, register the ABI-two Programs module, execute against recorded module version two and require ABI-two deployment and terminal receipt evidence."
assumption = "Human qualification must resolve the locked workspace without changing registry packages, build the three target-separated guests and execute their artifacts through the ABI-two production runner. No build, test, format, lock resolution, runner execution or passing result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.19.4.2]
task = "19.4"
file = "include/layerx/lxp_receipt.h"
symbol = "lxp_receipt"
observed = "Program events are carried as module-namespaced receipt effects, but the receipt has no explicit batch event-root field; batch-root qualification must establish the existing external accumulator path."
assumption = "Task 19.4 keeps the existing receipt shape and emits only through lxp_ctx_emit_event."
severity = "note"

[observation.19.4.3]
task = "19.4"
file = "src/guarantor/lxp_equivocation.c, tests/test_equivocation.c"
symbol = "lxp_equivocation_encode"
observed = "The equivocation encoder previously selected the sequencer capacity branch for an unknown evidence kind and incorporated an arbitrary offender key length before canonical admission. The encoder now admits only exact 33-byte guarantor or 32-byte sequencer evidence before arena allocation and derives capacity solely from fixed per-kind wire sizes."
assumption = "Human qualification will exercise every rejected kind and key-length boundary and confirm that canonical rejection consumes no arena capacity; this source-only implementation step does not claim those checks pass."
severity = "qualification-repair"

[observation.19.4.4]
task = "19.4"
file = "src/paxeer/lxp_finalisation.c, include/layerx/lxp_guarantor.h"
symbol = "lxp_checkpoint_finalisable, lxp_finalisation_requirements.checkpoint_deadline_ms"
observed = "Finality now requires the verifier policy checkpoint epoch to equal the certificate header epoch before historical signer or bond traversal. The checkpoint deadline remains an explicit millisecond policy value supplied by the trusted registry integration through lxp_finalisation_requirements; no canonical on-wire field independently proves who configured that deadline."
assumption = "Human integration qualification must establish that only the registry's trusted finality-policy owner constructs lxp_finalisation_requirements and must fault-inject an unrelated caller epoch and deadline. The C verifier does not derive policy authority from either value."
severity = "integration-boundary"

[observation.22.9.1]
task = "22.9"
file = "agent/crates/layerx-proof/src/checkpoint.rs, agent/crates/layerx-proof/src/export.rs, agent/sdk/typescript/src/verifier.ts, agent/sdk/python/layerx_sdk/verifier.py, platform/integrations/fastapi/layerx_fastapi/signatures.py, platform/sdk/go/verify.go, platform/sdk/jvm/src/main/java/com/sidiora/layerx/sdk/verify/LocalVerifier.java, platform/sdk/dotnet/Verifier.cs, platform/sdk/swift/Sources/LayerXSDK/Verifier.swift"
symbol = "checkpoint certificate verifier settlement and recoverable-signature policy"
observed = "Checkpoint verification now receives the expected Paxeer chain and settlement contract from the verifier and requires every attestation to match exactly. Rust, JVM, .NET, and the Python FastAPI integration bind the compressed key, compact signature, recovery id, EVM signer, and attestation digest; TypeScript, core Python, Go, and Swift expose that complete tuple through a mandatory external verifier contract because those artifacts bundle no authentic secp256k1 recovery primitive. Offline export review also receives the expected domain separately instead of trusting a domain embedded in the exported facts."
assumption = "Human qualification must exercise valid and altered signer, recovery-id, chain, and contract vectors in every SDK, including independent Keccak and recovery vectors for the FastAPI implementation. TypeScript, core Python, Go, and Swift must be supplied a production recoverable-secp256k1 implementation; without one their checkpoint path is unavailable and must not be represented as verified. This source-only implementation step does not claim those cross-language checks pass."
severity = "integration-boundary"

[observation.29.4.1]
task = "29.4"
file = "programs/crates/layerx-programs-runtime/tests/namespace_drop.rs"
symbol = "candidate_drop_reclaims_every_cell_at_the_declared_cell_ceiling"
observed = "Task 29.4 asks for a namespace at a declared cell ceiling, but the runtime and requirement 36.4 declare only activity resource budgets and storage key/value ceilings; no durable per-namespace cell-count ceiling exists. The implementation artifact uses a declared 64-cell boundary fixture without inventing a new storage-occupancy policy or making larger namespaces impossible to drop."
assumption = "Human qualification will decide whether the intended ceiling is the activity's declared reclamation-work budget or a future protocol namespace-occupancy limit; task 29.5 owns the latter resource policy."
severity = "ambiguity"

[observation.29.4.2]
task = "29.4"
file = "programs/crates/layerx-programs-runtime/src/abi/mod.rs"
symbol = "AbiEffects::namespace_drops"
observed = "Task 29.4 asks to credit released occupancy against the rent class, while task 29.5 independently owns creation of that resource class, its fee schedule, responsible account, durable ledger and canonical receipt evidence. Task 29.4 therefore records an exact success-only provisional NamespaceDrop fact but does not settle a rent credit or alter receipt pricing before the owning resource class exists."
assumption = "Task 29.5 consumes committed reclamation facts and final storage, derives the net pre-to-post occupancy delta, and records the durable canonical credit without over-crediting drop-then-write activities."
severity = "dependency-boundary"

[observation.29.5.1]
task = "29.5"
file = "programs/crates/layerx-programs-runtime/src/occupancy.rs"
symbol = "OccupancyLedger"
observed = "The Rust programs runtime has no production batch-transition, account-debit, state-root or snapshot bridge; the real programs call bridge in task 28.7 is still pending. Task 29.5 can implement a canonical staged occupancy ledger and debit allocation, but cannot honestly claim that the C kernel already atomically debits balances and commits this ledger."
assumption = "The task 28.7 programs transition bridge will apply prepared occupancy debits and the bound ledger state in one kernel transaction, and the state/snapshot owners will commit the ledger canonical bytes before production qualification."
severity = "dependency-boundary"

[observation.29.5.2]
task = "29.5"
file = "programs/crates/layerx-programs-runtime/src/meter.rs"
symbol = "MeteredUsage"
observed = "Occupancy is charged once per protocol batch to multiple namespace-responsible accounts, while MeteredUsage is one guest execution charged to one activity payer and its v1 and candidate-v2 evidence layouts are frozen. Folding occupancy into that activity record would misattribute charges and silently change frozen encodings."
assumption = "Task 29.5 records a separate versioned metered occupancy usage and canonical settlement evidence; task 31.6 or the production batch-receipt owner binds that evidence into the versioned protocol receipt without modifying prior layouts."
severity = "version-boundary"

[observation.29.5.3]
task = "29.5"
file = "programs/Cargo.toml"
symbol = "cargo fmt --all -- --check"
observed = "The workspace-wide formatting check reports pre-existing formatting drift in programs-registry, porting kits and runtime validation files outside task 29.5; none is changed by the occupancy diff. Targeted rustfmt checks for every Rust file changed by 29.5 remain clean."
assumption = "Human qualification or the owning tasks will normalize the unrelated files; task 29.5 does not repair inherited formatting drift across other task boundaries."
severity = "inherited"

[observation.21.1.1]
task = "21.1"
file = "programs/crates/layerx-programs-runtime/src/transfer.rs"
symbol = "KernelTransferPrimitive"
observed = "The Rust runtime has no production implementation of KernelTransferPrimitive; the only real transactional 402LXP primitive is owned by the C kernel. Task 28.7 owns the C Programs CALL ingress and must map one prepared activity transfer set into one lxp_ctx_emit_transfer_set call inside the same journal. A Rust test implementation would necessarily be a test double or a second ledger, while implementing the real C bridge here would cross the explicitly reserved 28.7 boundary."
assumption = "Task 21.1 supplies the sealed prepared settlement and strict evidence-verification seam; task 28.7 supplies and qualifies the sole real transactional implementation against the C kernel without introducing a second activity or global map. The actual C program-event envelope and its public receipt/batch publication are task-28.7-owned."
severity = "dependency-boundary"

[observation.28.7.1]
task = "28.7"
file = "programs/crates/layerx-programs-runtime/src/transfer.rs"
symbol = "KernelTransferPrimitive"
observed = "The C transfer primitive produces and verifies the exact sealed transfer-set root synchronously inside the open Programs CALL journal, while the one authoritative outer activity receipt is constructed only after module execution returns. Requiring an inner receipt digest before Rust releases held storage and effects creates an impossible ordering cycle and would imply a second receipt."
assumption = "The Rust affine settlement seam verifies the nonzero exact C transfer-set root, leg count and amount before releasing held state; the C kernel then binds that root and the terminal program outcome into the single standard outer receipt before signing and storage."
severity = "ordering-boundary"

[observation.28.7.2]
task = "28.7"
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
symbol = "CReceiptOracle::verified_receipt"
observed = "The production Programs CALL adapter currently returns AbiError::ReceiptMismatch for every receipt lookup. Because receipt-read grants are validated through ReceiptOracle during ABI construction, an explicitly authorised program cannot perform any receipt-verified read through this path."
assumption = "Task 28.7 remains incomplete until the adapter resolves and verifies canonical receipts from protocol state through an activity-owned scalar callback, or the protocol explicitly removes receipt-read from CALL admission with a typed versioned refusal. An always-mismatch oracle is not treated as implemented host functionality."
severity = "dependency-boundary"

[observation.28.8.1]
task = "28.8"
file = "spec/layerx-platform/spec.kvx"
symbol = "task.28.8 verify_cmd"
observed = "The declared verify_cmd is `make programs-test`, but every touched surface lives in a different cargo workspace than programs/: the agent-layer operation is in agent/crates/layerx-types, the CLI and emulator are in platform/, and the explorer surface is in human/crates/layerx-explorer-index. `make programs-test` compiles and runs the programs workspace plus SDK builds only, so it does not build or execute the new intent, CLI, emulator or explorer tests added by this task."
assumption = "Human qualification will run the per-workspace test suites (agent, platform, human) in addition to `make programs-test`, or a make target will be added that spans the interaction-layer workspaces."
severity = "note"

[observation.28.8.2]
task = "28.8"
file = "platform/cli/src/programs.rs"
symbol = "programs::call"
observed = "The hosted `/v1/programs/call` request and response contract, and the canonical program-call *activity envelope* the network compiles from the operation, are owned by core/hosted (28.7 and later plane tasks) and were not present in the tree. The CLI was written to a self-consistent response shape (result.receipt, result.result_code, result.outcome with completed/refused) and re-binds the typed outcome to the returned receipt by its own result code and a SHA-256 content digest; full checkpoint/sequencer verification still routes through `layerx receipt verify`."
assumption = "When the hosted program-call route lands, its response shape and digest semantics will be reconciled with render_call_result; the canonical-payload the CLI sends is the agent-layer ProgramCall encoding and is the shared anchor for that reconciliation."
severity = "dependency-boundary"

[observation.28.8.3]
task = "28.8"
file = "platform/emulator/src/main.rs"
symbol = "program_call"
observed = "The emulator /v1/programs/call route runs the pre-encoded canonical activity bytes through the real transition (platform_emulator_execute), identical to /v1/activities, so a local call and a network call differ only in state. It does not itself compile the structured {program_id, calldata, budget, capabilities} request into canonical activity envelope bytes, because that encoder is owned by core and no reachable Rust encoder for the full signed CALL envelope exists in this tree."
assumption = "A shared activity encoder (agent-layer or core-exported) will let the emulator accept the structured request directly; until then the emulator consumes the canonical activity bytes produced upstream, which is sufficient for byte-identical transition input and therefore identical receipts."
severity = "dependency-boundary"

[observation.28.8.4]
task = "28.8"
file = "human/crates/layerx-explorer-index/src/programs.rs"
symbol = "ExplorerProgramCall::from_verified"
observed = "The explorer program-call projection is gated by a local VerifiedProgramCall carrying a nonzero receipt digest and observed freshness, mirroring the registry-read honesty check, because layerx-programs exposes no VerifiedCallRead equivalent yet. The verified-call evidence (calldata/response digests, declared budget, requested capabilities, typed outcome) must be produced by a receipt-verifying reader that does not exist in this task's scope."
assumption = "A future task supplies a receipt-verified call-read source (analogous to VerifiedRegistryRead) that constructs VerifiedProgramCall from proof-gated protocol state; the projection and its typed-failure taxonomy are ready to consume it."
severity = "dependency-boundary"

[observation.workflow.1]
task = "28.7"
file = "spec/layerx-platform/spec.kvx"
symbol = "task status"
observed = "Twelve tasks (12.1-12.6, 13.1, 13.4, 13.5, 15.2, 25.1, 28.7) held every in_progress slot with no live agent on any of the first eleven. Their work sits on unmerged branches - notably worktree-task-12-6-activity, codex/task-25-1-mirror-publisher and codex/platform-11-x - which were never integrated into main."
assumption = "The eleven pre-wave-14 claims were released to pending so the wave 14-22 lanes could be claimed under the max_in_progress limit of twelve. No code was deleted and no branch was removed; the unmerged branches named above still carry whatever those tasks produced and need a human integration pass."
severity = "note"

[observation.23.1.1]
task = "23.1"
file = "interop/crates/layerx-ap2/tests/mandates.rs, interop/crates/layerx-ap2/tests/vectors"
symbol = "direct_pair, autonomous_pair, corrupt_signature"
observed = "Post-implementation review found the AP2 conformance tests used synthetic compact strings that never carried valid signatures, success cases asserted only that verification failed, helper amount arguments were ignored, several constraint and evidence tests had empty bodies, and the JSON vectors advertised success while containing placeholder tokens. The repair derives fixed valid P-256 issuer, merchant and delegated-agent keys, signs canonical merchant JWS, issuer SD-JWT and key-bound terminal presentations, exercises direct and autonomous success through the production MandateVerifier, and derives signature, binding, expiry and amount-range refusals from authentic signed evidence. The JSON records now describe the exact deterministic generator, key scalars, semantic inputs and minimal mutation instead of pretending placeholder strings are golden evidence."
assumption = "Human qualification must run the layerx-ap2 test target and independently replay the deterministic vectors against the pinned AP2 revision. The fixed keys are public test material only and are not production trust roots. No build, test, formatter or external AP2 conformance command was run during this source repair, so no passing result or upstream certification is asserted."
severity = "post-implementation-repair"

[observation.23.1.2]
task = "23.1"
file = "interop/crates/layerx-ap2/src/adapter.rs"
symbol = "Ap2Adapter::execute"
observed = "The AP2 adapter verifies mandates and maps them to typed intents through layerx-intents (do_1, do_2), refuses mandates whose constraints cannot be honored through typed Ap2Error variants (do_3), exports portable LayerX evidence through PortableReceipt (do_4), and declares conformance against the pinned AP2 specification (do_5), completing all five do clauses. No protocol authority is granted; adapters translate only."
assumption = "None. Implementation matches specification."
severity = "note"

[observation.23.1.3]
task = "23.1"
file = "interop/crates/layerx-interop-service/src/config.rs, interop/crates/layerx-interop-service/src/server.rs, interop/deploy/gateway/README.md"
symbol = "Ap2AssetBinding::audience, Ap2Request, ap2_execution_key"
observed = "Post-implementation source review found the runnable AP2 ingress accepted caller-selected current time, clock skew, expected audience, currency minor exponent and activity idempotency. A caller could validate expired mandates against an invented clock, make arbitrary audience and autonomous-budget economics appear expected, and replay the same verified mandate pair under fresh hosted-gateway keys. The repair removes those request overrides, uses the service clock with zero skew, bounds deployment bindings, requires canonical lowercase authenticated principal identities, rejects duplicate principal/currency bindings, verifies only against each deployment-owned audience and exponent for that principal, requires exactly one successful verification whose currency matches its binding, and derives the execution identity from the canonical principal plus both signature-verified mandate references."
assumption = "AP2 deployment manifests must add the audience field to every asset binding and clients must stop sending now, clock_skew_seconds, audience, currency_minor_exponent and activity_idempotency_key. Human qualification must exercise expired and future mandates, case-variant principals, duplicate and ambiguous bindings, altered budget exponents, cross-merchant audiences, same-pair retries with altered activities and direct and autonomous presentations across restarts. The signed nonce is still supplied with the presentation and must be issued by the integrating merchant challenge flow; this service does not claim to mint that external AP2 nonce. No build, test, formatter or live ingress was run during this source repair."
severity = "post-implementation-repair"

[observation.24.2.1]
task = "24.2"
file = "interop/crates/layerx-interop-service/src/server.rs, interop/deploy/gateway/README.md"
symbol = "FiatEvidenceVerifier::verify, FiatFacts::token_reference_sha256"
observed = "Post-implementation source review found the hosted fiat verifier accepted an opaque provider token but deliberately ignored it while verifying a signature over settlement facts alone. Authentic provider evidence could therefore be substituted alongside a different token reference, and the undomained signature bytes could alias another provider protocol using the same key and JSON. The runnable handler also bypassed the fiat adapter's provider-derived economic identity and accepted an arbitrary activity idempotency key from the callback, allowing the same signed settlement to be submitted under fresh keys. The repair requires the signed facts to commit to the exact token SHA-256 digest, compares it in constant time, verifies Ed25519 over a LayerX fiat-provider domain followed by the compact facts JSON, removes the callback idempotency override, and uses the adapter identity derived from provider, settlement, rail and evidence class. A source test signs authentic evidence and proves token substitution is refused."
assumption = "Provider callback producers must adopt the documented version-one signature domain and token_reference_sha256 field atomically with deployment and stop sending activity_idempotency_key. Human qualification must replay authentic card, bank and RTP sandbox callbacks, substitute token bytes and cross-protocol signatures, retry the same signed settlement with altered activities, verify the refusal or original result precedes any duplicate effect, and exercise reversals and chargebacks as their distinct signed stages. No build, test, formatter, provider sandbox or live callback was run during this source repair."
severity = "post-implementation-repair"

