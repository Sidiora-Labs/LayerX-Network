[observation.17.5.1]
task = "17.5"
file = "platform/hosted/webhooks/src/trusted.rs, platform/hosted/webhooks/deployment.yaml"
symbol = "TrustedSources, ReceiptVerifier"
observed = "The repository does not contain serving production journey, payment, approval or program event-source services. The webhook boundary therefore accepts only a bounded source event identifier, retrieves the canonical record over separately authenticated mTLS adapters, and independently verifies any protocol activity against the component receipt plus authority facts before a verified event can exist. Readiness remains degraded when any configured source is absent; the implementation does not restore caller-supplied facts or fabricate a source."
assumption = "Owners of the real journey, payment, approval and program services must implement the strict internal event lookup contract and provision its distinct service credentials. Human qualification will deploy those services and confirm canonical subject ordering and receipt correspondence before exercising fault injection."
severity = "dependency-boundary"

[observation.17.5.2]
task = "17.5"
file = "platform/hosted/webhooks/src/hosted.rs, platform/hosted/webhooks/deployment.yaml"
symbol = "KmsClient create_key and sign"
observed = "Task 17.5 requires webhook signing secrets to live behind a real file or KMS boundary, but no webhook-specific KMS schema or executable is present in the repository. The service defines a strict mTLS/token KMS adapter that persists only an opaque handle and public key in Redis, verifies every returned Ed25519 signature locally, and fails readiness closed without the signer; no seed is generated, serialized or accepted from configuration by the production path."
assumption = "The production custody owner must bind the documented create/sign operations to its managed HSM/KMS service and provision non-exportable Ed25519 keys. Human qualification will exercise creation, rotation, signer outage and public-key verification against that real service."
severity = "dependency-boundary"

[observation.17.5.3]
task = "17.5"
file = "platform/hosted/dashboard/src/gateway.rs, platform/hosted/dashboard/src/service.rs"
symbol = "Store request projection, Dashboard receipt"
observed = "The hosted gateway Redis audit stream records a principal digest, an opaque audit digest and an optional outcome, but not a reversible route label; its activity owner index also has no principal-scoped reverse link to an idempotency record. The dashboard therefore renders gateway request records as opaque and unverified and derives receipt views only from payment events created through independent sealed receipt verification. It does not read gateway secret digests, scan another principal's idempotency keys or invent route and receipt facts."
assumption = "A later additive gateway projection may publish redacted route labels and a principal-scoped activity-to-idempotency index. Until then, human qualification should expect request labels to remain opaque and receipts to appear after the canonical verified payment event is published."
severity = "schema-ambiguity"

