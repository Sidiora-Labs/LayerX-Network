[observation.17.4.1]
task = "17.4"
file = "platform/hosted/gateway/src/main.rs, platform/hosted/gateway/deployment.yaml"
symbol = "dependency_ready, /readyz, /v1/authorized-batches/by-activity"
observed = "The repository still has no production serving layerxd or layerx-agentd process, and the LNI Client submission boundary returns only Acknowledged or Unknown. Receipt verification requires an AuthorizedBatch containing batch_id, asset, both roots and sequencer key, but current LNI NodeInfo supplies only the current head/key and BatchHeader lacks batch_id and asset. The gateway therefore separates its mTLS core component and independent authority endpoints, locally verifies every receipt against the independently provisioned sequencer key, and remains degraded when either real boundary is absent. It never accepts the gateway/component's own status word as verification."
assumption = "A real serving core-agent component and an independently administered batch-authority service must be deployed under the documented mTLS/token contracts before hosted readiness and synchronous emulator-compatible activity responses can qualify. Human qualification must validate that those facts originate outside the gateway response and correspond to the canonical batch."
severity = "dependency-boundary"

