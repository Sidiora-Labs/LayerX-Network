symbol = "recorded_abi_version, lint_artifact_for_abi, lint_project_for_abi"
observed = "Final review found the official Rust lint CLI always selected ABI one for artifact and project validation even though the SDK's frozen current surface is ABI two; the only v2 lint entry point was a library helper, and the response fixture reached runtime qualification without passing through the official determinism gate. The repair requires bare artifacts to name ABI one or two explicitly, requires projects to carry exactly one supported abi_version in layerx-program.json, rejects a requested revision that differs from project metadata, dispatches v1 and v2 to their respective immutable validator paths, pins the legacy quickstart command to ABI one, and routes the ABI-two response fixture through the official CLI before runtime qualification."
assumption = "Human qualification must invoke the CLI with v1 and v2 import-bearing artifacts, missing, duplicate and unknown project metadata, CLI and metadata mismatches, and bare --artifact without a revision; it must also execute both quickstart and response-fixture build workflows and prove each selects its recorded revision. No build, test, format, CLI execution or passing result is asserted by this implementation repair."
severity = "post-implementation-repair"

