observed = "Post-implementation review found that migration verification rejected duplicate URL coordinates but had no operator-audited backend identity, so DNS aliases or alternate routes to one source could form a strict majority. The repair requires a bounded canonical independent_backend label on every closed endpoint configuration, independently enforces unique backend identities and host/port coordinates, rejects zero ports, and requires absolute CA/token paths with a regular owner-protected token file before any network request. Missing identities have no compatibility default."
assumption = "Operators must audit and provision one identity per genuinely independent Ethereum, Solana and rollback-anchor backend. Human qualification must prove aliases and duplicate operators are refused, credentials with unsafe modes are refused, and a real independent quorum reaches identical migration facts. No passing build or network result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.25.1.3]
task = "25.1"
file = "agent/schema/lni/v1.kvx, interop/crates/layerx-mirror/src/node.rs"
symbol = "CheckpointResponse, LniArchiveSource::acquire"
observed = "The stable LNI declares a checkpoint response but supplies no canonical encoding for the full replay/possession attestation fields required to reconstruct layerx_proof::checkpoint::Attestation and verify a ThresholdReport. NodeInfo exposes the latest checkpoint identifier but not its batch coordinate, and no serving checkpoint implementation is present. The publisher implements and verifies the exact batch-header authorization response and availability stream, but it refuses to manufacture checkpoint verification or infer checkpoint lag: a nonzero node checkpoint makes checkpoint readiness fail closed and archives remain checkpoint-free until the owner publishes the missing proof/server contract."
assumption = "The node owner must add a versioned canonical checkpoint response carrying every attestation field, bonded-set/settlement registration identity and checkpoint batch coordinate, then bind it to a real serving node. Qualification must prove certificate verification and checkpoint freshness against that endpoint before deployment readiness may be treated as complete."
severity = "dependency-boundary"

[observation.25.1.4]
