[observation.16.1.2]
task = "16.1"
file = "platform/Makefile.inc"
symbol = "platform-test-middleware"
observed = "do_4 requires each role's example exercised in CI against a real service. The suite boots the shipped paid-api seller example as a real HTTP service and drives both seller and buyer middleware over the wire, but the buyer-agent example targets the live Human API (move.quote/commit, journey.get, evidence.get) which is not stood up in this job; it is only build/link-checked as a workspace member here."
assumption = "The buyer end-to-end path against the live Human API is expected to be covered by the hosted testnet job (LAYERX_TESTNET_URL and related secrets), consistent with how other tasks gate live runs. Qualification should confirm a buyer-agent run against the hosted testnet."
