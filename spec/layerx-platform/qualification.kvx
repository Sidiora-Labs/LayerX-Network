[observation.31.7.1]
task = "31.7"
file = "src/modules/programs/call.c, programs/crates/layerx-programs-runtime/src/ffi_call.rs, programs/porting/evm/reference-v2/src/lib.rs, programs/porting/solana/reference-v2/src/lib.rs, programs/porting/cosmwasm/reference-v2/src/lib.rs"
symbol = "lxp_programs_call_activity, layerx_programs_call_activity, ABI-v2 porting reference guests"
observed = "The only production owner that can supply authenticated activity sequence, batch height, runtime, recorded ABI, effective fee schedule, payer coverage and verified receipt facts to an ABI-v2 guest is the C Programs CALL transition through the Rust FFI bridge. A local Rust executor seam cannot honestly manufacture those facts. The earlier local qualifier and its fabricated context and fake receipt oracle were removed. The Programs call-activity test now accepts the three locked artifacts, deploys each through lxp_kernel_execute_activity, invokes each through the production CALL transition and requires canonical ABI-v2 success receipt evidence; each guest traps unless its kit-owned mapped context and crypto results satisfy its source assertions."
assumption = "Human qualification must run programs-porting-v2-references and inspect all three production-transition receipts. This implementation writes that real route but does not claim it has executed."
severity = "qualification-required"

[observation.31.7.2]
task = "31.7"
file = "programs/porting/evm/guest/src/lib.rs"
symbol = "msg_sender, address_this"
observed = "LayerX program and principal identifiers are canonical 32-byte values while an EVM address is 20 bytes. The direct vocabulary mapping takes the low 20 bytes, matching EVM word narrowing, and distinguishes nested msg.sender from root invocation by using immediate_caller when present and invoking_principal only at the root."
assumption = "Human migration qualification must reject deployments whose participating 32-byte identifiers collide after low-20-byte narrowing, or the protocol must publish a collision-resistant canonical address allocation rule before those identifiers are exposed to unmodified Solidity address comparisons."
severity = "migration-boundary"

[observation.31.7.3]
task = "31.7"
file = "programs/porting/evm/src/keccak.rs, programs/porting/evm/guest/src/lib.rs, programs/porting/solana/src/anchor.rs, programs/porting/cosmwasm/src/messages.rs"
symbol = "host migration planning, guest keccak256, AnchorContext, MessageInfo"
observed = "Running EVM guest code now computes keccak256 through the ABI-two host primitive, including the digest used by ecrecover. Host-side migration planning still computes storage-slot addresses, selectors and event topics before a guest execution context exists; removing that tooling computation would make byte-identical migration artifacts impossible rather than moving contract computation into the guest. ABI two also has no authenticated producer for an enumerable Anchor account list or CosmWasm attached funds, so the porting kits expose only the context fields the runtime can prove and refuse to invent the unavailable values."
assumption = "Human qualification must distinguish pre-execution migration planning from running contract computation, compare the planned selectors, topics and slots with guest-produced values, and confirm the Solana and CosmWasm kits refuse unavailable account and funds patterns. A future ABI may add canonical producers for those fields; this implementation does not fabricate them. No build, test, formatting or runtime result is asserted."
severity = "porting-boundary"

[observation.37.1.23]
task = "37.1"
file = ".worktrees, .gitignore, tools/ci/public-repo-audit.sh, .github/workflows, platform/sdk/dotnet"
symbol = "monorepo checkout and immutable workflow inputs"
observed = "CI at revision 47d2df5b failed before executing nineteen jobs because two local audit worktrees were tracked as undeclared gitlinks, while Platform referenced nonexistent setup-node and setup-gradle commits. The repair removes the local gitlinks and tracked .NET build output, scopes ignores for those generated paths, rejects future tracked worktrees and undeclared gitlinks, replaces every external workflow action tag with a verified immutable commit, and rejects future mutable action or Docker-action references. Platform now uses upstream-resolving immutable setup-node v6 and setup-gradle v5 commits."
assumption = "Human qualification must perform clean checkouts on Linux, macOS and Windows, run the public repository audit, and allow every affected workflow to proceed past action resolution and checkout. No workflow, build, test or runtime result is asserted by this source repair."
severity = "clean-host-reproducibility"

[observation.37.1.24]
task = "37.1"
file = "paxeer-network/Dockerfile, paxeer-network/wasm-runtime/libwasmvm-linux.sha256, .github/workflows/paxeer-libwasmvm.yml"
symbol = "Paxeer Docker native runtime acquisition"
observed = "The Docker build copied six ignored native shared libraries that existed only in the developer checkout, so a clean GitHub checkout could not build the image. The repair downloads only the three target-architecture libraries from the public HPX artifact surface, verifies each against a checked-in SHA-256 digest before placing it in the cgo package and runtime library paths, makes missing build artifacts fatal, and adds explicit public-artifact verification for amd64 and arm64. No native binary is added to Git and a changed download is refused rather than accepted."
assumption = "Human qualification must build both Docker architectures from a clean checkout, compare all downloaded bytes with the committed digest manifest and published HPX checksums, exercise cgo linkage for the current, v1.5.2 and v1.5.5 runtimes, and prove missing or altered artifacts fail before compilation. Availability of node.hyperpaxeer.com remains a declared build input; no download, image build or runtime result is asserted by this source repair."
severity = "supply-chain-reproducibility"

[observation.37.1.25]
task = "37.1"
file = ".github/workflows/paxeer-db-tests.yml, .github/workflows/paxeer-go-test.yml, .github/workflows/paxeer-rocksdb-unit-tests.yml, .github/workflows/paxeer-ecr.yml, .github/workflows/paxeer-nightly-ecr.yml"
symbol = "Codecov and AWS workload identity"
observed = "Coverage uploads failed because the repository was not accepted for tokenless upload, while ECR publication failed because AWS denied sts:AssumeRoleWithWebIdentity. The repository-side coverage repair grants only contents read and id-token write, uses the pinned Codecov action's supported OIDC exchange, removes the absent static token dependency and keeps every attempted upload fatal. Both ECR workflows already request the correct GitHub OIDC permission and contain no repository-side credential fallback, so the AWS denial is an external trust-policy gate rather than a code path that can honestly be bypassed here."
assumption = "The repository owner must authorize this repository in Codecov and update AWS role common/gha trust for the exact Sidiora-Labs/LayerX-Protocol repository, event, ref and environment subjects. Human qualification must prove Codecov accepts the GitHub OIDC token and that AWS issues only the intended least-privilege session before any publication. No external configuration change, coverage upload, role assumption or publication result is asserted."
severity = "external-identity-gate"

[observation.37.1.26]
task = "37.1"
file = ".github/workflows/paxeer-integration-test.yml"
symbol = "ubuntu-large integration runner capacity"
observed = "The Docker integration workflow's prepare job did not lose a concurrency race: recent runs queued on the ubuntu-large label for exactly twenty-four hours, executed no step and were cancelled by GitHub. The workflow has no shared cancellation group, and its aggregate job correctly fails when preparation is cancelled. Changing that result to success or deleting the aggregate refusal would hide an unexecuted integration suite, so the workflow remains strict and unchanged apart from immutable action pins."
assumption = "The repository owner must provision an online runner with the exact ubuntu-large label and adequate Docker resources, or explicitly qualify a replacement hosted runner class against the full cluster workload. Human qualification must then execute every integration matrix row at one fixed revision. No runner capacity or integration result is asserted."
severity = "runner-capacity-gate"

[observation.32.2.1]
task = "32.2"
file = "programs/crates/layerx-programs-runtime/src/engine.rs, programs/crates/layerx-programs-runtime/src/host/mod.rs, programs/crates/layerx-programs-runtime/src/validate.rs"
symbol = "WasmEngine, HostLinker, ValidatedModule"
observed = "The implementation hoists the complete versioned host-function table into one immutable engine-owned linker and gives every validated module, including modules resolved for nested frames, a shared reference to that same linker. All execution-varying meter, authority, composition, refusal and outcome state remains owned by a newly created Store. A source invariant records one linker construction, the frozen registration count and pointer identity across v1 root, nested-resolved and v2 modules."
assumption = "Task 32.2 also requires conformance equivalence and a measured deep-composition improvement. The implementation phase forbids running tests or benchmarks, so human qualification must run make programs-test, compare receipts, fuel and refusals with the pre-hoist baseline, and publish cold and warm maximum-depth measurements. No build, test, benchmark, performance improvement or runtime result is asserted by this source implementation."
severity = "qualification-required"

[observation.32.2.2]
task = "32.2"
file = "spec/layerx-platform/spec.kvx, programs/crates/layerx-programs-runtime/src/engine.rs, programs/crates/layerx-programs-runtime/src/host/mod.rs"
symbol = "task.32.2.touches, WasmEngine, HostLinker"
observed = "The task touch set still names the pre-modularization path programs/crates/layerx-programs-runtime/src/host.rs and omits engine.rs, but task 28.1 moved the host surface to host/mod.rs and an engine-owned linker necessarily requires WasmEngine to retain it. The implementation therefore changes engine.rs and host/mod.rs in addition to the still-declared validate.rs path."
assumption = "The source paths are treated as the necessary post-28.1 implementation scope rather than silently recreating host.rs. The task touch set should be reconciled in a later spec-maintenance step; no acceptance criterion is weakened."
severity = "task-scope-drift"

[observation.32.2.3]
task = "32.2"
file = "spec/layerx-platform/spec.kvx, programs/crates/layerx-programs-runtime/src/host/mod.rs, programs/crates/layerx-programs-runtime/src/validate.rs"
symbol = "layerx_programs_runtime::host::linker, layerx_programs_runtime::validate"
observed = "The non-executing Codify implementation gate resolved host::linker and validate.rs but refused lifecycle advancement because the declared module symbol layerx_programs_runtime::validate is not represented as a definition by the graph and the stale pre-modularization host.rs touch path cannot match a change. No runtime or acceptance failure was reported. After recording both metadata contradictions, the source-complete task was advanced manually to implemented rather than inventing a dummy symbol or recreating an obsolete file solely to satisfy tooling."
assumption = "A later spec-maintenance pass should replace the stale graph symbol and touch path with indexable post-28.1 ownership. Human qualification still owns every compile, conformance and benchmark result; this lifecycle label asserts source implementation only."
severity = "graph-gate-metadata"

[observation.32.3.1]
task = "32.3"
file = "programs/crates/layerx-programs-runtime/src/engine.rs, programs/vendor/wasmi/src/engine/func_builder/translator.rs, programs/crates/layerx-programs-runtime/Cargo.toml"
symbol = "MeterInjection, FuelSchedule, WasmEngine"
observed = "The current runtime enables Config::consume_fuel and therefore delegates instruction charge-point placement and pricing to Wasmi's private translator and FuelCosts. A module-side digest or parsed charge-point manifest would describe intended metering but would not enforce it and would still permit a future engine tier to charge differently. The workspace contains no executable WASM instrumentation/re-encoding dependency and the task's sole declared touch path does not exist. Source work stopped rather than labeling metadata as engine-independent metering or silently changing current prices."
assumption = "Implementation requires either a fully owned deterministic WASM binary rewriter that injects runtime-private charge operations while preserving every index-bearing section, or a frozen engine-neutral executable IR consumed identically by every tier. Its schedule must reproduce the current Wasmi 0.31.2 dynamic instruction, branch-stack, call, bulk-memory and table costs exactly before engine fuel can be demoted to a qualification-only reference path. Human qualification must then differential-run both mechanisms over the complete conformance corpus and golden vectors."
severity = "implementation-blocker"

[observation.32.3.2]
task = "32.3"
file = "spec/layerx-platform/spec.kvx, programs/crates/layerx-programs-runtime/src/validate.rs, programs/crates/layerx-programs-runtime/src/cache.rs, programs/crates/layerx-programs-runtime/src/execute.rs, programs/crates/layerx-programs-runtime/src/qualification.rs"
symbol = "task.32.3.touches, MeterInjection, FuelSchedule"
observed = "Task 32.3 names only programs/crates/layerx-programs-runtime/src/meter/inject.rs, but a real implementation must also make validation compile the instrumented artifact, bind metering schedule identity into compiled-cache keys, record that identity in every receipt and canonical evidence, and make replay select and refuse metering versions independently of fee schedule versions. Restricting work to the declared path cannot meet do_2 or prevent a stale cached instrumented artifact."
assumption = "The task touch set must be expanded to the actual validation, cache, execution, receipt and replay ownership before implementation. Metering schedule version remains a distinct consensus field from fee schedule version and must not be exposed as a guest-callable ABI import."
severity = "task-scope-drift"

[observation.32.6.2]
task = "32.6"
file = "include/layerx/lxp_kernel.h, src/protocol/lxp_kernel.c, include/layerx/lxp_daemon.h, cmd/layerxd/lxp_daemon_main.c, cmd/layerxd/lxp_daemon_process.c, cmd/layerxd/lxp_daemon_receipt_authority.c"
symbol = "lxp_kernel_execute_activity_batch, lxp_daemon_start_protocol_batch, executor_run"
observed = "The first common batch API privately scheduled and settled a leading Programs CALL prefix but then published the complete live snapshot before returning its receipt and event spans to the daemon. The production daemon still selected the scalar callback, and switching it directly to that API would make later arena allocation, canonical encoding, ranged Merkle construction or durable-log refusal occur after live consensus mutation while the queue callback reported zero consumption. An observer refusal after the live publish had the same ambiguity. The integration contract therefore requires an opaque bounded prepared-batch transaction: private execution owns stable receipt and event bytes and exposes its exact consumed prefix and terminal root before any live write; the daemon preallocates and validates the complete ranged evidence; only then may one guarded no-refusal kernel commit publish all live domains. Canonical-log and authority publication after that boundary is recoverable fatal work, never an ordinary batch refusal."
assumption = "A bounded precommit write-ahead record must bind the base and settled roots and sequences plus the exact canonical activities, receipts, events, ranged header, signature and proofs, or sufficient deterministic reconstruction inputs, and reach its durability boundary before live publication. Recovery must discard it only when live still equals the base, finalize canonical evidence and authority publication when live equals the settled state, and refuse any third state. Human qualification must fault-inject every allocation, encoding, write-ahead-log, signature, canonical-log, observer and authority boundary on both sides of the live commit and prove that each outcome is either fully uncommitted or a uniquely recoverable committed prefix. No crash-recovery, atomicity or production batch result is asserted by the implementation-phase source."
severity = "atomic-publication-boundary"

[observation.32.6.3]
task = "32.6"
file = "src/modules/programs/call.c, src/modules/programs/fee.c, src/protocol/lxp_kernel.c, programs/tests/differential/parallel.c"
symbol = "lxp_kernel_prepare_activity, lxp_kernel_snapshot_apply_prepared, prepare_fee"
observed = "The ordinary execution-fee debit and treasury credit occur only during serial canonical settlement, while guest balance reads consume immutable receipt-backed facts rather than a mutable live account handle. After exact-prefix retry and rebinding were added, that treasury mutation is not itself a speculative worker dependency for a call with no storage occupancy. The occupancy path is different: layerx_programs_occupancy_payer_available runs during detached guest preparation and reads the treasury frozen flag, asset, balance and credit-overflow condition before staging occupancy transfers. Any call with effective storage writes or otherwise possible occupancy must therefore include the exact treasury and occupancy asset write or become a conservative barrier; an explicit guest capability naming the treasury remains guest-derived independently. Detached admission also originally reused a stale caller fee_balance for later levels and later settlement refusal discarded the private prefix; the implementation now refreshes payer balance from each current level snapshot and returns only deterministic refusal prefixes for exact root and batch-id rebinding and private re-preparation."
assumption = "The planner must distinguish canonical-only execution-fee settlement from worker-observable occupancy settlement without inferring absence from untrusted metadata. Only a strictly decoded effective no-storage/no-occupancy access plan may omit the protocol treasury dependency. Human qualification must include repeated payers, explicit treasury balance grants, storage and no-storage calls, near-empty payer balances, frozen or near-overflow treasury state and refusal at every batch index, then compare committed prefixes and receipts with singleton scalar execution. No fee-settlement equivalence or low-conflict benchmark result is asserted."
severity = "canonical-prefix-equivalence"

[observation.32.6.4]
task = "32.6"
file = "src/protocol/lxp_kernel.c, src/modules/programs/call.c, programs/crates/layerx-programs-runtime/src/schedule.rs, cmd/layerxd/lxp_daemon_process.c"
symbol = "layerx_programs_schedule_plan, lxp_kernel_prepare_activity_batch, apply_canonical_batch"
observed = "The initial predecessor-earliest conflict levels could decrease by canonical index, for example zero, one, zero. Applying a complete level at once would then attempt activity two before activity one and violate the global sequence and receipt-root chain. The scheduler now floors each level by the preceding canonical item's level and the kernel defensively requires nondecreasing contiguous waves. A separate refusal-prefix seam remains: activity_root and batch_id are bound to the offered count before private execution, so a transaction shortened after a later settlement refusal cannot be published under a smaller prefix header using those receipts."
assumption = "When private settlement identifies a shorter committable prefix, that result is only a retry count: the daemon must recompute the exact prefix activity root and batch identifier and rerun side-effect-free private preparation for that prefix before writing its WAL. It must never relabel whole-offer receipts as prefix receipts. Human qualification must include nonmonotonic raw conflict graphs and a refusal at every index, comparing exact sequence, batch id, activity root, receipt chain and consumed count with singleton canonical execution. No ordering or refusal-prefix runtime result is asserted."
severity = "canonical-order-binding"

[observation.32.3.3]
task = "32.3"
file = "wasm-instrument 0.4.0 src/gas_metering/mod.rs, programs/vendor/wasmi/src/engine/config.rs, programs/vendor/wasmi/src/engine/executor.rs, programs/vendor/wasmi/src/engine/func_builder/translator.rs"
symbol = "wasm_instrument::gas_metering::Rules, FuelCosts, FuelConsumptionMode::Lazy"
observed = "The pinned upstream wasm-instrument rewriter can inject static metered blocks, a per-local call surcharge and eager pre-operation memory.grow cost only. Wasmi 0.31.2's current schedule additionally charges typed branch DropKeep values, entity/load/store/call categories, successful bulk-memory bytes, successful table elements and memory/table growth using lazy semantics. Rules::instruction_cost receives only an untyped parity-wasm instruction, so it cannot derive Wasmi's branch keep count; the upstream dynamic rewrite covers only memory.grow and charges before the operation, which changes failed-operation usage relative to Wasmi's default lazy mode. Using the crate unchanged would silently reprice existing programs and violate req.39 ac_3."
assumption = "A suitable extension must include validating operand/control-stack analysis to derive every Wasmi DropKeep charge and must rewrite memory.grow, memory.copy, memory.fill, memory.init, table.grow, table.copy, table.fill and table.init so the dynamic charge executes only after a successful operation while preserving operands/results and trap behavior. The extension itself needs independently frozen transformation vectors. Vendoring the upstream crates before those semantics exist would create a partial dependency footprint rather than an executable parity implementation, so no vendor or manifest changes were retained."
severity = "instrumenter-semantics-blocker"

[observation.32.3.4]
task = "32.3"
file = "include/layerx/lxp_receipt.h, src/protocol/lxp_receipt.c, src/protocol/lxp_kernel.c"
symbol = "lxp_program_outcome, PRG3, LXRC3"
observed = "The active protocol has only legacy version one and occupancy version two, and both versions already have deployed canonical Programs outcome and idempotency layouts that contain no metering schedule identity. Appending a field to PRG1, PRG2, the raw legacy structs or fixed LXRC2 would reinterpret historical bytes. The implementation therefore introduces explicit PRG3 and LXRC3 layouts for newly produced outcomes and maps every decoded PRG1, PRG2, LXRC2 and raw legacy Programs outcome strictly to the protocol-defined metering schedule version one."
assumption = "Metering schedule version one is the exact historical Wasmi schedule required by task 32.3 cost parity. Human qualification must replay archived PRG1, PRG2, raw legacy and LXRC2 bytes and prove their canonical bytes and interpreted cost identity remain unchanged, then prove PRG3 and LXRC3 refuse zero or unavailable schedule identities. No replay or byte-compatibility result is asserted."
severity = "receipt-version-boundary"

[observation.32.3.5]
task = "32.3"
file = "src/modules/programs/event.h, src/modules/programs/event.c"
symbol = "LX_PROGRAMS_EVENT_CALL_OUTCOME, LXMO"
observed = "The committed CALL outcome event version one uses the LXCO domain and a fixed 251-byte body with no metering identity. Reusing that domain or body length would make old and new evidence ambiguous. Newly emitted outcomes therefore use event envelope version two, the LXMO domain and a fixed 255-byte body containing the distinct metering schedule version, while committed-event projection continues to recognize the exact historical LXCO version-one form."
assumption = "Historical LXCO evidence is interpreted as metering schedule version one. Human qualification must replay both envelope generations, freeze their exact bytes and digests, and verify that a receipt outcome and committed event cannot disagree about the schedule selected for execution. No projection, digest or runtime result is asserted."
severity = "evidence-version-boundary"

[observation.32.3.6]
task = "32.3"
file = "include/layerx/programs.h, src/modules/programs/call.c, src/protocol/lxp_kernel.c, src/protocol/lxp_module_ctx.c, cmd/layerxd/lxp_daemon_process.c"
symbol = "layerx_programs_call_begin, layerx_programs_call_terminal_begin, lxp_call_admission_facts"
observed = "A metering schedule version cannot be derived from the fee schedule or parameter version without coupling two independently governed histories. The kernel currently accepts only the protocol-defined historical version one from an owner-supplied runtime admission field, passes it independently across the scalar runtime boundary and requires terminal evidence to return the exact admitted value. That mutable runtime field is not consensus authority and no receipt/state-backed resolver or historical activation registry exists in the current C protocol surface."
assumption = "The runtime bridge must consume the added admission scalar and return the validated artifact's metering schedule version through the added terminal scalar. Before any version beyond one can activate, the state-integration owner must replace the authenticated-input seam with an explicit receipt/state-backed resolver and historical registry rather than aliasing fee_schedule_version, parameter_version, environment or node configuration. Unknown versions already fail closed. Human qualification must exercise mismatched and unavailable schedule refusals; no FFI or runtime execution result is asserted."
severity = "protocol-state-assumption"

[observation.32.3.7]
task = "32.3"
file = "src/protocol/lxp_receipt.c, src/protocol/lxp_kernel.c, src/protocol/lxp_module_ctx.c, src/modules/programs/call.c, src/modules/programs/event.c"
symbol = "lxp_program_metering_schedule_available, lxp_program_outcome_validate_for_protocol, envelope_effect_valid"
observed = "Adversarial source review found that the first receipt implementation treated every nonzero PRG3 metering identity as available, canonical decode did not reapply protocol-to-outcome layout rules, module-context binding collapsed validator failures to non-canonical and LXMO projection checked only its outer framing. The repair centralizes the version-one availability registry, applies protocol-aware validation to canonical and compact encode/decode, preserves validator result precedence at module binding, and parses every fixed LXMO field during projection to refuse unknown schedules, zero required identities or digests, invalid frames, zero runtime/ABI/fee versions and any terminal result other than success. CALL_OUTCOME is emitted only by the successful terminal branch, so both its constructor and historical/new projectors now enforce LXP_OK rather than accepting unrelated nonfatal refusals with no encoded terminal-kind discriminator."
assumption = "Human qualification must exercise each rejected construction and replay form, including unknown nonzero schedules, PRG1 under protocol two, PRG2 under protocol one, invalid PRG3 occupancy evidence and malformed LXMO fixed fields. Historical byte encodings remain unchanged; no build, test, replay or runtime result is asserted."
severity = "adversarial-repair"

[observation.32.3.8]
task = "32.3"
file = "src/modules/programs/metering.c, include/layerx/programs.h, src/protocol/lxp_kernel.c, cmd/layerxd/lxp_daemon_process.c"
symbol = "progmet/active/v1, progmet/history/v1, lx_programs_metering_schedule"
observed = "The implementation replaces the daemon-owned metering scalar with a Programs protocol-state resolver. Signed genesis carries identical LXMR1 active and version-one history records, snapshots retain those module-state records, admission selects the active record by activation batch, and exact-version lookup is available for receipt replay. The canonical record contains nine separately named Wasmi-parity coefficients and an authority digest; it is deliberately independent of fee and generic parameter versions. The task metadata names only the Rust injection file even though consensus authority necessarily spans genesis projection, module state, kernel admission, daemon binding and the scalar runtime boundary."
assumption = "Genesis tooling must call lxp_programs_metering_genesis_append before signing and lxp_programs_metering_genesis_project only after signature verification when constructing initial kernel state; genesis acceptance now rejects manifests without the signer-bound records and normal layerxd restart consumes and validates the already-rooted snapshot projection. Human qualification must freeze the 122-byte LXMR1 and 76-byte runtime schedule vectors, exercise malformed, gapped and missing active/history state, replay receipt version one from exact history, and prove fee/parameter version changes do not select metering history. No later-version activation API is claimed by this task. No build, test, replay or signature result is asserted."
severity = "task-scope-drift"

[observation.32.3.9]
task = "32.3"
file = "src/modules/programs/metering.c, src/protocol/lxp_receipt.c, src/modules/programs/event.c"
symbol = "lxp_program_metering_schedule_available, lxp_programs_metering_schedule_current"
observed = "Task 32.3 freezes the historical Wasmi-parity schedule as protocol version one and does not define a governed activity, receipt schema or activation authority for later metering schedules. Receipt and event validation are context-free and intentionally recognize only version one. An earlier draft exposed an activation helper that could only reject version two, so that dead governance API was removed. The state resolver still walks a consecutive append-only history and selects the record active as of a requested batch, preserving the exact replay contract without pretending that a future schedule can currently be authorized or executed."
assumption = "A future task that introduces metering evolution must jointly specify its governed activity, authority receipt, context-aware receipt/event availability, runtime coefficient support and activation migration. It must not reuse fee-schedule governance or silently make an unknown metering version executable. Human qualification for task 32.3 is limited to signed-genesis version one, malformed/gapped history refusal and exact version-one replay."
severity = "future-governance-boundary"

[observation.32.3.11]
task = "32.3"
file = "cmd/layerxd/lxp_daemon_process.c, src/protocol/lxp_genesis.c, src/modules/programs/metering.c"
symbol = "LAYERX_NODE_GENESIS_MANIFEST, lxp_programs_metering_genesis_project"
observed = "Genesis acceptance now refuses a signed manifest unless it contains identical signer-bound LXMR1 active and version-one history records. On the production bootstrap-snapshot path, layerxd requires the same canonical genesis manifest, binds its genesis root to the bootstrap snapshot root and transactionally projects or exactly matches those records in the live kernel module state before enabling Programs. Checkpoint restart does not reproject genesis; it requires the rooted snapshot history and validates the active schedule before attaching the protocol owner."
assumption = "Operators must provide LAYERX_NODE_GENESIS_MANIFEST when starting from the configured bootstrap snapshot. Existing bootstrap fixtures and deployment configuration need that explicit immutable input. Human qualification must prove a missing, differently signed, root-mismatched, partially projected or lineage-invalid manifest prevents startup and leaves live module state unchanged. No startup or rollback result is asserted by this implementation-phase source change."
severity = "bootstrap-input"

[observation.32.3.10]
task = "32.3"
file = "programs/crates/layerx-programs-runtime/src/meter/inject.rs, programs/vendor/wasm-instrument/src/gas_metering/mod.rs, programs/vendor/parity-wasm/src/elements/ops.rs"
symbol = "MeterInjection, WasmiParityRules, BranchCost"
observed = "The implementation now derives position-specific total branch prices from wasmparser's validated operand and control stacks, rewrites executable Wasm with a versioned runtime-private charge/check surface, preserves shifted function and reference indices, and wraps dynamic memory and table operations with precheck, original operation and successful-only commit. Source vectors freeze a manually audited minimal transformed module, the canonical big-endian schedule, selector-aware br_table cost, loop entry and backedge placement, indexed memory.grow invalid-delta/check/grow/success-commit ordering and indexed memory.copy check/operation/commit ordering. The implementation phase cannot execute the transformer or either engine to capture the full byte and cross-engine corpus."
assumption = "Human qualification must independently capture and review transformed-byte vectors for nested loops, typed br/br_if, maximum-arm br_table, locals, calls, loads/stores, memory grow/copy/fill/init and table grow/copy/fill/init; include both successful and trapping dynamic operations; then differential-run legacy Wasmi fuel and private-hook metering over the complete conformance corpus. No build, test, transformed-byte result, cost parity or cross-engine equivalence is asserted by the source implementation."
severity = "qualification-required"

[observation.32.3.12]
task = "32.3"
file = "programs/crates/layerx-programs-runtime/src/qualification.rs, programs/crates/layerx-programs-runtime/tests/replay.rs, programs/crates/layerx-programs-runtime/src/engine.rs"
symbol = "programs_differential_gate_versioned, DifferentialVector, WasmEngine"
observed = "The source now retains an independent Wasmi 0.31.2 internal-fuel execution over the original validated module beside the production instrumented execution, compares exact typed outcomes and all metered usage, and supplies ABI-aware expected-result vectors for function entry, control flow, start and execution traps, memory growth and bulk copy, MVP table copy, a real v2 host hash, missing exports and validation refusals. The runtime currently has no second production execution strategy: task do_5 says engine-neutral instrumentation enables a faster strategy later rather than authorizing a fabricated tier now. The differential harness deliberately uses isolated state because no authenticated receipt-backed execution context or original-byte nested resolver is available at this qualification entry point."
assumption = "Human qualification must execute the complete legacy-versus-instrumented corpus, capture the golden transformed bytes and investigate any divergence without weakening either oracle. Authenticated context and nested composition require a human-owned fixture with real authority and resolver inputs. When a genuinely distinct faster execution strategy is introduced, it must be added to this same differential evidence contract before activation. No build, test, corpus result, cross-engine parity or faster-tier result is asserted by this implementation-phase source."
severity = "qualification-required"

[observation.32.4.1]
task = "32.4"
file = "src/modules/programs/fees.c, src/modules/programs/occupancy.c, src/protocol/lxp_kernel.c, programs/crates/layerx-programs-runtime/src/meter.rs, programs/crates/layerx-programs-runtime/src/qualification.rs"
symbol = "FeeGovernance, lxp_programs_fee_governance_observe_batch, replay_recorded_execution_with_fee_history"
observed = "The source now seeds a signer-bound version-one fee schedule and demand policy into Programs protocol state, stages later coefficients only from a prior verified Governance receipt whose unique state effect commits the canonical proposal, exposes that pending record before its batch-boundary activation, appends every effective version, resolves current admission from active state and historical replay from the receipt-recorded version, and derives the next occupancy base price from the rooted completed-batch occupancy receipt under an integer per-batch movement cap. Fee-schedule versions are independent of generic parameter and metering versions throughout the C/Rust scalar boundary. Source vectors cover pending visibility, exact history selection, unknown-version refusal, independent parameter versions, bounded increase/decrease and multi-schedule Rust repricing."
assumption = "Human qualification must run the governance, genesis, occupancy, receipt and replay vectors; independently verify the prior Governance receipt authority fixture; freeze LXFR1, LXFP1 and LXFG1 bytes; exercise restart across pending activation and several demand-driven versions; and prove state-root and fee-unit replay equality. The implementation phase ran no build, test, replay or demand history and makes no passing claim."
severity = "qualification-required"

[observation.32.5.1]
task = "32.5"
file = "src/modules/programs/call.c, tests/programs/test_call_activity.c, programs/crates/layerx-programs-runtime/src/access.rs, programs/crates/layerx-programs-runtime/tests/shared_storage.rs, programs/sdk/rust/src/access.rs"
symbol = "lxp_programs_call_decode, AccessDeclaration, AccessSet, call_access_declaration_is_activity_bound"
observed = "The CALL payload now carries a length-delimited canonical access declaration before its response capacity and budget, so the declaration bytes are included in the payload hash and therefore in the canonical activity identifier. A source mutation vector changes only one declaration byte, proves the payload binding rejects the stale hash and proves the re-bound canonical activity receives a distinct identifier. The runtime enforces the committed declaration across real candidate-v2 Wasm storage operations and nested guest frames, rolls back an access refusal, and charges deterministic excess for conservative namespace-wide and absent declarations. SDK builders expose explicit declarations and derived static call/storage declarations without silently widening dynamic inputs."
assumption = "Human qualification must compile and run the C payload/digest vector and the real Wasm executor vectors for calldata-selected keys, prior-state-selected keys and callee-selected access; freeze the canonical access encodings and fee charge; exercise malformed, duplicate, reordered and over-bound declarations; and prove the production C-to-Rust scalar bridge preserves the exact activity-bound declaration across restart and replay. No build, test, formatter, runtime execution or passing result is asserted by this implementation-phase source work."
severity = "qualification-required"

[observation.32.6.1]
task = "32.6"
file = "cmd/layerxd/lxp_daemon_main.c, cmd/layerxd/lxp_daemon_process.c, src/protocol/lxp_kernel.c, src/modules/programs/call.c, programs/crates/layerx-programs-runtime/src/schedule.rs"
symbol = "executor_run, apply_canonical_activity, lxp_kernel_execute_activity, ParallelScheduler"
observed = "Task 32.6 originally named only the Rust scheduler and a differential harness, while the production daemon dequeues and seals exactly one activity per batch and the kernel immediately mutates a single live journal, account registry, identity sequence, Programs storage, fee transaction, receipt and observer. The deterministic scheduler therefore had no production caller, and invoking the scalar kernel concurrently would alias consensus state and publication effects. The implementation scope is expanded to a bounded daemon batch owner, authenticated access-plan conversion, immutable full-domain kernel snapshots, detached prepared transitions, canonical ordered commit, multi-activity sealing and a real runtime-backed differential harness. A prior synthetic harness was removed because local fake activities, receipts, roots and fuel values cannot prove production serial equivalence."
assumption = "Preparation must import or clone every mutable execution input into worker-private ownership and emit complete bounded effects without writing live state, logs, signatures, observers or publication. An absent or unprovable access declaration is an all-conflicting barrier. Thread refusal uses the same level snapshot serially. Live commit validates prepared preconditions and applies effects in canonical activity order without executing guest code again; receipts, events, final state root and per-activity metered fuel must therefore match the identical production path under serial strategy. Human qualification must compile and run low-conflict and all-conflicting real batches, fault-inject worker refusal and prepared-delta failure, exercise restart/replay of multi-activity headers and compare exact roots, receipts, events and fuel. No build, test, replay, benchmark, speedup or passing result is asserted by implementation-phase source work."
severity = "task-scope-drift"

[observation.32.6.5]
task = "32.6"
file = "src/protocol/lxp_kernel.c, cmd/layerxd/lxp_daemon_process.c, src/modules/programs/call.c, programs/crates/layerx-programs-runtime/src/ffi_call.rs"
symbol = "lxp_kernel_snapshot_apply_prepared, lxp_kernel_prepare_activity_batch, lxp_programs_call_schedule_item_prepare, layerx_programs_schedule_plan"
observed = "Programs worker preparation computes the deterministic fee and payer admission result without opening the fee transaction. Base execution fees debit the payer and credit system:fees only during canonical ordered settlement on the evolving private candidate. A semantic refusal after a settled prefix returns its exact prefix length; the daemon recomputes that prefix's activity root and batch identifier and reruns preparation before WAL-first live commit. The verified-receipt BalanceView cannot observe the mutable current treasury. Therefore the base fee treasury is canonical-settlement-only and is not a speculative conflict key. Occupancy remains different: storage-capable guest preparation reads and credits the treasury, so the planner retains the exact treasury plus occupancy asset write whenever the effective access set contains storage writes."
assumption = "Human qualification must fault-inject fee treasury freeze, asset mismatch and credit overflow at the first and later canonical positions; prove later refusal commits only the recomputed prior prefix and that restart recovery publishes that prefix exactly once. It must separately prove no-storage calls omit the base treasury conflict while storage-capable calls retain the occupancy treasury conflict. No build, test, fault-injection, benchmark or speedup result is asserted."
severity = "qualification-required"

[observation.33.1.1]
task = "33.1"
file = "programs/crates/layerx-programs-registry/src/interface.rs, programs/crates/layerx-programs-registry/src/lib.rs, programs/crates/layerx-programs-runtime/src/validate.rs"
symbol = "ProgramInterface, InterfaceDigest, verify_interface_read, ValidatedModule::exports_callable_entrypoint"
observed = "The interface is a bounded canonical protocol record binding an exact code hash and ABI to sorted entry points, discriminators, the frozen EncodingConvention and complete TypeTag schema family, exact scoped ordinary-ABI capabilities, event topics and typed failures. Publication validates the real module, refuses every entry lacking the callable export, allocator or memory required for discriminator-prefixed calldata, and requires each entry's exact statically reachable capability-class set. Interface publication is optional for backward compatibility: exact legacy 104/106 lifecycle frames remain interface-absent, while the new frames publish a receipt-rooted interface leaf. Once a program publishes an interface, a later legacy upgrade is refused so its code cannot drift from that leaf. Programs without a leaf may establish one only through an explicitly breaking new-frame upgrade. An existing interface can be removed only by the unambiguous new upgrade frame with zero interface length and the breaking bit; validation authenticates the prior leaf and the same journaled transition deletes it. Same-ABI widening is admitted; narrowing and cross-ABI change require the breaking declaration."
assumption = "DEPLOY and UPGRADE accept exact legacy interface-absent frames for replay compatibility and new canonical interface-bearing frames for publication; no guessed activation constant or replay-only mode is introduced. Static source tracing shows daemon replay_execute_activity calls lxp_kernel_execute_activity and therefore the same repaired Programs decoder; the source vector exercises real module dispatch without fake fee callbacks. Human qualification must replay signed historical 104/106 activities through the full production daemon and real fee path, freeze both payload families and every schema/capability/state-leaf digest; execute allocator, memory, import-underdeclaration and drift refusals; construct real receipt inclusion and Programs state membership proofs; and exercise interface-absent, legacy-to-breaking, same-ABI compatible, cross-ABI refused and declared-breaking upgrades. No build, test, receipt verification or runtime result is asserted by this implementation-phase source change."
severity = "qualification-required"

[observation.33.1.2]
task = "33.1"
file = "programs/crates/layerx-programs-runtime/src/validate.rs, programs/crates/layerx-programs-registry/src/interface.rs, programs/crates/layerx-programs-runtime/src/ffi_interface.rs"
symbol = "ValidatedModule::required_interface_capability_mask, ValidatedModule::interface_capability_mask_matches"
observed = "Interface capability classes are derived per exported entry from its transitive direct-call graph rather than from every module import. A reachable direct or tail call accumulates only the imported host classes it can reach; a reachable indirect or tail-indirect call conservatively accumulates every capability-bearing import because the table target is not statically proven. Publication requires exact class-mask equality, so a statically known entry can neither omit a reachable class nor claim an irrelevant class. Scoped storage selectors and capability principals, assets, recipients, seeds, limits and receipt digests remain runtime-derived values that static Wasm reachability cannot infer; their exact declared values continue to be enforced by the existing invocation capability set. Source vectors retain disjoint exports, a transitive call, irrelevant overclaim refusal and reachable indirect-call fallback."
assumption = "Human qualification must execute those vectors against parsed Wasm modules, include recursive and shared helper graphs and table mutation, and prove invocation rejects a runtime scoped value outside the exact published capability even when its class is valid. No build, test, parser execution or invocation result is asserted by this implementation-phase source work."
severity = "qualification-required"

[observation.33.4.1]
task = "33.4"
file = "programs/crates/layerx-programs-interpreter, programs/Cargo.toml, programs/Cargo.lock"
symbol = "layerx_programs_interpreter::Interpreter, layerx_programs_interpreter::Instruction"
observed = "The interpreter is an ordinary no-std ABI-v2 program whose complete LXSI v1 byte stream is validated before effects. Its closed instruction set uses a fixed 16-register ceiling, checked signed-i64 arithmetic and comparison, length-delimited positive repeat bodies with statically expanded step and nesting ceilings, principal-scoped storage containing exact big-endian i64 values, and the SDK transfer_402 request that can only consume an invocation grant. It contains no allocator, balance mutation, shared namespace, call, clock, entropy or authority construction surface. Checked-in machine-consumed vectors now freeze exact effects and steps across every opcode, the accepted depth-four boundary, structural excess, arithmetic overflow, divide-zero, signed MIN/-1, invalid transfer amount, and a late overflow after both a real storage write and transfer have been staged. The independent oracle decodes fixed numeric opcode literals into its own mathematical state without implementing or impersonating a host. A phony conformance target builds the actual guest and executes those same bytes through ABI-v2 validation, the production candidate runtime, real Storage transaction and production fail-closed UnavailableReceiptOracle, checking the production-published step response, exact storage/transfers and atomic rollback of the staged write and transfer. The declared task touch set is expanded from one source file to include the real crate, workspace/lock, deploy/interface descriptors, vectors, runtime integration source and automation required to ship it."
assumption = "Human qualification must run programs-interpreter-conformance, independently inspect the emitted ABI-v2 imports/exports, differential-run the frozen vectors across supported execution tiers and operating targets, and investigate any divergence without weakening either oracle. No build, test, formatter, runtime execution, differential result or passing claim is made by this implementation-phase source work."
severity = "qualification-required"

[observation.33.4.2]
task = "33.4"
file = "programs/Cargo.lock"
symbol = "cg spec implemented touch graph"
observed = "Git records the interpreter package entry in programs/Cargo.lock, but cg sync reports the lockfile among skipped paths and cg spec implemented cannot observe its declared touch even after a successful incremental graph sync. Every indexed task symbol and every other declared touch passed the graph check."
assumption = "Codify 0.6.0 does not support a force option for the implemented transition, so the authoritative spec status is advanced directly only after cg accepted both declared symbols and every indexed touch and the unindexable lockfile diff was inspected separately. Human qualification must use the checked-in lockfile through the declared --locked build and test commands; no dependency resolution, build or test was run in this implementation phase."
severity = "phase-boundary"
