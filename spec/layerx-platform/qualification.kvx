symbol = "read_protected_source, ProtocolEvidenceVerifier::load, authority_source_rejects_leaf_and_ancestor_symlinks, authority_source_rejects_permissive_and_non_regular_inputs"
observed = "The sequencer registry was read with fs::read after only lexical path normalization, so link substitution, non-regular inputs, foreign ownership and permissive modes were not refused at the trust boundary. Startup configuration and sequencer authority sources now require the configured absolute path to equal its canonical path, a regular file owned by the effective process user, no group or world permission bits, and identical device, inode, ownership, mode, link count, size and timestamps before and after the bounded read. Source regressions cover leaf symlink, ancestor symlink, group-readable and directory inputs. The policy_sources and signer_configurations paths are parsed into StartupConfig but no production source loader or signer construction consumes them anywhere under layerx-agentd, so there is no real read boundary to harden without inventing one."
assumption = "Qualification must exercise owner mismatch, concurrent replacement, truncation and growth, protected configuration overrides, and real operator-owned authority rotation. The daemon owner must add the same protected read contract at the eventual tenant policy and signer configuration loaders, and must wire those loaders into startup before either path can be treated as an active protected trust input. No build or passing result is asserted."
severity = "post-implementation-repair"

[observation.15.2.11]
task = "15.2"
file = "agent/crates/layerx-agentd/src/protocol_evidence.rs, agent/crates/layerx-agentd/tests/protocol_evidence.rs, agent/crates/layerx-agentd/tests/support/mod.rs"
symbol = "ProtocolEvidenceVerifier::authorization_for, revocation_handover_selects_only_the_key_active_at_each_batch"
observed = "Authority policy construction admitted a replacement key beginning at the old key's inclusive revocation batch because their active intervals did not overlap, but authorization selected candidates from the untrimmed configured ranges and returned AmbiguousAuthorization at that valid handover. Candidate selection now excludes entries at or after their revocation batch and passes only the effective active range into canonical inclusion verification. When no active entry exists, identity, epoch, full configured range and revocation observations retain distinct UnknownSequencer, Epoch, BatchRange and Revoked refusals. A signed-state source regression uses one stable sequencer identity with an old key valid through K-1 and a new key beginning at K, accepting each active key and rejecting an old-key signature at K."
assumption = "Qualification must replay the same handover with real signed receipt and state paths, reconnect handshakes on both sides of K, multiple epochs and identities, revoked-at-genesis records, sparse non-overlapping ranges, malformed overlapping policy, and old-key evidence after K. No build or passing result is asserted."
severity = "post-implementation-repair"

[observation.10.4.1]
task = "10.4"
file = "agent/crates/layerx-agentd/src/capability/consume.rs, agent/crates/layerx-agentd/src/outbox/recover.rs, agent/crates/layerx-agentd/tests/ceiling.rs, agent/crates/layerx-agentd/tests/recovery.rs, agent/crates/layerx-agentd/tests/unknown.rs"
symbol = "Ceiling::new, Ceiling::rebuild, State::protocol_reconciliation, reserve"
observed = "Fresh and receipt-rebuilt capability ceilings set reconciled=true even though the canonical protocol budget state schema is explicitly unavailable, and reserve treated that boolean as write authority. The state now carries an optional opaque ReconciliationState rather than caller-independent boolean authority; fresh and receipt-only rebuild paths hold None, their snapshots report unreconciled, and every new reservation fails with Unreconciled. Verified receipts may rebuild a non-authoritative consumption cache and retain identity/replay checks but cannot establish admission. Restart refuses to re-hold unknown ceiling reservations without protocol reconciliation. The reported duplicated ceiling parameter was not present in this worktree's consume signature, and no duplicate was introduced."
assumption = "There is intentionally no positive capability-ceiling admission path until core defines and produces a canonical budget key/value proof that can issue identity-bound ReconciliationState. Qualification must later bind that state to the exact tenant, capability, asset, ceiling and protocol window before installing it, then restore concurrency, unknown-hold, expiry and receipt-settlement coverage. No build or passing result is asserted."
severity = "missing-canonical-producer"

[observation.31.2.1]
task = "31.2"
file = "src/modules/programs/accounts.c, src/modules/programs/call.c, programs/crates/layerx-programs-runtime/src/ffi_call.rs"
symbol = "lxp_programs_value_account_read, layerx_programs_call_balance_view_begin, CReceiptOracle::verified_balance"
observed = "The canonical Core producer available to Programs can prove a current balance only for a registered ABI-two program value account: it binds the account and asset, account-registry proof, Programs binding proof, receipt digest, observed sequence and resulting state root. The BalanceView ingress uses exactly that producer. Core exposes no equivalent proof producer here for arbitrary principal accounts or unregistered accounts, so those sight grants return typed absent or evidence-unavailable results instead of reading raw kernel state or inventing a verified balance."
assumption = "If Programs must observe balances outside registered program value accounts, a later protocol task must add a canonical Core account-and-asset proof producer with the same receipt/state-root binding. Qualification must exercise zero balance, missing account, wrong asset, stale receipt, proof mismatch, sight denial, grant-count bounds, per-read metering and the absence of transfer authority."
severity = "dependency-boundary"

[observation.30.7.1]
task = "30.7"
file = "programs/sdk/rust/examples/escrow/src/lib.rs, programs/sdk/rust/src/receipt.rs"
symbol = "escrow::settle, Receipt"
observed = "The frozen verified receipt view exposes digest, result code, asset, amount and state root but no activity kind, module, payer, beneficiary or effect identity. The escrow therefore implements the strongest honest predicate currently representable: distinct predeclared release and refund digests, successful result, and exact escrow asset and amount. It does not infer business semantics from a digest label or claim that an arbitrary richer oracle condition was proved. A richer escrow condition must fail closed until the verified receipt ABI carries its canonical subject and effect identity."
assumption = "Human qualification must exercise distinct and identical condition digests, failed results, wrong asset, wrong amount, replay after settlement, release/refund races and malformed stored records. Product documentation must describe this reference as successful-settlement-receipt escrow unless a later ABI task adds and verifies richer canonical condition facts. No build, deployment, call or passing result is asserted."
severity = "abi-evidence-boundary"

[observation.30.7.2]
task = "30.7"
file = "programs/sdk/rust/examples/escrow, programs/sdk/rust/examples/vault, platform/cli/src/programs.rs, platform/hosted"
symbol = "reference custody source verification and end-to-end qualification"
observed = "The repository now contains complete Rust escrow and vault program sources, deterministic manifests and source-verifiable build inputs, but the current public CLI capability vocabulary cannot encode the exact ProgramSpend owner, seed, source, asset, destination and ceiling grant required by these calls, and the hosted deployment/call producer path is not currently an authenticated positive qualification route. The implementation phase therefore cannot honestly add a script that claims to deploy, source-verify and exercise custody end to end without inventing authority or evidence."
assumption = "Qualification must use an owner-published authenticated activity producer that can encode exact candidate-ABI ProgramSpend grants, register both derived MODULE_VALUE accounts, deploy both artifacts, verify their published sources against reproduced code hashes, fund and settle escrow release/refund and multi-participant vault deposit/withdraw calls, and verify receipts plus state and balances from protocol proofs. Until that route exists, task 30.7 is implemented source, not qualified or done."
severity = "missing-qualification-producer"

[observation.37.1.12]
task = "37.1"
file = "paxeer-network/rpc"
symbol = "Backend, InfoAPI, SubscriptionAPI, TransactionAPI, DebugAPI, WatermarkManager"
observed = "Post-implementation review found production RPC paths fabricated current headers and historical gas limits when canonical consensus data was unavailable, emitted Autobahn new-head envelopes with zero parent, transaction and receipt roots, exposed node-local test-keyring signing by default, truncated receipt heights and timestamps, trusted partial validator pages and nil consensus responses, swallowed trace serialization and policy lookup failures, silently omitted EVM or Wasm transactions and rewards when receipts were unavailable, used unbounded or cancellation-blind retry and subscription paths, and could partially register configured RPC modules. The repair requires canonical blocks, parameters, validators, receipts and roots, refuses incomplete Autobahn heads and partial block or receipt arrays, makes local-key RPC explicitly opt-in and forbidden on recognized live chains, checks signed and aggregate arithmetic, propagates retrieval and serialization errors, supplies an explicit error-returning non-database boundary for go-ethereum compatibility, bounds current-header lookup and subscription state, and fails server construction or module registration atomically when required dependencies are absent."
assumption = "Human qualification must compile and exercise HTTP, WebSocket, simulation and debug RPC against both Tendermint and Autobahn paths; verify the unsafe keyring gate on local and live chain IDs; inject missing, nil, partial, pruned, corrupt, overflow and cancellation cases; prove no partial block, receipt, fee-history or trace response is emitted; and prove newHeads resumes only after the Autobahn producer supplies canonical parent, transaction and receipt roots. Paxeer has no Ethereum chain database, so bad-block database operations must return the declared unsupported error, and CurrentHeader can return nil before any canonical header has been cached after its bounded consensus lookup fails. No build, test, format, RPC process or passing result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.37.1.13]
task = "37.1"
file = "paxeer-network/scripts/initialize_local_chain.sh, paxeer-network/loadtest/scripts/populate_genesis_accounts.py"
symbol = "local chain reset and genesis-account population"
observed = "Post-implementation review found the local-chain initializer unconditionally recursively deleted the default node home, accepted unquoted override paths, ignored its selected Python interpreter, and let its account helper invoke a fixed binary and home through shell command strings. The repair requires an explicit PAX_LOCAL_RESET=1 gate, resolves and confines the target below HOME, uses a selected executable and home consistently, removes shell command construction, quotes configuration paths, validates installation output, and performs grouped genesis rewrites through checked temporary files."
assumption = "Human qualification must run the initializer only in a disposable home; prove unset authorization, HOME itself, parent traversal, missing Python, missing paxd and paths containing spaces are refused safely; then initialize with default and overridden homes and compare the resulting genesis and generated accounts. The script remains intentionally destructive after the explicit local-reset gate and still invokes make install, so it must not be used against a production node home. No shell execution, install, chain start or generated-genesis result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.37.1.22]
task = "37.1"
file = "paxeer-network/storage/state_db/sc/migration/router_kvstore.go, paxeer-network/storage/state_db/sc/migration/router_kvstore_test.go"
symbol = "RouterCommitKVStore.RootHash"
observed = "Post-implementation review found the migration router adapter returned a freshly allocated all-zero 32-byte value from RootHash even though the Router abstraction exposes no authenticated store-root capability. A caller could mistake that fabricated digest for a canonical state commitment. The deprecated CommitKVStore contract already permits unsupported root access to panic, so the adapter now fails closed with the exact store name instead of manufacturing evidence. Composite app-hash construction continues to obtain its real lattice and memiavl commitments directly from their owning backends, not from this adapter."
assumption = "Human qualification must exercise legacy callers of GetChildStoreByName across every migration mode, prove none rely on the removed zero digest, and confirm WorkingCommitInfo and LastCommitInfo still contain the exact backend-owned roots. No storage build, migration replay, test or passing result is asserted by this source repair."
[observation.37.1.15]
task = "37.1"
file = "paxeer-network/wasm/x/wasm/ioutils/utils.go, paxeer-network/wasm/x/wasm/keeper/ante.go, paxeer-network/wasm/x/wasm/ibc.go"
symbol = "IsWasm, IsGzip, CountTXDecorator, IBCHandler"
observed = "Post-implementation review found truncated upload payloads could panic the CLI and legacy REST upload paths during fixed-width magic-byte inspection, malformed persisted transaction counters could panic consensus ante processing while an exhausted counter silently wrapped, and CosmWasm IBC callbacks indexed caller or stored connection-hop lists without locally enforcing the single valid hop required by this IBC version. The repair makes signature inspection length-safe, rejects malformed and exhausted counters before mutation, validates callback hop cardinality and identifiers, and validates stored channel state before constructing contract callback messages. Vendored libwasmvm unsafe FFI and architecture-specific native artifacts remain inherited boundaries rather than newly asserted safe implementations."
assumption = "Human qualification must compile the Paxeer WASM modules with the declared native libwasmvm artifacts, run upload, ante and IBC callback regressions, inject malformed persisted counter bytes and channel records, and exercise empty, truncated and oversized upload payloads without a process panic. Native FFI sanitizer, race, cross-architecture and state-sync replay remain required environment-owned gates; no build, test, format or runtime result is asserted by this source repair."
severity = "consensus-safety"

[observation.37.1.16]
task = "37.1"
file = "paxeer-network/precompiles/ibc/ibc.go, paxeer-network/precompiles/json/json.go, paxeer-network/precompiles/solo/solo.go"
symbol = "getChannelConnection, GetAdjustedHeight, GetAdjustedTimestamp, ExtractAsUint256, sigverify"
observed = "Post-implementation review found that the IBC precompile indexed an unvalidated connection-hop list, fabricated a default timeout from block time when the referenced client consensus state was absent, and allowed height or timestamp arithmetic to wrap. The JSON uint256 extractor accepted negative decimal input, whose magnitude could then be encoded as an unsigned result, and Solo claim replay protection ignored sequence-update errors and wrapped an exhausted uint64 sequence to zero. The repair rejects malformed channel state and absent consensus state, checks every default-timeout addition, rejects negative uint256 values, and advances claim sequences only through a successful non-wrapping account update. The inherited IBC module implementation was otherwise left unchanged."
assumption = "Human qualification must run the current and supported-version IBC, JSON and Solo precompile suites, inject empty and multi-hop channel state, missing consensus state, arithmetic boundaries, negative decimal JSON values, and a maximum account sequence, and prove each call reverts without state or event leakage. No build, test, format or runtime result is asserted by this source repair."
severity = "consensus-safety"

[observation.37.1.17]
task = "37.1"
file = "paxeer-network/consensus/autobahn/types/commit_qc.go, paxeer-network/consensus/autobahn/types/lane_qc.go, paxeer-network/consensus/autobahn/types/prepare_qc.go, paxeer-network/consensus/internal/autobahn/consensus/inner.go, paxeer-network/consensus/internal/autobahn/data/state.go, paxeer-network/consensus/internal/autobahn/producer/mempool.go, paxeer-network/consensus/internal/autobahn/producer/state.go, paxeer-network/consensus/internal/p2p/giga/data.go, paxeer-network/consensus/internal/p2p/giga_router.go, paxeer-network/consensus/config/autobahn.go"
symbol = "FullCommitQC.Verify, LaneQC.Verify, PrepareQC.Verify, State.PushQC, clientStreamFullCommitQCs, producer.State.Run"
observed = "Post-implementation source review found peer-controlled proposal and certificate coordinates were consulted by wait paths before authentication, the full-commit synchronization stream accepted duplicate or non-progressing certificates, reconstructed finalized headers were hash-linked but not bound to their signed lane and block-number positions, uint64 global heights were silently clamped into the application's signed height domain, producer rate and nonce arithmetic could overflow, an outbound validator handshake had no deadline, and an internal payload-construction failure panicked the process. The repair authenticates structural consensus evidence before waiting, requires each streamed certificate to cover and advance the exact expected block, validates every reconstructed header position, rejects certificates and RPC requests outside the executable int64 height domain, bounds producer arithmetic and EVM nonce exhaustion, applies the configured P2P handshake deadline, and propagates payload construction failure through structured concurrency."
assumption = "Human qualification must run Autobahn type, consensus, availability, data-WAL, producer, Giga RPC and router suites; stream invalid, duplicate, overlapping and out-of-order certificates; reconstruct wrong-lane and wrong-height header chains; hold validator handshakes open; and exercise maximum configured rates, int64 boundary heights and EVM nonces. PersistentStateDir is still optional even though the consensus source documents restart without it as slashable and the node setup suite explicitly expects that production config to be accepted; changing that operator contract requires a separate owner decision. Autobahn block-by-hash remains limited to the retained in-memory/WAL window because no production BlockDB writer exists. No build, test, formatting, network or passing result is asserted by this source review."
severity = "consensus-safety"

[observation.37.1.18]
task = "37.1"
file = "paxeer-network/sdk/crypto/keys/multisig/multisig.go, paxeer-network/sdk/storev2/commitment/store.go, paxeer-network/sdk/storev2/rootmulti/store.go, paxeer-network/sdk/store/rootmulti/store.go"
symbol = "LegacyAminoPubKey.VerifySignature, commitment.Store.GetWorkingHash, rootmulti.Store.SetKVStores, rootmulti.Store.SetTracer, rootmulti.Store.SetTracingContext"
observed = "Post-implementation review found the legacy multisignature public-key compatibility method terminated the process when handed raw signature bytes even though its boolean result can represent the unsupported encoding, the store-v2 child commitment wrapper panicked when asked for a working hash even though its error result can express that only the root multistore owns the composite commitment, and both root multistore generations left their generalized KV wrapper method unimplemented. Store-v2 tracing setters also returned nil and could erase a live multistore from a generic configuration path. The repair rejects unstructured multisignature bytes, returns a stable unavailable error from the child commitment wrapper, composes generalized wrappers through a real cache multistore, and preserves the live store when unsupported tracing configuration is requested. Canonical working app hashes remain calculated only after the root multistore flushes every named change set."
assumption = "Human qualification must compile and run multisignature, store-v2 commitment, root multistore, scheduler and tracing regressions; prove raw multisignature verification returns false without a panic, structured multisignature verification still follows VerifyMultisignature, wrapper handlers receive every mounted store, trace setup cannot replace the commit store with nil, and child stores cannot be mistaken for owners of the composite app hash. The deprecated storage CommitKVStore RootHash contract still cannot report an unavailable capability as an error; routed flatKV views therefore retain the separately recorded explicit fail-closed compatibility boundary. No build, test, format or runtime result is asserted by this source repair."
severity = "post-implementation-repair"

[observation.37.1.19]
task = "37.1"
file = "paxeer-network/consensus/internal/state/indexer/query_range.go, paxeer-network/consensus/internal/state/indexer/block/kv/kv.go, paxeer-network/consensus/internal/state/indexer/tx/kv/kv.go"
symbol = "QueryRange.LowerBoundValue, QueryRange.UpperBoundValue, BlockerIndexer.matchRange, TxIndex.matchRange"
observed = "Post-implementation review found remotely supplied range conditions could reach process panics when the query parser produced a non-numeric bound, and exclusive bounds at the int64 limits wrapped into the opposite end of the index. The transaction index also panicked on range-iterator construction or traversal failures. The repair makes bound normalization error-returning, accepts only numeric and time values, rejects exclusive-bound overflow and underflow, and propagates bound and database failures through both block and transaction Search results without clamping or returning a fabricated empty match."
assumption = "Human qualification must run block and transaction index searches with inclusive and exclusive integer and time bounds, string range operands, int64 extrema, corrupted iterator state and cancelled contexts, and prove malformed remote queries return errors without process termination or false matches. No build, test, format or runtime result is asserted by this source repair."
severity = "consensus-safety"

[observation.37.1.20]
task = "37.1"
file = "paxeer-network/sdk/store/multiversion/mvkv.go, paxeer-network/sdk/store/cachemulti/store.go, paxeer-network/sdk/store/rootmulti/store.go, paxeer-network/sdk/storev2/rootmulti/store.go"
symbol = "VersionIndexedStore.Write, VersionIndexedStore.GetWorkingHash, cachemulti.Store.CacheMultiStoreForExport, cachemulti.Store.GetEarliestVersion, cachemulti.Store.GetWorkingHash"
observed = "Post-implementation review found the scheduler's version-indexed cache implemented its CacheWrap publication and event-shaped compatibility methods with process panics, while cached multistores panicked on export, earliest-version and working-hash queries. The repair publishes a versioned transaction's tracked read, write and iterator sets exactly once, removes event methods that are not part of any implemented store contract, propagates the root store's real earliest retained version through every nested cache, and returns stable unavailable errors for root-only export and working-hash capabilities. Scheduler publication remains idempotent when both CacheWrap.Write and the scheduler's explicit publish boundary are reached."
assumption = "Human qualification must run OCC scheduler retries, aborts, nested message caches, iterator conflicts and repeated Write calls; verify one publication per incarnation; exercise old and store-v2 nested caches across pruning and historical export; and prove only root multistores produce working hashes or historical export views. VersionIndexedStore.CacheWrap and CacheWrapWithTrace remain explicit unsupported invariants because the scheduler installs the version store beneath a newly created cachekv branch and no production caller recursively wraps it directly; qualification must preserve that topology. No build, test, format or runtime result is asserted by this source repair."
severity = "consensus-safety"

[observation.37.1.21]
task = "37.1"
