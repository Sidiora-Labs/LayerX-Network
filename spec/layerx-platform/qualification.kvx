[observation.18.2.1]
task = "18.2"
file = "platform/hosted/gateway/src/lib.rs, platform/emulator/src/main.rs"
symbol = "production_route, program_call"
observed = "The hosted gateway admits only activities, state and receipt reads and has neither /v1/programs/deploy nor /v1/programs/call. The standalone emulator has a real-transition /v1/programs/call route, but it accepts a pre-encoded canonical activity rather than the structured client request and has no deployment/registry route. The reference marketplace therefore contains the real deterministic program, declared deployment/call commands and receipt verification, but correctly reports the missing hosted route as Unknown instead of pretending a deployment succeeded."
