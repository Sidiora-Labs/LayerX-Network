file = "agent/crates/layerx-types/src/intent.rs, platform/cli/src/programs.rs, platform/examples/marketplace/program/src/lib.rs"
symbol = "CapabilityRequest, programs::call, marketplace"
observed = "The genuine marketplace needs program-shared storage, one exact receipt-read grant and one asset/recipient/amount-bounded transfer grant. The current interaction-layer ProgramCall request exposes only caller-scoped storage-read/write plus broad transfer, event and compose requests; it cannot encode SharedStorageRead, SharedStorageWrite, ReceiptRead(digest), or Transfer402(asset,to,ceiling). The reference program uses the runtime's exact capabilities and the client sends only the currently declared high-level requests, so list/buy will fail closed until the hosted call contract can bind those exact grants."
assumption = "The hosted program-call work will add a versioned, canonical way to request the exact shared-storage, receipt and bounded-transfer grants without weakening the runtime capability model; qualification must refuse the marketplace release if the interaction surface still cannot express them."
severity = "dependency-boundary"

