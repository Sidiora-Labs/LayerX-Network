[observation.15.2.3]
task = "15.2"
file = "agent/crates/layerx-agentd/src/config.rs, agent/crates/layerx-agentd/src/boot.rs, agent/crates/layerx-agentd/src/protocol_evidence.rs, agent/crates/layerx-agentd/src/budget, agent/crates/layerx-agentd/src/capability/consume.rs, agent/crates/layerx-agentd/src/outbox"
symbol = "Gate::new, Gate::evidence_authority, EvidenceAuthority, RawReceiptEvidence, RawStateEvidence"
observed = "Post-implementation review found that raw Agent evidence carried a caller-constructed SequencerAuthorization, allowing an untrusted boundary to generate a key, sign its own header and receipt, and obtain an opaque Verified token. The repair removes all authority from raw ingress; makes verifier and key-range construction crate-private; loads the exact protocol version, network, sequencer identity, key, epoch, nonzero inclusive batch range and revocation point from a mandatory versioned startup authority source; rejects overlapping active sequencer ranges; and exposes mutation authority only after a real framed current handshake advertises a non-revoked configured key for its sealed batch. Receipt verification independently derives the current producer's execution batch identifier from the signed header's previous_state_root and batch_number plus the included receipt's activity_id and global_sequence, rather than copying the receipt's own batch_id; the full canonical header digest, signature and receipt Merkle inclusion remain separately verified."
assumption = "Human qualification must provision the sequencer authority source from independently administered core authority state, exercise source replacement and malformed input, attacker policy substitution, cross-network and cross-protocol headers, epoch rotation, revocation and boundary batches, and prove budget, capability and outbox mutations receive only boot-issued EvidenceAuthority. The source regressions use canonical handshake, header, signature and Merkle types; no build or passing result is asserted."
severity = "post-implementation-repair"

[observation.15.2.4]
task = "15.2"
file = "spec/layerx-protocol/docs/checkpointing.md, spec/layerx-protocol/docs/wire-format.md, cmd/layerxd/lxp_daemon_process.c, src/sequencer/lxp_batch_seal.c, src/protocol/lxp_receipt.c"
symbol = "batch_id, execution.batch_id, receipt_merkle_root, lxp_receipt_build"
observed = "The canonical documents use batch_id for the digest of the complete sealed batch header, while the current C producer places a distinct pre-seal execution identifier in receipt.batch_id: ContextHash(previous_state_root || activity_id || global_sequence_be || batch_number_be). The signed full-header digest remains separate evidence and its receipt_merkle_root commits the resulting canonical receipt bytes. The Agent verifier follows that executable non-circular producer contract by recomputing the receipt execution identifier with the batch_number and previous_state_root from the independently verified signed header, while continuing to verify the full header digest, signature and receipt inclusion separately."
assumption = "The protocol owner must define a versioned wire rename or migration that distinguishes receipt execution_batch_id from sealed batch_header_id, update the canonical documents and producers together, regenerate real receipt inclusion fixtures, and qualify the complete core-to-Agent path. Until then, verifier and producer deliberately follow the current C bytes rather than the ambiguous document name."
severity = "spec-implementation-discrepancy"

[observation.15.2.5]
task = "15.2"
file = "include/layerx/lx_budget.h, src/modules/budget/lx_budget_create.c, src/modules/budget/lx_budget_spend.c, src/state/lxp_state_root.c, agent/crates/layerx-agentd/src/budget/reconcile.rs, agent/crates/layerx-agentd/src/budget/hold.rs, human/crates/layerx-human-service/src/agents/spend.rs"
symbol = "lx_budget_record, lx_budget_state_put, module_execute, lxp_state_subtree_root, ProtocolBudgetState, SpendReconciliation"
observed = "Post-implementation review found no canonical core budget-state record or proof producer. lx_budget_state_put copies lx_budget_record into the process-local lx_budget_store only; Budget module execution emits the submitted payload as an event and never stages a kernel module KV/blob write; the module subtree root contains only kernel module KV/blob entries. No exact budget key, canonical value encoding, agent/account/asset binding, or two-level Budget-module/root proof schema exists. The Agent decoder's 52-byte LXBS value was test-invented and accepted any included leaf as budget authority. LXBS and the decoder are removed. Agent reconciliation authenticates receipt identities and candidate state inclusion but returns ProtocolStateSchemaUnavailable without mutating local accounting; restart exposes protocol_consumed=None and blocks writes; the Human spend surface no longer accepts caller-supplied verification levels, digests, receipt authorities, or budget facts and returns ProtocolBudgetStateUnavailable. Existing approval/render qualification fixtures which expected the invented budget state now remain in conflict with this blocker rather than minting replacement authority."
assumption = "The protocol owner must first define and version a canonical Budget module record encoding and deterministic key bound at minimum to budget_id, owner/agent account and asset; make real Budget execution stage that record into kernel state; expose exact subtree and outer-root proofs with signed-head freshness; and add an opaque daemon-produced read contract. Human qualification must then replace the blocked spend and approval fixtures with evidence from that real producer."
severity = "missing-protocol-integration"

[observation.15.2.6]
task = "15.2"
file = "agent/crates/layerx-agentd/src/protocol_evidence.rs, agent/crates/layerx-agentd/src/budget/reconcile.rs, agent/crates/layerx-agentd/src/budget/hold.rs, agent/crates/layerx-agentd/src/capability/consume.rs, agent/crates/layerx-agentd/src/outbox/recover.rs"
symbol = "ReceiptReplayGuard, SpendReceiptEvidence, PersistedReceipt, ReceiptApplication, Reservation, Ceiling::rebuild, Ceiling::apply_receipt"
observed = "Receipt aggregation and ceiling recovery previously counted the same canonical receipt more than once and did not reject two distinct receipts naming one activity. ReceiptApplication also let a receipt for one activity release an unrelated reservation, and rebuild could count two activities against one reservation identifier. The repair centralizes canonical receipt-reference and verified activity-id uniqueness in an opaque verifier-owned replay guard, persists the exact expected activity identity with reservations and recovery inputs, gives both reservation and activity identities one-to-one ceiling admission, checks the verified receipt against that identity before mutation, and retains replay history across ceiling rebuild so an old receipt cannot settle a new reservation."
assumption = "Human qualification must exercise replay after restart with persisted daemon records, concurrent application of the same receipt, distinct canonical receipts naming one activity, cross-reservation application, failed-receipt release, and crash points around replay-guard persistence. The source regressions use configured signed headers and canonical receipt inclusion; no build or passing result is asserted."
severity = "post-implementation-repair"

[observation.15.2.7]
task = "15.2"
file = "agent/crates/layerx-agentd/src/budget/reconcile.rs, agent/crates/layerx-agentd/src/policy/eval.rs, agent/tools/policy-harness/src/main.rs, human/crates/layerx-human-service/src/agents/spend.rs"
symbol = "ReconciliationState, EvaluationInput, BudgetContext, AgentSpendView, SpendReconciliation"
observed = "Post-repair review found that external callers could still construct ReconciliationState by public field literal and pass any chosen remaining amount into public policy EvaluationInput; valid_context trusted that caller-authored figure. ReconciliationState fields are now private with read-only accessors and no public constructor, EvaluationInput holds a private budget context which is either an opaque reconciliation result or explicitly unavailable, and unavailable budget context deterministically denies before policy matching. Because canonical budget state remains unavailable, no verified context can currently be issued. Human spend output fields are likewise privately constructed by the blocked service and only readable after service issuance; callers cannot assert their own verification level, evidence digests, reconciliation status, or amounts. Receipt verification, activity binding, and replay guards remain prerequisites in the reconciliation path."
assumption = "Positive policy-rule, policy-version, dry-run, adversarial-corpus, approval-render and spend qualification which formerly constructed budget truth is blocked until the real core budget state producer and proof schema exist. Current source regressions assert the unavailable-context denial and preserve corpus inputs without claiming constraint execution. Qualification must later obtain ReconciliationState only through configured daemon verification and then re-establish positive rule and Human rendering coverage from those opaque results."
severity = "post-implementation-repair"

[observation.15.2.8]
task = "15.2"
file = "agent/crates/layerx-agentd/src/protocol_evidence.rs, agent/crates/layerx-agentd/src/main.rs, agent/crates/layerx-agentd/src/read/program_node.rs, agent/crates/layerx-agentd/tests/protocol_evidence.rs"
symbol = "TrustedSequencer::new, active_last_batch, LayerxdProgramBalanceReader::connect, canonical_genesis_batch_zero_is_inside_a_bounded_trusted_range"
observed = "Configured sequencer ranges rejected first or last batch zero even though canonical genesis batch zero is valid. Trusted evidence policy, daemon environment validation and the Programs read adapter now accept bounded ranges beginning and ending at zero and continue to reject only reversed ranges; inclusive revocation at zero still yields no active batch. A signed-header source regression exercises exact configured range [0,0] through the real handshake and state-inclusion verifier. RawReceiptEvidence::canonical_receipt was also inspected for the reported duplicate must_use attribute; this branch contains exactly one such attribute, so removing it would remove the valid annotation rather than a duplicate."
assumption = "Qualification must exercise genesis handshake, signed state and receipt evidence, zero-to-nonzero sequencer rotation, revocation at zero, overlap detection and Programs reads from batch zero against a real node. No build or passing result is asserted."
severity = "post-implementation-repair"

[observation.15.2.9]
task = "15.2"
file = "agent/crates/layerx-agentd/src/policy/eval.rs, agent/crates/layerx-agentd/src/policy/approval.rs, agent/crates/layerx-agentd/src/approval/mod.rs, agent/tests/policy/adversarial.rs"
symbol = "PolicyRequest, EvaluationInput, ReconciliationState::protocol_consumed, maximum_cumulative_count, required_approval, ApprovalRegistry, ApprovalService::approve"
observed = "PolicyRequest exposed caller-authored cumulative_amount, cumulative_count and approval_present, allowing future callers to bypass cumulative and required-approval rules once a budget token became available. Those fields are removed. Cumulative amount is read only from opaque ReconciliationState; cumulative count is a private unavailable daemon fact and therefore makes context invalid until a canonical producer exists; required approval no longer accepts a boolean and cannot permit. The existing approval state machine does bind a granted decision to the exact held canonical digest and tenant-scoped registry record, but there is no production adapter that binds that grant back into policy evaluation with the current tenant, session, capability, activity and exact prepared-intent digest. No digest-as-proof or caller-mintable approval token was added."
assumption = "The daemon owner must wire policy evaluation directly after canonical preparation and issue a private approval context only from ApprovalRegistry and ApprovalService after matching tenant, session, capability, policy version, activity type and exact prepared canonical digest. A canonical protocol-relative usage-count producer must also be defined. Until both exist, positive policy, cumulative-rate and approval-required qualification remains fail closed and the harness reports those dimensions blocked rather than covered."
severity = "missing-daemon-integration"

[observation.15.2.10]
task = "15.2"
