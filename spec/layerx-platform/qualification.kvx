[observation.30.5.7]
task = "30.5"
file = "include/layerx/lxp_ledger.h, include/layerx/lxp_transfer.h, src/ledger/lxp_apply.c, src/ledger/lxp_journal.c, programs/crates/layerx-programs-runtime/src/ffi_transfer.rs"
symbol = "LXP_AUTH_PROGRAM_SPEND, layerx_programs_consume_program_spend_authorization"
observed = "The wind-down exit must let the ordinary 402LXP ledger synchronously consume an unforgeable, one-shot owner-program/frame authorization rather than accept a C-asserted OWNER value. The implementation names that transient consumption marker LXP_AUTH_PROGRAM_SPEND and binds it to the exact source, destination, asset, amount, seed-derived owner frame and transfer-set root. Requirement 30.1 and task 30.3 also say that Programs adds no new authority kind, even though an ordinary OWNER marker cannot encode or consume this program-frame witness. The marker creates no balance primitive and direct single-leg application refuses it, but it is a new closed enum value."
assumption = "Protocol qualification must resolve whether 'no new authority kind' prohibits even a transient ledger-consumed representation of the already specified ProgramAuthority. Until a versioned alternative is defined, qualification must retain one-shot exact witness consumption and must not replace it with fabricated OWNER authority or a parallel balance route."
severity = "spec-conflict"

