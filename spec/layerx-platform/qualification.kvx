symbol = "LayerXMirrorArchive, layerx-solana-mirror-program, mirror-live-qualification"
observed = "A 64 MiB archive cannot be an atomic Ethereum or Solana transaction. Both mirror protocols are implemented as immutable resumable manifest, ordered chunk and finalize stages with an expected rolling chunk commitment; the publisher persists each signed transaction before broadcast and verifies canonical retrieval after finality. The protected workflow and deployment manifests require real node, RPC, signer and testnet inputs, but implementation-phase rules prohibited compiling contracts/clients, deploying, broadcasting, running the workflow or observing chain state."
assumption = "Human qualification will compile and review both on-chain programs, pin their deployment artifacts and code identities, then run the protected live journey through stalls, restarts, ambiguous broadcasts and reorgs. A code-writing status must not be read as a claim that any contract is deployed or any live transaction succeeded."
severity = "qualification-input"

