[observation.30.3.4]
task = "30.3"
file = "src/modules/programs/accounts.c, src/modules/programs/deploy.c"
symbol = "registration_authorized, lxp_programs_account_owner_bind"
observed = "An immutable program deployed before ABI two has no owner principal in its frozen 71-byte registry record, so no state fact can authenticate a later principal as its deployer. The ABI two registration path refuses such an account admission instead of permitting first-caller asset squatting. Legacy authority-governed programs remain admissible through the authority already committed in their record, and all programs deployed under ABI two commit an owner record."
assumption = "If pre-ABI-two immutable programs must acquire derived value accounts, the protocol owner must define a receipt-proven migration or a separately versioned owner-adoption law. Qualification must confirm the current path fails closed and must not invent an owner from unauthenticated input."
severity = "migration-boundary"

