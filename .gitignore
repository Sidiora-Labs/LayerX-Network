# Native and Solidity build outputs
/build/
/build-*/
/out/
/cache/
/broadcast/
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.gcda
*.gcno
# Vendored wasmvm shared libraries ship with the module sources
!/wasm-runtime/internal/api/libwasmvm.*.so
!/wasm-runtime/internal/api/libwasmvm.dylib
!/wasm/x/wasm/artifacts/v152/api/libwasmvm152.*.so
!/wasm/x/wasm/artifacts/v152/api/libwasmvm152.dylib
!/wasm/x/wasm/artifacts/v155/api/libwasmvm155.*.so
!/wasm/x/wasm/artifacts/v155/api/libwasmvm155.dylib
# Vendored wasmvm static archives back the muslc and darwin-static link directives
!/wasm-runtime/internal/api/libwasmvm_muslc*.a
!/wasm-runtime/internal/api/libwasmvmstatic_darwin.a
!/wasm/x/wasm/artifacts/v152/api/libwasmvm152_muslc*.a
!/wasm/x/wasm/artifacts/v152/api/libwasmvm152static_darwin.a
!/wasm/x/wasm/artifacts/v155/api/libwasmvm155_muslc*.a
!/wasm/x/wasm/artifacts/v155/api/libwasmvm155static_darwin.a
