#!/usr/bin/env bash

# LayerX workspace dashboard. This file intentionally uses only Bash and
# standard host utilities so it can run before project dependencies exist.
#
# Rendering model
#   Every screen is composed into FRAME (an array of finished lines) and then
#   flushed with flush_frame, which rewrites only the rows that actually
#   changed. Nothing ever clears the whole screen except a genuine resize, so
#   repaints are flicker free even at ten frames a second during a run.
#
# Hit testing
#   Interactive elements register their own row and column span while they are
#   drawn, so mouse targets can never drift out of sync with the layout.

set -u

