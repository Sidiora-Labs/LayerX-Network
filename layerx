# --------------------------------------------------------------------------
# terminal lifecycle
# --------------------------------------------------------------------------

refresh_size() {
  local size rows columns
  size="$(stty size 2>/dev/null || true)"
  read -r rows columns <<< "$size"
  [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
  [[ "$columns" =~ ^[0-9]+$ ]] || columns=80
  (( rows < 1 )) && rows=24
  (( columns < 1 )) && columns=80
  ROWS="$rows"
  COLS="$columns"
  WIDTH=$(( COLS - 4 ))
  (( WIDTH > 94 )) && WIDTH=94
  (( WIDTH < 40 )) && WIDTH=40
}

on_winch() {
  RESIZED=1
  FULL_REDRAW=1
  refresh_size
}

terminal_mouse_on() {
  (( MOUSE )) && printf '%s' "${ESC}[?1000h${ESC}[?1006h"
}

terminal_mouse_off() {
  (( MOUSE )) && printf '%s' "${ESC}[?1000l${ESC}[?1006l"
}

terminal_enter() {
  printf '%s' "${ESC}[?1049h${ESC}[?25l"
  terminal_mouse_on
  TERMINAL_ACTIVE=1
  FULL_REDRAW=1
}

terminal_leave() {
  terminal_mouse_off
  printf '%s' "${ESC}[?25h${ESC}[?1049l"
  TERMINAL_ACTIVE=0
}

kill_tree() {
  local pid="$1" child
  for child in $(ps -eo pid=,ppid= 2>/dev/null | awk -v parent="$pid" '$2 == parent { print $1 }'); do
    kill_tree "$child"
  done
  kill -TERM "$pid" 2>/dev/null || true
}

cleanup() {
  if [[ -n "$CURRENT_CHILD" ]] && kill -0 "$CURRENT_CHILD" 2>/dev/null; then
    kill_tree "$CURRENT_CHILD"
    wait "$CURRENT_CHILD" 2>/dev/null || true
  fi
  if (( TERMINAL_ACTIVE )); then
    terminal_leave
  fi
}

trap cleanup EXIT HUP TERM
trap 'RUN_CANCELLED=1; [[ -n "$CURRENT_CHILD" ]] && kill_tree "$CURRENT_CHILD"' INT
trap on_winch WINCH

# --------------------------------------------------------------------------
# frame buffer
# --------------------------------------------------------------------------

FRAME=()
PREV_FRAME=()
LINE=""
LINE_W=0

FOCUS_IDS=()
FOCUS_ARGS=()
HIT_ROW=()
HIT_C0=()
HIT_C1=()
HIT_ID=()
HIT_ARG=()

SPAN_C0=0
SPAN_C1=0
W_INDEX=0

reset_frame() {
  FRAME=()
  LINE=""
  LINE_W=0
  FOCUS_IDS=()
  FOCUS_ARGS=()
  HIT_ROW=()
  HIT_C0=()
  HIT_C1=()
  HIT_ID=()
  HIT_ARG=()
}

put() {
  LINE+="$1"
  LINE_W=$(( LINE_W + ${#1} ))
}

putc() {
  local code="$1"
  local text="$2"
  if (( COLOR )); then
    LINE+="${code}${text}${RESET}"
  else
    LINE+="$text"
  fi
  LINE_W=$(( LINE_W + ${#text} ))
}

pad_to() {
  local target="$1" filler count
  count=$(( target - LINE_W ))
  (( count <= 0 )) && return
  printf -v filler '%*s' "$count" ''
  LINE+="$filler"
  LINE_W="$target"
}

eol() {
  FRAME+=("$LINE")
  LINE=""
  LINE_W=0
}

blank() {
  FRAME+=("")
}

repeat_char() {
  local character="$1" count="$2" spaces
  (( count <= 0 )) && { printf ''; return; }
  printf -v spaces '%*s' "$count" ''
  printf '%s' "${spaces// /$character}"
}

clip() {
  local text="$1" limit="$2"
  (( limit <= 0 )) && { printf ''; return; }
  if (( ${#text} > limit )); then
    printf '%s%s' "${text:0:limit - 1}" "$G_ELL"
  else
    printf '%s' "$text"
  fi
}

flush_frame() {
  local output="" index total previous
  total=${#FRAME[@]}
  previous=${#PREV_FRAME[@]}
  if (( FULL_REDRAW )); then
    output+="${ESC}[H${ESC}[2J"
    PREV_FRAME=()
    previous=0
    FULL_REDRAW=0
  fi
  for ((index = 0; index < total; index++)); do
    if (( index >= previous )) || [[ "${FRAME[index]}" != "${PREV_FRAME[index]}" ]]; then
      output+="${ESC}[$((index + 1));1H${FRAME[index]}${ESC}[K"
    fi
  done
  for ((index = total; index < previous; index++)); do
    output+="${ESC}[$((index + 1));1H${ESC}[K"
  done
  output+="${ESC}[$((total + 1));1H"
  printf '%s' "$output"
  if (( total )); then
    PREV_FRAME=("${FRAME[@]}")
  else
    PREV_FRAME=()
  fi
}

# --------------------------------------------------------------------------
# widgets
# --------------------------------------------------------------------------

reg_focus() {
  W_INDEX=${#FOCUS_IDS[@]}
  FOCUS_IDS+=("$1")
  FOCUS_ARGS+=("${2-}")
}

reg_hit() {
  HIT_ROW+=("$(( ${#FRAME[@]} + 1 ))")
  HIT_C0+=("$1")
  HIT_C1+=("$2")
  HIT_ID+=("$3")
  HIT_ARG+=("${4-}")
}

draw_chip() {
  local active="$1" focused="$2" label="$3" start
  start=$LINE_W
  if (( active )); then
    if (( COLOR )); then putc "$BLUE_BG" " $label "; else put "[$label]"; fi
  elif (( focused )); then
    if (( COLOR )); then putc "$FOCUS_BG" " $label "; else put "<$label>"; fi
  else
    put " $label "
  fi
  SPAN_C0=$(( start + 1 ))
  SPAN_C1=$LINE_W
}

draw_focus_marker() {
  local focused="$1"
  if (( focused )); then
    putc "$CYAN" "$G_MARK"
  else
    put " "
  fi
}

draw_checkbox() {
  local checked="$1" label="$2" start
  start=$LINE_W
  if (( checked )); then
    putc "$GREEN" "[x] $label"
  else
    put "[ ] $label"
  fi
  SPAN_C0=$(( start + 1 ))
  SPAN_C1=$LINE_W
}

# --------------------------------------------------------------------------
# host tooling
# --------------------------------------------------------------------------

missing_tools() {
  local tools="$1" tool missing="" index
  for ((index = 0; index < ${#TOOL_CACHE_KEYS[@]}; index++)); do
    if [[ "${TOOL_CACHE_KEYS[index]}" == "$tools" ]]; then
      printf '%s' "${TOOL_CACHE_VALUES[index]}"
      return
    fi
  done
  for tool in $tools; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      missing+="${missing:+, }$tool"
    fi
  done
  TOOL_CACHE_KEYS+=("$tools")
  TOOL_CACHE_VALUES+=("$missing")
  printf '%s' "$missing"
}

selected_count() {
  local count=0 value
  for value in "${SELECTED[@]}"; do
    (( value == 1 )) && ((count++))
  done
  printf '%s' "$count"
}

set_all_modules() {
  local value="$1" index
  for ((index = 0; index < ${#SELECTED[@]}; index++)); do
    SELECTED[index]="$value"
  done
}

# --------------------------------------------------------------------------
# input
# --------------------------------------------------------------------------

input_pending() {
  local discard
  IFS= read -rsn1 -t 0 discard 2>/dev/null
}

decode_sgr_mouse() {
  local payload="$1" final raw x y
  final="${payload: -1}"
  payload="${payload%?}"
  payload="${payload#<}"
  IFS=';' read -r raw x y <<< "$payload"
  [[ "$raw" =~ ^[0-9]+$ && "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]] || return 1
  if (( raw & 64 )); then
    (( raw & 1 )) && EVENT="wheeldown" || EVENT="wheelup"
    return 0
  fi
  (( raw & 32 )) && return 1          # drag, ignored
  [[ "$final" == "M" ]] || return 1   # release, ignored
  (( (raw & 3) == 0 )) || return 1    # non primary button
  EVENT="mouse"
  EVENT_BUTTON=0
  EVENT_X="$x"
  EVENT_Y="$y"
}

decode_x10_mouse() {
  local button x y
  IFS= read -rsn1 -t 0.2 button || return 1
  IFS= read -rsn1 -t 0.2 x || return 1
  IFS= read -rsn1 -t 0.2 y || return 1
  printf -v button '%d' "'$button"
  printf -v x '%d' "'$x"
  printf -v y '%d' "'$y"
  button=$(( button - 32 ))
  (( (button & 3) == 0 )) || return 1
  EVENT="mouse"
  EVENT_BUTTON=0
  EVENT_X=$(( x - 32 ))
  EVENT_Y=$(( y - 32 ))
}

read_event() {
  local key next sequence character final params
  EVENT=""
  if ! IFS= read -rsn1 key; then
    if (( RESIZED )); then
      RESIZED=0
      EVENT="resize"
    else
      EVENT="quit"
    fi
    return
  fi
  case "$key" in
    "") EVENT="enter" ;;
    " ") EVENT="space" ;;
    $'\t') EVENT="tab" ;;
    $'\177'|$'\010') EVENT="backspace" ;;
    $'\003') EVENT="cancel" ;;
    $'\033')
      if ! IFS= read -rsn1 -t 0.05 next; then
        EVENT="escape"
        return
      fi
      if [[ "$next" == "O" ]]; then
        IFS= read -rsn1 -t 0.05 next || { EVENT="escape"; return; }
        case "$next" in
          A) EVENT="up" ;;
          B) EVENT="down" ;;
          C) EVENT="right" ;;
          D) EVENT="left" ;;
          *) EVENT="escape" ;;
        esac
        return
      fi
      if [[ "$next" != "[" ]]; then
        EVENT="escape"
        return
      fi
      sequence=""
      while IFS= read -rsn1 -t 0.2 character; do
        sequence+="$character"
        [[ "$character" == [@-~] ]] && break
      done
      [[ -n "$sequence" ]] || { EVENT="escape"; return; }
      final="${sequence: -1}"
      params="${sequence%?}"
      case "$final" in
        A) EVENT="up" ;;
        B) EVENT="down" ;;
        C) EVENT="right" ;;
        D) EVENT="left" ;;
        H) EVENT="home" ;;
        F) EVENT="end" ;;
        M|m)
          if [[ -z "$params" ]]; then
            decode_x10_mouse || EVENT="none"
          else
            decode_sgr_mouse "$sequence" || EVENT="none"
          fi
          ;;
        *) EVENT="none" ;;
      esac
      ;;
    *) EVENT="key"; EVENT_KEY="$key" ;;
  esac
}

find_hit() {
  local index
  HIT_FOUND_ID=""
  HIT_FOUND_ARG=""
  for ((index = 0; index < ${#HIT_ROW[@]}; index++)); do
    if (( EVENT_Y == HIT_ROW[index] && EVENT_X >= HIT_C0[index] && EVENT_X <= HIT_C1[index] )); then
      HIT_FOUND_ID="${HIT_ID[index]}"
      HIT_FOUND_ARG="${HIT_ARG[index]}"
      return 0
    fi
  done
  return 1
}

HIT_FOUND_ID=""
HIT_FOUND_ARG=""

# --------------------------------------------------------------------------
# inline field editing
# --------------------------------------------------------------------------

start_edit() {
  EDIT_MODE=1
  EDIT_TARGET="$1"
  case "$1" in
    endpoint) EDIT_BUFFER="${ENV_ENDPOINTS[$ENV_INDEX]}" ;;
    network) EDIT_BUFFER="${ENV_NETWORKS[$ENV_INDEX]}" ;;
    *) EDIT_BUFFER="" ;;
  esac
}

commit_edit() {
  case "$EDIT_TARGET" in
    endpoint) ENV_ENDPOINTS[ENV_INDEX]="$EDIT_BUFFER" ;;
    network)
      if [[ "$EDIT_BUFFER" =~ ^[0-9]*$ ]]; then
        ENV_NETWORKS[ENV_INDEX]="$EDIT_BUFFER"
      fi
      ;;
  esac
  local previous="$EDIT_TARGET"
  EDIT_MODE=0
  EDIT_TARGET=""
  EDIT_BUFFER=""
  # Chain straight into the network field so an unconfigured environment can be
  # completed in one pass.
  if [[ "$previous" == "endpoint" && -n "${ENV_ENDPOINTS[$ENV_INDEX]}" && -z "${ENV_NETWORKS[$ENV_INDEX]}" ]]; then
    FOCUS="$(focus_index_of network)"
    start_edit network
  fi
}

# Shared text key handling. 0 keep editing, 1 commit, 2 cancel.
edit_consume() {
  case "$EVENT" in
    key)
      if [[ "$EDIT_TARGET" == "network" && ! "$EVENT_KEY" =~ ^[0-9]$ ]]; then
        return 0
      fi
      EDIT_BUFFER+="$EVENT_KEY"
      ;;
    space)
      [[ "$EDIT_TARGET" == "network" ]] || EDIT_BUFFER+=" "
      ;;
    backspace) EDIT_BUFFER="${EDIT_BUFFER%?}" ;;
    enter) return 1 ;;
    escape|cancel) return 2 ;;
  esac
  return 0
}

# --------------------------------------------------------------------------
# dashboard
# --------------------------------------------------------------------------

put_env_field() {
  local label="$1" value="$2" editing="$3" focused="$4" id="$5" start
  put "  "
  draw_focus_marker "$focused"
  put " "
  put "$label"
  pad_to 17
  start=$LINE_W
  if (( editing )); then
    put "$(clip "$value" $(( WIDTH - 20 )))"
    putc "$FOCUS_BG" " "
  elif [[ -n "$value" ]]; then
    put "$(clip "$value" $(( WIDTH - 19 )))"
  else
    putc "$YELLOW" "click or press Enter to configure"
  fi
  reg_hit "$(( start + 1 ))" "$(( WIDTH ))" "$id"
  eol
}

render_dashboard() {
  local index selected hint focused label missing text id
  local module_base=3

  reset_frame
  selected="$(selected_count)"

  put "  "
  putc "$BOLD$CYAN" "LAYERX WORKSPACE"
  put "   "
  putc "$DIM" "interactive dependency, build and test control"
  eol
  put "  "
  putc "$DIM" "$(repeat_char "$G_RULE" "$WIDTH")"
  eol

  # environment ------------------------------------------------------------
  reg_focus env
  focused=$(( FOCUS == W_INDEX ))
  put "  "
  draw_focus_marker "$focused"
  put " Environment"
  pad_to 17
  for ((index = 0; index < 3; index++)); do
    draw_chip "$(( ENV_INDEX == index ))" "$(( focused && ENV_INDEX == index ))" "${ENV_LABELS[index]}"
    reg_hit "$SPAN_C0" "$SPAN_C1" env "$index"
    put " "
  done
  eol

  reg_focus endpoint
  if (( EDIT_MODE )) && [[ "$EDIT_TARGET" == "endpoint" ]]; then
    put_env_field "Endpoint" "$EDIT_BUFFER" 1 1 endpoint
  else
    put_env_field "Endpoint" "${ENV_ENDPOINTS[$ENV_INDEX]}" 0 "$(( FOCUS == W_INDEX ))" endpoint
  fi

  reg_focus network
  if (( EDIT_MODE )) && [[ "$EDIT_TARGET" == "network" ]]; then
    put_env_field "Network ID" "$EDIT_BUFFER" 1 1 network
  else
    put_env_field "Network ID" "${ENV_NETWORKS[$ENV_INDEX]}" 0 "$(( FOCUS == W_INDEX ))" network
  fi

  blank

  # modules ----------------------------------------------------------------
  hint="click a row to toggle"
  if (( FOCUS >= module_base && FOCUS < module_base + ${#MODULE_IDS[@]} )); then
    hint="${MODULE_DESCRIPTIONS[$(( FOCUS - module_base ))]}"
  fi
  put "  "
  putc "$BOLD" "MODULES"
  put "   "
  putc "$DIM" "$(clip "$selected/${#MODULE_IDS[@]} selected $G_DASH $hint" $(( WIDTH - 10 )))"
  eol

  for ((index = 0; index < ${#MODULE_IDS[@]}; index++)); do
    reg_focus module "$index"
    focused=$(( FOCUS == W_INDEX ))
    put "  "
    draw_focus_marker "$focused"
    put " "
    if (( SELECTED[index] == 1 )); then
      putc "$GREEN" "[x]"
    else
      put "[ ]"
    fi
    put " "
    put "${MODULE_NAMES[index]}"
    pad_to 32
    missing="$(missing_tools "${MODULE_TOOLS[index]}")"
    if [[ -z "$missing" ]]; then
      putc "$GREEN" "READY"
    else
      putc "$YELLOW" "$(clip "MISSING $missing" $(( WIDTH - 32 )))"
    fi
    reg_hit 3 "$WIDTH" module "$index"
    eol
  done

  blank

  # action -----------------------------------------------------------------
  put "  "
  putc "$BOLD" "ACTION"
  put "    "
  putc "$DIM" "${ACTION_DESCRIPTIONS[$ACTION_INDEX]}"
  eol

  reg_focus action
  focused=$(( FOCUS == W_INDEX ))
  put "  "
  draw_focus_marker "$focused"
  put " "
  for ((index = 0; index < ${#ACTION_LABELS[@]}; index++)); do
    draw_chip "$(( ACTION_INDEX == index ))" "$(( focused && ACTION_INDEX == index ))" "${ACTION_LABELS[index]}"
    reg_hit "$SPAN_C0" "$SPAN_C1" action "$index"
    put " "
  done
  eol

  # toggles ----------------------------------------------------------------
  put "  "
  reg_focus dry
  draw_focus_marker "$(( FOCUS == W_INDEX ))"
  put " "
  draw_checkbox "$DRY_RUN" "Plan only"
  reg_hit "$SPAN_C0" "$SPAN_C1" dry
  pad_to 26
  reg_focus failfast
  draw_focus_marker "$(( FOCUS == W_INDEX ))"
  put " "
  draw_checkbox "$FAIL_FAST" "Stop on failure"
  reg_hit "$SPAN_C0" "$SPAN_C1" failfast
  pad_to 52
  reg_focus ci
  draw_focus_marker "$(( FOCUS == W_INDEX ))"
  put " "
  draw_checkbox "$CI_MODE" "CI environment"
  reg_hit "$SPAN_C0" "$SPAN_C1" ci
  eol

  blank

  # buttons ----------------------------------------------------------------
  put "  "
  for label in "Select all:selectall" "Clear:clearall" "RUN SELECTED:run" "Quit:quit"; do
    text="${label%%:*}"
    id="${label##*:}"
    reg_focus "$id"
    focused=$(( FOCUS == W_INDEX ))
    if [[ "$id" == "run" ]]; then
      draw_chip "$focused" "$focused" "$text"
    else
      draw_chip 0 "$focused" "$text"
    fi
    reg_hit "$SPAN_C0" "$SPAN_C1" "$id"
    put "  "
  done
  eol

  if (( EDIT_MODE )); then
    put "  "
    putc "$DIM" "Type a value $G_DOT Enter commits $G_DOT Esc cancels"
  else
    put "  "
    putc "$DIM" "$(clip "Click controls $G_DOT Arrows and Tab move $G_DOT Space toggles $G_DOT Enter activates $G_DOT q quits" "$WIDTH")"
  fi
  eol

  FOCUS_COUNT=${#FOCUS_IDS[@]}
  (( FOCUS >= FOCUS_COUNT )) && FOCUS=$(( FOCUS_COUNT - 1 ))
}

cycle_environment() {
  ENV_INDEX=$(( (ENV_INDEX + $1 + 3) % 3 ))
}

cycle_action() {
  ACTION_INDEX=$(( (ACTION_INDEX + $1 + ${#ACTION_LABELS[@]}) % ${#ACTION_LABELS[@]} ))
}

activate() {
  local id="$1" arg="${2-}"
  case "$id" in
    env)
      if [[ -n "$arg" ]]; then ENV_INDEX="$arg"; else cycle_environment 1; fi
      ;;
    endpoint) start_edit endpoint ;;
    network) start_edit network ;;
    module) SELECTED[arg]=$(( 1 - SELECTED[arg] )) ;;
    action)
      if [[ -n "$arg" ]]; then ACTION_INDEX="$arg"; else cycle_action 1; fi
      ;;
    dry) DRY_RUN=$(( 1 - DRY_RUN )) ;;
    failfast) FAIL_FAST=$(( 1 - FAIL_FAST )) ;;
    ci) CI_MODE=$(( 1 - CI_MODE )) ;;
    selectall) set_all_modules 1 ;;
    clearall) set_all_modules 0 ;;
    run) RUN_REQUESTED=1 ;;
    quit) QUIT_REQUESTED=1 ;;
  esac
}

focus_index_of() {
  local id="$1" arg="${2-}" index
  for ((index = 0; index < ${#FOCUS_IDS[@]}; index++)); do
    [[ "${FOCUS_IDS[index]}" == "$id" ]] || continue
    if [[ "$id" == "module" && -n "$arg" && "${FOCUS_ARGS[index]}" != "$arg" ]]; then
      continue
    fi
    printf '%s' "$index"
    return
  done
  printf '%s' "$FOCUS"
}

handle_dashboard_event() {
  local id arg

  if (( EDIT_MODE )); then
    edit_consume
    case "$?" in
      1) commit_edit ;;
      2) EDIT_MODE=0; EDIT_TARGET=""; EDIT_BUFFER="" ;;
    esac
    return
  fi

  id="${FOCUS_IDS[$FOCUS]:-}"

  case "$EVENT" in
    up|wheelup) FOCUS=$(( (FOCUS - 1 + FOCUS_COUNT) % FOCUS_COUNT )) ;;
    down|tab|wheeldown) FOCUS=$(( (FOCUS + 1) % FOCUS_COUNT )) ;;
    left)
      case "$id" in
        env) cycle_environment -1 ;;
        action) cycle_action -1 ;;
        *) FOCUS=$(( (FOCUS - 1 + FOCUS_COUNT) % FOCUS_COUNT )) ;;
      esac
      ;;
    right)
      case "$id" in
        env) cycle_environment 1 ;;
        action) cycle_action 1 ;;
        *) FOCUS=$(( (FOCUS + 1) % FOCUS_COUNT )) ;;
      esac
      ;;
    home) FOCUS=0 ;;
    end) FOCUS=$(( FOCUS_COUNT - 1 )) ;;
    enter|space) activate "$id" "${FOCUS_ARGS[$FOCUS]:-}" ;;
    key)
      case "$EVENT_KEY" in
        q|Q) QUIT_REQUESTED=1 ;;
        a|A) set_all_modules 1 ;;
        c|C) set_all_modules 0 ;;
        r|R) RUN_REQUESTED=1 ;;
        d|D) DRY_RUN=$(( 1 - DRY_RUN )) ;;
        i|I) ACTION_INDEX=0 ;;
        e|E) cycle_environment 1 ;;
      esac
      ;;
    mouse)
      if find_hit; then
        arg="$HIT_FOUND_ARG"
        FOCUS="$(focus_index_of "$HIT_FOUND_ID" "$arg")"
        activate "$HIT_FOUND_ID" "$arg"
      fi
      ;;
    escape|cancel|quit) QUIT_REQUESTED=1 ;;
  esac
}

