put_wrapped() {
  local text="$1" limit="$2" word line=""
  for word in $text; do
    if [[ -z "$line" ]]; then
      line="$word"
    elif (( ${#line} + 1 + ${#word} <= limit )); then
      line+=" $word"
    else
      put "  "; put "$line"; eol
      line="$word"
    fi
  done
  [[ -n "$line" ]] && { put "  "; put "$line"; eol; }
}

