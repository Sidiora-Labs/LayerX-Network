# --------------------------------------------------------------------------
# execution
# --------------------------------------------------------------------------

put_status() {
  local status="$1" code
  case "$status" in
    PASSED) code="$GREEN" ;;
    RUNNING) code="$CYAN" ;;
    PLANNED|SKIPPED) code="$DIM" ;;
    BLOCKED|FAILED|CANCELLED) code="$RED" ;;
    *) code="$YELLOW" ;;
  esac
  putc "$code" "$status"
}

load_log_tail() {
  local file="$1" size="" line
  if [[ -n "$file" && -f "$file" ]]; then
    size="$(wc -c <"$file" 2>/dev/null || printf '0')"
  fi
  if [[ "$file" == "$LOG_CACHE_FILE" && "$size" == "$LOG_CACHE_SIZE" ]]; then
    return
  fi
  LOG_CACHE_FILE="$file"
  LOG_CACHE_SIZE="$size"
  LOG_CACHE=()
  [[ -n "$file" && -f "$file" ]] || return
  while IFS= read -r line; do
    LOG_CACHE+=("$line")
  done < <(tail -n "$LOG_LINES" "$file" 2>/dev/null |
    sed -E $'s/\033\\[[0-9;?]*[ -\/]*[@-~]//g; s/\r//g; s/[^[:print:]\t]//g')
}

render_execution() {
  local current="$1" log_file="$2"
  local total start end index filled bar_width shown

  total=${#STEP_MODULE[@]}
  load_log_tail "$log_file"
  reset_frame

  put "  "
  putc "$BOLD$CYAN" "LAYERX WORKSPACE RUN"
  put "   "
  putc "$DIM" "${ACTION_LABELS[$ACTION_INDEX]} $G_DOT ${ENV_LABELS[$ENV_INDEX]}"
  eol

  bar_width=$(( WIDTH - 16 ))
  (( bar_width < 20 )) && bar_width=20
  filled=0
  (( total > 0 )) && filled=$(( current * bar_width / total ))
  put "  ["
  putc "$CYAN" "$(repeat_char "$G_BAR_FULL" "$filled")"
  putc "$DIM" "$(repeat_char "$G_BAR_EMPTY" "$(( bar_width - filled ))")"
  put "] $current/$total"
  eol
  blank

  start=$(( current - 3 ))
  (( start < 0 )) && start=0
  (( start + STEP_WINDOW > total )) && start=$(( total - STEP_WINDOW ))
  (( start < 0 )) && start=0
  end=$(( start + STEP_WINDOW ))
  (( end > total )) && end=$total

  for ((index = start; index < end; index++)); do
    if (( index == current && current < total )); then
      put "  "
      putc "$CYAN" "$G_MARK"
      put " "
    else
      put "    "
    fi
    put "${STEP_MODULE[index]}"
    pad_to 15
    put "${STEP_PHASE[index]}"
    pad_to 24
    put_status "${STEP_STATUS[index]}"
    pad_to 35
    put "$(clip "${STEP_LABEL[index]}" $(( WIDTH - 35 )))"
    eol
  done
  for ((index = end - start; index < STEP_WINDOW; index++)); do
    blank
  done

  blank
  put "  "
  putc "$BOLD" "LIVE OUTPUT"
  eol
  put "  "
  putc "$DIM" "$(repeat_char "$G_RULE" "$WIDTH")"
  eol

  shown=${#LOG_CACHE[@]}
  for ((index = 0; index < shown; index++)); do
    put "  "
    putc "$DIM" "$(clip "${LOG_CACHE[index]}" $(( WIDTH - 2 )))"
    eol
  done
  while (( shown < LOG_LINES )); do
    blank
    ((shown++))
  done

  blank
  put "  "
  putc "$DIM" "Ctrl-C cancels the active process; completed module results are preserved."
  eol

  flush_frame
}

run_one_step() {
  local index="$1" run_directory="$2"
  local missing command log_file exit_code keypress

  missing="$(missing_tools "${STEP_TOOLS[index]}")"

  if (( DRY_RUN )); then
    STEP_LOG[index]=""
    if [[ -n "$missing" ]]; then
      STEP_STATUS[index]="BLOCKED"
    else
      STEP_STATUS[index]="PLANNED"
    fi
    render_execution "$(( index + 1 ))" ""
    return 0
  fi

  log_file="$run_directory/$(printf '%03d' "$(( index + 1 ))")-${STEP_MODULE[index]}-${STEP_PHASE[index]}.log"
  STEP_LOG[index]="$log_file"

  if [[ "${STEP_COMMAND[index]}" == ":" ]]; then
    STEP_STATUS[index]="SKIPPED"
    : > "$log_file"
    render_execution "$(( index + 1 ))" "$log_file"
    return 0
  fi

  if [[ -n "$missing" ]]; then
    STEP_STATUS[index]="BLOCKED"
    printf 'Missing host tools: %s\n' "$missing" > "$log_file"
    render_execution "$(( index + 1 ))" "$log_file"
    return 1
  fi

  STEP_STATUS[index]="RUNNING"
  command="${STEP_COMMAND[index]}"
  (
    cd "$ROOT_DIR/${STEP_CWD[index]}" || exit 127
    export LAYERX_ENVIRONMENT="${ENV_NAMES[$ENV_INDEX]}"
    export LAYERX_ENDPOINT="${ENV_ENDPOINTS[$ENV_INDEX]}"
    export LAYERX_NETWORK_ID="${ENV_NETWORKS[$ENV_INDEX]}"
    if (( CI_MODE )); then export CI=1; fi
    exec bash -c "$command"
  ) </dev/null >"$log_file" 2>&1 &
  CURRENT_CHILD=$!

  while kill -0 "$CURRENT_CHILD" 2>/dev/null; do
    render_execution "$index" "$log_file"
    if IFS= read -rsn1 -t 0.12 keypress; then
      case "$keypress" in
        $'\003'|c|C|q|Q)
          RUN_CANCELLED=1
          kill_tree "$CURRENT_CHILD"
          ;;
      esac
    fi
  done

  wait "$CURRENT_CHILD"
  exit_code=$?
  CURRENT_CHILD=""

  if (( RUN_CANCELLED )); then
    STEP_STATUS[index]="CANCELLED"
    return 130
  elif (( exit_code == 0 )); then
    STEP_STATUS[index]="PASSED"
    return 0
  else
    STEP_STATUS[index]="FAILED"
    return "$exit_code"
  fi
}

render_results() {
  local passed=0 failed=0 blocked=0 planned=0 skipped=0 cancelled=0 waiting=0
  local index status total listed=0

  total=${#STEP_STATUS[@]}
  for ((index = 0; index < total; index++)); do
    status="${STEP_STATUS[index]}"
    case "$status" in
      PASSED) ((passed++)) ;;
      FAILED) ((failed++)) ;;
      BLOCKED) ((blocked++)) ;;
      PLANNED) ((planned++)) ;;
      SKIPPED) ((skipped++)) ;;
      CANCELLED) ((cancelled++)) ;;
      WAITING) ((waiting++)) ;;
    esac
  done

  while true; do
    reset_frame
    modal_header "WORKSPACE RESULTS"
    put "  "
    putc "$GREEN" "$passed passed"
    put "   "
    putc "$RED" "$failed failed"
    put "   "
    putc "$YELLOW" "$blocked blocked"
    eol
    put "  $planned planned   $skipped skipped   $cancelled cancelled   $waiting not run"
    eol
    blank

    listed=0
    if (( failed || blocked || cancelled )); then
      put "  "
      putc "$BOLD" "NEEDS ATTENTION"
      eol
      for ((index = 0; index < total && listed < 10; index++)); do
        case "${STEP_STATUS[index]}" in
          FAILED|BLOCKED|CANCELLED) ;;
          *) continue ;;
        esac
        put "  ${STEP_MODULE[index]}"
        pad_to 15
        put "${STEP_PHASE[index]}"
        pad_to 24
        put_status "${STEP_STATUS[index]}"
        pad_to 35
        put "$(clip "${STEP_LABEL[index]}" $(( WIDTH - 35 )))"
        eol
        ((listed++))
      done
    else
      put "  "
      putc "$GREEN" "Every executed step completed."
      eol
    fi

    blank
    if [[ -n "$RUN_DIRECTORY" ]]; then
      put "  Logs: $(clip "$RUN_DIRECTORY" $(( WIDTH - 8 )))"
    else
      put "  Plan only: no commands ran and no log files were created."
    fi
    eol
    blank
    put "  "
    draw_chip 1 0 "BACK TO DASHBOARD"
    reg_hit "$SPAN_C0" "$SPAN_C1" back
    eol
    flush_frame

    read_event
    case "$EVENT" in
      resize|none) continue ;;
      *) break ;;
    esac
  done
  FULL_REDRAW=1
}

run_plan() {
  local timestamp index result=0 completed=0 last_log=""

  timestamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  RUN_DIRECTORY=""
  if (( ! DRY_RUN )); then
    RUN_DIRECTORY="$ROOT_DIR/.logs/workspace/$timestamp"
    mkdir -p "$RUN_DIRECTORY"
  fi

  RUN_CANCELLED=0
  LOG_CACHE_FILE=""
  LOG_CACHE_SIZE=""
  FULL_REDRAW=1
  terminal_mouse_off

  for ((index = 0; index < ${#STEP_MODULE[@]}; index++)); do
    if ! run_one_step "$index" "$RUN_DIRECTORY"; then
      result=1
      completed=$(( index + 1 ))
      if (( RUN_CANCELLED || FAIL_FAST )); then
        break
      fi
    else
      completed=$(( index + 1 ))
    fi
  done

  if (( completed > 0 )); then
    last_log="${STEP_LOG[$(( completed - 1 ))]}"
  fi
  render_execution "$completed" "$last_log"
  terminal_mouse_on
  render_results
  return "$result"
}

start_current_action() {
  RUN_REQUESTED=0

  if (( $(selected_count) == 0 )); then
    show_notice "NO MODULES SELECTED" "Select at least one module before starting a workspace action."
    return
  fi

  if (( ACTION_INDEX == 0 )); then
    show_doctor
    return
  fi

  if [[ -z "${ENV_ENDPOINTS[$ENV_INDEX]}" || -z "${ENV_NETWORKS[$ENV_INDEX]}" ]]; then
    show_notice "ENVIRONMENT NOT CONFIGURED" \
      "Set both an endpoint and a numeric network ID for ${ENV_LABELS[$ENV_INDEX]} before running this action."
    FOCUS="$(focus_index_of endpoint)"
    start_edit endpoint
    return
  fi

  build_plan
  production_authorized || return
  confirm_run || return
  run_plan || true
}

# --------------------------------------------------------------------------
# main loop
# --------------------------------------------------------------------------

render_too_small() {
  reset_frame
  put "  "
  putc "$BOLD$YELLOW" "TERMINAL TOO SMALL"
  eol
  blank
  put "  LayerX Workspace needs at least $MIN_COLS columns and $MIN_ROWS rows."; eol
  put "  Current terminal: $COLS columns by $ROWS rows."; eol
  blank
  put "  "
  putc "$DIM" "Resize the terminal, or press q to quit."
  eol
  flush_frame
}

terminal_usable() {
  (( ROWS >= MIN_ROWS && COLS >= MIN_COLS ))
}

dashboard_main() {
  if (( $# != 0 )); then
    printf 'LayerX Workspace is an interactive dashboard. Launch it without subcommands.\n' >&2
    return 2
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'LayerX Workspace needs an interactive terminal.\n' >&2
    return 2
  fi
  if [[ ! -f "$ROOT_DIR/Makefile" || ! -f "$ROOT_DIR/platform/Cargo.toml" ]]; then
    printf 'The dashboard must remain in the LayerX repository root.\n' >&2
    return 2
  fi

  refresh_size
  terminal_enter

  while (( ! QUIT_REQUESTED )); do
    if ! terminal_usable; then
      render_too_small
      read_event
      [[ "$EVENT" == "quit" || "$EVENT" == "escape" ]] && break
      [[ "$EVENT" == "key" && "$EVENT_KEY" == [qQ] ]] && break
      continue
    fi

    render_dashboard
    flush_frame

    read_event
    [[ "$EVENT" == "resize" || "$EVENT" == "none" ]] && continue
    handle_dashboard_event

    # Drain any keys that arrived while the frame was being written so a held
    # arrow key advances focus once per press instead of once per repaint.
    while (( ! QUIT_REQUESTED && ! RUN_REQUESTED )) && input_pending; do
      read_event
      [[ "$EVENT" == "resize" || "$EVENT" == "none" ]] && continue
      handle_dashboard_event
    done

    if (( RUN_REQUESTED )); then
      start_current_action
    fi
  done

  terminal_leave
  TERMINAL_ACTIVE=0
  return 0
}

if [[ "${LAYERX_DASHBOARD_LIBRARY:-0}" != "1" ]]; then
  dashboard_main "$@"
fi