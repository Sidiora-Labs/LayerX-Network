[module]
name = "stream"
contract_major = 1
compatibility = "additive_only"
spine = "Both shells render live state from one resumable event stream: journey progress, approval lifecycle and notifications, delivered in cursor order without polling."
resumption = "Every event carries the stable cursor that names its position. A client that reconnects resumes from the last cursor it processed and receives every later event exactly once, in order, with no gaps and no duplicates. A cursor the service no longer retains is refused with the cursor-expired code, and the client re-opens from the current position."

[type.StreamEventKind]
variants = ["journey-progress","approval-created","approval-approved","approval-rejected","approval-expired","notification"]

[type.StreamEvent]
required = ["cursor:Cursor","kind:StreamEventKind","observed_at:Timestamp"]
optional = ["journey:Journey","approval:ApprovalSummary","notification:NotificationSummary"]
payloads = "An event embeds the journey it reports where one exists. Later modules extend the optional payloads additively; the cursor, kind and observed_at spine never changes."

[type.StreamPosition]
required = ["cursor:Cursor"]

[type.StreamPage]
required = ["events:StreamEvent[]","next_cursor:Cursor"]
paging = "An empty events list with an unchanged next_cursor means the position is current. next_cursor always names the position after the last delivered event and is always safe to resume from."

[operation.stream.open]
authorization_class = "money-movement"
method = "POST"
path = "/v1/stream"
request = "Empty"
response = "StreamPosition"

[operation.stream.next]
authorization_class = "read"
method = "GET"
path = "/v1/stream/{cursor}"
request = "Empty"
response = "StreamPage"
