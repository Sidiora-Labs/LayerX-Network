support.kvx:operation.support.feedback.request = "SupportFeedbackRequest"
support.kvx:operation.support.feedback.response = "SupportConversation"
support.kvx:operation.support.list.method = "GET"
support.kvx:operation.support.list.path = "/v1/support/conversations"
support.kvx:operation.support.list.request = "Empty"
support.kvx:operation.support.list.response = "SupportConversationPage"
support.kvx:operation.support.read.method = "POST"
