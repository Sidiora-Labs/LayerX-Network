movement.kvx:scalar.QuoteId.prefix = "qte_"
movement.kvx:scalar.QuoteId.rust = "String"
movement.kvx:scalar.QuoteId.typescript = "string"
movement.kvx:scalar.WalletAddress.json = "string"
movement.kvx:scalar.WalletAddress.prefix = "0x"
movement.kvx:scalar.WalletAddress.rust = "String"
movement.kvx:scalar.WalletAddress.typescript = "string"
movement.kvx:scalar.WalletSignature.json = "string"
movement.kvx:scalar.WalletSignature.prefix = "0x"
movement.kvx:scalar.WalletSignature.rust = "String"
movement.kvx:scalar.WalletSignature.typescript = "string"
movement.kvx:scalar.WalletTxId.json = "string"
movement.kvx:scalar.WalletTxId.prefix = "0x"
movement.kvx:scalar.WalletTxId.rust = "String"
movement.kvx:scalar.WalletTxId.typescript = "string"
