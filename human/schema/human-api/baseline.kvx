movement.kvx:type.DepositConfirmRequest.required = ["wallet_transaction:WalletTxId"]
movement.kvx:type.DepositConfirmRequest.settlement_domain = "paxeer"
movement.kvx:type.DepositStartRequest.optional = ["settlement_domain:SettlementDomain"]
movement.kvx:type.DepositStartRequest.required = ["money:Money"]
movement.kvx:type.DepositStartRequest.settlement_domain = "paxeer"
movement.kvx:type.ExitEligibility.normal_operation = "Where the protocol has not declared exit eligibility, eligible is false and copy_key states plainly that the exit is unavailable because the network is operating normally, with withdraw_instead_path offering the ordinary withdrawal instead."
movement.kvx:type.ExitEligibility.optional = ["withdraw_instead_path:string","settlement_domain:SettlementDomain"]
movement.kvx:type.ExitEligibility.required = ["eligible:boolean","copy_key:CopyKey"]
movement.kvx:type.ExitEligibility.settlement_domain = "paxeer"
movement.kvx:type.ExitStartRequest.optional = ["settlement_domain:SettlementDomain"]
movement.kvx:type.ExitStartRequest.required = ["confirmation:string"]
movement.kvx:type.ExitStartRequest.settlement_domain = "paxeer"
movement.kvx:type.ExitStartRequest.typed_confirmation = "confirmation carries the exact typed phrase the irreversible-action grammar requires. Anything else is refused."
movement.kvx:type.MoveCommitRequest.required = ["quote_id:QuoteId"]
movement.kvx:type.MoveMechanism.boundary = "deposit, withdraw and exit are never mechanisms of an internal movement: they name custody-boundary journeys exclusively."
movement.kvx:type.MoveMechanism.resolved = "The route resolver derives the mechanism from source, destination and their relationship. The user never chooses it."
movement.kvx:type.MoveMechanism.variants = ["fund","allocate","return","transfer"]
movement.kvx:type.MoveQuote.description = "description_copy_key resolves to the plain-language statement of what will happen, shown before the user commits."
movement.kvx:type.MoveQuote.estimates = "fee_estimate and arrival_estimate are labelled estimates and never receipt-shaped, and fee_ceiling is the most the fee can be. Receipt-backed actuals replace every estimate once the journey completes."
movement.kvx:type.MoveQuote.expiry = "A quote is honoured until expires_at. Committing an expired quote is refused with the quote-expired code and the client requests a fresh quote."
movement.kvx:type.MoveQuote.irreversibility = "irreversibility_copy_key is present when the movement cannot be undone and states so before commitment."
movement.kvx:type.MoveQuote.optional = ["irreversibility_copy_key:CopyKey"]
movement.kvx:type.MoveQuote.required = ["quote_id:QuoteId","description_copy_key:CopyKey","mechanism:MoveMechanism","money:Money","fee_estimate:Money","fee_ceiling:Money","arrival_estimate:Timestamp","expires_at:Timestamp"]
movement.kvx:type.MoveQuoteRequest.endpoints = "source and destination name the user's account, one of their managed agents or the bound wallet. The resolver derives everything else."
movement.kvx:type.MoveQuoteRequest.required = ["source:string","destination:string","money:Money"]
movement.kvx:type.Refusal.change_path_rule = "change_path names the surface where the user can change the refusing limit, present only when that limit is theirs to change."
movement.kvx:type.Refusal.money_left_rule = "money_left states whether any money left the account. The plane surfaces a refusal honestly, never softens it, and never retries into a different outcome."
movement.kvx:type.Refusal.optional = ["change_path:string"]
movement.kvx:type.Refusal.plain_language = "copy_key names in plain language which limit refused the movement."
movement.kvx:type.Refusal.required = ["refused_by:RefusedBy","copy_key:CopyKey","money_left:boolean"]
movement.kvx:type.RefusedBy.classes = "The machine classes a movement can be refused by. The journey surface always speaks the refusal in plain language through the Refusal copy key."
movement.kvx:type.RefusedBy.variants = ["policy","budget","capability","protocol","limit"]
movement.kvx:type.SettlementDomain.one_ledger = "An internal movement never names a settlement domain. One identity, one balance system and one canonical order are preserved unchanged by this vocabulary."
movement.kvx:type.SettlementDomain.reservation = "Every custody-boundary claim and receipt shape names its settlement domain through this vocabulary, so adding a settlement domain later is an additive schema change by construction: a new variant appended to this list with every existing declaration untouched."
movement.kvx:type.SettlementDomain.sole_domain = "paxeer is the sole valid settlement domain in this contract version. The custody and withdrawal guarantee remains Paxeer exclusively, and no other venue is ever presented as a place funds live."
movement.kvx:type.SettlementDomain.variants = ["paxeer"]
movement.kvx:type.WalletSignRequest.bound_address = "from_address is the bound address the signature must come from."
movement.kvx:type.WalletSignRequest.opaque = "to_sign_base64 carries exactly what the wallet consumes - the custody transaction, the binding statement or a claim. The client hands it to the wallet unchanged and never assembles or inspects it."
movement.kvx:type.WalletSignRequest.opens_once = "The wallet opens exactly once per wallet request, at an explicit signing moment, and copy_key states in plain language what the signature does."
movement.kvx:type.WalletSignRequest.optional = ["settlement_domain:SettlementDomain"]
movement.kvx:type.WalletSignRequest.required = ["stage_id:StageId","copy_key:CopyKey","from_address:WalletAddress","to_sign_base64:string"]
movement.kvx:type.WalletSignRequest.settlement_domain = "paxeer"
movement.kvx:type.WalletSignRequest.stage_rule = "stage_id names the journey stage that waits on this signature."
movement.kvx:type.WithdrawClaimRequest.optional = ["settlement_domain:SettlementDomain"]
movement.kvx:type.WithdrawClaimRequest.required = ["claim_signature:WalletSignature"]
movement.kvx:type.WithdrawClaimRequest.settlement_domain = "paxeer"
movement.kvx:type.WithdrawStartRequest.optional = ["settlement_domain:SettlementDomain"]
movement.kvx:type.WithdrawStartRequest.required = ["money:Money","destination:WalletAddress"]
movement.kvx:type.WithdrawStartRequest.review = "The review before commitment shows the amount, the full destination address and the explicit statement that a committed withdrawal cannot be cancelled, only completed."
movement.kvx:type.WithdrawStartRequest.settlement_domain = "paxeer"
stream.kvx:module.compatibility = "additive_only"
stream.kvx:module.contract_major = 1
stream.kvx:module.name = "stream"
stream.kvx:module.resumption = "Every event carries the stable cursor that names its position. A client that reconnects resumes from the last cursor it processed and receives every later event exactly once, in order, with no gaps and no duplicates. A cursor the service no longer retains is refused with the cursor-expired code, and the client re-opens from the current position."
stream.kvx:module.spine = "Both shells render live state from one resumable event stream: journey progress, approval lifecycle and notifications, delivered in cursor order without polling."
stream.kvx:operation.stream.next.method = "GET"
stream.kvx:operation.stream.next.path = "/v1/stream/{cursor}"
stream.kvx:operation.stream.next.request = "Empty"
stream.kvx:operation.stream.next.response = "StreamPage"
stream.kvx:operation.stream.open.method = "POST"
stream.kvx:operation.stream.open.path = "/v1/stream"
stream.kvx:operation.stream.open.request = "Empty"
stream.kvx:operation.stream.open.response = "StreamPosition"
stream.kvx:type.StreamEvent.optional = ["journey:Journey","approval:ApprovalSummary","notification:NotificationSummary"]
stream.kvx:type.StreamEvent.payloads = "An event embeds the journey it reports where one exists. Later modules extend the optional payloads additively; the cursor, kind and observed_at spine never changes."
stream.kvx:type.StreamEvent.required = ["cursor:Cursor","kind:StreamEventKind","observed_at:Timestamp"]
stream.kvx:type.StreamEventKind.variants = ["journey-progress","approval-created","approval-approved","approval-rejected","approval-expired","notification"]
stream.kvx:type.StreamPage.paging = "An empty events list with an unchanged next_cursor means the position is current. next_cursor always names the position after the last delivered event and is always safe to resume from."
stream.kvx:type.StreamPage.required = ["events:StreamEvent[]","next_cursor:Cursor"]
stream.kvx:type.StreamPosition.required = ["cursor:Cursor"]
support.kvx:module.compatibility = "additive_only"
support.kvx:module.contract_major = 1
support.kvx:module.name = "support"
support.kvx:module.spine = "Authenticated people can create and resume support conversations without exposing protocol payloads, credentials or browser diagnostics. A consented error trace is the only error-report field accepted by this surface."
support.kvx:operation.support.create.idempotency = true
support.kvx:operation.support.create.method = "POST"
support.kvx:operation.support.create.path = "/v1/support/conversations"
support.kvx:operation.support.create.request = "SupportCreateRequest"
support.kvx:operation.support.create.response = "SupportConversation"
support.kvx:operation.support.feedback.method = "POST"
