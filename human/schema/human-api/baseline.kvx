[manifest]
tool = "layerx-human-schema-check"
schema_major = 1
refresh = "cargo run --manifest-path human/tools/schema-check/Cargo.toml --locked -- --write-baseline human/schema/human-api"

[entries]
activity.kvx:module.compatibility = "additive_only"
activity.kvx:module.contract_major = 1
activity.kvx:module.name = "activity"
activity.kvx:module.spine = "One feed tells the user what happened in their words: deposits, withdrawals, movements, agent actions, approvals and security events in one place, every state translated through the journey vocabulary and every claim backed by evidence one reference away."
activity.kvx:operation.activity.entry.method = "GET"
activity.kvx:operation.activity.entry.path = "/v1/activity/{entry_id}"
activity.kvx:operation.activity.entry.request = "Empty"
activity.kvx:operation.activity.entry.response = "ActivityEntryDetail"
activity.kvx:operation.activity.export.evidence.idempotency = true
activity.kvx:operation.activity.export.evidence.method = "POST"
activity.kvx:operation.activity.export.evidence.path = "/v1/activity/exports/evidence"
activity.kvx:operation.activity.export.evidence.request = "ExportEvidenceRequest"
activity.kvx:operation.activity.export.evidence.response = "ExportArtefact"
activity.kvx:operation.activity.export.statement.idempotency = true
activity.kvx:operation.activity.export.statement.method = "POST"
activity.kvx:operation.activity.export.statement.path = "/v1/activity/exports/statement"
activity.kvx:operation.activity.export.statement.request = "ExportStatementRequest"
activity.kvx:operation.activity.export.statement.response = "ExportArtefact"
activity.kvx:operation.activity.query.method = "POST"
activity.kvx:operation.activity.query.path = "/v1/activity/query"
activity.kvx:operation.activity.query.request = "ActivityQueryRequest"
activity.kvx:operation.activity.query.response = "ActivityPage"
activity.kvx:operation.notification.list.method = "GET"
activity.kvx:operation.notification.list.path = "/v1/notifications"
activity.kvx:operation.notification.list.request = "Empty"
activity.kvx:operation.notification.list.response = "NotificationPage"
activity.kvx:operation.notification.preferences.get.method = "GET"
activity.kvx:operation.notification.preferences.get.path = "/v1/notifications/preferences"
activity.kvx:operation.notification.preferences.get.request = "Empty"
activity.kvx:operation.notification.preferences.get.response = "NotificationPreferences"
activity.kvx:operation.notification.preferences.set.method = "POST"
activity.kvx:operation.notification.preferences.set.path = "/v1/notifications/preferences"
activity.kvx:operation.notification.preferences.set.refusal = "A set that would fully suppress a security-critical class - recovery initiation or wallet rebinding - is refused with not-suppressible and changes nothing."
activity.kvx:operation.notification.preferences.set.request = "NotificationPreferences"
activity.kvx:operation.notification.preferences.set.response = "NotificationPreferences"
activity.kvx:operation.notification.read.method = "POST"
activity.kvx:operation.notification.read.path = "/v1/notifications/{notification_id}/read"
activity.kvx:operation.notification.read.request = "Empty"
activity.kvx:operation.notification.read.response = "NotificationSummary"
activity.kvx:scalar.ActivityEntryId.json = "string"
activity.kvx:scalar.ActivityEntryId.prefix = "act_"
activity.kvx:scalar.ActivityEntryId.rust = "String"
activity.kvx:scalar.ActivityEntryId.typescript = "string"
activity.kvx:scalar.ExportId.json = "string"
activity.kvx:scalar.ExportId.prefix = "exp_"
activity.kvx:scalar.ExportId.rust = "String"
activity.kvx:scalar.ExportId.typescript = "string"
activity.kvx:scalar.NotificationId.json = "string"
activity.kvx:scalar.NotificationId.prefix = "ntf_"
activity.kvx:scalar.NotificationId.rust = "String"
activity.kvx:scalar.NotificationId.typescript = "string"
activity.kvx:type.ActivityEntry.joined = "A custody-boundary journey renders as one joined entry spanning its stages, named by journey_id."
activity.kvx:type.ActivityEntry.optional = ["money:Money","direction:MoneyDirection","agent_id:AgentId","journey_id:JourneyId","approval_id:ApprovalId"]
activity.kvx:type.ActivityEntry.required = ["entry_id:ActivityEntryId","kind:ActivityEntryKind","state:JourneyState","state_copy_key:CopyKey","summary_copy_key:CopyKey","occurred_at:Timestamp"]
activity.kvx:type.ActivityEntry.states = "Entry states translate through JourneyState: done renders only under the receipt rule, and a refusal always states whether money left the account."
activity.kvx:type.ActivityEntryDetail.amounts = "money and fees are receipt-backed actuals, never estimates."
activity.kvx:type.ActivityEntryDetail.optional = ["money:Money","fees:Money","direction:MoneyDirection","agent_id:AgentId","journey_id:JourneyId","approval_id:ApprovalId"]
activity.kvx:type.ActivityEntryDetail.required = ["entry_id:ActivityEntryId","kind:ActivityEntryKind","state:JourneyState","state_copy_key:CopyKey","summary_copy_key:CopyKey","occurred_at:Timestamp","stages:JourneyStage[]","evidence:EvidenceRef[]"]
activity.kvx:type.ActivityEntryDetail.sentence = "summary_copy_key names the one plain sentence saying what happened."
activity.kvx:type.ActivityEntryDetail.technical = "evidence carries the references the collapsed Technical details section renders, each sufficient to fetch receipt or proof material for independent verification."
activity.kvx:type.ActivityEntryKind.variants = ["deposit","withdrawal","movement","agent-action","approval","security-event"]
activity.kvx:type.ActivityFilter.deferred_apply = "Filters are deferred-apply: choices collect on the client and apply in one query."
activity.kvx:type.ActivityFilter.optional = ["kinds:ActivityEntryKind[]","agent_id:AgentId","from:Timestamp","to:Timestamp"]
activity.kvx:type.ActivityFilter.required = []
activity.kvx:type.ActivityGroup.grouping = "Entries group by month with per-group subtotals for money in and money out."
activity.kvx:type.ActivityGroup.required = ["month:string","subtotal_in:Money","subtotal_out:Money","entries:ActivityEntry[]"]
activity.kvx:type.ActivityPage.echo = "The applied filter is echoed back in every page so the active view is always self-describing; an unfiltered page echoes the empty filter."
activity.kvx:type.ActivityPage.paging = "Cursors are stable: pages survive service restart without gaps, duplicates or reordering, and a new verified receipt appears within the declared freshness bound."
activity.kvx:type.ActivityPage.required = ["groups:ActivityGroup[]","next_cursor:Cursor","filter:ActivityFilter"]
activity.kvx:type.ActivityQueryRequest.optional = ["cursor:Cursor","filter:ActivityFilter","page_limit:integer"]
activity.kvx:type.ActivityQueryRequest.required = []
activity.kvx:type.ChannelPreference.required = ["enabled:boolean","classes:ClassToggle[]"]
activity.kvx:type.ClassToggle.required = ["class:NotificationClass","enabled:boolean"]
activity.kvx:type.ExportArtefact.composition = "evidence names every receipt and proof material composed into the artefact. Each reference resolves through evidence.get to the material in its exact protocol bytes, so the bundle verifies independently of this plane."
activity.kvx:type.ExportArtefact.required = ["export_id:ExportId","kind:ExportKind","download_path:string","content_type:string","created_at:Timestamp","evidence:EvidenceRef[]"]
activity.kvx:type.ExportEvidenceRequest.optional = ["filter:ActivityFilter","entry_ids:ActivityEntryId[]"]
activity.kvx:type.ExportEvidenceRequest.required = []
activity.kvx:type.ExportKind.variants = ["statement","evidence-bundle"]
activity.kvx:type.ExportStatementRequest.optional = ["filter:ActivityFilter"]
activity.kvx:type.ExportStatementRequest.required = []
activity.kvx:type.MoneyDirection.rendering = "Amounts render with sign, semantic colour and direction word together; direction carries the machine half of that rule."
activity.kvx:type.MoneyDirection.variants = ["in","out"]
activity.kvx:type.NotificationClass.non_suppressible = ["security-recovery","security-wallet-rebinding"]
activity.kvx:type.NotificationClass.rule = "Security-critical classes are never fully suppressible: a preference change silencing security-recovery or security-wallet-rebinding on every channel is refused with not-suppressible."
activity.kvx:type.NotificationClass.variants = ["approval-waiting","money-arrived","journey-finished","claim-ready","security-new-device","security-recovery","security-wallet-rebinding","security-key-rotation","service-status"]
activity.kvx:type.NotificationDetailLevel.bound = "The detail level bounds how much financial detail notification content carries, and lock-screen presentations degrade to non-sensitive summaries."
activity.kvx:type.NotificationDetailLevel.variants = ["full","summary","minimal"]
activity.kvx:type.NotificationGroup.required = ["recency:NotificationRecency","notifications:NotificationSummary[]"]
activity.kvx:type.NotificationPage.grouping = "Grouped by recency with read distinguished from unread, and repeated events deduplicated into their latest presentation."
activity.kvx:type.NotificationPage.required = ["groups:NotificationGroup[]","next_cursor:Cursor","unread_count:integer"]
activity.kvx:type.NotificationPreferences.immediacy = "Preference changes take effect immediately."
activity.kvx:type.NotificationPreferences.nesting = "Per-event-class preferences nest under each channel's toggle, with one detail level for how much financial detail notification content carries."
activity.kvx:type.NotificationPreferences.required = ["push:ChannelPreference","email:ChannelPreference","in_app:ChannelPreference","detail:NotificationDetailLevel"]
activity.kvx:type.NotificationRecency.variants = ["today","yesterday","this-week","earlier"]
activity.kvx:type.NotificationSummary.actions = "Security notifications carry action_copy_key naming the action button - review devices, pause agent, open approval."
activity.kvx:type.NotificationSummary.deep_link_rule = "deep_link lands on the exact surface in whichever shell is active, resolved to its honest current state: an expired approval reads expired, a completed journey reads done."
activity.kvx:type.NotificationSummary.optional = ["money:Money","agent_id:AgentId","approval_id:ApprovalId","journey_id:JourneyId","action_copy_key:CopyKey"]
activity.kvx:type.NotificationSummary.required = ["notification_id:NotificationId","class:NotificationClass","title_copy_key:CopyKey","body_copy_key:CopyKey","deep_link:string","read:boolean","created_at:Timestamp"]
agents.kvx:module.compatibility = "additive_only"
agents.kvx:module.contract_major = 1
agents.kvx:module.mirror = "The approval operations mirror the agent layer's approval module one to one. A hold surfaces here only with the held activity's own disclosure behind it, and a decision reaches the daemon as exactly one typed outcome."
agents.kvx:module.name = "agents"
agents.kvx:module.spine = "Managed agents and the approval inbox speak the journey vocabulary. Creation, funding and retirement are staged receipt-verified journeys, every figure a surface renders travels with the verification level the agent layer attached, and a restriction this plane enforces itself is always labelled app-enforced, never a protocol guarantee."
agents.kvx:operation.agent.archive.disposition_first = "Archive is refused with archive-needs-disposition while funds remain undisposed: remaining balances return through the reclaim paths first. A confirmed archive revokes authority, retires operating keys and keeps the agent's history and receipts readable forever."
agents.kvx:operation.agent.archive.grammar = "destructive"
agents.kvx:operation.agent.archive.idempotency = true
agents.kvx:operation.agent.archive.method = "POST"
agents.kvx:operation.agent.archive.path = "/v1/agents/{agent_id}/archive"
agents.kvx:operation.agent.archive.request = "AgentArchiveRequest"
agents.kvx:operation.agent.archive.response = "Journey"
agents.kvx:operation.agent.create.idempotency = true
agents.kvx:operation.agent.create.journey = "Creation is a staged receipt-verified journey of kind agent-create. The agent renders active only when every step's receipt has verified; a partial creation shows which steps completed and resumes."
agents.kvx:operation.agent.create.method = "POST"
agents.kvx:operation.agent.create.path = "/v1/agents"
agents.kvx:operation.agent.create.request = "AgentCreateRequest"
agents.kvx:operation.agent.create.response = "Journey"
agents.kvx:operation.agent.get.method = "GET"
agents.kvx:operation.agent.get.path = "/v1/agents/{agent_id}"
agents.kvx:operation.agent.get.request = "Empty"
agents.kvx:operation.agent.get.response = "Agent"
agents.kvx:operation.agent.limit.enforcement = "Where the limit is protocol-backed the change is receipt-verified through a protocol budget change. Any remainder this plane enforces itself is labelled app in enforcement and is never described as a protocol guarantee."
agents.kvx:operation.agent.limit.idempotency = true
agents.kvx:operation.agent.limit.method = "POST"
agents.kvx:operation.agent.limit.path = "/v1/agents/{agent_id}/limit"
agents.kvx:operation.agent.limit.request = "AgentLimitRequest"
agents.kvx:operation.agent.limit.response = "Agent"
agents.kvx:operation.agent.list.method = "GET"
agents.kvx:operation.agent.list.path = "/v1/agents"
agents.kvx:operation.agent.list.request = "Empty"
agents.kvx:operation.agent.list.response = "AgentPage"
agents.kvx:operation.agent.pause.consequence_copy_key = "agent.pause.consequence"
agents.kvx:operation.agent.pause.effect = "Operating authority is suspended promptly. Pause is reversible, confirmed with the plain consequence sentence consequence_copy_key names, and the paused record carries the evidence backing the suspension."
agents.kvx:operation.agent.pause.grammar = "reversible"
agents.kvx:operation.agent.pause.idempotency = true
agents.kvx:operation.agent.pause.method = "POST"
agents.kvx:operation.agent.pause.path = "/v1/agents/{agent_id}/pause"
agents.kvx:operation.agent.pause.request = "Empty"
agents.kvx:operation.agent.pause.response = "Agent"
agents.kvx:operation.agent.reclaim.idempotency = true
agents.kvx:operation.agent.reclaim.method = "POST"
agents.kvx:operation.agent.reclaim.path = "/v1/agents/{agent_id}/reclaim"
agents.kvx:operation.agent.reclaim.request = "AgentReclaimRequest"
agents.kvx:operation.agent.reclaim.response = "Journey"
agents.kvx:operation.agent.reclaim.vocabulary = "Taking money back is a move journey using return vocabulary. There is no key-based sweep of an agent's account: the route resolver picks a legitimate return path and the journey shows the receipt-backed result."
agents.kvx:operation.agent.recover.authority = "Recovery runs under the human's recovery authority with step-up, and the challenge delay is presented in plain time before anything changes."
agents.kvx:operation.agent.recover.idempotency = true
agents.kvx:operation.agent.recover.method = "POST"
agents.kvx:operation.agent.recover.path = "/v1/agents/{agent_id}/recover"
agents.kvx:operation.agent.recover.request = "Empty"
agents.kvx:operation.agent.recover.response = "KeyChallenge"
agents.kvx:operation.agent.resume.effect = "Resume restores the agent's operating authority through the same receipt-verified paths pause used."
agents.kvx:operation.agent.resume.idempotency = true
agents.kvx:operation.agent.resume.method = "POST"
agents.kvx:operation.agent.resume.path = "/v1/agents/{agent_id}/resume"
agents.kvx:operation.agent.resume.request = "Empty"
agents.kvx:operation.agent.resume.response = "Agent"
agents.kvx:operation.agent.rotate.effect = "Rotation runs through the protocol's own mechanism with its challenge delay presented in plain time before anything changes hands."
agents.kvx:operation.agent.rotate.idempotency = true
agents.kvx:operation.agent.rotate.method = "POST"
agents.kvx:operation.agent.rotate.path = "/v1/agents/{agent_id}/rotate"
agents.kvx:operation.agent.rotate.request = "Empty"
agents.kvx:operation.agent.rotate.response = "KeyChallenge"
agents.kvx:operation.approval.approve.idempotency = true
agents.kvx:operation.approval.approve.method = "POST"
agents.kvx:operation.approval.approve.outcomes = "Exactly one decision wins. A hold already decided answers already-decided, an expired hold answers hold-expired, a defective hold answers hold-defective, and repeating the same decision returns the original outcome."
agents.kvx:operation.approval.approve.path = "/v1/approvals/{approval_id}/approve"
agents.kvx:operation.approval.approve.request = "ApprovalApproveRequest"
agents.kvx:operation.approval.approve.response = "ApprovalDecision"
agents.kvx:operation.approval.get.method = "GET"
agents.kvx:operation.approval.get.path = "/v1/approvals/{approval_id}"
agents.kvx:operation.approval.get.request = "Empty"
agents.kvx:operation.approval.get.response = "ApprovalDetail"
agents.kvx:operation.approval.list.method = "GET"
agents.kvx:operation.approval.list.path = "/v1/approvals"
agents.kvx:operation.approval.list.request = "Empty"
agents.kvx:operation.approval.list.response = "ApprovalPage"
agents.kvx:operation.approval.reject.finality = "Rejection cancels the hold immediately and is final for it. The response confirms nothing moved."
agents.kvx:operation.approval.reject.idempotency = true
agents.kvx:operation.approval.reject.method = "POST"
agents.kvx:operation.approval.reject.path = "/v1/approvals/{approval_id}/reject"
agents.kvx:operation.approval.reject.request = "Empty"
agents.kvx:operation.approval.reject.response = "ApprovalDecision"
agents.kvx:scalar.AgentId.json = "string"
agents.kvx:scalar.AgentId.prefix = "agt_"
agents.kvx:scalar.AgentId.rust = "String"
agents.kvx:scalar.AgentId.typescript = "string"
agents.kvx:scalar.ApprovalId.json = "string"
agents.kvx:scalar.ApprovalId.prefix = "apr_"
agents.kvx:scalar.ApprovalId.rust = "String"
agents.kvx:scalar.ApprovalId.typescript = "string"
agents.kvx:type.Agent.evidence = "The receipts backing the agent's current state, each reference sufficient for export and independent verification."
agents.kvx:type.Agent.optional = ["creation_journey_id:JourneyId"]
agents.kvx:type.Agent.required = ["agent_id:AgentId","name:string","purpose:string","state:AgentState","state_copy_key:CopyKey","limit:SpendLimit","spend:AgentSpend","evidence:EvidenceRef[]","created_at:Timestamp","updated_at:Timestamp"]
agents.kvx:type.Agent.resumption = "While state is creating, creation_journey_id names the journey showing per-step progress and offering resumption, never a phantom agent."
agents.kvx:type.AgentArchiveRequest.confirmation = "Archive is destructive: confirm_name must equal the agent's name exactly, and a mismatch is refused with confirmation-mismatch."
agents.kvx:type.AgentArchiveRequest.required = ["confirm_name:string"]
agents.kvx:type.AgentCreateRequest.required = ["name:string","purpose:string","monthly_limit:Money"]
agents.kvx:type.AgentCreateRequest.simplicity = "Creating an agent asks exactly these three things. The service orchestrates everything else as a staged receipt-verified journey."
agents.kvx:type.AgentLimitRequest.required = ["monthly_limit:Money"]
agents.kvx:type.AgentPage.required = ["agents:Agent[]","next_cursor:Cursor"]
agents.kvx:type.AgentReclaimRequest.required = ["money:Money"]
agents.kvx:type.AgentSpend.optional = ["reconciliation_copy_key:CopyKey"]
agents.kvx:type.AgentSpend.reconciliation = "When local accounting and protocol state diverge the protocol figure is adopted and reconciliation_copy_key names the note surfacing the divergence honestly."
agents.kvx:type.AgentSpend.required = ["period_start:Timestamp","period_end:Timestamp","spent:Money","remaining:Money","verification:VerificationLevel"]
agents.kvx:type.AgentSpend.source = "Spend against the limit for the current period is computed from verified receipts and carries the verification level achieved. This plane never raises that level itself."
agents.kvx:type.AgentState.active.semantics = "Rendered only when every creation step's receipt has verified. While creation is partial the agent stays creating and its journey shows honestly which steps completed."
agents.kvx:type.AgentState.archived.semantics = "Authority revoked and operating keys retired. The agent's history and receipts remain readable forever."
agents.kvx:type.AgentState.paused.semantics = "Operating authority is suspended. Pause is reversible and resume restores authority through the same receipt-verified paths."
agents.kvx:type.AgentState.variants = ["creating","active","paused","archiving","archived"]
agents.kvx:type.ApprovalApproveRequest.binding = "The step-up ceremony is bound to exactly this hold. Evidence issued for any other operation, or missing entirely, is refused with step-up-required."
agents.kvx:type.ApprovalApproveRequest.required = ["step_up_evidence:EvidenceId"]
agents.kvx:type.ApprovalDecision.approved = "An approval releases exactly the held activity into the submission path. money_moved stays false at decision time; the released activity is tracked to its verified receipt through evidence like any movement."
agents.kvx:type.ApprovalDecision.rejected = "A rejection is immediate and final for this hold: money_moved is false and moved_copy_key names the sentence confirming nothing moved."
agents.kvx:type.ApprovalDecision.required = ["approval_id:ApprovalId","state:ApprovalState","state_copy_key:CopyKey","money_moved:boolean","moved_copy_key:CopyKey","evidence:EvidenceRef[]"]
agents.kvx:type.ApprovalDetail.context = "budget_remaining_after comes exclusively from verified reads labelled with their verification level. evidence names the hold material Technical details renders."
agents.kvx:type.ApprovalDetail.required = ["approval_id:ApprovalId","agent_id:AgentId","agent_name:string","state:ApprovalState","state_copy_key:CopyKey","reason_copy_key:CopyKey","facts:ApprovalFacts","budget_remaining_after:VerifiedMoney","created_at:Timestamp","evidence:EvidenceRef[]"]
agents.kvx:type.ApprovalFacts.defect = "A hold whose disclosure cannot back these facts is refused with hold-defective instead of rendered."
agents.kvx:type.ApprovalFacts.required = ["amount:Money","counterparty:string","asset:CurrencyCode","fees:Money","expires_at:Timestamp"]
agents.kvx:type.ApprovalFacts.source = "Every fact is rendered from the held activity's own disclosure, never a paraphrase or a second data source. The facts state plainly what will happen if you say yes; the mechanics behind them stay behind the evidence references."
agents.kvx:type.ApprovalPage.required = ["approvals:ApprovalSummary[]","next_cursor:Cursor"]
agents.kvx:type.ApprovalState.defective.semantics = "The held activity's disclosure could not back its own facts, so the hold is reported, never approvable."
agents.kvx:type.ApprovalState.expired.semantics = "The hold expired unactioned. No money moved and no approve control is offered."
agents.kvx:type.ApprovalState.pending.semantics = "The hold awaits the user's decision until its expiry."
agents.kvx:type.ApprovalState.variants = ["pending","approved","rejected","expired","defective"]
agents.kvx:type.ApprovalSummary.inbox = "One hold as the inbox lists it: the agent, the counterparty, the exact amount, why it was held, when it expires, and the budget remaining after with its verification level."
agents.kvx:type.ApprovalSummary.required = ["approval_id:ApprovalId","agent_id:AgentId","agent_name:string","counterparty:string","amount:Money","reason_copy_key:CopyKey","expires_at:Timestamp","state:ApprovalState","budget_remaining_after:VerifiedMoney"]
agents.kvx:type.KeyChallenge.continuity = "The agent's identity and history stay continuous across the change, and evidence carries the receipts backing it."
agents.kvx:type.KeyChallenge.plain_time = "The protocol's challenge delay is surfaced in plain time units: delay_seconds carries the exact figure and delay_copy_key names the sentence presenting it."
agents.kvx:type.KeyChallenge.required = ["agent_id:AgentId","kind:KeyChallengeKind","delay_copy_key:CopyKey","delay_seconds:integer","ready_at:Timestamp","evidence:EvidenceRef[]"]
agents.kvx:type.KeyChallengeKind.variants = ["rotate","recover"]
agents.kvx:type.LimitEnforcement.app.semantics = "The limit is enforced by this plane only. It is a restriction, never a protocol guarantee, and every surface labels it app-enforced."
agents.kvx:type.LimitEnforcement.protocol.semantics = "The limit is a protocol budget bound, backed by the verified receipts in the carrying record's evidence."
agents.kvx:type.LimitEnforcement.variants = ["protocol","app"]
agents.kvx:type.SpendLimit.labelling = "enforcement_copy_key names the plain sentence stating who enforces this limit. An app-enforced limit is never described as a protocol guarantee."
agents.kvx:type.SpendLimit.required = ["monthly:Money","enforcement:LimitEnforcement","enforcement_copy_key:CopyKey"]
agents.kvx:type.VerifiedMoney.honesty = "A figure travels with the verification level the agent layer attached. This plane never raises it and visibly marks what it cannot verify."
agents.kvx:type.VerifiedMoney.required = ["money:Money","verification:VerificationLevel"]
compatibility.kvx:compatibility.row.1.schema = "1.0"
compatibility.kvx:compatibility.row.1.service = "0.1.x"
compatibility.kvx:compatibility.row.1.web_app = "0.1.x"
compatibility.kvx:compatibility.row.2.schema = "1.1"
compatibility.kvx:compatibility.row.2.service = "0.1.x"
compatibility.kvx:compatibility.row.2.web_app = "0.1.x"
compatibility.kvx:compatibility.rule = "Every released pairing of contract schema, human service and web application versions is recorded here as a row. The conformance suite validates the shape of every row, and published rows are frozen by the additive-only baseline."
compatibility.kvx:compatibility.settlement_domains = "Every custody-boundary claim and receipt shape names its settlement domain through the SettlementDomain vocabulary, and paxeer is the sole valid domain in this schema version. Adding a settlement domain is an additive change by construction: a later release appends a variant to SettlementDomain and leaves every published declaration untouched, and the one-ledger guarantee - one identity, one balance system, one canonical order - is unchanged by the tagging."
errors.kvx:module.compatibility = "additive_only"
errors.kvx:module.contract_major = 1
errors.kvx:module.model = "Every failure response carries one typed shape: a stable machine code, the copy-catalog key naming the human message, the trace identifier on the envelope, and a retriability classification. No operation returns an unstructured error."
errors.kvx:module.name = "errors"
errors.kvx:module.report = "The envelope trace identifier is the key the Report action submits and the key support uses to retrieve the failure context the user saw."
errors.kvx:type.ApiError.field_errors = "A failure caused by one invalid input names it in field so forms can show the error inline at that field."
errors.kvx:type.ApiError.optional = ["retry_after_ms:integer","field:string"]
errors.kvx:type.ApiError.rate_limit = "A rate-limited failure carries retry_after_ms so clients surface honest retry timing, as the retriable-after classification requires."
errors.kvx:type.ApiError.required = ["code:ErrorCode","copy_key:CopyKey","retry:Retriability"]
errors.kvx:type.ErrorCode.stability = "Machine codes are stable identifiers. A code is never renamed or removed within a major version; new failure classes append new codes."
errors.kvx:type.ErrorCode.variants = ["unauthenticated","session-expired","step-up-required","forbidden","not-found","invalid-request","conflict","rate-limited","cursor-expired","unavailable","upstream-degraded","challenge-expired","refused-by-policy","refused-by-budget","refused-by-capability","refused-by-protocol","refused-by-limit","quote-expired","wallet-not-bound","exit-unavailable","already-decided","hold-expired","hold-defective","archive-needs-disposition","confirmation-mismatch","not-suppressible","support-unavailable","support-conversation-unknown","support-message-unknown"]
errors.kvx:type.Retriability.final.semantics = "The outcome is settled. The plane never retries into a different outcome and surfaces state the result honestly."
errors.kvx:type.Retriability.retriable-after.semantics = "The same request may be retried once the carried retry_after_ms has elapsed. Rate-limit refusals always classify here and always carry the timing."
errors.kvx:type.Retriability.retriable.semantics = "The same request may be retried as-is. Surfaces offer Retry."
errors.kvx:type.Retriability.structural.semantics = "Retrying the same call cannot help until surrounding state changes, such as re-authentication or a reload. Surfaces offer Reload."
errors.kvx:type.Retriability.variants = ["retriable","retriable-after","structural","final"]
home.kvx:module.compatibility = "additive_only"
home.kvx:module.contract_major = 1
home.kvx:module.name = "home"
home.kvx:module.spine = "The home surface is one receipt-honest read model: its balance is decoded from an agent-layer verified read, its freshness says exactly which head or checkpoint it is relative to, and the remaining summaries retain their evidence and verification levels."
home.kvx:operation.account.balance.method = "GET"
home.kvx:operation.account.balance.path = "/v1/account/balance"
home.kvx:operation.account.balance.request = "Empty"
home.kvx:operation.account.balance.response = "AccountBalance"
home.kvx:operation.home.summary.method = "GET"
home.kvx:operation.home.summary.path = "/v1/home"
home.kvx:operation.home.summary.request = "Empty"
home.kvx:operation.home.summary.response = "HomeSummary"
home.kvx:type.AccountBalance.evidence = "evidence includes the verified read and any checkpoint proof required to reproduce the presented balance independently."
home.kvx:type.AccountBalance.required = ["account_id:AccountId","money:Money","verification:VerificationLevel","freshness:ProtocolFreshness","evidence:EvidenceRef[]"]
home.kvx:type.AccountBalance.source = "money is decoded only from core-produced balance bytes admitted by the agent layer at verification or above. The human service never maintains or increments a balance of its own and never raises verification."
home.kvx:type.HomeSummary.composition = "Every protocol fact retains the verification and evidence carried by its source operation. The summary is a bounded composition of the real balance, agent, approval and activity services, never a second cache or write model."
home.kvx:type.HomeSummary.required = ["balance:AccountBalance","agents:Agent[]","approvals:ApprovalSummary[]","recent_activity:ActivityEntryDetail[]"]
home.kvx:type.ProtocolFreshness.honesty = "source_head is the exact agent-layer head relative to which the read was verified. checkpoint is present only when checkpoint proof material backed the read. A value outside the configured bound remains usable only with within_bound false and its age visibly rendered."
home.kvx:type.ProtocolFreshness.optional = ["checkpoint:string"]
home.kvx:type.ProtocolFreshness.required = ["observed_at:Timestamp","age_seconds:integer","source_head:string","within_bound:boolean"]
identity.kvx:module.ceremonies = "Passkey ceremonies travel as typed records whose ceremony and credential fields are opaque base64 strings produced and consumed by the platform credential machinery. This plane relays them without interpreting them."
identity.kvx:module.compatibility = "additive_only"
identity.kvx:module.contract_major = 1
identity.kvx:module.name = "identity"
identity.kvx:module.separation = "The application identity a passkey unlocks, the protocol identity the custody service establishes underneath it, and the wallet a person links for money in and out are three distinct things. Protocol mechanics stay behind evidence references, and the browser never holds signing power."
identity.kvx:module.spine = "One account held by passkeys, carried by sessions, linked to one payout wallet. Everything a person can do on the authenticated plane starts with the operations declared here: creating the account, confirming it is really them, watching onboarding finish honestly, and linking the wallet their money arrives from and returns to."
identity.kvx:operation.account.create.convergence = "Repeating the request under the same key returns the original account and its onboarding journey: one application identity, one protocol identity, one set of receipts, no orphaned protocol state."
identity.kvx:operation.account.create.idempotency = true
identity.kvx:operation.account.create.method = "POST"
identity.kvx:operation.account.create.path = "/v1/accounts"
identity.kvx:operation.account.create.request = "AccountCreateRequest"
identity.kvx:operation.account.create.response = "AccountCreation"
