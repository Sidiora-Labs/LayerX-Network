identity.kvx:type.StepUpEvidence.reference = "The record other modules carry when an operation requires fresh confirmation: acting on an approval, starting a withdrawal or exit, changing security settings, revealing a secret, replacing the payout wallet, archiving an agent."
identity.kvx:type.StepUpEvidence.required = ["challenge_id:StepUpChallengeId","confirms:OperationDigest","passkey_id:PasskeyId","completed_at:Timestamp","expires_at:Timestamp"]
identity.kvx:type.StepUpFinish.required = ["credential:OpaqueCredential"]
identity.kvx:type.StepUpRequest.required = ["confirms:OperationDigest"]
identity.kvx:type.TimedSecret.handling = "The value is returned only after fresh operation-bound step-up. The client masks it by default, clears it at remask_at, and writes it to the clipboard only after a separate explicit action when copyable is true."
identity.kvx:type.TimedSecret.required = ["value:string","remask_at:Timestamp","copyable:boolean"]
identity.kvx:type.WalletBinding.checksum = "address always carries the full checksummed mixed-case rendering."
identity.kvx:type.WalletBinding.evidence = "evidence references the receipt-backed record that established the current binding, and the binding reads as bound only once it verifies."
identity.kvx:type.WalletBinding.optional = ["address:EvmAddress","bound_at:Timestamp","evidence:EvidenceRef"]
identity.kvx:type.WalletBinding.required = ["state:BindingState"]
journeys.kvx:module.compatibility = "additive_only"
journeys.kvx:module.contract_major = 1
journeys.kvx:module.name = "journeys"
journeys.kvx:module.spine = "Every operation on this contract speaks in journeys, stages, states and evidence references. Raw protocol structures never cross this boundary."
journeys.kvx:operation.evidence.get.method = "GET"
journeys.kvx:operation.evidence.get.path = "/v1/evidence/{evidence_id}"
journeys.kvx:operation.evidence.get.request = "Empty"
journeys.kvx:operation.evidence.get.response = "EvidenceMaterial"
journeys.kvx:operation.journey.get.method = "GET"
journeys.kvx:operation.journey.get.path = "/v1/journeys/{journey_id}"
journeys.kvx:operation.journey.get.request = "Empty"
journeys.kvx:operation.journey.get.response = "Journey"
journeys.kvx:operation.journey.list.method = "GET"
journeys.kvx:operation.journey.list.path = "/v1/journeys"
journeys.kvx:operation.journey.list.request = "Empty"
journeys.kvx:operation.journey.list.response = "JourneyPage"
journeys.kvx:type.EvidenceClass.variants = ["local-journey-state","submission-record","layerx-receipt","checkpoint-proof","paxeer-finality","typed-refusal","approval-hold","wallet-ack"]
journeys.kvx:type.EvidenceMaterial.material = "The referenced receipt or proof in its canonical bytes, exactly as the protocol produced them, sufficient for export and for verification independent of this plane."
journeys.kvx:type.EvidenceMaterial.optional = ["settlement_domain:SettlementDomain"]
journeys.kvx:type.EvidenceMaterial.required = ["evidence_id:EvidenceId","class:EvidenceClass","verification:VerificationLevel","content_type:string","bytes_base64:string"]
journeys.kvx:type.EvidenceMaterial.settlement_domain = "paxeer"
journeys.kvx:type.EvidenceRef.export = "Every evidence reference is sufficient to fetch the receipt or proof material for export and independent verification."
journeys.kvx:type.EvidenceRef.optional = ["settlement_domain:SettlementDomain"]
journeys.kvx:type.EvidenceRef.required = ["evidence_id:EvidenceId","class:EvidenceClass","verification:VerificationLevel"]
journeys.kvx:type.EvidenceRef.settlement_domain = "paxeer"
journeys.kvx:type.Journey.optional = ["refusal:Refusal","wallet_request:WalletSignRequest"]
journeys.kvx:type.Journey.required = ["journey_id:JourneyId","kind:JourneyKind","state:JourneyState","state_copy_key:CopyKey","stages:JourneyStage[]","evidence:EvidenceRef[]","started_at:Timestamp","updated_at:Timestamp"]
journeys.kvx:type.Journey.rule = "A journey is the only shape in which protocol activity reaches a client."
journeys.kvx:type.JourneyKind.boundary = "deposit, withdraw and exit name custody-boundary journeys exclusively. Every movement inside LayerX is move, resolved to fund, allocate, return or transfer by the route resolver."
journeys.kvx:type.JourneyKind.variants = ["onboarding","wallet-binding","deposit","withdraw","exit","move","agent-create","agent-fund","agent-pause","agent-retire"]
journeys.kvx:type.JourneyPage.required = ["journeys:Journey[]","next_cursor:Cursor"]
journeys.kvx:type.JourneyStage.required = ["stage_id:StageId","copy_key:CopyKey","state:JourneyState","evidence:EvidenceRef[]"]
journeys.kvx:type.JourneyState.done-finalised.semantics = "The receipt-backed outcome is additionally covered by a finalised checkpoint proof."
journeys.kvx:type.JourneyState.done.semantics = "Rendered only when a verified LayerX receipt or a verified Paxeer finality proof in the journey's evidence backs the exact outcome."
journeys.kvx:type.JourneyState.refused.semantics = "A typed refusal backs this state and always states whether any money left the account."
journeys.kvx:type.JourneyState.still-checking.semantics = "The outcome is unknown. It resolves only by receipt lookup under the journey's idempotency key, and every duplicate-capable control stays locked while it lasts."
journeys.kvx:type.JourneyState.table = "This vocabulary is the normative status translation table. A state outside it on a default surface is a build failure."
journeys.kvx:type.JourneyState.variants = ["getting-ready","sending","processing","done","done-finalised","still-checking","refused","waiting-for-you"]
journeys.kvx:type.JourneyState.waiting-for-you.semantics = "A policy hold with deterministic expiry awaits the user's approval decision."
journeys.kvx:type.VerificationLevel.ordering = "declaration_order"
journeys.kvx:type.VerificationLevel.variants = ["unverified","receipt-verified","checkpoint-finalised","paxeer-finalised"]
movement.kvx:module.compatibility = "additive_only"
movement.kvx:module.contract_major = 1
movement.kvx:module.multi_leg = "The route resolver composes multi-leg journeys automatically. Each leg runs to its own verified receipt before the next leg starts, the journey presents per-leg progress, and the finished journey references every leg receipt in order."
movement.kvx:module.name = "movement"
movement.kvx:module.quote_then_commit = "Moving money is quote then commit. The quote states in plain language what will happen, the fee estimate with its ceiling, the arrival expectation and any irreversibility before the user commits, and the commit turns exactly that quote into a journey."
movement.kvx:module.refusals = "A refused movement carries the typed Refusal on its journey: which limit refused it in plain language, whether any money left the account, and where the limit can be changed when it is the user's to change."
movement.kvx:module.repeat_rule = "Every operation that could move money requires the Idempotency-Key header, and repeating the request returns the original journey rather than a second effect."
movement.kvx:module.still_checking = "A leg whose fate is unknown pauses its journey in still-checking. It resolves only by receipt lookup, the service never resubmits a leg whose fate is undetermined, and every control that could duplicate the effect stays locked while it lasts."
movement.kvx:module.verb = "The user sees one verb: Move money. The user says who gets how much, the route resolver picks the mechanism, and the user never selects a transfer type, bridge or route."
movement.kvx:module.vocabulary = "Movements inside LayerX are fund, allocate, return or transfer, in every API surface, log and copy string. Deposit, withdraw and exit name journeys across the Paxeer custody boundary exclusively and never name an internal movement."
movement.kvx:operation.deposit.confirm.handoff = "The wallet's transaction reference hands the journey to the service, which runs it server-side from here with no further user action required."
movement.kvx:operation.deposit.confirm.method = "POST"
movement.kvx:operation.deposit.confirm.path = "/v1/deposits/{journey_id}/confirm"
movement.kvx:operation.deposit.confirm.request = "DepositConfirmRequest"
movement.kvx:operation.deposit.confirm.response = "Journey"
movement.kvx:operation.deposit.start.first_stage = "The returned journey of kind deposit starts at the stage waiting on the wallet, and the journey carries the wallet request to sign for exactly that stage. Where no wallet is bound the journey starts with a linking stage instead, folding binding into the journey rather than a separate errand."
movement.kvx:operation.deposit.start.idempotency = true
movement.kvx:operation.deposit.start.method = "POST"
movement.kvx:operation.deposit.start.path = "/v1/deposits"
movement.kvx:operation.deposit.start.request = "DepositStartRequest"
movement.kvx:operation.deposit.start.response = "Journey"
movement.kvx:operation.exit.eligibility.method = "GET"
movement.kvx:operation.exit.eligibility.normal_operation = "When the network is operating normally the exit is unavailable, the read says so plainly, and the ordinary withdrawal is offered instead."
movement.kvx:operation.exit.eligibility.path = "/v1/exit/eligibility"
movement.kvx:operation.exit.eligibility.request = "Empty"
movement.kvx:operation.exit.eligibility.response = "ExitEligibility"
movement.kvx:operation.exit.start.framing = "A guided flow under Settings framed as getting my money out. It requires the typed confirmation of its irreversibility and stays operable when ordinary LayerX operation is degraded."
movement.kvx:operation.exit.start.idempotency = true
movement.kvx:operation.exit.start.method = "POST"
movement.kvx:operation.exit.start.path = "/v1/exit"
movement.kvx:operation.exit.start.request = "ExitStartRequest"
movement.kvx:operation.exit.start.response = "Journey"
movement.kvx:operation.move.commit.idempotency = true
movement.kvx:operation.move.commit.journey = "Committing a quote starts a journey of kind move. Repeating the request returns the original journey."
movement.kvx:operation.move.commit.method = "POST"
movement.kvx:operation.move.commit.path = "/v1/moves"
movement.kvx:operation.move.commit.request = "MoveCommitRequest"
movement.kvx:operation.move.commit.response = "Journey"
movement.kvx:operation.move.quote.method = "POST"
movement.kvx:operation.move.quote.no_route = "A route the resolver cannot serve is a typed refusal, never a partial attempt."
movement.kvx:operation.move.quote.path = "/v1/moves/quote"
movement.kvx:operation.move.quote.request = "MoveQuoteRequest"
movement.kvx:operation.move.quote.response = "MoveQuote"
movement.kvx:operation.withdraw.claim.claim = "The wallet's claim signature reference advances the journey through its ready-to-claim stage toward paid out."
movement.kvx:operation.withdraw.claim.method = "POST"
movement.kvx:operation.withdraw.claim.path = "/v1/withdrawals/{journey_id}/claim"
movement.kvx:operation.withdraw.claim.request = "WithdrawClaimRequest"
movement.kvx:operation.withdraw.claim.response = "Journey"
movement.kvx:operation.withdraw.start.commitment = "Starting a withdrawal commits it: a committed withdrawal cannot be cancelled, only completed, and the review states this explicitly before the user commits."
movement.kvx:operation.withdraw.start.idempotency = true
movement.kvx:operation.withdraw.start.method = "POST"
movement.kvx:operation.withdraw.start.path = "/v1/withdrawals"
movement.kvx:operation.withdraw.start.request = "WithdrawStartRequest"
movement.kvx:operation.withdraw.start.response = "Journey"
