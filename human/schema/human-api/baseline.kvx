support.kvx:operation.support.reply.method = "POST"
support.kvx:operation.support.reply.path = "/v1/support/conversations/{conversation_id}/replies"
support.kvx:operation.support.reply.request = "SupportReplyRequest"
support.kvx:operation.support.reply.response = "SupportConversation"
support.kvx:operation.support.status.method = "GET"
support.kvx:operation.support.status.path = "/v1/support/conversations/{conversation_id}/status"
support.kvx:operation.support.status.request = "Empty"
support.kvx:operation.support.status.response = "SupportConversationStatus"
support.kvx:scalar.SupportConversationId.json = "string"
support.kvx:scalar.SupportConversationId.prefix = "sup_"
support.kvx:scalar.SupportConversationId.rust = "String"
support.kvx:scalar.SupportConversationId.typescript = "string"
support.kvx:scalar.SupportMessageId.json = "string"
support.kvx:scalar.SupportMessageId.prefix = "msg_"
support.kvx:scalar.SupportMessageId.rust = "String"
support.kvx:scalar.SupportMessageId.typescript = "string"
support.kvx:type.SupportAuthor.variants = ["you","support"]
support.kvx:type.SupportConversation.optional = ["trace_id:TraceId"]
support.kvx:type.SupportConversation.privacy = "trace_id is the only error-report context admitted to a conversation. The service resolves its redacted report server-side and never accepts a machine code, route, stack, credential or arbitrary diagnostic field here."
support.kvx:type.SupportConversation.required = ["conversation_id:SupportConversationId","shell:SupportShell","state:SupportConversationState","created_at:Timestamp","updated_at:Timestamp","messages:SupportMessage[]","feedback:SupportFeedback[]"]
support.kvx:type.SupportConversationPage.bounds = "The service returns the authenticated principal's newest 100 conversations in updated_at order."
support.kvx:type.SupportConversationPage.required = ["conversations:SupportConversation[]"]
support.kvx:type.SupportConversationState.variants = ["waiting-for-support","waiting-for-you","resolved"]
support.kvx:type.SupportConversationStatus.required = ["conversation_id:SupportConversationId","state:SupportConversationState","unread_count:integer","updated_at:Timestamp"]
support.kvx:type.SupportCreateRequest.bounds = "body is trimmed UTF-8 text between 1 and 2000 Unicode scalar values. The required Idempotency-Key is the create identity for retries."
support.kvx:type.SupportCreateRequest.optional = ["topic:SupportTopic","trace_id:TraceId"]
support.kvx:type.SupportCreateRequest.required = ["body:string","shell:SupportShell"]
support.kvx:type.SupportFeedback.required = ["message_id:SupportMessageId","helpful:boolean","received_at:Timestamp"]
support.kvx:type.SupportFeedbackRequest.required = ["message_id:SupportMessageId","helpful:boolean"]
support.kvx:type.SupportMessage.optional = ["topic:SupportTopic"]
support.kvx:type.SupportMessage.rendering = "Every message body was persisted by its declared author. The application SHALL NOT generate a support-authored acknowledgement or present a system response as a person's reply."
support.kvx:type.SupportMessage.required = ["message_id:SupportMessageId","author:SupportAuthor","body:string","sent_at:Timestamp","read:boolean"]
support.kvx:type.SupportReadRequest.required = ["through_message_id:SupportMessageId"]
support.kvx:type.SupportReplyRequest.bounds = "body is trimmed UTF-8 text between 1 and 2000 Unicode scalar values. The required Idempotency-Key is the reply identity for retries."
support.kvx:type.SupportReplyRequest.required = ["body:string"]
support.kvx:type.SupportShell.variants = ["mobile","desktop"]
support.kvx:type.SupportTopic.variants = ["deposit","withdrawal","agents","account","report"]
v1.kvx:encoding.amounts = "Every amount is a decimal string of base units, never a JSON number, and always travels with an explicit currency code. TypeScript clients read amounts as bigint."
v1.kvx:encoding.base_path = "/v1"
v1.kvx:encoding.content_type = "application/json"
v1.kvx:encoding.error = "Failure responses carry ok false and a structured error object with a stable machine code, a copy-catalog key, the trace identifier and a retriability classification. No operation returns an unstructured error."
v1.kvx:encoding.idempotency = "Every mutation that could move money or change protocol state requires the Idempotency-Key header, and repeating the request returns the original journey rather than a second effect."
v1.kvx:encoding.idempotency_header = "Idempotency-Key"
v1.kvx:encoding.request = "A JSON object shaped by the operation's request type. Operations declaring the Empty request send no body."
v1.kvx:encoding.response = "A JSON envelope with ok as a boolean, result matching the operation's response type when ok is true, error as a structured object when ok is false, and trace always present."
v1.kvx:encoding.transport = "HTTPS"
v1.kvx:encoding.versioning = "The contract major version is the first segment of every operation path. Within one major version every change is additive."
v1.kvx:golden.failure_layout = "golden/<operation>.failure.json for every operation"
v1.kvx:golden.failure_rule = "Every operation ships a failure vector proving its typed error shape: a non-2xx status and an envelope carrying ok false, the structured ApiError and the trace. An operation without a failure vector fails the conformance suite."
v1.kvx:golden.layout = "golden/<operation>.request.json and golden/<operation>.response.json for every operation"
v1.kvx:golden.request_shape = "method, path, optional headers, optional body"
v1.kvx:golden.response_shape = "status, body"
v1.kvx:golden.rule = "Golden vectors are the executable examples of this contract. The conformance suite fails when an operation lacks vectors or a vector departs from the declared shapes."
v1.kvx:operation.version.method = "GET"
v1.kvx:operation.version.path = "/v1/version"
v1.kvx:operation.version.request = "Empty"
