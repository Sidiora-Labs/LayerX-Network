[compatibility]
rule = "Every released pairing of contract schema, human service and web application versions is recorded here as a row. The conformance suite validates the shape of every row, and published rows are frozen by the additive-only baseline."
settlement_domains = "Every custody-boundary claim and receipt shape names its settlement domain through the SettlementDomain vocabulary, and paxeer is the sole valid domain in this schema version. Adding a settlement domain is an additive change by construction: a later release appends a variant to SettlementDomain and leaves every published declaration untouched, and the one-ledger guarantee - one identity, one balance system, one canonical order - is unchanged by the tagging."

[compatibility.row.1]
schema = "1.0"
service = "0.1.x"
web_app = "0.1.x"

[compatibility.row.2]
schema = "1.1"
service = "0.1.x"
web_app = "0.1.x"
