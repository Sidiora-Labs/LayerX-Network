{
  "name": "@layerx/human-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:ui && next build",
    "build:ui": "cd packages/layerx-ui && rm -rf dist && ../../node_modules/.bin/tsup",
    "start": "next start",
    "test": "node --test e2e/scaffold.test.mjs e2e/copy.test.ts e2e/ui-library.test.ts e2e/kit.spec.ts e2e/harness.test.ts e2e/state-matrix.test.ts e2e/states.spec.ts e2e/api-client.test.ts",
    "test:component": "node --test e2e/scaffold.test.mjs e2e/copy.test.ts e2e/ui-library.test.ts e2e/kit.spec.ts e2e/harness.test.ts e2e/state-matrix.test.ts e2e/states.spec.ts e2e/api-client.test.ts",
    "test:foundation": "node --test e2e/shell.spec.ts e2e/a11y.spec.ts e2e/states.spec.ts",
    "test:perf": "playwright test --config playwright.perf.config.ts --project=desktop-shell",
    "test:journey": "playwright test --grep @journey",
    "test:settings": "node --test e2e/settings.spec.ts && playwright test --grep @settings",
    "test:explorer": "playwright test --grep @explorer",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "lint": "tsc --noEmit && eslint --max-warnings=0 \"src/**/*.{ts,tsx}\" \"copy/**/*.ts\" && node policy/check.mjs && npm audit --audit-level=high",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run test:e2e"
  },
  "dependencies": {
    "@layerx/ui": "file:packages/layerx-ui",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@emnapi/wasi-threads": "1.2.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
