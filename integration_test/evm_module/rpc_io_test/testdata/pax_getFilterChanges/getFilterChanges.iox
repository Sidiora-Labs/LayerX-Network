// Data-dependent: pax_newFilter, bind filterId, then pax_getFilterChanges(filterId). Run evm_rpc_tests.sh when local.
>> {"jsonrpc":"2.0","id":1,"method":"pax_newFilter","params":[{"fromBlock":"latest","toBlock":"latest"}]}
<< {"jsonrpc":"2.0","id":1,"result":"0x"}
@ bind filterId = result
>> {"jsonrpc":"2.0","id":2,"method":"pax_getFilterChanges","params":["${filterId}"]}
<< {"jsonrpc":"2.0","id":2,"result":[]}
